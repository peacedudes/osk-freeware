# Built artefacts -- the image, the tar of the same tree and the tar module
# that unpacks it are release assets, not source.
/osk-freeware.dd
/osk-freeware.tar
/tar
# The advisory lock tools/imagelock.py holds while a harness runs.  It
# was committed once, by a `git add -A' during a run.
*.dd.lock
/dd
/h0
/hz
*.dd
*.dd.gz

# macOS
.DS_Store
._*

# Collaboration guide -- for working ON this repo, not for its users.
CLAUDE.md

# Working notes that say so themselves: decision aids and indexes of a
# personal archive, not deliverables. Kept on disk, out of the repo.
notes/CORPUS-AUDIT-68k.md
notes/DOWNLOADS-68k.md
notes/FREEWARE-INDEX.md
notes/FREEWARE-TRIAGE-68k.md

# Editor and host litter. Note these are also refused by tools/check_disk.py:
# mkimage.sh reads disk/ off the filesystem, so ignoring them here is not
# enough to keep them out of the image.
*.swp
*.swo
*~
.DS_Store

# Python bytecode from running the tools in place.
__pycache__/
*.pyc

# Shell history, written into $HOME (= /dd) by a session on the tree.
.bash_history
.sh_history
.pdksh_hist

# Modules produced by tools/build.sh. The disk ships committed binaries;
# these are what a rebuild made this time, for comparison or installation.
/built/

# Play-test captures: raw terminal streams and rendered screens. Regenerated
# by tools/playtest.py; the screens worth keeping are published in docs/.
notes/playtests/

# The data tests' raw captures. Regenerated by every `tools/datatest.py' run,
# so they turn up as a diff after any test and say nothing a reader wants.
# The .cases files are the source; the verdicts are printed.
notes/datatests/

# Drive transcripts: what every program printed when it was run with real
# arguments, written by tools/drive.py. Regenerated from the sheets in
# tools/drives/, which are the source and ARE committed -- same arrangement
# as the data tests and the play-test captures above.
notes/drives/
