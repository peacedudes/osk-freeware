# Built artefacts -- the image, the tar of the same tree and the tar module
# that unpacks it are release assets, not source.
/osk-freeware.dd
/osk-freeware.tar
/tar
# The advisory lock tools/imagelock.py holds while a harness runs.  It
# was committed once, by a `git add -A' during a run.
*.dd.lock
/dd
/h0
/hz
*.dd
*.dd.gz

# The browser demo's disk: docs/try serves the collection as a web page
# (os9exec built to WebAssembly).  The three small files -- index.html,
# os9exec.js, os9exec.wasm -- are committed; the 49 MB disk.gz is not.  The
# workflow gzips the image it has just built into place before publishing
# Pages, so what the page serves is always the disk from that commit.
/docs/try/disk.gz

# macOS
.DS_Store
._*

# Collaboration guide -- for working ON this repo, not for its users.
CLAUDE.md

# Editor and host litter. Note these are also refused by tools/check_disk.py:
# mkimage.sh reads disk/ off the filesystem, so ignoring them here is not
# enough to keep them out of the image.
*.swp
*.swo
*~
.DS_Store

# Python bytecode from running the tools in place.
__pycache__/
*.pyc

# Shell history, written into $HOME (= /dd) by a session on the tree.
.bash_history
.sh_history
.pdksh_hist

# Modules produced by tools/build.sh. The disk ships committed binaries;
# these are what a rebuild made this time, for comparison or installation.
/built/

!docs/try/blank.dd.gz

# The maker's working papers -- handoffs, histories, research, retired
# scripts -- and what the harnesses write: play-test and card captures
# (the screens worth keeping are published in docs/), data-test and drive
# transcripts.  All regenerated or private; none of it ships.
notes/
