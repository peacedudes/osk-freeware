# /dd/local/sys/profile -- bash's system-wide startup file on this disk.## bash compiles this path in and reads it before anything else. Without it# bash starts with a Unix PATH (/usr/gnu/bin:/usr/local/bin:...) that does not# exist on OS-9, so no command is found, and with HOME unset it looks for# "/.bashrc" -- which OS-9 reads as a DEVICE name, giving the confusing# "(E$MNF) That module isn't currently loaded".HOME=/ddPATH=/dd/CMDS:/dd/CMDS/GAMES:.TMACDIR=/dd/LIBHELPDIR=/dd/SYS/HELPSIMPATH=/dd/SBPROLOG/MODLIBTERM=vt100USER=suexport HOME PATH TMACDIR HELPDIR SIMPATH TERM USER