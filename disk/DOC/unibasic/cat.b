* "quick and dirty" cat program dim filenum:byte dim filename:string[12] dim buf:string[300]  on error goto badfilelp filename=NextArg if len(filename)=0 then     end endif if filename="-?" or filename="--help" then     print     print "cat filename... filename"     print     print "concatenates files"     print     end endif open #filenum,filename:read while not(eof(#filenum)) do     read #filenum,buf     fprint buf endwhile goto lpbadfile print "error on file ";filename   