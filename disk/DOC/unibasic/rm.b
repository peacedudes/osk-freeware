* "quick and dirty" rm program for use with UniBasic Compiler* dim filename:string[12] on error goto badfilelp filename=NextArg if len(filename)=0 then     end endif if filename="-?" or filename="--help" then     print     print "rm filename... filename"     print     print "remove (delete) filename(s) from disk"     print     end endif delete filename goto lpbadfile print "cannot remove ";filename print "cannot remove ";filename