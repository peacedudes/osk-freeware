* this one is like pu4 except output is to printer dim printer:byte dim a$:string[100] dim a:real open #printer,"/p":write print #printer using("^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^","Centered Title") a$="         >>>>>>>>>>>>" a=4.5 print #printer using(a$,str$(a)) a=456.66 print #printer using(a$,str$(a)) print #printer "         ____________" a=4.5+456.66 print #printer using(a$,str$(a))