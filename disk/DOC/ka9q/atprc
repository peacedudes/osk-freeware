# atprc -- a working configuration for ATP, the QWK packet reader.## ATP looks for `atprc' or `.atprc' in your home directory, or in the# directory the ATP environment variable names.  This copy sits with the# documentation, so `ATP=/dd/DOC/ka9q atp' starts with it; copy it to your# own home directory and edit it to keep it.## A SPACE IS REQUIRED ON BOTH SIDES OF THE `=' -- atp.doc says so, and the# parser means it.  Every program named below is on this disk.user = testereditor = vispeller = ispell# Where downloaded packets are read from and reply packets written.mail = /dd/SPOOLreply = /dd/SPOOL# QWK packets are zip archives.  -j drops the pathnames, which is what a# bulletin board expects; -k writes them the way PKZIP would.archiver = zip -jkunarchiver = unzip -xjo# The listing atp runs for `list packets'.qlist = ls -l /dd/SPOOL | lessansi = ongraphics = oncharset = 7bitscreenlen = 24tagstyle = fidoautotag = offtagline = Read on OS-9/68000