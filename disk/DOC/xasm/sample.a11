* sample.a11 -- a 68HC11 program for as11.  Bit manipulation operands on* the 'HC11 are separated by BLANKS, not commas -- see DOC/xasm/asm.doc.*        org     $c000portb   equ     $1004start   ldaa    #$41        staa    portb        ldx     #table        ldab    #4loop    ldaa    0,x        staa    portb        inx        decb        bne     loop        bra     starttable   fcc     "HC11"        end