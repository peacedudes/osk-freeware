* sample.a09 -- a 6809 program for as09.  The 6809 is NOT source-* compatible with the 6800: it spells the accumulators lda/ldb rather* than ldaa/ldab, so as09 rejects sample.a0 and is right to.*        org     $0100start   lda     #$41            an 'A'        sta     $ff00           to the port        ldx     #tableloop    ldb     ,x+        beq     done        stb     $ff00        bra     loopdone    ldy     #count        leax    1,x        switable   fcc     "6809"        fcb     0count   fdb     $0004        end