tmode -w=1 pauseecho "To make this tour work, you must use Microware's shell/mshell"echo "A simple tour to OSK Lua features"echoecho "Now loading runtime engine and Lua compiler"load -d bin/lua bin/runc bin/luacechochd "clients/lib/osk/test"echo "How to pass arguments to a compiled chunk?"echo "Compiling example..."echo "Command line is: luac -x -o args args.lua"luac -x -o args args.luaechoecho "Ok, starting it with 3 arguments"echo "Command line is: " args "'first argument'" second "'and third'"args "first argument" second "and third"echoecho "And now the source code"echolist args.luaecho "The next example tests the OSK library,"echo "using a text script."echo "Command line is: lua osk.lua"echolua osk.luaechoecho "There is a very useful program in this directory named dren.lua"echo "It capitalizes directory names for the whole directory tree,"echo "and vice versa for file names"echo "Now compiling it..."echoluac -x -o dren dren.luadren -?echoecho "I like Lua!"