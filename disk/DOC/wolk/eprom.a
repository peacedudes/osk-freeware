********************************************************************* Wird aufgerufen von rep.c* In d0.w wird die gewuenschte Adresse uebergeben, und das gelesene* Datenbyte returniert. In d1.l wird das Parameterwort uebergeben* (typeset ins MSW geswapt).*                psectvia             equ       $FE5000read_byte:                movem.l   d3-d7,rescue(a6)     * Register retten                move.l    d1,d4         * typeset1 (read)                lsl.l     #8,d0         * adresse shiften                or.l      d0,d4         * ueberlagern                bsr       shiftout      * adresse ausgeben                bsr       shiftin       * Byte reinholen                move.l    d4,d0                movem.l   rescue(a6),d3-d7                rts********************************************************************* Wird aufgerufen von PEP.C* In d0.b wird das zu programierende Datum uebergeben, in d1.w die Adresse* und auf dem Stack die Parameterworte fuer PGM INH und VFYpgm_byte:                       movem.l   d3-d7,rescue(a6)     * Register retten                lsl.l     #8,d1                * Adresse zurechtruecken                move.l   $8(a7),d4             * INH liegt auf Stack                bsr       shiftout                move.l   $4(a7),d4             * PGM liegt auf Stack                or.l      d1,d4                * Adresse einbauen                or.b      d0,d4                * Datum einbauen                bsr       shiftout                move.l    d0,d3                * jetzt 50 ms Pause                move.l    #$80000010,d0        * 12/256-stel = 5 Ticks                OS9       F$Sleep              * Schlafen                move.l    d3,d0                move.l   $8(a7),d4             * INH                or.l      d1,d4                * Adresse einbauen                or.b      d0,d4                * Datum einbauen                bsr       shiftout                move.l   $c(a7),d4             * VFY liegt auf Stack                or.l      d1,d4                * Adresse einbauen                bsr       shiftout                bsr      shiftin                move.l   d4,d0                 * rueckgelesenen Wert                movem.l  rescue(a6),d3-d7                      rts                            * returnieren*********************************************************************  Gibt ein Langwort in d4 seriell ueber PB0 aus*shiftout        moveq     #$1F,d3shiftr          lsr.l     #1,d4                bcc.b     bitlow                bset      #0,via                bra.b     bitoutbitlow          bclr      #0,viabitout          bsr       clock                dbra      d3,shiftr                bsr       strobe                rts         ********************************************************************** Liesst ein Datenbyte aus PB3 seriell in d4 ein*shiftin         clr.l     d4                moveq     #7,d3inshift         lsr.b     #1,d4                btst      #3,via                beq.b     shclock                bset      #7,d4shclock         bsr       clock                dbra      d3,inshift                rts********************************************************************** Datenuebernahme fuer Schieberegister*strobe                ori.b     #%100,via                andi.b    #%11111011,via                rts********************************************************************** Takt fuer Schieberegister*clock                ori.b     #%10,via                andi.b    #%11111101,via                rts                                ********************************************************************** Alle Pins auf 'LOW', gruenes LED an*standby:                movem.l  d3-d4,rescue(a6)                move.l   #$8000000,d4                bsr      shiftout                movem.l  rescue(a6),d3-d4                rts*********************************************************************** Initialisiert die Ports von VIA 1*init_via:                move.l  a4,rescue(a6)                lea     via,a4                ori.b   #%111,$4(a4)                andi.b  #%11111000,(a4)                move.l  rescue(a6),a4                rts                vsectrescue:         ds.l       16                ends                ends