RDIR = /h0/RELSDDIR = /h0/DEFSLDIR = /h0/LIBSDIR = /h0/users/tom/csrcADIR = /h0/users/tom/asrcCDIR = /h0/cmdsCFLAGS = -ixt=/r0 -e=1sep: $(RDIR)/sep.r    $(RDIR)/eprom.r  cc $(CFLAGS) $(RDIR)/sep.r  $(RDIR)/eprom.r -f=$(CDIR)/sep >>-err  attr /h0/cmds/sep -pe  ll $(CDIR)/sep$(RDIR)/sep.r:   $(SDIR)/sep.c   $(DDIR)/stdio.h  cc $(CFLAGS) -r=$(RDIR) $(SDIR)/sep.c >>-err$(RDIR)/eprom.r:  $(ADIR)/eprom.a  r68 -o=$(RDIR)/eprom.r $(ADIR)/eprom.a >>-err