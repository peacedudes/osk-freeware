##	demo.mk -- a worked example for `make', small enough to read whole.##		make -f /dd/DOC/make/demo.mk greeting##	TWO THINGS CATCH EVERYBODY HERE.##	1. COMMAND LINES BEGIN WITH A TAB.  That is make's oldest rule.  A#	   rule written `greeting: ; command' on one line, which some makes#	   accept, gets this one as far as "Don't know how to make ;".  And a#	   tab does not survive being typed at this terminal -- SCF expands#	   it -- so a makefile you write by echoing at the shell will not#	   work.  Copy this file and edit it instead.##	2. A RECIPE WITH A SHELL METACHARACTER GOES TO $SHELL.  Where a line#	   has none, make forks the command itself.  Where it has a `>' or a#	   `|', make hands the line to $SHELL, which SYS/login makes ksh, and#	   it runs.  With SHELL set to bash it fails:##	       cat x > y:  (E$PNNF) That path name doesn't lead to a file##	Nothing here needs a compiler, so it runs on this disk as it stands.#	The real default rules -- for cc, r68, f77, pc, mc, flex and bison --#	are in default.mk beside this file, and `make' looks for THAT one#	along your PATH, not in the directory you are in.WHERE = /dd/tmpGREETING = $(WHERE)/greetinggreeting: $(GREETING)$(GREETING):	cp /dd/SYS/motd $(GREETING)clean:	rm $(GREETING)