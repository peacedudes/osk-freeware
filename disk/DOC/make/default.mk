###	This is the OS9 default makefile 'default.mk',#	which has to be placed somewhere along your PATH.##SUFFIXES = .r .c .a .A .ln .f F .l .lnk .mod .sym .def .p .y .h.SUFFIXES : $(SUFFIXES)#	Assembler sectionRC = r68RFLAGS =COMPILE.a = $(RC) $(RFLAGS) $(TARGET_ARCH)COMPILE.A = $(CC) $(RFLAGS) $(CPPFLAGS) $(TARGET_ARCH).a :	$(COMPILE.a) -o=$(RDIR)/$*.r $(SDIR)/$<	$(LINK.c) -f=$(ODIR)/$@ $(RELS)/$*.r.a.r :	$(COMPILE.a) -o=$(RDIR)/$@ $(SDIR)/$<.A :	$(COMPILE.A) -o=$(RDIR)/$*.r $(SDIR)/$<	$(LINK.c) -f=$(ODIR)/$@ $(RELS)/$*.r.A.r :	$(COMPILE.A) -o=$(RDIR)/$@ $(SDIR)/$<#	Linker sectionLC = ccLFLAGS =#	C sectionCC = ccCFLAGS =CPPFLAGS =COMPILE.c= $(CC) $(CFLAGS) $(CPPFLAGS) $(TARGET_ARCH)LINK.c = $(CC) $(CFLAGS) $(CPPFLAGS) $(LFLAGS) $(TARGET_ARCH).c :	$(LINK.c) -f=$(ODIR)/$@ $(SDIR)/$< $(LDLIBS).c.r :	$(COMPILE.c) $(OUTPUT_OPTION) -r=$(RDIR) $(SDIR)/$<.c.ln :	$(LINT.c) $(OUTPUT_OPTION) -i $<#	Fortran 77 sectionFC = f77FFLAGS =COMPILE.f= $(FC) $(FFLAGS) $(TARGET_ARCH)LINK.f = $(FC) $(FFLAGS) $(LFLAGS) $(TARGET_ARCH)COMPILE.F= $(FC) $(FFLAGS) $(CPPFLAGS) $(TARGET_ARCH)LINK.F = $(FC) $(FFLAGS) $(CPPFLAGS) $(LFLAGS) $(TARGET_ARCH).f :	$(LINK.f) -f=$(ODIR)/$@ $(SDIR)/$< $(LDLIBS).f.r :	$(COMPILE.f) $(OUTPUT_OPTION) -r=$(RDIR) $(SDIR)/$<.F :	$(LINK.F) -f=$(ODIR)/$@ $(SDIR)/$< $(LDLIBS).F.r :	$(COMPILE.F) $(OUTPUT_OPTION) -r=$(RDIR) $(SDIR)/$<#	Pascal sectionPC = pcPFLAGS =COMPILE.p = $(PC) $(PFLAGS) $(TARGET_ARCH)LINK.p = $(PC) $(PFLAGS) $(LFLAGS) $(TARGET_ARCH).p :	$(LINK.p) -f=$(ODIR)/$@ $(SDIR)/$< $(LDLIBS).p.r :	$(COMPILE.p) $(OUTPUT_OPTION) -r=$(RDIR) $(SDIR)/$<#	Modula2 sectionM2C = mcM2L = mlM2FLAGS =MODFLAGS =DEFFLAGS =COMPILE.def = $(M2C) $(M2FLAGS) $(DEFFLAGS) $(TARGET_ARCH)COMPILE.mod = $(M2C) $(M2FLAGS) $(MODFLAGS) $(TARGET_ARCH)LINK.mod = $(M2L) $(M2FLAGS) $(LFLAGS) $(TARGET_ARCH).mod :	$(LINK.mod) $@.mod.lnk :	$(COMPILE.mod) $<.def.sym :	$(COMPILE.def) $<#	Lex sectionLEX = flexLEXFLAGS =LEX.l = $(LEX) $(LEXFLAGS) -t.l :	$(LEX.l) $(SDIR)/$< >$(SDIR)/$*.c	$(LINK.c) -f=$(ODIR)/$@ $(SDIR)/$*.c $(LDLIBS).l.c :	$(LEX.l) $(SDIR)/$< >$(SDIR)/$@.l.r :	$(LEX.l) $(SDIR)/$< >$(SDIR)/$*.c	$(COMPILE.c) -r=$(RDIR) $(SDIR)/$*.c.l.ln :	$(LEX.l) $(SDIR)/$< $(SDIR)/>$*.c	$(LINT.c) -o $@ -i $(SDIR)/$*.c#	YACC SectionYACC = bisonYFLAGS =YACC.y = $(YACC) $(YFLAGS).y :	$(YACC.y) $(SDIR)/$<	$(LINK.c) -f=$(ODIR)/$@ $*.c $(LDLIBS).y.h :	$(YACC.y) -d -y $(SDIR)/$<	$(MV) ytab.h -w=$(SDIR)/$@.y.c :	$(YACC.y) $(SDIR)/$<.y.r :	$(YACC.y) $(SDIR)/$<	$(COMPILE.c) -r=$(RDIR) $*.c.y.ln :	$(YACC.y) $(SDIR)/$<	$(LINT.c) -o $@ -i $*.c#	Misc sectionMAKE = makeMV = moveRM = del#	Default directoriesSDIR = .RDIR = .RELS = .ODIR = .