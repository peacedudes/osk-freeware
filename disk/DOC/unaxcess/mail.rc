40 store-macro	select-buffer "Mail Header"	beginning-of-file	set-mark	end-of-file	copy-region	unmark-buffer	select-buffer "Mail Edit"	beginning-of-file	yank	newline	save-file	exit-emacs!endm39 store-macro	!if &equ &len %repl-file 0	    !return	!else	    select-buffer "Mail Reply"	    delete-mode "VIEW"	    end-of-file	    set %last-line $curline	    beginning-of-file	    set-mark	    set %iline $curline	    beginning-of-line*loop		insert-string "> "		set %iline &add %iline 1		set $curline %iline		beginning-of-line		!if &les %iline %last-line		    !goto loop		!endif	    copy-region	    unmark-buffer	    delete-window	    select-buffer "Mail Edit"	    yank	    set %repl-file ""	    delete-buffer "Mail Reply"	!endif!endm		38 store-macro	select-buffer "Mail Edit"	unmark-buffer	select-buffer "Mail Header"	unmark-buffer	exit-emacs!endm;	init for mail run	set $discmd FALSE	set %mail-info &env "MAIL-INFO"	select-buffer "Mail Info"	set %ibuff "Mail Info"	insert-file %mail-info	unmark-buffer	add-mode "VIEW";	write-message &cat "%ibuff = " %ibuff;	set %dummy &gtk	1 split-current-window	4 resize-window	select-buffer "Mail Header"	beginning-of-file	select-buffer %ibuff	beginning-of-file	set $curline 1	set %to #%ibuff	set $curline 2	set %subj #%ibuff	set $curline 3	set %mail-file #%ibuff	set $curline 4	set %repl-file #%ibuff	set $curline 5	set %private &seq #%ibuff "YES"	set $curline 6	set %attribs #%ibuff	select-buffer "Mail Header"	beginning-of-file	insert-string "To: "	insert-string %to	newline	!if %private	    insert-string "Subject (Private): "	!else	    insert-string "Subject: "	!endif	insert-string %subj	newline	!if &not &equ &len %attribs 0	    insert-string "Attributes: "	    insert-string %attribs	    newline	!endif	beginning-of-file	unmark-buffer	next-window	set %welcome "[Emacs ready: ^X^S to save and exit, ^C to abort]"	!if &not &equ &len %repl-file 0	    split-current-window	    select-buffer "Mail Reply"	    insert-file %repl-file	    unmark-buffer	    add-mode "VIEW"	    beginning-of-file	    next-window	    set %welcome "[Emacs ready: ^X^S to save and exit, ^C to abort, ^X^R to quote Mail Reply]"	!endif	select-buffer "Mail Edit"	change-file-name %mail-file	delete-buffer %ibuff	bind-to-key execute-macro-40 ^X^S	bind-to-key execute-macro-38 ^C	bind-to-key execute-macro-39 ^X^R	set $discmd "TRUE"	update-screen	write-message %welcome