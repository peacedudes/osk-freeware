* this one shows:* 1) a literal phrase* 2) a left justified arg which is less than field size* 3) a right justified arg which is less than field size* 4) a centered arg which is less than field size dim a$:string[100] dim b$:string[10] dim c$:string[10] dim d$:string[10] print ".'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'.'" a$="This is a test |<<<<<| |>>>>>|^^^^^^^^|" b$="arg2" c$="arg3" d$="arg4" print using(a$,b$,c$,d$)