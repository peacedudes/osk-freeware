.fill.justify.offset 5.rightmargin 70.pagesize 72.m1 3.m2 2.m3 2.m4 5.ec \.header /Speak/Utility/Speak.footer /Page #//Printed (%)/.in +5.define topic.bold.in -5$1 $2 $3 $4 $5.in +5.en.define endtopic.en.define noform.nojustify.nofill.en.define noformend.justify.fill.en.! Manual created with MWB.! END-OF-MACRO.topic NAMESpeak - A small chat program between two persons.endtopic.topic SYNOPSIS.noformspeak <user>.noformend.endtopic.topic DESCRIPTIONSpeak offers a small dialogue program for two users. It is termcap basedso it is useful to run it on inteligent terminlas. The screen is splitinto two regions. In the upper one you type your text, in the lower oneyou can see what the other one types. To quit this chat just type CTRL-Cor CTRL-E..endtopic.topic ENVIROMENT.noformTERM.in +3The terminal type of the current terminal..in -3.noformend.endtopic.topic AUTHOR.in 0.ce 4Ulrich DessauerKerschensteinerstr. 45, D-8034 GermeringVoice: +49 89 8417811E-Mail: ..!{chiuur|doitcr}!nitmar!ud.endtopic