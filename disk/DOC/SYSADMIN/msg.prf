.fill.justify.offset 5.rightmargin 70.pagesize 72.m1 3.m2 2.m3 2.m4 5.ec \.header /Msg/Utility/Msg.footer /Page #//Printed (%)/.in +5.define topic.bold.in -5$1 $2 $3 $4 $5.in +5.en.define endtopic.en.define noform.nojustify.nofill.en.define noformend.justify.fill.en.! Manual created with MWB.! END-OF-MACRO.topic NAMEMsg - Send a message to another user.endtopic.topic SYNOPSIS.noformmsg <user> [<port>] message.noformend.endtopic.topic DESCRIPTION	Msg sends a message to another user. This user needs a specialprogram to accept this message. Normally this is used for a BBS using.ulMMenuas a user interface..ulMMenucalls.ulmsgto send the message, so.ulmsg should not be called directly by the user..endtopic.topic SEE ALSO.noformMMenu in the TOP Munich Release..noformend.endtopic.topic AUTHOR.in 0.ce 4Ulrich DessauerKerschensteinerstr. 45, D-8034 GermeringVoice: +49 89 8417811E-Mail: ..!{chiuur|doitcr}!nitmar!ud.endtopic