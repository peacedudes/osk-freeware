DEST          = .HDRS          = defs.hCFLAGS        = -iqt=/r0RDIR          = relsLDFLAGS       = -qiLIBS          =LINKER        = ccMAKEFILE      = MakefileOBJS          = closure.r error.r lalr.r lr0.r main.r mkpar.r output.r \                reader.r skeleton.r symtab.r verbose.r warshall.rPRINT         = pr -f -l88PROGRAM       = yaccSRCS          = closure.c error.c lalr.c lr0.c main.c mkpar.c output.c \                reader.c skeleton.c symtab.c verbose.c warshall.c$(PROGRAM):     $(OBJS) $(LIBS)                @echo -n "Linking $(PROGRAM) ... "                @chd $(RDIR);$(LINKER) $(LDFLAGS) $(OBJS) $(LIBS) -fd=../$(PROGRAM)                @attr -ae $(PROGRAM)                @echo "done"closure.r: defs.herror.r: defs.hlalr.r: defs.hlr0.c: defs.hmain.r: defs.hmkpar.r: defs.houtput.r: defs.hreader.r: defs.hskeleton.r: defs.hsymtab.r: defs.hverbose.r: defs.hwarshall.r: defs.h