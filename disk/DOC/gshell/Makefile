RDIR          = RELSCFLAGS        = -q -t=/r0/TMP ODIR	      = /dd/GSHELLEXTHDRS	      =HDRS	      = selectfile.hLDFLAGS	      = -bg -i -q LIBS	      = -l=/dd/lib/termlib.l  LINKER	      = ccPRINT	      = prMake.Date: gshell editor compiler assembler	@touch Make.Dategshell: selectfile.r gshell.r		chd $(RDIR); $(LINKER) $(LDFLAGS) $@.r selectfile.r $(LIBS) -F=$(ODIR)/$@editor: selectfile.r editor.r		chd $(RDIR); $(LINKER) $(LDFLAGS) $@.r selectfile.r $(LIBS) -F=$(ODIR)/$@compiler: selectfile.r compiler.r		chd $(RDIR); $(LINKER) $(LDFLAGS) $@.r selectfile.r $(LIBS) -F=$(ODIR)/$@assembler: selectfile.r assembler.r		chd $(RDIR); $(LINKER) $(LDFLAGS) $@.r selectfile.r $(LIBS) -F=$(ODIR)/$@###gshell.r: selectfile.h gshell.cselectfile.r: selectfile.h selectfile.ceditor.r: selectfile.h editor.ccompiler.r: selectfile.h compiler.cassembler.r: selectfile.h assembler.c