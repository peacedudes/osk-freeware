*********************************************************************************   Makefile - erzeugt folgende Code - Files:                         ********   -----------------------------------------                         ********   1: makefile                                                       ********   2:                                                                ********   3:                                                                ********                                                                     ********   Version:  1.0                                                     ********   1. Aenderung: dd.mm.jj   Grund:                                   ********   2. Aenderung: dd.mm.jj   Grund:                                   ********   3. Aenderung: dd.mm.jj   Grund:                                   ********                                                                     ********                                                                     ********   Beschreibung:                                                     ********   Diese makefile dient zum Compilieren der spooler Programme. Damit ********   werden alle zugehoerigen Files compiliert und gelinkt. Der Erfolg ********   davon kann man dann im makefile.log nachschauen, wenn folgender   ********   Aufruf ausgefuehrt wurde: (make-s>>>makefile.log)^100&            ********                                                                     ********   Copyright by:                                                     ********   Hollenstein Guido  Obere Weidstrasse 8  CH-6343  ROTKREUZ         ********   Tel. 042/64 25 59                       -----------------         ********                                                                     ********   Programmbeginn:  26.02.90         Programmende:  26.02.90         *********************************************************************************RDIR   = /R0/RELS       	# Directory fuer die xxx.r FilesSDIR   = .					# Directory fuer die xxx.c FilesLDIR   = /H0/LIB        	# Directory fuer die xxx.l FilesDDIR   = /H0/DEFS       	# Directory fuer die xxx.h FilesWDIR   = /R0/WORK       	# Directory fuer die tmp und exe FilesRFLAGS = -qs -o=$(WDIR)CFLAGS = -sgixq -t=$(WDIR) -r=$(RDIR)LFLAGS = -sgixq -m=8FILE1  = pr_queueFILE2  = pr_spoolerFILE3  = printall: $(FILE1) $(FILE2) $(FILE3)         TOUCH $(WDIR)/make.date$(FILE1): $(FILE1).r         CHD $(RDIR); CC $(LFLAGS) $(FILE1).r -f=$(WDIR)/$(FILE1)$(FILE1).r: $(FILE1).c printer.h         CC $(CFLAGS) $(FILE1).c$(FILE2): $(FILE2).r         CHD $(RDIR); CC $(LFLAGS) $(FILE2).r -f=$(WDIR)/$(FILE2)$(FILE2).r: $(FILE2).c printer.h         CC $(CFLAGS) $(FILE2).c$(FILE3): $(FILE3).r         CHD $(RDIR); CC $(LFLAGS) $(FILE3).r -f=$(WDIR)/$(FILE3)$(FILE3).r: $(FILE3).c printer.h         CC $(CFLAGS) $(FILE3).c