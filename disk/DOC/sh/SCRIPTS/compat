echo 'sh for OS-9 provides nearly 100% compatibility'echo 'between the Bourne and the Mware shell'echo You may use the '#' symbol to comment a script:echo '# This is a command'echo Partly command and '#partly comment'echo Partly command and #partly comment#echo "By default, the '>>' syntax means append mode"echo 'echo -r ABC >/dd/abcdefghi'echo -r ABC >/dd/abcdefghiecho 'echo -r DEF >>/dd/abcdefghi'echo -r DEF >>/dd/abcdefghiecho 'echo    GHI >>/dd/abcdefghi'echo GHI >>/dd/abcdefghiecho list /dd/abcdefghilist /dd/abcdefghidel /dd/abcdefghiecho "Whenever the '*' symbol is encountered at the beginning of a command,"echo "sh switches to Mware mode".echo '* Now!'* Now!echo "To append, the '>+' syntax must now be used"echo 'echo -r ABC >/dd/abcdefghi'echo -r ABC >/dd/abcdefghiecho 'echo -r DEF >+/dd/abcdefghi'echo -r DEF >+/dd/abcdefghiecho 'echo    GHI >+/dd/abcdefghi'echo GHI >+/dd/abcdefghiecho list /dd/abcdefghilist /dd/abcdefghidel /dd/abcdefghiecho "In Mware mode, the '>>' syntax means redirection to standard error path"echo "'free -? >>/nil' must not produce any output on screen"free -? >>/nilecho "----- (nothing) -----"echo "The '#' symbol switches back to Bourne mode"echo '# Now!'#Now! echo "'free -? 2>/nil' must not produce any output on screen"free -? 2>/nilecho "----- (nothing) -----"