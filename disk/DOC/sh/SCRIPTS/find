## find: find file in directory tree (shell script example)# Written by Carsten Emde (carsten@effo.ch)### u s a g e#usage() {  echo 'Usage: find [<opts>] <file> [<opts>]' 1>&2  echo 'Options:' 1>&2  echo '   -v    verbose' 1>&2  exit 1}## b r o w s e#browse() {  if $verbose  then    echo Searching in directory $1 ...  fi   for i in $1/*                                   # browse through all files  do    testpath=`basename $i`                        # create file name    if test "$testpath" != "*"                    # exclude if empty directory    then      if test -d $i                               # is a directory?      then        if strcmp -c $testpath eq $file         then          found=`echo Found directory "'$i'"`           echo $found        fi        browse $i                                 # browse through next level      else        if strcmp -c $testpath eq $file        then          found=`echo Found file "'$i'"`           echo $found        fi      fi    fi  done}## less than 1 or more than 2 arguments?#if test $# -lt 1 || test $# -gt 2then  usagefi## parse arguments#verbose=falsewhile test $1do  if test $1 = '-?'  then    usage  fi  if test $1 = '-v'  then    verbose=true  else    file=$1  fi  shiftdone## file argument specified?#if test ! $filethen  usagefi## load tools#load basename strcmp## do the job ...#browse $CWD## remove tools from memory#unlink basename strcmp## print message if nothing found#if test ! "$found"then  echo Nothing foundfi