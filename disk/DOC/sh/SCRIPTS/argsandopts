#echo Command line arguments are set if the first argument ofecho the set command does not start with a dash. newarg1=arg1newarg2=-argsnewarg3=+arg3newarg4=[arg4]echo Setting new arguments $newarg1 $newarg2 $newarg3 $newarg4set $newarg1 $newarg2 $newarg3 $newarg4echo "Number of arguments is now $#"echo "Argument #1 is $1"echo "Argument #2 is $2"echo "Argument #3 is $3"echo "Argument #4 is $4"echo#echo Printing all arguments using the "\$* syntax:"echo $*echo#echo "Printing all arguments using the 'for' construct without 'in':"for idoecho $idoneecho#echo "Same as above, but 'do' on the same line:"for i doecho $idoneecho#echo The "\$- variable contains:"echo $-echo Setting option -techo The "\$- variable now contains:"set -t; echo $-; set -ntecho#echo "The 'set' command may be omitted, if Mware shell options are set"-t-ne -e -np -p -t -nt -x -nx -nl -l -v -nvecho "b is default - setting elp" echo The "\$- variable now contains:"echo $-echo#echo "The 'set' command may NOT be omitted, if any other option is set"echo "Otherwise, an error occurs..."-s