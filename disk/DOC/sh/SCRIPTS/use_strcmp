## Example for using the strcmp program in a shell script## The strcmp program was contributed by M.C. Gregorie.#search=xxxstring1=aaaXXXdddstring2=bbbxxxdddstring3=cccyyydddecho "1st example: Comparison case-sensitive"for i in $string1 $string2 $string3do  if strcmp $i ct $search  then    echo String "'$i'" contains "'$search'"     fidoneechoecho "2nd example: Comparison NOT case-sensitive"for i in $string1 $string2 $string3do  if strcmp -c $i ct $search  then    echo String "'$i'" contains "'$search'"  fidone