# Testing empty variables.## 1. Normal sh variables:echo 'Assigning an empty string to a variable:'echo 'shvar=""'shvar=""echo 'The following six lines must be identical:'echo 1. shvar is "'$shvar'"echo 2. shvar is \\047${shvar}\\047echo 3. shvar is "\047"$shvar"\047"echo 4. shvar is '\047'$shvar'\047'echo 5. shvar is "'"$shvar"'"echo 6. shvar is \'$shvar\'if test $shvar = ""thenecho 'O.K. $shvar is an empty variable.' fiif [ $shvar ]thenecho 'ERROR: The empty variable $shvar should return false.'elseecho 'O.K. The empty variable $shvar returns false.'fi## 2. Argumentsecho 'Assuming that this script was started without passing argument #9'echo The 9th argument is \'$9\'if test $9 = ""thenecho 'O.K. $9 is an empty argument.' fiif [ $9 ]thenecho 'ERROR: The empty variable $9 should return false.'elseecho 'O.K. The empty variable $9 returns false.'fi