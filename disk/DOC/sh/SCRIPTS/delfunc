## Internal function#_realdel() {  if [ $1 = -? ]  then    echo "Usage: del [-x] <arg1> [<arg2> ... <argn>]" 2>&1  else    echo -r "Deleting $1 ..."    if ../CMDS/del $1 $2    then      echo " Done."    fi  fi}## Surrogate for system utility del#del() {opt=response=for i do  if [ $i = -? ]  then    _realdel $i    return 1  fi  if [ $i = -x ]  then    opt=$i    continue  fi  accessible=no  if [ -n $opt ]  then    if [ -x $i ]    then      accessible=yes    fi  else    if [ -w $i ]    then      accessible=yes    fi  fi  if [ $accessible = yes ]  then    if [ $response != a ]    then      echo -r "Delete file $i [y/n/a/q]? "      read response    fi    case $response in      y*|Y*)  _realdel $i $opt;;      n*|N*)  ;;      a*)     _realdel $i $opt;;      A*)     _realdel $i $opt              response=a ;;      q*|Q*)  echo "Aborting."              break ;;    esac  else    echo Cannot access $i  fidone}