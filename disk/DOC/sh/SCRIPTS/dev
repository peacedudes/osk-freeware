## dev: display either all devices or only those that match specified pattern#if test $# -eq 0then  echo none  devselse  if test $1 = "-?"  then    echo 'Syntax: dev [<device>]' 1>&2    echo 'Function: search <device> in system device table' 1>&2    echo '          display all devices, if no argument given'  1>&2    exit 1  fi  devs | grep $1fi