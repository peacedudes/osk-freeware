## xcopy: backup one directory to another# Written by Carsten Emde (carsten@effo.ch)### u s a g e#usage() {  echo 'Usage: xcopy <source> <destination>' 1>&2  echo 'Options:' 1>&2  echo '   (none)' 1>&2  exit 1}## m a i n#if test $# -ne 2then  usagefisource=$1destination=$2if strcmp $source bw /then  echo Source \($source\) has fully qualified pathname.else  source=$CWD/$source  echo Fully qualified pathname for source \($source\) created.fiif strcmp $destination bw /then  echo Destination \($destination\) has fully qualified pathname.else  destination=$CWD/$destination  echo Fully qualified pathname for destination \($destination\) created.fiif test ! -d $sourcethen  echo Directory $source does not exist.  exit 1fiif test ! -d $destinationthen  if makdir $destination  then    echo Destination directory $destination created.  else    echo Cannot create destination directory $destination.    exit 1  fifiexport sourceecho Backup from $source to $destination ...cd $destination(cd $source && tar c - *) | tar x - echo Done.