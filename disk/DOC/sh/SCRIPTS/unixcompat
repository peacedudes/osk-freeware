#! /bin/sh# 1. Binary to execute script# sh for OS-9 accepts the above syntax. If the fully qualified# file name does not exist, the base name is tried.echo Executing \'$SHELL\' to fork script $0echo Next line must be '123' # 2. /tmp# sh for OS-9 implicitly replaces redirections to '/tmp' by '/dd/tmp':echo 123 >/tmp/123list /dd/tmp/123del /dd/tmp/123echo There should be no screen output after this line.# 3. /dev/null# sh for OS-9 implicitly replaces redirections to '/dev/null' by '/nil':echo This line must not appear on screen >/dev/null# dir's help message will also not appear on screen dir -? 2>/dev/null