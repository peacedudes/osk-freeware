echo Testing the case construct with a defined environment variablesetenv DEFINED definedcase $DEFINED in  defined)    echo Environment variable '$DEFINED' is "'$DEFINED'." ;;  *)    echo "Error!" ;;esacecho Testing the case construct with an undefined environment variablecase $UNDEFIND in  defined)    echo "Error!" ;;  "")    echo Environment variable '$UNDEFINED' is "'$UNDEFINED'." ;;  *)    echo "Error!" ;;esac