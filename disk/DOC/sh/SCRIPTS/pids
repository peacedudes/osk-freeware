#echo Pid is $$echo Parent is ${~}echo Grandparent is ${~2}echo Great grandparent is ${~3}echo Home directory is ~echo The pid of the login procedure can be obtained from '${~${_sh}}'echo This is how it works: '${~${_sh}}' '->'  '${~'${_sh}'}' '->' ${~${_sh}}echo This trick works on any shell level:echo 'echo Level $_sh: ${~${_sh}}' >/dd/pidlevelsh /dd/pidlevelsh sh /dd/pidlevelsh sh sh /dd/pidlevelsh sh sh sh /dd/pidlevelsh sh sh sh sh /dd/pidleveldel /dd/pidlevel