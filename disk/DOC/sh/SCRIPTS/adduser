#!/bin/shUSERDIR=/dd/USRif test $# != 3 -o ( $# -gt 0 -a $1 = '-?' )then  echo "Usage: $0 <login> <groupnumber> <usernumber>" 1>&2  echo "Function: Create a new user login entry" 1>&2  echo "Options:" 1>&2  echo "    (none)" 1>&2  if test $1 != '-?'  then    echo "Exactly three arguments required" 1>&2  fi  exit 1fi# Are we authorized?if test $.$, != 00then  echo "Sorry, you must be system administrator to use this utility" 1>&2  exit 1fiif test "`cut -d=, -f=1 /dd/SYS/password | grep -i $1`"then  echo "User $1 already defined, please use another login name" 1>&2  exit 1fi# Create the new user's directoryif ! makdir $USERDIR/$1then  error=$?  echo "Cannot create new directory due to " 1>&2  exit $?fi# Include the new user into the system password fileecho "$1,,$2.$3,128,.,$USERDIR/$1,sh -e" >>/dd/SYS/password# Provide standard profile scriptif ! copy /dd/SYS/dot.profile $USERDIR/$1/.profilethen  error=$?  echo "Cannot copy default profile script due to " 1>&2  exit $?fi# Provide standard login scriptif ! copy /dd/SYS/dot.login $USERDIR/$1/.loginthen  error=$?  echo "Cannot copy default login script due to " 1>&2  exit $?fi# Make them available to the noviceif ! chown -o $USERDIR/$1 $USERDIR/$1/.??* -u=$1then  error=$?  echo "Cannot change owner of default login scripts due to " 1>&2  exit $?fiecho "Please assign password:"passwd $1echo "New user $1 created."echo "You may wish to adapt the profile and login scripts to the user's needs."