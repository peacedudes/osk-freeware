# Test the tests ...#EMPTY=""echo shell var \$EMPTY is \'"$EMPTY"\'if test $EMPTYthen  echo Test 1 ERROR \$EMPTY returns trueelse  echo Test 1 passfiecho##TEST="TEST"echo shell var \$TEST is \'"$TEST"\'if test $TESTthen  echo Test 2 passelse  echo Test 2 ERROR \$TEST returns falsefiecho##TEST="TIST"echo shell var \$TEST is \'"$TEST"\'if test $TEST = "TIST"then  echo Test 3 passelse  echo Test 3 ERROR \$TEST is considered unequal to "TIST"fiecho####TEST="TEST"echo shell var \$TEST is \'"$TEST"\'if test $TEST != "TIST"then  echo Test 4 passelse  echo Test 4 ERROR \$TEST is considered equal to "TIST"fiecho##echo Assuming /term to be a ttyif test -t /termthen  echo Test 5 passelse  echo Test 5: /term is not considered to be a tty - this may be wrongfiecho##echo Assuming /dd not to be a ttyif test ! -t /ddthen  echo Test 6 passelse  echo Test 6: /dd is considered to be a tty - this may be wrongfiecho##echo Comparing 2 with 2if test 2 -eq 2then  echo Test 7 passelse  echo Test 7 ERROR 2 is considered unequal to 2 fiecho##echo Comparing whether 100 greater than -4if test 100 -gt -4then  echo Test 8 passelse  echo Test 8 ERROR 100 is not considered larger than -4 fiecho##[ "" ] && echo Test 9 ERROR An empty string must not return false \       || echo Test 9 pass#[ "" != "" ] && echo Test 10 ERROR Comparison of two emtpy strings \           must not return true || echo Test 10 pass##echo Assuming /dd to be a block deviceif test -b /ddthen  echo Test 11 passelse  echo Test 11: /dd is not considered to be a block device - this may be wrongfiecho##echo Assuming dd to be a block device descriptorif test -b ddthen  echo Test 12 passelse  echo Test 12: dd is not considered to be a block device descriptor -  echo          this may be wrongfiecho##echo "Assuming /dd/SYS to refer to a block device descriptor (what else?)"if test -b /dd/SYSthen  echo Test 13 passelse  echo Test 13: /dd/SYS is not considered to refer to a block device -  echo          this is necessarily wrongfiecho##echo Assuming /term not to be a diskif test ! -b /termthen  echo Test 14 passelse  echo Test 14: /term is considered to be a disk - this may be wrongfiecho##echo Assuming /dd/SYS to be a directoryif test -d /dd/SYSthen  echo Test 15 passelse  echo Test 15: /dd/SYS is not considered to be a directory - this may be wrongfiecho##echo Assuming /dd to be a directoryif test -d /ddthen  echo Test 16 passelse  echo Test 16: /dd is not considered to be a directory - this may be wrongfiecho##namedpipe=/pipe/.named.pipeecho Assuming $namedpipe to be a named pipeecho 123 >$namedpipeif test -p $namedpipethen  echo Test 17 passelse  echo Test 17: ERROR $namedpipe is not considered a named pipefilist $namedpipe >/nilecho##notapipe=/dd/startupecho Assuming $notapipe not to be a named pipeif test -p $notapipethen  echo Test 18: ERROR $notapipe is considered a named pipeelse  echo Test 18 passfiecho##str='-f'echo "Comparing a string (equal) that could also be a unary operator ($str)"if test $str = $strthen  echo Test 19 passelse  echo Test 19: ERROR "$str is considered unequal to $str"fiecho##echo "Comparing a string (unequal) that could also be a unary operator ($str)"str='-f'if test $str != $strthen  echo Test 20: ERROR "$str is considered unequal to $str"else  echo Test 20 passfiecho##echo "Testing the -m option for all memory modules"fail=""for i in `mdir -u`  do  if test ! -m $i  then    echo Test 21: "ERROR mdir reports $i but 'test -m' does not find it"    fail=1  fidoneif test -z $failthen  echo Test 21 passfiecho##echo "Testing the -m option ('%%%' cannot be a valid module)"if test -m %%%then  echo Test 22: ERROR module named '%%%' is believed to be availableelse  echo Test 22 passfiecho