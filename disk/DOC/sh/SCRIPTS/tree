## tree: display directory tree (shell script example)# Written by Carsten Emde (carsten@effo.ch)### u s a g e#usage() {  echo 'Usage: tree [<opts>]' 1>&2  echo 'Options:' 1>&2  echo '   (none)' 1>&2  exit 1}## b r o w s e#browse() {  for i in $1/*                       # browse through all files  do    if test $i = $1/\*                # wild card not expanded?    then      echo $indent$indent0'<empty>'   # say that dir is empty    else       indent=$indent0$2               # create this level's indent        if test -d $i                   # is a directory?      then        echo -r $indent#       echo `basename $i`        echo $i        oldindent=$indent        browse $i $indent             # browse through next level        indent=$oldindent      else        echo -r $indent#       echo `basename $i`        echo $i      fi    fi  done}## not exactly one argument?#if test $# -ne 0then  usagefiindent0="\20\20"## do the job ...#browse $CWD