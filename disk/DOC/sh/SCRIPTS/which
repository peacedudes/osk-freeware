#help## which: search module in memory, PATH and standard execution path#        OS-9 version of a standard UNIX tool## Written by Carsten Emde (carsten@effo.ch)##endcmd=$1if test $cmd = '-?' || test $# -ne 1then  echo 'Usage: which <command>' 1>&2; exit 1; fiabsent=true# is module in memory?if test -m $cmdthen  echo "\nMemory module"  mdir -e $1  absent=falsefi# is file in PATH search path?for i in `echo $PATH | tr ':' '\n'`do  if test -f $i/$1  then    echo "\n$i"    dir -e $i/$1    absent=false  fidone# is file in standard execution directory?if test -x $cmdthen  xdir=`pd -x`  echo "\nExecution directory ($xdir)"  dir -ex $1  absent=falsefiif $absentthen  echo program $1 not found  exit 1fiexit 0