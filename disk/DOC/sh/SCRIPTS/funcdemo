func1() {  echo Executing function 1.  if [ $4 ]  then    echo $1 $2 $3 $4.    return 0  fi  return 1}func2() {  echo Executing function 2.  if [ $4 ]  then    echo $1 $2 $3 $4.    return 0  fi  return 2}if test $# -eq 0then  echo "Please use one of 'f1' or 'f2' as first argument." 1>&2  echo "Optionally, a second argument can be specified." 1>&2  exit 1fiif test $1 = "f1"then  if func1 Command line argument $2   then    echo Arguments printed.  else    echo Function $? executed.  fi  exit 0fiif test $1 = "f2"then  if func2 Command line argument $2  then    echo Arguments printed.  else    echo Function $? executed.  fi  exit 0fiecho Illegal argument \'"$1"\' 1>&2exit 1