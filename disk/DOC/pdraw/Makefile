## Makefile to produce "pdraw"#SRCFLAGS=  -r -o -K=0LCLX10LIB = X11LIB = LIB    = SOURCES=  main.c IOread.c parser.c list.c time.c sort.c pif.c \	plotps.c plotX11.cCOMMON= header.hOBJS=     main.r IOread.r parser.r list.r time.r sort.r pif.r \	plotps.r plotNOX.rall:    pdraw pdraw:       $(OBJS) 	cc $(OBJS) $(LIB) -f=pdraw -l=/dd/lib/popen.r -l=/dd/lib/gnulib.lmain.r: main.c $(COMMON) 	cc $(SRCFLAGS) main.cIOread.r: IOread.c $(COMMON) 	cc $(SRCFLAGS) IOread.cparser.r: parser.c $(COMMON) 	cc $(SRCFLAGS) parser.clist.r: list.c $(COMMON) 	cc $(SRCFLAGS) list.ctime.r: time.c $(COMMON) 	cc $(SRCFLAGS) time.csort.r: sort.c $(COMMON) 	cc $(SRCFLAGS) sort.cpif.r: pif.c $(COMMON) 	cc $(SRCFLAGS) pif.cplotX.r: plotX.c $(COMMON) 	cc $(SRCFLAGS) plotX.cplotX11.r: plotX11.c $(COMMON) 	cc $(SRCFLAGS) plotX11.cplotps.r: plotps.c $(COMMON) 	cc $(SRCFLAGS) plotps.c