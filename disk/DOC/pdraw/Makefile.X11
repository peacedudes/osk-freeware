## Makefile to produce "pdraw"#SRCFLAGS=  -c -g X10LIB = -lXX11LIB = -lX11LIB    = -lmSOURCES=  main.c IOread.c parser.c list.c time.c sort.c pif.c \	plotps.c plotX11.cCOMMON= header.h Xdefs.hOBJS=     main.o IOread.o parser.o list.o time.o sort.o pif.o \	plotps.o plotX11.oall:    pdraw pdraw:       ${OBJS} 	cc -o pdraw ${OBJS} ${LIB} ${X11LIB}main.o: main.c ${COMMON} 	cc ${SRCFLAGS} main.cIOread.o: IOread.c ${COMMON} 	cc ${SRCFLAGS} IOread.cparser.o: parser.c ${COMMON} 	cc ${SRCFLAGS} parser.clist.o: list.c ${COMMON} 	cc ${SRCFLAGS} list.ctime.o: time.c ${COMMON} 	cc ${SRCFLAGS} time.csort.o: sort.c ${COMMON} 	cc ${SRCFLAGS} sort.cpif.o: pif.c ${COMMON} 	cc ${SRCFLAGS} pif.cplotX.o: plotX.c ${COMMON} 	cc ${SRCFLAGS} plotX.cplotX11.o: plotX11.c ${COMMON} 	cc ${SRCFLAGS} plotX11.cplotps.o: plotps.c ${COMMON} 	cc ${SRCFLAGS} plotps.clint: 	lint ${SOURCES} clean:	rm -f ${OBJS} *.o dataplot.ps install:	mv pdraw /usr/X11/bin/pdraw	cp pdraw.man /usr/X11/man/mann/pdraw.n##################################################################