## Makefile to produce "pdraw"#SRCFLAGS=  -c -g X10LIB = -lXX11LIB = -lX11LIB    = -lmSOURCES=  main.c IOread.c parser.c list.c time.c sort.c plotps.c pif.c\		plotX11.cCOMMON= header.h Xdefs.hOBJS=     main.o IOread.o parser.o list.o time.o sort.o plotps.o pif.oall:    pdraw pdrawX11pdraw:       ${OBJS} plotX.o	cc -o pdraw ${OBJS} plotX.o ${LIB} ${X10LIB}pdrawX11:       ${OBJS} plotX11.o	cc -o pdrawX11 ${OBJS} plotX11.o ${LIB} ${X11LIB}main.o: main.c ${COMMON} 	cc ${SRCFLAGS} main.cIOread.o: IOread.c ${COMMON} 	cc ${SRCFLAGS} IOread.cparser.o: parser.c ${COMMON} 	cc ${SRCFLAGS} parser.clist.o: list.c ${COMMON} 	cc ${SRCFLAGS} list.ctime.o: time.c ${COMMON} 	cc ${SRCFLAGS} time.csort.o: sort.c ${COMMON} 	cc ${SRCFLAGS} sort.cpif.o: pif.c ${COMMON} 	cc ${SRCFLAGS} pif.cplotX.o: plotX.c ${COMMON} 	cc ${SRCFLAGS} plotX.cplotX11.o: plotX11.c ${COMMON} 	cc ${SRCFLAGS} plotX11.cplotps.o: plotps.c ${COMMON} 	cc ${SRCFLAGS} plotps.clint: 	lint ${SOURCES} clean:	rm -f ${OBJS} *.o dataplot.ps ##################################################################