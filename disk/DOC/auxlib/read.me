I just merge alib[020].l onto the front of the normal MW stuff and don'tbother with remembering special libs.  i.e.:     rename clib.l clib.mw     cat alib.l clib.mw >clib.l     rename clibn.l clibn.mw     cat alib.l clibn.mw >clibn.l     rename clib020.l clib020.mw     cat alib020.l clib020.mw >clib020.l     rename clib020n.l clib020n.mw     cat alib020.l clib020n.mw >clib020n.l     rename clib020h.l clib020h.mw     cat alib020.l clib020h.mw >clib020h.l(or perhaps use merge if you don't have a cat that works)Alternatively you can include with -l=/dd/lib/alib[020].l ahead of thenormal ones.I don't have any sort of docs.  That is perhaps the main reason I don'tdistribute this.  Here is a list of the some of the functions and theirargs.  Running 'rdump -g' may turn up more if I haven't updated thislist recently.  Use any you recoginze; ask if you see something interestingyou don't understand.  They are mainly like my 6809 library and/or Unix.void	_ss_feed(n)int		n;void	_ss_rew()void	_ss_reten()void	_ss_rfm(n)int		n;void	_ss_skip(n)void	_ss_sqd()void	_ss_wfm(n)int		n;void	_dump(string, addr, count)char	*string, *addr;int		count;int		alarm(secs)int		secs;char	*basename(s)char	*s;char	*bsearch(key, base, nel, width, compar)char	*key, *base;int		nel, width;int		(*compar)();int		devtyp(pn)int		pn;bool	isatty(pn)int		pn;int		dup2(src, dest)int		src, dest;void	get_dev(s, buf)char	*s, *buf;int		getopt(argc, argv, optstring)int		argc;char	*argv[];char	*optstring;char	*getwd(wd)char	*wd;int		htoi(s)char	*s;long	htol(s)char	*s;void	itoa(n, s)int		n;char	*s;void	ltoa(n, s)long	n;char	*s;char	*memccpy(s1, s2, c, n)char	*s1, *s2;int		c, n;int		ocreat(name, mode, attr)char	*name;short	mode, attr;/* patmatch now includes character classes like Unix sh - i.e.             *//*      *.[ch] finds *.c or *.h                                            *//*      *.[!ch] finds all but *.c or 