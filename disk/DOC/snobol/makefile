######################### MakeFile for SNOBOL pattern hacking in C## Robert Heller - Created: April 18, 1988 Monday 3:46:53 pm### # # # # # RDIR = RELSCFLAGS = -i -dOSKLFLAGS = -l=rndsno.l -M=20all: rpoem rstory stone poker blackjak rstory2	echo Everything builtfloppy: rndsno.l snobolc.ar	format /d0 -r "-v=SNOBOL4-ish C hacks"    makdir /d0/SNOBOL4	makdir /d0/CMDS    dsave -b=100 -e /d0/snobol4    copy -b=100 /dd/cmds/rpoem /dd/cmds/rstory /dd/cmds/stone /dd/cmds/poker /dd/cmds/blackjak /dd/cmds/rstory2 /dd/cmds/tformat -w=/d0/cmds	del /d0/snobol4/games.menu	dir -r -e /d0snobolc.ar: rndsno.l	ar -u snobolc.ar *.c *.h *.syn *.act rndsno.list makefile readme rstory2 : rstory2.r	cc $(RDIR)/rstory2.r -f=rstory2rstory2.r : rstory2.ctformat : tformat.r	cc $(RDIR)/tformat.r -f=tformattformat.r : tformat.crpoem: rpoem.r rndsno.lrpoem.r: rpoem.c patdef.h rstory: rstory.r rndsno.lrstory.r: rstory.c patdef.h stone: stone.r rndsno.lstone.r: stone.c patdef.h phrase.hpoker: poker.r pokev.r cardpak.r rndsno.l	cc RELS/poker.r RELS/pokev.r RELS/cardpak.r -f=poker $(LFLAGS)poker.r: poker.c patdef.h phrase.h pokev.r: pokev.ccarkpak.r: cardpak.c patdef.h phrase.h blackjak: blackjak.r cardpak.r rndsno.l	cc RELS/blackjak.r RELS/cardpak.r -f=blackjak $(LFLAGS)blackjak.r: blackjak.c patdef.h phrase.hrndsno.l: quest.r rsent.r rselect.r pattern.r genprim.r rperm.r snorand.r \	rndsno.list	merge -z=rndsno.list >-rndsno.lquest.r: quest.c patdef.h phrase.h rsent.r: rsent.c patdef.h rselect.r: rselect.c patdef.h pattern.r: pattern.c patdef.hgenprim.r: genprim.crperm.r: rperm.c patdef.h #	cc -r=$(RDIR) -dDEBUG $(CFLAGS) rperm.csnorand.r: snorand.c