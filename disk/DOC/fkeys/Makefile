RDIR          = RELSCFLAGS        = -q -t=/r0/TMP ODIR	      = /dd/USR/CMDSEXTHDRS	      =HDRS	      =LDFLAGS	      = -bg -i -q LIBS	      =LINKER	      = ccPROGRAM       = fkeysOBJS	      = fkeys.rPRINT	      = prSRCS	      = fkeys.c$(PROGRAM):     $(OBJS) $(LIBS)		chd $(RDIR); $(LINKER) $(LDFLAGS) $(OBJS) $(LIBS) -F=$(ODIR)/$(PROGRAM)index: $(OBJS)		ctags -wx $(HDRS) $(SRCS)print: $(OBJS)		@$(PRINT) $(HDRS) $(SRCS)###fkeys.r: fkeys.cfkeys.c: fkeys.lex	lex fkeys.lex