RDIR          = RELSCFLAGS        = -q -t=/r0/TMP ODIR	      = /dd/USR/CMDSEXTHDRS	      =HDRS	      =LDFLAGS	      = -bg -i -q LIBS	      =LINKER	      = ccPROGRAM       = chardefOBJS	      = chardef.rPRINT	      = prSRCS	      = chardef.c$(PROGRAM):     $(OBJS) $(LIBS)		chd $(RDIR); $(LINKER) $(LDFLAGS) $(OBJS) $(LIBS) -F=$(ODIR)/$(PROGRAM)index: $(OBJS)		ctags -wx $(HDRS) $(SRCS)print: $(OBJS)		@$(PRINT) $(HDRS) $(SRCS)###chardef.r: chardef.cchardef.c: chardef.lex	lex chardef.lex