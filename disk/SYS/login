# SYS/login -- hand this to bash to get a working shell:##     os9exec -r bash /h0/SYS/login     this collection mounted as /h0#     os9exec -r bash /dd/SYS/login     this collection mounted as /dd## bash cannot be told to read a profile, but it DOES read $HOME/.bashrc once# HOME names a real RBF device -- which is why this script sets HOME to this# disk and then hands over to an interactive shell. (On a HOST DIRECTORY# mounted as a device, reading it fails with E$Unit. That is the device, not# bash, and it is one more reason to run from the image.)# Where this disk is mounted, taken from the path this script was invoked by,# so the same file serves every arrangement.ROOT=${0%/SYS/login}case $ROOT in "$0"|"") ROOT=/dd ;; esacHOME=$ROOTTERM=vt100# Some programs ask the environment who you are rather than the password# file. ularn is the clear case: without USER it stops with "Can't find your# logname.  Who Are You?" and never starts. LOGNAME is the other spelling.USER=${USER:-tester}LOGNAME=${LOGNAME:-$USER}# Elm and frm look for your mailbox at $MAIL, then at /dd/SPOOL/MAIL/<user>.# Naming it here means they find it wherever this collection is mounted.MAIL=$ROOT/SPOOL/MAIL/$USERPATH=$ROOT/CMDS:$ROOT/CMDS/GAMES:$ROOT/CMDS/NETPBM:$ROOT/CMDS/UUCP:.TMACDIR=$ROOT/LIBHELPDIR=$ROOT/SYS/HELPSIMPATH=$ROOT/SBPROLOG/MODLIB# pep's character-set tables. pep looks for a -g table in exactly two# places: the name as given, then $PEP/<name>. Without this its -g, -i,# -m and -d conversions have no data to read.PEP=$ROOT/SYS/PEP# 74 programs name /h0/sys/termcap outright, and they read TERMCAP first.# Setting it here is what makes them work with this disk mounted anywhere.TERMCAP=$ROOT/SYS/termcap# With your own OS-9 as /dd, its commands stay reachable -- and its cio is# what the starred programs in DOC/INDEX need.case $ROOT in  /dd) ;;  *)   PATH=$PATH:/dd/CMDS:/dd/CMDS/GAMES ;;esacexport HOME TERM PATH TMACDIR HELPDIR SIMPATH TERMCAP PEP USER LOGNAME MAIL# DO NOT REMOVE THIS cd. It looks like a convenience and it is not: it is# what makes `cd' usable in the shell you are about to get. Where /dd is# not an RBF disk (OS9DISK unset), the FIRST getwd of an interactive shell# aborts it with a bus error -- but here in a script the same failure is# survivable, so spending it now buys a working cd afterwards. Measured# both ways: drop this line and the first `cd' you type kills bash.## The stderr goes to /nil because that failure prints `cd_links: getwd:# cannot access parent directories', which is alarming and means nothing# to the person reading it.builtin cd $ROOT 2>/nil# And pwd cannot be asked where we ended up -- it hangs. See .bashrc.PWD=$ROOTexport PWDecho "OS-9 freeware collection on $ROOT.  DOC/CATEGORIES lists it by purpose."echo "cat and less read; vi_nocio edits; ls, cd and pwd work as they look."exec $ROOT/CMDS/bash -i