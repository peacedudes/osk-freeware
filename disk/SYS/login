# /dd/SYS/login -- hand this to bash to get a working shell:##     os9exec /dd/CMDS/bash /dd/SYS/login## bash on this disk CANNOT read a startup file. Its `.' builtin fails with# E$Unit on every path, so ~/.bashrc, /dd/sys/profile and the rest are never# read however they are named. It CAN run a script given as an argument, and# a script can export what it likes and then hand over to an interactive# shell -- which is all this is.HOME=/ddTERM=vt100PATH=/dd/CMDS:/dd/CMDS/GAMES:/h0/CMDS:/h0/CMDS/GAMES:.TMACDIR=/dd/LIBHELPDIR=/dd/SYS/HELPSIMPATH=/dd/SBPROLOG/MODLIBexport HOME TERM PATH TMACDIR HELPDIR SIMPATHecho "PATH covers /dd/CMDS and /h0/CMDS.  DOC/CATEGORIES lists what is here."exec /dd/CMDS/bash -i