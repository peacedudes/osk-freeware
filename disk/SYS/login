# SYS/login -- hand this to bash to get a working shell:##     os9exec -r bash /h0/SYS/login     this collection mounted as /h0#     os9exec -r bash /dd/SYS/login     this collection mounted as /dd## bash cannot be told to read a profile, but it DOES read $HOME/.bashrc once# HOME names a real RBF device -- which is why this script sets HOME to this# disk and then hands over to an interactive shell. (On a HOST DIRECTORY# mounted as a device, reading it fails with E$Unit. That is the device, not# bash, and it is one more reason to run from the image.)# Where this disk is mounted, taken from the path this script was invoked by,# so the same file serves every arrangement.ROOT=${0%/SYS/login}case $ROOT in "$0"|"") ROOT=/dd ;; esacHOME=$ROOTTERM=xterm-256color# Some programs ask the environment who you are rather than the password# file. ularn is the clear case: without USER it stops with "Can't find your# logname.  Who Are You?" and never starts. LOGNAME is the other spelling.USER=${USER:-tester}LOGNAME=${LOGNAME:-$USER}# Elm and frm look for your mailbox at $MAIL, then at /dd/SPOOL/MAIL/<user>.# Naming it here means they find it wherever this collection is mounted.MAIL=$ROOT/SPOOL/MAIL/$USER# EVERY PROGRAM DIRECTORY, not four of them. Seven more were found on# 2026-08-27: TeX, elm, the WN web server, the network and serial-line# sets and the news unpackers were all on the disk and unreachable by# name. `tex' in particular forks `virtex' by bare name and could not# find it.PATH=$ROOT/CMDS:$ROOT/CMDS/GAMES:$ROOT/CMDS/NETPBM:$ROOT/CMDS/UUCPPATH=$PATH:$ROOT/CMDS/TEXCMDS:$ROOT/CMDS/ELM:$ROOT/CMDS/COMMSPATH=$PATH:$ROOT/CMDS/NETWORK:$ROOT/CMDS/NEWS:$ROOT/CMDS/WNPATH=$PATH:$ROOT/CMDS/ADL:$ROOT/CMDS/REBUILTPATH=$PATH:$ROOT/CMDS/DEMOS:$ROOT/CMDS/DHRY:$ROOT/CMDS/GCC139:.TMACDIR=$ROOT/LIBHELPDIR=$ROOT/SYS/HELPSIMPATH=$ROOT/SBPROLOG/MODLIB# pep's character-set tables. pep looks for a -g table in exactly two# places: the name as given, then $PEP/<name>. Without this its -g, -i,# -m and -d conversions have no data to read.PEP=$ROOT/SYS/PEP# 74 programs name /h0/sys/termcap outright, and they read TERMCAP first.# Setting it here is what makes them work with this disk mounted anywhere.TERMCAP=$ROOT/SYS/termcap# SHELL is set for bash and for programs that read it themselves.  It is NOT# what makes system() work, and this comment said otherwise until 2026-09-11.## Microware's C library system() forks the bare module name `shell' and never# reads $SHELL at all.  Traced with a probe under `os9exec -d 0x0002': F$Fork# is handed the string "shell" from a compiled-in constant and answers E_MNF,# because nothing here is called `shell' -- the five shells are bash, ksh, sh,# gshell and mshell.  Nothing runs and system() returns junk that moves from# run to run.  SHELL set to ksh, to sh, to Microware's own shell, or unset# entirely, all give the identical result.## The old claim that tex, latex, eo and maketexpk do nothing without this line# is also false: all four give identical output with SHELL unset.  The one# program measurably affected is m4, whose syscmd is silent without a `shell'# module.  DOC/README-SHELLS carries the whole measurement.SHELL=$ROOT/CMDS/ksh# Mount your own OS-9 system as /h1 and its commands come along on PATH:# runb for the BASIC09 programs, the shell the ones which shell out reach# through, r68 and l68 to finish a Fortran or assembly build, cc to compile# -- the Microware pieces this collection leans on but does not carry.  The# collection is /dd and its hard-link /h0, so /h1 is where your system goes,# clear of both.  A PATH entry for a device you did not mount is simply# ignored, so this costs nothing when you run the collection on its own.PATH=$PATH:/h1/CMDS:/h1/CMDS/GAMESexport HOME TERM PATH TMACDIR HELPDIR SIMPATH TERMCAP PEP USER LOGNAME MAIL SHELL# runb resident when your system is on /h1, so the BASIC09 programs (bio,# blackjack) run by bare name at your own shell and by `runb <name>' here.# Silent and harmless with no /h1 -- load finds nothing and moves on.load /h1/CMDS/runb >/nil 2>/nil# Microware's own shell, if your system is on /h1.  This C library's system()# forks the bare module name `shell' and never reads $SHELL, and nothing on# this disk is called `shell' -- so without this a program that shells out# does nothing and returns a meaningless number.  Loading YOUR shell fixes it# with your own licensed copy; nothing of Microware's is shipped here.# Silent and harmless with no /h1, exactly like the runb load above.load /h1/CMDS/shell >/nil 2>/nil# DO NOT REMOVE THIS cd. It looks like a convenience and it is not: it is# what makes `cd' usable in the shell you are about to get. Where /dd is# not an RBF disk (OS9DISK unset), the FIRST getwd of an interactive shell# aborts it with a bus error -- but here in a script the same failure is# survivable, so spending it now buys a working cd afterwards. Measured# both ways: drop this line and the first `cd' you type kills bash.## The stderr goes to /nil because that failure prints `cd_links: getwd:# cannot access parent directories', which is alarming and means nothing# to the person reading it.builtin cd $ROOT 2>/nil# And pwd cannot be asked where we ended up -- it hangs. See .bashrc.PWD=$ROOTexport PWDecho "OS-9 freeware collection on $ROOT.  DOC/CATEGORIES lists it by purpose."echo "cat and less read; vi_nocio edits; ls, cd and pwd work as they look."exec $ROOT/CMDS/bash -i