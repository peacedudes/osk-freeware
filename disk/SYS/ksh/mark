## Sample (but useful) ksh script## your $ENVI should include the following line:#  alias mark='. /h0/KSHCMDS/mark; mark' go='. /h0/KSHCMDS/mark; go' \#      unmark='. /h0/KSHCMDS/mark; unmark'# to have the functions autoloaded when you need them.# (replace /h0/KSHCMDS by the name of the directory your#  scipts ar living in)#unalias mark go unmarktrap 'mark -s' EXITmark() {    while getopts cslt? opt    do      case $opt in        s) set | egrep '^mark_' > ~/.mark; return 0 ;;        c) for i in `set | sed -n '/^mark_/ s/=.*$//p'`; do unset $i; done; return 0;;        l|t) set | sed -n 's/^mark_/ /p'; return 0 ;;        \?) print "usage: mark [-<opts>] [<mark>]function: (un)mark current directory for later referenceopts:    -s    save current marks to file\t    -l    list marks\t    -c    clear ALL marks\related commands:    unmark <mark>   clear mark <mark>    go <mark>       cd to directory marked by <mark>examples:    mark mydir    go mydir" 1>&2            return 0 ;;      esac    done    export mark_$1=$PWD}go() {    eval cd \$mark_$1}unmark() {    unset mark_$1}set -a. ~/.markset +a