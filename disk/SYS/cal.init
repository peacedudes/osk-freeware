* cal.init* this is an initialization file for cal. This assumes a printout on a laser.# Set the session start string for reset, landscape, 12 cpi-ss=\x1bE\x1b&l1O\x1b(s12H# Session end string = reset-se=\x1bE# printout width = 132 columns-w=132# use big format-b# printer name-p=/p# include holiday information-h# overstrike on/off strings for date number emphasis-os=\x1b(s3B-oe=\x1b(s0B##### end of cal.init #####