## Build the TeX Formats## Explanation: TeX uses "personality files," called "formats" to speed up# it's operation.  The "initex" program reads in a bunch of macro, font,# and symbol definitions, then creates a ".fmt" file.  This file can be# read in by "virtex" very quickly, much more quickly than virtex could# read the original macro files.  The program called "tex" is just a tiny# program that runs "virtex," asking it to read the "plain" format file.# Similarly, "latex" is "virtex &lplain" (The '&' instructs virtex to# read a format file.), and "slitex" is "virtex &splain".## Type "make all" to create all three format files.  Be warned that# Version 3.14 of TeX requires a LOT of memory, so you may have to# re-boot, kill unnecessary processes, and close extra windows in order# to have memory to use it.  (You should be okay if "mfree -e" shows a# single block of at least 1400k.)## You may have to edit this line to indicate where the plain.tex, etc. files are.TEXINPUTS= /dd/sys/tex/inputsall: plain.fmt lplain.fmt splain.fmtplain.fmt: $(TEXINPUTS)/plain.tex	initex plain \dumplplain.fmt: $(TEXINPUTS)/lplain.tex $(TEXINPUTS)/latex.tex $(TEXINPUTS)/lfonts.tex 	initex lplain \dumpsplain.fmt: $(TEXINPUTS)/splain.tex $(TEXINPUTS)/latex.tex $(TEXINPUTS)/lfonts.tex	initex splain \dumpclean:	-del *.log	-del texput.*	-del *_K	