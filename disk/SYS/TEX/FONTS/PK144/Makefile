## Makefile to build standard TeX fonts### I hacked the Beebe "dvioki" driver to use 144dpi fonts, and created a mode# for such fonts.## For reference, here's the mode definition:#% Added by Tim Kientzle (kientzle@math.berkeley.edu) August, 1992#%#mode_def OkidataOneNineTwo =             % Okidata 192 9-pin printer#  mode_param (pixels_per_inch, 144);#  mode_param (aspect_ratio, 1);#  mode_param (blacker, 0);#  mode_param (fillin, 0);#  mode_param (o_correction, .2);#  mode_common_setup_;#enddef;MODE = OkidataOneNineTwoMAG = 1DPI = 144EXT = $(DPI)gfTFMDIR = ../TFMFONTS= cmr10   cmr7   cmr5   cmbx10  cmbx7  cmbx5 \       cmsl10  cmti10 cmtt10 \       cmmi10  cmmi7  cmmi5  cmsy10  cmsy7  cmsy5 \       cmex10## Default is to just build the standard TeX fonts.  The messages tell the# poor user (who's probably never used MetaFont before) what's going on.#texfonts:	@echo It will take me several hours to build the 16 fonts used by	@echo Plain TeX, so please be patient.	@echo (I'll also need quite a bit of memory, so be careful not to	@echo kill me by using up all of the memory.)	@echo	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG); \input *; \end'" $(FONTS)	@echo Convert fonts into PK format to conserve disk space.	cfp "-s=gftopk *.$(EXT)" $(FONTS)	@echo The "tfm" files belong somewhere else, so move them.	@echo Most of these probably already exist, so we'll just overwrite them.	cfp "-s=copy -r *.tfm -w=$(TFMDIR)" $(FONTS)	@echo	@echo 'All done.  If you also want the LaTeX fonts, type "make lfonts".'	@echo To get rid of the log files, the tfm files, and the now-extraneous	@echo 'gf-format files, type "make clean".'## These are just the "basic" LaTeX fonts.  If you need more, (i.e., you've# modified lfonts.tex and rebuilt lplain.fmt) you should add them in the# appropriate place.## One popular alteration is to use "correctly sized" fonts rather than the# scaled ten point fonts defined here.  This probably makes no difference# for low-resolution devices, such as dot-matrix printers, so may not be# worth the effort.  You'll need to create the appropriate .mf driver# files to build them if you want them.#  Note: be careful about the font size if you try this. i.e., 14 pt fonts# for TeX should really be 14.4 pt (10 * 1.2^2), 17pt should really be# 17.28pt (10*1.2^3), etc.  See the "sauter" directory for scripts that# can do this automatically on Unix.## this doesn't include the fonts defined aboveLFONTS = lasy5 cmr6 cmmi6 cmsy6 lasy6 cmti7 lasy7 \	cmr8 cmmi8 cmsy8 cmti8 lasy8 cmr9 cmmi9 cmsy9 cmti9 cmbx9 cmtt9 lasy9 \	cmss10 cmcsc10 lasy10 cmr12 cmmi12 cmti12 cmsl12 cmbx12 cmtt12 cmss12 \	cmr17 line10 linew10 lcircle10 lcirclew10# Plain LaTeX uses magnified 10pt fonts for many things.# Ten points at magstep(.5,1,2,3,4,5) is about 11pt/12pt/14pt/17pt/20pt/25pt# The "true size" comments indicate fonts created by LFONTS above.# We make almost all the basic fonts at 10, 11, and 12 points, and just a few# important ones at 14/17/20/25.LFONTShalf = cmr10 cmmi10 cmsy10 cmti10 cmsl10 cmbx10 cmtt10 cmss10 cmcsc10 lasy10 # true size: cmr12 cmmi12        cmti12 cmsl12 cmbx12 cmtt12 cmss12LFONTSone =               cmsy10                                    cmcsc10 lasy10LFONTStwo =  cmr10 cmmi10 cmsy10               cmbx10                       lasy10# true size: cmr17LFONTSthree =      cmmi10 cmsy10               cmbx10                       lasy10LFONTSfour = cmr10 cmmi10 cmsy10               cmbx10                       lasy10LFONTSfive = cmr10## This takes enormously long, and we aren't building anywhere near all the fonts we could.#lfonts:	@echo Building the standard LaTeX fonts that aren't in Plain TeX.	@echo This may take days...  be patient.	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG); \input *; \end'" $(LFONTS)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(.5); \input *; \end'" $(LFONTShalf)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(1); \input *; \end'" $(LFONTSone)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(2); \input *; \end'" $(LFONTStwo)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(3); \input *; \end'" $(LFONTSthree)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(4); \input *; \end'" $(LFONTSfour)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(5); \input *; \end'" $(LFONTSfive)	cfp "-s=gftopk *" *gf	cfp "-s=copy -r * -w=$(TFMDIR)" *.tfm	@echo If you haven't already, also build the Plain TeX fonts with "make texfonts"## Use true-sized fonts for the standard LaTeX fonts.  This requires modifying# lfonts.tex to load the correct fonts rather than the scaled versions,# and also requires the SAUTER .mf scripts to create correct fonts at these# sizes.  Takes an hour or two of editing to get everything set up.## Note that this only builds the fonts pre-loaded by LaTeX at one# particular installation.  This does not include loaded-on-demand# fonts, nor fonts that may be loaded at another installation.#MYFONTS=cmr5  cmmi5  cmsy5  cmbx5 \	cmr6  cmmi6  cmsy6  cmbx6 \	cmr7  cmmi7  cmsy7  cmbx7  cmti7 \	cmr8  cmmi8  cmsy8  cmbx8  cmti8 \	cmr9  cmmi9  cmsy9  cmbx9  cmti9  cmtt9 \	cmr10 cmmi10 cmsy10 cmbx10 cmti10 cmtt10 cmsl10 cmss10 cmcsc10 cmex10 \	cmr11 cmmi11 cmsy11 cmbx11 cmti11 cmtt11 cmsl11 cmss11 cmcsc11MYFONT2=cmr12 cmmi12 cmsy12 cmbx12 cmti12 cmtt12 cmsl12 cmss12 cmcsc12 \	cmr14 cmmi14 cmsy14 cmbx14 \	cmr17 cmmi17 cmsy17 cmbx17 \	cmr20 cmmi20 cmsy20 cmbx20 \        cmr25 \	lasy5 lasy6  lasy7  lasy8  lasy9  lasy10 \	line10 linew10 lcircle10 lcirclew10# The lasy font must be scaled, until we can put together mf files# to build them at "real" sizes.LASYMAGS= .5 1 2 3 4myfonts:	@echo Building true-sized fonts for LaTeX and TeX	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG); \input *; \end'" $(MYFONTS)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG); \input *; \end'" $(MYFONT2)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=magstep(*); \input lasy10; \end'" $(LASYMAGS)	@echo Now copy the tfm files and clean up.## Delete all the now-unnecessary stuff#clean:	@echo Deleting log files.	-del *.log	@echo Deleting Generic Font files.	-del *gf	@echo Deleting TeX Font Metric files.	-del *.tfm	@echo Deleting editor backup files.	-del *_K