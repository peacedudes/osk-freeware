## Makefile to build standard TeX fonts### The Epson MX/FX and compatible 9-pin printers have a top resolution# of 240 dpi horizontally and 216 dpi vertically.  This non-square# aspect ratio means we need to generate fonts specifically for this# device.  These fonts should probably NOT be stored in the# "PKnnn" directories, in order to avoid confusion.## Note: The dvieps driver has been hacked to first look in this "EPSON"# directory for any fonts.  If it ends up using a font with a square# aspect ratio from another directory, the output may look a little# strange.MODE = epsonMAG = 1DPI = 240EXT = $(DPI)gfTFMDIR = ../TFMFONTS= cmr10   cmr7   cmr5   cmbx10  cmbx7  cmbx5 \       cmsl10  cmti10 cmtt10 \       cmmi10  cmmi7  cmmi5  cmsy10  cmsy7  cmsy5 \       cmex10## Default is to just build the standard TeX fonts.  The messages tell the# poor user (who's probably never used MetaFont before) what's going on.#texfonts:	@echo It will take me several hours to build the 16 fonts used by	@echo Plain TeX, so please be patient.	@echo (I'll also need quite a bit of memory, so be careful not to	@echo kill me by using up all of the memory.)	@echo	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG); \input *; \end'" $(FONTS)	@echo Convert fonts into PK format to conserve disk space.	cfp "-s=gftopk *.$(EXT)" $(FONTS)	@echo The "tfm" files belong somewhere else, so move them.	@echo Most of these probably already exist, so we'll just overwrite them.	cfp "-s=copy -r *.tfm -w=$(TFMDIR)" $(FONTS)	@echo	@echo All done.  If you also want the LaTeX fonts, type "make lfonts".	@echo To get rid of the log files, the tfm files, and the now-extraneous	@echo gf-format files, type "make clean".## These are just the "basic" LaTeX fonts.  If you need more, (i.e., you've# modified lfonts.tex and rebuilt lplain.fmt) you should add them in the# appropriate place.## One popular alteration is to use "correctly sized" fonts rather than the# scaled ten point fonts defined here.  This probably makes no difference# for low-resolution devices, such as dot-matrix printers, so may not be# worth the effort.  You'll need to create the appropriate .mf driver# files to build them if you want them.#  Note: be careful about the font size if you try this. i.e., 14 pt fonts# for TeX should really be 14.4 pt (10 * 1.2^2), 17pt should really be# 17.28pt (10*1.2^3), etc.  See the "sauter" directory for scripts that# can do this automatically on Unix.## this doesn't include the fonts defined aboveLFONTS = lasy5 cmr6 cmmi6 cmsy6 lasy6 cmti7 lasy7 \	cmr8 cmmi8 cmsy8 cmti8 lasy8 cmr9 cmmi9 cmsy9 cmti9 cmbx9 cmtt9 lasy9 \	cmss10 cmcsc10 lasy10 cmr12 cmmi12 cmti12 cmsl12 cmbx12 cmtt12 cmss12 \	cmr17 line10 linew10 lcircle10 lcirclew10# Plain LaTeX uses magnified 10pt fonts for many things.# Ten points at magstep(.5,1,2,3,4,5) is about 11pt/12pt/14pt/17pt/20pt/25pt# The "true size" comments indicate fonts created by LFONTS above.# We make almost all the basic fonts at 10, 11, and 12 points, and just a few# important ones at 14/17/20/25.LFONTShalf = cmr10 cmmi10 cmsy10 cmti10 cmsl10 cmbx10 cmtt10 cmss10 cmcsc10 lasy10 # true size: cmr12 cmmi12        cmti12 cmsl12 cmbx12 cmtt12 cmss12LFONTSone =  cmr10        cmsy10                                    cmcsc10 lasy10LFONTStwo =  cmr10 cmmi10 cmsy10               cmbx10                       lasy10# true size: cmr17LFONTSthree =      cmmi10 cmsy10               cmbx10                       lasy10LFONTSfour = cmr10 cmmi10 cmsy10               cmbx10                       lasy10LFONTSfive = cmr10## This takes enormously long, and we aren't building anywhere near all the fonts we could.#lfonts:	@echo Building the standard LaTeX fonts that aren't in Plain TeX.	@echo This may take days...  be patient.	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG); \input *; \end'" $(LFONTS)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(.5); \input *; \end'" $(LFONTShalf)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(1); \input *; \end'" $(LFONTSone)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(2); \input *; \end'" $(LFONTStwo)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(3); \input *; \end'" $(LFONTSthree)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(4); \input *; \end'" $(LFONTSfour)	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=$(MAG)magstep(5); \input *; \end'" $(LFONTSfive)	cfp "-s=gftopk *" *gf	cfp "-s=copy -r * -w=$(TFMDIR)" *.tfm	@echo If you haven't already, also build the Plain TeX fonts with "make texfonts"## Delete all the now-unnecessary stuff#clean:	@echo Deleting log files.	-del *.log	@echo Deleting Generic Font files.	-del *gf	@echo Deleting TeX Font Metric files.	-del *.tfm	@echo Deleting editor backup files.	-del *_K