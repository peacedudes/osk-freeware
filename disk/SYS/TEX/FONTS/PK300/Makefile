## Makefile to build standard TeX fonts### It is convenient for many reasons to keep magnified 300dpi fonts around.# This makefile will build a set of fonts at the given magnification.#MODE = CanonCXMAGSTEP = 1DPI = 300EXT = $(DPI)gfTFMDIR = ../TFM## This is a list of every font you're ever likely to need at a single magnification (136 fonts).#ALL=	cmr5	cmbx5	cmti5	cmsl5	cmss5	cmcsc5	cmtt5	cmmi5	cmsy5	cmex5	lasy5\	cmr6	cmbx6	cmti6	cmsl6	cmss6	cmcsc6	cmtt6	cmmi6	cmsy6	cmex6	lasy6\	cmr7	cmbx7	cmti7	cmsl7	cmss7	cmcsc7	cmtt7	cmmi7	cmsy7	cmex7	lasy7\	cmr8	cmbx8	cmti8	cmsl8	cmss8	cmcsc8	cmtt8	cmmi8	cmsy8	cmex8	lasy8\	cmr9	cmbx9	cmti9	cmsl9	cmss9	cmcsc9	cmtt9	cmmi9	cmsy9	cmex9	lasy9\	cmr10	cmbx10	cmti10	cmsl10	cmss10	cmcsc10	cmtt10	cmmi10	cmsy10	cmex10	lasy10\	cmr11	cmbx11	cmti11	cmsl11	cmss11	cmcsc11	cmtt11	cmmi11	cmsy11	cmex11	lasy11\	cmr12	cmbx12	cmti12	cmsl12	cmss12	cmcsc12	cmtt12	cmmi12	cmsy12	cmex12	lasy12\	cmr14	cmbx14	cmti14	cmsl14	cmss14	cmcsc14	cmtt14	cmmi14	cmsy14	cmex14	lasy14\	cmr17	cmbx17	cmti17	cmsl17	cmss17	cmcsc17	cmtt17	cmmi17	cmsy17	cmex17	lasy17\	cmr20	cmbx20	cmti20	cmsl20	cmss20	cmcsc20	cmtt20	cmmi20	cmsy20	cmex20	lasy20\	cmr25	cmbx25	cmti25	cmsl25	cmss25	cmcsc25	cmtt25	cmmi25	cmsy25	cmex25	lasy25\	line10	linew10	lcircle10	lcirclew10## These are the 16 fonts preloaded by Plain TeX#TFONTS=	cmr5	cmbx5						cmmi5	cmsy5 \	cmr7	cmbx7						cmmi7	cmsy7 \	cmr10	cmbx10	cmti10	cmsl10			cmtt10	cmmi10	cmsy10	cmex10## These are the fonts used at "true-size" in LaTeX#LFONTS=	cmr5	cmbx5						cmmi5	cmsy5		lasy5 \	cmr6							cmmi6	cmsy6		lasy6 \	cmr7	cmbx7	cmti7					cmmi7	cmsy7		lasy7 \	cmr8		cmti8					cmmi8	cmsy8		lasy8 \	cmr9	cmbx9					cmtt9	cmmi9	cmsy9		lasy9 \	cmr10	cmbx10	cmti10	cmsl10	cmss10	cmcsc10	cmtt10	cmmi10	cmsy10	cmex10	lasy10 \	cmr12	cmbx12	cmti12	cmsl12	cmss12		cmtt12	cmmi12	cmsy12	cmex12	\	cmr14 \	cmr17	line10	linew10	lcircle10	lcirclew10## Default is to just build the standard TeX fonts.  The messages tell the# poor user (who's probably never used MetaFont before) what's going on.#texfonts:	@echo It will take me several hours to build the 16 fonts used by	@echo Plain TeX, so please be patient.	@echo (I'll also need quite a bit of memory, so be careful not to	@echo kill me by using up all of the memory.)	@echo	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=magstep($(MAGSTEP)); \input *; \end'" $(TFONTS)	@echo Convert fonts into PK format to conserve disk space.	cfp "-s=gftopk *.$(EXT)" $(FONTS)	@echo The "tfm" files belong somewhere else, so move them.	@echo Most of these probably already exist, so we'll just overwrite them.	cfp "-s=copy -r *.tfm -w=$(TFMDIR)" $(FONTS)	@echo	@echo All done.  If you also want the LaTeX fonts, type "make lfonts".	@echo To get rid of the log files, the tfm files, and the now-extraneous	@echo gf-format files, type "make clean".lfonts:	@echo Building the 58 standard LaTeX fonts that aren't in Plain TeX.	@echo This may take days...  be patient.	cfp "-s=virmf '&cmbase \mode:=$(MODE); \batchmode; \mag:=magstep($(MAGSTEP)); \input *; \end'" $(LFONTS)	cfp "-s=gftopk *" *gf	cfp "-s=copy -r * -w=$(TFMDIR)" *.tfm	@echo If you haven't already, also build the Plain TeX fonts with "make texfonts"## Delete all the now-unnecessary stuff#clean:	@echo Deleting log files.	-del *.log	@echo Deleting Generic Font files.	-del *gf	@echo Deleting TeX Font Metric files.	-del *.tfm	@echo Deleting editor backup files.	-del *_K