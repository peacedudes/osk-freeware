PROCEDURE MakeFont(* This is a short Basic program which automates some of *)(* the hassle of building new fonts.  It allows you to *)(* specify the base font and the size (in pts, dpi, or *)(* magstep), and then proceeds to build an appropriate *)(* directory if one doesn't already exist, runs MetaFont *)(* to build a TFM and GF file, runs GFtoPK to convert the *)(* font into PK format, sets all the relevant attributes *)(* to public read, and finally deletes the now-extraneous *)(* GF file and the log file. *)DIM fontdir$:STRING[80]DIM printer$:STRING[80]DIM targetdir$:STRING[80]DIM printerresolution:REALDIM base$:STRING[80]DIM mfcmd$:STRING[500]DIM magstep:REAL(* ========================= Customize here ========================= *)(* Fonts are actually kept in subdirectories of *)(* this directory. *)fontdir$="/DD/SYS/TEX/FONTS"(* Set this to the printer mode name, as defined *)(* in "modes.mf". *)printer$="CanonCX"(* The horizontal resolution of the printer, in *)(* dots per inch *)printerresolution=300(* If the printer has non-square aspect ratio, *)(* i.e., the horizontal and vertical resolutions *)(* are different, then set this to a particular *)(* subdirectory where the fonts will be stored. *)(* E.g., for EpsonMXFX-compatible printers, *)(* set this to "EPSON". *)(* If your printer has square aspect ratio, leave *)(* this empty. *)targetdir$=""(* METAFONT base file to be used *)base$="plain"(* ========================= Program start ========================= *)INPUT "Name of font [e.g., cmr8]: ",fontname$INPUT "Size to make font [e.g., 9pt, magstep3, 518dpi]: ",size$(* Decide which size format was used, and *)(* set up targetres and the magnification string *)(* to give METAFONT *)IF size$="" THENtargetres = printerresolutionmag$="magstep(0)"ELSEIF LEFT$(size$,7)="magstep" THENmagstep=VAL(MID$(size$,8,5))targetres=printerresolution*1.2^magstepmag$="magstep("+STR$(magstep)+")"ELSEIF RIGHT$(size$,2)="pt" THENi=LEN(fontname$)WHILE MID$(fontname$,i,1)>="0" AND MID$(fontname$,i,2)<="9" DOi=i-1ENDWHILEtargetres=printerresolution*VAL(size$)targetres=targetres/VAL(MID$(fontname$,i+1,5))mag$=STR$(VAL(size$))+"/"+MID$(fontname$,i+1,5)ELSEIF RIGHT$(size$,3)="dpi" THENtargetres=VAL(size$)mag$=STR$(targetres)+"/"+STR$(printerresolution)ELSEPRINT "Size specifier must be one of 'pt', 'magstep', or 'dpi'."ENDENDIFENDIFENDIFENDIF(* Convert the target resolution into a string *)(* suitable for building the gf filename *)targetres$=STR$(INT(targetres+.5))targetres$=LEFT$(targetres$,LEN(targetres$)-1)(* Now, build the filenames we'll need *)pkname$=fontname$+"."+targetres$+"pk"gfname$=fontname$+"."+targetres$+"gf"logname$=fontname$+".log"tfmname$=fontname$+".tfm"(* Square aspect ratio fonts are *)(* stored in PKxxx dirs, since this is common, *)(* and square printers can share fonts *)IF targetdir$="" THENtargetdir$="PK"+targetres$ENDIF(* Tell the user what we've decided on *)PRINT "Creating font file "+fontdir$+"/"+targetdir$+"/"+pkname$+"."(* Try to Chd to the correct directory *)(* If there's an error, try making the *)(* directory. *)ON ERROR GOTO 120PRINT "chd "+fontdir$+"/"+targetdir$CHD fontdir$+"/"+targetdir$GOTO 140120 errnum=ERRIF errnum<>216 THENPRINT "Error number "; errnum; " trying to chd."ENDENDIFON ERRORPRINT "makdir "+fontdir$+"/"+targetdir$SHELL "makdir "+fontdir$+"/"+targetdir$PRINT "chd "+fontdir$+"/"+targetdir$CHD fontdir$+"/"+targetdir$140 ON ERROR(* Build the METAFONT command line *)mfcmd$="virmf '&"+base$+" \batchmode; \mode:="+printer$+";"mfcmd$=mfcmd$+" \mag:="+mag$+";"mfcmd$=mfcmd$+" \input "+fontname$+"; \end'"(* Run MetaFont *)PRINT mfcmd$SHELL mfcmd$(* Convert the font to PK format *)(* We hope the resolution we computed matches *)(* the resolution that MetaFont computed. *)PRINT "gftopk "+gfname$SHELL "gftopk "+gfname$(* Delete the GF file and log files *)PRINT "del "+gfname$SHELL "del "+gfname$PRINT "del "+logname$SHELL "del "+logname$(* Make sure all users can use this font now *)PRINT "attr -pr -r "+pkname$+" "+tfmname$SHELL "attr -pr -r "+pkname$+" "+tfmname$(* Probably should check to see if the TFM file *)(* already exists in FONTS/TFM, and copy it over if it doesn't. *)(* Need tfmdir$ to be defined in customization section *)(* For now, just leave TFM file behind so user can copy *)(* it if they need to *)(* Sketch of proposed code ... *)(* IF tfmdir$ + "/" + tfmname$ does not exist... THEN *)(* shell "copy " + tfmname$ + "  " + tfmdir$+"/"+tfmname$ *)(* ENDIF *)(* shell "del "+tfmname$ *)END