## Build the Metafont bases## See the Makefile in the Formats directory for more information# about the "personality file" approach used by both TeX and# MetaFont.  MetaFont uses "inimf" to build the "base" files,# and "virmf" reads in the base file to give you a certain# "built-in" set of MetaFont capabilities.## virmf &plain  - This is the MetaFont described in the MetaFontBook# virmf &cmbase - This is used to build the Computer Modern fonts.##MFINPUTS= /dd/sys/tex/mfinputsall: plain.base cmbase.baseplain.base: $(MFINPUTS)/modes.mf $(MFINPUTS)/plain.mf	inimf 'plain; \input modes; dump'	copy plain.base mf.basecmbase.base: $(MFINPUTS)/modes.mf $(MFINPUTS)/cmbase.mf	inimf '&plain cmbase dump'	copy cmbase.base cmmf.baseclean:	-del *.log	-del mfput.*	-del *_K	