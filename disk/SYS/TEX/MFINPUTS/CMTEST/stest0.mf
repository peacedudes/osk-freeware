% try all characters on TEST0.MF using the parameters of cmssbx10if unknown cmbase: input cmbase fi % omit if CMMF can be assumedmode_setup;def generate suffix t= enddef;input cmsx10; font_setup;let echar=endchar;def endchar= echar; stop "done with char "&decimal charcode&". " enddef;let iff=always_iff;input test0;end