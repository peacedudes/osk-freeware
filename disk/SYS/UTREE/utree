##       $HOME/.utree or $UTLIB/utree#       Startup file for UTREE 3.03b-um#       klin, Sun Feb 16 16:12:30 1992#       Directory:      user's home directory  ($HOME)#                       or a library directory ($UTLIB)##       SCCSID = @(#) utree 3.03-um (klin) Feb 16 1992 lib/utree.startup##       Ported to OS-9/68000.  Every command named below is on this#       collection; the Unix example file named a dozen that are not.#       Copy it to $HOME/.utree and it is yours to change -- utree#       reads that first and this only if there is no such file.# General variables: variable=valueHISTSIZE=22                             #Size of history listSHELL=ksh                               #Takes a whole line as one argumentEDITOR=vi                               #mg is here tooPAGER=lessXDUMPER=dump                            #The hex dump here is `dump'BACKUP=/dd/SYS/UTREE/utree.backup       #Named in full: not on PATH# User defined tree commands: variable=value #MenuitemTREECMD1=du -a %d                       #UsageT2=ls -l %d                             #LongT3=ls -R %d                             #Deep# User defined file commands: variable=value #MenuitemFILECMD1=file %f                        #TypeF2=wc %f                                #CountF3=make %s                              #MakeF4=diff %f %s                           #Diff   # Filetype dependent commands: filetype:commandline #Comment*.[1-9]:nroff -man %f | less            #View manual page*.mk:make -f %f %s                      #Call make for file.mk[Mm]akefile:make %s                     #Call make for Makefile or makefile*.a:ar tv %f | less                     #Table of ar archive*.tar:tar tvf %f | less                 #Table of tar archive*.arc:arc l %f | less                   #Table of arc archive*.lzh:lharc l %f | less                 #Table of lharc archive*.Z:compress -d %f                      #Uncompress in place