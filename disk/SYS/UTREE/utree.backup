#!ksh##	$UTLIB/utree.backup#	Backup program for UTREE 3.03b-um on OS-9/68000.## utree's Backup command writes one pathname per line into a list file and# runs this with that file as its only argument.  The distribution names a# backup program and ships none, so this one is written for this collection:# anyone who wants it can have it.## Neither `tar' nor `gtar' here reads a list of names from a file -- the# small tar takes `[ctx][mfv] tarfile file...' and nothing else -- so the# list is expanded onto the command line.## The archive goes where UTREE_BACKUP says, or to utree.tar in your home# directory.  Set it from utree with `=' : BACKUPOPTS is passed through as# a second argument, so##	BK=utree.backup	BO=/dd/tmp/monday.tar## writes there instead.# Run from utree this inherits a PATH; run by hand it may not, and `cat: not# found' is what that looks like.  /dd is where this collection lives.PATH=${PATH:-/dd/CMDS}:/dd/CMDSexport PATHlist=$1out=$2if [ -z "$list" ]; then    echo "Syntax: utree.backup <list file> [<archive>]" >&2    exit 1fiif [ ! -f "$list" ]; then    echo "utree.backup: no list file at $list" >&2    exit 1fiif [ -z "$out" ]; then    out=${UTREE_BACKUP:-$HOME/utree.tar}finames=`cat $list`if [ -z "$names" ]; then    echo "utree.backup: nothing tagged -- the list is empty" >&2    exit 1fiecho "utree.backup: writing $out"tar cvf $out $namesecho "utree.backup: done"