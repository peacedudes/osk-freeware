##       $HOME/.utree-$TERM or $UTLIB/utree-$TERM#       Keybinding file for terminal type $TERM=xterm-256color#       klin, Sun Feb 23 23:31:11 1992#       Directory:      user's home directory  ($HOME)#                       or a library directory ($UTLIB)##       SCCSID = @(#) utree 3.03-um (klin) Feb 23 1992 lib/utree.binding## Key bindings: key_sequence=utree_key_name     #Keyname#               key_sequence="string_to_insert" #Keyname# utree names this file after $TERM, so a terminal of your own wants a# copy under its own name: $HOME/.utree-<TERM> is read before this one.# Arrows, TAB and the letter commands need nothing here -- these are the# keypad and function keys, which no termcap describes.# Bindings for keypad keys (xterm)\eOp=DOWN                               #Keypad-0\eOn=INSERT                             #Keypad-.\eOo=PREVPAGE                           #Keypad-/\eOx=NEXTPAGE                           #Keypad-8\eOj=UP                                 #Keypad-*\eOy=DOWN                               #Keypad-9# Bindings for function keys (xterm)\e[21~=EXIT                             #FunctionKey 10# Bindings that insert a string (xterm)\e[11~="/y"                             #FunctionKey 1\e[12~="!du -a .\n"                     #FunctionKey 2