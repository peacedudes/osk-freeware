ocate memory)  swap initiate r> ;                   ( Perform initialization): new ( -- ptr)    [compile] as                                 ( Take the next symbol, "as")  ?compile make ; immediate            ( And "make" an instance): sizeof ( -- size)    ' >body +size @                      ( Access size of structure)  [compile] literal ; immediate                ( And make literal if compiling): assign ( a b -- )    [compile] sizeof                     ( Access size and assign instance)  ?compile cmove ; immediate: struct.type ( -- struct offset0)    create here 0 0 , 0 ,                ( Allocate initial struct information)  does> create make drop ;             ( Create a new instance): bytes ( offset1 n -- offset2)    over field + ;                       ( Create an access field of "n" bytes): align ( offset1 -- offset2)    dup 1 and + ;                                ( Align field offset to even address): field ( bytes -- )    create , nil ,                       ( Create a predefined field type)  does> @ bytes ; private              ( At run-time create field names): struct ( -- )    [compile] sizeof bytes ;             ( Create a structure sized field name)( Initial set of field names)1 field byte ( -- )2 field word ( -- )4 field long ( -- )4 field ptr  ( -- )4 field enum ( -- ): struct.init ( struct offset3 -- )  align over +size !                   ( Assign size of structure type)  here swap +initiate ! ] ;            ( And pointer to initialization code): struct.does ( -- )   [compile] does>                      ( Do what does-does); immediate compilation: struct.end ( [] or [struct offset3] -- )    compiling                            ( Check compilation status)  if [compile] ;                       ( If compiling then end definition)  else swap +size ! then ; immediate   ( Else assign size of structure type)forth only