field -- )  ." bitfield#" dup .                  ( Print field address)  ." pos: " dup +pos @ .               ( Print position of field)  ." width: " +width @ . ;             ( Print width of field)#ifdef f@  ( Check if the kernel supports field access as a primitive): get ( x field -- y)  dup +pos @ swap +width @ f@ ;                ( Access field structure and data): put ( x y field -- z)  dup +pos @ swap +width @ f! ;                ( Access field structure and modify)#else  ( without field access primitives): mask ( width -- mask)  -1 swap << not ; private             ( Create a mask for access): get ( x field -- y)  dup >r +pos @ >>                     ( Get position and adjust for access)  r> +width @ mask and ;               ( Mask of right part): put ( x y field -- z)  dup >r +width @ mask swap over       ( Create a mask for access)  r@ +pos @ << not and                 ( Remove field)  swap rot and                         ( Mask out part of source)  r> +pos @ << or ;                    ( Adjust position and include)#thenforth only