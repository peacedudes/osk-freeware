.( Loading Queues test...) cr#include queues.f83#include blocks.f83blocks queues.( 1: Create a queue and insert some elements) crQUEUE foofoo print foo ?empty .foo length . crQUEUE fiefie foo intofoo printfoo ?empty .foo length . crQUEUE fumfum foo intofoo printfoo ?empty .foo length . cr.( 2: Print information about all the queue elements) crfoo block[ .queue cr ]; map.( 3: Remove some queue elements) crfie outfoo .queue crfum outfoo .queue cr.( 4: Try the member function) crfoo foo ?member .fie foo ?member .fie foo intofie foo ?member . crforth only