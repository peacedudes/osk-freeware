#!ksh## man -- the librarian: everything this disk has about a program##   man <name>        read it: its manual page, its other documents, one#                     after another -- or, for a program with none, what#                     it says when asked for help#   man -k <word>     which programs are about <word>#   man -f <name>     what <name> is, in a line#   man -w <name>     where each of its documents is, and its source#   man -s <name>     read its source#   man               how to use the library## Every program on this disk has a card in DOC/WHATIS -- a line saying what# it is -- and every document or source file that belongs to it is listed# in DOC/DOCS, one to a line.  Both are generated from the disk itself, so# a program cannot be missing and a path cannot be wrong.  A roff page is# formatted with `nroff -man', everything is read with `less', and several# documents are handed to less together: `:n' goes on to the next, `:p'# comes back.## Each line is read whole and split with `set --': this ksh's `read' does# not fold a run of spaces into one separator, so `read n kind path' on a# line of DOC/DOCS left kind empty, and it has `let' but no arithmetic# expansion (both measured 2026-09-27).  less runs with -f, because a# document drawn in the PC's box characters otherwise stops at `may be a# binary file'.  And only one `while ... done < file' works in a script# here: a later one gets end-of-file at once, so the one loop writes the# cover page's list as it goes.## Written for this collection: anyone who wants it can have it.DOCS=/dd/DOC/DOCSWHATIS=/dd/DOC/WHATISUSAGE=/dd/DOC/USAGET=/dd/tmp/man.$$           # a directory of this run's own: less shows the namesTMACDIR=${TMACDIR:-/dd/LIB}PATH=$PATH:/dd/CMDSexport TMACDIR PATHdesk() {    echo "man -- the librarian for this disk"    echo ""    echo "  man <name>       everything about a program, a document at a time"    echo "  man -k <word>    which programs are about <word>   (man -k chess)"    echo "  man -f <name>    what a program is, in one line"    echo "  man -w <name>    where its documents and source are"    echo "  man -s <name>    read its source"    echo ""    echo "Reading, space pages on, b pages back, /word searches, :n goes to"    echo "the next document and :p comes back.  q leaves."    exit ${1:-0}}# The name as the catalogue spells it -- `MAN Hp' finds hp -- or nothing.lookup() {    line=`grep "^$1 " $WHATIS | head -n 1`    [ -n "$line" ] || line=`grep -i "^$1 " $WHATIS | head -n 1`    set -- $line    echo $1}# No such program: say so, and offer what the catalogue says about the word.unknown() {    echo "man: nothing on this disk is called '$1'" >&2    hits=`grep -i -c "$1" $WHATIS`    if [ "${hits:-0}" -gt 0 ]; then        echo "man: these mention it -- 'man <name>' reads one:" >&2        grep -i "$1" $WHATIS | head -n 12 >&2    else        echo "man: 'man -k <word>' searches what every program does" >&2    fi    exit 1}mode=readwant=while [ $# -gt 0 ]; do    case "$1" in        -k) shift; [ $# -gt 0 ] || desk 1            grep -i "$1" $WHATIS || echo "man: no program is about '$1'" >&2            exit 0 ;;        -f) mode=whatis ;;        -w) mode=where ;;        -s) mode=source ;;        -?|-h) desk ;;        -*) desk 1 ;;        *)  want="$1" ;;    esac    shiftdone[ -n "$want" ] || deskname=`lookup "$want"`[ -n "$name" ] || unknown "$want"what=`grep "^$name " $WHATIS | head -n 1`mkdir -p $T 2>/niltrap "rm -rf $T 2>/nil" 0trap "rm -rf $T 2>/nil; exit 1" 1 2 3 15case $mode in    whatis) echo "$what"; exit 0 ;;    where)  echo "$what"            grep "^$name " $DOCS > $T/list            while read line; do                set -- $line; kind=$2; path=$3                case $kind in                    man) echo "  manual page  /dd/$path" ;;                    doc) echo "  document     /dd/$path" ;;                    src) echo "  source       /dd/$path" ;;                esac            done < $T/list            rm -rf $T            exit 0 ;;esacgrep "^$name " $DOCS > $T/list# What to hand to less, in order: pages to read, or the source to read.files=count=0nsrc=0while read line; do    set -- $line; kind=$2; path=$3    if [ $mode = source ]; then        [ $kind = src ] || continue    else        [ $kind = src ] && { let nsrc=nsrc+1; continue; }    fi    let count=count+1    if [ $kind = man ]; then        page=`basename $path`        nroff -man /dd/$path > $T/$page 2>/nil        files="$files $T/$page"        echo "  $count  /dd/$path   (its manual page)" >> $T/items    else        files="$files /dd/$path"        echo "  $count  /dd/$path" >> $T/items    fidone < $T/listif [ $count -eq 0 ] && [ $mode = source ]; then    rm -rf $T 2>/nil    echo "$what"    echo "man: its source is not on this disk -- SOURCES.txt says why" >&2    exit 1fi# A cover page, when there is more than one thing to read or nothing at# all: what the program is, the documents in the order they follow, and# -- for a program with no document -- what it says when asked for help.if [ $count -ne 1 ]; then    {        echo "$what"        echo ""        if [ $count -eq 0 ]; then            echo "It has no manual here.  Asked for help, it says:"            echo ""            sed -n "/^  $name   (/,/^  [^ ]/p" $USAGE | sed '$d' | sed '1d'        else            [ $mode = source ] && echo "Its source, a file at a time:" \                               || echo "Its documents, in the order they follow this page:"            echo ""            cat $T/items            echo ""            echo "Space pages on, :n goes to the next and :p comes back, q leaves."        fi        if [ $mode = read ] && [ $nsrc -gt 0 ]; then            echo ""            echo "Its source is here too: man -s $name"        fi    } > $T/about-$name    files="$T/about-$name$files"filess -c -f $filesrm -rf $T 2>/nilexit 0