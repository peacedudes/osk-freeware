#!ksh## man -- read one of this disk's manual pages##   man <name>      format the page for <name> and show it a screen at a time#   man -k <word>   list the pages whose name contains <word>#   man -w <name>   print where the page is, instead of reading it## About 300 roff manual pages ship here, one or two to a package directory# under DOC.  DOC/MANPAGES is the index of them -- name, then path -- and# this reads that rather than searching 363 directories.  `nroff -man' does# the formatting and `less' the paging; nroff needs TMACDIR set, which# /dd/startup and SYS/login both do.## Written for this collection: anyone who wants it can have it.INDEX=/dd/DOC/MANPAGESusage() {    echo "Syntax:   man <name>" >&2    echo "Function: read a manual page from this disk" >&2    echo "Options:" >&2    echo "          -k <word>   list the pages whose name contains <word>" >&2    echo "          -w <name>   print where the page is" >&2    exit 1}want=mode=readwhile [ $# -gt 0 ]; do    case "$1" in        -k) shift            [ $# -gt 0 ] || usage            grep -i "$1" $INDEX            exit $?            ;;        -w) mode=where ;;        -?|-h) usage ;;        *)  want="$1" ;;    esac    shiftdone[ -n "$want" ] || usageline=`grep "^$want " $INDEX | head -n 1`if [ -z "$line" ]; then    echo "man: no manual page for '$want'" >&2    echo "man: 'man -k $want' looks for a name containing it" >&2    exit 1fiset -- $linepage=$2if [ "$mode" = where ]; then    echo $page    exit 0finroff -man $page | less