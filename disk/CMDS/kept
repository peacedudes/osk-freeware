#!/dd/CMDS/bash# kept -- what has been taken off the collection onto this disk.## The question the receipt exists to answer: what did this put on my disk?# No awk: the awk here will not take a multi-line program, and a bash loop# reads the receipt perfectly well.C=/dd/CMDSTO=${KEEP_TO:-/dd}RECEIPT=$TO/SYS/keptif ! $C/ls $RECEIPT > /nil 2>/nil; then  echo "nothing has been kept on this disk"  exit 0fin=0; bytes=0; progs=0; last=""while IFS="	" read -r p path size sum; do  if [ -z "$p" ]; then continue; fi  n=`expr $n + 1`  bytes=`expr $bytes + $size`  if [ "$p" != "$last" ]; then progs=`expr $progs + 1`; last=$p; fi  echo "  $p	$path"done < "$RECEIPT"echo ""echo "  $n file(s) from $progs program(s), $bytes bytes"