cond argument to square/2 ***'), $nl, fail)	) ;	($number(X) ->			$b_arith(X,Y,3) ;		       ($print('*** illegal first argument to square/2 ***'), $nl, fail)	).$sin(X, Y) :- var(X) ->	($number(Y) -> $b_arith(X, Y, 5) ;		       ($print('*** illegal second argument to sin/2 ***'), $nl, fail)	) ;	($number(X) ->			$b_arith(X,Y,4) ;		       ($print('*** illegal first argument to sin/2 ***'), $nl, fail)	).$b_arith(X, Y, N) :- '_$builtin'(60).$b_floatc(F,M,E,S) :- '_$builtin'(61).