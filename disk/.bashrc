# /dd/.bashrc -- read by bash when HOME points at this collection.## SYS/login sets HOME to wherever this disk is mounted, and that is what# makes bash read this file. Everything here works with no Microware module# present.PS1='os9$ '# ls reads COLUMNS and rejects whatever bash leaves in it, complaining once# per run. Giving it a width it accepts is the whole fix.COLUMNS=80export COLUMNS# cd and pwd.## bash's getwd() walks `..' upward until it reaches a directory that is its# own parent. OS-9 has one root PER DEVICE and no single root above them, so# that walk has no stopping point: `pwd' hangs the shell outright, and where# /dd is not an RBF device `cd' aborts it with a bus error. Both were# measured, and the hang is the likeliest reason a terminal has to be closed# rather than exited.## So cd works out the path itself, by string, resolving . and .. lexically --# and pwd simply reports what cd recorded. NEVER call `builtin pwd': that is# the hang. `builtin cd' is safe, and is what actually moves.cd() {  local target rest comp out  case ${1-} in    "") target=$HOME ;;    /*) target=$1 ;;    *)  target=$PWD/$1 ;;  esac  out=  rest=${target#/}  while :; do    case $rest in      "")  break ;;      */*) comp=${rest%%/*}; rest=${rest#*/} ;;      *)   comp=$rest; rest= ;;    esac    case $comp in      ""|.) ;;      ..)   out=${out%/*} ;;      *)    out=$out/$comp ;;    esac  done  # There is nothing above a device root, so a `..' too many stays put.  case $out in "") out=$PWD ;; esac  builtin cd "$out" && PWD=$out}pwd() { echo "$PWD"; }alias ll='ls -al'# hack, larn and ularn move into their playground and then look at their# own file by the name they were started as.  This bash starts a program# with the bare word you typed as that name -- where Microware's shell and# ksh pass the full path -- so from the playground `hack' names nothing and# the game stops with "Cannot get status of hack."  Typed here, each word# becomes the full path, and the games start.alias hack="$HOME/CMDS/GAMES/hack"alias larn="$HOME/CMDS/GAMES/larn"alias ularn="$HOME/CMDS/GAMES/ularn"