# /dd/.bashrc -- read by bash when HOME points at this collection.## SYS/login sets HOME to wherever this disk is mounted, and that is what# makes bash read this file. Everything here works with no Microware module# present.PS1='os9$ '# The size of your window.  Every termcap here says 24 lines by 80 columns;# less and the other programs that read LINES and COLUMNS first lay the# screen out to the real size once those two say it.  `resize' asks the# terminal -- any VT100-style terminal answers where its cursor stops in# the bottom right corner -- and prints them.  Drag the window to a new size# and type `resize' again: this function re-reads and exports them.  Where# nothing answers, resize prints nothing and 80 columns stand; ls rejects# the empty COLUMNS bash would otherwise leave, complaining once per run.COLUMNS=80export COLUMNSresize() { eval `$HOME/CMDS/resize`; }resize# cd and pwd.## bash's getwd() walks `..' upward until it reaches a directory that is its# own parent. OS-9 has one root PER DEVICE and no single root above them, so# that walk has no stopping point: `pwd' hangs the shell outright, and where# /dd is not an RBF device `cd' aborts it with a bus error. Both were# measured, and the hang is the likeliest reason a terminal has to be closed# rather than exited.## So cd works out the path itself, by string, resolving . and .. lexically --# and pwd simply reports what cd recorded. NEVER call `builtin pwd': that is# the hang. `builtin cd' is safe, and is what actually moves.cd() {  local target rest comp out  case ${1-} in    "") target=$HOME ;;    /*) target=$1 ;;    *)  target=$PWD/$1 ;;  esac  out=  rest=${target#/}  while :; do    case $rest in      "")  break ;;      */*) comp=${rest%%/*}; rest=${rest#*/} ;;      *)   comp=$rest; rest= ;;    esac    case $comp in      ""|.) ;;      ..)   out=${out%/*} ;;      *)    out=$out/$comp ;;    esac  done  # There is nothing above a device root, so a `..' too many stays put.  case $out in "") out=$PWD ;; esac  builtin cd "$out" && PWD=$out}pwd() { echo "$PWD"; }alias ll='ls -al'# hack, larn and ularn move into their playground and then look at their# own file by the name they were started as.  This bash starts a program# with the bare word you typed as that name -- where Microware's shell and# ksh pass the full path -- so from the playground `hack' names nothing and# the game stops with "Cannot get status of hack."  Typed here, each word# becomes the full path, and the games start.alias hack="$HOME/CMDS/GAMES/hack"alias larn="$HOME/CMDS/GAMES/larn"alias ularn="$HOME/CMDS/GAMES/ularn"# sc, gnuchess, gnuchessn, typefast and yahtzee read TERMCAP as the terminal# description ITSELF, where the other termcap programs here read it as the# name of a file -- SYS/login sets it to the file, SYS/termcap.  So each of# the four is a function that hands its program the description, from# SYS/termcap.entry, for that one run and leaves TERMCAP as it was.# Measured 2026-09-22: every other termcap program on the disk accepts# TERMCAP as a path; these four answer "Unknown terminal type" to it.tcpath=$TERMCAP. $HOME/SYS/termcap.entrytcentry=$TERMCAPTERMCAP=$tcpathexport TERMCAPsc()        { TERMCAP=$tcentry $HOME/CMDS/sc "$@"; }gnuchess()  { TERMCAP=$tcentry $HOME/CMDS/gnuchess "$@"; }gnuchessn() { TERMCAP=$tcentry $HOME/CMDS/gnuchessn "$@"; }typefast()  { TERMCAP=$tcentry $HOME/CMDS/GAMES/typefast "$@"; }yahtzee()   { TERMCAP=$tcentry $HOME/CMDS/GAMES/yahtzee "$@"; }