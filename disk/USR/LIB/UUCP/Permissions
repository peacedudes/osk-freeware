# This is a sample Permissions file, at this time only the following# Entries are supported.## LOGNAME=remote:remote2:remote3#   Remote machines names that use this entry# REQUEST=YES or NO#   YES = Remote can request files, NO = Remote cannot request files# SENDFILE=YES or NO or CALL      #   CALL means 'Send files only when the remote is the caller'#   YES  means 'Send files anytime'#   NO   means 'never send files to this remote'# READ=path#   path = the uppermost level the remote can request files from.#          If you set this to / the remote can request ANY file on#          your system.  The default is the PUBDIR '/DD/SPOOL/UUCPPUBLIC'# WRITE=path#   path = the uppermost level the remote can send file to.#          The default is the PUBDIR# PUBDIR=path#   path = an alternate PUBDIR for this remote# COMMANDS=command1:command2:etc#   Commands this remote can execute that are in the 'Commands' list.#   Set this to ALL if the remote can execute all the commands in the#   'Commands' file.  Default is rmail:rnews#LOGNAME=jimi REQUEST=yes SENDFILE=yes \READ=/DD/SPOOL/UUCPPUBLIC \WRITE=/DD/SPOOL/UUCPPUBLIC \COMMANDS=rmail:rnews