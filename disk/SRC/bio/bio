PROCEDURE bioREM --------------------------------------------------------------------REM Biorhythmus (c) by F.K. 1987 V 2.2eREM --------------------------------------------------------------------ON ERROR GOTO 5DIM Wochentag(7):STRINGDIM Monatstage(12):INTEGERREM --------------------------------------------------------------------REM Daten aus den Datazeilen lesenREM --------------------------------------------------------------------FOR I=1 TO 7READ Wochentag(I)NEXT IFOR I=1 TO 12READ Monatstage(I)NEXT IREM --------------------------------------------------------------------REM DatenREM --------------------------------------------------------------------DATA "Sunday","Monday","Tuesday","Wednesday","Thursday"DATA "Friday","Saturday"DATA 31,28,31,30,31,30,31,31,30,31,30,31REM --------------------------------------------------------------------REM StartREM --------------------------------------------------------------------1 REMPRINT #2PRINT #2,"Biorhythm (c) 1987 by F.Kaefer V2.2e"REM --------------------------------------------------------------------REM Eingabe des heutigen DatumsREM --------------------------------------------------------------------10 REMPRINT #2PRINT #2,"Date [<RETURN> for Systemdate] (DD.MM.YYYY) : ";REM alt:INPUT #0,T,M,JINPUT #0,Dtmp$IF LEN(Dtmp$)<>10 THENREM Systemdatum einsetzenDtmp$=MID$(DATE$,7,2)+"."+MID$(DATE$,4,2)+".19"+LEFT$(DATE$,2)ENDIFT=VAL(LEFT$(Dtmp$,2))M=VAL(MID$(Dtmp$,4,2))J=VAL(RIGHT$(Dtmp$,4))Th=TMh=MJh=JREM --------------------------------------------------------------------REM Eingabe des GeburtstagesREM --------------------------------------------------------------------11 REMPRINT #2,"Birthday (DD.MM.YYYY) : ";REM alt:INPUT #0,T,M,JINPUT #0,Dtmp$IF Dtmp$="" THENDtmp$="06.09.1954"ENDIFIF LEN(Dtmp$)<>10 THENPRINT #2,"Wrong input!"GOTO 11ENDIFT=VAL(LEFT$(Dtmp$,2))M=VAL(MID$(Dtmp$,4,2))J=VAL(RIGHT$(Dtmp$,4))Tg=TMg=MJg=JGOSUB 2Ta=Ta-INT(Ta/7)*7Gtag=Ta+1REM --------------------------------------------------------------------REM Ueberpruefung der EingabenREM --------------------------------------------------------------------IF Jg>Jh THENPRINT #2,"Wrong input!"GOTO 1ENDIFIF Jg=Jh THENIF Mg>Mh THENPRINT #2,"Wrong input!"GOTO 1ENDIFIF Mg=Mh THENIF Tg>Th THENPRINT #2,"Wrong input!"GOTO 1ENDIFENDIFENDIFREM --------------------------------------------------------------------REM Abfrage, ob Kurve oder Tageswerte ausgegeben werden sollenREM --------------------------------------------------------------------20 REMPRINT #2,"Values of today or Graph (v/g) ";INPUT #0,Ausgabeart$IF Ausgabeart$="g" THENGOTO 4ENDIFIF Ausgabeart$<>"v" THENGOTO 20ENDIFREM --------------------------------------------------------------------REM Berechnung der vergangenen TageREM --------------------------------------------------------------------J=JgM=MgT=TgGOSUB 2Tag=TaJ=JhM=MhT=ThGOSUB 2Tah=TaTage=Tah-TagGOSUB 100PRINT #1PRINT #1,"The birthday "; Tg; Mg; Jg; " is a "; Wochentag(Gtag)PRINT #1,"Age in days: "; TageREM --------------------------------------------------------------------REM Berechnung der drei Werte fuer das angegebene DatumREM --------------------------------------------------------------------Phys=INT(50*(1+SIN((Tage/23-INT(Tage/23))*360*PI/180)))Emot=INT(50*(1+SIN((Tage/28-INT(Tage/28))*360*PI/180)))Geist=INT(50*(1+SIN((Tage/33-INT(Tage/33))*360*PI/180)))REM --------------------------------------------------------------------REM Ausgabe der WerteREM --------------------------------------------------------------------PRINT #1,"Biorhythm "; Th; Mh; JhPRINT #1,"Physical:  "; Phys; "%"PRINT #1,"Emotional: "; Emot; "%"PRINT #1,"Mental:   "; Geist; "%"PRINT #1ENDREM --------------------------------------------------------------------REM Unterprogramm zur Berechnung der vergangenen TageREM --------------------------------------------------------------------2 REMTa=0IF M<=2 THENTa=(M-1)*31GOTO 3ENDIFIF J/4=INT(J/4) THENTa=1IF J/100=INT(J/100) THENTa=0IF J/400=INT(J/400) THENTa=1ENDIFENDIFENDIFTa=Ta+INT((306*M-324)/10)3 REMTa=Ta+(J-1)*365+INT((J-1)/4)Ta=Ta-INT((J-1)/100)+INT((J-1)/400)Ta=Ta+TRETURNREM --------------------------------------------------------------------REM Ausgabe einer KurveREM --------------------------------------------------------------------4 REMPRINT #2,"How many days : ";INPUT #0,KtageKtage=Ktage-1DIM Line$(51):STRINGREM --------------------------------------------------------------------REM Berechnung der vergangenen TageREM --------------------------------------------------------------------J=JgM=MgT=TgGOSUB 2Tag=TaJ=JhM=MhT=ThGOSUB 2Tah=TaTage=Tah-TagGOSUB 100PRINT #1PRINT #1,"The birthday "; Tg; Mg; Jg; " is a "; Wochentag(Gtag)PRINT #1,"Age in days: "; TagePRINT #1PRINT #1,TAB(15); "P=Physical, E=Emotional, M=Mental"PRINT #1PRINT #1,TAB(15); "bad condition"; TAB(52); "good condition"REM --------------------------------------------------------------------REM Schleife fuer die Ausgabe der KurveREM --------------------------------------------------------------------FOR Z=Tage TO Tage+KtagePhys=INT(50*(1+SIN((Z/23-INT(Z/23))*360*PI/180)))Emot=INT(50*(1+SIN((Z/28-INT(Z/28))*360*PI/180)))Geist=INT(50*(1+SIN((Z/33-INT(Z/33))*360*PI/180)))REM --------------------------------------------------------------------REM Ausgabe der Werte als KurveREM --------------------------------------------------------------------PRINT #1,Th; Mh; Jh;PRINT #1,TAB(15);Phys=INT(INT(Phys)/2+.5)Emot=INT(INT(Emot)/2+.5)Geist=INT(INT(Geist)/2+.5)P=Phys+1E=Emot+1G=Geist+1REM --------------------------------------------------------------------FOR Cl=1 TO 51Line$(Cl)="."NEXT ClLine$(P)="P"Line$(E)="E"Line$(G)="M"Line$(25)="|"FOR Pl=1 TO 51PRINT #1,Line$(Pl);NEXT PlPRINTREM --------------------------------------------------------------------Th=Th+1IF Th>Monatstage(Mh) THENMh=Mh+1Th=1ENDIFIF Mh>12 THENJh=Jh+1Mh=1ENDIFNEXT ZPRINT #1ENDREM --------------------------------------------------------------------REM Kopf BIORHYTHMUSREM --------------------------------------------------------------------100 REMPRINT #2PRINT #1,TAB(32); "BIORHYTHM"PRINT #1,TAB(32); "========="PRINT #1PRINT #1,TAB(23); "(c) 1987,1988 by F.Kaefer"RETURNREM --------------------------------------------------------------------REM Error RoutineREM --------------------------------------------------------------------5 REMPRINT #2ENDREM --------------------------------------------------------------------REM End of ProgramREM --------------------------------------------------------------------