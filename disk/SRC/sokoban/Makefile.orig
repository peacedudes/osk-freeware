CCOPT= -gOBJECTS= sok.o readscreen.o showscreen.o play.o save.o score.osokoban: $(OBJECTS)	cc $(CCOPT) -o sokoban $(OBJECTS) -lcurses -ltermcapsok.o: sok.c sokoban.h	cc $(CCOPT) -c sok.creadscreen.o: readscreen.c sokoban.h	cc $(CCOPT) -c readscreen.cshowscreen.o: showscreen.c sokoban.h	cc $(CCOPT) -c showscreen.cplay.o: play.c sokoban.h	cc $(CCOPT) -c play.csave.o: save.c sokoban.h	cc $(CCOPT) -c save.cscore.o: score.c sokoban.h	cc $(CCOPT) -c score.c