#	Real syntax MAKEFILE for MAKE##	Using Microsoft 'C' V5.1 & Logical Systems 'MAKE' (older version!)##	Written		10/23/88 by Kirk Bailey (based on MAKEFILE written by#			Greg Yachuk)##	"make"		Compile and link 'MAKE'## MACRO DEFINITIONS:.SUFFIXES:.SUFFIXES: .c.SUFFIXES: .a.SUFFIXES: .rRDIR = CFLAGS =LFLAGS =RFLAGS =SDIR = .ODIR =.RC	= r68CC = gcc2 -DGCC257LC  = $(CC)# angabe der MACRONAMEN der Dirs in denen die files gemaess extend# gesucht werden sollen:. = 	# steht fuer ohne extend.r = RDIR 	# files mit xxx.r werden in : $(RDIR)/xxx.r gesucht !! # compiler on a .C file.#.c.r	:	echo compile $<	$(CC)  $(CFLAGS) -c -o $(RDIR)/$@ $(SDIR)/$<.a.r	:	$(RC) -o=$(RDIR)/$*.r $(RFLAGS) $(SDIR)/$*.a.r		:	# von .r nach ausfuehrbar (kein extend)	echo link $<	$(LC) $(LFLAGS) $(RDIR)/$*.r -f=$(ODIR)/$@.SILENT# End of default.mk