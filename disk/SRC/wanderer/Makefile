# OS-9/68k makefile for wandererRELS = m.r save.r jump.r display.r icon.r game.r read.r help.r fall.r\		scores.r edit.rRDIR = RELSODIR = /h0/cmds/dogCFLAGS = -qixt=/r0LFLAGS = -m=16kLIBS = -l=/dd/lib/curses.l -l=/dd/lib/termlib.l\		-l=/dd/lib/math.l -l=/dd/lib/strings.rwanderer: $(RELS) ./makefile	chd $(RDIR); cc $(CFLAGS) $(LFLAGS) -f=$(ODIR)/wanderer $(RELS) $(LIBS)$(RELS): wand_head.h