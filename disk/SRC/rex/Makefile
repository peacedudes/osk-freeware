# Makefile for remote execution utilities over an os9 network## ODIR is the directory of the sourceODIR = /dd/usr/src/rex# where to install the user programsINSDIR = /dd/usr/cmds# where to install the sysadmin daemons and programsETCDIR = /dd/etc/cmds# define HAS_UTMP if you have an SunOS compatible utmp.hDEFINES = -DREX="$(INSDIR)/rex" -DREXDC="$(ETCDIR)/rexdc" -DHAS_UTMP# compiler flagsCFLAGS = -qix $(DEFINES) #-g# you need net.l from the microware os9-net distribution disk# and a library which contains getpwuid and endpwent,# for example os9lib.l from the top package.#LIBS = -l=/dd/lib/net.l -l=/dd/lib/os9lib.lLIBS = -l=/dd/lib/nfm/net.l -l=/dd/lib/local/uclib.lall: rex rexd rexdc chp remdate	@echo done.rex: rex.r	cc $(CFLAGS) rex.r $(LIBS) -f=$(ODIR)/$@rexd: rexd.r	cc $(CFLAGS) rexd.r -f=$(ODIR)/$@rexdc: rexdc.r	cc $(CFLAGS) rexdc.r $(LIBS) -f=$(ODIR)/$@chp: chp.r	cc $(CFLAGS) chp.r -f=$(ODIR)/$@remdate: remdate.r	cc $(CFLAGS) remdate.r $(LIBS) -f=$(ODIR)/$@install: rex rexd rexdc chp remdate	copy rex chp -rw=$(INSDIR)	chd $(INSDIR); attr -erwpenprnpw rex chp	copy rexd rexdc remdate -rw=$(ETCDIR)	chd $(ETCDIR); attr -erwnpenprnpw rexd rexdc remdateclean:	-del rex rexd rexdc chp remdate *.r *.dbg *.stb