CPP = gccDEBUG = -gCFLAGS = $(DEBUG) -I../Include -I/djgpp/contrib/windows/inc -c -DMESSYDOSODIR = ../binPROGRAM = PrtLablsLFLAGS = $(DEBUG)  -L../Lib -llib -L/djgpp/contrib/windows/lib -lw -lgpp -lpc -lcSRCS = PrtLabls.ccOBJS = PrtLabls.o$(ODIR)/$(PROGRAM) : $(OBJS) ../Lib/liblib.a	$(CPP) $(OBJS) $(LFLAGS) -o $(ODIR)/$(PROGRAM) PrtLabls.o : PrtLabls.cc PrtLabls.h ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/Card.h ../Include/CardRec.h \		../Include/ListRec.h ../Include/PTree.h		$(CPP) $(CFLAGS) PrtLabls.cc -o PrtLabls.oPrtLabls.h : PrtLabls.arg	makeargprc PrtLabls