CPP = gcc2 -Fcc2pluss200 #200 -Fcccp2s200CFLAGS = -I../Include -c -ggSRCS = vBTee.cc vm.cc CardRecord.cc ListRecord.cc CommandScreen.cc \	EditForm.cc ScrollPrompt.cc LLScrollPrompt.cc Terminal.cc \	ParseExpr.y EvalExpr.cc Card.cc PTree.cc LList.ccOBJS = vBTree.r vm.r CardRecord.r ListRecord.r CommandScreen.r \	EditForm.r ScrollPrompt.r LLScrollPrompt.r Terminal.r \	ParseExpr.r EvalExpr.r Card.r PTree.r LList.rLIBR = libr.llibr.l : $(OBJS)	merge $(OBJS) >-libr.l	rdump -l libr.lvm.r : vm.cc ../Include/common.h ../Include/vm.h	$(CPP) $(CFLAGS) vm.cc -o vm.rvBTree.r : vBTree.cc ../Include/common.h ../Include/vm.h ../Include/vBTree.h	$(CPP) $(CFLAGS) vBTree.cc -o vBTree.rCardRecord.r : CardRecord.cc ../Include/common.h ../Include/Card.h \		../Include/CardRecord.h	$(CPP) $(CFLAGS) CardRecord.cc -o CardRecord.rListRecord.r : ListRecord.cc ../Include/common.h ../Include/ListRecord.h	$(CPP) $(CFLAGS) ListRecord.cc -o ListRecord.rCard.r : Card.cc ../Include/common.h ../Include/Card.h	$(CPP) $(CFLAGS) Card.cc -o Card.rLList.r : LList.cc ../Include/common.h ../Include/LList.h	$(CPP) $(CFLAGS) LList.cc -o LList.rPTree.r : PTree.cc ../Include/common.h ../Include/PTree.h	$(CPP) $(CFLAGS) PTree.cc -o PTree.rTerminal.r : Terminal.cc ../Include/common.h ../Include/Terminal.h	$(CPP) $(CFLAGS) Terminal.cc -o Terminal.rCommandScreen.r : CommandScreen.cc ../Include/common.h ../Include/Terminal.h \		../Include/CommandScreen.h	$(CPP) $(CFLAGS) CommandScreen.cc -o CommandScreen.rEditForm.r : EditForm.cc ../Include/common.h ../Include/Terminal.h \		../Include/EditForm.h	$(CPP) $(CFLAGS) EditForm.cc -o EditForm.rScrollPrompt.r : ScrollPrompt.cc ../Include/common.h ../Include/Terminal.h \		../Include/ScrollPrompt.h	$(CPP) $(CFLAGS) ScrollPrompt.cc -o ScrollPrompt.rLLScrollPrompt.r : LLScrollPrompt.cc ../Include/common.h ../Include/Terminal.h \		../Include/LLScrollPrompt.h ../Include/LList.h	$(CPP) $(CFLAGS) LLScrollPrompt.cc -o LLScrollPrompt.rParseExpr.r : ParseExpr.tab.cc ../Include/common.h ../Include/Card.h \	      ../Include/PTree.h	$(CPP) $(CFLAGS) -DYYDEBUG=1 ParseExpr.tab.cc -o ParseExpr.rEvalExpr.r : EvalExpr.cc ../Include/common.h ../Include/Card.h \	      ../Include/PTree.h	$(CPP) $(CFLAGS) EvalExpr.cc -o EvalExpr.rParseExpr.tab.cc : ParseExpr.y	bisonpp -vd ParseExpr.y