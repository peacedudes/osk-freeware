CPP = gccDEBUG = -gCFLAGS = $(DEBUG) -I../Include -I/djgpp/contrib/windows/inc -c -DMESSYDOSSRCS = vbtee.cc vm.cc cardrec.cc listrec.cc cmdscren.cc \	editform.cc scrpmt.cc llscrpmt.cc terminal.cc \	prsexp.y evalexpr.cc card.cc ptree.cc llist.ccOBJS = vbtree.o vm.o cardrec.o listrec.o cmdscren.o \	editform.o scrpmt.o llscrpmt.o terminal.o \	prsexp.o evalexpr.o card.o ptree.o llist.oLIBR = liblib.a$(LIBR) : $(OBJS)	ar rv $(LIBR) $(OBJS)	ranlib $(LIBR)vm.o : vm.cc ../Include/common.h ../Include/vm.h	$(CPP) $(CFLAGS) vm.cc -o vm.ovbtree.o : vbtree.cc ../include/common.h ../include/vm.h ../include/vbtree.h	$(CPP) $(CFLAGS) vbtree.cc -o vbtree.ocardrec.o : cardrec.cc ../Include/common.h ../Include/card.h \		../Include/cardrec.h	$(CPP) $(CFLAGS) cardrec.cc -o cardrec.olistrec.o : listrec.cc ../Include/common.h ../Include/listrec.h	$(CPP) $(CFLAGS) listrec.cc -o listrec.ocard.o : card.cc ../Include/common.h ../Include/card.h	$(CPP) $(CFLAGS) card.cc -o card.ollist.o : llist.cc ../Include/common.h ../Include/llist.h	$(CPP) $(CFLAGS) llist.cc -o llist.optree.o : ptree.cc ../Include/common.h ../Include/ptree.h	$(CPP) $(CFLAGS) ptree.cc -o ptree.oterminal.o : terminal.cc ../Include/common.h ../Include/terminal.h	$(CPP) $(CFLAGS) terminal.cc -o terminal.ocmdscren.o : cmdscren.cc ../Include/common.h ../Include/terminal.h \		../Include/cmdscren.h	$(CPP) $(CFLAGS) cmdscren.cc -o cmdscren.oeditform.o : editform.cc ../Include/common.h ../Include/terminal.h \		../Include/editform.h	$(CPP) $(CFLAGS) editform.cc -o editform.oscrpmt.o : scrpmt.cc ../Include/common.h ../Include/Terminal.h \		../Include/scrpmt.h	$(CPP) $(CFLAGS) scrpmt.cc -o scrpmt.ollscrpmt.o : llscrpmt.cc ../Include/common.h ../Include/terminal.h \		../Include/llscrpmt.h ../Include/llist.h	$(CPP) $(CFLAGS) llscrpmt.cc -o llscrpmt.oprsexp.o : prsexptb.cc ../Include/common.h ../Include/card.h \	      ../Include/ptree.h	$(CPP) $(CFLAGS) -DYYDEBUG=1 prsexptb.cc -o prsexp.oevalexpr.o : evalexpr.cc ../Include/common.h ../Include/card.h \	      ../Include/ptree.h	$(CPP) $(CFLAGS) evalexpr.cc -o evalexpr.o#prsexptb.cc : prsexp.y#	bisonpp -vd prsexp.y