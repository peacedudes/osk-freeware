CPP = gccDEBUG = -gCFLAGS = $(DEBUG) -I../Include -I/djgpp/contrib/windows/inc -c -DMESSYDOSODIR = ../binPROGRAM = Asc2LibrLFLAGS = $(DEBUG) -L../Lib -llib -lgppSRCS = asc2libr.ccOBJS = asc2libr.o$(ODIR)/$(PROGRAM) : $(OBJS) ../Lib/liblib.a	$(CPP) $(OBJS) $(LFLAGS)  -o $(ODIR)/$(PROGRAM) ../lib/liblib.a : 	cd ..\lib\liblib.a	makeasc2libr.o : asc2libr.cc asc2libr.h ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/ListRec.h ../Include/CardRec.h \		../Include/Card.h 		$(CPP) $(CFLAGS) asc2libr.cc -o asc2libr.oasc2libr.h : asc2libr.arg	makeargprc asc2libr