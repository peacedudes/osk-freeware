CPP = gccDEBUG = -gCFLAGS = $(DEBUG) -I../Include   -I/djgpp/contrib/windows/inc -c -DMESSYDOSODIR = ../binPROGRAM = LibrariaLFLAGS = $(DEBUG)  -L../Lib -llib -L/djgpp/contrib/windows/lib -lw -lgpp -lpcSRCS = Libraria.ccOBJS = Libraria.o$(ODIR)/$(PROGRAM) : $(OBJS) ../Lib/liblib.a	$(CPP) $(OBJS) $(LFLAGS) -o $(ODIR)/$(PROGRAM) Libraria.o : Libraria.cc Libraria.h ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/ListRec.h ../Include/CardRec.h \		../Include/Card.h ../Include/Terminal.h \		../Include/CmdScren.h ../Include/ScrPmt.h \		../Include/LLScrPmt.h ../Include/LList.h		$(CPP) $(CFLAGS) Libraria.cc -o Libraria.oLibrarian.h : Librarian.arg	makeargprc Librarian