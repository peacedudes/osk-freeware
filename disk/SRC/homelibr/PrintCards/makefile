CPP = gcc2 -Fcc2pluss200 #200 -Fcccp2s200CFLAGS = -I../Include -gg -cODIR = ../CMDSPROGRAM = PrintCardsLFLAGS = -gg -l../Lib/libr.l -lgpp000 -liostream000 -lgcc -los9lib.l  -s 30 -vSRCS = PrintCards.ccOBJS = PrintCards.r$(ODIR)/$(PROGRAM) : $(OBJS) ../Lib/libr.l	$(CPP) $(LFLAGS) $(OBJS) -o $(ODIR)/$(PROGRAM) PrintCards.r : PrintCards.cc PrintCards.h ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/Card.h ../Include/CardRecord.h \		../Include/ListRecord.h ../Include/PTree.h		$(CPP) $(CFLAGS) PrintCards.cc -o PrintCards.rPrintCards.h : PrintCards.arg	makeargprc PrintCards