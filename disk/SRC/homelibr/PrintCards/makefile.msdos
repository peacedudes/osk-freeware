CPP = gccDEBUG = -gCFLAGS = $(DEBUG) -I../Include -I/djgpp/contrib/windows/inc -c -DMESSYDOSODIR = ../binPROGRAM = PrtCardsLFLAGS = $(DEBUG)  -L../Lib -llib -L/djgpp/contrib/windows/lib -lw -lgpp -lpc -lcSRCS = PrtCards.ccOBJS = PrtCards.o$(ODIR)/$(PROGRAM) : $(OBJS) ../Lib/liblib.a	$(CPP) $(OBJS) $(LFLAGS) -o $(ODIR)/$(PROGRAM) PrtCards.o : PrtCards.cc PrtCards.h ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/Card.h ../Include/CardRec.h \		../Include/ListRec.h ../Include/PTree.h		$(CPP) $(CFLAGS) PrtCards.cc -o PrtCards.oPrtCards.h : PrtCards.arg	makeargprc PrtCards