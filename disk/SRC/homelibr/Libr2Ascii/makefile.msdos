CPP = gccDEBUG = -gCFLAGS = $(DEBUG) -I../Include  -I/djgpp/contrib/windows/inc -c -DMESSYDOSODIR = ../binPROGRAM = libr2ascLFLAGS = $(DEBUG) -L../Lib -llib -lgppSRCS = libr2asc.ccOBJS = libr2asc.o$(ODIR)/$(PROGRAM) : $(OBJS) ../Lib/liblib.a	$(CPP) $(OBJS) $(LFLAGS) -o $(ODIR)/$(PROGRAM) libr2asc.o : libr2asc.cc ../Include/common.h ../Include/vm.h \	       ../Include/vBTree.h ../Include/Card.h ../Include/CardRec.h \	       ../Include/ListRec.h Libr2Asc.h		$(CPP) $(CFLAGS) libr2asc.cc -o libr2asc.oLibr2Ascii.h : Libr2Ascii.arg	makeargprc Libr2Ascii