CPP = gcc2 -Fcc2pluss200 #200 -Fcccp2s200CFLAGS = -I../Include -gg -cODIR = ../CMDSPROGRAM = Libr2AsciiLFLAGS = -gg -l../Lib/libr.l -lgpp000 -liostream000 -lgcc  -s 30 -vSRCS = Libr2Ascii.ccOBJS = Libr2Ascii.r$(ODIR)/$(PROGRAM) : $(OBJS) ../Lib/libr.l	$(CPP) $(LFLAGS) $(OBJS) -o $(ODIR)/$(PROGRAM) Libr2Ascii.r : Libr2Ascii.cc ../Include/common.h ../Include/vm.h \	       ../Include/vBTree.h ../Include/Card.h ../Include/CardRecord.h \	       ../Include/ListRecord.h Libr2Ascii.h		$(CPP) $(CFLAGS) Libr2Ascii.cc -o Libr2Ascii.rLibr2Ascii.h : Libr2Ascii.arg	makeargprc Libr2Ascii