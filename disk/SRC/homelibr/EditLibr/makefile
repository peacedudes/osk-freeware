CPP = gcc2 -Fcc2pluss300 #200 -Fcccp2s300CFLAGS = -I../Include -gg -cODIR = ../CMDSPROGRAM = EditLibrLFLAGS = -gg -l../Lib/libr.l -lgpp000 -liostream000 -lgcc  -ltermlib.l -s 30 -vHEADERS = EditDefs.h EditGLob.hSRCS = EditLibr.cc EditCard.cc ListStuff.cc DeleteStuff.ccOBJS = EditLibr.r  EditCard.r  ListStuff.r  DeleteStuff.r$(ODIR)/$(PROGRAM) : $(OBJS) ../Lib/libr.l	$(CPP) $(LFLAGS) $(OBJS) -o $(ODIR)/$(PROGRAM) EditLibr.r : EditLibr.cc EditLibr.h ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/ListRecord.h ../Include/CardRecord.h \		../Include/Card.h ../Include/Terminal.h \		../Include/CommandScreen.h $(HEADERS)		$(CPP) $(CFLAGS) EditLibr.cc -o EditLibr.rEditCard.r : EditCard.cc ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/ListRecord.h ../Include/CardRecord.h \		../Include/Card.h ../Include/Terminal.h \		../Include/CommandScreen.h ../Include/EditForm.h \		$(HEADERS)		$(CPP) $(CFLAGS) EditCard.cc -o EditCard.rListStuff.r : ListStuff.cc ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/ListRecord.h ../Include/CardRecord.h \		../Include/Card.h ../Include/Terminal.h \		../Include/CommandScreen.h ../Include/EditForm.h \		../Include/LLScrollPrompt.h ../Include/LList.h \		$(HEADERS)		$(CPP) $(CFLAGS) ListStuff.cc -o ListStuff.rDeleteStuff.r : DeleteStuff.cc ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/ListRecord.h ../Include/CardRecord.h \		../Include/Card.h ../Include/Terminal.h \		../Include/CommandScreen.h ../Include/ScrollPrompt.h \		$(HEADERS)		$(CPP) $(CFLAGS) DeleteStuff.cc -o DeleteStuff.rEditLibr.h : EditLibr.arg	makeargprc EditLibr