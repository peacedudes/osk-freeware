CPP = gccDEBUG = -gCFLAGS = $(DEBUG) -I../Include -I/djgpp/contrib/windows/inc -c -DMESSYDOSODIR = ../binPROGRAM = EditLibrLFLAGS = $(DEBUG)  -L../Lib -llib -L/djgpp/contrib/windows/lib -lw -lgpp -lpc -lcHEADERS = EditDefs.h EditGLob.hSRCS = EditLibr.cc EditCard.cc LstStuff.cc DelStuff.ccOBJS = EditLibr.o  EditCard.o  LstStuff.o  DelStuff.o exec.o$(ODIR)/$(PROGRAM) : $(OBJS) ../Lib/liblib.a	$(CPP) $(OBJS) $(LFLAGS) -o $(ODIR)/$(PROGRAM) EditLibr.o : EditLibr.cc EditLibr.h ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/ListRec.h ../Include/CardRec.h \		../Include/Card.h ../Include/Terminal.h \		../Include/CmdScren.h $(HEADERS)		$(CPP) $(CFLAGS) EditLibr.cc -o EditLibr.oEditCard.o : EditCard.cc ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/ListRec.h ../Include/CardRec.h \		../Include/Card.h ../Include/Terminal.h \		../Include/CmdScren.h ../Include/EditForm.h \		$(HEADERS)		$(CPP) $(CFLAGS) EditCard.cc -o EditCard.oLstStuff.o : LstStuff.cc ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/ListRec.h ../Include/CardRec.h \		../Include/Card.h ../Include/Terminal.h \		../Include/CmdScren.h ../Include/EditForm.h \		../Include/LLScrPmt.h ../Include/LList.h \		$(HEADERS)		$(CPP) $(CFLAGS) LstStuff.cc -o LstStuff.oDelStuff.o : DelStuff.cc ../Include/common.h \		../Include/vm.h ../Include/vBTree.h \		../Include/ListRec.h ../Include/CardRec.h \		../Include/Card.h ../Include/Terminal.h \		../Include/CmdScren.h ../Include/ScrPmt.h \		$(HEADERS)		$(CPP) $(CFLAGS) DelStuff.cc -o DelStuff.oEditLibr.h : EditLibr.arg	makeargprc EditLibr