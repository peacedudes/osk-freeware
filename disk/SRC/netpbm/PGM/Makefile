# Makefile for pgm tools.## Copyright (C) 1989, 1991 by Jef Poskanzer.## Permission to use, copy, modify, and distribute this software and its# documentation for any purpose and without fee is hereby granted, provided# that the above copyright notice appear in all copies and that both that# copyright notice and this permission notice appear in supporting# documentation.  This software is provided "as is" without express or# implied warranty.# Default values, usually overridden by top-level Makefile.CC= gcc2CFLAGS= -ansi -O -m68000 -ucc -T/r0 -D_OSK -optasmRGBDEF =        -DRGB_DB="""/dd/sys/rgb.txt"""TIFFDEF =       -DLIBTIFFODIR = .LDFLAGS= -L/dd/lib -nocol -m68000 -los9lib.l -ctrapSHELL =    kshINCLUDE =   -I.. -I../PBMALLCFLAGS = $(CFLAGS) $(RGBDEF) $(TIFFDEF) $(INCLUDE)LIBPBM =    ../PBM/libpbm.lLIBPGM =    libpgm.lDEFPGM =    pgm.h ../pbmplus.hBINARIES =  asciitopgm bioradtopgm fstopgm \         hipstopgm lispmtopgm pbmtopgm \         pgmbentley pgmenhance pgmhist pgmkernel \         pgmnoise pgmnorm pgmoil \         pgmramp pgmtofs pgmtolispm pgmtopbm \         psidtopgm rawtopgm spottopgm \         pgmcrater pgmedge pgmtextureOBJECTS =  asciitopgm.r bioradtopgm.r fstopgm.r \         hipstopgm.r lispmtopgm.r pbmtopgm.r \         pgmbentley.r pgmenhance.r pgmhist.r pgmkernel.r \         pgmnoise.r pgmnorm.r pgmoil.r \         pgmramp.r pgmtofs.r pgmtolispm.r pgmtopbm.r \         psidtopgm.r rawtopgm.r spottopgm.r \         pgmcrater.r pgmedge.r pgmtexture.r.c.r:    $(CC) $(CFLAGS) -c -o $*.r $*.call.done:   $(BINARIES)   echo all donemerge:      pbmmergepbmmerge:   pbmmerge.c $(OBJECTS) $(LIBPBM)    $(CC) $(ALLCFLAGS) $(LDFLAGS) -o ../cmds/$@ $@.c $(OBJECTS) $(LIBPBM)# Rules for plain programs.$(BINARIES):    $(DEFPGM) $(LIBPGM)    $(CC) $(ALLCFLAGS) $(LDFLAGS) -o ../cmds/$@ $@.c -l$(LIBPGM) -l$(LIBPBM)$(OBJECTS): $(DEFPGM)    $(CC) $(ALLCFLAGS) "-Dmain=$*_main" -c $*.c# And library.lib:        $(LIBPGM)$(LIBPGM):  libpgm1.r libpgm2.r    merge libpgm1.r libpgm2.r >-$(LIBPGM)libpgm1.r:  $(DEFPGM) ../version.h libpgm.h libpgm1.c    $(CC) $(ALLCFLAGS) -c libpgm1.clibpgm2.r:  $(DEFPGM) ../version.h libpgm.h libpgm2.c    $(CC) $(ALLCFLAGS) -c libpgm2.cbioradtopgm  bioradtopgm.r :  bioradtopgm.casciitopgm  asciitopgm.r :  asciitopgm.cfstopgm  fstopgm.r :  fstopgm.chipstopgm  hipstopgm.r :  hipstopgm.clispmtopgm  lispmtopgm.r :  lispmtopgm.cpbmtopgm  pbmtopgm.r :  pbmtopgm.cpgmbentley  pgmbentley.r :  pgmbentley.cpgmenhance  pgmenhance.r :  pgmenhance.cpgmhist  pgmhist.r :  pgmhist.cpgmnoise  pgmnoise.r :  pgmnoise.cpgmnorm  pgmnorm.r :  pgmnorm.cpgmoil  pgmoil.r :  pgmoil.cpgmramp  pgmramp.r :  pgmramp.cpgmtofs  pgmtofs.r :  pgmtofs.cpgmtolispm  pgmtolispm.r :  pgmtolispm.cpgmtopbm  pgmtopbm.r :  pgmtopbm.cpsidtopgm  psidtopgm.r :  psidtopgm.cspottopgm  spottopgm.r :  spottopgm.cpgmkernel  pgmkernel.r :  pgmkernel.crawtopgm  rawtopgm.r :  rawtopgm.cpgmcrater  pgmcrater.r :  pgmcrater.cpgmedge  pgmedge.r :  pgmedge.cpgmtexture  pgmtexture.r :  pgmtexture.c