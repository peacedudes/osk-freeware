# makefile for mgif## date:    Tue May 14 20:24:28 1991# version: 3.0###SECT		= 1SUBSECT		= TARGET		= mgifMANPAGE		= mgif.$(SECT)$(SUBSECT)CATPAGE		= mgif.catMANSRC		= mgif.manARCFILE		= mgif.arcSHARFILE	= mgif.sharUUEFILE		= mgif.uuHEADERS		= mgif.hSRCS		= mgif.c process.c readgif.c flicker.cOBJS        = mgif.r process.r flicker.r readgif.r OTHERS		= readme makefile $(MANSRC)DISTFILES	= $(OTHERS) $(SRCS)CC		= gccARC             = arcUUENCODE 	= uuencodeSHAR		= sharCFLAGS		= -c -T/r0/tmpLDFLAGS		= -g LIBS		=BINDIR		= ./MANDIR		= RUNPARM		=RUNOUT		=./mgif: $(OBJS)    $(CC) $(LDFLAGS) -o $(TARGET) $(OBJS) /h0/lib/gpprim.r $(LIBS)install_bin:	$(TARGET)		copy $(TARGET) $(BINDIR)$(TARGET)install_man:	$(MANPAGE)		copy $(MANPAGE) $(MANDIR)$(MANPAGE)# others...#clean:		del $(OBJS) errs $(CATPAGE)clobber:	clean		del $(TARGET) $(MANPAGE)arc:		$(ARC) a $(ARCFILE) $(DISTFILES)		@echo done making $(ARCFILE)uue:		$(UUENCODE) $(TARGET)		@echo done making $(UUEFILE)shar:		$(SHAR) $(DISTFILES) >$(SHARFILE)		@echo done making $(SHARFILE)# dependencies...#mgif.r:		mgif.c mgif.h	$(CC) $(CFLAGS) -O -o $@ $*.c -mremoteflicker.r:	flicker.c	$(CC) $(CFLAGS) -o $@ $*.c -mremoteprocess.r:	process.c mgif.h	$(CC) $(CFLAGS) -O -o $@ $*.creadgif.r:	readgif.c mgif.h	$(CC) $(CFLAGS) -O -o $@ $*.c