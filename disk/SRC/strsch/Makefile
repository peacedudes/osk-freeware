# Makefile for bmgsubs (Boyer-Moore-Gosper subroutines)### Define BSD if you're compiling this for a 4.xBSD system#       (BSD has bcopy, has index() instead of strchr().)#ENV = -DBSDCFLAGS = -Obmgsubs.o: bmgsubs.cbmgtest: bmgsubs.o bmgtest.o        cc -o bmgtest bmgsubs.o bmgtest.obmgtest2: bmgsubs.o bmgtest2.o        cc -o bmgtest2 bmgsubs.o bmgtest2.oclean:        rm -f bmgtest bmgtest2 *.o *.BAK *.CKP