# BINDIR is the directory where the moria binary while be put# LIBDIR is where the other files (scoreboard, news, hours) will be put# LIBDIR must be the same directory defined in config.h# BINDIR = /h0/usr/games/cmds/# LIBDIR = /h0/usr/games/moriadir/# if you use Gnu C, must add -fwritable-strings option to CFLAGSCFLAGS = -iqt=/dd CC = ccSRCS = main.c misc1.c misc2.c store1.c files.c io.c create.c desc.c\	generate.c sets.c dungeon.c creature.c death.c eat.c help.c magic.c\	potions.c prayer.c save.c staffs.c wands.c scrolls.c spells.c\	wizard.c store2.c signals.c moria1.c moria2.c monsters.c\	treasure1.c treasure2.c variables.cOBJS = main.r misc1.r misc2.r store1.r files.r io.r create.r desc.r\	generate.r sets.r dungeon.r creature.r death.r eat.r help.r magic.r\	potions.r prayer.r save.r staffs.r wands.r scrolls.r spells.r\	wizard.r store2.r signals.r moria1.r moria2.r monsters.r\  	treasure1.r treasure2.r variables.rmoria : $(OBJS)	$(CC) -m=30 -fd=/h0/USR/GAMES/CMDS/moria $(CFLAGS) $(OBJS) -l=/dd/lib/ncurses.l -l=/dd/lib/os9lib.l# lintout : $(SRCS)#	lint $(SRCS) -lm -lcurses -ltermcap > lintout## lintout2 : $(SRCS)#	lint -bach $(SRCS) -lm -lcurses -ltermcap > lintout## TAGS : $(SRCS)#	ctags -x $(SRCS) >TAGS## you must define BINDIR and LIBDIR before installing# install:#	cp moria $(BINDIR)#	cp Moria_hours $(LIBDIR)#	cp Moria_news $(LIBDIR)#	cp Highscores $(LIBDIR)#	chmod 4511 $(BINDIR)/moria#	chmod 644 $(LIBDIR)/Highscores#	chmod 444 $(LIBDIR)/Moria_news#	chmod 444 $(LIBDIR)/Moria_hours#	chmod 555 $(LIBDIR)create.r: constants.h mtypes.h externs.h config.hcreature.r: constants.h mtypes.h externs.h config.hdeath.r: constants.h mtypes.h externs.h config.hdesc.r: constants.h mtypes.h externs.h config.hdungeon.r: constants.h mtypes.h externs.h config.heat.r: constants.h mtypes.h externs.h config.hfiles.r: constants.h mtypes.h externs.h config.hgenerate.r: constants.h mtypes.h externs.h config.hhelp.r: constants.h mtypes.h externs.h config.hio.r: constants.h mtypes.h externs.h config.hmagic.r: constants.h mtypes.h externs.h config.hmain.r: constants.h mtypes.h externs.h config.hmisc1.r: constants.h mtypes.h externs.h config.hmisc2.r: constants.h mtypes.h externs.h config.hmonsters.r: constants.h mtypes.h config.hmoria1.r: constants.h mtypes.h externs.h config.hmoria2.r: constants.h mtypes.h externs.h config.hpotions.r: constants.h mtypes.h externs.h config.hprayer.r: constants.h mtypes.h externs.h config.hsave.r: constants.h mtypes.h externs.h config.hscrolls.r: constants.h mtypes.h externs.h config.hsets.r: constants.h config.hsignals.r: constants.h mtypes.h externs.h config.hspells.r: constants.h mtypes.h externs.h config.hstaffs.r: constants.h mtypes.h externs.h config.hstore1.r: constants.h mtypes.h externs.h config.hstore2.r: constants.h mtypes.h externs.h config.htreasure1.r: constants.h mtypes.h config.htreasure2.r: constants.h mtypes.h config.hvariables.r: constants.h mtypes.h config.hwands.r: constants.h mtypes.h externs.h config.hwizard.r: constants.h mtypes.h externs.h config.h