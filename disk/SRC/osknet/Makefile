#	Makefile for KA9Q TCP/IP package for OS9-68k#  Prepared by Bob Brose, N0QBJ, 974 Hampden Ave, St Paul MN 55114-1108#  Modified heavily 1997 by Chris Hawks, 28456 S. R. 2 New Carlisle, In.#                                                              46552##  Note that this is still under development, e.g. curses functions not#  resolved yet.  Since "remote" is an OSK storage type, we redefine at#  compile time remote=rremote so variables using that name in the files#  don't have to be renamed.  Don't use "rremote" in any modifications.SHELL = /dd/cmds/shell# If you have shared libraries (usually /lib/libc_s.a) you can make# smaller executable with SHLIB defined: note cio.l is too slow to do# 9600 baud on a 16mhz 68000 system#SHLIB="-l=/dd/lib/cio.l"SHLIB=CC=ccSDIR=.RDIR=RELSOSKDEFS = -Dremote=rremote -D_OSKCFLAGS = -s -t=/dd/tmp $(OSKDEFS)LIBS =$(SHLIB)SRCS =	main.c cmdparse.c dial.c files.c ftp.c ftpcli.c ftpserv.c \	icmp.c icmpcmd.c icmpdump.c icmpmsg.c iface.c ip.c ipcmd.c ipdump.c \	iproute.c lcsum.c mbuf.c md5.c misc.c motd.c netuser.c osk_io.c \	pathname.c ppp.c pppchap.c pppcmd.c pppdump.c pppfsm.c pppipcp.c \	ppplcp.c ppppap.c session.c slip.c slhc.c slhcdump.c smisc.c smtpcli.c \	smtpserv.c tcpcmd.c tcpdump.c tcpin.c tcpout.c tcpsubr.c tcptimer.c \	tcpuser.c telnet.c telunix.c timer.c tnserv.c trace.c ttydriv.c udp.c \	udpcmd.c udpdump.c version.c wildmat.cOBJS =	main.r cmdparse.r dial.r files.r ftp.r ftpcli.r ftpserv.r \	icmp.r icmpcmd.r icmpdump.r icmpmsg.r iface.r ip.r ipcmd.r ipdump.r \	iproute.r lcsum.r mbuf.r md5.r misc.r motd.r netuser.r osk_io.r \	pathname.r ppp.r pppchap.r pppcmd.r pppdump.r pppfsm.r pppipcp.r \	ppplcp.r ppppap.r session.r slip.r slhc.r slhcdump.r smisc.r smtpcli.r \	smtpserv.r tcpcmd.r tcpdump.r tcpin.r tcpout.r tcpsubr.r tcptimer.r \	tcpuser.r telnet.r telunix.r timer.r tnserv.r trace.r ttydriv.r udp.r \	udpcmd.r udpdump.r version.r wildmat.rosknet:	$(OBJS)     chd $(RDIR);l68 /dd/lib/cstart.r -z=../linkfiles -g -o=osknet $(SHLIB) -l=/dd/lib/clib.l -l=/dd/lib/sys.l -aclean:	del rels/*.r