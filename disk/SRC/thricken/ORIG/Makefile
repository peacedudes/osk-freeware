# compiler flagsCC = gccCFLAGS = -OLDFLAGS = -sLIBS = -lcurses -ltermcap# directoriesBINDIR = /dcs/89/rince/open/bin.$(ARCH)LIBDIR = /dcs/89/rince/open/lib/thrickenMANDIR = /dcs/89/rince/open/manOBJ = files.o main.o scores.o screen.oDEFS =	-DLIBDIR=\"$(LIBDIR)\"thricken:	$(OBJ)	$(CC) $(LDFLAGS) $(OBJ) -o $@ $(LIBS)%.o:	%.c	$(CC) $(CFLAGS) $(DEFS) -c $<	install:	thricken thricken.6	# the game	-mkdir -p $(BINDIR)	chmod a+xr $(BINDIR)	-cp thricken $(BINDIR)	chmod a+x $(BINDIR)/thricken	# the data files	-mkdir -p $(LIBDIR)	chmod a+xr $(LIBDIR)	-cp data/* $(LIBDIR)	chmod a+r $(LIBDIR)/*	# the man page	-mkdir -p $(MANDIR)/man6	chmod a+xr $(MANDIR)/man6	-cp thricken.6 $(MANDIR)/man6	chmod a+r $(MANDIR)/man6/thricken.6clean:	-rm thricken *.o *~files.o: thricken.hmain.o: thricken.h extern.hscores.o: extern.h thricken.hscreen.o: extern.h thricken.h