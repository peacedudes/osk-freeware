##       Makefile for Mtools  - for gcc2 with native GNU library#USERCFLAGS = USERLDFLAGS =SHELL = kshRDIR      = ./RELSODIR      = ./cmdsCC       = gcc2CPPFLAGS =RFLAGS =DEFS     = -DHAVE_CONFIG_H -DHAVE_ATEXITHOST_ID  =CFLAGS   =  -I/h0/mwos/src/defs/GCC2 -m68000 -ucc -T/r0 -optasmLDFLAGS  = LIBS     = -L/dd/lib -lmtools.l -los9lib.l -L/h0/mwos/os9/68000/lib -nocolOBJS = buffer.r codepage.r codepages.r config.r copyfile.r devices.r \directory.r expand.r fat.r fat_free.r file.r file_name.r file_read.r \filter.r force_io.r hash.r init.r match.r mattrib.r mbadblocks.r mcd.r \mcopy.r mdel.r mdir.r mformat.r misc.r missing_functions.r \mk_direntry.r mlabel.r mmd.r mmove.r mainloop.r minfo.r precmd.r privileges.r \parse.r plain_io.r signal.r stream.r streamcache.r subdir.r \toupper.r tty.r vfat.r xdf_io.rSRCS = buffer.c codepage.c codepages.c config.c copyfile.c devices.c \directory.c expand.c fat.c fat_free.c file.c file_name.c file_read.c \filter.c force_io.c hash.c init.c match.c mattrib.c mbadblocks.c mcd.c \mcopy.c mdel.c mdir.c mformat.c misc.c missing_functions.c \mk_direntry.c mlabel.c mmd.c mmount.c mmove.c mtools.c \parse.c plain_io.c signal.c stream.c streamcache.c subdir.c \toupper.c vfat.c xdf_io.c mkmanest.cSCRIPTS = mcheck mxtar uz gz xcopy mcompLINKS=msattrib mscd mscopy msdel msdir msformat mslabel msmd msmove mstype\ msbadblocks msdeltree msrd msread msren mswrite msinfo mstoolstestALLCFLAGS = $(CPPFLAGS) $(DEFS) $(HOST_ID) $(CFLAGS) $(USERCFLAGS)all.done:   mtools.l $(LINKS) mtools   echo all done.c.r:	 $(CC) $(ALLCFLAGS) -c -o $(RDIR)/$*.r $*.cmtools: $(OBJS) mtools.r  $(CC) $(CFLAGS) -o $(ODIR)/mtools $(LIBS) -s 100 $(RDIR)/$@.r mtools.l :  $(OBJS)     chd rels; libgen -co=../mtools.l $(OBJS)$(LINKS): mtools.l   $(CC) $(CFLAGS) -o $(ODIR)/$@ $(LIBS) -s 100  $(RDIR)/$@.r buffer.r: buffer.c sysincludes.h config.h msdos.h mtools.h \ stream.h buffer.hcodepage.r: codepage.c sysincludes.h confi