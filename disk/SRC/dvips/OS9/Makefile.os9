# Makefile for dvips for OS9version = 5.495b# Installation directories.prefix = /DD/SYSexec_prefix = /DD/CMDSbindir = $(exec_prefix)datadir = $(prefix)infodir = $(prefix)/INFOmanext = 1mandir = $(prefix)/MAN/MAN$(manext)# Where TeX is `rooted'.texprefix = $(datadir)/TEX# Where dvips-specific stuff should go.dvipsdir = $(texprefix)/DVIPS# The top-level (or main, or something) font directory.texfontdir = $(texprefix)/FONTS# Where the PostScript TFM and VF files get installed.pstfmdir = $(texfontdir)/TFMpsvfdir = $(texfontdir)/VF# Default paths for you to override.  You can either change these and# run `make', or copy paths.h.in to include/paths.h and change# them manually.  These paths are overridden by various environment# variables; see the documentation.default_tfm_path = $(texfontdir)//:.default_pk_path = $(default_tfm_path)default_vf_path = $(default_tfm_path)# Where the configuration files get installed,# the default path for searching for them.# and the installed name of the config file.configdir = $(dvipsdir)default_config_path = .:$(configdir)configfile = config.ps# Where the PostScript header files go,# and the default path for searching for them.# Downloadable fonts are looked for here, also.headerdir = $(configdir)default_header_path = $(default_config_path):$(texprefix)/FONTS//# Where the TeX macro files get installed,# and the default path for searching for epsf and PS files.# This should match the default TeX input path.texmacros = $(texprefix)/INPUTStexmacrodir = $(texmacros)/DVIPSdefault_fig_path = .:$(texmacros)//# What to search for IFF files, etc.default_pict_path = $(default_fig_path)# Add -DDEFRES=dpi to DEFS to change the default resolution from 300dpi.# Add -DDEBUG to turn on debugging.# Add -DTPIC for tpic support.# Add -DFONTLIB to search font libraries.# Add -DEMTEX for EMTEX specials.# Add -DSECURE if you will install dvips with special privileges.# # For VM/CMS, need -DVMCMS; see the vmcms subdirectory.# For VMS, need -DVMS; see the vms subdirectory.# For DOS, need -DDOS; see the pc subdirectory.# For Xenix, need -DXENIX; sorry, configure should figure that out.# If you have a Xenix system and want to test this, please let me# (karl@cs.umb.edu) know.# DEFS = -DTPIC -DDEBUG #-DDEFRES=400# Perhaps you will want to optimize or use -Wall here.CFLAGS = -WallXCFLAGS = -O -fstrength-reduce -fomit-frame-pointer -fdefer-pop -fdelayed-branch -ffunction-cse# Start of system configuration section.SHELL = shell#srcdir = @srcdir@#VPATH = @srcdir@srcdir = .VPATH = .CC = gccCPPFLAGS = -I. -I$(srcdir) $(DEFS)# The user can set CFLAGS on the command line..c.r:	$(CC) $(CPPFLAGS) $(CFLAGS) $(XCFLAGS) -c $<LIBS = -l/dd/lib/os9lib.l -l/dd/lib/clib.lLDFLAGS = $(CFLAGS) $(XLDFLAGS) -s 256k -xINSTALL = copy -rINSTALL_PROGRAM = copy -rINSTALL_DATA = copy -rMKDIR = makdirMAKE = makeMAKEINFO = echopathsearch_objects = concat.r concat3.r dir_p.r file_p.r pathsrch.r xmalloc.r \xopendir.r xrealloc.r xstat.r xstrdup.robjects = dospecial.r dviinput.r emspecial.r fontdef.r loadfont.r \        dvips.r tfmload.r \	download.r prescan.r scanpage.r skippage.r output.r scalewidth.r \	dosection.r dopage.r resident.r search.r unpack.r drawPS.r \	header.r makefont.r repack.r virtualfont.r dpicheck.r finclude.r \	pprescan.r papersiz.r flib.r color.r bbox.r $(pathsearch_objects) \	system.rprograms = dvips squeeze afm2tfmprologues = tex.pro texps.pro texc.pro special.pro finclude.pro \            color.pro crop.proinstall_subdirs = PSlatex PStfms PSvfsall:	$(programs) $(prologues) dvips.infodvips:	$(objects)	$(CC) $(LDFLAGS) -o $@ $(objects) $(LIBS)afm2tfm: afm2tfm.r	$(CC) $(LDFLAGS) -o $@ afm2tfm.r $(LIBS).SUFFIXES: .pro .lpro .info .texi# The `_t'[mp] business is so that we don't create an empty .pro file,# if running squeeze fails for some reason.# .lpro.pro: squeeze	-del $@_t	-del $@	./squeeze <$< >$@_t	rename $@_t $@.texi.info:	$(MAKEINFO) $<texc.lpro: texc.script tex.lpro	$(srcdir)/texc.script tex.lpro texc.lprosqueeze: squeeze.r	$(CC) $(LDFLAGS) -o $@ squeeze.r $(LIBS)# Separate the installation instructions into a separate file, for the# benefit of people who don't want to look at the info file.INSTALL_DOCS: dvips.info	sed -n '/Node: Installation,/,/for that package./p' dvips.info* \          | grep -v  > $@paths.h: paths.h.in	rm -f paths.h	echo "/* Generated from paths.h.in (`date`).  */" > paths.h	sed -e "s,replace-with-pk-path,$(default_pk_path),"		\            -e "s,replace-with-tfm-path,$(default_tfm_path),"		\            -e "s,replace-with-vf-path,$(default_vf_path),"		\            -e "s,replace-with-config-path,$(default_config_path),"	\            -e "s,replace-with-header-path,$(default_header_path),"	\            -e "s,replace-with-fig-path,$(default_fig_path),"		\            -e "s,replace-with-pict-path,$(default_pict_path),"		\          $(srcdir)/paths.h.in >> paths.hcheck: all	rm -f mtest.ps	tex test	-dvips test -o test.ps	cp test.ps mtest.ps	dvips testinstallargs = \  INSTALL='$(INSTALL)' \  INSTALL_DATA='$(INSTALL_DATA)' \  texmacrodir=$(texmacrodir) \  pstfmdir=$(pstfmdir) \  psvfdir=$(psvfdir)install: all	-$(MKDIR) $(prefix)	-$(MKDIR) $(exec_prefix)	-$(MKDIR) $(datadir)	-$(MKDIR) $(texprefix)	-$(MKDIR) $(texmacros)	-$(MKDIR) $(bindir)	-$(MKDIR) $(headerdir)	-$(MKDIR) $(configdir)	-$(MKDIR) $(texmacrodir)	-$(MKDIR) $(texfontdir)	-$(MKDIR) $(mandir)	-$(MKDIR) $(infodir)	-$(MKDIR) $(pstfmdir)	-$(MKDIR) $(psvfdir)	if test -z "$(install_subdirs)"; then exit 0; else \	  for dir in "$(install_subdirs)"; \	    do (cd $$dir; $(MAKE) $(installargs) install) done; fi	$(INSTALL_PROGRAM) dvips $(bindir)/dvips	$(INSTALL_PROGRAM) afm2tfm $(bindir)/afm2tfm	$(INSTALL_PROGRAM) $(srcdir)/MakeTeXPK $(bindir)/MakeTeXPK	for i in dvips.info*; do $(INSTALL_DATA) $$i $(infodir)/$$i; done	$(INSTALL_DATA) $(srcdir)/tex.pro $(headerdir)/tex.pro	$(INSTALL_DATA) $(srcdir)/texc.pro $(headerdir)/texc.pro	$(INSTALL_DATA) $(srcdir)/texps.pro $(headerdir)/texps.pro	$(INSTALL_DATA) $(srcdir)/special.pro $(headerdir)/special.pro	$(INSTALL_DATA) $(srcdir)/finclude.pro $(headerdir)/finclude.pro	$(INSTALL_DATA) $(srcdir)/color.pro $(headerdir)/color.pro	$(INSTALL_DATA) $(srcdir)/crop.pro $(headerdir)/crop.pro	$(INSTALL_DATA) $(srcdir)/config.ps $(configdir)/$(configfile)	$(INSTALL_DATA) $(srcdir)/psfonts.map $(configdir)/psfonts.map	$(INSTALL_DATA) $(srcdir)/epsf.tex $(texmacrodir)/epsf.tex	$(INSTALL_DATA) $(srcdir)/epsf.sty $(texmacrodir)/epsf.sty	$(INSTALL_DATA) $(srcdir)/rotate.tex $(texmacrodir)/rotate.tex	$(INSTALL_DATA) $(srcdir)/rotate.sty $(texmacrodir)/rotate.sty	$(INSTALL_DATA) $(srcdir)/colordvi.sty $(texmacrodir)/colordvi.sty	$(INSTALL_DATA) $(srcdir)/colordvi.tex $(texmacrodir)/colordvi.tex	$(INSTALL_DATA) $(srcdir)/blackdvi.sty $(texmacrodir)/blackdvi.sty	$(INSTALL_DATA) $(srcdir)/blackdvi.tex $(texmacrodir)/blackdvi.tex	$(INSTALL_DATA) $(srcdir)/dvips.1 $(mandir)/dvips.$(manext)	$(INSTALL_DATA) $(srcdir)/afm2tfm.1 $(mandir)/afm2tfm.$(manext)distdir = dvipsk_$(version)dist: INSTALL_DOCS	rm -rf $(distdir)## `contrib' has subdirectories.	find * -type d ! -name contrib -print > /tmp/subdirs## Make all subdirectories in the distribution directory.	find * -type d -exec $(MKDIR) -p $(distdir)/'{}' \;## But it also has one file.	ln contrib/whichinpath $(distdir)/contrib## Link all files in subdirectories.	find `cat /tmp/subdirs`						\          \( -name $(distdir) -prune -o -type f \)			\          -exec ln '{}' $(distdir)/'{}' \;#	ln C* INSTALL_DOCS NEWS README $(distdir)	ln configure config.??* *.in $(distdir)	ln *.sty *.tex *.texi *.info* *.lpro psfonts.map $(distdir)	ln *.1 texc.script *.c *.h $(distdir)	cp -p $(plain)/texinfo.tex $(distdir)	cp -p $(local)/bin/MakeTeXPK $(distdir)	cp -p $(gnu)/lib/aclocal.m4 $(distdir)	cp -p $(HOME)/gnu/gnuorg/COPYING* $(top_distdir)	cp $(ktex)/fontname/adobe.txt $(distdir)/adobe	cd $(distdir); rm -f c-auto.h paths.h config.status */Makefile	tar czf $(distdir). $(distdir)	rm -rf $(distdir)# Prevent GNU make 3 from overflowing arg limit on system V..NOEXPORT:configure: configure.in	autoconfconfig.status: configure	sh configure --no-createMakefile: Makefile.in config.status	sh config.statusdepend: paths.h	$(CC) -MM *.c > /tmp/dependTAGS:	etags -t *.c *.hmostlyclean:	-del -f *_t	-del -f *.r	-del -f $(programs)	-del -f core	-del -f a.outclean: mostlyclean	-del -f *.dvi	-del -f *.log	-del -f *test.ps	-del -f *.prodistclean: clean	-del -f Makefile extraclean: distclean	-del -f paths.h c_auto.h config.status	-del -f *.tfm *gf *pk *~ *\#* patch* *.orig *.rej	-del -f TAGS dvips.info*	-del -f texc.lpro# Dependencies.afm2tfm.r : afm2tfm.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h bbox.r : bbox.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h color.r : color.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h concat.r : concat.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h concat3.r : concat3.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h dir_p.r : dir_p.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h dirio.h xstat.h  c_pathch.hdopage.r : dopage.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h dosection.r : dosection.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h \  c_errno.h c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h \  debug.h dospecial.r : dospecial.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h \  c_errno.h c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h \  debug.h download.r : download.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h dpicheck.r : dpicheck.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h drawPS.r : drawPS.c dviinput.r : dviinput.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h dvips.r : dvips.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h file_p.r : file_p.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h xstat.h finclude.r : finclude.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h flib.r : flib.c fontdef.r : fontdef.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h header.r : header.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h loadfont.r : loadfont.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h \  c_pathmx.h makefont.r : makefont.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h output.r : output.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h papersiz.r : papersiz.c pathsrch.r : pathsrch.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h c_pathch.h c_namemx.h \  c_pathmx.h paths.h xstat.h dirio.h pathsrch.h  c_memstr.hpprescan.r : pprescan.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h prescan.r : prescan.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h repack.r : repack.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h resident.r : resident.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h \  pathsrch.h scalewidth.r : scalewidth.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h \  c_errno.h c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h \  debug.h scanpage.r : scanpage.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h search.r : search.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h \  pathsrch.h skippage.r : skippage.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h squeeze.r : squeeze.c system.r : system.c system.htfmload.r : tfmload.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h \  c_pathmx.h unpack.r : unpack.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h \  c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h debug.h virtualfont.r : virtualfont.c structures.h config.h system.h c_auto.h c_std.h c_memstr.h \  c_errno.h c_minmax.h c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h paths.h \  debug.h c_pathmx.h xmalloc.r : xmalloc.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h xopendir.r : xopendir.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h dirio.h xrealloc.r : xrealloc.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h xstat.r : xstat.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h xstat.h xstrdup.r : xstrdup.c config.h system.h c_auto.h c_std.h c_memstr.h c_errno.h c_minmax.h \  c_limits.h c_seek.h c_fopen.h c_proto.h types.h lib.h 