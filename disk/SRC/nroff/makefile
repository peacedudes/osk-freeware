# makefile for nroff (os9)#CFLAGS		= -qxm=2k -t=/r0 LFLAGS		= -qxm=2kSRCS		= main.c command.c text.c io.c macros.c strings.c escape.c low.cRFILES		= main.r command.r text.r io.r macros.r strings.r escape.r low.rTARGET		= nroffMANPAGE		= nroff.1TMACDIR		= /h0/libMAN_MACRO	= tmac.anRDIR		= RELSODIR		= /h0/cmds/miscMANDIR		= /h0/usr/dog/doc$(ODIR)/$(TARGET):	$(RFILES)	chd $(RDIR); cc $(LFLAGS) -f=$(ODIR)/$(TARGET) $(RFILES)	attr -ax -pepr $(ODIR)/$(TARGET)# install targetinstall:	$(TARGET)		copy -r $(MANPAGE) $(MANDIR)/$(MANPAGE)		copy -r $(MAN_MACRO) $(TMACDIR)/$(MAN_MACRO)clean:	chd $(RDIR); del $(RFILES)shar:		shar README MANIFEST Makefile Makefile.bsd nroff.1 tmac.an \			*.h >part01		shar main.c command.c text.c io.c >part02		shar escape.c low.c macros.c strings.c >part03# dependencies#nroff.h:	version.h		touch nroff.h$(RFILES): nroff.h