***********************************************************************         nam     ATerm         ttl     Communication program for OS9/68000* osk-freeware 2026-08-24: was `use     /R0/Defs/DefsFile' -- a RAM-disk* path on the author's machine, and nothing mounts /r0 here.  The angle* form is what every other assembly source in this collection uses and it* resolves to /dd/defs/oskdefs.d.  Assembles with 0 errors and the module* that comes out is byte-for-byte the aterm that ships.         use     <oskdefs.d>edition  set     26              version 2.6typ_lang set     (Prgrm<<8)+Objctattr_rev set     (ReEnt<<8)+0         psect   ATerm,typ_lang,attr_rev,edition,$0C00,ATerm_Go*********************************************************************       A few equates...*bsize    equ     $2000           Buffer size user for Up & Downloadingctl_qty  equ     20              Qty of items to be read from the control filedial_siz equ     2800            Size of the phone bufferenv_len  equ     6               Length of the environment variable namesenv_sync equ     $FC01           Environment Synch Codehelp_key equ     $E2             [HELP] Key on the ATARI STmax_nos  equ     35              Quantity of phone numbers allowed in tablemax_errs equ     10              Consecutive errors before aborting on XModemnull_cr  equ     $000D           Needed as a delimiter in the environment*------------------*  Sequence prefixs used to compute offset within the Control table.*s_cls    equ     0               Sequence Offset key for Clear Screens_csr_on equ     1                                       Cursor Ons_csr_of equ     2                                       Cursor OFFs_rev_on equ     3                                       Reverse ONs_rev_of equ     4                                       Reverse OFFs_prtset equ     5                                       Printer initialisations_mdm_pr equ     6                                       Modem prefixs_mdm_sf equ     7                                       Modem suffixs_dev_dr equ     8               Name of the device driver for the serial paths_siz_pp equ     9               Buffer size to be used for the Printer Pipes_cmd_pp equ    10               Script command file to process Printer Pipe*------------------secs_t_o equ     5               Seconds allowed before signaling a timeoutseq_len  equ     $20             Bytes by sequence string code allowed (CTL)sig_kbd  equ     256             Signal for keyboard data ready*sig_c_hi equ     257             Signal when DCD is HIGH*sig_c_lo equ     258             Signal when DCD is LOWstderr   equ     2               Standard Error Path (Screen)stdin    equ     0               Standard Input Path (Keyboard)stdout   equ     1               Standard Output Path (Screen)xmd_pksz equ     128             XModem packet sizeymd_pksz equ     1024            YModem  "  "  "  "*----------------* Xmodem equates*----------------C$SOH    equ     1               Start-of-header    Used for 128 bytes blocksC$STX    equ     2               Start-of-Text      Used for YModem 1-KC$EOT    equ     4               end-of-textC$ACK    equ     6               acknowledgeC$DC2    equ     $12             Automatic buffer OPEN (^R)C$DC4    equ     $14             Automatic buffer close (^T)C$NAK    equ     $15             negative acknowledgeC$CAN    equ     $18             cancelC$EM     equ     $19             Control-YC$PAD    equ     $1A             xmodem padding character (^Z)************************************************************************                     ------ Memory variables ------*         vsect*        ---> Marker for the top Vsect areavs_top   ds.b    1*=======================         align*=======================*-----< Long words : 32 bits >-----bfr_ptr  ds.l    1               Pointer for the data in the upload bufferblk_no   ds.l    1               Block number for xmodemcr_delay ds.l    1               Upload carriage return delaydd_add   ds.l    1               Device descriptor module addressdfilelen ds.l    1               Length of the download file nameprt_add  ds.l    1               Address to be used for the printer scriptprt_size ds.l    1               And the parameter size for it toonumber   ds.l    1               Buffer for file sizeph_read  ds.l    1               actual quantity of phone numbersphn_ptr  ds.l    1               Pointer to phone number when dialingpkt_siz  ds.l    1               XModem packet sizeprm_size ds.l    1               Size of the parameter are to pass to F$Forkrcvd_chr ds.l    1               Buffer for how many character received/sendtbl_add  ds.l    1               Table addressu_countr ds.l    1               upload chracter counteru_delay  ds.l    1               Upload character delayufilelen ds.l    1               Length of the upload file namexerror   ds.l    1               number of xmodem errorxnumber  ds.l    1               number of passing xmodem characterxsize    ds.l    1               size of xmodem file*-----< Words      : 16 bits >-----crc_val  ds.w    1               CRC-16 bits value for usercrc_rmt  ds.w    1               CRC-16 bits receive from remotectl_path ds.w    1               Control file path numberfd_path  ds.w    1               File download path bufferfu_path  ds.w    1               file upload path buffermdm_path ds.w    1               Buffer for serial port pathmd_path2 ds.w    1               Second path number for the modempr_path  ds.w    1               Printer path numbertik_rate ds.w    1               Tick rate in ticks per second*-----< Bytes      :  8 bits >-----abort_uf ds.b    1               Abort upload flagact_par  ds.b    1               Actual Parity setup before entering XModemauto_buf ds.b    1               Indicator for auto buffer : ^R / ^Tbuf_stat ds.b    1               Buffer state : 0-Closed, 1-Openedcrc_meth ds.b    1               XModem validation method : 0-CSum 1-CRCclos_flg ds.b    1               flag to see if download file was closedcr_flag  ds.b    1               If there is no prompt characterctl_inf  ds.b    100             Control information (one line at once)ctl_file ds.b    30              Full path name of the control file to usectl_item ds.b    1               Valid items read from the control filectl_ok   ds.b    1               Flag indicating status of control file*=======================         align*=======================ctl_tbl  ds.b    ctl_qty*seq_len Len of the sequence tablectl_dumm ds.b    seq_len         Keep a spare space.  Don't trust user !!!cust_xof ds.b    1               Customized XOFF.cust_xon ds.b    1               Customized XON.d_flag   ds.b    1               Download flagdash_flg ds.b    1               how many phone numbersdfilenam ds.b    80              Download filenamedial_flg ds.b    1               Indicate that we are in Dial Modedir_outp ds.b    1               Direct output to printer flagechoflag ds.b    1               Buffer for echo stateenv_init ds.b    400             Environment table read at the startupf_downld ds.b    bsize           Buffer for download/uploadprt_init ds.b    1               Printer script addresses initializedgood_env ds.b    1               Indicate a successfull match within ENV varsinbuffer ds.b    3               Keyboard input bufferlast_dig ds.b    1               Indicates that this is the last digitlead_0   ds.b    1               Corresponding zero is not a leading onelf_flag  ds.b    1               linefeed flagmbuffer  ds.b    1               Modem character buffermove_dlm ds.b    1               Delimiter to be 'seen' to stop moving datanlead_0  ds.b    1               Indicate that we want leading zero'snot_0    ds.b    1               Check for first not zeroout_char ds.b    1               a buffer for a digit to be printedpass_1   ds.b    1               pass flag for division routinepf_flag  ds.b    1               Phone file flagphbuffer ds.b    dial_siz        Buffer for phone numbersphon_fil ds.b    30              Phone file path namepr_echo  ds.b    1               Printer echo flagprt_name ds.b    20              Printer path nameret_cnt  ds.b    1               Retry count before switching from CRC to CSUMshell_nm ds.b    20              Shell name to be used : MW or env val SHELL=sw_done  ds.b    1               Switch from CRC to CSUM has been donekb_abort ds.b    1               flag to see if key was pressed during xmodemtext_seq ds.b    1               Indicates an ASCII or HEX control sequencetime_out ds.b    1               Indicate that the remote has been timed outtoo_many ds.b    1               Too many successive errorsu_flag   ds.b    1               Upload flagu_prompt ds.b    1               Upload prompt characterufilenam ds.b    80              Upload filenameunlk_dd  ds.b    1               Unlink device descriptor prior to continuevalid_dd ds.b    1               Indicate a valid device descriptorwait_for ds.b    1               The character we are waiting forwhit_0   ds.b    1               Substitute leading zeroes with spaceswrt_cnt  ds.b    1               Write count for sequencesx_mode   ds.b    1               XModem download statexd_open  ds.b    1               Xmodem download file is openxu_open  ds.b    1               Xmodem Upload file is openxmd_mtd  ds.b    1               Xmodem method : 0-XModem : 1-YModem*=======================         align*=======================**************           *   It is imperative to have the data of the path descriptors* IMPORTANT *   aligned on an even boundary.  Failing to do so, will result*           *   in a lockout of the program !*************fork_prm ds.b    512             Parameters to be used for the F$Forkopt_t1_o ds.b    128             Path descriptor : /T1   (As it was on entry)opt_t1_w ds.b    128             "  "   "    "   : /T1   (Working version)pd_trm_o ds.b    128             "  "   "    "   : /TERM (As it was on entry)pd_trm_w ds.b    128             "  "   "    "   : /TERM (Working version)*        --> Marker for the bottom of the Vsect areavs_bot   ds.b    1         ends*---------------------------------------------------------------------*                       ---  String Constants  ---*---------------------------------------------------------------------Authors  dc.b    "< By D. Boulanger & D. Chartrand (c)1989 >"crlf     dc.b    C$CR                 Carriage return         dc.b    C$LF                 Linefeeddef_ctl  dc.b    "/DD/SYS/ATERM/ATerm.Ctl",C$CR   Default Control filedef_phon dc.b    "/DD/SYS/ATERM/ATerm.Phone",C$CR Default dialer filedef_prt  dc.b    "/P",C$CR                        Default printer pathdef_shl  dc.b    "Shell",C$Null                   Default Shellenv_list equ     *                    Beginning of the environment listenv_shl  dc.b    "SHELL="             Shell command processorenv_ctl  dc.b    "CNTLF="             Environment variable to matchenv_phon dc.b    "PHONE="             Dialer fileenv_prt  dc.b    "HDCPY="             Hardcopy deviceoptions  dc.b    "BCDEFIOPQSTUXY"     Valid options supported by ATermqty_opt  equ     *-options            Quantity of optionsprt_parm dc.b    "/DD/SYS/ATERM/ATerm.Print",C$CR,C$Nullpp_size  equ     *-prt_parmprt_pipe dc.b    "/Pipe/ATerm",C$CR   Printer Pipe Name*                                     Shell parameters for the F$Forkshl_prm  dc.b    " -nt -nl -nx -p='",C$LF,"[ATerm]:'<>>>/Term"         dc.b    C$Null,C$CR          We need this delimiterspace    dc.b    "     "              Used to separate values when XModem'ingspc_len  equ     *-spacexmod_c   dc.b    C$CAN,C$CAN,C$CAN    Cancel a XModem transferxmod_c_l equ     *-xmod_c*----------------------------------------------------------------**      Parity, Data Bits and Stop Bits tables.*   )  First byte indicates how many items currently in the table*   )  Each pair of items are :*      - Byte to be compared to the user's choice*      - Mask to be OR'ed with the PD_PAR byte when a match occurs*par_tbl  dc.b    5,'N',00,'O',01,'S',02,'M',02,'E',03data_tbl dc.b    4,'5',12,'6',08,'7',04,'8',00stop_tbl dc.b    3,'1',00,'2',16,'3',48*---------------------------------------------------------------------*                      ---  Messages & Prompts  ---*---------------------------------------------------------------------mesg1    dc.b    "                    ATerm : A terminal program for OS9/68000"         dc.b    C$CR,C$LF         dc.b    "                    ===== = = ======== ======= === ========="         dc.b    C$CR,C$LFendtitle equ     *-mesg1         dc.b    C$LF         dc.b    "                       Syntax  : ATerm /serial_path"         dc.b    C$CR,C$LF         dc.b    "                       Function: Terminal program for OSK"         dc.b    C$CR,C$LF         dc.b    "                       Example : ATerm /t1"         dc.b    C$CR,C$LF,C$Bellendmesg1 equ     *-mesg1*--------------------------mesg2    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Unable to open the specified serial device."         dc.b    C$CR,C$LFendmesg2 equ     *-mesg2*--------------------------mesg3    dc.b    C$CR,C$LF         dc.b    "* Now returning to system level..."         dc.b    C$CR,C$LFendmesg3 equ     *-mesg3*--------------------------mesg4    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** System error when trying to 'fork' child process."         dc.b    C$CR,C$LFendmesg4 equ     *-mesg4*--------------------------mesg5    dc.b    C$CR,C$LF         dc.b    "* We're now on line ..."         dc.b    C$CR,C$LF,C$LFendmesg5 equ     *-mesg5*--------------------------mesg6 dc.b "     <===================================================================>" dc.b    C$CR,C$LF dc.b "     |                            ATerm V2.6                             |" dc.b    C$CR,C$LF dc.b "      >-----------------------------------------------------------------< " dc.b    C$CR,C$LF dc.b "     |   B - Baud & Parity selections          C - CR/LF translation     |" dc.b    C$CR,C$LF dc.b "     |   D - Download ASCII text file          E - Echo Toggle           |" dc.b    C$CR,C$LF dc.b "     |   F - Flow characters selection         I - Invoke phone dialer   |" dc.b    C$CR,C$LF dc.b "     |   O - Close download file (ASCII)       P - Printer toggle        |" dc.b    C$CR,C$LF dc.b "     |   Q - Quit ATerm & Return to system     S - OSK Shell access      |" dc.b    C$CR,C$LF dc.b "     |   T - Terminal mode                     U - Upload ASCII file     |" dc.b    C$CR,C$LF dc.b "     |   X - XModem (128 Bytes CSum/Crc)       Y - YModem (1024 Bytes)   |" dc.b    C$CR,C$LF dc.b "      >-----------------------------------------------------------------< " dc.b    C$CR,C$LF dc.b "     |         [CTRL]-[Y] or [HELP] will re-display this screen.         |" dc.b    C$CR,C$LF dc.b "     <===================================================================>" dc.b    C$CR,C$LFendmesg6 equ     *-mesg6*--------------------------mesg7    dc.b    C$CR,C$LF         dc.b    "                           > Make your selection : "endmesg7 equ     *-mesg7*--------------------------mesg8    dc.b    C$CR,C$LF         dc.b    "> Specify file name. ( [RETURN] = Cancel demand ) : "endmesg8 equ     *-mesg8*--------------------------mesg9    dc.b    C$Bell         dc.b    "*** The specified file is empty !!!  Upload request aborted."endmesg9 equ     *-mesg9*--------------------------msg10    dc.b    C$CR,C$LF         dc.b    "* Please wait... Closing current download file."         dc.b    C$CR,C$LFendmsg10 equ     *-msg10*--------------------------msg11    dc.b    C$CR,C$LF         dc.b    "> Upload file name. ( [RETURN] = Ignore request ) : "endmsg11 equ     *-msg11*--------------------------msg12    dc.b    C$Bell         dc.b    "*** Can't open the specified file.  Please re-enter."         dc.b    C$CR,C$LFendmsg12 equ     *-msg12*--------------------------msg13    dc.b    C$CR,C$LF         dc.b    "> Upload prompt character. ( [RETURN] = none ) : "endmsg13 equ     *-msg13*--------------------------msg14    dc.b    C$CR,C$LF         dc.b    "> Upload delay after each carriage return. (~ 1/10 sec) [0-9] : "endmsg14 equ     *-msg14*--------------------------msg15    dc.b    C$CR,C$LF         dc.b    "> Delay between characters. (~ 1/100 sec) [0-9] : "endmsg15 equ     *-msg15*--------------------------msg16    dc.b    C$CR,C$LF         dc.b    "> Add a linefeed for each carriage return received ? [Y/N] : "endmsg16 equ     *-msg16*--------------------------msg17    dc.b    C$CR,C$LF,C$LF,C$Bell         dc.b    "*** Upload has been aborted by the user."         dc.b    C$CR,C$LFendmsg17 equ     *-msg17*--------------------------msg18    dc.b    C$CR,C$LF         dc.b    "* Echo has been set."         dc.b    C$CR,C$LFendmsg18 equ     *-msg18*--------------------------msg19    dc.b    C$CR,C$LF         dc.b    "* Echo has been disabled."         dc.b    C$CR,C$LFendmsg19 equ     *-msg19*--------------------------msg20    dc.b    C$CR,C$LF         dc.b    "* Beginning upload for the requested file ..."         dc.b    C$CR,C$LFendmsg20 equ     *-msg20*--------------------------msg21    dc.b    C$CR,C$LF,C$LF         dc.b    "* Upload transfer has been successfully completed !"         dc.b    C$CR,C$LFendmsg21 equ     *-msg21*--------------------------msg22    dc.b    C$CR,C$LF         dc.b    "> Press any key to begin transfer."         dc.b    " ( [RETURN] = Cancel demand ) : "endmsg22 equ     *-msg22*--------------------------msg23    dc.b    C$CR,C$LF,C$Bell         dc.b    "* PRESSING {ESC} WHILE SENDING DATA, WILL ABORT TRANSFER. *"         dc.b    C$CR,C$LF,C$LFendmsg23 equ     *-msg23*--------------------------msg24    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** I'm patient, but the prompt delay timeout is exceeded !"endmsg24 equ     *-msg24*--------------------------msg25    dc.b    C$CR,C$LF         dc.b    "                              * Baud rate table *"         dc.b    C$CR,C$LF,C$LF         dc.b    "           0 = 50         1 = 75         2 = 110         3 = 134.5"         dc.b    C$CR,C$LF         dc.b    "           4 = 150        5 = 300        6 = 600         7 = 1200"         dc.b    C$CR,C$LF         dc.b    "           8 = 1800       9 = 2000       A = 2400        B = 3600"         dc.b    C$CR,C$LF         dc.b    "           C = 4800       D = 7200       E = 9600        F = 19200"         dc.b    C$CR,C$LF,C$LF         dc.b    "       > Press the corresponding key, or {RETURN} to ignore request : "endmsg25 equ     *-msg25*--------------------------msg26    dc.b    C$CR,C$LF         dc.b    "* Printer is now on duty !"         dc.b    C$CR,C$LFendmsg26 equ     *-msg26*--------------------------msg27    dc.b    C$CR,C$LF         dc.b    "* Printer will cool off as soon as possible."         dc.b    C$CR,C$LFendmsg27 equ     *-msg27*--------------------------msg28    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Unable to open path to the printer."         dc.b    C$CR,C$LFendmsg28 equ     *-msg28*--------------------------msg28a   dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Unable to open the pipe for the printer."         dc.b    C$CR,C$LFendmg28a equ     *-msg28a*--------------------------msg29    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Media error while trying to write to disk."         dc.b    C$CR,C$LFendmsg29 equ     *-msg29*--------------------------msg30    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Error reading media.  Please verify disk."         dc.b    C$CR,C$LFendmsg30 equ     *-msg30*--------------------------msg31    dc.b    "> "endmsg31 equ     *-msg31*--------------------------msg32    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Ooops ! No file to be closed at the moment."         dc.b    C$CR,C$LFendmsg32 equ     *-msg32*--------------------------msg33    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Where is the Dialer file ?  Can you help me to locate it ???"         dc.b    C$CR,C$LFendmsg33 equ     *-msg33*--------------------------msg34    dc.b    C$CR,C$LF         dc.b    "                 > Registered numbers in the dialer directory <"         dc.b    C$CR,C$LF         dc.b    "                   ------------------------------------------"         dc.b    C$CR,C$LFendmsg34 equ     *-msg34*--------------------------msg35    dc.b    C$CR,C$LF         dc.b    "       * Dialing {"endmsg35 equ     *-msg35*--------------------------msg36    dc.b    "}, using phone number : "endmsg36 equ     *-msg36*--------------------------msg37    dc.b    C$CR,C$LF,C$LF         dc.b    "       > Choose one number/letter.  ([RETURN]=Ignore) [1-9, A-Z] : "endmsg37 equ     *-msg37*--------------------------msg38    dc.b    C$Bell         dc.b    "> File already exist !  Want to overwrite it ? [Y/N] : "endmsg38 equ     *-msg38*--------------------------msg39    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Sorry, unable to locate this entry.  Please re-specify."         dc.b    C$CR,C$LFendmsg39 equ     *-msg39*--------------------------msg40    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** I'm exceeding the limit count for phone numbers."         dc.b    C$CR,C$LF         dc.b    "    Maximum quantity of entries allowed is 35."         dc.b    C$CR,C$LF,C$LF         dc.b    "*** Please apply appropriate changes to the Dialer file."         dc.b    C$CR,C$LFendmsg40 equ     *-msg40*--------------------------msg41    dc.b    " bytes to be uploaded."         dc.b    C$CR,C$LFendmsg41 equ     *-msg41*--------------------------msg42    dc.b    " bytes were written to file : "endmsg42 equ     *-msg42*--------------------------msg43    dc.b    C$Bellendmsg43 equ     *-msg43*--------------------------msg44    dc.b    C$CR,C$LF         dc.b    "> Specify value of the character that will serve as XON : "endmsg44 equ     *-msg44*--------------------------msg45    dc.b    C$CR,C$LF         dc.b    "> And for the XOFF, we will use ... : "endmsg45 equ     *-msg45*--------------------------*msg46    dc.b    "* Connection with remote station has been established ..."*         dc.b    C$CR,C$LF,C$LF*endmsg46 equ     *-msg46*--------------------------*msg47    dc.b    C$CR,C$LF,C$LF*         dc.b    "* Carrier loss detected.  Assuming normal disconnection."*         dc.b    C$CR,C$LF,C$LF*endmsg47 equ     *-msg47*--------------------------msg48    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** The specified device is not a valid one.  Sorry !"         dc.b    C$CR,C$LF,C$LF         dc.b    "*** Must be a SCF type device, having the same driver"         dc.b    C$CR,C$LF         dc.b    "    as the one specified in the control file."         dc.b    C$CR,C$LFendmsg48 equ     *-msg48*--------------------------**  Parity --> Bits 0-1 : 0=None, 1=Odd, 3=Even*msg49    dc.b    C$CR,C$LF         dc.b    "> What will be the type of parity to be used ? [{N}one, {O}dd, {E}ven] : "endmsg49 equ     *-msg49          *--------------------------**  Data Bits --> Bits 2-3 : 0=8, 1=7, 2=6, 3=5*msg50    dc.b    C$CR,C$LF         dc.b    "> How many data bits will be needed ? [5-8] : "endmsg50 equ     *-msg50          *--------------------------**  Stop Bits --> Bits 4-5 : 0=1, 1=1.5, 2=2*msg51    dc.b    C$CR,C$LF         dc.b    "> And for the stop bits, this will be ? [1=1, 2=1.5, 3=2] : "endmsg51 equ     *-msg51          *--------------------------**  Stop Bits --> Bits 4-5 : 0=1, 1=1.5, 2=2*msg52    dc.b    C$CR,C$LF         dc.b    "> The Parity/Data bits are being set to {8 N 1}.  Is this ok ? [Y/N] : "endmsg52 equ     *-msg52          *--------------------------msg53    dc.b    C$CR,C$LF         dc.b    "> Do you want the automatic buffer feature ? [Y/N] : "endmsg53 equ     *-msg53*--------------------------msg54    dc.b    C$CR,C$LF         dc.b    "* Now capturing the incoming data."         dc.b    C$CR,C$LF,C$LFendmsg54 equ     *-msg54*--------------------------msg55    dc.b    C$CR,C$LF         dc.b    "* Capture to buffer has been suspended by the remote."         dc.b    C$CR,C$LF,C$LFendmsg55 equ     *-msg55*--------------------------msg56    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Where is the Control file ?  Can you help me to locate it ???"         dc.b    C$CR,C$LFendmsg56 equ     *-msg56*--------------------------msg57    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Control file is imcomplete.  Please do appropriate changes."         dc.b    C$CR,C$LFendmsg57 equ     *-msg57*--------------------------msg58    dc.b    C$CR,C$LF,C$Bell         dc.b    "*** Invalid HDCPY value.  Assuming script file for printout."         dc.b    C$CR,C$LF         dc.b    "*** Press any key to continue ... "endmsg58 equ     *-msg58*============================================================================xmg1     dc.b    C$CR,C$LF         dc.b    "                              --------------------"         dc.b    C$CR,C$LF         dc.b    "                            < Xmodem file transfer >"         dc.b    C$CR,C$LF         dc.b    "                              --------------------"         dc.b    C$CR,C$LFendxmg1  equ     *-xmg1*--------------------------xmg2     dc.b    C$CR,C$LF         dc.b    "> {S}end or {R}eceive ? ( [RETURN] = Ignore request ) : "endxmg2  equ     *-xmg2*--------------------------xmg3     dc.b    " bytes to be sent. ( Packets : "endxmg3  equ     *-xmg3*--------------------------xmg4     dc.b    " - XModem, "endxmg4  equ     *-xmg4*--------------------------xmg5     dc.b    " - YModem )."         dc.b    C$CR,C$LF,C$LF,C$Bell         dc.b    "* PRESSING {ESC} WHILE SENDING DATA, WILL ABORT TRANSFER. *"         dc.b    C$CR,C$LF,C$LF         dc.b    "* Press [RETURN] to cancel or, any key to pursue with transfer : "endxmg5  equ     *-xmg5*--------------------------xmg6     dc.b    C$Bell         dc.b    "Block NAKed. Re-sending"endxmg6  equ     *-xmg6*--------------------------xmg7     dc.b    C$CR,C$LF         dc.b    "*** Xmodem transfer has been aborted !"endxmg7  equ     *-xmg7*--------------------------xmg8     dc.b    C$Bell         dc.b    "Xfer canceled by user. "endxmg8  equ     *-xmg8*--------------------------xmg9     dc.b    C$Bell         dc.b    "CAN issued by remote ! "endxmg9  equ     *-xmg9*--------------------------xmg10    dc.b    C$Bell         dc.b    "Error accessing media. "endxmg10 equ     *-xmg10*--------------------------xmg11    dc.b    C$Bell         dc.b    "Remote site on timeout!"endxmg11 equ     *-xmg11*--------------------------xmg12    dc.b    C$Bell         dc.b    "Waiting for remote ... "endxmg12 equ     *-xmg12*--------------------------xmg15    dc.b    C$Bell         dc.b    "Too bad, I'm quitting !"endxmg15 equ     *-xmg15*--------------------------xmg16    dc.b    " Lookin' good Dude !!! "endxmg16 equ     *-xmg16*--------------------------xmg19    dc.b    C$Bell         dc.b    "Synchronisation error. "endxmg19 equ     *-xmg19*--------------------------xmg20    dc.b    C$Bell         dc.b    "Requesting same block. "endxmg20 equ     *-xmg20*--------------------------xmg21    dc.b    C$CR,C$LF         dc.b    "> File to send. (Press [RETURN] to void request) : "endxmg21 equ     *-xmg21*--------------------------xmg22    dc.b    C$CR,C$LF         dc.b    "     - Blk # -     - Bytes -     - Error -     - Last Status Message -"         dc.b    C$CR,C$LF         dc.b    "     =========     =========     =========     ======================="         dc.b    C$CR,C$LF         dc.b    "                                               "endxmg22 equ     *-xmg22*=======================         align*=======================******************************************************************************                    ------ Macros definitions ------****   1) push         Push D0, D1 and A0 on stack**   2) pull         Pull D0, D1 and A0 from stack**push     MACRO         movem.l d0-d7/a0-a5,-(a7)     Save registers on stack         ENDMpull     MACRO         movem.l (a7)+,d0-d7/a0-a5     Retrieve registers back from stack         ENDM****************************************************************************                      ------  Main program entry  ------**  First, check the command line.*ATerm_Go push                          Keep registers for later         lea     vs_top(a6),a0         Top VSect         lea     vs_bot(a6),a1         Bottom of the Vsect areainit_0   clr.b   (a0)+                 Initialize Vsect area         cmpa.l  a1,a0                 Are we done ?         bmi.s   init_0                Nope, so keep going ...         bsr     set_env               Set parms using environment variables         lea     prt_name(a6),a0       Point to the printer path name         cmpi.b  #'/',(a0)             Are we using default ?         bne.s   init_1                Nope, we have to analyse parm         move.b  #$01,dir_outp(a6)     Indicate that we do direct output         bra.s   init_9                And continue on with the setupinit_1   andi.b  #$DF,(a0)             Mask lower case         cmpi.b  #'D',(a0)             User is asking for direct output ?         bne.s   init_4                Nope, so check for script processing         move.b  #$01,dir_outp(a6)     We do direct output.  Now get path name         lea     prt_name(a6),a1       Point to the beginning of itinit_2   addi.l  #$01,a0               Position to the next character         cmpi.b  #'/',(a0)             Have we reached the delimiter ?         bne.s   init_2                No, so keep goinginit_3   move.b  (a0)+,(a1)+           Put it at the top of the buffer         cmpi.b  #C$Null,(a0)          Buffer filled ?         bne.s   init_3                Nope, we need to do more         bra.s   init_9                All set, now branch for something elseinit_4   cmpi.b  #'S',(a0)             Are we using a script file for print ?         beq.s   init_9                Yes, so keep everything is fine ...         lea     msg58(pc),a0          --> Invalid HDCPY parm. Assuming script         move.l  #endmsg58,d1          Get message length         bsr     std_out               And advise user ...init_5   bsr     read_kbd              Read a key from the keyboard         bcs.s   init_5                Wait 'till a key is depressed         init_9   bsr     set_frk               Set parameter area for the F$Fork call         bsr     get_ctl               And, read control file ...         pull                          Restore registers to their values**         lea     prt_name(a6),a0*         move.w  #15,d1*         bsr     std_out*         bra     exit00*         tst.b   ctl_ok(a6)            Are the controls all ok ?         beq     exit00                Nope, so exit right away !!!         cmpi.b  #C$CR,(a5)            any parameter on cmd line ?         beq.s   abort                 no, so abortscan     move.b  (a5)+,d0              get next character on cmd line         cmpi.b  #C$Spac,d0            a space ?         beq.s   scan                  yes, skip it         cmpi.b  #'/',d0               a slash for the descriptor path ?         beq.s   test_ser              Yes, so validate serial port choiceabort    bsr     cls                   Clear screen ...         lea     mesg1(pc),a0          --> Help message         move.l  #endmesg1,d1         bra     op_exit               And return to systemtest_ser movea.l a5,a0                 transfer in a0         push                          Save registers values         move.w  #(Devic<<8)+0,d0      It must be a device descriptor         os9     F$Link                Link to it in order to take a peek         bcs.s   bad_dd                Unable to link properly         move.b  #$01,unlk_dd(a6)      Indicate that we will unlink it later         move.l  a2,dd_add(a6)         Keep it for later reference         cmpi.b  #DT_SCF,M$DTyp(a2)    Do we have an SCF device ?         bne.s   bad_dd                If not, indicate a bad selectionchk_drv  movea.w M$PDev(a2),a0         Get offset to the device driver name         adda.l  a0,a2                 Point to it         lea     ctl_tbl(a6),a0        Point to the beginning of the table         move.l  #seq_len*s_dev_dr,d1  Get offset for the device driver name         adda.l  d1,a0                 Add offset as previously computed         moveq   #seq_len,d0           Will have to compare this amount (max)         subi.l  #$01,d0               Adjust for the DBxx loopcmp_drv  cmpm.b  (a0)+,(a2)+           Matching bytes ?         bne.s   bad_dd                Nope, so indicate a bad choice         cmpi.b  #$FF,(a0)             Have we reached the end of string ?         beq.s   good_dd               If so, assume end of device driver name         dbra    d0,cmp_drv            Keep checking ...         bra.s   good_dd               We have a good choice !!!bad_dd   move.b  #$01,valid_dd(a6)     Indicate an invalid device descriptorgood_dd  pull                          Restore them as they were         tst.b   unlk_dd(a6)           Do we have to unlink the device desc. ?         beq.s   tst_val               Nope, so just check for validity         movea.l dd_add(a6),a2         Get the module header address         os9     F$UnLink              Unlink the moduletst_val  tst.b   valid_dd(a6)          Do we have a valid descriptor ?         bne.s   not_val               Indicate it to our user ...         suba.l  #$01,a0               re-adjust path address pointer         moveq   #Updat_,d0            Update mode         os9     I$Open                open the serial path         bcc.s   set_ser               Go set the serial port parametersoperror  lea     mesg2(pc),a0          --> Unable to open serial port         move.l  #endmesg2,d1         bra.s   op_exitnot_val  lea     msg48(pc),a0          --> Invalid device descriptor         move.l  #endmsg48,d1op_exit  bsr     std_out               Write byte/message to screen         bra     exit00                and exitset_ser  move.w  d0,mdm_path(a6)       save this new path         os9     I$Dup                 Duplicate this path         move.w  d0,md_path2(a6)         moveq   #SS_Opt,d1            Function code for Path Desc Option         lea     opt_t1_o(a6),a0       Where to store the Original version         os9     I$GetStt              Get it ...         lea     opt_t1_w(a6),a0       This one will be our working copy         os9     I$GetStt              Get the info ...         clr.b   PD_EKO-PD_OPT(a0)     Disable ECHO function         clr.b   PD_PAU-PD_OPT(a0)      "   "  PAUSE function         clr.b   PD_EOF-PD_OPT(a0)      "   "  End-Of-File character         clr.b   PD_RPR-PD_OPT(a0)      "   "  REPRINT character         clr.b   PD_DUP-PD_OPT(a0)      "   "  DUPlicate last line char.         clr.b   PD_PSC-PD_OPT(a0)      "   "  PAUSE character         clr.b   PD_INT-PD_OPT(a0)      "   "  INTERRUPT character (CTL-C)         clr.b   PD_QUT-PD_OPT(a0)      "   "  QUIT character (CTL-E)         clr.b   PD_XOFF-PD_OPT(a0)    Will enable the handshake only when         clr.b   PD_XON-PD_OPT(a0)     Up/Downloading ASCII files         move.b  PD_PAR-PD_OPT(a0),d2  Get actual Parity, Data Bits, Stop Bit         andi.b  #$C0,d2               Clear bits to have : 8 N 1         move.b  d2,PD_PAR-PD_OPT(a0)  Set it up         os9     I$SetStt              Set path descriptor with new values*         bsr     sig_c_rl              Release modem from pending SS_xxx         bsr     kbd_rel               Release keyboard*         bsr     sig_c_on              Enable signal on Carrier Detect ON*         bsr     sig_c_of              Enable signal on Carrier Detect OFF*--------------------------------------------------------------------*  Save original "/TERM" state before any modifications dynamically*  done by ATerm so it can be restore when exiting ATerm.*--------------------------------------------------------------------         moveq   #stdin,d0             Standard input path (TERM)         moveq   #SS_Opt,d1            System call to copy descriptor         lea     pd_trm_o(a6),a0       Original copy will go there         os9     I$GetStt              Get it ...         lea     pd_trm_w(a6),a0       Now this will be our working version         os9     I$GetStt              Get it once more ...         clr.b   PD_PAU-PD_OPT(a0)     Disable PAUSE option         clr.b   PD_PSC-PD_OPT(a0)      "   "  PAUSE character         clr.b   PD_XOFF-PD_OPT(a0)    Make sure that /TERM will not react         clr.b   PD_XON-PD_OPT(a0)     to the Xon/Xoff handshake*------*debug1  clr.b   PD_INT-PD_OPT(a0)     Disable ^C (C$Intr) ($03)*debug2  clr.b   PD_QUT-PD_OPT(a0)      "   "  ^E (C$Quit) ($05)*------         os9     I$SetStt              Set it for the rest of the session*--------------------------------*  Initialisation of some flags*--------------------------------         move.b  #$01,whit_0(a6)       Replace leading '0' with spaces         move.b  #C$XOn,cust_xon(a6)   Set customized XON to the normal one         move.b  #C$XOff,cust_xof(a6)  Set customized XOFF to the standard*---------------------------------------------*  Show main title, menu and get on line !!!*---------------------------------------------         bsr     anormal         moveq   #$03,d0               System time in Julian format w/ticks         os9     F$Time                Get requested information         swap    d3                    Put ticks/sec in lower half         move.w  d3,tik_rate(a6)       Here we go ....         bsr     set_trap              Install intercept trap         bsr     cls                   Clear the screen         lea     mesg1(pc),a0          --> Main title         move.l  #endtitle,d1         bsr     std_out               Write byte/message to screen         bsr     show_mnu              go show main menu to user         bsr     on_line               and go to terminal mode******************************************************************  Main program loop. Program loop here when waiting for user.*readkey  bsr     read_kbd              Check keyboard, and read data if any         bcs.s   no_key                nothing, so skip keyboard scan         move.b  (a0),abort_uf(a6)     for later check for an abort         cmpi.b  #help_key,(a0)        it was the "HELP" key on Atari ST ?         beq.s   suspend               yes, suspend prg. and show menu         cmpi.b  #C$EM,(a0)            is it CONTROL Y ?         beq.s   suspend               yes, suspend prg. and show menu         tst.b   echoflag(a6)          do we want to echo the character ?         beq.s   no_echo               no         bsr     std_out               Write byte/message to screenno_echo  bsr     wrt_mdm               Send byte to the modem pathno_key   bsr     read_mdm              Check modem and read data if any         bcc.s   ser_chr               yes, so get it         tst.b   u_flag(a6)            are we uploading ?         bne     do_upld               Yes, So keep going ...         bra.s   readkey               nothing, go check the keyboardser_chr  tst.b   u_flag(a6)            are we uploading ?         bne.s   go_on                 yes, so don't bother with what follow         bsr     std_out               Write byte/message to screenskip_0   tst.b   pr_echo(a6)           want to print the character?         beq.s   no_pri                no         bsr     print_ch              go print character on printerno_pri   tst.b   lf_flag(a6)           want to add a linefeed ?         beq.s   skip_pr               no         cmpi.b  #C$CR,(a0)            yes, but is it a carriage return ?         bne.s   skip_pr               no, so skip         move.b  #C$LF,(a0)            echo with a linefeed         bsr     std_out               Write byte/message to screenskip_pr  tst.b   d_flag(a6)            are we downloading ?         beq.s   go_on                 no, go on with regular reception         bsr     keep_chr              yes, go save received charactergo_on    bra.s   readkey               loop on this main routine****************************************************************************  Main program comes here when ^Y is hit. It will print menu on screen.*suspend  bsr     cls                   Clear the screen         bsr     show_mnu              go write main menu on screen         lea     mesg7(pc),a0          --> Make your selection         move.l  #endmesg7,d1         bsr     std_out               Write byte/message to screenrepeat   bsr     read_kbd              Any data to be picked up from kbd ?         bcs.s   repeat                Nope, keep waiting ...         andi.b  #$DF,(a0)             Mask lower case         lea     options(pc),a1        Point to the first valid option         move.b  (a0),d2               Get a copy of the key         moveq   #qty_opt-1,d1         Adjust options qty for the DBEQ loopvalidat  cmp.b   (a1)+,d2              Compare key against table         dbeq    d1,validat            Until found / table exhausted         tst.w   d1                    Have we a good option ?         bpl.s   goodopt               Yes, so connect and do the work         bsr     ring                  Nope ! Notify the user by ringing         bra.s   repeat                And re-ask him to choose againgoodopt  moveq   #$01,d1               Will put only one character         bsr     putchr                Go show it on the screen         cmpi.b  #'T',(a0)             terminal mode is the choice ?         bne.s   other                 go check others choices         bsr     on_line               else show back on line         bra     readkey               go back to terminal modeother    cmpi.b  #'B',(a0)             Change baud rate         beq     do_baud         cmpi.b  #'C',(a0)             Cr/LF Translation         beq     add_lf         cmpi.b  #'D',(a0)             Download ASCII file         beq     download         cmpi.b  #'E',(a0)             Toggle echo (Half Duplex)         beq     tog_echo         cmpi.b  #'F',(a0)             Set flow characters (XON/XOFF)         beq     do_flow         cmpi.b  #'I',(a0)             Invoke dialer         beq     dial_0         cmpi.b  #'O',(a0)             Close ASCII download file         beq     clos_dld         cmpi.b  #'P',(a0)             Printer toggle         beq     do_pr         cmpi.b  #'Q',(a0)             Quit to system level         beq     the_end         cmpi.b  #'S',(a0)             OSK shell command processor         beq.s   callsys         cmpi.b  #'U',(a0)             Upload ASCII file         beq     upload         cmpi.b  #'X',(a0)             XModem (CSUM / CRC)         beq     do_xmodm         cmpi.b  #'Y',(a0)             YModem (YModem 1K / Batch)         beq     do_ymodmnext_opt bra     readkey               Accessed with further developpement*-------------------------------------------------------------------*  This point will be accessed when new options will be installed. |*-------------------------------------------------------------------*************************************************************  [S] System : The user wants access to OS9/68000 shell.*callsys  bsr     tempokbd              restore a temporary keyboard         bsr     cls                   clear screen         clr.w   d0                    any module type         clr.l   d1                    No additionnal memory needed         move.l  prm_size(a6),d2       Parameter size         move.w  #$03,d3               # of paths : In, Out, Err         move.w  #0,d4                 Priority, Same as Parent         lea     shell_nm(a6),a0       Module name pointer         lea     fork_prm(a6),a1       Command line parameters         os9     F$Fork                Fork the process         bcc.s   ok_fork               Successfull, so continue on         lea     mesg4(pc),a0          --> Shell error while forking ...         move.l  #endmesg4,d1         bsr     std_out               Write byte/message to screenfork_00  bsr     read_kbd              Wait for user to acknowledge         bcs.s   fork_00               Keep waiting 'till a key is depressedok_fork  os9     F$Wait                Wait for the child to die         bsr     anormal               restore keyboard         bsr     cls                   clear screen         bsr     show_mnu              reshow the menu         bsr     on_line               go back to terminal mode         bra     readkey               and main program loop**********************************  [D] Ascii download section.*download clr.b   x_mode(a6)            Reset Xmodem status flag, just in case         tst.b   d_flag(a6)            check if a download file is already open         beq.s   cont_dl               no, so continue normal download         bsr     save_dld              yes, go save memory beforecont_dl  move.b  #$01,d_flag(a6)       download flag for main programask_file bsr     tempokbd              restore a temporary keyboardask_fil2 lea     mesg8(pc),a0          --> Specify file name ...         move.l  #endmesg8,d1         bsr     std_out               Write byte/message to screen         moveq   #stdin,d0             select standard input path         moveq   #80,d1                maximum path length         lea     dfilenam(a6),a0       where to store download filename         os9     I$ReadLn              read download filename         move.l  d1,dfilelen(a6)       Keep the file name length for later         cmpi.l  #$01,d1               only one byte for filename         bne.s   create                no, so the user really want that file         cmpi.b  #C$CR,(a0)            want to abort download ?         beq.s   ab_downl              yes, so confirm the annulationcreate   moveq   #Updat_,d0            access mode         moveq   #Updat_+PUpdat_,d1    access permission         move.l  #bsize,d2             optional size (Buffer Size)         lea     dfilenam(a6),a0       the choosen name         os9     I$Create              create the file         move.w  d0,fd_path(a6)        file download path number         cmpi.w  #E$BPNam,d1           Bad file name ?         bne.s   chk_cef               Check if creating an existing file         bsr     ring                  Ring the bell !!!         bra.s   ask_fil2              Re-Ask the user for a filenamechk_cef  cmpi.w  #E$CEF,d1             already exist ?         bne.s   ok_downl              if everything OK         bsr     anormal               Restore keyboard to previous statusask_dl   bsr     mkcrlf                Insert a blank line         lea     msg38(pc),a0          --> File already exist. Overwrite ...         move.l  #endmsg38,d1         bsr     std_out               Write byte/message to screenask_dl1  bsr     read_kbd              Any data ready for us on keyboard ?         bcs.s   ask_dl1               No, so keep waiting         andi.b  #$DF,(a0)             filter lower case         cmpi.b  #'Y',(a0)             delete the existing file ?         bne.s   test_n                yes         bsr     putchr                Echo user's reply on screen         moveq   #Updat_,d0            access mode         lea     dfilenam(a6),a0       name of the file         os9     I$Delete              delete the file         bra.s   create                and go back create ittest_n   cmpi.b  #'N',(a0)             don't delete ?         beq.s   ab_dld                go abort download         bsr     ring                  ring the bell         bra.s   ask_dl1               if invalid user choiceab_dld   bsr     putchr                Put user's reply on the screenab_downl clr.b   d_flag(a6)            clear download flag         clr.b   x_mode(a6)         bra.s   skip_flg              skip the flagok_downl tst.b   x_mode(a6)            Are we in the XModem mode ?         beq.s   n_mode                Nope, so branch on normal process         bra     x_return              Otherwise return to XModem routinen_mode   move.b  #$01,clos_flg(a6)     show main program that file is opened         lea     f_downld(a6),a3       initialize memory buffer         lea     opt_t1_w(a6),a0       This one is our working copy         bsr     xn_xf_on              Enable Xon/Xoff handshake         bsr     anormal               Restore keyboard features         bsr     auto_bfr              Ask user for automatic buffer         bra.s   skp_flg0              Return onlineskip_flg bsr     anormal               file is open; restore keyboardskp_flg0 bsr     on_line               go back to terminal mode         bra     readkey               and main program loop************************************  [O]  Close the download file.*clos_dld tst.b   clos_flg(a6)          Check if the file is already opened         beq.s   close_2               Nope, nothing to close. Notify user.         bsr     save_dld              yes, it is opened; go close it         bra.s   close_3               and exitclose_2  lea     msg32(pc),a0          --> Sorry, there is no file to close         move.l  #endmsg32,d1         bsr     std_out               Write byte/message to screenclose_3  bsr     anormal               restore keyboard         bsr     on_line               go back to terminal mode         bra     readkey               and main program loop****************************************  [U] An ASCII upload is requested.*upload   tst.b   clos_flg(a6)          check if a download file is left open         beq.s   not_open              yes, it is already close         bsr     save_dld              no, so save and close it beforenot_open clr.l   rcvd_chr(a6)          clear character counter         bsr     auto_bfr              Ask user for automatic buffer         bsr     tempokbd              temporary keyboardbadufn   lea     msg11(pc),a0          --> Upload file name ...         move.l  #endmsg11,d1         bsr     std_out               Write byte/message to screen         moveq   #stdin,d0             standard input path         lea     ufilenam(a6),a0       where to store data from keyboard         moveq   #80,d1                maximum length         os9     I$ReadLn              get the filename to upload         move.l  d1,ufilelen(a6)       Get the length of the path name         cmpi.l  #$01,d1               only one byte for filename         bne.s   open_it               no         cmpi.b  #C$CR,(a0)            want to cancel request ?         beq     end_upld              yesopen_it  bsr     mkcrlf                Issue a CR/LF on the screen         moveq   #Read_,d0             access mode: read only         os9     I$Open                open that file         bcc.s   fi_there              file is there         lea     msg12(pc),a0          --> Can't open requested file ...         move.l  #endmsg12,d1         bsr     std_out               Write byte/message to screen         bra.s   badufn                bad upload filenamefi_there move.w  d0,fu_path(a6)        save this new path number         bsr     size_it               go compute and print file size         bsr     anormal               Restore keyboard specs.         tst.l   number(a6)            Is this an empty file ?         bne.s   fi_ok_1               Nope, so keep going         lea     mesg9(pc),a0          --> Requested file is empty         move.l  #endmesg9,d1         bsr     std_out               Write byte/message to screen         bsr     mkcrlf                Issue a 'white line' ...         bra     close_up              Go close the file and returnfi_ok_1  bsr     arrow                 Display an arrow in front of the value         bsr     show_val              Display file size         lea     msg41(pc),a0          --> ... bytes to be uploaded.         move.l  #endmsg41,d1         bsr     std_out               Write byte/message to screenfi_ok    move.b  #$01,u_flag(a6)       signify to main program an upload state         lea     msg13(pc),a0          --> Upload character prompt         move.l  #endmsg13,d1         bsr     std_out               Write byte/message to screenfi_ok_2  bsr     read_kbd              Check for data on keyboard ?         bcs.s   fi_ok_2               Keep waiting ...         move.b  (a0),u_prompt(a6)     Keep it for later reference         bsr     putchr                Put user's reply on screen         cmpi.b  #C$CR,(a0)            is it a carriage return ?         bne.s   one_chr               no, there is one character promptrefuse   move.b  #$01,cr_flag(a6)      signify no prompt character         lea     msg14(pc),a0          --> Upload delay after CR ...         move.l  #endmsg14,d1         bsr     std_out               Write byte/message to screenask_del  bsr     in_0_9                Go ask for the value ...         addi.l  #$01,d2               Insure a non-zero value         mulu.w  tik_rate(a6),d2       Get x times the tik_rate         divu.w  #10,d2                Put it in 1/10th sec units         andi.l  #$FFFF,d2             Get rid of the remainder         addi.l  #$01,d2               To round to the highest integer         move.l  d2,cr_delay(a6)       Now we have our delay set upone_chr  lea     msg15(pc),a0          --> Delay between characters ...         move.l  #endmsg15,d1         bsr     std_out               Write byte/message to screenask_dch  bsr     in_0_9                Get the desired value.         mulu.w  tik_rate(a6),d2       Get x times the tik_rate         divu.w  #100,d2               Put it in 1/100th sec units         andi.l  #$FFFF,d2             Get rid of the remainder         addi.l  #$01,d2               To round to the highest integer         move.l  d2,u_delay(a6)        save that value for laterask_ue   lea     msg22(pc),a0          --> Press any key to begin ...         move.l  #endmsg22,d1         bsr     std_out               Write byte/message to screenask_ue_a bsr     read_kbd              Data to be read ?         bcs.s   ask_ue_a              Keep waiting ...         bsr     mkcrlf                Issue a CR/LF on the screen         cmpi.b  #C$CR,(a0)            want to abort now         beq     ab_upl1               yes, go cancel request         lea     msg20(pc),a0          --> Beginning upload for requested file         move.l  #endmsg20,d1         bsr     std_out               Write byte/message to screen         lea     msg23(pc),a0          --> Press any key to abort         move.l  #endmsg23,d1         bsr     std_out               Write byte/message to screen         lea     opt_t1_w(a6),a0       This one is our working copy         bsr     xn_xf_on              Enable Xon/Xoff Handshake         clr.b   kb_abort(a6)          Reset keyboard abort flag         bsr     kbd_det               Set keyboard intercept trap         tst.b   auto_buf(a6)          Are we using automatic buffer ?         beq.s   recharge              Nope so just continue on         lea     mbuffer(a6),a0        Point to modem's I/O buffer         move.b  #C$DC2,(a0)           Insert our Auto-Open buffer command         bsr     wrt_mdm               Send it to the remoterecharge bsr     fill_buf              Go fill up the buffer         bcs.s   errread               Oooops, an error occured while reading         move.l  a3,bfr_ptr(a6)        Keep track of the buffer address         bra     readkey               back to main looperrread  lea     msg30(pc),a0          --> Error reading disk ...         move.l  #endmsg30,d1         bsr     std_out               Write byte/message to screen         bsr     on_line               go write program back on line         bra     readkey               return to main program************************************************************  Main program comes here if we are in an upload state.*do_upld  tst.l   u_delay(a6)           a delay before sending character ?         beq.s   no_delay              no, don't delay         move.l  u_delay(a6),d0        get user's delay in 1/100th sec units         os9     F$Sleep               Take a little nap ...no_delay move.l  bfr_ptr(a6),a3        Get a copy of the buffer pointer         movea.l a3,a0                 transfer reg. a3 to a0         bsr     wrt_mdm               Write the byte on the modem path         bsr     std_out               Echo on screen as well ...         tst.b   pr_echo(a6)           echo the upload on printer ?         beq.s   dont_pr               no don't do that         bsr     print_ch              yes, do itdont_pr  cmpi.b  #C$CR,(a3)            a carriage return ?         bne.s   skip_pmt              no, skip         bsr     mkcrlf                Issue a CR/LF on the screen         tst.b   cr_flag(a6)           an upload prompt exist ?         bne.s   wait_lin              no, skiptimer_0  moveq   #$01,d0               julian code         os9     F$Time                get system time in julian format         addi.l  #60,d0                add 60 seconds to that time         move.l  d0,d7                 and keep that for latertimer_1  bsr     read_mdm              Check modem for data availability         bcc.s   rcvd_pmt              yes, so get it         tst.b   kb_abort(a6)          User want to abort ?         bne.s   ab_upl                Yes, so return ...timer_2  moveq   #$01,d0               keep waiting: get julian time         os9     F$Time                again on system         cmp.l   d0,d7                 60 seconds wait exceeded ?         bpl.s   timer_1               not yet, loop         lea     msg24(pc),a0          --> Upload delay timeout exceeded         move.l  #endmsg24,d1         bsr     std_out               Write byte/message to screen         bra.s   ab_upl                go abort uploadrcvd_pmt move.b  u_prompt(a6),d3       it was the prompt character ?         cmp.b   (a0),d3         bne.s   timer_0               no         bsr     std_out               Write byte/message to screen         bra.s   skip_pmt              Don't wait, get ready for more actionwait_lin move.l  cr_delay(a6),d0       Get the desired 1/10th sec delay         os9     F$Sleep               Take a nap for the specified timeskip_pmt tst.b   kb_abort(a6)          Want to abort upload ?         bne.s   ab_upl                yes go abort upload         addi.l  #$01,bfr_ptr(a6)      increment buffer pointer         addi.l  #$01,u_countr(a6)     increment the counter         move.l  u_countr(a6),d3       at the end of memory buffer ?         move.l  rcvd_chr(a6),d4         cmp.l   d3,d4                 Sent = Capacity of the buffer ?         bne     readkey               not yet         cmpi.l  #bsize,d3             check for end-of-file         bmi.s   do_eof                do it if so         bra     recharge              else go recharge buffer*-------------------------*  Close the upload file*-------------------------do_eof   lea     msg21(pc),a0          --> Upload transfer complete         move.l  #endmsg21,d1         bsr     std_out               Write byte/message to screenclose_up move.w  fu_path(a6),d0        upload is finish         os9     I$Close               close the file         clr.b   cr_flag(a6)           clear upload prompt flag         clr.b   u_flag(a6)            upload is finish         clr.l   rcvd_chr(a6)          clear character counter         bra.s   end_upld              everything was okab_upl   lea     msg17(pc),a0          --> Upload is aborted ...         move.l  #endmsg17,d1         bsr     std_out               Write byte/message to screenab_upl1  tst.b   u_flag(a6)            something was opened ?         bne.s   close_up              yes, go close upload fileend_upld bsr     anormal               restore keyboard         lea     opt_t1_w(a6),a0       This one is our working copy         bsr     xn_xf_of              Disable Xon/Xoff handshake         bsr     kbd_rel               Release keyboard intercept trap         tst.b   auto_buf(a6)          Are we using automatic buffer ?         beq.s   back_on               Nope, so simply return back online         lea     mbuffer(a6),a0        Point to modem's I/O buffer         move.b  #C$DC4,(a0)           Insert our Auto-Close buffer command         bsr     wrt_mdm               Send it to the remoteback_on  bsr     on_line               go back to terminal mode         bra     readkey               and main program loop*****************************************  [C]  Echoing a linefeed on screen.*add_lf   lea     msg16(pc),a0          --> Add a linefeed after each CR ...         move.l  #endmsg16,d1         bsr     std_out               Write byte/message to screenbdchoice bsr     read_kbd              Check for a depressed key and         bcs.s   bdchoice              Keep waiting if nothing         andi.b  #$DF,(a0)             mask lower case         cmpi.b  #'N',(a0)             want to add a linefeed ?         beq.s   no_lf                 no, stay as is or remove them         cmpi.b  #'Y',(a0)             yes         beq.s   set_lf                bad choice from user on keyboard         bsr     ring                  Ring the bell, wrong choice !         bra.s   bdchoice              Go Re-Ask the user ...set_lf   move.b  #$01,lf_flag(a6)      notify yes to main program         bra.s   lf_done               done with linefeed selectno_lf    clr.b   lf_flag(a6)           clear linefeed flaglf_done  bsr     putchr                Echo user's choice on screen         bsr     on_line               go back to terminal mode         bra     readkey               and main program loop*********************************************  [E]  The user wants to add local echo.*tog_echo tst.b   echoflag(a6)          what is echo state ?         bne.s   clr_echo              so we want to clear echoset_echo move.b  #$01,echoflag(a6)     set the echo         lea     msg18(pc),a0          --> Echo is now ON         move.l  #endmsg18,d1         bsr     std_out               Write byte/message to screen         bra.s   tog_end               go back to main programclr_echo clr.b   echoflag(a6)          clear the echo         lea     msg19(pc),a0          --> Echo is now OFF         move.l  #endmsg19,d1         bsr     std_out               Write byte/message to screentog_end  bsr     on_line               Show message back Online ...         bra     readkey               Return to the main loop***************************************  [I]  User want to dial a number.*dial_0   tst.b   pf_flag(a6)           check first if file already read         bne.s   dial_1                it was         moveq   #Read_,d0             access mode         lea     phon_fil(a6),a0       Pathname used by the dialer         os9     I$Open                open the file         bcc.s   dial_2                if success         lea     msg33(pc),a0          --> Can't locate dialer file ...         move.l  #endmsg33,d1         bsr     std_out               Write byte/message to screen         bsr     on_line               back to terminal mode         bra     readkey               and main program loopdial_2   lea     phbuffer(a6),a0       points at phone numbers buffer         move.b  #C$CR,(a0)+           Insert a CR at the top         move.l  #dial_siz,d1          maximum to read (35*80)         os9     I$Read                read the numbers from file         move.l  d1,ph_read(a6)        number of bytes actually read         os9     I$Close               close the file         move.b  #$01,pf_flag(a6)      say that the file was readdial_1   lea     msg34(pc),a0          --> Registered numbers in directory         move.l  #endmsg34,d1         bsr     std_out               Write byte/message to screen         move.l  ph_read(a6),d2        initialize scanner (Bytes read)         subi.l  #$01,d2               Adjust counter for the DBRA loop         lea     phbuffer(a6),a0       where to find numbers to write         clr.b   dash_flg(a6)          initialize how many numbers         moveq   #$01,d1               Will write one byte at oncedial_3   bsr     std_out               Put it on the screen         cmpi.b  #']',(a0)             Is it a marker ?         bne.s   dial_5                no         addi.b  #$01,dash_flg(a6)     yes, increment number flagdial_5   cmpi.b  #C$CR,(a0)            is it a carriage return?         bne.s   dial_4                no         move.b  (a0),-(a7)            push character         move.b  #C$LF,(a0)            send a linefeed         os9     I$Write               on screen         move.b  (a7)+,(a0)            puls characterdial_4   adda.l  #$01,a0               increment buffer address         dbra    d2,dial_3             all done ?         cmpi.b  #max_nos,dash_flg(a6) did we exceed max. qty of numbers ?         ble.s   dial_8                no, it's ok ...         lea     msg40(pc),a0          --> Too many phone # in file ...         move.l  #endmsg40,d1         bsr     std_out               Write byte/message to screen         bra     dial_6                and go back to terminal modedial_8   lea     msg37(pc),a0          --> Choose one letter/number         move.l  #endmsg37,d1         bsr     std_out               Write byte/message to screendial_8a  bsr     ring                  Ring the little bell ...dial_8aa bsr     read_kbd              Go get user's answer         bcs.s   dial_8aa              Nothing so far, wait for him         cmpi.b  #C$CR,(a0)            want to abort ?         beq     dial_6a               yes, so exit dialer routine         cmpi.b  #'1',(a0)             Compare value against '1' ASCII         bmi.s   dial_8a               Invalid key, re-ask user         cmpi.b  #'9',(a0)             What about against '9' ASCII ?         ble.s   dial_16               Looks good, so keep going         andi.b  #$DF,(a0)             Mask lower case         cmpi.b  #'A',(a0)             Now, what about 'A' ?         bmi.s   dial_8a               Nope, still invalid, re-ask user         cmpi.b  #'Z',(a0)             Finally, compared to 'Z' ?         ble.s   dial_16               Yep, we have a good key         bra.s   dial_8a               Nope, still have to ask this userdial_16  move.b  (a0),d2               keep that number/letter         bsr     putchr                Show key to user         move.b  #$01,dial_flg(a6)     indicate that we are in dial mode         lea     phbuffer(a6),a1       initialize buffer pointer         movea.l a1,a2                 keep it for later reference         adda.l  #dial_siz,a2          a2 points at the end of bufferdial_7   cmpa.l  a1,a2                 did we exceed buffer length ?         bmi     dial_17               yes, so can't locate entry         move.b  (a1),d4               get buffer character         cmp.b   d4,d2                 same than the keyboard ?         beq.s   dial_15               yes, proceed with search         adda.l  #$01,a1               no, increment pointer         bra.s   dial_7                and keep on scanningdial_15  adda.l  #$01,a1               get next character before         cmpi.b  #']',(a1)             it was an end-of-line ?         beq.s   dial_18               yes, so we found our number         adda.l  #$02,a1               no, re-adjust pointer         bra.s   dial_7                and scan againdial_18  lea     msg35(pc),a0          --> Dialing ...         move.l  #endmsg35,d1         bsr     std_out               Write byte/message to screen         move.l  #seq_len*s_rev_on,d1  Get offset for 'Reverse On'         bsr     wrt_seq               Write Appropriate sequence         movea.l a1,a0                 transfer pointer         adda.l  #$02,a0               re-adjust pointer         move.l  #$01,d1               Will write one byte a oncedial_9   cmpi.b  #':',(a0)             Check for end of name marker         beq.s   dial_10               Name completed ? If so branch         os9     I$Write               Otherwise show it on screen         adda.l  #$01,a0               Advance pointer for next character         bra.s   dial_9                Keep going until donedial_10  move.l  #seq_len*s_rev_of,d1  Get offset for 'Reverse Off'         bsr     wrt_seq               Send appropriate sequence         lea     msg36(pc),a0          --> ... using phone number ...         move.l  #endmsg36,d1         bsr     std_out               Write byte/message to screendial_10a cmpi.b  #'@',(a1)+            Now finding the baud selection         beq.s   dial_10b              Ok, now we've got it         bra.s   dial_10a              Keep searchingdial_10b movea.l a1,a0                 Get a copy of the pointer         move.b  (a1),inbuffer(a6)     Put a copy of in input buffer         push                          Save registers on stack         lea     inbuffer(a6),a0       Simulate keyboard input         bsr     auto_bd               Not set the baud rate accordingly         pull                          Restore registers values         clr.b   dial_flg(a6)          Reset auto_dial flagdial_11  cmpi.b  #'#',(a1)+            now try to find phone number         beq.s   dial_12               found         bra.s   dial_11               no, not yetdial_12  movea.l a1,a0                 transfer pointer         move.l  a1,phn_ptr(a6)        Keep a copy of the pointer         moveq   #$01,d1               One byte at oncedial_12a bsr     std_out               Write byte/message to screen         adda.l  #$01,a0               Adjust pointer         cmpi.b  #C$Spac,(a0)          Do we have a space next ?         beq.s   dial_12b              Yes, so the number is printed         cmpi.b  #C$CR,(a0)            Do we have a Cr ?         bne.s   dial_12a              Keep printing the numberdial_12b bsr     mkcrlf                Force a Cr/Lf on screen         bsr     mkcrlf                Once more !!!         movea.l phn_ptr(a6),a0        Restore pointer to phone number         move.l  #seq_len*s_mdm_pr,d1  Get offset for the modem prefix         move.w  mdm_path(a6),d0       Select proper path         bsr     wrt_seq               Write sequence on modem pathdial_13  cmpi.b  #C$CR,(a0)            We're at the end of the phone no ?         beq.s   dial_13a              Yes, so just send the suffix now         cmpi.b  #C$Spac,(a0)          Do we have a space delimiter ?         beq.s   dial_13a              If so, consider number to be completed         bsr     wrt_mdm               Otherwise, send char to the modem path         adda.l  #$01,a0               Ajust for next character         bra.s   dial_13               Keep going until done ...dial_13a move.l  #seq_len*s_mdm_sf,d1  Get offset for the sequence string         bsr     wrt_seq               Send it where appropriate         bra.s   dial_6b               And wait for connection...dial_17  lea     msg39(pc),a0          --> Can't locate this entry         move.l  #endmsg39,d1         bsr     std_out               Write byte/message to screen         bra     dial_1dial_6a  bsr     mkcrlf                Issue a CR/LF on the screendial_6   bsr     on_line               back to terminal modedial_6b  bra     readkey               and main program loop*******************************  [X]-[Y]  XModem / YModem*do_xmodm clr.b   xmd_mtd(a6)           Indicate XModem state         move.l  #xmd_pksz,pkt_siz(a6) Indicate 128 bytes packet         bra.s   go_xmod               Go for it ...do_ymodm move.b  #$01,xmd_mtd(a6)      Indicate use of YModem         move.l  #ymd_pksz,pkt_siz(a6) Indicate 1024 bytes packetgo_xmod  move.b  #$01,crc_meth(a6)     Assume CRC method at first         lea     opt_t1_w(a6),a0       Optional path descriptor for the modem         move.b  PD_PAR-PD_OPT(a0),d2  Get actual parity setting         move.b  d2,act_par(a6)        Keep a copy for when exiting XModem         andi.b  #$C0,d2               Set it to 8 data bits, no parity, 1 stop         move.b  d2,PD_PAR-PD_OPT(a0)  Put it in the path descriptor         bsr     set_mdm               Set modem accordingly         tst.b   clos_flg(a6)          ascii download not closed ?         beq.s   ok_xmodm              no, continue xmodem         bsr     save_dld              yes, go save download fileok_xmodm clr.l   xnumber(a6)         clr.l   xerror(a6)            Reset error count         clr.l   u_countr(a6)         clr.l   blk_no(a6)            Initialize block number         clr.b   too_many(a6)xmo_0    bsr     anormal               Disable features of keyboard         lea     xmg1(pc),a0           --> Xmodem file transfer intro         move.l  #endxmg1,d1         bsr     std_out               Write byte/message to screenxmo_1    lea     xmg2(pc),a0           --> (U)pload / (D)ownload         move.l  #endxmg2,d1         bsr     std_out               Write byte/message to screenxmo_1a   bsr     read_kbd              Have we received the user's reply ?         bcs.s   xmo_1a                Nope, keep waiting         andi.b  #$DF,(a0)             mask lower case         cmpi.b  #C$CR,(a0)            want to abort xmodem ?         beq     xmu_can               yes, go abort xmodem transfer         cmpi.b  #'S',(a0)             want to upload ?         beq.s   xmo_up                yes         cmpi.b  #'R',(a0)             want to download ?         beq     xmo_dld               yes         bsr     ring                  Ring the bell and request re-input         bra.s   xmo_1a                bad user choice**************************************  [X]-[S]  Xmodem Send.  (Upload)*xmo_up   bsr     putchr                Echo user's reply on screen         bsr     tempokbd              Set alternate features on keyboardxmo_up1  lea     xmg21(pc),a0          --> File to send ...         move.l  #endxmg21,d1         bsr     std_out               Write byte/message to screen         moveq   #stdin,d0             standard input path         lea     ufilenam(a6),a0       where to store data         moveq   #80,d1                maximum of data to read         os9     I$ReadLn              read filename on keyboard         move.l  d1,ufilelen(a6)       Save file name length for later         cmpi.l  #$01,d1               only one byte ?         bne.s   xmo_2                 no, proceed         cmpi.b  #C$CR,(a0)            want ot abort ?         beq     xmu_can1              yesxmo_2    bsr     mkcrlf                Issue a CR/LF on the screen         moveq   #Read_,d0             access mode         os9     I$Open                open the file         bcc.s   xmo_3                 if no problem         lea     msg12(pc),a0          --> Can't open the requested file ...         move.l  #endmsg12,d1         bsr     std_out               Write byte/message to screen         bra.s   xmo_up1               go repeat questionxmo_3    move.w  d0,fu_path(a6)        save new path         move.b  #$01,xu_open(a6)      Xmodem upload file is opened         bsr     size_it               go read and show file size         tst.l   number(a6)            Is this an empty file ?         bne.s   xmo_3b         lea     mesg9(pc),a0          --> Requested file is empty         move.l  #endmesg9,d1         bsr     std_out               Write byte/message to screen         bra     abo_xmod              Abort xmodem file transferxmo_3b   bsr     arrow                 Display an arrow in front of the value         bsr     show_val              Go put the amount on screen         lea     xmg3(pc),a0           --> ... bytes to be sent. (         move.l  #endxmg3,d1         bsr     std_out               Write byte/message to screen         move.l  #xmd_pksz,d2          For 128 bytes packets         move.l  xsize(a6),number(a6)  Get the file size back. Show XModem blk         bsr     blk_qty               go compute and print xmodem block qty.         lea     xmg4(pc),a0           --> XModem,         move.l  #endxmg4,d1         bsr     std_out               Display message         move.l  #ymd_pksz,d2          For 1024 bytes packets         move.l  xsize(a6),number(a6)  Get the file size back. Show YModem blk         bsr     blk_qty               Go show the amount of blocks         lea     xmg5(pc),a0           Completion of the message         move.l  #endxmg5,d1           Get its length         bsr     std_out               Display it ..xmo_3a   bsr     read_kbd              Any depressed key ?         bcs.s   xmo_3a                No, nothing.  Keep waiting for him         cmpi.b  #C$CR,(a0)            want to abort ?         beq     exit_xmo              yes         lea     opt_t1_w(a6),a0       where to store options         bsr     anormal               Restore keyboard to avoid problems         bsr     mkcrlf                Issue a Cr/Lf to skip a line         move.b  #$01,nlead_0(a6)      Will need leading '0' on display         lea     xmg22(pc),a0          --> Blk#  Bytes  Errors         move.l  #endxmg22,d1          Get its length ...         bsr     std_out               Routine to print xmodem messages         move.l  #seq_len*s_csr_of,d1  Offset to Csr Off sequence string         bsr     wrt_seq               Send sequence on appropriate path         bsr     fill_buf              go fill up the buffer         bcs     xu_err                if any error during read         bsr     chk_pad               go check for xmodem padding         lea     xmg12(pc),a0          --> Waiting for initial NAK         move.l  #endxmg12,d1         bsr     std_out               Write byte/message to screen         clr.b   kb_abort(a6)          Reset keyboard abort flag         bsr     kbd_det               Set keyboard intercept trapinitimer bsr     wait_byt              go wait a response from receiverchk_nak  cmpi.l  #max_errs,xerror(a6)  too long waiting receiver response ?         bmi.s   xmo_11                no, go ahead         bra     exit_err              yes, exit xmodemxmo_11   tst.b   time_out(a6)          Was the remote timed out ?         bne.s   initimer              Yes, so keep waiting for him         cmpi.b  #'C',(a0)             it was nak ?         beq.s   xmd_chk               Will use XModem checksum         cmpi.b  #C$NAK,(a0)           Do we have a request for CRC ?         bne.s   initimer              Nope, so keep waiting         clr.b   crc_meth(a6)          Indicate a Checksum val. methodxmd_chk  clr.l   xerror(a6)            Reset error count, if any so far         lea     xmg16(pc),a0          --> Fine and dandy !!!         move.l  #endxmg16,d1         bsr     xmd_msg               Write byte/message to screen         move.l  #$01,blk_no(a6)       Initialize the block #xu_send  bsr     show_blk              Show block # being processed         move.l  blk_no(a6),d2         Copy it in d2 for easier process         lea     mbuffer(a6),a0        where to store data         tst.b   xmd_mtd(a6)           Are we using XModem ?         bne.s   xu_sh_02              No, so must send an C$STX ($02)         move.b  #C$SOH,(a0)           start-of-header (XModem)         bra.s   xu_s_hdr              Go send headerxu_sh_02 move.b  #C$STX,(a0)           Indicate a Ymodem block to be sentxu_s_hdr bsr     wrt_mdm               go send that byte         move.b  d2,(a0)               block number         bsr     wrt_mdm               go send block number         not.l   d2                    invert the block number         move.b  d2,(a0)               transfer in a0         bsr     wrt_mdm               go send that information into modem         not.l   d2                    restore normal block number         move.l  pkt_siz(a6),d4        counter for how many bytes         subi.l  #$01,d4               Adjust it for the DBRA loopup_byte  move.b  (a3)+,(a0)            get a byte         bsr     wrt_mdm               go send that byte         dbra    d4,up_byte            repeat for the complete packet         tst.b   xmd_mtd(a6)           Are we using XMODEM ?         bne.s   up_byt1               Nope, YModem is now used         addi.l  #xmd_pksz,u_countr(a6) Counter within buffer         addi.l  #xmd_pksz,xnumber(a6)  Total number of passing bytes         bra.s   up_byt0up_byt1  addi.l  #ymd_pksz,u_countr(a6) Counter within buffer         addi.l  #ymd_pksz,xnumber(a6)  Total number of passing bytesup_byt0  bsr     crc_calc              Go compute checksum/CRC         move.b  crc_val(a6),(a0)      get the checksum         bsr     wrt_mdm               and go send it         tst.b   crc_meth(a6)          Are we using CRC ?         beq.s   up_byt_8              Nope, so only 1 byte checksum is needed         move.b  crc_val+1(a6),(a0)    Get the second byte of the CRC         bsr     wrt_mdm               And send it as wellup_byt_8 bsr     show_byt              Show what has been actually sentxmo_8    bsr     wait_byt              go wait for receiver's answer         cmpi.l  #max_errs,xerror(a6)  too many error while waiting ?         bmi.s   xmo_12                no, it's ok         bra.s   exit_err              yes, exit xmodem nowxmo_12   tst.b   time_out(a6)          Has the remote been timed out ?         bne.s   xmo_8                 Yep, keep waiting for him         lea     mbuffer(a6),a0        restore pointer         cmpi.b  #C$ACK,(a0)           it was acknowledge ?         beq.s   do_next               yes, continue next block         cmpi.b  #C$CAN,(a0)           cancel signal ?         beq     cancel                yes, go abort transfer         cmpi.b  #C$NAK,(a0)           receiver error ?         bne.s   xmo_8                 nono of themno_good  lea     xmg6(pc),a0           --> Receiver error.  Re-sending ...         move.l  #endxmg6,d1         bsr     xmd_msg               Write byte/message to screenup_retry tst.b   xmd_mtd(a6)           Are we using XModem         bne.s   up_ret1               Nope, so adjust for YModem         subi.l  #xmd_pksz,u_countr(a6) re-adjust counter         subi.l  #xmd_pksz,xnumber(a6)  re-adjust byte counter         bra.s   up_ret0up_ret1  subi.l  #ymd_pksz,u_countr(a6) re-adjust counter         subi.l  #ymd_pksz,xnumber(a6)  re-adjust byte counterup_ret0  suba.l  pkt_siz(a6),a3        Re-adjust pointer within buffer         addi.l  #$01,xerror(a6)       one more error         cmpi.l  #max_errs,xerror(a6)  10 errors until now ?         bmi     xu_send               not yetexit_err lea     xmg15(pc),a0          --> Too many errors.  Stopping Xmodem         move.l  #endxmg15,d1         bsr     xmd_msg               Write byte/message to screen         bra     abo_xmod              and abort transfer nowdo_next  tst.b   kb_abort(a6)          Go check if a key has been depressed         bne     usr_abrt              Yep, so better abort upload right nowdo_nexta move.l  rcvd_chr(a6),d1       check how many bytes where read         move.l  u_countr(a6),d4       number of bytes send         cmp.l   d1,d4                 end-of-buffer ?         bmi.s   xmo_6                 no, keep on sending         move.l  xsize(a6),d1          are we at the end of file ?         move.l  xnumber(a6),d4        Bytes transfered so far         cmp.l   d1,d4                 Are we done ?         bpl.s   end_xmod              yes, so end transfer now         bra.s   x_refill              no, go refill bufferxmo_6    addi.l  #$01,blk_no(a6)       increment block number         tst.l   xerror(a6)            Any errors while processing this block?         beq.s   xmo_6a                Nope, It was clearly received         clr.l   xerror(a6)            Reset error count         lea     xmg16(pc),a0          --> Fine and dandy !!!         move.l  #endxmg16,d1         bsr     xmd_msg               Write byte/message to screenxmo_6a   bra     xu_send               and keep on sendingend_xmod lea     mbuffer(a6),a0        Point to the modem's exchange buffer         move.b  #C$EOT,(a0)           end-of-transmission         bsr     wrt_mdm               write character into serial portend_xm00 bsr     wait_byt              go wait acknowledge from receiver         cmpi.l  #max_errs,xerror(a6)  how many errors until now ?         bmi.s   xmo_13                less than 10, keep on transferring         bra.s   exit_err              10 errors or more, abort transferxmo_13   tst.b   time_out(a6)          Maybe the remote is timed out         bne.s   end_xmod              He may have lost the EOT, do it again         lea     mbuffer(a6),a0        Check for final acknowledge         cmpi.b  #C$ACK,(a0)           receiver did accept the upload ?         beq     exit_xmo              yes, go to final end         bra     abo_xmod              no, transfer is refusedx_refill bsr     fill_buf              go read file on disk         bcs     xu_err                if any error during disk access         bsr     chk_pad               Check for padding         bra.s   xmo_6                 keep on transferring*******************************************  [X]-[R]  Xmodem Receive.  (Download)*xmo_dld  bsr     putchr                Echo user's reply on screen         move.b  #$01,x_mode(a6)       we are in a xmodem state         bra     ask_file              go ask user a filenamex_return move.b  #$01,xd_open(a6)      Xmodem download file is open         bsr     anormal               Make sure the keyboard is set ok         lea     opt_t1_w(a6),a0       where to store options         lea     f_downld(a6),a3       a memory buffer where to store data         lea     xmg22(pc),a0          --> Blk#  Bytes  Errors         move.l  #endxmg22,d1          Get its length ...         bsr     std_out               Write message to screen         move.l  #seq_len*s_csr_of,d1  Offset to Csr Off sequence string         bsr     wrt_seq               Send sequence on appropriate path         move.b  #$01,nlead_0(a6)      Will need leading '0' on display         lea     xmg16(pc),a0          --> Find and dandy !!!         move.l  #endxmg16,d1         bsr     xmd_msg               Write byte/message to screen         moveq   #$01,d2               Set block number as it should be         move.l  d2,blk_no(a6)         Keep block number for later reference         move.b  #$01,sw_done(a6)      Switch can be done if necessary         clr.b   kb_abort(a6)          Reset keyboard abort flag         bsr     kbd_det               Set intercept trap for the keyboardxd000    move.b  #$05,ret_cnt(a6)      We'll retry 5 times before switchingxd00     lea     mbuffer(a6),a0        Point to the modem path buffer         tst.b   xmd_mtd(a6)           Are we using XModem ?         bne.s   xd00_b                No, YModem is being used.         tst.b   crc_meth(a6)          Are we trying to use CRC method ?         bne.s   xd00_b                Yep so send appropriate code         move.b  #C$NAK,(a0)           signal for transmitter         bra.s   xd00_c                Go send the 'wake-up' bytexd00_b   move.b  #'C',(a0)             Request for CRC methodxd00_c   bsr     wrt_mdm               Signal our intentions to the remotexd0      bsr     show_blk              Display block # being processed         bsr     wait_byt              go read transmitter response         tst.b   time_out(a6)          Has the remote been timed out ?         beq.s   xd1                   No, so check it user aborted request         cmpi.l  #$01,blk_no(a6)       Are we testing for CRC method ?         bne.s   xd1                   Nope, since this is not the first block         tst.b   kb_abort(a6)          Has the user requested an abort ?         bne.s   xd05                  Yes he did, so simply quit ...         subi.b  #$01,ret_cnt(a6)      Adjust retry count         bne.s   xd00                  Retry again, if possible         tst.b   sw_done(a6)           Switch has already took place ?         beq.s   xd1                   So there is nothing we can do !!!         tst.b   xmd_mtd(a6)           Are we using YModem ?         bne.s   xd0_c                 Yes. No switch but give 5 more chancesxd0_b    clr.b   crc_meth(a6)          Switch to CheckSumxd0_c    clr.b   sw_done(a6)           Indicate that the switch took place         bra.s   xd000xd05     lea     xmg8(pc),a0           --> Xmodem transfer cancelled by user         move.l  #endxmg8,d1         bsr     xmd_msg               Write byte/message to screen         bra     retry0                and exitxd1      cmpi.l  #max_errs,xerror(a6)  more than 10 xmodem download errors ?         bmi.s   xd2                   noxd1_a    lea     xmg15(pc),a0          --> Too many errors.  Stopping Xmodem.         move.l  #endxmg15,d1         bsr     xmd_msg               Write byte/message to screen         bra     retry0                yes, abort downloadxd2      tst.b   xmd_mtd(a6)           Are we using YModem ?         bne.s   xd2_a                 Will have to check for C$STX, not C$SOH         cmpi.b  #C$SOH,(a0)           was a start-of-header ?         beq.s   get_blk               Yes, don't wait !! Go get the data         bra.s   xd2_b                 Skip over the YModem header testxd2_a    cmpi.b  #C$STX,(a0)           Start of an YModem packet ?         beq.s   get_blk               Yes, so get the rest of it ...xd2_b    cmpi.b  #C$CAN,(a0)           was a cancel byte ?         beq     stop_xd               yes, cancel file transfer         cmpi.b  #C$EOT,(a0)           was end-of-file ?         beq     endofxmd              normal end of transmission         bra     xd00                  none of them, so loopget_blk  bsr     wait_byt              get the incoming block number         cmp.b   (a0),d2               it was the good block ?         bne     wrongblk              no, we are out of sync.         clr.l   xerror(a6)            Reset error count         not.l   d2                    complement block number         bsr     wait_byt              now get block number complement         cmp.b   (a0),d2               still ok ?         bne     wrongblk              no         not.l   d2                    restore original block number         move.l  d2,blk_no(a6)         Get a copy of the block number         bsr     show_blk              Show block number being received         move.l  pkt_siz(a6),d4        initialise counter vs packet size         subi.l  #$01,d4               Adjustement for the DBRA loop ...rcv_blk  bsr     wait_byt              go get next block byte         move.b  (a0),(a3)+            where to save that byte         dbra    d4,rcv_blk            loop until finish block         tst.b   xmd_mtd(a6)           Are we using XMODEM ?         bne.s   rcv_blk1              Nope, YModem is now used         addi.l  #xmd_pksz,u_countr(a6) Counter within buffer         addi.l  #xmd_pksz,xnumber(a6)  Total number of passing bytes         bra.s   rcv_blk0rcv_blk1 addi.l  #ymd_pksz,u_countr(a6) Counter within buffer         addi.l  #ymd_pksz,xnumber(a6)  Total number of passing bytesrcv_blk0 clr.w   crc_rmt(a6)           Reset remote's CheckSum/CRC         bsr     wait_byt              Wait for remote's one         move.b  (a0),crc_rmt(a6)      Get checksum/ first byte of the CRC         tst.b   crc_meth(a6)          Are we using checksum method ?         beq.s   chk_val               Yes, so no need to receive another byte         bsr     wait_byt              Get the other byte of the CRC         move.b  (a0),crc_rmt+1(a6)    Save it where it belongschk_val  bsr     crc_calc              Compute our Checksum / CRC         lea     crc_val(a6),a0        Point to our CheckSum         lea     crc_rmt(a6),a1        And remote's one         cmpm.w  (a0)+,(a1)+           Compare them         bne.s   retry                 If they differ than re-ask for block         bsr     show_blk              Reshow block no, just in case         bsr     show_byt              Go display amount received and errors         cmpi.l  #bsize,u_countr(a6)   at the end of buffer ?         bmi.s   xd06         bsr     save_buf              yes, go save buffer on diskxd06     addi.l  #$01,d2               increment block number         move.l  d2,blk_no(a6)         Adjust our block pointer         tst.b   kb_abort(a6)          User did abort the transfer ?         bne     xd05                  Yes he did !!!         bsr     send_ack              Otherwise acknowledge block         bra     xd0                   repeat actionendofxmd subi.l  #$01,blk_no(a6)       Adjust block # for good representation         bsr     show_blk              Display real amount of received blocks         bsr     save_buf              go save what is left in buffer         bra     exit_xmo              exit xmodem modestop_xd  lea     xmg9(pc),a0           --> Xmodem transfer cancelled by recv         move.l  #endxmg9,d1         bsr     xmd_msg               Write byte/message to screen         bsr     save_buf              save was is left in buffer         bra     abo_xmod              abort xmodem nowwrongblk lea     xmg19(pc),a0          --> Error in blk # synch         move.l  #endxmg19,d1         bsr     xmd_msg               Write byte/message to screen         bsr     save_buf              save what is left in memory         bra     abo_xmod              and abandon transmissionretry    lea     xmg20(pc),a0          --> Xmodem err.  Requesting same blk         move.l  #endxmg20,d1         bsr     xmd_msg               Write byte/message to screen         tst.b   xmd_mtd(a6)           Are we using XModem         bne.s   retry_ym              Nope, so adjust for YModem         subi.l  #xmd_pksz,u_countr(a6) re-adjust counter         subi.l  #xmd_pksz,xnumber(a6)  re-adjust byte counter         bra.s   adj_errretry_ym subi.l  #ymd_pksz,u_countr(a6) re-adjust counter         subi.l  #ymd_pksz,xnumber(a6)  re-adjust byte counteradj_err  suba.l  pkt_siz(a6),a3        Re-adjust pointer within buffer         addi.l  #$01,xerror(a6)       one more error         cmpi.l  #max_errs,xerror(a6)  10 errors until now ?         bmi.s   retry1                retry if less than 10 errorsretry0   bsr     save_buf              save what is left in memory         bra.s   abo_xmod              and quit xmodemretry1   tst.b   kb_abort(a6)          Has the user requested an abort ?         bne     xd05                  Yes he did ...         lea     mbuffer(a6),a0        send a NAK to transmitter         move.b  #C$NAK,(a0)           to re-ask the same block         bsr     wrt_mdm               Send request to remote         bra     xd0                   return receive the same block*******************************************************************  Xmd_Exit : Will come here or at a point within this block upon*           XModem completion, successful or not.*xmd_exit equ     *xu_err   lea     xmg10(pc),a0          --> Error during disk access ...         move.l  #endxmg10,d1         bsr     xmd_msg               Routine to print xmodem messages         bra.s   abo_xmodusr_abrt lea     xmg8(pc),a0           --> Xmodem transfer cancelled by user         move.l  #endxmg8,d1         bsr     xmd_msg               Write byte/message to screen         bra.s   abo_xmod              and exitcancel   lea     xmg9(pc),a0           --> Xmodem transfer cancelled by recv         move.l  #endxmg9,d1         bsr     xmd_msg               Write byte/message to screenabo_xmod bsr     xmo_3can              Send 3 CAN to remote ...         bsr     mkcrlf                Issue a CR/LF for neeter reporting         lea     xmg7(pc),a0           --> Xmodem transfer is aborted ...         move.l  #endxmg7,d1         bsr     std_out               Write byte/message to screenexit_xmo clr.b   nlead_0(a6)           Won't need leading zeros anymore         tst.b   xu_open(a6)           Xmodem upload file is opened ?         beq.s   tst_xd                No, so check for Download ?         move.w  fu_path(a6),d0        Get path number for Upload file         clr.b   xu_open(a6)           Reset flag         os9     I$Close               Close Upload file         bra.s   clo_file              And go complete worktst_xd   tst.b   xd_open(a6)           Is the download file Opened ?         beq.s   xmu_can               No, so exit normally         move.w  fd_path(a6),d0        Get the proper path number         clr.b   xd_open(a6)           Reset status flag         os9     I$Close               Close Download file         bsr     send_ack              Send final acknowledgeclo_file clr.l   rcvd_chr(a6)          clear character counterxmu_can  bsr     mkcrlf                issue a CR/LF on the screenxmu_can1 bsr     anormal               restore keyboard         bsr     kbd_rel               Release keyboard from the signal trap         lea     opt_t1_w(a6),a0       Optional path descriptor for the modem         move.b  act_par(a6),d2        Get previous parity setup         move.b  d2,PD_PAR-PD_OPT(a0)  Re-Install it where it belongs         bsr     set_mdm               Reset modem path accordingly         bsr     on_line               Show message "BAck on line ..."         bra     readkey               go back to main program loop*******************************************  [B]  User wants to change baud rate.*do_baud  lea     msg25(pc),a0          --> Baud rate table ...         move.l  #endmsg25,d1         bsr     std_out               Write byte/message to screen         bsr     ask_hex         cmpi.b  #C$CR,(a0)            User just want to ignore request ?         bne.s   baud_use              Yes, so just return to caller         bsr     putchr                Put it on the screen         bra     exit_bd               Exit baud selection routine*-----------------------------------------*  Will enter here from the dial routine*-----------------------------------------auto_bd  bsr     ask_hex1baud_use tst.b   dial_flg(a6)          Baud changes done via the dialer ?         bne.s   chg_baud              Yes, so don't echo reply on screen         bsr     putchr                Put it on the screenchg_baud lea     opt_t1_w(a6),a0       Point to our working path descriptor         move.b  d2,PD_BAU-PD_OPT(a0)  Set new baud rate         move.b  PD_PAR-PD_OPT(a0),d2  Get Actual parity information         andi.b  #$C0,d2               Clear bits 0-5 to have : 8 N 1         move.b  d2,PD_PAR-PD_OPT(a0)  Put it in the working descriptor         tst.b   dial_flg(a6)          Are we using the dialer ?         beq.s   chg_man               No. Values must be specfied manually         clr.l   d0                    Initialize working register         adda.l  #$01,a1               Point to the byte after the baud rate         move.b  (a1)+,d0              Get the first byte mask for parity         subi.b  #$30,d0               Subtract the ASCII bias         mulu.w  #10,d0                This is our dizains         add.b   (a1)+,d0              Get second mask byte         subi.b  #$30,d0               Subtract ASCII bias of the second byte         or.b    d0,d2                 Now set the new parity value         move.b  d2,PD_PAR-PD_OPT(a0)  Put the computed value in descriptor         bra.s   updt_mdm              Go update the modem path descriptorchg_man  lea     msg52(pc),a0          --> 8 N 1 is Ok ?         move.l  #endmsg52,d1          Message length         bsr     std_out               Show message on screenchg_man0 bsr     read_kbd              Get User's reply         bcs.s   chg_man0              Wait for user's reply         andi.b  #$DF,(a0)             Mask lower case         cmpi.b  #'Y',(a0)             User accepts new set up         beq.s   ch_man99              So go for it         cmpi.b  #'N',(a0)             He wants to change it to something else         beq.s   chg_man1              Go for it         bsr     ring                  Notify that a bad choice occured         bra.s   chg_man0chg_man1 bsr     putchr         lea     msg50(pc),a0          --> Data bits selection         move.l  #endmsg50,d1          Message length         bsr     std_out               Show message on screen         lea     data_tbl(pc),a1       Point to the parity table         bsr     ask_key               Get user's reply and set value         lea     msg49(pc),a0          --> Parity selection         move.l  #endmsg49,d1          Message length         bsr     std_out               Show message on screen         lea     par_tbl(pc),a1        Point to the parity table         bsr     ask_key               Get user's reply and set value         lea     msg51(pc),a0          --> Stop bits selection         move.l  #endmsg51,d1          Message length         bsr     std_out               Show message on screen         lea     stop_tbl(pc),a1       Point to the parity table         bsr     ask_key               Get user's reply and set value         bra.s   updt_mdm              Set modem path according to the valuesch_man99 bsr     putchr                Show user's reply on screenupdt_mdm bsr     set_mdm               Set modem using new options descriptor         tst.b   dial_flg(a6)          Are we in dial mode ?         beq.s   exit_bd               Nope, normal mode. So keep going         rts                           Return to the dial routineexit_bd  bsr     on_line               go back to terminal mode         bra     readkey               and main program loop*********************************  [P]  Toggle printer state.*do_pr    tst.b   pr_echo(a6)           printer is off ?         beq.s   set_pr                yes, turn on the printerclr_pr   clr.b   pr_echo(a6)           clear printer flag         move.w  pr_path(a6),d0        Get its path number         os9     I$Close               Close the printer         lea     msg27(pc),a0          --> Printer is now OFF.         move.l  #endmsg27,d1         bsr     std_out               Write byte/message to screen         bra     pr_exit               and exitset_pr   tst.b   dir_outp(a6)          Are we doing direct output ?         bne.s   set_pr1               Yes, so don't use the pipe         lea     ctl_tbl(a6),a0        Point to the control table         move.l  #seq_len*s_siz_pp,d1  Get offset to the Pipe buffer size         adda.l  d1,a0                 Make (a0) pointing to the value         move.l  (a0),d2               Then, get user's size         lea     prt_pipe(pc),a0       Printer Pipe Name         moveq   #Updat_+ISize_,d0     Mode : READ / WRITE & Initial size         move.w  #Read_+Write_,d1      Attr : Owner READ and WRITE         os9     I$Create              Create the specified path         bra.s   set_pr2               And open the pathset_pr1  lea     prt_name(a6),a0       Get path name to the printer         moveq   #Updat_,d0            No ISize, of course !!!         os9     I$Open                Open it ...set_pr2  bcc.s   ok_pr                 if no problems         tst.b   dir_outp(a6)          Are we doing direct output to printer ?         bne.s   set_pr3               Yes, so send appropriate message         lea     msg28a(pc),a0         --> Unable to open printer pipe         move.l  #endmg28a,d1          Get its length         bra.s   set_pr4               And send message ...set_pr3  lea     msg28(pc),a0          --> Unable to open printer path         move.l  #endmsg28,d1set_pr4  bsr     std_out               Write byte/message to screen         bra     pr_exitok_pr    move.w  d0,pr_path(a6)        save the new printer path         move.l  #seq_len*s_prtset,d1  Get proper offset for init string         bsr     wrt_seq               Write sequence on printer path         lea     msg26(pc),a0          --> Printer is now ON.         move.l  #endmsg26,d1         bsr     std_out               Write byte/message to screen         move.b  #$01,pr_echo(a6)      turn printer on         tst.b   dir_outp(a6)          Are we doing direct output to printer ?         bne     pr_exit               Yes, so don't fork Shell Scriptfrk_prt  tst.b   prt_init(a6)          Script executed at least once ?         beq.s   frk_pr00              Nope, so do initial setup         move.l  prt_add(a6),a1        Get address as computed previously         move.l  prt_size(a6),d2       And get the parm size as well         bra.s   frk_prt2              Branch accordinglyfrk_pr00 lea     ctl_tbl(a6),a1        Point to the control table         move.l  #seq_len*s_cmd_pp,d1  Get offset to the Pipe Command Processor         adda.l  d1,a1                 Adjust address accordingly         cmpi.b  #C$Null,(a1)          Has the user did give one ?         beq.s   frk_prt1              Nope, so use default ...         move.l  a1,d1                 Keep a copy to restore it later         movea.l a1,a0                 Get a copy of the actual pointerfrk_prt0 cmpi.b  #$FF,(a0)+            Have we reached our marker ?         bne.s   frk_prt0              Keep going if not         move.b  #C$CR,-1(a0)          Replace marker with a Carriage Return         addi.l  #$01,a0               Insure to have a trailing NULL         suba.l  a1,a0                 Get real string length         move.l  a0,d2                 Then put it where appropriate         move.l  d1,a1                 Restore address as it was before         move.l  d2,prt_size(a6)       Save it for next call, if any         move.l  a1,prt_add(a6)        We'll need this one too         move.b  #$01,prt_init(a6)     Indicate fork has been initialized         bra.s   frk_prt2              And invoke process in backgroundfrk_prt1 lea     prt_parm(pc),a1       Default script name for the process         move.l  #pp_size,d2           Parameter sizefrk_prt2 clr.w   d0                    Any Module type         move.l  #1024,d1              Get few extra memory to work with         move.w  #$03,d3               # of paths : In, Out, Err         move.w  #0,d4                 Priority, Same as Parent ...         lea     shell_nm(a6),a0       Module name pointer (Shell)         os9     F$Fork                Fork the process         bcc.s   frk_prt3              Successfull, so continue on         lea     mesg4(pc),a0          --> Shell error while forking ...         move.l  #endmesg4,d1         bsr     std_out               Write byte/message to screenfrk_err  bsr     read_kbd              Wait for user to acknowledge         bcs.s   frk_err               Keep waiting 'till a key is depressedfrk_prt3 os9     F$Wait                Wait for the Shell to 'return'pr_exit  bsr     on_line               go back to terminal mode         bra     readkey               and main program*************************************************************  [F]  Want to adjust flow characters, normally XON,XOFF*                                              - DC1,DC3 -*do_flow  lea     msg44(pc),a0          --> Xon Prompt         move.l  #endmsg44,d1          Get its length         bsr     std_out               Display it on screenflow_on  bsr     ask_hex               Get hexadecimal value         cmpi.b  #C$CR,(a0)            If only return, then ignore         beq.s   flow_end              And ask for the other one         mulu.w  #16,d2                Adjust first byte         move.w  d2,d3                 Save result         bsr     std_out               Show it on screen         bsr     ask_hex               Get second byte         add.w   d2,d3                 Adjust final result         move.b  d3,cust_xon(a6)       XON character is setted up         bsr     putchr                Echo choice on screen         lea     msg45(pc),a0          --> XOFF Prompt         move.l  #endmsg45,d1          Get its length         bsr     std_out               Display it on screenflow_off bsr     ask_hex               Go read the user's choice         cmpi.b  #C$CR,(a0)            If only return, then ignore         beq.s   flow_end              And exit flow routine         mulu.w  #16,d2                Adjust first byte         move.w  d2,d3                 Save result         bsr     std_out               Show it on screen         bsr.s   ask_hex               Get second byte         add.w   d2,d3                 Adjust final result         move.b  d3,cust_xof(a6)       XOFF character is setted upflow_end bsr     putchr                Need blank line ...         bsr     on_line               go back to terminal mode         bra     readkey               and main program loop******************************************************  The end. Here we exit ATerm and go back to OSK.*the_end  tst.b   clos_flg(a6)          check if download file is left open         beq.s   alreadyc              no, it is already close         bsr     save_dld              yes, so save and close before exitalreadyc bsr     normal                restore keyboard*-------------------------*  XMode the serial port*-------------------------         move.w  mdm_path(a6),d0       restore modem path         moveq   #SS_Opt,d1            read the path descriptor         lea     opt_t1_o(a6),a0       where to write the descriptor         os9     I$SetStt              Restore /T1 to its orginal state         os9     I$Close               Close corresponding path         lea     mesg3(pc),a0          --> ATerm returning to system level         move.l  #endmesg3,d1         bsr     std_out               Write byte/message to screenexit00   clr.l   d1                    exit with no error code         os9     F$Exit                back to OSK*/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\**                  Subroutines used by main program**/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\***********************************************************************  Anormal : Remove keyboard features such as echo, pause, ^C, etc.*anormal  moveq   #stdin,d0             standard input path         lea     pd_trm_w(a6),a0       in memory         clr.b   PD_EKO-PD_OPT(a0)     Disable ECHO option         clr.b   PD_EOF-PD_OPT(a0)      "   "  END-OF-FILE character         clr.b   PD_PSC-PD_OPT(a0)      "   "  PAUSE character         moveq   #SS_Opt,d1            do it         os9     I$SetStt              now         rts                           back to caller**************************************************************  Arrow : Show the greater sign in front of the file size*arrow    push                          Save register's contents         lea     msg31(pc),a0          --> '> '         move.l  #endmsg31,d1         bsr     std_out               Write byte/message to screen         pull                          Restore registers         rts                           Return to caller.*********************************************************************  Ask_Hex : Routine to get hexadecimal values from the keyboard.*            Mainly used in the Flow characters selection and the*            baud rate setting.*          ask_hex0 bsr     ring                  Waiting for a valid input ...ask_hex  bsr     read_kbd              Check if user depressed a key         bcs.s   ask_hex               No he did not.  Keep wating         cmpi.b  #C$CR,(a0)            User just want to ignore request ?         bne.s   ask_hex1              Yes, so just return to caller         bra.s   ask_hex9              Exit baud selection routine*-------------------------------------------------------------------*  Will enter here from the dial routine, to get the baud rate and*  parity mask, and from the Get_Ctl routine*-------------------------------------------------------------------ask_hex1 move.b  (a0),d2               get that character         cmpi.b  #'0',d2               lower than 0 ascii?         bmi.s   ask_hex0              yes repeat choice         cmpi.b  #'9',d2               higher than 9 ascii ?         bhi.s   ask_hex2              yes         andi.b  #$0F,d2               convert from ascii to binary         bra.s   ask_hex9              and go change baud rateask_hex2 andi.b  #$DF,d2               filter lower case         cmpi.b  #'A',d2               smaller than A ascii ?         bmi.s   ask_hex0              yes go repeat choice         cmpi.b  #'F',d2               greater than F ascii ?         bhi.s   ask_hex0              yes go repeat choice         subi.b  #$37,d2               convert from ascii to binary         andi.b  #$DF,(a0)             Mask lower caseask_hex9 rts***********************************************************  Ask_Key : Will ask the user for a specific reply and adjust the Parity &*            Data bits options, using the mask in the table pointed by (a1).*          ask_key  push         move.l  a1,tbl_add(a6)        Keep a copy of the table entry pointask_agn  movea.l tbl_add(a6),a1        Get the address backask_key0 bsr     read_kbd              Any key depressed ?         bcs.s   ask_key0              Keep waiting for user         clr.l   d0                    Make sure all bits a reset to 0         move.b  (a0),d0               Get user's reply         cmpi.b  #'0',d0               Lower than an ASCII '0' ?         bmi.s   bad_key               Don't accecpt the input         cmpi.b  #'9',d0               What about an ASCII '9' ?         ble.s   ask_uper              This is a digit, so don't worry         andi.b  #$DF,d0               Mask lower case         move.b  d0,(a0)               Put it back where it belongsask_uper clr.l   d0                    Make sure all bits a reset to 0         move.b  (a1)+,d0              Get Quantity of items in table         subi.l  #$01,d0               Adjust for the DBxx loop         move.b  (a0),d1               Get user's replyask_key1 cmp.b   (a1)+,d1              Is this what we are looking for ?         beq.s   ask_key2         addq.l  #$01,a1               Skip to take a peek at the next entry         dbra    d0,ask_key1bad_key  bsr     ring                  Sorry, bad choice is given         bra.s   ask_agn               Ask again ...ask_key2 move.b  (a1),d1               Get mask value         lea     opt_t1_w(a6),a0       Point to our working path descriptor         move.b  PD_PAR-PD_OPT(a0),d2  Get Actual parity information         or.b    d1,d2                 Mask descriptor byte with value         move.b  d2,PD_PAR-PD_OPT(a0)  Set the new value         lea     inbuffer(a6),a0       Point where we stored the user's reply         moveq   #$01,d1               Only one byte after all         bsr     putchr                Show it on the screen         pull                          Restore registers as they were before         rts                           Return to caller********************************************************************  Auto_Bfr : Ask the user if he want an automatic ASCII buffer.*auto_bfr clr.b   auto_buf(a6)          Indicate Normal buffer         clr.b   buf_stat(a6)          Indicate a CLOSED status for buffer         lea     msg53(pc),a0          --> Want to use auto Buffer feature ?         move.l  #endmsg53,d1         bsr     std_out               Write byte/message to screenauto_bf1 bsr     read_kbd              Any data ready for us on keyboard ?         bcs.s   auto_bf1              No, so keep waiting         andi.b  #$DF,(a0)             filter lower case         cmpi.b  #'N',(a0)             No, the user wants regular download         beq.s   auto_bf3              So, just do the normal download         cmpi.b  #'Y',(a0)             Yes, he wants the automatic buffer         beq.s   auto_bf2              So, set the flags accordingly         bsr     ring                  Oopps, a wrong answer supplied         bra.s   auto_bf1              Re-ask the userauto_bf2 move.b  #$01,auto_buf(a6)     We'll use the automatic bufferauto_bf3 bsr     putchr                Show user's reply on screen         rts                           Return to caller***********************************************************  Blk_Qty : Show how many xmodem blocks are in a file.*blk_qty  move.l  number(a6),d3         get the file size         divu.w  d2,d3                 divide it by 128 to know how many         move.l  d3,d4                 save in d4         andi.l  #$FFFF,d3             keep only quotient         move.l  d3,number(a6)         in the file size         andi.l  #$FFFF0000,d4         there was a remainder         beq.s   block_2               no, 128 bytes exactly, or a multiple         addi.l  #$01,number(a6)       no so add a block to its lengthblock_2  bsr     show_val              go divide and display how many blocks         rts                           return to main program********************************************************************  Crc_Calc : Routine to compute the checksum and CRC.** (a2) : address of the xmodem packet*crc_calc push         clr.w   crc_val(a6)           Reset CheckSum/CRC field         movea.l a3,a2                 Pointer within buffer         suba.l  pkt_siz(a6),a2        Point to the beginning of the packet         move.l  pkt_siz(a6),d5        Packet size         tst.b   crc_meth(a6)          Which method are we using ?         bne.s   crc_16                We're using the CRC-16 method         subi.l  #$01,d5               Adjust it for the DBRA loop         clr.l   d4                    Initialize checksumchk_sum8 add.b   (a2)+,d4              compute checksum         dbra    d5,chk_sum8           repeat until done ...         move.b  d4,crc_val(a6)        Save the computed value         bra.s   calc_end              and return to caller*--------* CRC-16*--------crc_16   clr.l   d2                    Initialize the CRC value         bra.s   crc_c07               Go check if we have some work to docrc_c01  move.b  (a2)+,d0              Get a byte from the XModem packet         ext.w   d0                    Extend sign of byte into bits 8-15         ext.l   d0                    Extend sign of the word into bits 16-31         lsl.l   #8,d0         move.l  d2,d1                 Get previous CRC value         eor.l   d1,d0         move.l  d0,d2                 CRC upated ...         clr.l   d4         bra.s   crc_c06crc_c02  move.l  d2,d0         btst.l  #15,d0                Do we have a carry ?         beq.s   crc_c04crc_c03  move.l  d2,d0         lsl.l   #1,d0         eori.l  #4129,d0         move.l  d0,d2         bra.s   crc_c05crc_c04  move.l  d2,d0         lsl.l   #1,d0         move.l  d0,d2crc_c05  addq.l  #$01,d4crc_c06  moveq   #$08,d0         cmp.l   d4,d0         bgt.s   crc_c02crc_c07  subi.l  #$01,d5               All bytes of the packet processed ?         bge.s   crc_c01               Nope, still more to do         move.l  d2,d0         andi.l  #65535,d0         move.w  d0,crc_val(a6)        All done, CRC is now availablecalc_end pull         rts*******************************************************************  Chk_Pad : Ckeck if padding is necessary for the given block.*chk_pad  cmpi.l  #bsize,d1             all bytes were read ?         beq.s   exit_pad              yes, not end-of-file yet         move.l  #bsize,d0         lea     f_downld(a6),a0       go at top of buffer         add.l   d1,a0                 adjust pointer         sub.l   d1,d0                 compute remainder of buffer         subi.l  #$01,d0               Adjust counter for the DBRA looppad_buf  move.b  #C$PAD,(a0)+          fill rest of buffer with padding char.         dbra    d0,pad_buf            loop until finishexit_pad rts                           return**************************************************************************  Cls : Clear the screen using the Escape sequence for VT52 terminal.*cls      push         move.l  #seq_len*s_cls,d1     Offset for the Clear Screen sequence         moveq   #stdout,d0            Select proper path         bsr     wrt_seq               Write sequence on terminal         pull         rts***************************************************************************  Fill_Buf : Used by the ASCII Upload and XModem UpLoad routines, this*             section will read data from the file and fill the buffer.*fill_buf clr.l   u_countr(a6)          clear quantity of bytes uploaded         clr.l   rcvd_chr(a6)          clear bytes quantity         move.w  fu_path(a6),d0        input path         lea     f_downld(a6),a0       where to put read data         movea.l a0,a3                 transfer pointers         move.l  #bsize,d1             number of bytes to read (Buffer Size)         os9     I$Read                read the file         bcs.s   fill_ex               Exit with error ...         move.l  d1,rcvd_chr(a6)       number of bytes actually readfill_ex  rts                           return to caller*************************************************************************  Get_Ctl : Get all the escape sequence codes from the Control file.*get_ctl  clr.b   ctl_ok(a6)            Clear control status flag first         clr.b   ctl_item(a6)          Control intems counter         moveq   #Read_,d0             access mode         lea     ctl_file(a6),a0       filename for the control file         os9     I$Open                open the file         bcc.s   get_ctl1              Successfull open, you may proceed         lea     msg56(pc),a0          --> Can't locate Control file         move.l  #endmsg56,d1         bsr     std_out               Write byte/message to screen         bra     ctl_exit              Exit routineget_ctl1 move.w  d0,ctl_path(a6)       Save path number for later reference         moveq   #ctl_qty,d4           Need this quantity of items         subi.l  #$01,d4               Adjust it for the DBra loopget_ctl2 bsr     read_ctl              Read info from the control file         bcs.s   get_ctl8              Indicate an error while reading         addi.l  #$01,a0               Point to the byte following the marker         lea     ctl_tbl(a6),a1        Point to the control table         clr.l   d0                    Reset counter         move.b  ctl_item(a6),d0       Get actual item counter         mulu.w  #seq_len,d0           Adjust to get offset         adda.l  d0,a1                 And now we've got the right address         clr.l   d1                    Init counter         bsr     ask_hex1              Get first hex byte         move.b  d2,d1                 Save its binary representation         mulu.w  #$10,d1               Multiply by 16         addi.l  #$01,a0               Point to next hex byte         bsr     ask_hex1              Get its binary equivalent         add.b   d2,d1                 Now we have the sequence byte count         tst.b   d1                    Do we have a null sequence definition         beq.s   get_ctl4              Yep, so just skip and wait for next one         cmpi.b  #seq_len,d1           Are we exceeding the maximum length ?         bls.s   g_ctl2a               Nope, so the value is in a good range         move.l  #seq_len,d1           Force the maximum length otherwiseg_ctl2a  subi.l  #$01,d1               Adjust for the DBra loop         tst.b   text_seq(a6)          Do we have a plain ASCII sequence ?         beq.s   get_ctl3              Nope this is an HEX sequence ...         addi.l  #$01,a0               Adjust pointer for first ASCII char.get_ctl3 tst.b   text_seq(a6)          Do we have a text sequence ?         beq.s   g_ctl3a               Nope, this is an HEX sequence code         move.b  (a0)+,d3              Get ASCII byte from the control stat.         bra.s   g_ctl3b               And save it without conversiong_ctl3a  clr.l   d3                    Init counter         addi.l  #$01,a0               Point to the MSB to convert         bsr     ask_hex1              Get equivalent in binary         move.b  d2,d3                 Save it for later         mulu.w  #$10,d3               Multiply by 16         addi.l  #$01,a0               Adjust pointer for the LSB         bsr     ask_hex1              Get binary equivalent         add.b   d2,d3                 Adjust final resultg_ctl3b  move.b  d3,(a1)+              Put byte in table         dbra    d1,get_ctl3           Loop until sequence is completedg_ctl3c  move.b  #$FF,(a1)             Put our delimiter in placeget_ctl4 addi.b  #$01,ctl_item(a6)     Adjust item counter         dbra    d4,get_ctl2           Keep going until all items read         move.b  #$01,ctl_ok(a6)       Indicate successfull completionget_ctl8 cmpi.b  #ctl_qty,ctl_item(a6) Do we have all the information needed         beq.s   get_ctl9              Yes, so something else happened         lea     msg57(pc),a0          --> Imcomplete control file         move.l  #endmsg57,d1         bsr     std_out               Write byte/message to screenget_ctl9 move.w  ctl_path(a6),d0       Get the path number         os9     I$Close               Close the control filectl_exit rts                           Return to caller***************************************************************************  Get_Env0 : Set parameters prior to find the environment value of the*             given variable.*get_env0 clr.l   d2                    Indicate offset within table         mulu.w  #env_len,d1           Adjust counter vs item to check         lea     env_list(pc),a1       Point to the env. list to verify         add.l   d1,a1                 Point to the correct item to verify         moveq   #env_len-1,d3         Bytes to be compared minus 1 (DBRA)         lea     env_init(a6),a0       Point to the initial environment table         bsr.s   get_env               Get environement value if possible         rts                           Return to caller**************************************************************************  Get_Env : Attempt to get the environement variable value.  The flag*            good_env(a6) is used to indicate a successfull match.*get_env  clr.b   good_env(a6)          Assuming no match at firstget_env1 cmpm.b  (a0)+,(a1)+           Do we have a match ?         bne.s   get_env2              Nope, so adjust pointers         dbra    d3,get_env1*- Environment variable has been found ... (a0) Now pointing to the value         move.b  #$01,good_env(a6)     Indicate a successfull match         bra.s   get_exit              And return to callerget_env2 lea     env_init(a6),a0       Reset pointer to the top of the buffer         addi.l  #$01,d2               Adjust offset within table         adda.l  d2,a0                 Start comparaison from next byte         lea     env_list(pc),a1       Point to the list to verify         adda.l  d1,a1                 Point to the correct item to verify         moveq   #env_len-1,d3         Bytes to be compared minus 1 (DBRA)         cmp.l   d2,d0                 Are we at the end of the table ?         bne.s   get_env1              Nope, so we can try once more*- enviroment variable is not defined ... Sorry folksget_exit rts*******************************************************************************  In_0_9 : Accept ASCII value 0-9 and convert it to its binary equivalent.*in_0_9   bsr     read_kbd              Any key pressed on keyboard         bcs.s   in_0_9                Nope, keep waiting ...         cmpi.b  #'0',(a0)             smaller than 0 ascii ?         bmi.s   in_0_9                yes         cmpi.b  #'9',(a0)             greater than 9 ascii ?         bhi.s   in_0_9                Re-ask the user if necessary         bsr     putchr                Show choice on screen         move.b  (a0),d2               transfer value         andi.l  #$0F,d2               filter d2 value         rts                           return to caller****************************************************************************  Kbd_Det : Install a signal trap that will be triggered upon detection*            of a depressed key on the keyboard.*kbd_det  push         moveq   #stdin,d0             Indicate Standard Input (Keyboard)         moveq   #SS_SSig,d1           'Send Signal on data ready' code         move.w  #sig_kbd,d2           Will use signal #256, at least for now         os9     I$SetStt              Install 'trap' ...         pull         rts*********************************************************************  Kbd_Rel : Disable the intercept routine for keyboard interrupt*kbd_rel  push         moveq   #stdin,d0             Indicate Standard Input (Keyboard)         moveq   #SS_Relea,d1          Release 'trap'         os9     I$SetStt              Indicate it to the system         bcc.s   kbd_exit         bsr     ringkbd_exit pull         rts*****************************************************  Keep_Chr : Keep character for download option.*keep_chr cmpi.b  #C$LF,(a0)            is it a linefeed ?         beq.s   not_yet               yes, don't keep it         tst.b   auto_buf(a6)          Are we in auto-buffer mode ?         beq.s   keep_ch2              Nope, so just continue on         cmpi.b  #C$DC2,(a0)           An Open-Buffer request received ?         beq.s   keep_ch0              Yes, so set flag accordingly         cmpi.b  #C$DC4,(a0)           A Close-Buffer request has been issued ?         bne.s   keep_ch1              No, so process character as normal         clr.b   buf_stat(a6)          Set buffer status to CLOSED and exit         lea     msg55(pc),a0          --> Reception to buffer is suspended         move.l  #endmsg55,d1          Get message length         bsr     std_out               And notify user         bra.s   not_yetkeep_ch0 move.b  #$01,buf_stat(a6)     Set buffer status to open and exit         lea     msg54(pc),a0          --> Now capturing to ASCII buffer         move.l  #endmsg54,d1          Get message length         bsr     std_out               And notify user         bra.s   not_yet               Exit, and wait for next characterkeep_ch1 tst.b   buf_stat(a6)          Is the buffer opened ?         beq.s   not_yet               Nope, so don't save the bytekeep_ch2 move.b  (a0),(a3)+            save received character         addi.l  #$01,rcvd_chr(a6)     increment number of rcvd. char.         cmpi.l  #bsize,rcvd_chr(a6)   Is our reception buffer full ?         blt.s   not_yet               not yetwrite_fl bsr     send_xof              Insure the host will wait for us ...         move.w  fd_path(a6),d0        restore path number         move.l  rcvd_chr(a6),d1       how many character to write to the file         lea     f_downld(a6),a0       where to find the data         os9     I$Write               write received character to the file         bcc.s   no_prob               if no problem writing data to disk         bsr.s   med_err               go say writing error on diskno_prob  clr.l   rcvd_chr(a6)          clear number of received char.         lea     f_downld(a6),a3       re-position pointer         bsr     send_xon              Ok now, we can receive more data !!!not_yet  rts                           return to caller***********************************************************************  Med_Err : Send 'Media error' message when an unsuccessfull write*            to disk occurs.*med_err  lea     msg29(pc),a0          --> Error while writting to disk         move.l  #endmsg29,d1         bsr     std_out               Write byte/message to screen         rts                           return*******************************  Mk_Space : Generate a string of white spaces to seperate items on*             the line when using the XModem protocol*mk_space push         lea     space(pc),a0          --> '    '         move.l  #spc_len,d1         bsr     std_out               Write byte/message to screen         pull         rts*********************************************************************  MkCRLF : Issue CR/LF sequence on the screen to separate lines.*mkcrlf   push                          Save register's values         lea     crlf(pc),a0           --> CR/LF sequence         moveq   #$02,d1         bsr     std_out               Write byte/message to screen         pull                          Restore them back         rts                           Return from subroutine*********************************************************************  Move_Dat : Transfer data from (a0) to (a1) until move_dlm(a6)*             is seen at (a0).*move_dat move.b  (a0)+,(a1)+           Transfer data ...         move.b  (a0),d1               Get next byte         cmp.b   move_dlm(a6),d1       Do we have to stop transfer ?		 bne.s   move_dat              Nope, keep going ...         move.b  (a0),(a1)             Copy delimiter where appropriatemove_ext rts                           Return to caller, transfer done         *************************************************************  Normal : Restore normal keyboard before exiting ATerm.*normal   moveq   #stdin,d0             standard input path         moveq   #SS_Opt,d1            get the descriptor         lea     pd_trm_o(a6),a0       in memory         os9     I$SetStt              now restore original "/TERM"         rts                           return to caller**************************************  On_Line : Show on line message.*on_line  lea     mesg5(pc),a0          --> * On line ...         move.l  #endmesg5,d1         bsr     std_out               Write byte/message to screen         move.l  #seq_len*s_csr_on,d1  Get proper offset into table         bsr     wrt_seq               Write corresponding sequence         rts                           return to caller********************************************************  OutChr : Print a digit resulting from a division.*outchr   move.l  d3,d4                 save register         andi.b  #$0F,d3               keep only the byte         bne.s   out_1                 not a zero, so branch         tst.b   last_dig(a6)          Are we processing the last digit ?         bne.s   out_1                 Yes, so do normal process.         tst.b   not_0(a6)             there was always a blank zero ?         beq.s   out_2                 no, print nothing         tst.b   lead_0(a6)            Do we still have leading zeroes ?         bne.s   out_1                 No this is not.         tst.b   nlead_0(a6)           Do we need them ?         beq.s   out_2                 Nope, just ignore it         tst.b   whit_0(a6)            Do we replace leading zeroes / ' ' ?         beq.s   out_1                 No print it as is         move.b  #' ',d3               Replace the '0' by a space         bra.s   out_1aout_1    move.b  #$01,lead_0(a6)       No more leading zeroes         move.b  #$01,not_0(a6)        a first blank zero was read         addi.b  #$30,d3               ascii the digitout_1a   lea     out_char(a6),a0       place it in a buffer         move.b  d3,(a0)               get the digit         moveq   #$01,d1               only one byte         bsr     std_out               Write byte/message to screenout_2    move.l  d4,d3                 restore character         rts                           return to caller***************************************************************  Print_Ch : Send the character on printer if appropriate.*             The character is pointer to by register 'a0'.*print_ch move.w  pr_path(a6),d0        Printer Pipe Path Number         moveq   #$01,d1               Only one character at once         tst.b   dir_outp(a6)          Are we doing direct output to printer ?         beq.s   pr_char1              Nope, so use 'non-edited' WRITE         os9     I$WritLn              Otherwise, write with edition         bra.s   pr_ch_ex              And return to callerpr_char1 os9     I$Write               Go for it, send it where it belongspr_ch_ex rts                           return to main program***************************************************************************  PutChr : Will print on STD_OUT, a string pointed by a0, for a length*           specified by D1.*putchr   push         bsr     std_out               Write byte/message to screen         bsr     mkcrlf                Put a CR+LF right after         pull         rts                           Return from subroutine***************************************************************************  Read_Ctl : Get a line out of the control file.  Return to caller if*             the read is not successfull or if we're pointing to a valid*             sequence code, leaded by an '@'.*read_ctl clr.b   text_seq(a6)          Indicate either a text/HEX sequence         move.w  ctl_path(a6),d0       Get path number         moveq   #100,d1               Maximum line length         lea     ctl_inf(a6),a0        Where to put the control information         os9     I$ReadLn              Read control file         bcs.s   read_cex              Return to caller indicating the error         subi.l  #$01,d1               Adjust read count for the DBra loopread_ct1 cmpi.b  #'@',(a0)             Do we have an ASCII text sequence ?         bne.s   read_ct2              Nope, so check for an HEXa sequence ?         move.b  #$01,text_seq(a6)     Indicate an ASCII sequence ....         bra.s   read_cex              Return to callerread_ct2 cmpi.b  #'$',(a0)             Do we have an HEX sequence ?         beq.s   read_cex              If so, return to caller         addi.l  #$01,a0               Otherwise point to next byte and ...         dbra    d1,read_ct1           Keep going 'till done         bra.s   read_ctl              It looks like we have to read more !!read_cex rts                           Return to caller***************************************************************************  Read_Kbd : Check the keyboard status, to know if there is any data*            awaiting to be picked up.*read_kbd moveq   #stdin,d0             Kbd Path.  STD IN         moveq   #SS_Ready,d1          Set the system call function code         os9     I$GetStt              Check for data availability         bcs.s   kb_s_ex               Exit as we have nothing to pick upread_kb1 moveq   #$01,d1               Get ready to read data, one byte         lea     inbuffer(a6),a0       Where to put the data to be read         os9     I$Read                Go for itkb_s_ex  rts                           Return with appropriation status**************************************************************************  Read_Mdm: Check the modem path status, to know if there is any data*            awaiting to be picked up.*read_mdm move.w  mdm_path(a6),d0       Modem path         moveq   #SS_Ready,d1          Set the system call function code         os9     I$GetStt              Check for data available         bcs.s   md_s_ex               Exit as we have nothing to pick up         moveq   #$01,d1               Get ready to read data, one byte         lea     mbuffer(a6),a0        where to put the data to be read         os9     I$Read                Go for itmd_s_ex  rts                           Return with appropriate status****************************************************  Ring : Ring the bell once to notify the user.*ring     push         lea     msg43(pc),a0           --> C$Bell         move.l  #endmsg43,d1           how many bytes         bsr     std_out               Write byte/message to screen         pull         rts                           return to caller*************************************************************************  Save_Buf : Save XModem buffer to the file and re-adjust pointers.*save_buf move.w  fd_path(a6),d0        restore filename path         move.l  u_countr(a6),d1       how many bytes to write to         lea     f_downld(a6),a0       the disk file         os9     I$Write         clr.l   u_countr(a6)          clear bytes counter         lea     f_downld(a6),a3       and re-adjust buffer pointer         rts****************************************************************************  Save_Dld : Save remaining data in the buffer from a previous download*             when exiting or an other upload or download is requested.*save_dld lea     msg10(pc),a0          --> Please wait, closing file ...         move.l  #endmsg10,d1         bsr     std_out               Write byte/message to screen         bsr     write_fl              go save what was received         clr.b   clos_flg(a6)          say that the file was close to others         clr.b   d_flag(a6)            say download is finish         lea     opt_t1_w(a6),a0       This one is our working copy         bsr     xn_xf_of              Disable Xon/Xoff Handshake         move.w  fd_path(a6),d0        get download path         os9     I$Close               and close it         bcc.s   ok_disk1              if no error         bsr     med_err               error on mediaok_disk1 bsr     mkcrlf                Generate a CR/LF on screen         lea     dfilenam(a6),a0       read again filename         moveq   #Read_,d0             access         os9     I$Open                open the file         move.w  d0,fd_path(a6)        save path         bsr     size_it               compute and show file size         move.w  fd_path(a6),d0        restore path         os9     I$Close               close the file         bsr     arrow                 Display an arrow on screen         bsr     show_val              Compute and display value         lea     msg42(pc),a0          --> ... bytes written to file         move.l  #endmsg42,d1         bsr     std_out               Write byte/message to screen         lea     dfilenam(a6),a0       Point to the filename         move.l  dfilelen(a6),d1       Get is length         bsr     std_out               Show it on the screen         bsr     mkcrlf                Issue a CR/LF on the screen         rts                           return to caller************************************************  Send_Ack : Send C$ACK for blocks and EOT.*send_ack lea     mbuffer(a6),a0        say to transmitter that         move.b  #C$ACK,(a0)           everything ok so far         bsr     wrt_mdm               Acknowledge reception of this packet         rts*****************************************************************  Send_Xof/Xon : Transmit handshake character on modem port.*send_xof lea     cust_xof(a6),a0       Customized XOFF         bra.s   send_hsksend_xon lea     cust_xon(a6),a0       Customized XONsend_hsk bsr     wrt_mdm               Send it on the modem port         moveq   #$20,d0               Wait a little         os9     F$Sleep               As ram disk is really fast and the host*                                       may not have caught the XOFF         rts                           Return to caller*******************************************************************************  Set_Env : Set variables using environment values.  If environment values*            are not found, then set variables to their defaults.*set_env  cmpi.b  #C$CR,(a5)+           Have we reached the end of cmd line ?         bne.s   set_env               Nope, so keep going         lea     env_init(a6),a0       Point to our initial environment table         clr.l   d0                    Reset lengthset_env0 cmpi.b  #$FC,(a5)             End of the environement variables ?         beq.s   set_env2              Yes, so do some more work         cmpi.b  #C$Null,(a5)          Do we have a NULL character ?         beq.s   set_env1              Yes so ignore it         move.b  (a5),(a0)+            Put it in our table         addi.l  #$01,d0               Increment length counterset_env1 addi.l  #$01,a5               Adjust environment pointer         bra.s   set_env0              Keep going until transfer complete**-  Table successfully copied, we may now search for matching ENV variables*set_env2 move.b  #C$Spac,(a0)          Make sure to have a proper terminator         clr.l   d1                    Reset item counter 0 = SHELL         bsr     get_env0              Try to get environment value         lea     shell_nm(a6),a1       Point where we'll store the value         tst.b   good_env(a6)          Successfull ?         beq.s   set_env3              Nope, so use default values         move.b  #C$Spac,move_dlm(a6)  Stop moving data when a space is seen         bra.s   set_env4              And go move the dataset_env3 move.b  #C$Null,move_dlm(a6)  Stop when a null is seen         lea     def_shl(pc),a0        We'll use default value for the shellset_env4 bsr     move_dat              Go move the data         clr.b   (a1)                  Make sure it ends with a NULL         moveq   #$01,d1               Now go for the CNTLF (Control File)         bsr     get_env0              Get environement value for CNTLF         lea     ctl_file(a6),a1       Point where we'll store the data         tst.b   good_env(a6)          Has the research been successfull ?         beq.s   set_env5              Unfortunatly no, so set to defaults         move.b  #C$Spac,move_dlm(a6)  Stop moving data at first space         bra.s   set_env6              And move the appropriate dataset_env5 move.b  #C$CR,move_dlm(a6)    Will stop at the first carriage return         lea     def_ctl(pc),a0        Point to the default control fileset_env6 bsr     move_dat              Go move the data         move.b  #C$CR,(a1)            Make sure we've got the CR terminator         moveq   #$02,d1               This is the time to check for PHONE         bsr     get_env0              Give it a try and see what happen         lea     phon_fil(a6),a1       Where the Phone pathname will go ...         tst.b   good_env(a6)          Has the research been successfull         beq.s   set_env7              Nope, so we'll use the default value         move.b  #C$Spac,move_dlm(a6)  Stop moving data at the first space         bra.s   set_env8              And go move the dataset_env7 move.b  #C$CR,move_dlm(a6)    End transfert at the carriage return         lea     def_phon(pc),a0       Get the default path nameset_env8 bsr     move_dat              Move data once more ....         move.b  #C$CR,(a1)            Insure to have appropriate terminator         moveq   #$03,d1               And now, the hardcopy : HDCPY         bsr     get_env0              Let see if we have a match ...         lea     prt_name(a6),a1       This is where the printer name goes         tst.b   good_env(a6)          Have we found it in the environement ?         beq.s   set_env9              No.  So prepare to use default         move.b  #C$Spac,move_dlm(a6)  Set our transfer delimiter accordingly         bra.s   set_envA              And do the data exchangeset_env9 move.b  #C$CR,move_dlm(a6)    Indicate the transfer delimiter         lea     def_prt(pc),a0        Point to the default printer pathset_envA bsr     move_dat              Do the transfer of data         move.b  #C$CR,(a1)            Insure once more for proper delimiter         lea     env_init(a6),a0       Point to the top of the table         add.l   d0,a0                 Position to the last byte of it         clr.b   (a0)                  Reset it as we put a C$Spac upon entryexit_env rts                           Environement has been set, return*******************************************************************************  Set_Frk : Using the Shell name, the parameters to be passed to the Shell*            and the actual environment variables, prepare parameter area*            to be used by the F$Fork system call.**-----*   1)  Set the command line parameters ...*-----set_frk  move.b  #C$CR,move_dlm(a6)    Indicate the transfer delimiter         lea     shl_prm(pc),a0        Where we copy the data from ...         lea     fork_prm(a6),a1       Where we copy the data to ...         bsr     move_dat              Transfer the data where appropriate         adda.l  #$01,a1               Point where we'll put next data         clr.b   (a1)+                 Insert one byte padding         move.l  a1,d1                 Get actual ending address         btst.l  #0,d1                 Even byte boundary ?         beq.s   set_frk1              Yes, so no padding necessary         adda.l  #$01,a1               Adjust to the next even byte boundary*-----*   2)  Set the environment variables ...*-----set_frk1 move.b  #C$Null,move_dlm(a6)  Now, the NULL charcater is the delim         lea     env_init(a6),a0       Point to actual environment variables         bsr     move_dat              Get a copy in our buffer         adda.l  #$01,a1               Point where we'll put next data         move.l  a1,d1                 Get actual ending address         btst.l  #0,d1                 Even byte boundary ?         beq.s   set_frk2              Yes, so no padding necessary         adda.l  #$01,a1               Adjust to the next even byte boundary*-----*   3)  Set Env. Sync Code, Program Name and Program name offset ...*-----set_frk2 move.w  #env_sync,(a1)+       Install the environment Sync Code         lea     fork_prm(a6),a0       Where we copy the data to ...         move.l  a0,d0                 Get top address of the parameter area         move.l  a1,d1                 Where are we at right now         sub.l   d0,d1                 Compute offset from the top         addi.l  #$04,d1               Adjust for the offset space requirement         move.l  d1,(a1)+              Save it in the buffer as pgmname offset         lea     shell_nm(a6),a0       Point to the program name to be used         bsr     move_dat              Get it in our buffer         adda.l  #$01,a1               Point where we'll put next data         move.l  a1,d1                 Get actual ending address         btst.l  #0,d1                 Even byte boundary ?         beq.s   set_frk3              Yes, so no padding necessary         adda.l  #$01,a1               Adjust to the next even byte boundaryset_frk3 move.w  #null_cr,(a1)+        Put the delimiter in the buffer         move.l  #$00,(a1)+            Need a 4 bytes block of 0's as marker*-----*   4)  Compute command line parameter offsets ...*-----         move.l  #-1,d0                Will serve as an offset counter         lea     fork_prm(a6),a0       Point to top parameter bufferset_frk4 move.b  (a0)+,d1              Get a byte out of the parameter buffer         addi.l  #$01,d0               Adjust offset counter         cmpi.b  #C$CR,d1              Command line completed ?         beq.s   set_frk5              Yep, so go process environment         cmpi.b  #C$Spac,d1            Do we have a space delimiter ?         bne.s   set_frk4              Nope, so keep looking          move.l  d0,d1                 Get a copy of the offset         addi.l  #$01,d1               Adjust to point to the non-space         move.l  d1,(a1)+              Put offset value in buffer         bra.s   set_frk4              Keep going 'till done ...         set_frk5 move.l  #$00,(a1)+            Need a 4 bytes block of 0's as markerset_frk6 move.b  (a0)+,d1              Get a byte out of the parameter buffer         addi.l  #$01,d0               Adjust offset counter         cmpi.b  #C$Null,d1            Are we a the beginning of the ENV vars         beq.s   set_frk6              Nope, so keep skipping data*-----*   5)  Compute environment variable offsets ...*-----         move.l  d0,(a1)+              Save offset of first environment var.set_frk7 move.b  (a0)+,d1              Get a byte out of the parameter buffer         addi.l  #$01,d0               Adjust offset counter         cmpi.b  #C$Null,d1            Environment completly scanned ?         beq.s   set_frk8              Yep, so do last preparations         cmpi.b  #C$Spac,d1            Do we have a space delimiter ?         bne.s   set_frk7              Nope, so skip it         move.l  d0,d1                 Get a copy of the offset         addi.l  #$01,d1               Adjust to point to the non-space         move.l  d1,(a1)+              Put offset value in buffer         bra.s   set_frk7              Keep going 'till done ...         set_frk8 move.l  #$00,(a1)+            Need a 4 bytes block of 0's as marker         lea     fork_prm(a6),a0       Where we copy the data to ...         move.l  a0,d0                 Get top address of the parameter area         move.l  a1,d1                 Where are we at right now         sub.l   d0,d1                 Compute offset         move.l  d1,prm_size(a6)       Save it as parameter size for F$Forkexit_frk rts                           Fork setup is done, return***************************************************  Set_Mdm : Set modem path according to the values in the working*            optional path descriptor*set_mdm  lea     opt_t1_w(a6),a0       This one is our working copy         move.w  mdm_path(a6),d0       Get modem path         moveq   #SS_Opt,d1            Set option function code         os9     I$SetStt              And go for it ...*         moveq   #$20,d0               wait a little bit*         os9     F$Sleep               before returning         rts                           Return to caller***************************************************  Set_Trap : Install signal intercept routine.*set_trap lea     sig_trap(pc),a0       Point to the intercept routine         os9     F$Icpt                Install it         rts*********************************************  Show_Blk : Show block number on screen*show_blk push         lea     crlf(pc),a0           --> CR/LF sequence         moveq   #$01,d1               But will use only the CR         bsr     std_out               Write byte/message to screen         move.l  blk_no(a6),number(a6) Get the block number back*                                      --> Sending xmodem block #         bsr     mk_space              Issue few spaces for clarity         bsr.s   show_val              go convert and show block number         pull         rts***********************************************************************  Show_Byt : Display the amount of bytes sent/received via XModem.*             count.*show_byt push         bsr     mk_space              Make few spaces on screen         move.l  xnumber(a6),d1        get character number         move.l  d1,number(a6)         transfer in buffer         bsr.s   show_val              go print how many bytes were send         pull         rts*******************************************************************  Show_Err : Show amount of errors on current block. (XModem).*show_err push         bsr     mk_space              make a space on screen         move.l  xerror(a6),d1         go show on screen how many         move.l  d1,number(a6)         transfer error since beginning         bsr.s   show_val              go print error number         bsr     mk_space              Still need few spaces before msg         pull         rts                           Return to caller*****************************************************************  Show menu : Print ATerm main menu on screen when using ^Y.*show_mnu lea     mesg6(pc),a0          --> Main menu with options         move.l  #endmesg6,d1         bsr     std_out               Write byte/message to screen         rts*****************************************************************  Show_Val : Display a value previously computed.  The value*             to be displayed is in 'number(a6)'.*show_val clr.b   pass_1(a6)            not the second pass         clr.b   lead_0(a6)            Leading zeroes indicator         clr.b   last_dig(a6)          Last digit indicator         move.b  #$01,not_0(a6)        Set the flag to process zeroes         move.l  number(a6),d3         copy the number in d3*---------------------------------------------------*  Take care of the most significant 16 bits first*---------------------------------------------------         divu.w  #10000,d3             result in LS 16 bitssnd_pass andi.l  #$FFFF,d3             erase remainder         divu.w  #10000,d3             divide again         bsr     outchr                go print first digit*----------*  1000's*----------         tst.b   pass_1(a6)            first pass ?         beq.s   mill_2                yes         move.b  #$01,not_0(a6)        second pass, flag for blank zeromill_2   swap    d3                    get quotient         andi.l  #$FFFF,d3             filter remainder         divu.w  #1000,d3              divide by 1000         bsr     outchr                go print the digit*---------*  100's*---------         swap    d3                    get quotient         andi.l  #$FFFF,d3             erase remainder         divu.w  #100,d3               divide quotient by 100         bsr     outchr                go print the digit*--------*  10's*--------         swap    d3                    get quotient         andi.l  #$FFFF,d3             erase remainder         divu.w  #10,d3                divide quotient by 10         bsr     outchr                go print digit*-------*  1's*-------         tst.b   pass_1(a6)            This was the second pass ?         beq.s   siz_0                 No, still the first one         move.b  #$01,last_dig(a6)     Indicate that we're doing the last onesiz_0    swap    d3                    get quotient         bsr     outchr                go print it         tst.b   pass_1(a6)            it was the second pass ?         bne.s   end_size              yes, exit routine         clr.b   not_0(a6)             no, clear flag         move.b  #$01,pass_1(a6)       now it is the second pass         move.l  number(a6),d3         get the number back         divu.w  #10000,d3             divide it by 10000         swap    d3                    get the quotient         bra.s   snd_pass              and repeat divisionend_size rts                           return to main program****************************************************************  Sig_C_Of : Carrier loss detection.**sig_c_of push*         move.w  md_path2(a6),d0       Indicate modem path*         moveq   #SS_DCOff,d1          'Send Signal on carrier loss' code*         move.w  #sig_c_lo,d2          Will use signal #258, to signal event*         os9     I$SetStt              Install 'trap' ...*         bcc.s   sig_of_x*         bsr     ring*sig_of_x pull*         rts***************************************************  Sig_C_On : Carrier detect on signal routine.**sig_c_on push*         move.w  md_path2(a6),d0       Indicate modem path*         moveq   #SS_DCOn,d1           'Send Signal on carrier detect' code*         move.w  #sig_c_hi,d2          Will use signal #257, to signal event*         os9     I$SetStt              Install 'trap' ...*         bcc.s   sig_on_x*         bsr     ring*sig_on_x pull*         rts***************************************************  Sig_C_Rl : Release signal for carrier status.**sig_c_rl push*         move.w  md_path2(a6),d0       Indicate modem path*         moveq   #SS_Relea,d1          Release device from signals*         os9     I$SetStt              And do the job*         bcc.s   s_mdm_rl*         bsr     ring*s_mdm_rl pull*         rts***************************************************************************  Sig_Trap : Will intercept signals defined to be used in the program.**            256  :  Keyboard depression indicating an abort*            257  :  Carrier detection on*            258  :  Carrier loss*sig_trap push                          Save registers values onto stack*------------*  Keyboard*------------sig_256  cmpi.w  #sig_kbd,d1           Do we have a keyboard abort ?*         bne.s   sig_257               Nope, so test for carrier status         bne.s   sig_next              Temporary skip over carrier signals         moveq   #stdin,d0             Kbd Path.  STD IN         bsr     read_kb1              Get key that has been depressed         cmpi.b  #C$EOF,(a0)           Do we have an ESCape ?         bne.s   sig_256a              Nope, so simply ignore it         bsr     ring                  Indicate successfull abort detection         move.b  #$01,kb_abort(a6)     Set the keyboard abort flag accordinglysig_256a bsr     kbd_det               Re-Install Signal intercept for KBD*         bra.s   sig_exit              Return to caller*---------------------*  Carrier Detect ON*---------------------*sig_257  cmpi.w  #sig_c_hi,d1          Do we have a carrier detection ?*         bne.s   sig_258               Nope, so test for a carrier lost*         lea     msg46(pc),a0          Point to message for Carrier ON*         move.l  #endmsg46,d1          Get message length*         bsr.s   std_out               Show message**         bsr.s   sig_c_rl              Release device from signals*         bsr.s   sig_c_on              Re-Install signal trap*         bra.s   sig_exit              Return to caller*----------------------*  Carrier Detect OFF*----------------------*sig_258  cmpi.w  #sig_c_lo,d1          Do we have a carrier lost signal ?*         bne.s   sig_next              No, so try with next possible signal*         lea     msg47(pc),a0          Point to message*         move.l  #endmsg47,d1          Pick up its length*         bsr.s   std_out               Advise user of the situation**         bsr.s   sig_c_rl              Release device from previous signals*         bsr     sig_c_of              Re-Install signal trap**         bra.s   sig_exitsig_next equ     *sig_exit pull                          Restore registers as before intercept         clr.l   d1                    Clear processed signal         os9     F$RTE                 Return from interrupt exception.*****************************************************************  Size_It : Get the file size for ASCII/XModem Up/Downloads.*size_it  moveq   #SS_Size,d1           function code         os9     I$GetStt              get file size         move.l  d2,number(a6)         and save that in the buffer         move.l  d2,xsize(a6)          As well as for the XModem utility         rts*******************************************************  Std_Out : Will write to the standard output path*            a byte/string pointed by register (a0)*            for a length specified by reg. 'd1'.*std_out  moveq   #stdout,d0            Select the Standard Output Path         os9     I$Write               Write the required byte/string ...         rts                           Simple, easy and complete !!!****************************************************  TempoKbd : Temporary keyboard for user entry.*tempokbd moveq   #stdin,d0             standard input path         lea     pd_trm_w(a6),a0       in that memory         move.b  #ON,PD_EKO-PD_OPT(a0) set the echo back on         move.b  #C$EOF,PD_EOF-PD_OPT(a0)  restore eof         move.b  #C$Paus,PD_PSC-PD_OPT(a0)  "   "  PAUSE character         moveq   #SS_Opt,d1            get the descriptor         os9     I$SetStt              Go for it         rts                           Back to main program ...***********************************************************************  Wait_Byt : Wait for a byte from the modem path or the keyboard.*             Will signal waiting timout if appropriate.  Will also*             set the manually abort flag if a key is depressed.*wait_byt movem.l d2,-(a7)              Save Blk#.  (D2 used by F$Time)         clr.b   time_out(a6)          Indicates that the rmt is timed out         bsr     read_mdm              Check for data availability         bcc.s   wait_end              We have something, so just exit         moveq   #$01,d0               code = julian time to get the         os9     F$Time                time with system call         addi.l  #secs_t_o,d0          Add delay before signaling timeout         move.l  d0,d7                 and keep that for laterwait_mdm bsr     read_mdm              Check for data on modem path         bcc.s   wait_end              a character is waiting         moveq   #$01,d0               none of them; read again         os9     F$Time                julian time         cmp.l   d0,d7                 did we exeed 10 seconds wait?         bpl.s   wait_mdm              not yet, we can still wait         move.b  #$01,time_out(a6)     Indicate remote being timed out         addi.l  #$01,xerror(a6)       reached and increment error counter         cmpi.l  #$01,blk_no(a6)       Are we processing first block         beq.s   wait_end              If so, don't indicate a timeout         lea     xmg11(pc),a0          --> Excessive timeout ...         move.l  #endxmg11,d1         bsr.s   xmd_msg               Write byte/message to screen         bsr     show_blk              Show Block number on screen         bsr     show_byt              And reshow cumulative counters         cmpi.l  #max_errs,xerror(a6)  Are we exceeding error count ?         blo.s   wait_end              Nope, so don't get excited !!!         move.b  #$01,too_many(a6)     Indicate that too many errors occuredwait_end movem.l (a7)+,d2              Get our block number back         rts                           and return*****************************************************************************  Wrt_Mdm : Will send a byte to the modem, and wait for 2 ticks in order*            to help slow receivers.  (a0) points to the byte to be sent.*wrt_mdm  move.w  mdm_path(a6),d0       Will print to modem path         moveq   #$01,d1               Length set before call         os9     I$Write               Send it to the modem ...*        moveq   #$01,d0               wait a little bit*        os9     F$Sleep               before returning         rts                           Return from subroutine************************************************************************  Wrt_Seq : Will write a pre-selectionned sequence from the control*            table.  Register D1 has the offset within table, and D0*            has the path number.*wrt_seq  push         clr.b   wrt_cnt(a6)           Reset our write count         lea     ctl_tbl(a6),a0        Point to the beginning of the table         adda.l  d1,a0                 Add offset as previously computed         moveq   #$01,d1               Only one byte at oncewrt_seq1 cmpi.b  #$FF,(a0)             Are we at the end of the sequence ?         beq.s   wrt_seq2              Yep, so return to caller         os9     I$Write               Write the required byte/string ...         addi.b  #$01,wrt_cnt(a6)      Increment counter         cmpi.b  #seq_len,wrt_cnt(a6)  Are we at the end of the sequence ?         addi.l  #$01,a0               Point to next byte         bne.s   wrt_seq1              Keep going till donewrt_seq2 pull         rts                           Simple, easy and complete !!!***************************************************************  Xmd_Msg : Routine to display error messages under XModem*xmd_msg  bsr     show_blk         bsr     show_byt         bsr     show_err         bsr     std_out         rts************************************************************  Xmo_3Can : Issue 3 consecutives CAN on the modem port*xmo_3can push                          Save registers values         lea     xmod_c(pc),a1         Point to the string         moveq   #xmod_c_l,d2          Get its length         subi.l  #$01,d2               Adjust counter for the DBxx loopsnd_can  lea     mbuffer(a6),a0        Get address for the modem buffer         move.b  (a1)+,(a0)            Put the byte where it belongs         bsr.s   wrt_mdm               Send it ...         dbra    d2,snd_can            If more to do, than go for it         pull                          Now we can restore registers         rts                           Remote is now advised**************************************************************  Xn_Xf : Enable or disable XON/XOFF for the serial port.*          This routine assumes (a0) to point to the descr.*xn_xf_of clr.b   PD_XON-PD_OPT(a0)     Disable XOF handshake         clr.b   PD_XOFF-PD_OPT(a0)     "   "  XOFF "    "         bra.s   set_hshk              Set Handshake parametersxn_xf_on move.b  cust_xon(a6),PD_XON-PD_OPT(a0)   Enable XON         move.b  cust_xof(a6),PD_XOFF-PD_OPT(a0)  Enable XOFFset_hshk move.w  mdm_path(a6),d0       Serial port path         moveq   #SS_Opt,d1            Set path options         os9     I$SetStt              Go for it ...         rts         ends