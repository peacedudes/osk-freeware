 - lacks dup2() system call (S5Rn, n < 4)#       -DGCVT_MISSING          - lacks gcvt() routine#       -DGETOPT_MISSING        - lacks getopt() routine#       -DMEMCMP_MISSING        - lacks memcmp() routine#       -DMEMCPY_MISSING        - lacks memcpy() routine#       -DMEMSET_MISSING        - lacks memset() routine#       -DRANDOM_MISSING        - lacks random() routine#       -DSTRCASE_MISSING       - lacks strcasecmp() routine#       -DSTRCHR_MISSING        - lacks strchr() and strrchr() routines#       -DSTRERROR_MISSING      - lacks (ANSI C) strerror() routine#       -DSTRTOD_MISSING        - lacks strtod() routine#       -DTMPNAM_MISSING        - lacks or deficient tmpnam() routine#       -DVPRINTF_MISSING       - lacks vprintf and associated routines#       -DSIGTYPE=int           - signal routines return int (default void)# A generic 4.2 BSD machine# (eliminate GETOPT_MISSING for 4.3 release)# (eliminate STRCASE_MISSING and TMPNAM_MISSING for Tahoe release)MISSING = -DDOPRNT_MISSING -DGCVT_MISSING -DBLKSIZE_MISSING\          -DSTRTOD_MISSING -DBSDSTDIO\          -DSTRCASE_MISSING -DTMPNAM_MISSING \          -DGETOPT_MISSING -Dstrchr=index -Dstrrchr=rindex -DSIGTYPE=int# Comment out the next line if you don't have gcc.# Also choose just one of -g and -O.CC=             ccRDIR=   		relsODIR=        	/h0/c/gawkOPTIMIZE=       -qgit=/r0PROFILE=        #-pgDEBUG=          #-DDEBUG #-DMEMDEBUG #-DFUNC_TRACE #-DMPROFDEBUGGER=       #-g -BstaticWARN=           #-W -Wunused -Wimplicit -Wreturn-type -Wcomment # for gcc only# Parser to use on grammar -- if you don't have bison use the first onePARSER = yacc#PARSER = bison# ALLOCA#       Set equal to alloca.r if your system is S5 and you don't have#       alloca. Uncomment one of the rules below to make alloca.r from#       either alloca.s or alloca.c.ALLOCA= alloca.r## With the exception of the alloca rule referred to above, you shouldn't# need to customize this file below this point.#FLAGS= $(MISSING) $(DEBUG)CFLAGS= $(FLAGS) $(DEBUGGER) $(PROFILE) $(OPTIMIZE) $(WARN)# object filesAWKOBJS = main.r eval.r builtin.r msg.r debug.r io.r field.r array.r node.r \                version.r missing.rALLOBJS = $(AWKOBJS) awk.tab.r# GNUOBJS#       GNU stuff that gawk uses as library routines.GNUOBJS= regex.r # $(ALLOCA)# source and documentation filesSRC =   main.c eval.c builtin.c msg.c \        debug.c io.c field.c array.c node.c missing.cALLSRC= $(SRC) awk.tab.cAWKSRC= awk.h awk.y $(ALLSRC) version.sh patchlevel.hGNUSRC = alloca.c alloca.s regex.c regex.hCOPIES = missing.d/dup2.c missing.d/gcvt.c missing.d/getopt.c \        missing.d/memcmp.c missing.d/memcpy.c missing.d/memset.c \        missing.d/random.c missing.d/strcase.c missing.d/strchr.c \        missing.d/strerror.c missing.d/strtod.c missing.d/tmpnam.c \        missing.d/vprintf.cSUPPORT = support/texindex.c support/texinfo.texDOCS= gawk.1 gawk.texinfoINFOFILES= gawk-info gawk-info-1 gawk-info-2 gawk-info-3 gawk-info-4 \           gawk-info-5 gawk-info-6 gawk.aux gawk.cp gawk.cps gawk.fn \           gawk.fns gawk.ky gawk.kys gawk.pg gawk.pgs gawk.toc \           gawk.tp gawk.tps gawk.vr gawk.vrsMISC = CHANGES COPYING FUTURES Makefile PROBLEMS READMEPCSTUFF= pc.d/Makefile.pc pc.d/popen.c pc.d/popen.hALLDOC= gawk.dvi $(INFOFILES)ALLFILES= $(AWKSRC) $(GNUSRC) $(COPIES) $(MISC) $(DOCS) $(ALLDOC) $(PCSTUFF) $(SUPPORT)# Release of gawk.  There can be no leading or trailing white space here!REL=2.11# rules to build gawkgawk: $(ALLOBJS) $(GNUOBJS)        chd $(RDIR);$(CC) -fd=$(ODIR)/gawk $(CFLAGS) $(ALLOBJS) $(GNUOBJS)\                        -l=/dd/lib/os9lib.l -l=/dd/lib/os9lib2.l# rules for testing of regexregex: reg.r        $(CC) -fd=regex $(CFLAGS) $(RDIR)/reg.r -l=/dd/lib/os9lib.lreg.r: regex.c	  @move $(RDIR)/regex.r $(RDIR)/r.r      @remove cpp      @load cpp.new      $(CC) -r=$(RDIR) regex.c -Dtest -qgit=/r0	  @move $(RDIR)/regex.r $(RDIR)/reg.r -r	  @move $(RDIR)/r.r $(RDIR)/regex.r      @remove cppmsg.r: awk.h      @remove cpp      @load cpp.new      $(CC) $(CFLAGS) -r=$(RDIR) $*.c      @remove cppregex.r: regex.h      @remove cpp      @load cpp.new      $(CC) $(CFLAGS) -r=$(RDIR) $*.c      @remove cppmissing.r: missing.c $(COPIES)      @remove cpp      @load cpp.new      $(CC) $(CFLAGS) -r=$(RDIR) $*.c      @remove cpp$(AWKOBJS): awk.hmain.r: patchlevel.hawk.tab.r: awk.h awk.tab.cawk.tab.c: awk.y        $(PARSER) -lv awk.y        -copy -r y.tab.c awk.tab.c# Alloca: uncomment this if your system (notably System V boxen)# does not have alloca in /lib/libc.a##alloca.r: alloca.s#       /lib/cpp < alloca.s | sed '/^#/d' > t.s#       as t.s -o alloca.r#       rm t.s# If your machine is not supported by the assembly version of alloca.s,# use the C version instead.  This uses the default rules to make alloca.r.#alloca.r: alloca.cclean:        -del gawk		-del $(RDIR)/*.r		-del awk.rutput		-del awk.tab.cclobber: clean        del $(ALLDOC) gawk.logsrcrelease: $(AWKSRC) $(GNUSRC) $(DOCS) $(MISC) $(COPIES) $(PCSTUFF) $(SUPPORT)        -makdir gawk-$(REL)        copy -p $(AWKSRC) $(GNUSRC) $(DOCS) $(MISC) gawk-$(REL)        -makdir gawk-$(REL)/missing.d        copy -p $(COPIES) gawk-$(REL)/missing.d        -makdir gawk-$(REL)/pc.d        copy -p $(PCSTUFF) gawk-$(REL)/pc.d        -makdir gawk-$(REL)/support        copy -p $(SUPPORT) gawk-$(REL)/support        tar -cf - gawk-$(REL) | compress > gawk-$(REL).tar.Zdocrelease: $(ALLDOC)        -makdir gawk-$(REL)-doc        copy -p $(INFOFILES) gawk.dvi gawk-$(REL)-doc        nroff -man gawk.1 > gawk-$(REL)-doc/gawk.1.pr        tar -cf - gawk-$(REL)-doc | compress > gawk-doc-$(REL).tar.Zpsrelease: docrelease        -makdir gawk-postscript        dvi2ps gawk.dvi > gawk-postscript/gawk.postscript        psroff -t -man gawk.1 > gawk-postscript/gawk.1.ps        tar -cf - gawk-postscript | compress > gawk.postscript.tar.Z