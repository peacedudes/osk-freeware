S$Alarm equ 5 psect utls,0,0,0,0,0 ifdef OSK_V2.2_setalarm: movem.l d2/d3,-(a7) move.l d0,d3 ; Zeit moveq.l #0,d0 moveq.l #A$Set,d1 moveq.l #S$Alarm,d2 ; Signal-Code bra.s alarm_setrepalarm: movem.l d2/d3,-(a7) move.l d0,d3 ; Zeit moveq.l #0,d0 moveq.l #A$Cycle,d1 moveq.l #S$Alarm,d2 ; Signal-Code bra.s alarm_delalarm: movem.l d2/d3,-(a7) moveq.l #0,d0 moveq.l #A$Delete,d1 alarm OS9 F$Alarm bcs.s err moveq.l #0,d0 movem.l (a7)+,d2/d3 rts err movem.l (a7)+,d2/d3err2 and.l #$00ffff,d1 move.l d1,errno(a6) moveq.l #-1,d0 rts*********** sigmask** only needed on 2.2 systems*sigmask: move.l d0,d1 moveq.l #0,d0 OS9 F$SigMask bcs.s err2 moveq.l #0,d0 rts endc************ _ss_break*_ss_break: moveq.l #SS_Break,d1 OS9 I$SetStt bcs.s err2 moveq.l #0,d0 rts ends