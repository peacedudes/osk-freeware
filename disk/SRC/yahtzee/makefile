# Define your brand of Unix here.#### Berkeley Unix systems should use this# UNIX_BRAND= BSD##### any System 5 less than 5.3 should define this# UNIX_BRAND= SYS5##### define this for 5.3 or (gulp) laterUNIX_BRAND= SYS5_3# BIN - final resting place for yahtzee# BIN= $(HOME)/bin# HSFILE - path for high score file, file will be created automatically#	   by yahtzee and will need write permission for those using it# HSFILE= $(HOME)/lib/yahtzee.HS# LDLIBS - libraries to get curses(3X) working#  BSD people require -ltermcap and -lcurses, SYS5 people only need -lcurses# LDLIBS= -lcurses# LDLIBS= -lcurses -ltermcap# LDFLAGS - flags for the loader#  BSD people should leave this empty# LDFLAGS= $(CFLAGS)# LDFLAGS=# FINAL - basename for program# FINAL= yahtzee##  ****** No real need to change anything below this line ******## HSSTRING - use this to get past sh(1) which will strip quotes# HSSTRING= '"$(HSFILE)"'# MANENTRY= yahtzee.6# CFLAGS= -O -D$(UNIX_BRAND)# HIGHFLAG= -DHSFILE=$(HSSTRING)CFLAGS =  -l=/dd/LIB/ncurses.l -l=/dd/LIB/os9lib.l -QT=/dd/TMP -DHSFILE="/h0/USR/GAMES/yahtzee.scores"OBJECTS = best.r boxup.r comp_select.r dis_dice.r eval.r find.r finish.r\	get_m.r help.r high.r misc.r opthelp.r play_info.r rools.r\	shwin.r update_score.r yz.r costs.r shell.r values.ryahtzee: $(OBJECTS)	cc $(OBJECTS) -f=/h0/USR/GAMES/CMDS/yahtzee $(CFLAGS) -m=10$(OBJECTS): defs.hmisc.r: side.hcosts.r: costs.hdis_dice.r: dice.hhelp.r: help.h# high.r: makefile#	cc -c $(CFLAGS) $(HIGHFLAG) high.crools.r: rools.h