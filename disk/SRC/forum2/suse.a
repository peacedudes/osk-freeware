 nam	suse ttl 	Souped-up Sieve of Eratosthenes (240 BC.)*********************************************************** Edition History*  #   Date     Comments    					 	    by * -- -------- ---------------------------------------- --- * 00 05-08-87 Initial test version					   OET	* -- 00-00-87 released to Forum						   OET* 02 09-04-87 some corrections ..                                          MB*********************************************************** include system definitions - here for my configuration		    use 	/DD/DEFS/oskdefs.d 			Edition		equ		1Typ_Lang 	equ		(Prgrm<<8)+ObjctAttr_Rev	equ		(ReEnt<<8)+1			psect	suse,Typ_Lang,Attr_Rev,Edition,0,0*---------------------------------------------------------* Explanations:* Articles using the famous sieve as a benchmark have been* published everywhere. * This famous sieve finds the first 1899 primes using a* sifting algorithm * In 1981 AAL (the Apple Assembly Line) challenged its* readers for the fastest Sieve (all dirty tricks allowed)* * The standard algorithm is described in some classics.* The following changes were made:*       * 1. Only check odd numbers - leave even ones out of array* 2. Get next increment from the prime array, so you only*    knock out primes* 3. Start knock-out sequence at P^2 - if prime found is 3,*    start at 9.* 4. Increment knock-out index by 2*P to avoid even numbers* 5. Stop at sqrt of max. number* 6. Shave some time computing squares by other method:* 		odd #	square	formula*		 1		  1		 0 * 8 + 1*		 3		  9		 1 * 8 + 1*		 5		 25		 3 * 8 + 1* 		 7		 49		 6 * 8 + 1*		 n		 n*n	sum of(1..n)*8+1* 7. As we are ignoring even numbers, we can simplify *	 	S*8+1 to S*4* 8. And do away with the *4 part by adding 4 each time*    * see AAL Oct.81, Feb.82, Nov.82, June 84.**---------------------------------------------------------_ARRAY	equ		$2000           this definition doesn't reserve space!*MB: reserve space for array        vsectARRAY   ds.b            _ARRAY        ends        *----   loop instruction  -------------------------------- Sieve	move.w		 #999,D6		do 1000 times   *----   clear working array  -----------------------------*_1		move.w	#ARRAY,A0	clear array _1              lea     ARRAY(a6),a0    pointer to array*		move.b	#$FF,D0                move.w  #$FF,D0         must be word for dbf !                _2		clr.l	(A0)+		pop off stack		clr.l	(A0)+		(downward growth)		clr.l	(A0)+		clr.l	(A0)+		(movem might be faster) 		clr.l	(A0)+		clr.l	(A0)+		clr.l	(A0)+		clr.l	(A0)+		dbf		D0,_2		nice, hey? *----   init variables  ----------------------------------		moveq	#3,D0		start at 3		moveq	#4,D4		makes 9		moveq	#4,D2		delta		moveq	#1,D3		used for striking non-primes*		move	#ARRAY+1,A0     position of 3 		lea     ARRAY+1(a6),a0  position of 3*		move	#ARRAY,A1	start of array                lea     ARRAY(a6),a1    start of array		bra.s	_4			jump into loop		*----   start sifting  -----------------------------------_3		addq	#4,D2		update difference		add		D2,D4		update square pointer_4		cmpi.b	#0,(A0)+	this a prime ?		bne.s	_6			  no*----   strike out multiples  ----------------------------		move	D4,D5		get latest square _5		move.b	D3,0(A1,D5)	  strike one		add 	D0,D5		  next strike		cmpi	#$2000,D5	  .. finished ?		bls.s	_5			  .. no*----	get next sieve size  -----------------------------_6		addq	#2,D0		next odd number		cmpi	#127,D0		until sqrt $4000-1				bls.s	_3*----	do it 1000 times  ---------------------------------		dbf	D6,_1		next one*		rts* use 'OS9 F$Exit' to leave a program !!!                clr.w   d1              return no error                OS9     F$Exit