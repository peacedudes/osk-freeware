#include <ctype.h>#include <modes.h>#include <stdio.h>#define SHELL    "zsh"#define SH_OPT   "-ny -nl"#define BT       '`'#define B_SIZE   1024char cmdbuf [ B_SIZE ] ;char *cmdptr = cmdbuf ;char subbuf [ B_SIZE ] ;char *subptr ;char *execl_args [4] = { (char*)0, (char*)0, (char*)0, (char*)0 } ;extern int  chainc () ;extern char *getenv () ;extern int  os9forkc () ;extern char **environ  ;/* addstr        *//*===============*/char *addstr ( dest, src, max, len )     char *dest ;     char *src ;     char *max ;     int  len ;{if ( len )  {  if ( dest + len >= max )    {    exit ( _errmsg ( 1, "argument doesn't fit into command buffer: '%s'\n", src ) ) ;    }  dest += sprintf ( dest, "%s ", src ) ;  }return ( dest ) ;}/* proc_bq_string *//*================*/proc_bq_string ( bqcmd )     char *bqcmd ;{int  pd ;int  old1 ;int  son_pid ;int  rpid ;unsigned status ;short last_was_white = 1 ;/* Pipe einrichten : */if ( ( pd = create ( "/PIPE",                     S_IREAD | S_IWRITE | S_ISIZE,                     S_IREAD | S_IWRITE | S_IOREAD | S_IOWRITE,                     512 ) ) < 0 )  {  exit ( _errmsg ( 2, "can't create pipe to '%s'\n", bqcmd ) ) ;  }old1 = dup ( 1 ) ;close ( 1 ) ;dup ( pd ) ;/* Sub-Kommando ausfuehren : */execl_args [2] = bqcmd ;son_pid = os9exec ( os9forkc, execl_args [0], execl_args, environ, 0, 0, 3 ) ;/* restore stdout : */close ( 1 ) ;dup ( old1 ) ;close ( old1 ) ;if ( son_pid < 0 )  {  exit ( _errmsg ( 3, "can't fork subprocess '%s'\n", bqcmd ) ) ;  }/* stdout vom Sub-Kommando lesen : */while ( read ( pd, cmdptr, 1 ) == 1 )  {  if ( isspace ( *cmdptr ) )    {    if ( last_was_white == 0 )      {      *cmdptr = ' ' ;      last_was_white = 1 ;      }    else      {      cmdptr -- ;      }    }  else    {    last_was_white = 0 ;    }  if ( ++ cmdptr >= cmdbuf + B_SIZE )    {    goto too_long ;    }  }close ( pd ) ;if ( *( cmdptr - 1 ) != ' ' )  {  *cmdptr = ' ' ;  if ( ++ cmdptr >= cmdbuf + B_SIZE )    {too_long:    exit ( _errmsg ( 4, "command expansion too long: '%s'\n", cmdbuf ) ) ;    }  }do  rpid = wait ( &status ) ;while ( rpid != son_pid && rpid != -1 ) ;}/* usage          *//*================*/usage (){fprintf ( stderr, "Syntax: qp <cmd> <arg1> ... <argn>\n" ) ;fprintf ( stderr, "Function: process back-quotes for command expansion\n" ) ;fprintf ( stderr, "no Options\n" ) ;fprintf ( stderr, "  Args enclosed in back quotes (`) are treated as a\n" ) ;fprintf ( stderr, "  command sequence; stdout of this sequence replaces\n" ) ;fprintf ( stderr, "  the command itself.\n" ) ;fprintf ( stderr, "  Nested qp's are possible: The innermost qp has to be\n" ) ;fprintf ( stderr, "  enclosed within a pair of single back quotes, the next\n" ) ;fprintf ( stderr, "  level must be enclosed with double back quotes, and\n" ) ;fprintf ( stderr, "  so on.\n" ) ;fprintf ( stderr, "  If quotes of two levels are at the same place, they\n" ) ;fprintf ( stderr, "  have to be separated by at least one blank.\n" ) ;exit ( 0 ) ;}/* main           *//*================*/main ( ac, av )    int  ac ;    char *av [] ;{int  i ;short between ;register short cnt ;register int len ;register char *cp ;register char *bp ;if ( ac == 1 || *av [1] == '-' )  {  usage () ;  }if ( ( execl_args [0] = getenv ( "SHELL" ) ) == (char*) 0 )  {  execl_args [0] = SHELL ;  }execl_args [1] = SH_OPT ;for ( i = 1 , between = 0 ; i < ac ; i ++ )  {  cp = av [i] ;  len = strlen ( cp ) ;  if ( between == 0 )    {    if ( *cp == BT )      {      do        {        len -- ;        cp ++ ;        between ++ ;        }      while ( *cp == BT ) ;      subptr = subbuf ;      }    else      {      cmdptr = addstr ( cmdptr, cp, cmdbuf + B_SIZE, len ) ;      }    }  if ( between > 0 )    {    if ( *( bp = cp + len - 1 ) == BT )      {      cnt = between ;      while ( -- cnt > 0 && *( -- bp ) == BT ) ;      if ( cnt == 0 )        {        len -= between ;        *bp = '\0' ;        between = 0 ;        subptr = addstr ( subptr, cp, subbuf + B_SIZE, len ) ;        proc_bq_string ( subbuf ) ;        }      else        {        subptr = addstr ( subptr, cp, subbuf + B_SIZE, len ) ;        }      }    else      {      subptr = addstr ( subptr, cp, subbuf + B_SIZE, len ) ;      }    }  }if ( between )  {  exit ( _errmsg ( 5, "unbalanced backquote '`' (level %d)\n", between ) ) ;  }execl_args [2] = cmdbuf ;os9exec ( chainc, execl_args [0], execl_args, environ, 0, 0, 3 ) ;}