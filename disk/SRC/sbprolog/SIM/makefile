********************************************************************************	This is the makefile for SBProlog compilation under OS9********************************************************************************	Default directories*	DDIR =*	SDIR =*	RDIR =*	Compiler, assembler & linker flagsCFLAGS = -t=/r0 -dOS9RFLAGS =#LFLAGS = -t=/r0 -m=100 -dOS9 -l=builtin/builtin.l \#	-l=/dd/lib/signal.l -l=/dd/lib/clock.lLFLAGS = -t=/r0 -m=100 -dOS9 -l=builtin/builtin.l -l=/dd/lib/os9lib.l*	ObjectsObjects = dispatch.r init.r float.r io.r sub_inst.r loader.r main.r \	parse_oprnd.r dis.r print_inst.r unify.r load_work.r aux.r mathutil.r*	Include filesIncludes = sim.h inst.h aux.h index.h simdef.hsbprolog: $(Objects) builtin/builtin.l	cc $(LFLAGS) -fd=../cmds/wam.sbprolog $(Objects)$(Objects): $(Includes)*	End of makefile