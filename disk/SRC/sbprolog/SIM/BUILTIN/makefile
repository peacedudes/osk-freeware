********************************************************************************	This is the makefile for SBProlog builtins compilation under OS9********************************************************************************	Default directories*	DDIR =*	SDIR =*	RDIR =*	Compiler, assembler & linker flagsCFLAGS = -t=/r0 -dOS9RFLAGS =LFLAGS = -t=/r0 -dOS9*	ObjectsObjects = builtin.r init_branch.r meta.r tio.r structure.r name.r buffer.r \	other.r time.r compare.r substuff.r arith.r saverest.r file.r syscall.r*	Include filesIncludes = builtin.h ../sim.h ../aux.hbuiltin.l: $(Objects)	merge -b=500 $(Objects) >-builtin.l$(Objects): $(Includes)*	End of makefile