# -*- Mode: Text -*-CFLAGS = -gt=/dd -DANSIIBINDIR = /h0/cmdsLIBDIR = /h0/libRDIR = RELSall: buildhash ispell ispell.hashispell.hash: buildhash dict.191	buildhashinstall: buildhash ispell ispell.hash	copy ispell.hash $(LIBDIR)/ispell.hash	attr $(LIBDIR)/ispell.hash -pr	attr ispell -xpebuildhash: buildhash.r hash.r	chd $(RDIR); cc $(CFLAGS) -f=buildhash buildhash.r hash.rispell: ispell.r term.r good.r lookup.r hash.r tree.r	chd $(RDIR); cc $(CFLAGS) -f=ispell ispell.r term.r good.r lookup.r \		hash.r tree.r -ltermlibclean:	del -f *.r buildhash ispell core mon.out hash.out \		stats.191 count.191