# -*- Mode: Text -*-#CFLAGS = -qxm=4k -t=/r0 -DANSIICFLAGS = -qxm=16k -t=/r0 -DTERMCAPS -bgRDIR = RELSODIR = /h0/cmds/dogLIBDIR = /h0/libmake.date: buildhash ispell $(LIBDIR)/ispell.hash	@echo ispell is ready; date >-make.date$(LIBDIR)/ispell.hash: buildhash dict.191	buildhash	attr $(LIBDIR)/ispell.hash -prbuildhash: buildhash.r hash.r	chd $(RDIR); cc $(CFLAGS) -f=buildhash buildhash.r hash.rispell: ispell.r term.r good.r lookup.r hash.r tree.r os9.r	chd $(RDIR); cc $(CFLAGS) -f=ispell -l=/dd/lib/termlib.l\					ispell.r term.r good.r lookup.r hash.r tree.r os9.r	attr ispell -axpeprclean: $(RDIR)/os9.r	del $(RDIR) *.r stats.191 count.191 make.date