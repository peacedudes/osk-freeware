CSRCS=	main.c getinfo.c debug.c send.c skip.c list.c subr.cSRCS=	${CSRCS} commands.cOBJS=	main.r getinfo.r debug.r send.r skip.r list.r subr.r commands.rDEFS=   -DDEBUG -DSYSVCFLAGS= -O ${DEFS} -T/dd -I.../include -I.../res -I/h0/blarslib/defs -O0 -Dis68k -gLFLAGS =  -l.../res/libresolv.l -l/dd/lib/socklib.l -l/dd/lib/netdb.l \   -l/h0/blarslib/blarslib.l -l/dd/lib/os9lib.l -g -s 50CC = gcc2ODIR = .../cmds.c.r:    ${CC} ${CFLAGS} -c -o $*.r $<$(ODIR)/nslookup : $(OBJS)    ${CC}  ${CFLAGS} $(OBJS) -o $(ODIR)/nslookup $(LFLAGS)