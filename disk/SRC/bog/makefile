# See bog.h for configuration# DICT is the dictionary that will be used to construct bog's word listDICT=wordsLIBS = -l=/dd/lib/curses.l -l=/dd/lib/termlib.l -l=/dd/lib/math.lRDIR = relsODIR = /h0/cmds/gamesCFLAGS = -qixm=2k -t=/r0CC = yccOBJS = bog.r help.r mach.r prtable.r timer.r word.r rand.rit.all: bog mkdict mkindex dict.stuff	@echo donebog: $(OBJS)	chd $(RDIR); $(CC) $(CFLAGS) -g -f=$(ODIR)/bog $(OBJS) $(LIBS)mkdict: mkdict.cmkindex: mkindex.cshowdict: showdict.r word.r	chd $(RDIR); $(CC) $(CFLAGS) -f=$(ODIR)/showdict showdict.r word.rdict.stuff: mkdict mkindex	mkdict <$(DICT) >-dict	mkindex <dict >-dict.ind$(OBJS): bog.hinstall: all	@echo "Move dict, dict.ind, and the helpfile to where you specified in bog.h"	@echo "Move bog.man to where you want the manual page to go"clean:	del $(RDIR)/*.r