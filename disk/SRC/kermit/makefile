PROG = xkermitRDIR = relsODIR = /h0/cmds/jejonesCDEFS =CFLAGS = -igqt=/r0 $(CDEFS)HEADERS = os9inc.hFILES = os9con.r os9get.r os9ker.r os9qui.r os9raw.r \		os9rec.r os9sen.r os9srv.r os9utl.rSRC = os9con.c os9get.c os9ker.c os9qui.c os9raw.c \		os9rec.c os9sen.c os9srv.c os9utl.c$(ODIR)/$(PROG): $(FILES)	chd rels; cc $(CFLAGS) $(FILES) -f=$(ODIR)/$(PROG)$(FILES):  $(HEADERS)	cc $(CFLAGS) -r=$(RDIR) $*.cdate.list: $(HEADERS) $(SRC)	pr -p96 -h1 -r90 -n $? ! spl	touch date.list