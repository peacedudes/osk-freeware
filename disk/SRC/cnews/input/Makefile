# You get your choice of rnews.immed or rnews.batch; rnews.immed tries# to start processing immediately, while rnews.batch waits for somebody# else (cron) to do it.  Running rnews.immed might, perhaps, be reasonable# if your news load is light and you are wildly impatient about processing# incoming news.  Otherwise, leave this alone.RNEWS = rnews.batchCC= ccDEFINES =COPTS = -t=/r0CFLAGS = $(COPTS) $(DEFINES) -v=../include -v=/h0/blarslib/defsLDFLAGS= -iLIBS= ../libcnews.lBATCH = ../batchTHEMBIN = newsrun newsrunning c7decode bdecode recenews recpnews rnewsTHEM = newsspool $(THEMBIN)RBIN = /h0/cmds# =()<NEWSARTS = @<NEWSARTS>@>()=NEWSARTS = /h0/spool/news# =()<NEWSBIN = @<NEWSBIN>@>()=NEWSBIN = /h0/ulib/newsbinDTR = README Makefile newsrun newsrunning newsspool.c c7decode.c rnews.batch \  rnews.8 bdecode.c recenews recpnewsPRE=POST= -l=../libcnews.l -l=/h0/blarslib/blarslib.lall: $(THEM)  touch all$(NEWSBIN)/input/newsspool: newsspool.r $(LIBS)  $(CC) $(CFLAGS) $(LDFLAGS) newsspool.r $(PRE) $(POST) -fd=$@  attr -e $@c7decode: c7decode.r $(LIBS)  $(CC) $(CFLAGS) $(LDFLAGS) c7decode.r $(PRE) $(POST) -fd=$@bdecode: bdecode.r $(BATCH)/crctab.r $(LIBS)  $(CC) $(CFLAGS) $(LDFLAGS) bdecode.r $(BATCH)/crctab.r $(PRE) $(POST) -fd=$@$(NEWSBIN)/input/newsrun: newsrun.r $(LIBS)  $(CC) $(CFLAGS) $(LDFLAGS) -bg newsrun.r $(PRE) $(POST) -fd=$@  attr -e $@$(RBIN)/rnews: rnews.r $(LIBS)  $(CC) $(CFLAGS) $(LDFLAGS) rnews.r $(PRE) $(POST) -fd=$@  attr -e -pe $@$(BATCH)/crctab.r:  $(BATCH)/crctab.c  chd $(BATCH) ; make crctab.rbdecode.r:  bdecode.c $(BATCH)/coder.h  $(CC) -r -v=$(BATCH) $(CFLAGS) bdecode.cnewsrun.r: newsrun.c ../include/news.hrnews.r: rnews.c ../include/news.htest.1:  echo '#! rnews' >$@  echo 'here is a phony first batch' >>$@test.2:  echo '#! cunbatch' >$@  echo '#! rnews' >>$@  echo 'here is a phony second batch' >>$@test.3p:  echo '#! rnews' >$@  echo 'here is a phony third batch' >>$@test.3:  test.3c  ( echo '#! cunbatch' ; cat test.3c ) >$@test.3c:  test.3p  : compress tends to return silly exit status for tiny inputs  -compress -b12 <test.3p >$@test.out:  echo '#! rnews' >$@  echo 'here is a phony first batch' >>$@  echo '#! rnews' >>$@  echo 'here is a phony second batch' >>$@  echo '#! rnews' >>$@  echo 'here is a phony third batch' >>$@rnews.immed:  rnews.batch  sed '/qqq/s/newsspool/& -i/' rnews.batch >$@rnews:  rnews.batch rnews.immed  cp $(RNEWS) rnews  chmod +x rnewssetup:  all  chmod +x rnews.batch rnews.immed  rm -rf bin  mkdir bin  cp $(THEM) bin  mkdir bin/input  cp newsrun bin/input  rm -f tmp.1  here=`pwd` ; echo "cat >>!!!!here/tmp.1" >bin/relaynews  echo "echo 1" >bin/spacefor  echo 'ln !!!!*' >bin/newslock  echo 'echo 10' >bin/sizeof  chmod +x bin/* bin/input/*  rm -rf in.coming  mkdir in.comingr:  all test.1 test.2 test.3 test.3c test.out setup  chmod +x $(THEM)  NEWSARTS=`pwd` NEWSCTL=`pwd` ./rnews.batch <test.1  cmp in.coming/* test.1  NEWSARTS=`pwd` NEWSCTL=`pwd` ./rnews.batch <test.2  sed 1d test.2 >tmp.2  cmp `ls -t in.coming | sed -n '1s;^;in.coming/;p'` tmp.2  rm tmp.2  NEWSARTS=`pwd` NEWSCTL=`pwd` ./rnews.batch <test.3  cmp `ls -t in.coming | sed -n '1s;^;in.coming/;p'` test.3c  NEWSARTS=`pwd` NEWSCTL=`pwd` ./newsrunning off  test -r in.coming/stop ;  NEWSARTS=`pwd` NEWSCTL=`pwd` ./newsrunning on  test ! -r in.coming/stop ;  mkdir in.coming/bad  NEWSARTS=`pwd` NEWSCTL=`pwd` ./newsrun  cmp tmp.1 test.out  test " `echo in.coming/*`" = ' in.coming/bad' ;  rm tmp.1  NEWSARTS=`pwd` NEWSCTL=`pwd` ./rnews.batch <test.1  NEWSARTS=`pwd` NEWSCTL=`pwd` ./rnews.batch <test.2  NEWSARTS=`pwd` NEWSCTL=`pwd` NEWSBIN=`pwd`/bin ./rnews.immed <test.3  cmp tmp.1 test.out  test " `echo in.coming/*`" = ' in.coming/bad' ;  rm tmp.1  rm -r bin in.comingclean:  rm -f *.r newsspool c7decode tmp.? test.* dtr lint rnews rnews.immed  rm -f bdecode  rm -rf in.coming bindtr:  $(DTR)  makedtr $(DTR) >dtr