# makefile for C news relaynews# modified for os9/68k by Blarson# =()<NEWSARTS = @<NEWSARTS>@>()=NEWSARTS = /h0/spool/news# =()<NEWSBIN = @<NEWSBIN>@>()=NEWSBIN = /h0/ulib/newsbin# =()<NEWSCTL = @<NEWSCTL>@>()=NEWSCTL = /h0/ulib/newsBIN=/h0/cmdsNPROC=2DEFINES= -v=../include -v=. -v=/h0/blarslib/defs -DVOID=void -DFLUSHEVERY=6CC= ccCOPTS= -t=/r0CFLAGS=$(DEFINES) $(COPTS)DBM = # -ldbmLIBS= $(DBM)LLIBS=-l=/h0/blarslib/blarslib.lLDFLAGS=PROPTS=PRE=POST=$(LLIBS)LIBOBJS=../libcnews.lLIBSRCS=SRC=relaynews.c active.c article.c caches.c mkdirs.c control.c fileart.c \  hdrdefs.c hdrparse.c hdrmunge.c \  history.c io.c msgs.c procart.c \  sys.c transmit.c trbatch.c ihave.c $(LIBSRCS)OBJ=relaynews.r active.r article.r caches.r mkdirs.r control.r fileart.r \  hdrdefs.r hdrparse.r hdrmunge.r \  history.r io.r msgs.r procart.r \  sys.r transmit.r trbatch.r ihave.rNONCFILES= TODO* README ads/README ads/[0-9]* \  sh/inews sh/tear sh/anne.jones sh/defhdrs.awk \  sh/realrnews sh/serverrnews makefileCFILES= ../include/*.h \  active.h article.h caches.h mkdirs.h control.h fileart.h \  hdrint.h headers.h history.h system.h transmit.h trbatch.h $(SRC)FILES=$(NONCFILES) $(CFILES)$(NEWSBIN)/relaynews: $(OBJ) $(LIBOBJS)  $(CC) $(LDFLAGS) $(OBJ) $(PRE) $(LIBS) -l=$(LIBOBJS) $(POST) -fd=$@  attr -e -pe $@newsinstall:  : nothing# bininstall: make directories, install programsbininstall: installinstall: $(NEWSBIN)/relay/relaynews$(NEWSBIN)/relay/relaynews: relaynews  -mkdir $(NEWSBIN)/relay $(NEWSBIN)/inject $(NEWSBIN)/ctl  rm -f $(NEWSBIN)/relay/relaynews  cp relaynews $(NEWSBIN)/relay  : needs to be news-owned, setuid -- build looks after that  cp sh/[a-z]* $(NEWSBIN)/inject  cp ctl/[a-z]* $(NEWSBIN)/ctl  cp aux/[a-z]* $(NEWSBIN)/relay  rm -f $(BIN)/inews  ln $(NEWSBIN)/inject/inews $(BIN)/inews 2>/dev/null || cp sh/inews $(BIN)TODO.grep: TODO  grep TODO ../include/*.h *.h *.c sh/* | tr -s " \11" " " >$@  grep TODO ../lib*/*.[ch] | tr -s " \11" " " >>$@r:  relaynews  chmod +x regress/regress  (cd regress; ./regress)  # header dependencies followactive.r: ../include/libc.h ../include/news.h ../include/config.hactive.r: active.harticle.r: ../include/news.h article.h headers.hcaches.r: ../include/news.h active.h caches.h transmit.hmkdirs.r: ../include/libc.h ../include/news.hcontrol.r: ../include/libc.h ../include/news.h ../include/config.hcontrol.r: headers.h article.h caches.h history.hfileart.r: ../include/libc.h ../include/news.h ../include/config.hfileart.r: active.h mkdirs.h headers.h article.h history.h system.hhdrdefs.r: ../include/news.h headers.h hdrint.hhdrmunge.r: ../include/libc.h ../include/news.h fileart.h headers.hhdrmunge.r: article.h hdrint.hhdrparse.r: ../include/libc.h ../include/news.h headers.h hdrint.hhistory.r: ../include/libc.h ../include/news.h ../include/config.hhistory.r: ../include/fgetmfs.h headers.h article.h history.hhostname.r: ../include/news.h ../include/config.hihave.r: ../include/libc.h ../include/news.h ../include/config.hihave.r: headers.h article.h caches.h history.hio.r: ../include/news.h headers.h article.hmsgs.r: ../include/news.h headers.h article.hprocart.r: ../include/libc.h ../include/news.h active.h control.hprocart.r: headers.h article.h history.h system.hrelaynews.r: ../include/libc.h ../include/news.h ../include/config.hrelaynews.r: ../include/fgetmfs.h active.h caches.h headers.hrelaynews.r: history.hstring.r: ../include/libc.h ../include/news.hsys.r: ../include/libc.h ../include/fgetmfs.h ../include/news.hsys.r: ../include/config.h system.htransmit.r: ../include/libc.h ../include/news.h ../include/config.htransmit.r: headers.h active.h article.h system.h trbatch.h transmit.htrbatch.r: ../include/libc.h ../include/news.h trbatch.h