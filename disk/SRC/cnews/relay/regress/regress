#! /bin/shPATH=".:$PATH"echo removing old dregs...rm -rf tmpecho making new working subtree...mkdir tmp 2>/dev/nullchmod +x master/runcp ../relaynews master/* tmpcd tmpchmod u+w *echo running relaynews..../runecho comparing output...sed 's/^... .. ..:..:..\..../TIME/' log >.log && mv .log logsed 's/	[0-9][0-9]*~/	TIME~/' history >.history && mv .history historyrm -f gmon.out history.* relaynews# diff -r ../out .for f in `find . -type f -print`do	cmp $f ../out/$fdone