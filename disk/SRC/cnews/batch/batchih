#! /bin/sh# ihave batch preparer# =()<. ${NEWSCONFIG-@<NEWSCONFIG>@}>()=. ${NEWSCONFIG-/usr/lib/news/bin/config}PATH=$NEWSCTL/bin:$NEWSBIN/batch:$NEWSBIN/inject:$NEWSBIN:$NEWSPATH ; export PATHumask $NEWSUMASKcase "$1"in	-d)	shift ; shift		# ignore -d option	;;esacdest=`expr "$NEWSSITE" : "^\(.*\)\.[^.]*$"`case "$dest"in	'')	dest="$NEWSSITE"	;;esacme="`newshostname`"echo "Newsgroups: to.$dest"echo "Subject: ihave $me"echo "Control: ihave $me"echoexec cat $*