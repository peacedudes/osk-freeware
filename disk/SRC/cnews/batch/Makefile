# Configuration stuff.# modified for os9/68k by blarsCC= ccCOPTS=-t=/r0CFLAGS=$(COPTS) -v=../include -v=/h0/blarslib/defsLDFLAGS= -iLIBS=../libcnews.l# =()<NEWSARTS = @<NEWSARTS>@>()=NEWSARTS = /h0/spool/news# =()<NEWSBIN = @<NEWSBIN>@>()=NEWSBIN = /h0/ulib/newsbin# =()<NEWSCTL = @<NEWSCTL>@>()=NEWSCTL = /h0/ulib/newsPRE=POST= -l=../libcnews.l -l=/h0/blarslib/blarslib.lOUTGOING = $(NEWSARTS)/out.goingPGMDIR = $(NEWSBIN)/batchPGMS=batcher batchih batchsm batchsplit comp compcun nocomp viainews viauux \  sendbatches compc7 c7encode viamail viapmail bencode compb viauuxz \  viaemail viarsh viauuxl viauuxcunALL = $(PGMS) batchparms$(NEWSBIN)/batcher: batcher.r $(LIBS)  $(CC) $(CFLAGS) $(LDFLAGS) batcher.r $(PRE) $(POST) -fd=$@  attr -e $@$(NEWSBIN)/c7encode: c7encode.r $(LIBS)  $(CC) $(CFLAGS) $(LDFLAGS) c7encode.r $(PRE) $(POST) -fd=$@  attr -e $@$(NEWSBIN)/bencode: bencode.r crctab.r $(LIBS)  $(CC) $(CFLAGS) $(LDFLAGS) bencode.r crctab.r $(PRE) $(POST) -fd=$@  attr -e $@bencode.r:  coder.h$(NEWSBIN)/sendbatches: sendbatches.r  $(CC) $(CFLAGS) $(LDFLAGS) sendbatches.r $(PRE) $(POST) -fd=$@  attr -e $@sendbatches.r:$(NEWSBIN)/trlfcmp: trlfcmp.r  $(CC) $(CFLAGS) $(LDFLAGS) trlfcmp.r $(PRE) $(POST) -fd=$@  attr -e $@trlfcmp.r: trlfcmp.c$(NEWSBIN)/trlfcmpcun: trlfcmpcun.r  $(CC) $(CFLAGS) $(LDFLAGS) trlfcmpcun.r $(PRE) $(POST) -fd=$@  attr -e $@trlfcmpcun.r: trlfcmpcun.c$(NEWSBIN)/viauux: viauux.c  $(CC) $(CFLAGS) $(LDFLAGS) viauux.r $(PRE) $(POST) -fd=$@  attr -e $@viauux.r: viauux.c