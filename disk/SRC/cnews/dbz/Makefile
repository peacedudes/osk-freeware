# dbz makefile modified for os9/68k by blarsCC= ccCOPTS = -t=/r0FLAGS = -v=../include -v=/h0/blarslib/defs# -lc before libcnews.a so we get fread etc. from systemDBMLIBS = -l=../libcnews.lRFC = -DHAVERFCIZEDEBUG = -DDBZDEBUGCFLAGS = $(COPTS) $(FLAGS)LDFLAGS = -i -l=/h0/blarslib/blarslib.llib_dbz.l: dbz.r  merge dbz.r >-lib_dbz.ldbz:  dbzmain.r dbz.r  $(CC) $(CFLAGS) dbzmain.r dbz.r $(LDFLAGS) -fd=$@byteflip:  byteflip.r  $(CC) $(CFLAGS) byteflip.r $(LDFLAGS) -fd=$@