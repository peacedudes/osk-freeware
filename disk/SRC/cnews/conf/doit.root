#! /bin/shumask 002set -x: making directories...for d in /h1/News /h1/News/in.coming /h1/News/in.coming/bad /h1/News/out.going /h1/Lib/News /h1/Lib/News/bin /h1/Lib/Newsbindo	if test ! -d $d	then		mkdir $d	fidone/dd/Cmds/chown news.news /h1/News /h1/News/in.coming /h1/News/in.coming/bad /h1/News/out.going /h1/Lib/News /h1/Lib/News/bin /dd/Cmds/chown bin.bin /h1/Lib/Newsbin : done