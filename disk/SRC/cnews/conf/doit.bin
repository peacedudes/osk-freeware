#! /bin/sh# -i suppresses install, -t suppresses stdio test# options are seen in first argument only, i.e. use -ti not -t -iumask 002set -x: setting up for substitutionscat >nsubstitutions <<'!'# master substitutions file## where the programs live (see also NEWSCONFIG)NEWSBIN		/h1/Lib/Newsbin# where the control files liveNEWSCTL		/h1/Lib/News# where the articles liveNEWSARTS	/h1/News# what PATH should be used for finding normal programs# (things not in NEWSBIN, that is)NEWSPATH	/h0/Cmds:/bin:/usr/bin# the umask under which files should be createdNEWSUMASK	002# who to send mail to when there is troubleNEWSMASTER	usenet# configuration file that lets shell files pick up all of thisNEWSCONFIG	/h1/Lib/News/bin/config!if test -r substitutions && cmp -s nsubstitutions substitutionsthen	rm nsubstitutionselse	mv nsubstitutions substitutionsfi: done: building headerscd ..if test ! -d includethen	mkdir include include/sysficd hrm -f nnewshsedecho "/NOSTOREVAL.*qqq/s;^;/* ;" >>nnewshsedecho "/SMALLMEM.*qqq/s;^;/* ;" >>nnewshsedif test -f newshsed && cmp -s nnewshsed newshsedthen	rm -f nnewshsedelse	mv nnewshsed newshsedfimake all || exit 1cd ../hfakeed - Makefile <<'!'/NEEDED =/s~.*~NEEDED =  ../include/string.h ../include/sys/timeb.h~w!make all || exit 1: done: making substitutions...cd ../confmake substs || exit 1: done: making spacefor, queuelen, etc....rm -f spacefor queuelen hostname setnewsidsmake spacefor.null || exit 1cp spacefor.null spaceformake queuelen.null || exit 1cp queuelen.null queuelenecho 'echo blars.la.ca.us' >hostname: done: making library...touch ../ranlibed ; sleep 2for dir in libv7 libbig libc libcnews  dbzdo	cd ../$dir	make u COPTS='-t=/r0' LDFLAGS='-i' POST='/h0/blarslib/blarslib.l' || exit 1donecd ../libfakeed - Makefile <<'!'/NEEDED =/s/.*/NEEDED =  fsync.o strchr.o strrchr.o strpbrk.o strspn.o strcspn.o strtok.o symlink.o/w!make u COPTS='-t=/r0' LDFLAGS='-i' POST='/h0/blarslib/blarslib.l' || exit 1cd ../confmake ../ranlibed || exit 1: library done: building programscd ../confmake setnewsids NEWSUSER=news NEWSGROUP=news COPTS='-t=/r0' LDFLAGS='-i' POST='/h0/blarslib/blarslib.l' || exit 1for dir in conf batch expire input relay misc rnado	cd ../$dir	make all DBM= COPTS='-t=/r0' LDFLAGS='-i' POST='/h0/blarslib/blarslib.l' || exit 1done: done: building prototype control filescd ../confrm -f active errlog history history.pag history.dir localgroups log mailname mailpaths organization postdefltdist postdefltgroup replyusepath server sys whoamicp config.proto configecho 'blars.la.ca.us' >mailnamecat <<'!' >organizationDis!echo 'blars.la.ca.us' >whoamiecho 'general 0000000000 0000000001 y' >activeecho 'news.announce.newusers 0000000000 0000000001 y' >>activeecho 'control 0000000000 0000000001 y' >>activeecho 'junk 0000000000 0000000001 y' >>active>errlog>history>history.pag>history.direcho 'general	general local news' >localgroups>logecho 'all	uunet!%s' >mailpathscp sys.proto syscd ../expiremake explists && cp explist.no explistcd ../confcat >cron <<'!'15 *	1-31 *	0-6	su news -c '/h1/Lib/Newsbin/input/newsrun'30 8	1-31 *	1-5	su news -c '/h1/Lib/Newsbin/input/newsrunning off'00 17	1-31 *	1-5	su news -c '/h1/Lib/Newsbin/input/newsrunning on'40 *	1-31 *	0-6	su news -c '/h1/Lib/Newsbin/batch/sendbatches'59 0	1-31 *	0-6	su news -c '/h1/Lib/Newsbin/expire/doexpire '10 8	1-31 *	0-6	su news -c '/h1/Lib/Newsbin/maint/newsdaily'00 5,13,21	1-31 *	0-6	su news -c '/h1/Lib/Newsbin/maint/newswatch'!echo 'su news -c /h1/Lib/Newsbin/maint/newsboot' >rc: donecase "$1" in-*i*)	exit 0	;;esac: installing programsfor dir in conf batch expire input relay misc rnado	cd ../$dir	make bininstall BIN=/h0/Cmds RBIN=/h0/Cmds DBM= || exit 1done: done: installing manual pagescd ../mancp inews.1 /h0/Doc/man1/inews.1cp postnews.1 /h0/Doc/man1/postnews.1cp active.times.5 /h0/Doc/man5/active.times.5cp news.5 /h0/Doc/man5/news.5cp expire.8 /h0/Doc/man8/expire.8cp newsaux.8 /h0/Doc/man8/newsaux.8cp newsbatch.8 /h0/Doc/man8/newsbatch.8cp newsmail.8 /h0/Doc/man8/newsmail.8cp newsmaint.8 /h0/Doc/man8/newsmaint.8cp relaynews.8 /h0/Doc/man8/relaynews.8cp rnews.8 /h0/Doc/man8/rnews.8: done