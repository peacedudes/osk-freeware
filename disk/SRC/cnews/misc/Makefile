  $(CC) $(NHCFLAGS) $(LDFLAGS) newshist.r $(RNEWSOBJS) $(PRE) $(POST) -fd=$@  attr -e $@$(NEWSBIN)/maint/newsdaily: newsdaily.r $(LIBS)  $(CC) $(NHCFLAGS) $(LDFLAGS) newsdaily.r $(PRE) $(POST) -fd=$@  attr -e $@newshist.r:  newshist.c  $(CC) $(NHCFLAGS) -r newshist.c$(RNEWSOBJS): $(RNEWSSRCS)  chd $(RN) ; $(CC) $(RNCFLAGS) -r $*.caddgroup.r: addgroup.cnewsdaily.r: newsdaily.c