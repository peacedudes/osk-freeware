# libcnews makefile# modified for os9/68k by BlarsonINCLUDE=../includeDEFINES=-v=$(INCLUDE) -v=/h0/blarslib/defsCOPTS= -t=/r0CFLAGS= $(COPTS) $(DEFINES)LIB=../libcnews.lSRCS=complain.c config.c fopenclex.c hostname.c \ lock.c ltoza.c ngmatch.c readline.c \ string.c strlower.c strsave.c str3save.c time.c case.c# order changed for dumb osk linker (order is critical!)OBJS = complain.r gethdr.r \  ngmatch.r string.r hostname.r strlower.r config.r \  time.r ltoza.r \  case.r fopenclex.rlib_cnews.l:  $(OBJS)  merge $(OBJS) >-$@all:  $(OBJS)# header dependencies for libcnews.lconfig.r: $(INCLUDE)/news.h $(INCLUDE)/config.h config.c lock.c strsave.c str3save.c nemalloc.cngmatch.r: $(INCLUDE)/news.htime.r: $(INCLUDE)/news.h# ltoza.r: $(INCLUDE)/stdlib.h  # trouble if stdlib.h is system one, not ours