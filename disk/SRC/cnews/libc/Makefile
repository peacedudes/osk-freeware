# C news local libc makefile - added by Ian Darwin# modified for os9/68k by blarsINCLUDE=../includeDEFINES=-v=$(INCLUDE) -v=/h0/blarslib/defsCOPTS=-t=/r0CFLAGS=$(COPTS) $(DEFINES)SRCS=closeall.c efopen.c error.c fgetmfs.c \  nfclose.c \  standard.c stdfdopen.c warning.c emalloc.cOBJS = efopen.r fgetmfs.r getdate.r nfclose.r \  standard.r stdfdopen.r emalloc.r closeall.r error.r warning.rlib_c.l: getdate.c $(OBJS)  merge $(OBJS) >-$@all:  $(OBJS)getdate.c: getdate.y  bison getdate.y  touch getdate.c  del getdate.c  rename getdate.tab.c getdate.c