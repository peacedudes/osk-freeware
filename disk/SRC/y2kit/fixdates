#!/cmds/sh# script to fix year errors on files and directories# second version#fyopts="-l"# function to do the workfixfile()    {    # exit on blank file names    if [ -z $1 ]; then        return    fi    if [ -d $1 ]; then        echo Fixing $1        cd $1        for i in `ls -u`        do            fixfile $i        done        cd ..        fixyear $1 $fyopts    else        fixyear $1 $fyopts    fi    }## The program itself#echo "Fix Date Utility"echoecho This program will check and fix the date on the files inecho the current directories and all directories under it.echoecho  The present directory is $PWDechoecho -r "To change the base directory, enter its name: "read newdirechotmode nopauseif [ -n $newdir ]; then    cd $newdirfiecho You are now in $PWD.while(true)do    echo Contents of $PWD:    ls    echo    echo -r "Name of directory or file to fix: "    read i    if [ -z $i ]; then        echo No target entered        exit 0    else        fixfile $i    fidoneexit (0)