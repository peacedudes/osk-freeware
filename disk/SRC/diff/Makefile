refix)$(bindir)/diff3$(prefix)$(bindir)/diff3: diff3	install diff3 $(prefix)$(bindir)/diff3diff.tar: $(tapefiles)	mkdir tmp	mkdir tmp/diff	ln $(tapefiles) tmp/diff	cd tmp; tar cf ../diff.tar diff	rm -rf tmpdiff.tar.Z: diff.tar	compress < diff.tar > diff.tar.Z