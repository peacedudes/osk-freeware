* Makefile to compile STERM Version 2.0 (Ultra-C)VER     = 2.0CC      = cc -mode=uccTMP     = /R0DD      = /DDLIB     = -l=termlib.l -l=sys_clib.l -l=clib.l -l=os_lib.l# CPU     = 68kCPU     = 386MEMOPT  = -olM=DFLAGS = -x=aoio# CFLAGS = -i -d_OSK -d_UCC -td=/r0 $(DFLAGS)CFLAGS  = -i -d_386 -d_UCC -td=/r0 $(DFLAGS)CSTART  =ODIR    = $(DD)/CMDSRDIR    = RELSLFLAGS = $(CFLAGS) -gRFILES = sterm.r io.r bplus.r crc.r xmodem.r getopt.rSterm: $(RFILES)    chd $(RDIR); \    $(CC) -f=$(ODIR)/STerm $(LFLAGS) $(CSTART) $(RFILES) $(LIB) $(MEMOPT)4ksterm.r: sterm.c sterm.h common.hio.r: io.c io.h common.hbplus.r: bplus.c bplus.h common.hcrc.r: crc.cxmodem.r: xmodem.c xmodem.h common.hgetopt.r: getopt.c getopt.h