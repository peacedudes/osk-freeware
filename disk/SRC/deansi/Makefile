## Take an ansi programme, and prepare it for a K&R1 compiler.# No attempt is made to deal with preprocessor differences,# but some keywords are deleted (volatile, const), and declarations# are modified to be acceptable#CFLAGS = -g#deansi : deansi.o        cc -o deansi deansi.o -ll        @- rm -f deansi.o#tidy :        rm -f *~ deansi.c *.o core a.outempty : tidy        rm -f deansi