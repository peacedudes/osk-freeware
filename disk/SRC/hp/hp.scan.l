%{/* hp.scan.l --- lex scanner for hp calculator */#include "y.tab.h"#ifdef OSK/* The parser reads each number straight out of line[], at the place   hp.c's reader has reached, so flex must take the characters from that   reader one at a time; lex called input() and unput() instead. */extern int hp_input();#undef YY_INPUT#define YY_INPUT(buf,result,max_size) \	{ int c = hp_input(); if (c) { buf[0] = c; result = 1; } else result = YY_NULL; }#else#undef input#undef unput#endif%}%%"."	return (DOT);[0-9]	return (DIGIT);"P"	return (BIGP);"p"	return (LITTLEP);"+"	return (PLUS);"-"	return (MINUS);[Xx*]	return (STAR);"/"	return (SLASH);"%"	return (PERCENT);[:^]	return (POW);"&"	return (AND);"|"	return (OR);"!"	return (NOT);"="	return (EQ);"<"	return (LT);">"	return (GT);"<="	return (LE);">="	return (GE);"D"	return (BIGD);"d"	return (LITTLED);[Qq]	return (QUIT);[ \t\n]	;.	fprintf(stderr, "%s: unknown command.\n", yytext);