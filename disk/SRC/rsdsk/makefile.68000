# Makefile to compile rsdsk# Copyright (c) 1995 by Bob DevriesCC = ccODIR    = /r0RDIR	= ../RELSSDIR    = .CFLAGS  = -t=/r0 RFILES	= rsdsk.r rsdir.r get_len.r get_fat.r get_sector.r rsreaddir.r \usage.r rscopy.r gran2trksec.r rsproc.rrsdsk: $(RFILES)	chd $(RDIR); l68 /dd/lib/cstart.r $(RFILES) -o=/r0/rsdsk \    -l=/h0/lib/clib.l -l=/h0/lib/sys.l   copy -r /r0/rsdsk ../CMDS/rsdsk.68000# Dependenciesrsdsk.r: rsdsk.c rsdir.h       $(CC) $(CFLAGS) -r=$(RDIR) rsdsk.crsdir.r: rsdir.c rsdir.h       $(CC) $(CFLAGS) -r=$(RDIR) rsdir.cget_len.r: get_len.c       $(CC) $(CFLAGS) -r=$(RDIR) get_len.cget_fat.r: get_fat.c       $(CC) $(CFLAGS) -r=$(RDIR) get_fat.cget_sector.r: get_sector.c       $(CC) $(CFLAGS) -r=$(RDIR) get_sector.crsreaddir.r: rsreaddir.c rsdir.h       $(CC) $(CFLAGS) -r=$(RDIR) rsreaddir.cusage.r: usage.c       $(CC) $(CFLAGS) -r=$(RDIR) usage.crscopy.r: rscopy.c rsdir.h       $(CC) $(CFLAGS) -r=$(RDIR) rscopy.cgran2trksec.r: gran2trksec.c       $(CC) $(CFLAGS) -r=$(RDIR) gran2trksec.crsproc.r: rsproc.c rsdir.h       $(CC) $(CFLAGS) -r=$(RDIR) rsproc.c# EOF makefile