/* lpq fuer os-9/68k         Uwe Simon  4.9.1987 */#include <stdio.h>#include <module.h>#include <pwd.h>#include "lp.h"mod_exec *module;int copies,tmpfile,mesg;char filename[100],dev[32];error(){	fprintf(stderr,"Syntax: lpq [-p=dev] [user]\n");	fprintf(stderr,"Function: shows spoolerqueue\n");	fprintf(stderr,"Options:\n");		fprintf(stderr,"       -d=dev     shows queue of printer dev\n");}main(argc,argv)int argc;char **argv;{	int user,i,jo,ev;	struct passwd *pwd;	char dev[32],fi[100],*username;	long int group,uid;	dev[0]='\0'; user=-1; jo=0;	while(--argc) {		argv++;		if(strcmp(*argv,"-?")==0) {error(); exit(0);}		else if(strncmp(*argv,"-d=",3)==0) strcpy(dev,*argv+3);		else user=atoi(*argv);	}			module=(mod_exec *)modlink("spoolqueue",0x400);	if((int)module==-1) { exit(_errmsg(1,"no spooler installed\n")); }	queue=(struct spoolqueue *)((long)module+module->_mexec);	if(!queue->active) printf("Spooler is not active\n");	ev=_ev_link("spoolqueue");	printf("Defaultprinter: %s\n",queue->printer[0]);	printf("other Printers: ");	for(i=1;i<8;i++) printf("%s  ",queue->printer[i]);	printf("\n");	_ev_wait(ev,0,0);	if(queue->spoolfiles) {			printf("%d Spoolfiles\n",queue->spoolfiles);				printf("  Id         User      St  #   Printer   Size   File\n");		printf("------ --------------- -- ---- -------- ------  ----\n");	    for(i=0;i<queue->spoolfiles;i++) {	    	group=queue->jobs[i].user;	    	uid=group&0xffff;	    	if((user>=0)==(user==uid)){	    		if((dev[0]>'\0')==(strcmp(dev,queue->printer[queue->jobs[i].dev][0])=='\0')){	    			group>>=16; jo++;	    			pwd=getpwuid(uid);	    			if(pwd==NULL) username="???";	    			else username=pwd->pw_name;					strcpy(fi,queue->jobs[i].titel);  					printf("%6d  %-15s %1c  %3d %-8s %6d  %s\n",queue->jobs[i].spoolid,   						username,queue->jobs[i].status,queue->jobs[i].copy,		    			queue->printer[queue->jobs[i].dev],queue->jobs[i].size,fi);   				}   			}    	}		if(!jo){			if(user==-1)				printf("No Spooljobs for printer %s\n",dev);			else printf("No Spooljobs for user %d\n",user);		}	}    		else printf("Spoolerqueue is empty\n");		_ev_signal(ev,0);	_ev_unlink(ev);	munlink(module);}