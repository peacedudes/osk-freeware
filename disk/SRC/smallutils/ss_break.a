********************* Stacked parameter defs*   Arguments from 'C' beyond 2 are passed on the stack*   and hence the definitions below.  *     usage:  move.b arg3+params(a5),d0*params equ 8 offset from a5 to stacked parametersarg3 set 0arg4 set 4arg5 set 8arg6 set 12arg7 set 16**  _ss_break()****     'C' bindings for SS_Break setstat****  Function: _ss_break - send break on serial line via SS_Break setstat***          int _ss_break( path )*          int path;  /* path number to the device as returned by open() */**  Returns:  0 if all went well*           -1 on error, errno set to error number from driver**  Description:*  Attempts to do a SetStt of SS_Break on the specified path. Returns -1*  if an error occurs. *  Caveats:*               Garbage in.... Garbage (possibly crash) out*        psect _ss_break,0,0,0,0,0        _ss_break: link a5,#0   set stack frame (for symbolic debuggers, ect.. ) move.l a0,-(sp) move.l d1,a0 the command pointer move.l #SS_Break,d1 SS_Break code os9 I$SetStt  bcs.s _ss_breakerr clr.l d0 return all ok  bra.s _ss_breakex_ss_breakerr move.l #-1,d0 set error flag for return move.l d1,errno(a6) set errno to value from driver_ss_breakex move.l (sp)+,a0 unlk a5 rts   ends