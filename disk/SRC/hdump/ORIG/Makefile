## Generic UNIX makefile for dump#CC      = ccOFILE1	= hdumpOFILE2	= undumpSRCS    = od.c cnv.c cnv.h undump.cOBJS    = od.o cnv.oOBJS2   = undump.oRM	    = rm -fINSTDIR = /usr/local/bin.c.o	  :	$(CC) -c $*.c -o $*.oall       : $(OFILE1) $(OFILE2)	@echo ""$(OFILE1) : $(OBJS)	$(CC) $(OBJS) -o $@$(OFILE2) : $(OBJS2)	$(CC) $(OBJS2) -o $@	clean	  :	$(RM) $(OBJS) $(OBJS2) $(OFILE1) $(OFILE2) core *~ a.outinstall	  : $(OFILE1) $(OFILE2)	install -g bin -m 755 -s $(OFILE1) $(INSTDIR)	install -g bin -m 755 -s $(OFILE2) $(INSTDIR)od.o	  : cnv.h od.ccnv.o	  : cnv.h cnv.cundump.o  : undump.c