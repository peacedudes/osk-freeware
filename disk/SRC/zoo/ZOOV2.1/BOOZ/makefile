#Make Booz -- makefile for **IX.  Rename to `makefile' before use.## OSK adaption 22 Jul 91 	- hcz# Edit here to reflect your standard DEFS/LIB/TEMP directories:CDEF=/r0/DEFSCLIB=/r0/LIBTEMP=/r0/TEMPODIR=/h0/USR/CMDSRDIR=RELSLFLAGS=-giOOZOBJS = addbfcrc.r lzd.r booz.r oozext.r portable.r \	io.r huf.r decode.r maketbl.rCFLAGS = -git=$(TEMP)$(ODIR)/booz : $(OOZOBJS)	chd $(RDIR); cc $(OOZOBJS) -F=$(ODIR)/booz -l=$(CLIB)/os9lib.l $(LFLAGS)# DEPENDENCIES follow# DO NOT DELETE this linebooz.r: $(CDEF)/stdio.h booz.h zoo.hdecode.r: $(CDEF)/stdio.h ar.h booz.h lzh.h zoo.hhuf.r: $(CDEF)/stdio.h ar.h booz.h lzh.h zoo.hio.r: $(CDEF)/stdio.h ar.h booz.h lzh.h zoo.hlzd.r: $(CDEF)/stdio.h booz.hmaketbl.r: $(CDEF)/stdio.h ar.h booz.h lzh.h zoo.hoozext.r: $(CDEF)/stdio.h booz.h zoo.hportable.r: $(CDEF)/stdio.h booz.h zoo.h