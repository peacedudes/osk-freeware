Edit  equ 1Stk   equ $2000StkOf equ $3C use oskdefs.d psect fstart_a,(Prgrm<<8)!Objct,(ReEnt<<8)!0,Edit,Stk,_fstartOs9Nam dc.b "os9lib",0,0  offs set 0                     preset branch table index  goto macro* move.l os9st(a6),-(a7)        for 68000* addi.l #offs,(a7)* rts jmp ([os9st,a6],offs)         for 68020offs set offs+4     endm  _F09: goto_F11: goto_FSV: goto_FRS: goto_SQRT: goto_EXP: goto_ALOG: goto_SIN: goto_COS: goto_TAN: goto_ATAN: gotoMUL_D1: gotoMUL_D2: gotoMUL_D3: gotoMUL_D4: gotoMUL_D5: gotoMUL_D6: gotoMUL_D7: gotoDIV_D1: gotoDIV_D2: gotoDIV_D3: gotoDIV_D4: gotoDIV_D5: gotoDIV_D6: gotoDIV_D7: goto_FSCAN: goto_STROUT: goto_STRIN: goto_PREIO: goto_POSTIO: goto_ITOA: goto_IATOI: goto_FTOA: goto_FATOF: goto_LTOA: goto_LATOI: goto_ARRIO: goto_FILIN: goto_FILOUT: gotoBININP: gotoBINOUT: goto_OPEN: goto_CLOSE: goto_ASSC: goto_XTRC: goto_CONC: goto_CMPC: goto_CDSC: goto_ICAR: gotoICHAD: gotoINDEX: gotoLEN: goto_PRMSG: goto_WTRPLY: gotoRNDM: goto_RREXP: goto_IREXP: goto_RIEXP: goto_IIEXP: goto_ALOG10: gotoACTIVATE: gotoPASSIVATE: goto_INITZ: gotoMESSAGE: gotoICAMAD: gotoREPLY: gotoANTWR: gotoAMOD: gotoISIGN: gotoSIGN: goto_BADPAR: goto_SIZC: gotoRNORM: gotoINT: gotoNINT: gotoDELETE: gotoRENAME: goto_BADSTK: gotoINCHR: gotoOUTCHR: gotoEV_CREAT: gotoEV_DELET: gotoEV_READ: gotoEV_WAIT: gotoEV_SIGNL: gotoEV_LINK: gotoEV_UNLNK: gotoEV_SET: gotoEV_PULSE: gotoF_SLEEP: gotoF_SEND: gotoF_STIME: gotoF_TIME: gotoI_WRITE: gotoI_READ: gotoF_PERR: gotoF_FORK: gotoF_WAIT: gotoF_ID: gotoF_GPRDSC: goto_COMAL: gotoF_ICPT: gotoI_SSIG: gotoNUMPATH: gotoSHELL: gotoMEMALL: goto_fstart: clr.w  d0                       link to OS9LIB module lea    Os9Nam(pc),a0 os9    F$Link bcc.s  _found                   ..module found clr.w  d0 lea    Os9Nam(pc),a0 os9    F$Load                   try to load it bcs.s  _exod1                   ..not found_found: move.l a1,os9st(a6)      save entry point lea    _exod(pc),a4             address of return to OS9 move.l a4,_EXODOS(a6)           ... to global defined in OS9LIB move.l #$400,_LOWRAM(a6)        set lower memory limit move.l #$FFFFFF,_IUPRAM(a6)     set upper memory limit clr.l  _VECBAS(a6)              set vector base address suba.l StkOf(a3),a5 move.l a5,_STKLIM(a6)           set lower stack limit movea.l #-1,a5                  break for traceback lea    main_f(pc),a4            go to RTF user program jmp    (a4)_exod  clr.w d0 lea Os9Nam(pc),a0 os9 F$UnLoad clr.l d1_exod1 os9 F$Exit                terminate program VSECTCOMAD DS.B 128 ENDS VSECTCOMSZ DS.B 128 ENDS VSECTCOMNM DS.B 512 ENDS VSECTLUPATH DS.B 356 ENDS VSECTIPOT DS.B 40 ENDS VSECTWORKSP DS.B 32 ENDS VSECTSTKLIM DS.B 4 ENDS VSECTVECBAS DS.B 4 ENDS VSECTIUPRAM DS.B 4 ENDS VSECTLOWRAM DS.B 4 ENDS VSECTEXODOS DS.B 4 ENDS vsectos9st ds.l 1                   storage for lib entry point ends  _EXODOS: EQU EXODOS_LOWRAM: EQU LOWRAM_IUPRAM: EQU IUPRAM_VECBAS: EQU VECBAS_STKLIM: EQU STKLIM ends end