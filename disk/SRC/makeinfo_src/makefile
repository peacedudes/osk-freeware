# Make two programs used in generating output from texinfo.CFLAGS = -O=2 -t=/r0CC=ccRDIR=RELSLDFLAGS = $(CFLAGS) -l=/dd/lib/os9lib.ltexindex: texindex.r	chd $(RDIR);$(CC) -fd=../$* $(LDFLAGS) $(CFLAGS) $*.rtexindex.r: texindex.cMAKEINFO_MAJOR = 1MAKEINFO_MINOR = 0MAKEINFO_FLAGS = -DMAKEINFO_MAJOR=$(MAKEINFO_MAJOR) -DMAKEINFO_MINOR=$(MAKEINFO_MINOR)makeinfo: makeinfo.r getopt.r getopt1.r	chd $(RDIR);$(CC) $(LDFLAGS) -fd=../makeinfo makeinfo.r getopt.r getopt1.r