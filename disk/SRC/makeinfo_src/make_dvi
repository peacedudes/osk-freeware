#!/bin/csh -f# 1: LaTeX 1 + texindex 1# 2: LaTeX 2 + texindex 2# 3: LaTeX 3# 4: dviselect# 5: dvi2ttyif	($#argv  <  1)    then	echo	"Usage:  make-dvi <document> [<step>]"	exit	1endifset	root	= $1set	texSrc	= $root.texiset	index	= /lrzsw1/GNU/texindex \	tex	= (btex $texSrc)if	($#argv  >  1)    goto S-$2S-1:echo	'###############\## Schritt 1 ##\###############\'$tex	< /dev/nullecho	$index $root.??$index	$root.??if	(-e stop)    exit 0S-2:echo	'\\###############\## Schritt 2 ##\###############\'$tex	< /dev/nullecho	$index $root.??$index	$root.??if	(-e stop)    exit 0S-3:echo	'\\###############\## Schritt 3 ##\###############\'$tex	< /dev/nullS-4:echo	'\\###############\## Schritt 4 ##\###############\'dviselect :0 $root.dvi Index.dviS-5:echo	'\\###############\## Schritt 5 ##\###############\'dvi2tty	-w 132 Index.dvi \| sed	-e '1d;/^   /d;/^/d;/^ *$/d' \	-e 's,:,.,g;s,^\([0-9][0-9]*\)   ,\1,' \	-e 's,^\([0-9] \), \1,;s,\([^ .]\)\.\.,\1 ..,' \	-e 's,\.\.\([0-9]\),.. \1,;s,\([a-zA-Z] \) ,\1,g'  > Index.txtexit	0