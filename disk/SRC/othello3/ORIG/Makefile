# Simple makefile for othello# pick one of the next two lines. VOIDSIGPTR is used with SysV'ish# systems (e.g. SunOS 4.1)#CFLAGS = -OCFLAGS = -O -DVOIDSIGPTRothello: othello.c	cc -o othello $(CFLAGS) othello.c -lcurses -ltermcap#     If you are running on a Sequent which supports parallel#     processes, use the following to compile othello to run#     in parallel:##	cc -o othello othello.c -lcurses -ltermcap -lpps -DPARALLEL  