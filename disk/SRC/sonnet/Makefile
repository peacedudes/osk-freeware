####  Makefile for sonnet.##  $Header: Makefile,v 2.0 89/02/08 16:29:38 rsalz Release1 $####  Some systems have strchr/strrchr, some have index/rindex.##  If you're the latter, then uncomment the next line.DEFS  = -DUSE_INDEX#DEFS =##  If getopt isn't in your C library, and you can't add it, uncomment##  these two lines.GET_c = getopt.cGET_o = getopt.r##  On some systems, curses is just part of terminfo or termlib.#LIBS  = -lterminfoLIBS   = -l=/dd/lib/curses.l -l=/dd/lib/termlib.l\		-l=/dd/lib/rand.r -l=/dd/lib/math.l##  If you don't want to check the code against the library use for lint,##  edit this line#LLIBS  = $(LIBS)##  If you add to the database, put the words here.#LEXERS        = lex.data lex.bbnLEXERS = lex.data####  END OF CONFIG SECTION##RDIR   = RELSODIR   = /h0/cmds/dogCFLAGS = -qm=4k $(DEFS)LFLAGS = -qSOURCES	= sonnet.c compose.c $(GET_c)OBJECTS	= sonnet.r compose.r $(GET_o)sonnet:	$(OBJECTS)	chd $(RDIR); cc $(CFLAGS) -f=sonnet $(OBJECTS) $(LIBS)$(OBJECTS):	sonnet.hcompose.r:	lex.ilex.i:		lex.data makelex 	makelex $(LEXERS) >-lex.imakelex:	makelex.r sonnet.hmakelex.r:	makelex.c sonnet.h