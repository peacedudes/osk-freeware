#!/bin/make -f# pathalias -- by steve bellovin, as told to peter honeyman### begin configuration section#### if you can't or don't intend to use dbm files,# don't bother with DBM or makedb# DBM = -ldbm# or if you roll your own ...DBM = dbm.r# or if it's in your lib :)# DBM 	=#### where is getopt (if not in the c library)?GETOPT = getopt.r#### internet domain name resolver library# enable RESOLVER in config.h# RESOLVER = -lresolv# or if disabledRESOLVER =### end of configuration section CD 		= chdMV 		= copy -rRM 		= delTEMP 	= /r0MEM 	= 24kEDTN    = 11# Debug on#DBG     = -g# Debug offDBG     =# if you want to link using 'cio' or 'csl'TRAPLIB = -i# no traplib#TRAPLIB =# Stock Microware CCC      = ccCDEFS   =COPTS   = -qt=$(TEMP) -sRFLAG   = -rSTICKY  = -bgLOPTS   = $(STICKY) $(TRAPLIB) -e=$(EDTN) -M=$(MEM)# Ultra C#CC      = ucc#CDEFS   =#COPTS   = -bc -td=$(TEMP) -r#RFLAG   = -eas#STICKY  = -ol=S#LOPTS   = -bc $(STICKY) $(TRAPLIB) -ol=e=$(EDTN) -ol=M=$(MEM)CHDRS   = -v=HDRSLIBS 	=#CHDRS 	= -v=/dd/SYS/UNIX#LIBS 	= -l=/dd/lib/unix.lCFLAGS  = $(COPTS) $(CDEFS) $(CHDRS) $(DBG)LFLAGS  = $(LOPTS) $(LIBS) $(DBG)LDFLAGS = $(DBM) $(GETOPT) $(LFLAGS)YACC 	= bisonYFLAGS 	= -dyYYDEBUG = 0ODIR 	= BINRDIR 	= RELSBINDIR 	= /DD/ETC/CMDSOSKLIB  = alloca.r bcmp.r gethname.r popen.r stat.r getopt.r dbm.rOSKSRC  = OSK/alloca.c OSK/bcmp.c OSK/dbm.c OSK/gethname.c \          OSK/getopt.c OSK/popen.c OSK/stat.c OSK/getopt.c OSK/dbm.cOBJ		= addlink.r addnode.r domain.r local.r main.r mapit.r mapaux.r mem.r \          parse.r printit.r $(OSKLIB)HDRS 	= def.h config.hCSRC 	= addlink.c addnode.c domain.c local.c main.c mapit.c mapaux.c mem.c \          printit.c $(OSKSRC)LSRC 	= $(CSRC) parse.cSRC 	= $(CSRC) parse.y makedb.cMAN 	= pathalias.8TEXT 	= Make.honey Makefile.unix Makefile.osk Make.paths.osk \          README CHANGES Readme.OSKOFILES 	= pathalias makedb.c.r :   $(CC) $(CFLAGS) $*.c $(RFLAG)=$(RDIR)pathalias: lib.date parse.c $(OBJ)	$(CD) $(RDIR) ; $(CC) $(OBJ) $(LDFLAGS) -fd=../$(ODIR)/pathalias    attr $(ODIR)/$@ -epelib.date : $(OSKLIB)    touch lib.dateall: parse.c $(OFILES)$(OBJ):	$(HDRS)parse.c: parse.y $(HDRS)	$(YACC) $(YFLAGS) parse.y    @echo '\23define YYDEBUG 0' >-parse.c    @echo -r '\2f\5e\\\23line\2fd\0ds\2fyydebug = 0\2fyydebug = $(YYDEBUG)\2f' >-_sed.cmd    @sed -f _sed.cmd y.tab.c >+parse.c    @del _sed.cmd#    @sed -e '/^\# line/d' -e 's/yydebug = 0/yydebug = $(YYDEBUG)/' y.tab.c >+parse.c)makedb: makedb.r $(OSKLIB)	$(CD) $(RDIR) ; $(CC) makedb.r $(LDFLAGS) -fd=../$(ODIR)/makedb    attr $(ODIR)/$@ -epemakedb.r: config.hclean:	$(CD) $(RDIR) ; $(RM) *.r	$(RM) y.tab.? parse.cclobber: clean	$(CD) $(ODIR) ; $(RM) $(OFILES)tags: $(SRC) $(HDRS)	ctags -w $(HDRS) $(SRC)bundle:	lha -u palias10.lzh $(TEXT) $(MAN) $(HDRS) $(SRC)    $(RM) palias10.bakshar:    shar $(TEXT) $(MAN) $(HDRS) $(SRC) ! compress >-palias10.sh.Zlint:	$(LSRC)	lint $(CFLAGS) $(LSRC)	lint makedb.c	lint arpatxt.cinstall:    $(CD) $(ODIR) ; $(MV) $(OFILES) -w=$(BINDIR)	@echo "installed pathalias, makedb"	@echo "install pathalias.8 according to local conventions"    @echo Done#  Leave in this linedbm.r       : OSK/dbm.cgetopt.r    : OSK/getopt.calloca.r    : OSK/alloca.cbcmp.r      : OSK/bcmp.cgethname.r  : OSK/gethname.cpopen.r     : OSK/popen.cstat.r      : OSK/stat.cosk.r       : osk.c