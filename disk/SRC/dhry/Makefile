###FILES = dhry dhryO2 dhryGcc dhryGcco2 dhryGccin dhryGccmx dhryshamu \	dhryGcc2 dhryGcc2o2 dhryGcc2in dhryGcc2mx dhryshamu2CC = ccGCC = gcc -cioGCC2 = gcc2 -cioall: $(FILES)dhry:	$(CC) -O -r dhry_p1.c	$(CC) -O -r dhry_p2.c	$(CC) -fd=$@ dhry_p1.r dhry_p2.r	load -d $@	$@	unlink $@dhryO2:	$(CC) -r dhry_p1.c	$(CC) -r dhry_p2.c	$(CC) -fd=$@ dhry_p1.r dhry_p2.r	load -d $@	$@	unlink $@dhryGcc:	$(GCC) -O -c dhry_p1.c	$(GCC) -O -c dhry_p2.c	$(GCC) -o $@ dhry_p1.r dhry_p2.r	load -d $@	$@	unlink $@dhryGcco2:	$(GCC) -O2 -c dhry_p1.c	$(GCC) -O2 -c dhry_p2.c	$(GCC) -o $@ dhry_p1.r dhry_p2.r	load -d $@	$@	unlink $@dhryGccin:	$(GCC) -O -finline-functions -c dhry_p1.c	$(GCC) -O -finline-functions -c dhry_p2.c	$(GCC) -o $@ dhry_p1.r dhry_p2.r	load -d $@	$@	unlink $@dhryGccmx:	$(GCC) -O -finline-functions -fstrength-reduce -fomit-frame-pointer \	-fforce-mem -c dhry_p1.c	$(GCC) -O -finline-functions -fstrength-reduce -fomit-frame-pointer \	-fforce-mem -c dhry_p2.c	$(GCC) -o $@ dhry_p1.r dhry_p2.r	load -d $@	$@	unlink $@dhryshamu:	$(GCC) -cio -O2 -finline-functions -fstrength-reduce -fomit-frame-pointer \	-fforce-mem -c dhry_p1.c	$(GCC) -cio -O2 -finline-functions -fstrength-reduce -fomit-frame-pointer \	-fforce-mem -c dhry_p2.c	$(GCC) -cio -o $@ dhry_p1.r dhry_p2.r	load -d $@	$@	unlink $@dhryGcc2:	$(GCC2) -O -c dhry_p1.c	$(GCC2) -O -c dhry_p2.c	$(GCC2) -o $@ dhry_p1.r dhry_p2.r -oldlibs	load -d $@	$@	unlink $@dhryGcc2o2:	$(GCC) -O2 -c dhry_p1.c	$(GCC) -O2 -c dhry_p2.c	$(GCC) -o $@ dhry_p1.r dhry_p2.r -oldlibs	load -d $@	$@	unlink $@dhryGcc2in:	$(GCC2) -O -finline-functions -c dhry_p1.c	$(GCC2) -O -finline-functions -c dhry_p2.c	$(GCC2) -o $@ dhry_p1.r dhry_p2.r -oldlibs	load -d $@	$@	unlink $@dhryGcc2mx:	$(GCC2) -O -finline-functions -fstrength-reduce -fomit-frame-pointer \	-fforce-mem -c dhry_p1.c	$(GCC2) -O -finline-functions -fstrength-reduce -fomit-frame-pointer \	-fforce-mem -c dhry_p2.c	$(GCC2) -o $@ dhry_p1.r dhry_p2.r -oldlibs	load -d $@	$@	unlink $@dhryshamu2:	$(GCC2) -cio -O2 -finline-functions -fstrength-reduce -fomit-frame-pointer \	-fforce-mem -c dhry_p1.c	$(GCC2) -cio -O2 -finline-functions -fstrength-reduce -fomit-frame-pointer \	-fforce-mem -c dhry_p2.c	$(GCC2) -cio -o $@ dhry_p1.r dhry_p2.r -oldlibs	load -d $@	$@	unlink $@clean:	$(RM) dhry_p1.r dhry_p2.r $(FILES)