#  - un'cpio' this in /usr/src or /usr/local/src or something - doesn't matter.#  - do a 'make install' in the tetrix directory#  - tetrix gets installed in /usr/lbin#  - this will create a high score file in /usr/tmp, so doing it again#    later on will erase high scores for the machine.CFLAGS= -qixt=/r0LFLAGS= -qix -l=/dd/lib/curses.l -l=/dd/lib/termlib.l\			 -l=/dd/lib/rand.r -l=/dd/lib/math.l RDIR= RELSODIR= /h0/cmds/dogRELS= MoveR.r MoveL.r NewP.r AdvanceP.r Rotate.r tet.rINCS= tet.htetrix: $(RELS) $(INCS)	chd $(RDIR); cc $(RELS) -f=tetrix  $(LFLAGS)$(RELS): $(INCS)