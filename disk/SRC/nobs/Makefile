#	Makefile for nobs.#	G. L. Sicherman (ihnp4!odyssey!gls).  March 1988.#-------# Configurable parameters:#BINDEST=$$HOME/bin/nobs#MANDEST=$$HOME/man/nobs.6BINDEST=$$HOMEMANDEST=$$HOME# Define BSD for Berkeley, Sun, etc.BSDFLAG= -DBSD#BSDFLAG= -UBSD# If BSD, we need libtermcap.LIB= -lcurses -ltermcap#LIB= -lcurses# End of configurable parameters.  Good luck!CFLAGS= -O $(BSDFLAG)OBJS = nobs.o logglobs.o window.o gamescore.o deal.o shuf.o play.o human.o \   pegs.o program.o playscore.o show.o progaux.o logaux.o wglobs.o globs.o \   version.oSHARS = nobs.c logglobs.c window.c gamescore.c deal.c shuf.c play.c human.c \   pegs.c program.c playscore.c show.c progaux.c logaux.c wglobs.c \   globs.c version.c defs.h globs.h logglobs.h window.h nobs.6 Makefile READMEall: nobsnobs: $(OBJS)	cc -o nobs $(OBJS) $(LIB)$(OBJS): defs.h globs.hlog.o progaux.o program.o: logglobs.hplay.o program.o human.o gamescore.o pegs.o window.o show.o: window.hinstall: nobs nobs.6	rm -f $(BINDEST) $(MANDEST)	cp nobs $(BINDEST)	cp nobs.6 $(MANDEST)shar: nobs.sharnobs.shar: $(SHARS)	shar $(SHARS) > $@clean:	rm -f nobs *.o nobs.shar