# PD Bourne/Korn Shell# for use with the OSK version of dmake# Directories. Note that CLIB, CDEF and TEMP are taken from# the environment if present, else the default values below# are used#SHNAME=     ksh1#DEBUG =     -g#RDIR =      DRELSSHNAME=    kshDEBUG =RDIR=      RELSOSK=../OSKSTD=../std.IMPORT: CLIB TEMP CDEFCLIB *= /dd/LIBTEMP *= /ddCDEF *= /dd/LIB# Default place to look for RELS.SOURCE.r: $(RDIR)# Additional FilesXHDRS = $(OSK)/DEFS /h0/DEFSXLIBS = $(CLIB)/os9lib.lCONFIG= -D_SYSV_X_DEFS = -Dopendir=_x_opendir -Dopen=_x_open -Daccess=_x_access\          -Dcreat=_x_creat -DUSE_SIGNAL -DNSIG=255 -DSHELL="$(SHNAME)"\          -DSHELLENV="SHELL=$(SHNAME)"LFLAGS= -xi $(DEBUG) -e=$(shell cat osk_ed)CFLAGS = -xit=$(TEMP) -v={$(XHDRS)} -D_SYSV -DBIT8 $(_X_DEFS) $(DEBUG)# For making the dependency list (if you don't have gcc: don't# matter, you just can't execute 'dmake -u depend')GCCFLAGS = -I{$(XHDRS)} -dSYSV -DBIT8 $(_X_DEFS)HDRS =	sh.h table.h expand.h lex.h tree.h tty.h trace.hFILES =	version main misc syn lex edit emacs vi tree \	exec jobs trap c_sh c_ksh c_test do_ulimit getopts expr history \	var table alloc io eval mail trace # sigactSRCS = {$(FILES)}.cOBJS = {$(FILES)}.r$(SHNAME): $(OBJS) $(XLIBS)  $(OSK)/LIB/osklib.r    # This ist faster if $(TEMP) resides on a ram disk:        merge -b100 $(RDIR)/{$(OBJS)} $(OSK)/LIB/osklib.r   >-$(TEMP)/kshobjs.r	$(CC) $(LFLAGS) -f=$(SHNAME) -n=$(SHNAME) $(TEMP)/kshobjs.r -l=${XLIBS} -m=10    # else try the following version:#	$(CC) $(LFLAGS) -f=$(SHNAME) -n=$(SHNAME) $(RDIR)/{$(OBJS)} -l=${XLIBS} -m=10        attr -pe $(ODIR)/$(SHNAME).PHONY depend:	shell 'gcc -M $(GCCFLAGS) $(SRCS) ! sed s.$(CDEF).$$(CDEF).g  >-dmake.depend'.PHONY compress:    ksh " set -xv; cd ..;\          tmode nopause;\          tar cb 100 - `dir -uard | egrep -v '\..?err|(/|\.r)$$'` | \          compress -c > ../pd_ksh.ed$(shell cat osk_ed).t.Z ".INCLUDE: dmake.depend