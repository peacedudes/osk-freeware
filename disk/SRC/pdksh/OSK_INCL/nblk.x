	/* set up base enviroment */	e.type = E_NONE;	ainit(&e.area);	e.loc = l;	e.savefd = NULL;	e.oenv = NULL;	initctypes();	/* open file streams for fd's 0,1,2 */	fopenshf(0);	fopenshf(1);	fopenshf(2);	/* set up variable and command dictionaries */	newblock();		/* set up global l->vars and l->funs */	tinit(&commands, APERM);	tinit(&builtins, APERM);	tinit(&lexicals, APERM);	tinit(&homedirs, APERM);----------------------------------