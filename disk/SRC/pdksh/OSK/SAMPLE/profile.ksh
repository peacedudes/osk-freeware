print '/h0/SYS/profile.ksh'set -a		# alle folgenden Variablen automatisch exportieren# $ENVENV=				# read upon each invocationENVI=/h0/SYS/envi.ksh		#  - " - , if ksh is interactive only # Network stationsfo=''pr="/n0/Pr"rxf=$fo/n11/rxfhcz=$pr/n12/hcz# devicespp=$fo/ppppt=$fo/pptp=$fo/t7ANALYZER=$fo/t5PRINTER="$p"PRINTERPORT="$pp"MODEM="$pr/m5"EML_PORT=/t6# PathsCDPATH=.:$HOMEAWKPATH=".:../AWK:$HOME/AWK:/h0/AWK"CLIB="/r0/LIB"CDEF="/r0/DEFS"TEMP="/r0/TEMP"GCCDEF=$CDEFGCCLIB=$CLIBTMPDIR=/r0EMACSRC="/r0/SYS/EMACS"IXDEFS=/h1/hcz/IX/DEFSIXLIB=/h1/hcz/IX/LIB#TeXTEX=${TEX=/h1/TEX}TEXFONTS=.:$TEX/FONTS:$TEX/FONTS/TFMTEXFORMATS=.:/r0/TEX:$TEX/FORMATSTEXINPUTS=.:$TEX/INPUTS:$TEX/MACROS:$TEX/STYLESMF=$TEX/MFMFINPUTS=$MF/INPUTSMFBASES=$MF/BASESMFPOOL=$MF/POOL# Pathtypeset +r PATH=".:\$ODIR:/h0/KSHCMDS:/h0/CMDS:/h0/USR/CMDS:/h0/ETC/CMDS:$TEX/TEXCMDS"# Pascal-Extrawurschtvmodul='$vmodul'VModul='$VModul'# ShellSHELL=ksh		#logon schreibt /h0/CMDS/ksh reinRPASS=$USERPS1='fo [$PWD] ${_sh#0}> 'PS2="-> "RCSPATH=/h1/RCS# MailMAIL=$pr/h0/SPOOL/MAIL/$USERif [ $_sh -eq 0 ]then    from $MAILfiset +a