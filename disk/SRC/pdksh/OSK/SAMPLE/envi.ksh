set -o emacsbind ?=down-historybind ?=up-historybind ?=forward-charbind ?=backward-charbind ?=search-historybind S=end-of-historybind ?=beginning-of-historybind ?=end-of-linebind ?=beginning-of-linebind '^L'=redrawbind ?=kill-to-eolbind ?=yankbind ?=yank-popbind ?=completebind ?=eot-or-deleteset -htypeset -r PATHalias mark='. /h0/KSHCMDS/mark; mark' go='. /h0/KSHCMDS/mark; go' \      unmark='. /h0/KSHCMDS/mark; unmark' dm='. /h0/KSHCMDS/dm; dm' \      latex='. /h0/KSHCMDS/latex' calc='le -12 calc'