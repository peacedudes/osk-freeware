* Syntax:** #include <modes.h>** int ssmpermit(size, perm, addr)* u_int addr, size;* short perm;	/* S_IREAD, S_IWRITE */** Zugriff auf beliebigen Speicherbereich erlauben. addr ist der* Bereichsbeginn, size die L?nge (Bytes), mode die Art des* Zugriffs (voller Zugriff: I_READ+I_WRITE).** Der Eigent?mer des Moduls muss Gruppe 0 angeh?ren (sonst Fehler).* * R?ckgabewert: 0: ok*              -1: Fehler, Nummer in errno** Siehe auch: ssmprotect, F$Permit (SSM-Manual).          psect     ssmpermit_a,0,0,0,0,0ssmpermit:          movem.l   d0-d2/d7/a2-a4/a6,-(a7)          os9       F$ID                process Id holen          move.l    d1,d7		group/user sichern          ext.l     d0          asl.l     #2,d0               soviel Bytes aus proc desc blk tab holen          move.l    d0,-(a7)		Anzahl sichern          and.l     #$FFFF,d1           Group number 0 machen          os9       F$SUser          bcs.s     err1          addq.l    #4,d0          os9       F$SRqMem          bcs.s     err1          move.l    d0,(a2)             L?nge merken          move.l    (a7),d1          lea       4(a2),a0          os9       F$GPrDBT          move.l    (a7),d0            Offset holen          move.l    (a0,d0.l),a4        Adresse des Prozessdeskriptors holen          move.l    (a2),d0          os9       F$SRtMem		Ram zurueckgeben          bcs.s     err1          move.w    #D_SPUMem,d0        SSM global data ptr          move.l    #$80000004,d1       size, examination req.          os9       F$SetSys          bcs.s     err1          move.l    d2,a3          move.l    a7,a1		sysglob rausfinden: hierher          suba.l    a0,a0               Quelladresse: 0          moveq.l   #0,d0               Pid          moveq.l   #4,d1               4 Bytes          os9       F$CpyMem            holen          bcs.s     err1          movem.l   (a7)+,a6		sysglob Adr          movem.l   (a7)+,d0/d1         size, perm          move.l    28(a7),a2          os9       F$Permit            Erlaubnis anfordern          bcc.s     PermOk          cmp.w     #E$UnkSvc,d1	kein SSM vorhanden: auch ok          bne.s     errPermOk    move.l    #0,d0		ok melden          move.l    d7,d1          os9       F$SUser          bcs.s     err          movem.l   (a7)+,d2/d7/a2-a4/a6          rtserr1      move.w    d1,6(a7)            Fehlernummer merken          move.l    d7,d1          os9       F$SUser          lea       4(a7),a7          movem.l   (a7)+,d0-d2/d7/a2-a4/a6          move.w    d0,errno+2(a6)          moveq.l   #-1,d0          rtserr       move.l    d1,-(a7)          move.l    d7,d1          os9       F$SUser          movem.l   (a7)+,d1/d2/d7/a2-a4/a6          move.w    d1,errno+2(a6)          moveq.l   #-1,d0          rts          ends