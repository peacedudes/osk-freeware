G=	-gCC=	ccCFLAGS=	-qt=/dd/TMP $G -DREGEXP -DAPPEND_SIG -DMNEWS -DINCSTR \	-DLOCK_INDEX -DRAND_SIGLIBS=	-l=/dd/LIB/8bit.l -l=/dd/LIB/termlib.l -l=/dd/LIB/os9lib.lOBJECTS	=	curses.r art.r group.r mail.r main.r misc.r page.r \		prompt.r screen.r select.r time.r sigs.r/h0/ETC/CMDS/tass: $(OBJECTS)	$(CC) $(CFLAGS) -m=20 -f=$@ $(OBJECTS) $(LIBS)shar:	-mv -f ../tass.shar ../tass.shar-	shar -v [A-Z]* *.[ch] > ../tass.sharart.r:		art.c tass.hcurses.r:	curses.cgroup.r:	group.c tass.hmail.r:		mail.cmain.r:		main.c tass.hmisc.r:		misc.c tass.hpage.r:		page.c tass.hprompt.r:	prompt.c tass.hscreen.r:	screen.c tass.hselect.r:	select.c tass.htime.r:		time.c