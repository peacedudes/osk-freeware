# Makefile for 6809 to 68000 translatorNAME      = xlateRDIR      = /r0ODIR      = objsLDIR      = /dd/libDEFS      = /dd/defsCPDEFS   =  $(NAME).hRFILES    =  $(NAME).r static.rCFLAGS    = -g #-iqx LFLAGS    = -g -n=$(NAME)LIBS      = -l=$(LDIR)/cio.l -l=$(LDIR)/math.l -l=$(LDIR)/clib.l -l=$(LDIR)/sys.l# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # Link it$(NAME) : $(RFILES)  chd $(RDIR);l68 $(LDIR)/cstart.r $(LFLAGS) $(RFILES) $(LIBS) -o=$(NAME)# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # Compile/assemble$(RFILES): $(CPDEFS)