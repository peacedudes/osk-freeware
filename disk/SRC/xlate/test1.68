* TRANSLATION GENERATED IN 68000 MODE VIA TABclock       move.b      moy(a6),d0           * LDA MOY get month            cmp.b       #$13,d0              * CMPA #$13 is it bogus (ie. 83 error has been logged)            beq.s       clocker              * BEQ CLOCKER yes...set up for clock error            bra.s       clocky               * BRA CLOCKY everything is ok...go on*clocker     move.b      #$01,d0              * LDA #$01 temp. force month to be jan.            move.b      d0,moy(a6)           * STA MOY            clr.b       clkded(a6)           * CLR CLKDED            bsr.s       clocky               * BSR CLOCKY run thru julian            move.b      #$13,d0              * LDA #$13            move.b      d0,moy(a6)           * STA MOY reset to bad month            move.b      d0,clkded(a6)        * STA CLKDED reset to dead clock            rts                              * RTS*clocky      move.l      #m10day,a6           * LDU #M10DAY set u-pointer to rtc buffer            move.l      #moy,a0              * LDX #MOY set x-pointer to master clock            move.b      4(a6),d0             * LDA 4,U get 60-cycle timer            sub.b       #$06,d0              * SUBA #$06 has timer accumulated 6 or more counts            bcc.s       update               * BCC UPDATE yes...serve julian clocks            rts                              * RTS NO...JULIAN clock should not be servedupdate      move.b      d0,4(a6)             * STA 4,U yes, store new 60-cycle time            bsr.s       julian               * BSR JULIAN serve julian every 100 ms            bra.s       clock                * BRA CLOCK*julian      move.b      spcnt(a6),d0         * LDA SPCNT test for 3 seconds count for $33 dm            cmp.b       #100,d0              * CMPA #100 counts from 100 to 130 to time off 3 sec            blo.s       jules                * BLO JULES if spcnt<100, disregard counting            cmp.b       #130,d0              * CMPA #130            bhi.s       julio                * BHI JULIO if done, insure spcnt is cleared            addq.b      #1,spcnt(a6)         * INC SPCNT            bra.s       jules                * BRA JULESjulio       clr.b       spcnt(a6)            * CLR SPCNTjules       addq.b      #1,2(a6)             * INC 2,U inc 10/100ms timer (ms10hund)            addq.b      #1,3(a6)             * INC 3,U inc 5/100ms timer (mshund)            move.b      #05,d0               * LDA #05 set up to check 0-5 ctr (mshund)            cmp.b       3(a6),d0             * CMPA 3,U has 500 ms expired?            bne         relok                * LBNE RELOK no get out            clr.b       3(a6)                * CLR 3,U clear 5/100ms timer (mshund)            asl.b       #1,d0                * ASLA            cmp.b       2(a6),d0             * CMPA 2,U has ms10hund counted for 1000 ms?            bne         relok                * LBNE RELOK no, wait for 1000 msec            clr.b       2(a6)                * CLR 2,U yes, clear 10/100ms (1 sec) timer            jsr         addbcd(a6)           * JSR >ADDBCD increment seconds timer (som)            move.b      rvflg(a6),d1         * LDB RVFLG are we in ramval?            bne         relok                * LBNE RELOK yes - skip rest of clock routine            cmp.b       #$60,d0              * CMPA #$60 has 60 secs expired?            blo         relok                * LBLO RELOK no            clr.b       5(a0)                * CLR 5,X yes - restart seconds timer (som)            addq.b      #1,kbdtmr(a6)        * INC KBDTMR inc keyboard timeout timer            lea.l       4(a0),a1             * LEAY 4,X            jsr         addbcd(a6)           * JSR >ADDBCD increment minutes timer (moh)*tstq        cmp.b       #$33,d0              * CMPA #$33 once per hour            bne.s       tstqx                * BNE TSTQX test the insert/eepburn system            move.b      njobs(a6),d1         * LDB NJOBS but only if the system is idle            bne.s       tstqx                * BNE TSTQX            move.l      begptr(a6),a1        * LDY BEGPTR is burn pointer in valid range?            cmp.l       #qbuf,a1             * CMPY #QBUF            blo.s       tstqr                * BLO TSTQR            cmp.l       #endbuf,a1           * CMPY #ENDBUF            bhs.s       tstqr                * BHS TSTQR            move.b      (a1),d1              * LDB ,Y is queue zeroed out?            bne.s       tstqr                * BNE TSTQR            move.l      endptr(a6),a1        * LDY ENDPTR is insert pointer in valid range?            cmp.l       #qbuf,a1             * CMPY #QBUF            blo.s       tstqr                * BLO TSTQR            cmp.l       #endbuf,a1           * CMPY #ENDBUF            bhs.s       tstqr                * BHS TSTQR            cmp.l       begptr(a6),a1        * CMPY BEGPTR            beq.s       tstqx                * BEQ TSTQX all tests valid - go on with clocktstqr       move.b      #$fc,d1              * LDB #$FC system down - reinitialize - - -             move.b      d1,dmkey(a6)         * STB DMKEY set up diag msg            move.l      #qbuf,a1             * LDY #QBUF set default for insert address            move.l      a1,dmregx(a6)        * STY DMREGX            move.l      #tstq,a1             * LDY #TSTQ detection address            move.l      a1,dmaddr(a6)        * STY DMADDR            move.b      memslct+1(a6),d1     * LDB MEMSLCT+1 detection address port value            move.b      d1,dmmprt(a6)        * STB DMMPRT            ifeq        versw                * IFEQ VERSW            move.b      xwrdrec(a6),d1       * LDB XWRDREC execute the diag msg            move.b      d1,xlat(a6)          * STB XLAT            jsr         xlatr(a6)            * JSR >XLATR            else        *                    ELSE            jsr         wrdrec(a6)           * JSR >WRDREC execute the diag msg            endc        *                    ENDC            move.l      #qbuf,a1             * LDY #QBUF reset the pointers            move.l      a1,begptr(a6)        * STY BEGPTR            move.l      a1,endptr(a6)        * STY ENDPTR            clr.b       d1                   * CLRB INSURE entire qbuf is clearedtstq1       move.b      d1,(a1)+             * STB ,Y+            cmp.l       #endbuf,a1           * CMPY #ENDBUF            bne.s       tstq1                * BNE TSTQ1*tstqx       move.b      d0,d1                * TFR A,B continue 1 minute break            and.b       #$0f,d1              * ANDB #$0F isolate minute units            move.b      d1,1(a6)             * STB 1,U save 10-min timer (0-9)            bne         relok                * LBNE RELOK #not on a 10-min break            addq.b      #1,(a6)              * INC ,U inc 10-minute/day counter (hex)            clr.b       aclner(a6)           * CLR ACLNER clear ac line error counter once every 10 minhrbk        cmp.b       #$60,d0              * CMPA #$60 are we at hour break (60 min)?            blo         relok                * LBLO RELOK no,            clr.b       4(a0)                * CLR 4,X yes - clear the minutes timer (moh)            move.b      #1,d0                * LDA #1            move.b      d0,vector(a6)        * STA VECTOR enable prom chksum test in main            add.b       3(a0),d0             * ADDA 3,X inc hr timer (hod)            fail No 68000 equivalent             daa         *                    DAA RETAIN decimal format            move.b      d0,3(a0)             * STA 3,X and save it...**    test for any change in diag message buffer...*            move.b      dmvec(a6),d0         * LDA DMVEC wrdrec active during the last hour?            or.b        #$20,d0              * ORA #$20 if yes, force a burn insertion of dmsg            move.b      d0,dmvec(a6)         * STA DMVEC********************************************************************    is a change in hod needed for daylight savings time?*hrbk1       bsr.s       dsttst               * BSR DSTTST correct master clock if needed            jmp         clrh(a6)             * JMP >CLRH**    subroutine: test for a change needed for daylite time *         (also called in executive)dsttst      movem.l     d0/d1/a0,-(a7)       * PSHS A,B,X SAVE INCOMING REGISTERS            move.b      clkded(a6),d0        * LDA CLKDED is master clock active?            cmp.b       #$13,d0              * CMPA #$13            beq.s       dstrts               * BEQ DSTRTS if not, skip dst software            move.b      dst(a6),d1           * LDB DST            bne.s       ckdst                * BNE CKDST if cleared, then dst never set updstnew      jsr         lddst(a6)            * JSR >LDDST load default values             bra.s       dstdon               * BRA DSTDON and go set up to burn it            fail Tested register contents altered ckdst       and.b       #$40,d1              * BITB #$40            beq.s       ckdste               * BEQ CKDSTE go - no change needed            move.l      #moy,a0              * LDX #MOY restore pointer to master clock            move.b      6(a0),d1             * LDB 6,X check if past sunday (had powerdown)            cmp.b       #1,d1                * CMPB #1 if so,  make change regardless of time            bhi.s       dodst                * BHI DODST            move.b      3(a0),d0             * LDA 3,X reload hour of day            cmp.b       #2,d0                * CMPA #2 it's sunday - is it 2:00 am yet?            blo.s       ckdste               * BLO CKDSTE no - not time yet to change overdodst       move.b      dst(a6),d1           * LDB DST okay - is it spring or fall change?            cmp.b       #$41,d1              * CMPB #$41 is this the spring change?            bne.s       dechr                * BNE DECHR no - go do fall change            move.l      #hod,a1              * LDY #HOD yes - set the hour hand ahead            jsr         addbcd(a6)           * JSR >ADDBCD (increment hod & store it)            move.b      #$10,d1              * LDB #$10 reset dst flag to show edt in effect            move.b      d1,dst(a6)           * STB DST            bra.s       dstdon               * BRA DSTDON and go set up to burn it in eepromdechr       cmp.b       #$50,d1              * CMPB #$50 is this the fall change?            beq.s       dechrgo              * BEQ DECHRGO yes - proceed             jsr         detdst(a6)           * JSR >DETDST no - bogus value in dst - recompute it            bra.s       ckdste               * BRA CKDSTEdechrgo     move.b      #1,d1                * LDB #1 its fall - set the hour hand back            move.b      d1,dst(a6)           * STB DST reset dst flag to show est in effect            jsr         minbcd(a6)           * JSR >MINBCD            move.b      d0,3(a0)             * STA 3,X and save the new hours count dstdon      move.b      #1,d1                * LDB #1            move.l      #dst,a0              * LDX #DST insert the new dst flag for eeprom burn            move.l      a0,saddr(a6)         * STX SADDR            move.b      d1,len(a6)           * STB LEN save data to be sent to subroutine insert            move.b      epromf(a6),d1        * LDB EPROMF            move.b      d1,epromfm(a6)       * STB EPROMFM            jsr         insert(a6)           * JSR >INSERT            move.b      epromfm(a6),d1       * LDB EPROMFM            move.b      d1,epromf(a6)        * STB EPROMF            move.b      #$ff,d1              * LDB #$FF reset day clock table offset            move.b      d1,rtcgen(a6)        * STB RTCGENdstrts      movem.l     (a7)+,d0/d1/a0       * PULS A,B,X RESTORE INCOMING REGISTERS            rts                              * RTSckdste      move.b      eepgood(a6),d0       * LDA EEPGOOD able to read eeprom?            move.b      eepgood+1(a6),d1     * LDB EEPGOOD+1            cmp.b       #$b5,d0              * CMPA #$B5            bne.s       dstdon               * BNE DSTDON no  - can't read eeprom            cmp.b       #$4a,d1              * CMPB #$4A            bne.s       dstdon               * BNE DSTDON            move.b      dste(a6),d1          * LDB DSTE            cmp.b       dst(a6),d1           * CMPB DST is the dst value in eeprom still current?            bne.s       dstdon               * BNE DSTDON no- go set up to repair it?            movem.l     (a7)+,d0/d1/a0       * PULS A,B,X RESTORE INCOMING REGISTERS            rts                              * RTS*            ifeq        versw-0              * IFEQ VERSW-0*setodcor    move.b      #$01,d0              * LDA #$01            move.b      d0,todcor(a6)        * STA TODCOR set coord. clock switch            jmp         relok(a6)            * JMP >RELOK go on*            endc        *                    ENDC*clrh        move.b      3(a0),d0             * LDA 3,X            ifeq        versw-0              * IFEQ VERSW-0            cmp.b       #$02,d0              * CMPA #$02 is it 2:00 am            beq.s       setodcor             * BEQ SETODCOR yes...set up coord sync clocks            endc        *                    ENDC            cmp.b       #$24,d0              * CMPA #$24 no...are we at 2400 hrs?            clr.b       d1                   * CLRB YES...            move.b      d1,cpdto(a6)         * STB CPDTO reset cpd trip counter once a day            move.b      d1,pwrcn(a6)         * STB PWRCN reset powerdown counter each day            move.b      d1,lrsed(a6)         * STB LRSED clear special lower ram flag each day            move.b      d1,3(a0)             * STB 3,X clear hours timer (hod)            move.b      d1,(a6)              * STB ,U clr 10-min/day counter            addq.b      #1,6(a0)             * INC 6,X inc day of week (1-7)            lea.l       1(a0),a1             * LEAY 1,X            jsr         addbcd(a6)           * JSR >ADDBCD increment day of month timer (dom)            move.b      5(a6),d0             * LDA 5,U increment day of year (doy - 2 bytes)            move.b      6(a6),d1             * LDB 6,U            add.b       #1,d1                * ADDB #1            move.b      d1,6(a6)             * STB 6,U            fail Carry flag not included             add.b       #0,d0                * ADCA #0            move.b      d0,5(a6)             * STA 5,U            move.b      clkded(a6),d0        * LDA CLKDED is master clock active?            cmp.b       #$13,d0              * CMPA #$13            beq         relok                * LBEQ RELOK            move.b      #$ff,d0              * LDA #$FF hold off ks till thru with gtc regen            move.b      d0,edtdel(a6)        * STA EDTDEL            move.b      d0,yeargen(a6)       * STA YEARGEN            move.b      d0,rtcgen(a6)        * STA RTCGEN set up to redo all gtc tables            move.b      d0,daygen(a6)        * STA DAYGEN            move.b      (a0),d0              * LDA ,X get month of year (moy)            cmp.b       #$0a,d0              * CMPA #$0A convert it to hex for the offset            blo.s       getmon               * BLO GETMON            sub.b       #$06,d0              * SUBA #$06 find # of days in this monthgetmon      move.l      #montbl,a1           * LDY #MONTBL            subq.b      #1,d0                * DECA            ext.w       d0                   Extend to word            move.b      (a1,d0.w),d1         * LDB A,Y            move.b      d1,spa(a6)           * STB SPA temp store itgoleap      move.b      1(a0),d0             * LDA 1,X get day of month            cmp.b       spa(a6),d0           * CMPA SPA are we over days in month            bls.s       week                 * BLS WEEK no, go check day of week            jsr         leapyr(a6)           * JSR >LEAPYR are we in a leap year            bcc.s       noleap               * BCC NOLEAP no - just transfer to next month            move.b      (a0),d1              * LDB ,X            cmp.b       #$02,d1              * CMPB #$02            bne.s       noleap               * BNE NOLEAP            cmp.b       #$29,d0              * CMPA #$29 is it leap day?            beq.s       week                 * BEQ WEEK yes - check day of weeknoleap      lea.l       (a0),a1              * LEAY ,X            jsr         addbcd(a6)           * JSR >ADDBCD yes - increment month of year (moy)            cmp.b       #$13,d0              * CMPA #$13 year over?            bne.s       dset                 * BNE DSET no, skip new year setup            move.b      #1,d0                * LDA #1 yes            move.b      d0,(a0)              * STA ,X set month=1            move.b      d0,6(a6)             * STA 6,U set day of year (lo-byte)=1            clr.b       5(a6)                * CLR 5,U clr day of year (hi-byte)            clr.b       7(a0)                * CLR 7,X clr week of year            add.b       2(a0),d0             * ADDA 2,X inc year            fail No 68000 equivalent             daa         *                    DAA RETAIN decimal format            move.b      d0,2(a0)             * STA 2,X save new year            move.b      #8,d1                * LDB #8            cmp.b       6(a0),d1             * CMPB 6,X is first day of year a sunday            beq.s       dset                 * BEQ DSET yes, allow week routine (below) to correct woydset        move.b      #1,d0                * LDA #1            move.b      d0,1(a0)             * STA 1,X set dom=1*week        move.b      6(a0),d0             * LDA 6,X week over?            cmp.b       #8,d0                * CMPA #8            blo         inityc               * LBLO INITYC no, check for regen. year prog. table            move.b      #1,d0                * LDA #1 yes, its sunday            move.b      d0,6(a0)             * STA 6,X set dow = 1            addq.b      #1,7(a0)             * INC 7,X inc week of year            ifeq        versw-0              * IFEQ VERSW-0            clr.b       count3(a6)           * CLR COUNT3 court of last resort errors            move.l      #areset,a0           * LDX #ARESET point to alarm area            clr.b       d0                   * CLRAloopbak     move.b      (a0)+,d1             * LDB ,X+ inc. location            cmp.b       #7,d1                * CMPB #7 do we have > = 7 resets???            bhs.s       loopbak              * BHS LOOPBAK yes...dont clear out resets            move.b      d0,(a0)              * STA ,X no..clear out resets            cmp.l       #endda,a0            * CMPX #ENDDA are we thru???            blo.s       loopbak              * BLO LOOPBAK no...            clr.b       cnt78(a6)            * CLR CNT78 clear tbc counter            move.b      serrsw(a6),d0        * LDA SERRSW get timebase sync switch            cmp.b       #$09,d0              * CMPA #$09 have we had too many phantom syncs            bhs.s       clrest               * BHS CLREST yes...don't clear timebase sync error counter            clr.b       serrsw(a6)           * CLR SERRSW no..clear it nowclrest      clr.b       d0                   * CLRA            else        *                    ELSE*          ldx   #areset  point to alarm area*          clra*loopbak   ldb   ,x+      inc. location*          cmpb  #7       do we have > = 7 resets???*          bhs   loopbak  yes...dont clear out resets*          sta   ,x       no..clear out resets*          cmpx  #endda   are we thru???*          blo   loopbak  no...            clr.b       d0                   * CLRA            endc        *                    ENDC            clr.b       d1                   * CLRB            move.b      d0,countrp(a6)       * STA COUNTRP            move.b      d0,swicnt(a6)        * STA SWICNT            move.b      d1,swicnt+1(a6)      * STB SWICNT+1            move.b      d0,shrtcnt(a6)       * STA SHRTCNT            move.b      d1,shrtcnt+1(a6)     * STB SHRTCNT+1            move.b      d0,rswi(a6)          * STA RSWI clear all power down counters once a week            move.b      d1,rswi+1(a6)        * STB RSWI+1            move.b      d0,rshrt(a6)         * STA RSHRT            move.b      d1,rshrt+1(a6)       * STB RSHRT+1            move.l      #moy,a0              * LDX #MOY yes...restore x-pointer            jmp         daylit(a6)           * JMP >DAYLIT**         subroutine:  subtract in bcd format*              a - b  ->  a                ( a >= b)*minbcd      move.b      d0,rtemp1(a6)        * STA RTEMP1 temp store minuend            move.b      d1,rtemp2(a6)        * STB RTEMP2 temp store subtrahend            move.b      #$99,d0              * LDA #$99 to compute:            sub.b       rtemp2(a6),d0        * SUBA RTEMP2 $99 - b            ori         #$01,ccr             * ORCC #$01            fail Carry flag not included             add.b       rtemp1(a6),d0        * ADCA RTEMP1            fail No 68000 equivalent             daa         *                    DAA            rts                              * RTS**         subroutine - increment the bcd value pointed by reg y*addbcd      move.b      (a1),d0              * LDA ,Y read the value            add.b       #1,d0                * ADDA #1 hex increment it            fail No 68000 equivalent             daa         *                    DAA CONVERT sum to bcd            move.b      d0,(a1)              * STA ,Y and save it            rts                              * RTS********************************************************************    subroutine - determine the current dst status of the master clock*detdst      movem.l     d0/d1/a0,-(a7)       * PSHS A,B,X            move.l      #dstvar,a0           * LDX #DSTVAR point to dst variables            move.b      (a0),d0              * LDA ,X is daylight savings time intended?            cmp.b       1(a0),d0             * CMPA 1,X if start and end variables are the same            bne.s       dtdst                * BNE DTDST - then forget it. always standard time.            bra.s       setest               * BRA SETESTdtdst       move.b      moy(a6),d0           * LDA MOY okay. look for changes...            jsr         decbin(a6)           * JSR >DECBIN            cmp.b       (a0),d0              * CMPA ,X are we before starting month?            blo.s       setest               * BLO SETEST yes - must be standard time            bhi.s       dtdst3               * BHI DTDST3 no - go check ending month            move.b      2(a0),d0             * LDA 2,X in starting month - check week no.            cmp.b       #5,d0                * CMPA #5 looking for last week in month?            blo.s       dtdst1               * BLO DTDST1 no - go check indicated week            jsr         daylts(a6)           * JSR >DAYLTS in last week?            bhi.s       setest               * BHI SETEST no - must be in standard time            jsr         decbin(a6)           * JSR >DECBIN change reg. a to hex            move.b      d0,d1                * TFR A,B            bra.s       dtdst2               * BRA DTDST2 yes - now are we to the change yet?dtdst1      move.b      dom(a6),d0           * LDA DOM convert dom to hex            jsr         decbin(a6)           * JSR >DECBIN            move.b      d0,spb(a6)           * STA SPB            move.b      2(a0),d0             * LDA 2,X            move.b      #7,d1                * LDB #7 calculate end of indicated week            ext.w       d0                   Extend to word            ext.w       d1                   Extend to word            move.w      d1,d2                Move to destination register            mulu        d0,d2                * MUL            cmp.b       spb(a6),d1           * CMPB SPB is the clock past this week yet?            blo.s       dtdst3               * BLO DTDST3 yes - go check ending month            sub.b       #6,d1                * SUBB #6 no - find beginning of week            cmp.b       spb(a6),d1           * CMPB SPB are we to start of this week yet?            bhi.s       setest               * BHI SETEST no - must be in standard timedtdst2      neg.b       d1                   * NEGB OKAY - we have an eligible week            add.b       spb(a6),d1           * ADDB SPB calculate offset between clock and            addq.b      #1,d1                * INCB - start of the week            cmp.b       dow(a6),d1           * CMPB DOW are we to sunday yet?            blo.s       setest               * BLO SETEST no - must be in standard time            move.b      dow(a6),d1           * LDB DOW is this currently sunday?            cmp.b       #1,d1                * CMPB #1            bhi.s       setedt               * BHI SETEDT no - must be in daylight time            move.b      hod(a6),d1           * LDB HOD yes - so is it past 2:00 am?            cmp.b       #2,d1                * CMPB #2            blo.s       setestc              * BLO SETESTC no - must be in e.s.t. ready to changesetedt      move.b      #$10,d0              * LDA #$10 yes - set dst flag - in daylight time            bra.s       setdst               * BRA SETDSTsetedtc     move.b      #$50,d0              * LDA #$50            bra.s       setdst               * BRA SETDSTsetestc     move.b      #$41,d0              * LDA #$41            bra.s       setdst               * BRA SETDSTsetest      move.b      #1,d0                * LDA #1 set dst flag - in standard timesetdst      move.b      d0,dst(a6)           * STA DST            movem.l     (a7)+,d0/d1/a0       * PULS A,B,X            rts                              * RTSdtdst3      move.b      moy(a6),d0           * LDA MOY possible to be in daylight time            jsr         decbin(a6)           * JSR >DECBIN            cmp.b       1(a0),d0             * CMPA 1,X are we in ending month?            blo.s       setedt               * BLO SETEDT no - must be in daylight time            bhi.s       setest               * BHI SETEST no - must be in standard time            move.b      3(a0),d0             * LDA 3,X yes - in the right week?            cmp.b       #5,d0                * CMPA #5 looking for the last week of the month?            jsr         daylts(a6)           * JSR >DAYLTS yes - are we in last week?            bhi.s       setedt               * BHI SETEDT no - must be in daylight time            jsr         decbin(a6)           * JSR >DECBIN            move.b      d0,d1                * TFR A,B            bra.s       dtdst5               * BRA DTDST5 yes - now are we to the change yet?dtdst4      move.b      dom(a6),d0           * LDA DOM convert dom to hex            jsr         decbin(a6)           * JSR >DECBIN            move.b      d0,spb(a6)           * STA SPB            move.b      3(a0),d0             * LDA 3,X            move.b      #7,d1                * LDB #7 calculate end of indicated week            ext.w       d0                   Extend to word            ext.w       d1                   Extend to word            move.w      d1,d2                Move to destination register            mulu        d0,d2                * MUL            cmp.b       spb(a6),d1           * CMPB SPB are we past this week?            blo.s       setest               * BLO SETEST yes - must be in standard time            sub.b       #6,d1                * SUBB #6 are we before start of this week?            cmp.b       spb(a6),d1           * CMPB SPB            bhi.s       setedt               * BHI SETEDT yes - must be in daylight timedtdst5      neg.b       d1                   * NEGB OKAY - in an eligible week            add.b       spb(a6),d1           * ADDB SPB calculate offset between clock and            addq.b      #1,d1                * INCB - start of the week            cmp.b       dow(a6),d1           * CMPB DOW are we to sunday yet?            blo.s       setedt               * BLO SETEDT no - must be in daylight time            move.b      dow(a6),d1           * LDB DOW so is it sunday?            cmp.b       #1,d1                * CMPB #1            bhi.s       setest               * BHI SETEST no - past it - must be standard time            move.b      hod(a6),d1           * LDB HOD yes - are past 2:00 am?            cmp.b       #2,d1                * CMPB #2            blo.s       setedtc              * BLO SETEDTC no - still e.d.t. ready to change            bra.s       setest               * BRA SETEST yes - must be standard time***    begin regular weekly inspection of dst variables*daylit      move.l      #dstvar,a0           * LDX #DSTVAR first check validity of dst words            move.b      (a0),d0              * LDA ,X start month must be 1 - 12            beq         daylit5              * LBEQ DAYLIT5 n.g. - go load default values            cmp.b       #12,d0               * CMPA #12            bhi         daylit5              * LBHI DAYLIT5            move.b      1(a0),d0             * LDA 1,X ending month must be 1 - 12            beq         daylit5              * LBEQ DAYLIT5            cmp.b       #12,d0               * CMPA #12            bhi         daylit5              * LBHI DAYLIT5            move.b      2(a0),d0             * LDA 2,X week no. must be 1 - 5            beq         daylit5              * LBEQ DAYLIT5            cmp.b       #5,d0                * CMPA #5            bhi         daylit5              * LBHI DAYLIT5            move.b      3(a0),d0             * LDA 3,X week no. must be 1 - 5            beq         daylit5              * LBEQ DAYLIT5            cmp.b       #5,d0                * CMPA #5            bhi         daylit5              * LBHI DAYLIT5*                        all dst words are valid            move.b      dstchk(a6),d0        * LDA DSTCHK is dst checksum in ram valid?            bsr.s       dstsm                * BSR DSTSM            beq         daylt                * LBEQ DAYLT okay - go check for occurrence of dst            move.b      eepgood(a6),d0       * LDA EEPGOOD dst invalid - able to read eeprom?            move.b      eepgood+1(a6),d1     * LDB EEPGOOD+1            cmp.b       #$b5,d0              * CMPA #$B5            bne         inityc               * LBNE INITYC can't read eeprom so skip dst var. inspection            cmp.b       #$4a,d1              * CMPB #$4A            bne         inityc               * LBNE INITYC            move.b      dstchke(a6),d0       * LDA DSTCHKE no - check validity of dst chksm in eeprom            bsr.s       dstsm                * BSR DSTSM            bne.s       daylit1              * BNE DAYLIT1 no - check validity of dst words in eeprom            move.b      dstchke(a6),d0       * LDA DSTCHKE yes - correct dst chksm in ram            move.b      d0,dstchk(a6)        * STA DSTCHK            jmp         daylt(a6)            * JMP >DAYLT and go check for occurrence of dstdaylit1     move.l      #dstvare,a0          * LDX #DSTVARE are dst words in eeprom valid?            move.b      dstchk(a6),d0        * LDA DSTCHK            bsr.s       dstsm                * BSR DSTSM            bne.s       daylit4              * BNE DAYLIT4 no - recheck validity of dst chksm in eepromdaylit2     bsr.s       dstcpy               * BSR DSTCPY yes - transfer eeprom data to ram            jmp         daylt(a6)            * JMP >DAYLT and go check for occurrence of dst change*            fail 68000 eor instruction operates on memory dstsm       eor.b       d0,(a0)              * EORA ,X subroutine to sum dst words            fail 68000 eor instruction operates on memory             eor.b       d0,1(a0)             * EORA 1,X (note: any value xor'ed with itself = 0)            fail 68000 eor instruction operates on memory             eor.b       d0,2(a0)             * EORA 2,X            fail 68000 eor instruction operates on memory             eor.b       d0,3(a0)             * EORA 3,X            rts                              * RTS*dstcpy      move.l      #dstvar,a0           * LDX #DSTVAR subroutine - copy all dst data in eeprom to ram            move.b      #4,d1                * LDB #4 set loop count to copy 4 bytesdstcpy1     move.b      $2000(a0),d0         * LDA $2000,X            move.b      d0,(a0)+             * STA ,X+            subq.b      #1,d1                * DECB            bne.s       dstcpy1              * BNE DSTCPY1            move.l      #dstvar,a0           * LDX #DSTVAR            bsr.s       lddstc               * BSR LDDSTC redo dst chksm in ram            rts                              * RTS*          daylit4     move.b      #3,d1                * LDB #3 set up redundacy on reading eepromdaylitr     move.b      dstchke(a6),d0       * LDA DSTCHKE recheck validity of dst chksm in eeprom            move.b      d0,spa(a6)           * STA SPA            bsr.s       dstsm                * BSR DSTSM            beq.s       daylitk              * BEQ DAYLITK            subq.b      #1,d1                * DECB            bne.s       daylitr              * BNE DAYLITR if reads of eeprom no good, try again            bra.s       daylit5              * BRA DAYLIT5 give up - go set up default valuesdaylitk     move.b      spa(a6),d0           * LDA SPA read good            move.b      d0,dstchk(a6)        * STA DSTCHK            bra.s       daylit2              * BRA DAYLIT2 now go correct dst words in ram*lddst       move.l      #dstvar,a0           * LDX #DSTVAR subroutine - load default values to dst words            move.b      #4,d1                * LDB #4 start 1st week in april            move.b      d1,(a0)              * STB ,X            move.b      #1,d1                * LDB #1            move.b      d1,2(a0)             * STB 2,X            move.b      #10,d1               * LDB #10 end last week in october            move.b      d1,1(a0)             * STB 1,X            move.b      #5,d1                * LDB #5            move.b      d1,3(a0)             * STB 3,Xlddstc      move.b      (a0),d1              * LDB ,X calculate the dst checksum            fail 68000 eor instruction operates on memory             eor.b       d1,1(a0)             * EORB 1,X            fail 68000 eor instruction operates on memory             eor.b       d1,2(a0)             * EORB 2,X            fail 68000 eor instruction operates on memory             eor.b       d1,3(a0)             * EORB 3,X            move.b      d1,dstchk(a6)        * STB DSTCHK            move.b      #4,d1                * LDB #4 now insert new dst words to burn queue            move.l      a0,saddr(a6)         * STX SADDR            move.b      d1,len(a6)           * STB LEN save data to be sent to subroutine insert            jsr         insert(a6)           * JSR >INSERT            rts                              * RTS*daylts      move.l      #montbl,a1           * LDY #MONTBL point to days in month table            move.b      moy(a6),d0           * LDA MOY calculate start of last week in month            jsr         decbin(a6)           * JSR >DECBIN            ext.w       d0                   Extend to word            move.b      (a1,d0.w),d0         * LDA A,Y            jsr         leapyr(a6)           * JSR >LEAPYR check for leap year correction - is it leap year            bcc.s       daylts1              * BCC DAYLTS1 no...            move.b      moy(a6),d1           * LDB MOY            cmp.b       #2,d1                * CMPB #2            bne.s       daylts1              * BNE DAYLTS1            addq.b      #1,d0                * INCAdaylts1     move.b      #6,d1                * LDB #6            jsr         minbcd(a6)           * JSR >MINBCD            cmp.b       dom(a6),d0           * CMPA DOM are we within last week of the month?            rts                              * RTS*decbin      movem.l     d0,-(a7)             * PSHS A SUBROUTINE - CONVERT BCD VALUE IN REG. A            and.b       #$f0,d0              * ANDA #$F0 to hex   - reg. b used            lsr.b       #1,d0                * LSRA            lsr.b       #1,d0                * LSRA            lsr.b       #1,d0                * LSRA            lsr.b       #1,d0                * LSRA            move.b      #10,d1               * LDB #10            ext.w       d0                   Extend to word            ext.w       d1                   Extend to word            move.w      d1,d2                Move to destination register            mulu        d0,d2                * MUL            move.b      d1,disms(a6)         * STB DISMS            movem.l     (a7)+,d0             * PULS A            and.b       #$0f,d0              * ANDA #$0F            add.b       disms(a6),d0         * ADDA DISMS            rts                              * RTS*daylit5     bsr.s       lddst                * BSR LDDST load the default values for dst wordsdaylt       move.l      #dstvar,a0           * LDX #DSTVAR do we need to correct for dst?            move.b      moy(a6),d0           * LDA MOY get current month            jsr         decbin(a6)           * JSR >DECBIN            cmp.b       (a0),d0              * CMPA ,X is it dst starting month?            blo.s       inityc               * BLO INITYC no - leave dst section            bhi.s       daylt3               * BHI DAYLT3 no - check for ending month            move.b      2(a0),d0             * LDA 2,X okay - get the week number            cmp.b       #5,d0                * CMPA #5 is it last week of month?            blo.s       daylt1               * BLO DAYLT1 no - go check which week            bsr.s       daylts               * BSR DAYLTS are we in last week?            bhi.s       inityc               * BHI INITYC no - leave dst section            bra.s       daylt2               * BRA DAYLT2 yes - go implement spring changedaylt1      move.b      dom(a6),d0           * LDA DOM convert dom to hex            jsr         decbin(a6)           * JSR >DECBIN            move.b      d0,spb(a6)           * STA SPB            move.b      2(a0),d0             * LDA 2,X            move.b      #7,d1                * LDB #7 calculate end of scheduled week            ext.w       d0                   Extend to word            ext.w       d1                   Extend to word            move.w      d1,d2                Move to destination register            mulu        d0,d2                * MUL            cmp.b       spb(a6),d1           * CMPB SPB before the end of the week?            blo.s       inityc               * BLO INITYC no - go leave dst section            sub.b       #6,d1                * SUBB #6 calulate begin of scheduled week            cmp.b       spb(a6),d1           * CMPB SPB before start of the week?            bhi.s       inityc               * BHI INITYC no - leave dst sectiondaylt2      move.b      #$41,d0              * LDA #$41 okay!  set flag to implement spring change            move.b      d0,dst(a6)           * STA DST            bra.s       inityc               * BRA INITYC and leave dst sectiondaylt3      cmp.b       1(a0),d0             * CMPA 1,X are we in ending month?            bne.s       inityc               * BNE INITYC no - leave dst section            move.b      3(a0),d0             * LDA 3,X yes - get scheduled week number            cmp.b       #5,d0                * CMPA #5 is it last week of month?            blo.s       daylt4               * BLO DAYLT4 no - check the scheduled week            jsr         daylts(a6)           * JSR >DAYLTS yes - are we in the last week?            bhi.s       inityc               * BHI INITYC no - leave dst section            bra.s       daylt5               * BRA DAYLT5 yes - go implement the fall changedaylt4      move.b      dom(a6),d0           * LDA DOM convert dom to hex            jsr         decbin(a6)           * JSR >DECBIN            move.b      d0,spb(a6)           * STA SPB            move.b      3(a0),d0             * LDA 3,X            move.b      #7,d1                * LDB #7 calculate the end of the scheduled week            ext.w       d0                   Extend to word            ext.w       d1                   Extend to word            move.w      d1,d2                Move to destination register            mulu        d0,d2                * MUL            cmp.b       spb(a6),d1           * CMPB SPB before end of the week?            blo.s       inityc               * BLO INITYC no - leave dst section            sub.b       #6,d1                * SUBB #6 calculate start of the week            cmp.b       spb(a6),d1           * CMPB SPB before start of week?            bhi.s       inityc               * BHI INITYC yes - go leave dst sectiondaylt5      move.b      #$50,d0              * LDA #$50 okay! set flag to implement fall change            move.b      d0,dst(a6)           * STA DST*************************************************************inityc      clr.b       d0                   * CLRA            move.b      #1,d1                * LDB #1            tst.b       d0                   * TSTA            bne.s       relok                * BNE RELOK            cmp.b       doy+1(a6),d1         * CMPB DOY+1 are we starting a new year?            bne.s       relok                * BNE RELOK no, exit.            move.b      dow(a6),d1           * LDB DOW yes, set up for a new year program            subq.b      #1,d1                * DECB            move.b      d1,ypofst(a6)        * STB YPOFST new jan.1 offset for year program tablerelok       move.b      ms10hun(a6),d0       * LDA MS10HUN get now current value of 0.1 second            move.b      d0,tos(a6)           * STA TOS to update rtc tos            move.b      dieflg(a6),d0        * LDA DIEFLG            move.b      dieflg+1(a6),d1      * LDB DIEFLG+1            cmp.b       #$a5,d0              * CMPA #$A5 are we in a dead state            bne.s       relokrt              * BNE RELOKRT yes...bypass burn of power down counters            cmp.b       #$5a,d1              * CMPB #$5A            bne.s       relokrt              * BNE RELOKRT            move.b      eepgood(a6),d0       * LDA EEPGOOD able to read eeprom?            move.b      eepgood+1(a6),d1     * LDB EEPGOOD+1            cmp.b       #$b5,d0              * CMPA #$B5            bne.s       relokrt              * BNE RELOKRT no - skip next for this time            cmp.b       #$4a,d1              * CMPB #$4A            bne.s       relokrt              * BNE RELOKRT            move.b      #4,d1                * LDB #4 did powerdown counters change?            move.l      #pwrcn,a0            * LDX #PWRCN point to 4 variablesreloka      move.b      $2000(a0),d0         * LDA $2000,X read eeprom value            cmp.b       (a0)+,d0             * CMPA ,X+ compare to valuue in ram            bne.s       relokb               * BNE RELOKB if changed, go burn new value            subq.b      #1,d1                * DECB            bne.s       reloka               * BNE RELOKA            bra.s       relokrt              * BRA RELOKRT no changes - exit            ifne        versw-0              * IFNE VERSW-0relokb      move.b      ccpymr+t(a6),d0      * LDA CCPYMR+T do not burn if ramcopy in progress            bne.s       relokrt              * BNE RELOKRT            move.b      rtcasw(a6),d0        * LDA RTCASW don't burn if in exec or guard            else        *                    ELSErelokb      move.b      rtcasw(a6),d1        * LDB RTCASW don't burn if in exec or guard            endc        *                    ENDC            bne.s       relokrt              * BNE RELOKRT            move.b      #4,d1                * LDB #4 change occurred            move.l      #pwrcn,a0            * LDX #PWRCN set up insertion for burn            move.b      epromf(a6),d0        * LDA EPROMF do not reburn eep chksuums!!!            move.b      d0,epromfm(a6)       * STA EPROMFM save in  mirror word            move.l      a0,saddr(a6)         * STX SADDR            move.b      d1,len(a6)           * STB LEN save data to be sent to subroutine insert            jsr         insert(a6)           * JSR >INSERT            move.b      epromfm(a6),d0       * LDA EPROMFM restore epromf            move.b      d0,epromf(a6)        * STA EPROMFrelokrt     rts                              * RTS**         montbl      dc.b        $31                  * FCB $31 january            dc.b        $28                  * FCB $28 february            dc.b        $31                  * FCB $31 march            dc.b        $30                  * FCB $30 april            dc.b        $31                  * FCB $31 may            dc.b        $30                  * FCB $30 june            dc.b        $31                  * FCB $31 july            dc.b        $31                  * FCB $31 august            dc.b        $30                  * FCB $30 september            dc.b        $31                  * FCB $31 october            dc.b        $30                  * FCB $30 november            dc.b        $31                  * FCB $31 december*****    subroutine:  kill master time clockskillclk     move.b      #$13,d0              * LDA #$13 both clocks bad!  total disable of clocks            move.b      d0,(a0)              * STA ,X            move.b      d0,clkded(a6)        * STA CLKDED            move.b      d0,clkded1(a6)       * STA CLKDED1            ori         #$50,ccr             * ORCC #$50 disable interrupts during wrdrec            move.b      #$20,d0              * LDA #$20 set diag message for master clock failure            move.b      d0,dmkey(a6)         * STA DMKEY            move.l      (a7),a0              * LDX ,S detection address            move.l      a0,dmaddr(a6)        * STX DMADDR            move.b      memslct+1(a6),d0     * LDA MEMSLCT+1 detection address port values            move.b      d0,dmmprt(a6)        * STA DMMPRT            move.b      #8,d0                * LDA #8 type of reset  (none)            move.b      d0,typres(a6)        * STA TYPRES            ifeq        versw-0              * IFEQ VERSW-0            move.b      xwrdrec(a6),d0       * LDA XWRDREC execute the diag message            move.b      d0,xlat(a6)          * STA XLAT            jsr         xlatr(a6)            * JSR >XLATR            else        *                    ELSE            jsr         wrdrec(a6)           * JSR >WRDREC execute the diag msg            endc        *                    ENDC            rts                              * RTS**