DEBUG    = -gOPT      = -O2 -ob -optasm -fomit-frame-pointer -mnostack-checkTRAP     =CC       = gcc2CF       = -uwlibs -T/r0 $(DEBUG) $(OPT) $(TRAP)CFLAGS   = $(CF)LIBDIR   = /dd/LIBSYSLIBS  = -l=$(LIBDIR)/sys.lLFLAGS   = $(SYSLIBS) RDIR     = RELSSDIR     = .ODIR     = CMDS.c.r:  $(CC) $(SDIR)/$*.c -c $(CFLAGS) -o $(RDIR)/$*.rDISP.OBJS = $(RDIR)/scf_c.r $(RDIR)/disp.r$(ODIR)/disp:    $(DISP.OBJS)         l68 $(DISP.OBJS) $(SYSLIBS) -O=$@