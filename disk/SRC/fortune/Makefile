# OS-9/68k makefileODIR = /h0/cmds/dogCC = ccDESTDIR=		/h0/games/fortuneFORTUNES=       ./scene ./obsceneSOURCE=         fortune.c strfile.h strfile.c unstr.c $(FORTUNES)LIBDIR=         $(DESTDIR)/.BINDIR=         $(DESTDIR)/.OWN=            daemonCFLAGS=         -gixm=2k -t=/dd-bmakefile: fortune strfile unstr fortunes.dat		echo donefortune: strfile.h fortune.c        $(CC) $(CFLAGS) -DFORTFILE="$(LIBDIR)/fortunes.dat" -f=fortune fortune.cstrfile: strfile.h strfile.c        $(CC) $(CFLAGS) -f=strfile strfile.cunstr: strfile.h unstr.c        $(CC) $(CFLAGS) -f=unstr unstr.cfortunes.dat: ./fortunes strfile        strfile fortunes./fortunes: $(FORTUNES)        tee <scene   >fortunes; \        echo "%-"    >+fortunes; \        tee <obscene >+fortunes; \        echo "%%"    >+fortunes#install: all#        install -m 600 -f=$(OWN) fortunes.dat $(LIBDIR)/#        install -m 4711 -f=$(OWN) fortune $(BINDIR)/clean:        del -x fortune strfile unstr		del fortunes fortunes.dat