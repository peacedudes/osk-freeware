#include <stdio.h>#include <errno.h>#include <time.h>#define SHOWTIME#define HELP      "/dd/GAMES/pacman/document"#define BBRD      "/dd/GAMES/pacman/board"#define SCORE     "/dd/GAMES/pacman/score"#define pos( Y,X )     printf("\033=%c%c",Y+32,X+32)#define cput( Y,X,C )  printf("\033=%c%c%c",Y+32,X+32,C)#define put( Y,X,str ) printf("\033=%c%c%s",Y+32,X+32,str)#define POSX   14#define POSY   10#define FRX    24#define FRY    10#define MOX    35#define MOY    10#define COLMS  70#define MAX    80#define MAXLINES   24#define MEN    3#define LEFT 0#define DOT    '*'#define PDOT   '0'#define M0    "CPM"#define M1    "MPM"#define M2    "RAM"#define M3    "ROM"#define M4    "$$$"#define ERROR -1#define SEC256THS 0x80000000 struct {   int x,y,gh;} t[4];struct bye {  int uid, codes, bw, lev;  long  score;  char namestr[24];} pl, hi[11], temp;int lev, killed, bonus, left, ft, fb[8],sec;char  *rn[4],*fc[8],*os,*mons[4],move,old;char buffer[ BUFSIZ ];int youx, youy,     /*     your new x,y position      */    oyoux,oyouy,    /*     your old x,y position      */    speed,          /*     speed of play              */    dot,            /*     number of dots eaten       */    set(),          /*     (end game while running)   */    tim;             /*      time monsters are ghosts  */long  score, oscore; /*     new and old score          */char  s[MAX+2][MAXLINES],     /*     the board array            */      *SO,           /*     Stand-out mode on(reverse) */      *SE,           /*     Stand-out mode off(reverse)*/      *CL,           /*     Clear screen character     */      *CM;           /*     Cursor Motion              */main( argc, argv )int argc;char *argv[];{       int i, j, r, l, d, u;       char m[4], om[4] ;		stdin->_flag  |= _UNBUF;		stdout->_flag |= _UNBUF;       sec = 10;       if( argc > 1 )          sec = atoi( argv[1] );     if( sec > 20 ) {         printf("Maximum is 20\n");         sec = 20;         tsleep (SEC256THS + (1<<8));     }/* Get userid for name in score file */       pl.uid = getuid();       inital();       clear();       getname();	/* Use pid to randomize number generator */       help();		/* Ask if wants information */       left = MEN;	/* Set number of men */        os9fork("tmode", 16, "nopause noecho\n", 0, 0, 0, 0);        wait(0);        intercept( set );        graph();	/* Draw the board on screen from file *//* Initialize all dots, monsters, and pl */        men();        init();        flush();         speed = 21 - sec;/* Main part of the game follows: */         do {               oscore=score;               oyoux=youx;	/* Save position in old */               oyouy=youy;/* Read move,   don't stop */          move = old;               while(_gs_rdy(0) >= 0 ) {                       move = getchar();               }/* Move selection */           if( move == '\014' ) {  /*        Redraw  screen     */                 redraw();                 move = '5';                 men();           }           switch( move ) {           case 'L':           case 'l':           case '5':                move = '6';          case '6':                 if( wall( youx + 1, youy ) ) {                        youx++;                        cput( oyouy, oyoux-1, s[oyoux-1][oyouy] );                        printf("%s",os);                 }                 break;           case 'K':           case 'k':               move = '8';           case '8':                if( wall( youx, youy - 1 ) ) {                     erase( youx, youy );                     youy--;                     if( youy == 0 )                         youy = MAXLINES-1;                     put( youy, youx - 1, os );               }               break;           case 'J':           case 'j':           case '1':               move = '2';           case '2':               if( wall( youx, youy + 1 ) ) {                       erase( youx, youy );                       youy++;                       if( youy == MAXLINES-1 )                             youy = 1;                       put( youy, youx - 1, os );               }               break;            case 'H':            case 'h':                  move = '4';            case '4':                   if( youx == 40 && youy > 9 && youy < 14 )                          break;                   if( wall( youx - 1, youy ) ) {                          youx--;                          put( youy, youx-1, os );                          printf("%c", s[oyoux+1][oyouy] );                   }                   break;            case 'x':            case 'e':            case 'Q':            case 'q':                   set( 17 );            default:                   break;            }/* Player eats something ?? */            switch( s[youx][youy] ) {            case DOT:           /*       Star        */                   score += 10;                   s[youx][youy] = ' ';                   dot++;                   break;            case PDOT:                   score += 50;                   dot++;                   tim = 10 * speed ;                   for( i = 0 ; i < 4 ; i++ )                        t[i].gh=1;                   killed = 1;                   s[youx][youy] = ' ';                   break;             default:                   break;             }/* If all the small dots are eaten then start over,	and speed up.  If not then go on. */             switch( dot ) {             case 100:                  /*     Put out fruits     */             case 200:                     ft = 75;                     put( FRY, FRX, fc[lev] );                     break;             case 155:                 /*      Take away fruits   */             case 255:                     ft = 0;                     cput( FRY, FRX, s[FRX][FRY] );                     break;            case 269:                 /*      The board is done   */                    ft = dot = tim = 0;                    lev++;                    if( lev == 2 || lev == 4 ) {                            show();                            tsleep (SEC256THS + (1<<8));                    }                    graph();                    for( i = 0 ; i < lev ; i++ )                            put( i + 1, MAX-2, fc[ i ] );                    if( speed > 3 )                          speed -= 2;                    men();                    tsleep (SEC256THS + (1<<8) + 128);                    init();                    break;            default:                    break;            }/* Check if you ate a fruit during it's time */           if( youx == FRX && youy == FRY && ft ) {                    score += fb[ lev ];/* If there is a beep possible ???? */                    printf("\007\007\007");                    ft = 0;          }/* Is there any time left for eating monsters */        if(  tim == 1  )              for( i = 0 ; i < 4 ; i++ )                   t[i].gh = 0;        if( ft )              ft--;/* This is the INTERESTING part, THE  MONSTER  MOVES */        for( i = 0 ; i < 4 ; i++ ) {/* Check if they ate player */               check( i );               u = wall( t[i].x, t[i].y-1 );               d = wall( t[i].x, t[i].y+1 );               l = wall( t[i].x-1, t[i].y );               r = wall( t[i].x+1, t[i].y ); /* Monster's LOGIC */                if( l && r && d && u )                        m[ i ] = '6';                else if( l && r && !d && !u )                        m[ i ] = om[ i ];                else if( d && u && !l && !r )                        m[ i ] = om[ i ];                else if( l && u && d && !r && om[ i ] != '6' && t[ i ].x >= youx )                        m[ i ] = '4';                else if( l && u && d && !r && t[ i ].y <= youy ) {                       if( i == 0 || i == 3 )                               m[ i ] = '2';                       else                               m[ i ] = '8';               } else if( l && u && d && !r && t[ i ].y >= youy ) {                       if( i == 0 || i == 3 )                               m[ i ] = '8';                       else                               m[ i ] = '2';               }else if(r && u && d && !l && om[ i ] != '4' && t[ i ].x <=youx )                       m[ i ] = '6';                else if(r && u && d && !l &&t[i].y >= youy) {                       if( i == 0 || i == 3 )                             m[i] = '8';                       else                             m[i] = '2';               }else if( r && u && d && !l && t[i].y <= youy ) {                        if( i == 0 || i == 3 )                             m[i] = '2';                        else                             m[i] = '8';                }else if( r && l && u && !d && om[i] != '2' && t[i].y >= youy)                        m[i] = '8';               else if( r && l && u && !d && t[i].x <= youx ) {                        if( i == 0 || i == 1 )                               m[i] = '6';                        else                               m[i] = '4';               }else if( r && l && u && !d && t[i].x >= youx ) {                        if( i == 0 || i == 1 )                                m[i] = '4';                        else                                m[i] = '6';               }else if( r && l && d && !u && om[i] != '8' && t[i].y <= youy )                        m[i] = '2';               else if( r && l && d && !u && t[i].x >= youx )                        m[i] = '4';               else if( r && l && d && !u && t[i].x <= youx )                        m[i] = '6';               else if( d && !u && !l && !r )                        m[i] = '2';               else if( u && !d && !l && !r )                        m[i] = '8';               else if( l && !d && !u && !r )                        m[i] = '4';               else if( r && !l && !d && !u )                        m[i] = '6';               else if( l && r && !d && !u && t[i].x >= youx ) {                        if( i == 0 || i == 1 )                                m[i] = '4';                        else if( i == 2 )                                m[i] = '6';               }else if( u && d && !l && !r && t[i].y >= youy ) {                        if( i == 0 || i == 1 )                                m[i] = '8';                        else if( i == 2 )                                m[i] = '2';               }else if( u && d && l && !r && ( om[i] == '8' || om[i] == '2' ) && t[i].x >= youx )                        m[i] = '4';               else if( u && d && r && !l && ( om[i] == '8' || om[i] == '2' ) && t[i].x <= youx )                        m[i] = '6';               else if( l && r && d && !u && ( om[i] == '4' || om[i] == '6' ) && t[i].y <= youy )                        m[i] = '2';               else if( l && r && u && !d && ( om[i] == '4' || om[i] == '6' ) && t[i].y >= youy )                        m[i] = '8';               else if( d && r && !l && !u && om[i] == '4' )                        m[i] = '2';               else if( d && r && !l && !u && om[i] == '8' )                        m[i] = '6';               else if( u && r && !l && !d && om[i] == '4' )                        m[i] = '8';               else if( u && r && !l && !d && om[i] == '2' )                        m[i] = '6';               else if( l && d && !u && !r && om[i] == '8' )                        m[i] = '4';               else if( l && d && !u && !r && om[i] == '6' )                        m[i] = '2';               else if( l && u && !d && !r && om[i] == '2' )                        m[i] = '4';               else if( l && u && !d && !r && om[i] == '6' )                        m[i] = '8';               else if( abs( t[i].x -youx ) > abs( t[i].y - youy ) ) {                        if( t[i].x <= youx )                                m[i] = '6';                        else                                m[i] = '4';               }else {                        if( t[i].y <= youy )                               m[i] = '2';                        else                               m[i] = '8';               }               if( t[i].x == 40 && t[i].y > 9 && t[i].y < 14 ) {                        if( move == '8' || move == '2' )                                m[i] = move;                        else if( i == 1 || i == 2 )                                m[i] = '8';                        else                                m[i] = '2';               }              om[i] = m[i];/* Plot monster's move */             switch( m[i] ) {             case '2':                   /*    Down    */                      sput( t[i].y,t[i].x );                      t[i].y++;                      putmo( i );                     break;             case '6':                 /*    Right  */                      cput( t[i].y,t[i].x-1,s[t[i].x-1][t[i].y] );                      t[i].x++;                      putmo( i );                      break;             case '4':                   /*   Left   */                      cput( t[i].y, t[i].x+1,s[t[i].x+1][t[i].y] );                      t[i].x--;                      putmo( i );                      break;             case '8':                    /*     UP     */                      sput( t[i].y,t[i].x );                      t[i].y--;                      putmo( i );                      break;             }             check( i );             if( t[i].x < FRX-2 && t[i].x > FRX+2 && t[i].y == FRY && ft )                    put( FRY, FRX, fc[lev] );        }/* End of monster moves */        if( score > 10000 && !bonus ) {                left++;                printf("\007\007\007\007");                men();                bonus = 1;        }        if( tim > 0 )     /*     Decrease time are ghs    */               tim--;        old = move;/* Put out score */        if( score != oscore ) {                 pos( 22, 40 );                 printf("%ld",score );        }#ifdef SHOWTIME        {          struct sgtbuf tt;          getime(&tt);          pos(22,47);          printf("%2d:%02d:%02d",             tt.t_hour, tt.t_minute, tt.t_second);        }#endif        flush();        tsleep (SEC256THS + (speed * 7));      } while( 1 );     set( 17 );}    /*  ********     END OF MAIN PROGRAM    **********  */hold(){  put( MAXLINES-2, 0 , SO );  printf(" Hit 'space' to continue %s", SE );  flush();  while( getchar() != ' ' );  clear();}help(){  clear();  printf( "\n\n\n\n\n Do you wish instructions ? ( y / n ) " );  read(0, buffer, 1);  if(*buffer == 'y' || *buffer == 'Y' )     if( format( HELP ) == -1 )         printf( "Cannot open %s\n", HELP );}format( file )char *file;{  FILE *fp, *fopen();  register int counter;  counter = 0;  if( (fp = fopen( file, "r" )) == NULL )       return( -1 );   clear();      while( fgets( buffer, BUFSIZ , fp ) != NULL ) {      counter++;            printf("%s",buffer);      if( counter == MAXLINES-1 ) {            counter = 0;            hold();      }  }  hold();  fclose( fp );} /*     End of viewing text file function     */mesg( i )int i;{   put( 22, 14, " " );   printf("%8s got you",rn[ i ] );   flush();   tsleep (SEC256THS + (2<<8));   put( 22, 14, "                 ");} /*    End of kill message    */show(){   register int  i;   clear();   put( 10, 1, "0" );   for( i = COLMS-10 ; i > 1 ; i-- ) {          put( 10, i, os);          printf("  $$$ ");          flush();          tsleep (SEC256THS + 85);   }   for( i = 0 ; i < COLMS ; i++ ) {           put( 10, i, " ");           printf("%s  $$$",os);           flush();           tsleep (SEC256THS + 85);   }}men(){   int it;   for( it = 1 ; it <= 4 ; it++ )         if( it <= left )               put( 1, (it * 4 + 36), os );         else               put( 1, (it * 4 + 36), "   " );}#define      SIZE      sizeof( struct bye )int HISIZE;hiscor(){   int fd, i;   if( (fd = open( SCORE, _READ )) == EOF )           fixit( SCORE );   HISIZE = (read(fd,hi,SIZE*10))/SIZE;   close( fd );   if( HISIZE == 0 ) {           printf( "No scores yet !\n" );           return( 1 );   }   printf("Score          Name\n");   for( i = 0 ; i < HISIZE ; i++ ) {          printf("%5ld  %-24.24s ",hi[ i ].score, hi[ i ].namestr );   if( hi[ i ].codes )           printf(" killed on level %3d by %s.\n", hi[ i ].lev + 1, mons[ hi[i].bw ] );    else           printf(" quit ! on level %3d.\n", hi[ i ].lev + 1 );   }   flush();}  /*     End  of  printing  scores    */high(){   int wfd, rfd, touched;   int test, it;   if( (rfd = open( SCORE, _READ )) == EOF )          fixit( SCORE );   HISIZE = (read( rfd, hi, (SIZE * 10) )) / SIZE ;   close( rfd );   touched = 1;   if( HISIZE < 10 ) {         copy( HISIZE );         HISIZE++;   } else if( hi[ HISIZE - 1 ].score < pl.score )       copy( HISIZE-1 );   else         touched = 0;   if( HISIZE > 0 && touched ) {       do {             test = 0;             for( it = 0 ; it < HISIZE -1 ; it++ )                   if( hi[it].score < hi[it+1].score ) {                        swap( it );                        test = 1;                    }       } while( test );       if( (wfd = open( SCORE , _WRITE)) == EOF ) fixit( SCORE );       write( wfd, hi, HISIZE * SIZE );       close( wfd );   }}     /*   End of writing score    */redraw(){   register int i,j;   clear();   for( i = 0 ; i < MAXLINES; i++ ) {   for(j=0;j<COLMS;j++)       printf("%c",s[j][i] );   if( i < MAXLINES-1 )     printf("\n");   }   flush();}     /*    End of redrawing function   */fixit( file )char *file;{      echo();      printf( "Cannot open %s\n", file );      printf( "ERROR, Aborting\n" );      exit( 1 );}getname(){   clear();   printf("\n\nSpeed level %d\n", sec );   printf("\n\nWhat is your name ? ");   readln(0, buffer, 24);   sscanf(buffer, "%[^\n]", pl.namestr );}inital(){   fb[0] = 100;   fb[1] = 300;   fb[2] = 500;   fb[3] = 700;   fb[4] = 1000;   fb[5] = 2000;   fb[6] = 3000;   fb[7] = 5000;   fc[0] = "&";   fc[1] = "#";   fc[2] = "O";   fc[3] = "%";   fc[4] = "$";   fc[5] = "!";   fc[6] = "@";   fc[7] = "K";   rn[0] = "speedy";   rn[1] = "blinky";   rn[2] = "pokey";   rn[3] = "we";   os = "OS9";   imo();SO = "";SE = "";   CL  = "\033*";   move = old = '5';}imo(){   mons[0] = M0;   mons[1] = M1;   mons[2] = M2;   mons[3] = M3;}init(){   register int it;   for( it = 0 ; it < 4 ; it++ )       inmo( it );   youx = POSX;   youy = POSY;   put( youy, youx-1, os );}   /*    End of init    */inmo( it )register int it;{   t[it].x = MOX;   t[it].y = MOY + it;   t[it].gh = 0;   put( t[it].y, t[it].x-1, mons[ it ] );}   /*   End of Initialize monster  */   draw( file )char *file;{   register int col, row;   FILE *fp, *fopen();   if( (fp= fopen( file, "r" )) == NULL )        fixit( file );   for( row = 0 ; row < MAXLINES ; row++ ) {     fgets( buffer, BUFSIZ, fp );       for( col = 0 ; col < strlen(buffer) ; col++ )           s[ col ][ row ] = buffer[ col ];   }  fclose( fp );}  /*   End of draw, fill in board array   */graph(){   draw( BBRD );   redraw();   flush();}  /*   End of graph  */wall( x, y )register int x,y;{  if( ( s[x][y] == '|' || s[x][y] == '-' ) )     return(0);  else if( ( s[x-1][y] == '|' || s[x-1][y] == '-' ) )     return(0);  else if( ( s[x+1][y] == '|' || s[x+1][y] == '-' ) )     return(0);  else     return(1);}kilall(){   register int i;   for( i = 0 ; i < 4 ; i++ )      sput( t[i].y, t[i].x );   sput( oyouy, oyoux );   init();   flush();   tsleep (SEC256THS + (3<<8));}  /*   End of taking everything off board   */set( code )int code;{   printf("%s%s", CL, SE );   pl.score=score;   pl.lev = lev;   echo();   switch( code ) {   case 16:         printf("\007\007You have been had!\n");         pl.codes = 1;         break;   case 17:         printf( "\007\007Exit!\n" );         break;   case 3:         printf( "\007\007Quit !\n" );         break;   case 2:         printf( "\007\007Interrupt !\n" );         break;   default:         break;   }   printf( "\n\nYour final score was %5ld\n\n", score );   flush();   high();   hiscor();   exit( 0 );}echo(){        os9fork("tmode", 7, "normal", 0, 0, 0, 0);        wait(0);}check( it )register int it;{   register int j;   for( j = 0 ; j < 4 ; j++ )      if( youx == t[j].x && youy == t[j].y )        if( t[j].gh ) {           score += fb[ killed ] * 2;           put( 22, 14, " you got " );           printf("%4d",fb[ killed ] * 2 );           killed++;           flush();           tsleep (SEC256THS + (2<<8));           put( 22, 14, "               ");           inmo( j );        } else {           left--;           sput( FRY, FRX );           ft = 0;           mesg( it );           men();           if( left == LEFT ) {                pl.bw = it;                set( 16 );           }           kilall();        }} /*    End of check   */flush(){   if( (fflush( stdout ) == ERROR) ) {       printf( "ERROR #%d, FLUSH!\n", errno );       echo();       exit( 1 );   }}clear(){   printf("%s",CL);}sput( y, x )register x,y;{   pos( y, x-1 );   printf("%c%c%c",s[x-1][y],s[x][y],s[x+1][y] );}putmo( it )register it;{   if( tim > 0  && t[it].gh ) {      put( t[it].y, t[it].x-1, M4 );      if( tim < 15 )         put( t[it].y, t[it].x-1, mons[it] );   } else      put( t[it].y, t[it].x-1,mons[it] );}erase(x,y)register x,y;{    pos( y, x-1 );    printf("%c %c", s[x-1][y],s[x+1][y] );}swap( px ){   temp.uid = hi[px].uid;   temp.bw = hi[px].bw;   temp.lev = hi[px].lev;   temp.codes = hi[px].codes;   temp.score = hi[px].score;   strcpy( temp.namestr, hi[px].namestr );   hi[px].uid = hi[px+1].uid;   hi[px].bw = hi[px+1].bw;   hi[px].lev = hi[px+1].lev;   hi[px].codes = hi[px+1].codes;   hi[px].score = hi[px+1].score;   strcpy( hi[px].namestr,hi[px+1].namestr );   hi[px+1].uid = temp.uid;   hi[px+1].lev = temp.lev;   hi[px+1].codes = temp.codes;   hi[px+1].bw = temp.bw;   hi[px+1].score = temp.score;  strcpy( hi[px+1].namestr, temp.namestr );}/**	tgoto( y, x )*	register x,y;*	{*	  printf( CM, y, x );*	}*/copy( px )int px;{  hi[px].lev = pl.lev;  hi[px].uid = pl.uid;  hi[px].codes = pl.codes;  hi[px].score = pl.score;  strcpy( hi[px].namestr, pl.namestr );  hi[px].bw = pl.bw;}