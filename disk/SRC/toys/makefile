* misc OS-9/68k makefileODIR =		/h0/cmds/gamesRDIR =		RELSLIBS =		screen.r rand.r /dd/lib/usr.l /dd/lib/termlib.lCFLAGS =	-qgixm=8k -t=/ddLFLAGS =	-qgixm=8k -l=/dd/lib/usr.l -l=$(RDIR)/screen.r \						-l=/dd/lib/termlib.l -l=$(RDIR)/rand.r./makefile:  joke newsgen pacman rain valspeak wish worms	@touch makefilejoke:		joke.r $(LIBS)newsgen:	newsgen.r ctime.r $(LIBS)	cc $(LFLAGS) $(RDIR)/newsgen.r $(RDIR)/ctime.r -f=$*pacman:		pacman.rrain:		rain.r $(LIBS)valspeak:	valspeak.r $(LIBS)wish:		wish.rworms:		worms.r $(LIBS)