* misc OS-9/68k makefileODIR =		/h0/cmds/gamesRDIR =		.LIBS =		screen.r rand.r /dd/lib/usr.l /dd/lib/termlib.lCFLAGS =	-qgixm=8k -t=/ddLFLAGS =	-qgixm=8k -l=/dd/lib/usr.l -l=$(RDIR)/screen.r \						-l=/dd/lib/termlib.l -l=$(RDIR)/rand.r./makefile: newsgen pacman rain valspeak hackwish worms	@touch makefilenewsgen:	newsgen.r ctime.r $(LIBS)	cc $(LFLAGS) $(RDIR)/newsgen.r $(RDIR)/ctime.r -f=$*pacman:		pacman.rrain:		rain.r $(LIBS)valspeak:	valspeak.r $(LIBS)* hackwish builds -qm (trap-free): a -qixm build reaches cio through trap* selectors this cio edition answers differently and its pipe to hack then* carries nothing.  No curses, so no screen/termlib.hackwish:	wish.c	cc -qm=16k -t=/dd -r=$(RDIR) wish.c	cc -qm=16k $(RDIR)/wish.r -f=$@ -n=$@worms:		worms.r $(LIBS)