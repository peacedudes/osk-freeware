## Makefile for Yahtzee 2.1## A path for the high score fileHS_FILE="$(HOME)/lib/yahtzee2.hs"# system dependent flags# Xenix - some Xenix folks may have to add -lxLDLIBS= -ltinfo -lmLDOPT= -OCCOPT= -OCPFLAGS= -DM_TERMINFO# System 5# LDLIBS= -lcurses -lm# LDOPT= -O# CCOPT= -O# BSD, SunOS 3.5# LDLIBS= -lcurses -ltermlib -lm# LDOPT= -O# CCOPT= -OSRC= admin.c book.c comp.c eval.c help.c main.c score.c scr.cOBJS= help.o main.o scr.o admin.o comp.o eval.o book.o score.oINCS= yz_consts.h yz_costs.h yz_funcs.h yz_macros.h yz_types.h port.hEXE= yahtzeePFLAGS= -DYZ_HS_FILE='$(HS_FILE)' $(CPFLAGS)CFLAGS= $(PFLAGS) $(CCOPT)all: $(EXE)$(EXE): $(OBJS)	cc $(LDOPT) -o $(EXE) $(OBJS) $(LDLIBS)comp.o: yz_costs.hlint:	lint -u $(PFLAGS) $(SRC) > lint.outclean:	rm -f $(OBJS) $(EXE)shar:	xshar README Makefile $(EXE).6 $(SRC) $(INCS) > $(EXE).shar