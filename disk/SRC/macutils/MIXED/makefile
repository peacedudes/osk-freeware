CC = ccCFLAGS = -r -dOSK -dNODOTSRCS1 =	macsave.c \	globals.c \	macbinary.c \	dir.c \	mcb.c\    fputc.cSRCS2 =	macstream.cOBJS1 =	macsave.r \	globals.r \	macbinary.r \	dir.r \	mcb.r\    fputc.rOBJS2 =	macstream.r fputc.rTNAME =	../util/transnameBNAME = ../util/backtransUNAME =	../util/utilONAME =	../fileio/wrfileINAME = ../fileio/rdfileGNAME =	../fileio/fileglobXOBJS1=	$(TNAME).r $(UNAME).r $(ONAME).r $(GNAME).rXSRCS1=	$(TNAME).c $(UNAME).c $(ONAME).c $(GNAME).cXOBJS2=	$(TNAME).r $(BNAME).r $(UNAME).r $(INAME).r $(GNAME).rXSRCS2=	$(TNAME).c $(BNAME).c $(UNAME).c $(INAME).c $(GNAME).call: macsave macstream    attr macsave -e -pe;\    attr macstream -e -pemacsave:	$(OBJS1) $(XOBJS1)	$(CC) -FD=macsave $(OBJS1) $(XOBJS1) -l=/dd/lib/blarslib.lmacstream:	$(OBJS2) $(XOBJS2)	$(CC) -FD=macstream $(OBJS2) $(XOBJS2) -l=/dd/lib/blarslib.l$(TNAME).r:	$(TNAME).c	(chd ../util; make)$(BNAME).r:	$(BNAME).c	(chd ../util; make)$(UNAME).r:	$(UNAME).c	(chd ../util; make)$(ONAME).r:	$(ONAME).c	(chd ../fileio; make)$(INAME).r:	$(INAME).c	(chd ../fileio; make)$(GNAME).r:	$(GNAME).c	(chd ../fileio; make)macsave.r:	globals.h ../util/patchlevel.h ../fileio/wrfile.h \           ../fileio/wrfileopt.h ../util/util.h macsave.c $(CC) $(CFLAGS) macsave.cglobals.r:	globals.h ../fileio/machdr.h globals.c $(CC) $(CFLAGS) globals.cmacbinary.r:	globals.h ../fileio/machdr.h ../fileio/kind.h \            ../util/util.h macbinary.c $(CC) $(CFLAGS) macbinary.cdir.r:	globals.h ../fileio/machdr.h ../fileio/wrfile.h \        ../util/util.h ../util/masks.h dir.c fputc.c $(CC) $(CFLAGS) dir.cmcb.r:	globals.h ../fileio/machdr.h ../fileio/wrfile.h \        ../util/masks.h ../util/util.h mcb.c fputc.c $(CC) $(CFLAGS) mcb.cmacstream.r:	../fileio/machdr.h ../fileio/rdfile.h ../fileio/rdfileopt.h \                ../util/patchlevel.h macstream.c $(CC) $(CFLAGS) macstream.c# For OSK only ..Somehow '#define fprintf(path,"%c",var) fputc(var,path)'# would not work in this source code ????? -DJL  fputc.r : fputc.c globals.h $(CC) $(CFLAGS) fputc.c 