CC = ccCFLAGS = -r -dNODOTSRCS  =	binhex.c dofile.cOBJS  =	binhex.r dofile.rLIB =	../crc/libcrc.lTNAME =	../util/transnameBNAME = ../util/backtransUNAME =	../util/utilINAME = ../fileio/rdfileGNAME =	../fileio/fileglobXOBJS =	$(TNAME).r $(BNAME).r $(UNAME).r $(INAME).r $(GNAME).rXSRCS =	$(TNAME).c $(BNAME).c $(UNAME).c $(INAME).c $(GNAME).cbinhex:	$(OBJS) $(XOBJS) $(LIB)	$(CC) -dOSK -FD=binhex $(OBJS) $(XOBJS) -l=$(LIB) -l=/dd/lib/blarslib.l$(LIB):	../crc/makecrc.c	(chd ../crc; make)   $(CC) $(CFLAGS) binhex.c dofile.c$(TNAME).r:	$(TNAME).c	(chd ../util; make)$(BNAME).r:	$(BNAME).c	(chd ../util; make)$(UNAME).r:	$(UNAME).c	(chd ../util; make)$(INAME).r:	$(INAME).c	(chd ../fileio; make)$(GNAME).r:	$(GNAME).c	(chd ../fileio; make)binhex.r:	../fileio/machdr.h	../fileio/rdfile.h \            ../util/patchlevel.h binhex.c  $(CC) $(CFLAGS) binhex.c dofile.r:	../fileio/machdr.h	../fileio/rdfile.h dofile.c  $(CC) $(CFLAGS) dofile.c 