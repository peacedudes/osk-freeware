cbin.r:	macunpack.h globals.h ../fileio/machdr.h ../fileio/wrfile.h \       ../fileio/kind.h	../util/util.h ../util/masks.h bin.c osk.h      $(CC) $(CFLAGS) bin.cjdw.r:	macunpack.h jdw.h globals.h	huffman.h ../fileio/wrfile.h \        ../fileio/machdr.h ../util/util.h ../util/masks.h jdw.c osk.h      $(CC) $(CFLAGS) jdw.cstf.r:	macunpack.h stf.h globals.h huffman.h ../util/curtime.h \       ../fileio/wrfile.h ../fileio/machdr.h ../util/util.h stf.c osk.h      $(CC) $(CFLAGS) stf.clzc.r:	macunpack.h globals.h lzc.h ../util/util.h osk.h \       ../fileio/machdr.h ../fileio/wrfile.h ../util/masks.h lzc.c      $(CC) $(CFLAGS) lzc.cpit.r:	macunpack.h ../fileio/fileglob.h ../fileio/wrfile.h \       ../fileio/kind.h globals.h pit.h ../fileio/machdr.h \       crc.h ../util/masks.h ../util/util.h huffman.h pit.c osk.h      $(CC) $(CFLAGS) pit.csit.r:	macunpack.h globals.h sit.h  crc.h ../util/util.h \       ../fileio/machdr.h ../fileio/wrfile.h ../fileio/kind.h \       ../util/masks.h huffman.h sit.c osk.h      $(CC) $(CFLAGS)  sit.cdia.r:	macunpack.h globals.h dia.h ../util/curtime.h \       ../util/masks.h ../fileio/machdr.h ../fileio/wrfile.h \       ../fileio/kind.h	../util/util.h dia.c osk.h      $(CC) $(CFLAGS) dia.ccpt.r:	macunpack.h globals.h cpt.h crc.h ../util/util.h \        ../fileio/machdr.h ../fileio/wrfile.h ../fileio/kind.h \        ../util/masks.h huffman.h cpt.c osk.h      $(CC) $(CFLAGS) cpt.czma.r:	macunpack.h globals.h zma.h	crc.h ../fileio/machdr.h \        ../fileio/wrfile.h ../fileio/kind.h	../util/masks.h \        ../util/util.h zma.c osk.h      $(CC) $(CFLAGS) zma.clzh.r:	macunpack.h	globals.h lzh.h crc.h ../fileio/wrfile.h \        ../fileio/machdr.h ../util/masks.h ../util/util.h \        bits_be.h lzh.c osk.h      $(CC) $(CFLAGS) lzh.cdd.r:	macunpack.h globals.h dd.h crc.h ../fileio/machdr.h \                         ../fileio/wrfile.h ../fileio/fileglob.h \        ../util/masks.h ../util/util.h dd.c osk.h      $(CC) $(CFLAGS) dd.cde_huffman.r:	macunpack.h globals.h ../util/masks.h huffman.h \               ../fileio/wrfile.h ../util/util.h de_huffman.c osk.h      $(CC) $(CFLAGS) de_huffman.cde_compress.r:	macunpack.h	globals.h ../fileio/wrfile.h \               de_compress.c osk.h      $(CC) $(CFLAGS) de_compress.cde_lzah.r:	macunpack.h	globals.h ../util/masks.h ../fileio/wrfile.h \            macunpack.h globals.h ../util/masks.h ../fileio/wrfile.h \            bits_be.h de_lzah.c osk.h      $(CC) $(CFLAGS) de_lzah.cbits_be.r:	../util/masks.h	bits_be.h bits_be.c       $(CC) $(CFLAGS) bits_be.c# fputc is only for OSKfputc.r: fputc.c globals.h      $(CC) $(CFLAGS) fputc.c