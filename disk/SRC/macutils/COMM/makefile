CC = ccCFLAGS = -r -dOSK -dNODOT -V=/dd/bsddefsSRCS1 =	tomac.c xm_to.c ym_to.c zm_to.c tty.c globals.cSRCS2 =	frommac.c xm_from.c ym_from.c zm_from.c tty.c globals.cOBJS1 =	tomac.r xm_to.r ym_to.r zm_to.r tty.r globals.rOBJS2 =	frommac.r xm_from.r ym_from.r zm_from.r tty.r globals.rLIB =	../crc/libcrc.lTNAME =	../util/transnameBNAME = ../util/backtransUNAME =	../util/utilINAME = ../fileio/rdfileONAME = ../fileio/wrfileGNAME =	../fileio/fileglobXOBJS1 =	$(TNAME).r $(BNAME).r $(UNAME).r $(INAME).r $(GNAME).rXOBJS2 =	$(TNAME).r $(UNAME).r $(ONAME).r $(GNAME).rXSRCS1 =	$(TNAME).c $(BNAME).c $(UNAME).c $(INAME).c $(GNAME).cXSRCS2 =	$(TNAME).c $(UNAME).c $(ONAME).c $(GNAME).ctomac:	$(OBJS1) $(XOBJS1)	$(CC) -FD=tomac $(OBJS1) $(XOBJS1)frommac:	$(OBJS2) $(XOBJS2)	$(CC) -FD=frommac $(OBJS2) $(XOBJS2)$(LIB):	../crc/makecrc.c	(chd ../crc; make )$(TNAME).r:	$(TNAME).c	(chd ../util; make )$(BNAME).r:	$(BNAME).c	(chd ../util; make )$(UNAME).r:	$(UNAME).c	(chd ../util; make )$(INAME).r:	$(INAME).c	(chd ../fileio; make )$(ONAME).r:	$(ONAME).c	(chd ../fileio; make )$(GNAME).r:	$(GNAME).c	(chd ../fileio; make )tomac.r:	comm.h ../fileio/machdr.h ../fileio/rdfile.h \            ../util/patchlevel.h globals.h tomac.c$(CC) $(CFLAGS) tomac.cxm_to.r:	comm.h ../fileio/machdr.h ../fileio/rdfile.h \           ../util/masks.h globals.h protocol.h xm_to.c$(CC) $(CFLAGS) xm_to.cym_to.r:	comm.h ym_to.c$(CC) $(CFLAGS) ym_to.czm_to.r:	comm.h zm_to.c$(CC) $(CFLAGS) zm_to.cfrommac.r:	comm.h ../util/patchlevel.h ../fileio/machdr.h \            globals.h ../fileio/fileglob.h ../fileio/wrfile.h \            frommac.c$(CC) $(CFLAGS) frommac.cxm_from.r:	comm.h ../fileio/machdr.h ../fileio/wrfile.h \           ../util/masks.h globals.h protocol.h xm_from.c$(CC) $(CFLAGS) xm_from.cym_from.r:	comm.h ym_from.c$(CC) $(CFLAGS) ym_from.czm_from.r:	comm.h zm_from.c$(CC) $(CFLAGS) zm_from.cglobals.r:	globals.h globals.c$(CC) $(CFLAGS) globals.ctty.r:	../util/masks.h protocol.h  globals.h tty.c$(CC) $(CFLAGS) tty.c