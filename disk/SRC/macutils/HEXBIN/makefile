CC = ccCFLAGS= -dOSK -dNODOTSRCS =	hexbin.c dl.c hecx.c hqx.c mu.c buffer.c crc.c readline.c \        printhdr.c globals.cOBJS =	hexbin.r dl.r hecx.r hqx.r mu.r	buffer.r crc.r readline.r \        printhdr.r  globals.rLIB =	../crc/libcrc.lTNAME =	../util/transnameBNAME =	../util/backtransUNAME =	../util/utilONAME =	../fileio/wrfileGNAME =	../fileio/fileglobXOBJS =	$(TNAME).r $(BNAME).r $(UNAME).r $(ONAME).r $(GNAME).rXSRCS =	$(TNAME).c $(BNAME).c $(UNAME).c $(ONAME).c $(GNAME).cCRCS =	../crc/binhex.chexbin:	$(OBJS) $(LIB) $(XOBJS) 	$(CC) $(CFLAGS) -FD=hexbin $(OBJS) $(XOBJS) -l=$(LIB)\          -l=/dd/lib/blarslib.l$(LIB):	../crc/makecrc.c	(chd ../crc; make)$(TNAME).r:	$(TNAME).c	(chd ../util; make)$(BNAME).r:	$(BNAME).c	(chd ../util; make)$(UNAME).r:	$(UNAME).c	(chd ../util; make)$(ONAME).r:	$(ONAME).c	(chd ../fileio; make)$(GNAME).r:	$(GNAME).c	(chd ../fileio; make)hexbin.r:	globals.h crc.h readline.h ../util/masks.h ../util/util.h\            ../util/patchlevel.h ../fileio/wrfile.h ../fileio/wrfileopt.h\            ../fileio/machdr.h ../fileio/kind.h	../util/curtime.h\            hexbin.h hexbin.c     $(CC) $(CFLAGS) -r hexbin.cdl.r:	hexbin.h globals.h crc.h readline.h ../fileio/machdr.h \        ../fileio/wrfile.h ../util/util.h buffer.h printhdr.h     $(CC) $(CFLAGS) -r dl.checx.r:	hexbin.h globals.h crc.h readline.h ../util/masks.h \        ../util/util.h ../fileio/machdr.h ../fileio/wrfile.h\        buffer.h printhdr.h hecx.c     $(CC) $(CFLAGS) -r hecx.chqx.r:	hexbin.h globals.h readline.h crc.h buffer.h ../fileio/machdr.h\        ../fileio/wrfile.h ../util/util.h printhdr.h hqx.c     $(CC) $(CFLAGS) -r hqx.cmu.r:	hexbin.h globals.h readline.h ../util/masks.h ../util/util.h\        ../fileio/machdr.h ../fileio/wrfile.h buffer.h 	printhdr.h mu.c     $(CC) $(CFLAGS) -r mu.cbuffer.r:	globals.h ../util/util.h buffer.h ../fileio/wrfile.h buffer.c     $(CC) $(CFLAGS) -r buffer.ccrc.r:	hexbin.h crc.h ../util/masks.h globals.h crc.c     $(CC) $(CFLAGS) -r crc.creadline.r:	readline.h globals.h printhdr.h globals.h readline.c     $(CC) $(CFLAGS) -r readline.cglobals.r:	globals.h ../fileio/machdr.h ../fileio/wrfile.h\            ../fileio/kind.h globals.c     $(CC) $(CFLAGS) -r globals.c