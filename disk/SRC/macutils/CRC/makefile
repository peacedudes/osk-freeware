CC = ccCFLAGS = -dNODOTCRCC =	arc.c ccitt.c kermit.c binhex.c ccitt32.c zip.cCRCO =	arc.r ccitt.r kermit.r binhex.r ccitt32.r zip.rlibcrc.l:	$(CRCO)    rm -f libcrc.l;\    merge $(CRCO) >libcrc.l;\    attr libcrc.l -pw -pr -w -r$(CRCC):	makecrc	./makecrc;\   $(CC) $(CFLAGS) $(CRCC)makecrc:	makecrc.r	$(CC) makecrc.c -FD=./makecrcarc.r:	arc.cccitt.r:	ccitt.ckermit.r:	kermit.cbinhex.r:	binhex.cccitt32.r:	ccitt32.czip.r:		zip.c