##    START OF LOCAL CONFIGURATION INFORMATION#    change the following lines to reflect your local environment###    name of the directory into which the binary should be installed#        used only when you use  'make install'#INSDIR=/usr/tmp##    choose one from each of 1) 2) and 3) below###    1) SELECTION OF OPERATING SYSTEM VARIETY#        choose a) b) or c)## a) for BSD derivitives, enable the following lineOSFLAG=# b) for XENIX systems, enable the following line#OSFLAG=-DXENIX# b) for other A.T. and T. derivitives, enable the following line#OSFLAG=-DATT##     2) SELECTION OF TERMINAL CONTROL LIBRARY#        choose either of a) b) or c)## a) if you use termcap, enable the following linesTFLAG=-DM_TERMCAPTLIB=/h0/lib/termlib.l# b) if you are using terminfo on a XENIX machine, enable the following lines#TFLAG=-DM_TERMINFO#TLIB=tinfo# c) if you use terminfo on any other type of machine,#    enable the following lines#TFLAG=-DM_TERMINFO#TLIB=curses.l##    3) SELECTION OF WINDOW MANAGER AVAILABILITY## if you have the Bellcore's MGR window manager, enable the following linesVISFLAG=#VISFLAG=-DMGRVISLIB=#VISLIB=/usr/public/pkg/mgr/lib/libmgr.aMGRINCDIR=#MGRINCDIR=-I/usr/public/pkg/mgr/includeMGRINCS=#MGRINCS=$(MGRINC)/dump.h $(MGRINC)/term.h $(MGRINC)/restart.h $(MGRINC)/window.hREV=CIMSG=##    END OF LOCAL CONFIGRATION INFORMATION, the rest of this#    file may be modified only at great risk#        -- caveat hackor##                        Copyright (c) 1988 Bellcore#                            All Rights Reserved#       Permission is granted to copy or use this program, EXCEPT that it#       may not be sold for profit, the copyright notice must be reproduced#       on copies, and credit should be given to Bellcore where it is due.#       BELLCORE MAKES NO WARRANTY AND ACCEPTS NO LIABILITY FOR THIS PROGRAM.#CC=ccOBJ= spiff.r output.r compare.r float.r strings.r exact.r miller.r parse.r\     command.r comment.r tol.r line.r token.r floatrep.r misc.r visual.rCFILES= spiff.c output.c compare.c float.c strings.c exact.c miller.c parse.c   command.c comment.c tol.c line.c floatrep.c token.c misc.c visual.cHFILES=misc.h strings.h line.h float.h floatrep.h tol.h command.h comment.h\     token.h edit.h parse.h compare.h flagdefs.h exact.h miller.h visual.h output.hOTHER=README makefile Sample.1 Sample.2 Sample.3 Sample.4 paper.ms paper.rMANPAGE=spiff.1CFLAGS= $(OSFLAG) $(TFLAG) $(VISFLAG) -t=/r0 -bg -i -qLFLAGS= -qRDIR = RELSdefault: spiffspiff: $(OBJ)	chd $(RDIR); $(CC) $(CFLAGS) $(LFLAGS) -n=spiff -f=spiff $(OBJ)\			$(VISLIB) -l=$(TLIB) -l=/h0/lib/unix.l## if you don't have the unix.l library, remove the above line and # append the file 'isatty.c' to the file 'output.c'#spiff.r: spiff.c misc.h line.h token.h tol.h command.h edit.h parse.h compare.h flagdefs.h exact.h miller.h visual.hvisual.r: visual.c misc.h visual.h $(MGRINCS)    $(CC) $(CFLAGS) $(MGRINCDIR) visual.cmisc.r: misc.c visual.h misc.hparse.r:  parse.c misc.h line.h command.h float.h tol.h comment.h parse.h\          token.h flagdefs.h#   @echo compiler may report 4 statement not reached warning messages for#         parse.c    $(CC) $(CFLAGS) parse.ccommand.r: command.c float.h tol.h misc.hcomment.r: comment.c misc.h comment.htol.r: tol.c tol.h float.houtput.r: output.c output.h misc.h edit.h flagdefs.hcompare.r: compare.c misc.h strings.h float.h tol.h token.h line.h compare.h    flagdefs.h#   @echo compiler may report 1 statement not reached warning message for#   compare.c    $(CC) $(CFLAGS) compare.cfloat.r: float.c misc.h strings.h float.h floatrep.hfloatrep.r: floatrep.c misc.h strings.h floatrep.hstrings.r: strings.c  misc.h strings.hexact.r: exact.c exact.h misc.h edit.hmiller.r: miller.c miller.h misc.h edit.h token.htoken.r: token.c token.h misc.hline.r: line.c line.h misc.hclean:    rm -f *.rclobber: clean    rm -f spiffci:    ci -l -q  '-m $(CIMSG)' $(CFILES) $(HFILES) $(OTHER) $(MANPAGE)col:    co -l  $(CFILES) $(HFILES) $(OTHER) $(MANPAGE)cirev:    ci -l -r$(REV)  '-m $(CIMSG)' $(CFILES) $(HFILES) $(OTHER) $(MANPAGE)cirel:    ci -l -q  -sRel  $(CFILES) $(HFILES) $(OTHER) $(MANPAGE)lint:    lint  $(CFLAGS) $(CFILES)#cpio:#   for i in $(CFILES) $(HFILES) $(OTHER) $(MANPAGE); do echo $$i; done | cpio  -ocv  > spiff.cpio#cmd:#   -$(CMD) $(CFILES) $(HFILES) $(OTHER) $(MANPAGE)install:    mv spiff $(INSDIR)/bin    cp $(MANPAGE) $(INSDIR)/man/man1