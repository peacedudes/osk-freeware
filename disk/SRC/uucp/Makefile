## Makefile for UUCP package##TEMP     = /r0TEMP     = .EDTN     = 3CHDRS    =CDEFS    = -dLPWD -dMTSMONMEM      = 16kUMEM     = 64K# Debug on#DBG      = -g# Debug onDBG      =# if you want to link using 'cio' or 'csl'TRAPLIB  = -i# no traplib#TRAPLIB  =# Stock Microware CCC       = ccCOPTS    = -qt=$(TEMP) -sRFLAG    = -rSTICKY   = -bgLOPTS    = $(STICKY) $(TRAPLIB) -e=$(EDTN) -M=$(MEM)UOPTS    = $(STICKY) $(TRAPLIB) -e=$(EDTN) -M=$(UMEM)LIBS     =VSPRINTF = vsprintf.rSSBRKSRC = ssbreak.c# Ultra C - cc executive changed to ucc with "fixmod -un=ucc cc"#CC       = ucc#CPUOPT   = -tp=cpu32#CPUOPT   =#COPTS    = -bc -td=$(TEMP) -r -b $(CPUOPT)#RFLAG    = -eas#STICKY   = -ol=S#LOPTS    = -bc $(STICKY) $(TRAPLIB) -ol=e=$(EDTN) -ol=M=$(MEM) $(CPUOPT)#UOPTS    = -bc $(STICKY) $(TRAPLIB) -ol=e=$(EDTN) -ol=M=$(UMEM) $(CPUOPT)#LIBS     = -l=sys_clib.l#LIBS     =#VSPRINTF =#SSBRKSRC = ssbreak.aCFLAGS   = $(COPTS) $(CDEFS) $(CHDRS) $(DBG)RDIR     = RELSODIR     = ../BINUFLAGS   = $(UOPTS) $(LIBS) $(DBG)LFLAGS   = $(LOPTS) $(LIBS) $(DBG)# if Getopt is not in your libsGETOPT   = getopt.r#GETOPT   =MISC     = Makefile Readme Changes #DOC BIN CONFIG HDRS     = dcp.h host.h protg.h uucp.h pwd.h varargs.h dev.h stat.hSRCS     = dcp.c dcpadd.c dcpfpkt.c dcpgpkt.c dcpio.c dcpmisc.c dcpsys.c \           dcpxfer.c disable.c enable.c exptilde.c getargs.c getconfig.c \           getseq.c lmail.c ln.c mail.c mfgets.c oskmail.c pd.c perms.c \           pwent.c pwtest.c rmail.c ssbreak.c ssbreak.a turnport.c \           uuclean.c uucp.c uulog.c uuname.c uupoll.c uustat.c uux.c \           uuxqt.c validuser.c vsprintf.c stricmp.c getopt.cOBJS     = dcp.r dcpsys.r dcpxfer.r dcpgpkt.r dcpfpkt.r dcpmisc.r dcpio.r \           dcpadd.r ssbreak.r exptilde.r $(VSPRINTF)UTLOBJS  = getconfig.r mfgets.r pwent.r stricmp.r $(GETOPT)UUCPOBJS = uucp.r getseq.r exptilde.r pd.r $(UTLOBJS)UUMODS   = uucico uux uuxqt uucp uupoll uuclean uulog uunameMAILMODS = lmail mail# rmailMTSMODS  = enable disableGLOBCMDS = mail uulog uuname uucpSYSCMDS  = uucico uux uuxqt uupoll uuclean lmail $(MTSMODS)# rmailSYSDIR   = /dd/etc/cmdsGLOBDIR  = /dd/cmdsall.date: $(UUMODS) $(MAILMODS) $(MTSMODS)  @touch all.datearc:	lha -ur uucp.lzh $(SRCS) $(HDRS) $(MISC)install:    chd $(ODIR) ; copy -rw=$(SYSDIR)  $(SYSCMDS)    chd $(ODIR) ; copy -rw=$(GLOBDIR) $(GLOBCMDS)clobber: clean    chd $(ODIR) ; del *clean:    chd $(RDIR) ; del *.ruucico:	$(OBJS) $(UTLOBJS) ln.r  chd $(RDIR); $(CC) $(UFLAGS) $(OBJS) $(UTLOBJS) ln.r -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uux: uux.r $(UTLOBJS) getseq.r  chd $(RDIR); $(CC) $(LFLAGS) uux.r getseq.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uuxqt: uuxqt.r $(UTLOBJS) perms.r  chd $(RDIR); $(CC) $(LFLAGS) uuxqt.r perms.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uucp: $(UUCPOBJS)  chd $(RDIR); $(CC) $(LFLAGS) $(UUCPOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uupoll: uupoll.r $(UTLOBJS)  chd $(RDIR); $(CC) $(LFLAGS) uupoll.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uulog: uulog.r $(UTLOBJS)  chd $(RDIR); $(CC) $(LFLAGS) uulog.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uuname: uuname.r $(UTLOBJS)  chd $(RDIR); $(CC) $(LFLAGS) uuname.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uuclean: uuclean.r $(UTLOBJS) ln.r popen.r  chd $(RDIR); $(CC) $(LFLAGS) uuclean.r $(UTLOBJS) ln.r popen.r -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@lmail		: lmail.r $(UTLOBJS)  chd $(RDIR); $(CC) $(LFLAGS) lmail.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@mail		: mail.r $(UTLOBJS)  chd $(RDIR); $(CC) $(LFLAGS) mail.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@rmail		: rmail.r mfgets.r  chd $(RDIR); $(CC) $(LFLAGS) rmail.r mfgets.r -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@enable		: enable.r   chd $(RDIR); $(CC) $(LFLAGS) enable.r -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@disable		: disable.r  chd $(RDIR); $(CC) $(LFLAGS) disable.r -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@ssbreak.r		: $(SSBRKSRC)ln.r            : ln.c   $(CC) ln.c -dLINK $(CFLAGS) $(RFLAG)=$(RDIR)dcp.r			: dcp.c dcp.h host.h uucp.hdcpadd.r		: dcpadd.c uucp.hdcpfpkt.r		: dcpfpkt.c dcp.h host.hdcpgpkt.r		: dcpgpkt.c dcp.h host.h protg.hdcpio.r			: dcpio.c dcp.h host.h uucp.hdcpmisc.r		: dcpmisc.c dcp.h host.hdcpsys.r		: dcpsys.c dcp.h host.hdcpxfer.r		: dcpxfer.c dcp.h host.h uucp.hdial.r			: dial.cdisable.r		: disable.c turnport.c dev.henable.r		: enable.c turnport.c dev.hexptilde.r		: exptilde.c uucp.h pwd.h validuser.cgetargs.r		: getargs.cgetconfig.r		: getconfig.c pwd.h uucp.hgetseq.r		: getseq.c uucp.hlmail.r			: lmail.c pwd.h uucp.hmfgets.r		: mfgets.cpd.r            : pd.cperms.r         : perms.c uucp.hpwent.r			: pwent.c pwd.hpwtest.r		: pwtest.crmail.r			: rmail.c oskmail.cstricmp.r       : stricmp.cmail.r          : mail.c oskmail.cuuclean.r		: uuclean.c uucp.huucp.r			: uucp.c uucp.h pwd.huulog.r			: uulog.c uucp.huuname.r		: uuname.c uucp.huupoll.r		: uupoll.c uucp.huustat.r		: uustat.c uucp.huux.r			: uux.c pwd.h uucp.huuxqt.r			: uuxqt.c uucp.hvaliduser.r		: validuser.cvsprintf.r      : vsprintf.c varargs.hpopen.r         : popen.cgetopt.r        : getopt.c