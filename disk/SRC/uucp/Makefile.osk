## Makefile for UUCP package#TEMP     = /r0CC       = ccCOPTS    = -qst=$(TEMP)CHDRS    =CDEFS    = -dLPWD -dMTSMONCFLAGS   = $(COPTS) $(CDEFS) $(CHDRS)RDIR     = RELSODIR     = ../BINEDTN     = 3NMEM     = -m=64KUOPTS    = -m=64K -bg -e=$(EDTN)LOPTS    = -m=16K -bg -e=$(EDTN) -iLIBS     =UFLAGS   = $(UOPTS) $(LIBS)LFLAGS   = $(LOPTS) $(LIBS)MISC     = Makefile Readme Changes #DOC BIN CONFIG HDRS     = dcp.h host.h protg.h uucp.h pwd.h varargs.h dev.h stat.hSRCS     = dcp.c dcpadd.c dcpfpkt.c dcpgpkt.c dcpio.c dcpmisc.c dcpsys.c \           dcpxfer.c disable.c enable.c exptilde.c getargs.c getconfig.c \           getseq.c lmail.c ln.c mail.c mfgets.c oskmail.c pd.c perms.c \           pwent.c pwtest.c rmail.c ssbreak.c turnport.c uuclean.c \           uucp.c uulog.c uuname.c uupoll.c uustat.c uux.c uuxqt.c \           validuser.c vsprintf.c stricmp.cOBJS     = dcp.r dcpsys.r dcpxfer.r dcpgpkt.r dcpfpkt.r dcpmisc.r dcpio.r \           dcpadd.r ssbreak.r exptilde.r vsprintf.rUTLOBJS  = getconfig.r mfgets.r pwent.r stricmp.rUUCPOBJS = uucp.r getseq.r exptilde.r pd.r $(UTLOBJS)UUMODS   = uucico uux uuxqt uucp uupoll uuclean uulog uunameMAILMODS = lmail mail#rmailMTSMODS  = enable disableGLOBCMDS = mail uulog uuname uucpSYSCMDS  = uucico uux uuxqt uupoll uuclean lmail $(MTSMODS)#rmailSYSDIR   = /dd/etc/cmdsGLOBDIR  = /dd/cmdsall.date: $(UUMODS) $(MAILMODS) $(MTSMODS)  @touch all.datearc:	lha -ur uucp.lzh $(SRCS) $(HDRS) $(MISC)install:    chd $(ODIR) ; copy -rw=$(SYSDIR)  $(SYSCMDS)    chd $(ODIR) ; copy -rw=$(GLOBDIR) $(GLOBCMDS)clobber: clean    chd $(ODIR) ; del *clean:    chd $(RDIR) ; del *.ruucico:	$(OBJS) $(UTLOBJS) ln.r  chd $(RDIR); $(CC) $(UFLAGS) $(OBJS) $(UTLOBJS) ln.r -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uux: uux.r $(UTLOBJS) getseq.r  chd $(RDIR); $(CC) $(LFLAGS) uux.r getseq.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uuxqt: uuxqt.r $(UTLOBJS) perms.r  chd $(RDIR); $(CC) $(LFLAGS) uuxqt.r perms.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uucp: $(UUCPOBJS)  chd $(RDIR); $(CC) $(LFLAGS) $(UUCPOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uupoll: uupoll.r $(UTLOBJS)  chd $(RDIR); $(CC) $(LFLAGS) uupoll.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uulog: uulog.r $(UTLOBJS)  chd $(RDIR); $(CC) $(LFLAGS) uulog.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uuname: uuname.r $(UTLOBJS)  chd $(RDIR); $(CC) $(LFLAGS) uuname.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@uuclean: uuclean.r $(UTLOBJS) ln.r  chd $(RDIR); $(CC) $(LFLAGS) uuclean.r ln.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@lmail		: lmail.r $(UTLOBJS)  chd $(RDIR); $(CC) $(LFLAGS) lmail.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@mail		: mail.r $(UTLOBJS)  chd $(RDIR); $(CC) $(LFLAGS) mail.r $(UTLOBJS) -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@rmail		: rmail.r mfgets.r  chd $(RDIR); $(CC) $(LFLAGS) rmail.r mfgets.r -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@enable		: enable.r   chd $(RDIR); $(CC) $(LFLAGS) enable.r -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@disable		: disable.r  chd $(RDIR); $(CC) $(LFLAGS) disable.r -fd=../$(ODIR)/$@  attr -e -pe $(ODIR)/$@ln.r            : ln.c   $(CC) ln.c -dLINK $(CFLAGS) -r=$(RDIR)dcp.r			: dcp.c dcp.h host.h uucp.hdcpadd.r		: dcpadd.c uucp.hdcpfpkt.r		: dcpfpkt.c dcp.h host.hdcpgpkt.r		: dcpgpkt.c dcp.h host.h protg.hdcpio.r			: dcpio.c dcp.h host.h uucp.hdcpmisc.r		: dcpmisc.c dcp.h host.hdcpsys.r		: dcpsys.c dcp.h host.hdcpxfer.r		: dcpxfer.c dcp.h host.h uucp.hdial.r			: dial.cdisable.r		: disable.c turnport.c dev.henable.r		: enable.c turnport.c dev.hexptilde.r		: exptilde.c uucp.h pwd.h validuser.cgetargs.r		: getargs.cgetconfig.r		: getconfig.c pwd.h uucp.hgetseq.r		: getseq.c uucp.hlmail.r			: lmail.c pwd.h uucp.hmfgets.r		: mfgets.cpd.r            : pd.cperms.r         : perms.c uucp.hpwent.r			: pwent.c pwd.hpwtest.r		: pwtest.crmail.r			: rmail.c oskmail.cstricmp.r       : stricmp.cmail.r          : mail.c oskmail.cssbreak.r		: ssbreak.cuuclean.r		: uuclean.c uucp.huucp.r			: uucp.c uucp.h pwd.huulog.r			: uulog.c uucp.huuname.r		: uuname.c uucp.huupoll.r		: uupoll.c uucp.huustat.r		: uustat.c uucp.huux.r			: uux.c pwd.h uucp.huuxqt.r			: uuxqt.c uucp.hvaliduser.r		: validuser.cvsprintf.r      : vsprintf.c varargs.h