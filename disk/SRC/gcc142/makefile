LOC =OBSTACK = obstack.rLOBSTACK = -l=obstack.r# Dependency on obstack, alloca, malloc or whatever library facilities# are not installed in the system libraries.LIBDEPS= $(OBSTACK) $(ALLOCA) $(MALLOC) $(CLIB)# How to link with both our special library facilities# and the system's installed libraries.LIBS = $(OBSTACK) $(ALLOCA) $(MALLOC) $(CLIB)LLIBS = $(LOBSTACK) $(LALLOCA) $(LMALLOC) $(LCLIB)# Language-specific object files for C.C_OBJS = c_parse.tab.r c_decl.r c_typeck.r c_convert.r# Language-independent object files.OBJS1 = toplev.r version.r tree.r print_tree.r stor_layout.r \	fold_const.r rtl.rOBJS2 = rtlanal.r expr.r stmt.r expmed.r explow.r optabs.r \	varasm.r symout.r dbxout.r sdbout.rOBJS3 = emit_rtl.r insn_emit.r integrate.r jump.r cse.r \	loop.r flow.r stupid.rOBJS4 = combine.r regclass.r local_alloc.r global_alloc.r \	reload.r reload1.rOBJS5 = caller_save.r insn_peep.r final.r recog.r insn_recog.r \	insn_extract.rOBJS6 = insn_output.rOBJS  = $(OBJS1) $(OBJS2) $(OBJS3) $(OBJS4) $(OBJS5) $(OBJS6)# Library members defined in gnulib.c# Don't change order of names.  (A.S.)# Fortunately, output of MicroWare's c68 does not use d2 and d3 in # _eprintf, _builtin_new, _builtin_gNew and _builtin_del.LIBFUNCS = _eprintf _umulsi3 _mulsi3 _udivsi3 _divsi3 _umodsi3 _modsi3 \  _lshrsi3 _lshlsi3 _ashrsi3 _ashlsi3 _divdf3 _muldf3 _negdf2 _adddf3 \  _subdf3 _cmpdf2 _fixunsdfsi _fixdfsi _floatsidf _truncdfsf2 _extendsfdf2 \  _addsf3 _negsf2 _subsf3 _cmpsf2 _mulsf3 _divsf3 _builtin_new _builtin_gNew \  _builtin_del _stack_check# Library members defined in gnulib2.c.# Don't change order of names.  (A.S.)LIB2FUNCS = _anddi3 _ashldi3 _divdi3 _udivdi3 _fixdfdi _fixunsdfdi _adddi3 \  _floatdidf _ashrdi3 _lshldi3 _subdi3 _iordi3 _lshrdi3 _moddi3 _cmpdi2 \  _negdi2 _umoddi3 _bdiv _muldi3 _one_cmpldi2 _ucmpdi2 _varargs _xordi3# Header files that are made available to programs compiled with gcc.USER_H = stddef.h stdarg.h assert.h limits.h va_osk.h# If you want to recompile everything, just do rm *.o.CONFIG_H = config.h tm.h#CONFIG_H =RTL_H = rtl.h rtl.def machmode.defTREE_H = tree.h real.h tree.def machmode.def# system libraries to useSYSLIBS= -l=../gnulib.l -l=$(HOST_LIBDIR)/cio.l -l=$(HOST_LIBDIR)/clibn.l \	-l=$(HOST_LIBDIR)/math.l -l=$(HOST_LIBDIR)/sys.l#SYSLIBS= -l=../gnulib.l -l=$(HOST_LIBDIR)/cio.l -l=$(HOST_LIBDIR)/clibn.l \#	-l=$(HOST_LIBDIR)/math.l -l=$(HOST_LIBDIR)/sys.l# Generate all objectsmake.date: cc1 ccc gcc    @touch make.date	@echo done.# Making compiler drivergcc: gccosk.r version.r $(LIBDEPS)	chd $(RDIR);$(LC) #32K -o=$(ODIR)/gcc -ga -S -e=$(GCCED) -M=32K \	$(HOST_LIBDIR)/cstart.r gccosk.r version.r $(LLIBS) $(SYSLIBS) \ 	-sm >-$*.map# Making the preprocessorccc: cccp.r cexp.r version.r $(LIBDEPS)	chd $(RDIR);$(LC) #32K -o=$(ODIR)/cccp -ga -S -e=$(CCCPED) -M=32K \	$(HOST_LIBDIR)/cstart.r cccp.r cexp.r version.r $(LLIBS) $(SYSLIBS) \	-sm >-$*.map	@touch $(ABS)/ccc# Making the compiler## `echo -n': Command buffer of OSK's shell is too small (512bytes) to#            use $(OBJS) directory.# `l68'    : If linker l68 is called from $(CC), then l68's stack overflows.cc1: $(C_OBJS) $(OBJS) $(LIBDEPS)	@echo -n $(HOST_LIBDIR)/cstart.r>-$(RDIR)/rof.names	@echo -n $(C_OBJS)>+$(RDIR)/rof.names	@echo -n $(OBJS1)>+$(RDIR)/rof.names	@echo -n $(OBJS2)>+$(RDIR)/rof.names	@echo -n $(OBJS3)>+$(RDIR)/rof.names	@echo -n $(OBJS4)>+$(RDIR)/rof.names	@echo -n $(OBJS5)>+$(RDIR)/rof.names	@echo -n $(OBJS6)>+$(RDIR)/rof.names	chd $(RDIR);$(LC) #32K -z=rof.names -o=$(ODIR)/cc1 -ga -S -e=$(CC1ED) -M=7K \	$(LLIBS) $(SYSLIBS) -sm >-$*.map	@echo -r "Compilation finished at " ; datecexp.r: cexp.c $(CONFIG_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r cexp.ccexp.c: cexp.y	$(BISON) -o cexp.c cexp.ycccp.r: cccp.c $(CONFIG_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r cccp.cgccosk.r: gccosk.c $(CONFIG_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r gccosk.c# C language specific files.c_parse.tab.r : c_parse.tab.c $(CONFIG_H) $(TREE_H) c_parse.h c_tree.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r c_parse.tab.cc_parse.tab.c : c_parse.y	$(BISON) $(BISONFLAGS) c_parse.yc_decl.r : c_decl.c $(CONFIG_H) $(TREE_H) c_tree.h c_parse.h flags.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68_1) $(RF) -o $(RDIR)/$*.r c_decl.cc_typeck.r : c_typeck.c $(CONFIG_H) $(TREE_H) c_tree.h flags.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r c_typeck.cc_convert.r : c_convert.c $(CONFIG_H) $(TREE_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r c_convert.c# Language-independent files.tree.r : tree.c $(CONFIG_H) $(TREE_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r tree.cprint_tree.r : print_tree.c $(CONFIG_H) $(TREE_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r print_tree.cstor_layout.r : stor_layout.c $(CONFIG_H) $(TREE_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r stor_layout.cfold_const.r : fold_const.c $(CONFIG_H) $(TREE_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r fold_const.ctoplev.r : toplev.c $(CONFIG_H) $(TREE_H) flags.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r toplev.crtl.r : rtl.c $(CONFIG_H) $(RTL_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r rtl.crtlanal.r : rtlanal.c $(CONFIG_H) $(RTL_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r rtlanal.cvarasm.r : varasm.c $(CONFIG_H) $(TREE_H) $(RTL_H) flags.h expr.h \  insn_codes.h hard_reg_set.h	-really_new $(RDIR)/$@ $? insn_codes.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r varasm.cstmt.r : stmt.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h insn_flags.h expr.h \  insn_config.h regs.h insn_codes.h recog.h	-really_new $(RDIR)/$@ $? insn_flags.h insn_config.h insn_codes.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r stmt.cexpr.r : expr.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h insn_flags.h \  insn_codes.h expr.h insn_config.h recog.h	-really_new $(RDIR)/$@ $? insn_flags.h insn_codes.h insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r expr.cexpmed.r : expmed.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h insn_flags.h \  insn_codes.h expr.h insn_config.h recog.h	-really_new $(RDIR)/$@ $? insn_flags.h insn_codes.h insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r expmed.cexplow.r : explow.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h expr.h \  insn_codes.h	-really_new $(RDIR)/$@ $? insn_codes.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r explow.coptabs.r : optabs.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h insn_flags.h \  insn_codes.h expr.h insn_config.h recog.h	-really_new $(RDIR)/$@ $? insn_flags.h insn_codes.h insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r optabs.csymout.r : symout.c $(CONFIG_H) $(TREE_H) $(RTL_H) symseg.h gdbfiles.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r symout.cdbxout.r : dbxout.c $(CONFIG_H) $(TREE_H) $(RTL_H) flags.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r dbxout.csdbout.r : sdbout.c $(CONFIG_H) $(TREE_H) $(RTL_H) c_tree.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r sdbout.cemit_rtl.r : emit_rtl.c $(CONFIG_H) $(RTL_H) regs.h insn_config.h real.h	-really_new $(RDIR)/$@ $? insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r emit_rtl.cintegrate.r : integrate.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h expr.h \  insn_flags.h insn_codes.h	-really_new $(RDIR)/$@ $? insn_flags.h insn_codes.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r integrate.cjump.r : jump.c $(CONFIG_H) $(RTL_H) flags.h regs.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r jump.cstupid.r : stupid.c $(CONFIG_H) $(RTL_H) regs.h hard_reg_set.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r stupid.ccse.r : cse.c $(CONFIG_H) $(RTL_H) regs.h hard_reg_set.h flags.h real.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r cse.cloop.r : loop.c $(CONFIG_H) $(RTL_H) insn_config.h insn_codes.h \  regs.h recog.h flags.h expr.h	-really_new $(RDIR)/$@ $? insn_config.h insn_codes.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r loop.cflow.r : flow.c $(CONFIG_H) $(RTL_H) basic_block.h regs.h hard_reg_set.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r flow.ccombine.r : combine.c $(CONFIG_H) $(RTL_H) flags.h  \  insn_config.h regs.h basic_block.h recog.h	-really_new $(RDIR)/$@ $? insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r combine.cregclass.r : regclass.c $(CONFIG_H) $(RTL_H) flags.h regs.h \  insn_config.h recog.h hard_reg_set.h	-really_new $(RDIR)/$@ $? insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r regclass.clocal_alloc.r : local_alloc.c $(CONFIG_H) $(RTL_H) basic_block.h regs.h \  insn_config.h recog.h hard_reg_set.h	-really_new $(RDIR)/$@ $? insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r local_alloc.cglobal_alloc.r : global_alloc.c $(CONFIG_H) $(RTL_H) flags.h  \  basic_block.h regs.h hard_reg_set.h insn_config.h	-really_new $(RDIR)/$@ $? insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r global_alloc.creload.r : reload.c $(CONFIG_H) $(RTL_H)  \  reload.h recog.h hard_reg_set.h insn_config.h regs.h	-really_new $(RDIR)/$@ $? insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r reload.creload1.r : reload1.c $(CONFIG_H) $(RTL_H) flags.h reload.h regs.h \  hard_reg_set.h insn_config.h basic_block.h recog.h	-really_new $(RDIR)/$@ $? insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r reload1.ccaller_save.r : caller_save.c $(CONFIG_H) $(RTL_H) flags.h reload.h regs.h \  hard_reg_set.h insn_config.h basic_block.h recog.h	-really_new $(RDIR)/$@ $? insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r caller_save.cfinal.r : final.c $(CONFIG_H) $(RTL_H) regs.h recog.h conditions.h \  gdbfiles.h insn_config.h real.h	-really_new $(RDIR)/$@ $? insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r final.crecog.r : recog.c $(CONFIG_H) $(RTL_H) regs.h recog.h hard_reg_set.h \  insn_config.h	-really_new $(RDIR)/$@ $? insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r recog.cversion.r : version.c	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r version.c# Now the source files that are generated from the machine description.#.PRECIOUS: insn_config.h insn_flags.h insn_codes.h insn_emit.c insn_recog.c \# insn_extract.c insn_output.c insn_peep.c# The following pair of rules has this effect:# genconfig is run only if the md has changed since genconfig was last run;# but the file insn_config.h is touched only when its contents actually change.# Each of the other insn_* files is handled by a similar pair of rules.# For OSK, really_new is needed to imitate orignal behavior.  (A.S.)insn_config.h: $S/stamp_config.h	@$(DO_NOTHING)$S/stamp_config.h: md $(ABS)/genconfig	$(ABS)/genconfig md>-tmp_config.h	move_if_change tmp_config.h insn_config.h	@touch $S/stamp_config.hinsn_flags.h: $S/stamp_flags.h	@$(DO_NOTHING)$S/stamp_flags.h: md $(ABS)/genflags	$(ABS)/genflags md>-tmp_flags.h	move_if_change tmp_flags.h insn_flags.h	@touch $S/stamp_flags.hinsn_codes.h: $S/stamp_codes.h	@$(DO_NOTHING)$S/stamp_codes.h: md $(ABS)/gencodes	$(ABS)/gencodes md>-tmp_codes.h	move_if_change tmp_codes.h insn_codes.h	@touch $S/stamp_codes.hinsn_emit.r : insn_emit.c $(CONFIG_H) $(RTL_H) expr.h insn_config.h real.h \  insn_codes.h	-really_new $(RDIR)/$@ $? insn_emit.c insn_config.h insn_codes.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r insn_emit.cinsn_emit.c: $S/stamp_emit.c	@$(DO_NOTHING)$S/stamp_emit.c: md $(ABS)/genemit	$(ABS)/genemit md>-tmp_emit.c	move_if_change tmp_emit.c insn_emit.c	@touch $S/stamp_emit.cinsn_recog.r : insn_recog.c $(CONFIG_H) $(RTL_H) insn_config.h real.h \  recog.h	-really_new $(RDIR)/$@ $? insn_recog.c insn_config.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r insn_recog.cinsn_recog.c: $S/stamp_recog.c	@$(DO_NOTHING)$S/stamp_recog.c:md $(ABS)/genrecog	$(ABS)/genrecog md>-tmp_recog.c	move_if_change tmp_recog.c insn_recog.c	@touch $S/stamp_recog.cinsn_extract.r : insn_extract.c $(RTL_H)	-really_new $(RDIR)/$@ $? insn_extract.c ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r insn_extract.cinsn_extract.c: $S/stamp_extract.c	@$(DO_NOTHING)$S/stamp_extract.c: md $(ABS)/genextract	$(ABS)/genextract md>-tmp_extract.c	move_if_change tmp_extract.c insn_extract.c	@touch $S/stamp_extract.cinsn_peep.r : insn_peep.c $(CONFIG_H) $(RTL_H) regs.h real.h	-really_new $(RDIR)/$@ $? insn_peep.c ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r insn_peep.cinsn_peep.c: $S/stamp_peep.c	@$(DO_NOTHING)$S/stamp_peep.c: md $(ABS)/genpeep	$(ABS)/genpeep md>-tmp_peep.c	move_if_change tmp_peep.c insn_peep.c	@touch $S/stamp_peep.cinsn_output.r : insn_output.c $(CONFIG_H) $(RTL_H) regs.h real.h \  conditions.h insn_config.h insn_flags.h output.h aux_output.c \  hard_reg_set.h	-really_new $(RDIR)/$@ $? insn_output.c insn_config.h insn_flags.h ;\	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r insn_output.cinsn_output.c: $S/stamp_output.c	@$(DO_NOTHING)$S/stamp_output.c: md $(ABS)/genoutput	$(ABS)/genoutput md>-tmp_output.c	move_if_change tmp_output.c insn_output.c	@touch $S/stamp_output.c# Now the programs that generate those files.$(ABS)/genconfig : genconfig.r rtl.r $(LIBDEPS)	chd $(RDIR);$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genconfig genconfig.r rtl.r $(LIBS)genconfig.r : genconfig.c $(RTL_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r genconfig.c$(ABS)/genflags : genflags.r rtl.r $(LIBDEPS)	chd $(RDIR);$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genflags genflags.r rtl.r $(LIBS)genflags.r : genflags.c $(RTL_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r genflags.c$(ABS)/gencodes : gencodes.r rtl.r $(LIBDEPS)	chd $(RDIR);$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/gencodes gencodes.r rtl.r $(LIBS)gencodes.r : gencodes.c $(RTL_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r gencodes.c$(ABS)/genemit : genemit.r rtl.r $(LIBDEPS)	chd $(RDIR);$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genemit genemit.r rtl.r $(LIBS)genemit.r : genemit.c $(RTL_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r genemit.c$(ABS)/genrecog : genrecog.r rtl.r $(LIBDEPS)	chd $(RDIR);$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genrecog genrecog.r rtl.r $(LIBS)genrecog.r : genrecog.c $(RTL_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(NO68) $(RF) -o $(RDIR)/$*.r genrecog.c$(ABS)/genextract : genextract.r rtl.r $(LIBDEPS)	chd $(RDIR);$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genextract genextract.r rtl.r $(LIBS)genextract.r : genextract.c $(RTL_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r genextract.c$(ABS)/genpeep : genpeep.r rtl.r $(LIBDEPS)	chd $(RDIR);$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genpeep genpeep.r rtl.r $(LIBS)genpeep.r : genpeep.c $(RTL_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r genpeep.c$(ABS)/genoutput : genoutput.r rtl.r $(LIBDEPS)	chd $(RDIR);$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genoutput genoutput.r rtl.r $(LIBS)genoutput.r : genoutput.c $(RTL_H)	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r genoutput.cobstack.r: obstack.c obstack.h	$(CC)  $(INCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r obstack.c# missing libraries for OSK.qsort.r: $(libsrc)/qsort.c	@copy -r $(libsrc)/qsort.c	$(CC)  $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r qsort.cperror.r: $(libsrc)/perror.c	@copy -r $(libsrc)/perror.c	$(CC)  $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r perror.cgetcd.r: $(libsrc)/getcd.c	@copy -r $(libsrc)/getcd.c	$(CC)  $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r getcd.cldexp.r: $(libsrc)/ldexp.c	@copy -r $(libsrc)/ldexp.c	$(CC)  $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r ldexp.cstat.r: $(libsrc)/stat.c	@copy -r $(libsrc)/stat.c	$(CC)  $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) -o $(RDIR)/$*.r stat.calloca.r: $(libsrc)/alloca.a	$(RC) -b -o=$(RDIR)/$*.r $(libsrc)/alloca.a# Library of arithmetic subroutines# Don't compile this with gcc!gnulib1: gnulibosk.c	-makdir $(tmplibdir)	copy -r gnulibosk.c $(tmplibdir)/temp	@chd $(tmplibdir) ; echo -n $(LIBFUNCS) !\	cfp -zne "-s=rename temp L*.c ; $(OLDCC) -qsrt=/r0 -DL* L*.c ;\	rename L*.c temp" ! shell -np	@chd $(tmplibdir) ; echo -n $(LIBFUNCS) !\	cfp -zne "-s=echo L*.r" ! shell -np >>/nil ! merge -z>-../gnulib1	deldir -qf $(tmplibdir)	copy -r gnulib1 gnulib.l# gnulib2.cgnulib2: gnulib1 gnulib2.c cc1 gccosk cccp $(CONFIG_H) $(ALLOCA)	-makdir $(tmplibdir)	copy -r gnulib2.c $(tmplibdir)/temp	@chd $(tmplibdir) ; echo -n $(LIB2FUNCS) !\	cfp -zne "-s=rename temp L*.c ; $(CC) -c -I.. -I../config -ob \	-mnostack-check -fcombine-regs -fstrength-reduce \	-Dalloca=__builtin_alloca -DL* L*.c ; rename L*.c temp" ! shell -np	@chd $(tmplibdir) ; echo -n $(LIB2FUNCS) !\	cfp -zne "-s=echo L*.r" ! shell -np >>/nil ! merge -z>-../gnulib2	deldir -qf $(tmplibdir)	merge gnulib2 gnulib1 $S/$(ALLOCA) >-gnulib.l## a stupid make requires strange rules .....#cc1.r: final.c	@echo $@ >>>/nilmd:	@echo $@ >>>/nil