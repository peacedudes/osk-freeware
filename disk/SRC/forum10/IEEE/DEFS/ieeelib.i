{ IEEE Header file for ieeelib.r    routines for gesibs 1a & 1b  }                { date: 21-02-89      B&K JS 4510 }                { Remember to link with ieeelib.r }CONST  EOSchr         = $0A; { <LF> }  ErrNam         = '/dd/sys/errmsg.ibc';  TimeOut        = 50;  { 1/10 sec. }  IbcDevice      = '/ibc';  No_Instruments = 16; {max number of instruments on the IEEE bus}  SendMode       = 0;  {0=ASCII (7 bits) 1=Binary (8 bits)}     ReceiveMode    = 1;  {1=ASCII (7 bits) 0=Binary (8 bits)}   type  regtype = record              d0,d1,d2,d3,d4,d5 : LONGHEX;              a0,a1,a2,a3,a6    : LONGHEX;            end;(*****************************************************************************)(*                                                                           *)(* Global variables for IEEE operation                                       *)(*                                                                           *)(*****************************************************************************)var  IbcError : INTEGER ;           { Status of last system call to IEEE board  }  IbcFile  : TEXT ;              { File for IEEE data transfer.              }  IbcPath  : INTEGER;            { Path number for controller.               }  (*****************************************************************************)(*                                                                           *)(* Global variables for Error repporting                                     *)(*                                                                           *)(*****************************************************************************)  ErrFile  : TEXT;    { Needed to get path# for 'f_perr'-call. }  ErrPath  : INTEGER; { Path# for 'f_perr'-call stored here. }FUNCTION IbcTrig(path: INTEGER; VAR adlist: STRING[15]) : BOOLEAN; EXTERNAL;FUNCTION IbcClear(path: INTEGER) : BOOLEAN; EXTERNAL;FUNCTION IbcIfc(path: INTEGER) : BOOLEAN; EXTERNAL;FUNCTION IbcRemote(path: INTEGER) : BOOLEAN; EXTERNAL;FUNCTION IbcTime(path : INTEGER;                 time : HEX     ) : BOOLEAN; EXTERNAL;FUNCTION IbcSend(path:INTEGER;                 eosfunc: HEX;                  eos : CHAR;                  nb : HEX;                 cmpty : HEX;              VAR adlist : string[15] ) : BOOLEAN; EXTERNAL;FUNCTION IbcRecv(path: INTEGER;                  eos : HEX;                  adtalk : HEX;                  typeos : HEX   ) : BOOLEAN; EXTERNAL;FUNCTION IbcDclear(path   : INTEGER;                VAR adlist : string[15] ) : BOOLEAN; EXTERNAL;FUNCTION IbcLlo(path: INTEGER) : BOOLEAN; EXTERNAL;FUNCTION IbcLocal(path: INTEGER) : BOOLEAN; EXTERNAL;FUNCTION IbcInitialize(            DeviceName  : STRING[15];            TimeoutTime : HEX;        VAR IbcPath     : INTEGER;        VAR IbcFile     : TEXT                      ) : BOOLEAN; EXTERNAL;Procedure IeeeInit; EXTERNAL;Procedure InterFaceClear; EXTERNAL;Procedure Remote; EXTERNAL;Procedure DevClearAll; EXTERNAL;Procedure DevClear(addresslist : STRING [No_instruments] ); EXTERNAL;Procedure LocalLock; EXTERNAL;Procedure Send(message : STRING; addresslist : STRING [No_instruments] ); EXTERNAL;Procedure Receive(VAR message:STRING; address:INTEGER); EXTERNAL;Procedure GroupTrig(addresslist:STRING); EXTERNAL;Procedure Local; EXTERNAL;Procedure IeeeTerminate; EXTERNAL;