(*****************************************************************************)(*                                                                           *)(* Filename: testibc.p                              Date: 17/4-89      JS    *)(* Modified:           17/4-89   for Omegasoft Pascal V 2.01                 *)(*                                                                           *)(*****************************************************************************)PROGRAM TestIbc(Input,Output);const  VerMod = '       IEEE test program.   B & K  Denmark           17/4-89  JS';Var  cmd   : CHAR;{$I/dd/defs/ieeelib.i}{$I/dd/defs/os9calls}(*****************************************************************************)procedure menu;  begin    write(#27'[62;1"p'#27'[2J'#27'['#1';'#1'H'); { VT220 ClrScr }    write(#27'['#16';r'); { Scroll region 16..24 }    writeln(VerMod);    writeln;    writeln('         I)fc            Interface Clear.       (bus command)');    writeln('         R)emote         Remote Enable.         (bus command)');    writeln('         L)lo            Local lockout          (bus command)');    writeln('         G)oto local     Go to Local.           (bus command)');    writeln('         C)lear          Device Clear.          (bus command)');    writeln;    writeln('         S)end           Send string to 1 or more listeners.');    writeln('         E)nter          Receive string from one talker.');    writeln;    writeln(      '         D)ev-clear      Selected device clear. (addressed command)');    writeln('         T)ime           Set timeout time.      (system command)');    writeln('         Q)uit           Exit ''testibc''-program.');  end; { menu } {}(*****************************************************************************)Function GetCmd : Char;var ch : char;begin  menu;  writeln;  write('Command? ');  readln(ch);  GetCmd := ch;end; { GetCmd }(*****************************************************************************)procedure ifc;  begin    if ibcifc(IbcPath)    then writeln('TestIbc: IbcIfc: OK.')    else    begin      write('TestIbc: IbcIfc: '#13#10'  ');      f_perr(IbcError,errpath);    end;  end; { Ifc }(*****************************************************************************)procedure remote1;  begin    if ibcRemote(IbcPath)    then writeln('TestIbc: IbcRemote: OK.')    else    begin      write('TestIbc: IbcRemote: '#13#10'  ');      f_perr(IbcError,errpath);    end;  end; { Remote }(*****************************************************************************)procedure clear1;  begin    if ibcClear(IbcPath)    then writeln('TestIbc: IbcClear: OK.')    else    begin      write('TestIbc: IbcClear: '#13#10'  ');      f_perr(IbcError,errpath);    end;  end; { Clear }{  }(*****************************************************************************)procedure send1;  var    adlist : string;    ladd   : integer;    mess   : string;    yesno  : CHAR;  begin    adlist := '';    repeat      if length(adlist)<14 then      begin        write('Listen address? ');        readln(ladd);        adlist := concat(adlist,chr(ladd));        write('More listeners (Y/N)? ');        readln(yesno);      end      else writeln('Max 14 Listeners.');    until (Upshift(yesno) <> 'Y') or (length(adlist)=14);    adlist := concat(adlist,chr($FF));    write('Message? ');    readln(mess);    mess := concat(mess,chr(EOSchr));    if IbcSend(IbcPath,1,EOSchr,$FF,0,adlist) then    begin      writeln('TestIbc: IbcSend OK.');      write(IbcFile,mess);      writeln('TestIbc: Writeln(IbcFile,Message) Passed.');    end    else    begin      write('TestIbc: IbcSend: '#13#10'  ');      f_perr(IbcError,errpath);    end;  end; { Send }(*****************************************************************************)procedure enter1;  var    adtalk : hex;    talkadr: integer;    mess : string;    svar : char;  begin    write('Talk Address? ');    readln(talkadr);    adtalk := hex(talkadr);    if IbcRecv(IbcPath,EOSchr,adtalk,0) then    begin      writeln('TestIbc: IbcRecv OK.');      readln(IbcFile,mess);      writeln('"',mess,'"');      readln(svar);    end    else    begin      write('TestIbc: IbcRecv: '#13#10'  ');      f_perr(IbcError,errpath);    end;  end; { Enter } {  }(*****************************************************************************)procedure LocalLockout1;  begin    IF IbcLlo(IbcPath) THEN    begin      writeln('TestIbc: IbcLlo OK.');    end    else    begin      write('TestIbc: IbcLlo: '#13#10'  ');      f_perr(IbcError,errpath);    end;  end; { LocalLockout }(*****************************************************************************)procedure GotoLocal1;  begin    IF IbcLocal(IbcPath) THEN    begin      writeln('TestIbc: IbcLocal OK.');    end    else    begin      write('TestIbc: IbcLocal: '#13#10'  ');      f_perr(IbcError,errpath);    end;  end; { GotoLocal }(*****************************************************************************)procedure DevClr1;  var    adr    : integer;    adlist : string[16];    answ   : char;  begin    adlist := '';    REPEAT      write('Listen address? ');      readln(adr);      IF (adr >= 0) AND (adr <= 15)      THEN adlist := concat(adlist,chr(adr))      ELSE writeln('"',adr,'" out of range: (0..15)');      write('More listners? ');      readln(answ);    UNTIL upshift(answ) <> 'Y';    adlist := concat(adlist,chr($FF));    IF IbcDclear(IbcPath,adlist) THEN    begin      writeln('TestIbc: IbcDclear OK.');    end    else    begin      write('TestIbc: IbcDclear: '#13#10'  ');      f_perr(IbcError,errpath);    end;  end; { DevClr } {  }(*****************************************************************************)procedure SetTime1;  var    ToTim : HEX;    ToStr : String;    ToInt : INTEGER;  begin    REPEAT      write('Timeout time (1/10 Sec)? ');      readln(ToStr);      IF NOT ((REAL(ToStr) > 0) AND (REAL(ToStr) < 32767))      THEN WRITELN('Range 1 .. 32767');    UNTIL (REAL(ToStr) > 0) AND (REAL(ToStr) < 32767);    ToInt := Integer(ToStr);    ToTim := HEX(ToInt);    {$Ceq test} writeln(toint:6,ToTim:6); {$Cend}    IF IbcTime(IbcPath,ToTim) THEN    begin      writeln('TestIbc: IbcTime OK.');    end    else    begin      write('TestIbc: IbcTime: '#13#10'  ');      f_perr(IbcError,errpath);    end;  end; { SetTime }(*****************************************************************************)begin  writeln('TestIbc: Running ...');  reset(ErrFile,ErrNam);  writeln('Using "',ErrNam,'" as Error message file.');  ErrPath := Get_Path(addr(ErrFile));  writeln('TestIbc: ErrPath = ',ErrPath);  IF IbcInitialize( { DeviceName = } '/ibc',                    { Time out   = } 50,     { 1/10 Sec }                      IbcPath,                      IbcFile   )  THEN WRITELN('TestIbc: IbcInitialize: OK.')  ELSE  begin    write('TestIbc: IbcInitialize: '#13#10'  ');    f_perr(HEX(IbcError),errpath);  end;  settime1;  REPEAT    cmd := GetCmd;    CASE upshift(cmd) OF    'I' : ifc;    'R' : remote1;    'L' : LocalLockout1;    'G' : GotoLocal1;    'C' : clear1;    'S' : send1;    'E' : enter1;    'D' : devclr1;    'T' : settime1;    END;  UNTIL cmd IN ['q','Q'];  write(#27'[2J'#27'[;H'#27'[61"p');  CLOSE(ErrFile);  CLOSE(IbcFile);  writeln('TestIbc: Terminated.');end.