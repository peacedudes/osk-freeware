module testlib(input,output);{$I/dd/defs/os9calls}{$I/dd/js/libdir/ibc_typ.i}(*****************************************************************************)(* Importet from:                                                            *)(* Filename: ibc_rut.i                            Date: 04/4/-89    JS/4510  *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* OmegaSoft 68000 Pascal language interface for IBS_1 IEEE driver           *)(*                  (layer 1)                                                *)(*                                                                           *)(*                                                                           *)(*                                                                           *)(* Function  :  Description                                                  *)(*                                                                           *)(* setstat   :  System call for addressing IEEE board                        *)(* IbcTrig   :  Group Execute Trigger                                        *)(* IbcClear  :  Device Clear                                   (bus command) *)(* IbcIfc    :  Interface Clear                                (bus command) *)(* IbcRemote :  Remote Enable                                  (bus command) *)(* IbcTime   :  Initialize timeout value.                                    *)(* IbcSend   :  Configure board for WRITE                                    *)(* IbcRecv   :  Configure board for READ                                     *)(* IbcDclear :  Selected device clear                                        *)(* IbcLlo    :  Local lock out                                 (bus command) *)(* IbcLocal  :  Go to local                                    (bus command) *)(*                                                                           *)(* IbcInitialize: Initialize IEEE system and timeout time                    *)(*                                                                           *)(*****************************************************************************)(*****************************************************************************)(*                                                                           *)(* setstat : system call                                                     *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:     dummy    : HEX       Dummy parameter                           *)(* INPUT:     regs     : regtype   registers for transfering data            *)(*                                                                           *)(* OUTPUT:    setstat : BOOLEAN   Operation status:                          *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'regs.d1')       *)(*****************************************************************************)FUNCTION setstat(dummy:hex;var regs:regtype):boolean;external;(*****************************************************************************)(*                                                                           *)(* IbcTrig :  Group Execute Trigger                                          *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:     path     : INTEGER   Path number returned from getpath.        *)(*            adlist   : STRING[16] Addresses of listeners -                 *)(*                                  terminated by chr($FF)                   *)(*                                                                           *)(*                                                                           *)(* OUTPUT:    IbcTrig  : BOOLEAN   Operation status:                         *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'IbcError')      *)(*****************************************************************************)FUNCTION IbcTrig(path: INTEGER; VAR adlist: STRING[15]) : BOOLEAN;entry;CONST  FC_Trig = 131;VAR  regs : regtype;BEGIN  WITH regs DO  BEGIN    d0 := path;    d1 := FC_Trig;    a0 := addr(adlist[1]);    IbcTrig := Setstat(0,regs);    IbcError := integer(d1);  END;END; { IbcTrig }(*****************************************************************************)(*                                                                           *)(* IbcClear:  Device Clear                                     (bus command) *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:     path     : INTEGER   Path number returned from getpath.        *)(*                                                                           *)(* OUTPUT:    IbcClear : BOOLEAN   Operation status:                         *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'IbcError')      *)(*****************************************************************************)FUNCTION IbcClear(path: INTEGER) : BOOLEAN;entry;CONST  FC_DClr = 146;VAR  regs : regtype;BEGIN  WITH regs DO  BEGIN    d0 := path;    d1 := FC_DClr;    IbcClear := Setstat(0,regs);    IbcError := integer(d1);  END;END; { IbcClear }(*****************************************************************************)(*                                                                           *)(* IbcIfc:    Interface Clear                                  (bus command) *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:     path     : INTEGER   Path number returned from getpath.        *)(*                                                                           *)(* OUTPUT:    IbcIfc   : BOOLEAN   Operation status:                         *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'IbcError')      *)(*****************************************************************************)FUNCTION IbcIfc(path: INTEGER) : BOOLEAN;entry;CONST  FC_Ifcl = 143;VAR  regs : regtype;BEGIN  WITH regs DO  BEGIN    d0 := path;    d1 := FC_Ifcl;    IbcIfc := Setstat(0,regs);    IbcError := integer(d1);  END;END; { IbcIfc }(*****************************************************************************)(*                                                                           *)(* IbcRemote: Remote Enable (bus command)                                    *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:    path      : INTEGER   Path number returned from getpath.        *)(*                                                                           *)(* OUTPUT:   IbcRemote : BOOLEAN   Operation status:                         *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'IbcError')      *)(*****************************************************************************)FUNCTION IbcRemote(path: INTEGER) : BOOLEAN;entry;CONST  FC_Reme = 141;VAR  regs : regtype;BEGIN  WITH regs DO  BEGIN    d0 := path;    d1 := FC_Reme;    IbcRemote := Setstat(0,regs);    IbcError := integer(d1);  END;END; { IbcRemote }(*****************************************************************************)(*                                                                           *)(* IbcTime: Initialize timeout value.                                        *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:    path      : INTEGER   Path number returned from getpath.        *)(*           time      : HEX       Timeout time in 1/10 Sec                  *)(*                                                                           *)(* OUTPUT:   IbcTime   : BOOLEAN   Operation status:                         *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'IbcError')      *)(*****************************************************************************)FUNCTION IbcTime(path : INTEGER;                 time : HEX     ) : BOOLEAN;entry;CONST  FC_Time = 148;VAR  regs : regtype;BEGIN  WITH regs DO  BEGIN    d0 := path;    d1 := FC_Time;    d2 := time;    IbcTime := Setstat(0,regs);    IbcError := integer(d1);  END;END; { IbcTime }(*****************************************************************************)(*                                                                           *)(* IbcSend:   Configure board for WRITE                                      *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:   path    : INTEGER    Path number returned from getpath.          *)(*          eosfunc : HEX        Dialogue controll:                          *)(*                                 = 0 Character count in 'nb'               *)(*                                 = 1 EOS character in 'eos'.               *)(*          eos     : CHAR       End Of Sequence character.                  *)(*          nb      : HEX        Character count.                            *)(*          cmpty   : HEX        Comparison type:                            *)(*                                  = 0 ASCII (7 bits)                       *)(*                                  = 1 Binary (8 bits).                     *)(*          adlist  : STRING[16] Addresses of listeners -                    *)(*                                   terminated by chr($FF)                  *)(*                                                                           *)(* OUTPUT:  IbcSend : BOOLEAN    Operation status:                           *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'IbcError')      *)(*****************************************************************************)FUNCTION IbcSend(path:INTEGER;                 eosfunc: HEX;                  eos : CHAR;                  nb : HEX;                 cmpty : HEX;              VAR adlist : string[15] ) : BOOLEAN;entry;CONST  FC_Send = 128;VAR  regs : regtype;BEGIN  WITH regs DO  BEGIN    d0 := path;    d1 := FC_Send;    d3 := eosfunc;    d4 := cmpty;    IF eosfunc = 0       THEN d5 := nb          { Character count }    ELSE d5 := HEX(eos);      { Termination character }    a0 := addr(adlist[1]);    IbcSend := Setstat(0,regs);    IbcError := integer(d1);  END;END; { IbcSend }(*****************************************************************************)(*                                                                           *)(* IbcRecv:   Configure board for READ                                       *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:     path     : INTEGER   Path number returned from getpath.        *)(*            eos      : HEX       End Of Sequence character -               *)(*                                 <> 0 EosChar = chr(eos)                   *)(*                                  - 0 for no EOS detection                 *)(*            adtalk   : HEX       Talkers address                           *)(*            typeos   : HEX       EOS comparison width:                     *)(*                                  = 0 ASCII (7 bits)                       *)(*                                  = 1 Binary (8 bits).                     *)(*                                                                           *)(* OUTPUT:    IbcRecv  : BOOLEAN   Operation status:                         *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'IbcError')      *)(*****************************************************************************)FUNCTION IbcRecv(path: INTEGER;                  eos : HEX;                  adtalk : HEX;                  typeos : HEX   ) : BOOLEAN;entry;VAR  regs : regtype;BEGIN  WITH regs DO  BEGIN    D0 := path;    D1 := 129;  { FC_Recv }    D2 := adtalk;    D3 := eos;    D4 := typeos;    IbcRecv := setstat(0,regs);    IbcError := integer(d1);  END;END; { IbcRecv }(*****************************************************************************)(*                                                                           *)(* IbcDclear: Selected device clear                                          *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:   path    : INTEGER    Path number returned from getpath.          *)(*          adlist  : STRING[16] Addresses of listeners -                    *)(*                                   terminated by chr($FF)                  *)(*                                                                           *)(* OUTPUT:  IbcDclear : BOOLEAN  Operation status:                           *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'IbcError')      *)(*****************************************************************************)FUNCTION IbcDclear(path   : INTEGER;                VAR adlist : string[15] ) : BOOLEAN;entry;VAR  regs : regtype;BEGIN  WITH regs DO  BEGIN    d0 := path;    d1 := 132;  { FC_Sdclr }    a0 := addr(adlist[1]);    IbcDclear := Setstat(0,regs);    IbcError  := integer(d1);  END;END; { IbcDclear }(*****************************************************************************)(*                                                                           *)(* IbcLlo:    Local lock out                                   (bus command) *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:   path    : INTEGER    Path number returned from getpath.          *)(*                                                                           *)(* OUTPUT:  IbcLlo  : BOOLEAN    Operation status:                           *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'IbcError')      *)(*****************************************************************************)FUNCTION IbcLlo(path: INTEGER) : BOOLEAN;entry;VAR  regs : regtype;BEGIN  WITH regs DO  BEGIN    D0 := path;    D1 := 147;  { FC_Llo }    IbcLlo := Setstat(0,regs);    IbcError := integer(d1);   END;END; { IbcDclear }(*****************************************************************************)(*                                                                           *)(* IbcLocal:  Go to local                                      (bus command) *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:   path    : INTEGER    Path number returned from getpath.          *)(*                                                                           *)(* OUTPUT:  IbcLocal: BOOLEAN    Operation status:                           *)(*                                  = TRUE   All Ok, no errors               *)(*                                  = FALSE  Error (code in 'IbcError')      *)(*****************************************************************************)FUNCTION IbcLocal(path: INTEGER) : BOOLEAN;entry;VAR  regs : regtype;BEGIN  WITH regs DO  BEGIN    D0 := path;    D1 := 142;  { FC_Locl }    IbcLocal := Setstat(0,regs);    IbcError := integer(d1);  END;END; { IbcLocal }(*****************************************************************************)(*                                                                           *)(* IbcInitialize: Initialize IEEE system                                     *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(* INPUT:   DeviceName    : STRING[15] Name of ieee controller device        *)(*          TimeoutTime   : HEX        Time out time in 1/10 Sec             *)(*                                                                           *)(* OUTPUT:  IbcPath       : INTEGER    Path number of IbcFile                *)(*          IbcFile       : TEXT       File                                  *)(*          IbcInitialize : BOOLEAN    Operation status:                     *)(*                                       = TRUE   All Ok, no errors          *)(*                                       = FALSE  Error                      *)(*****************************************************************************)FUNCTION IbcInitialize(            DeviceName  : STRING[15];            TimeoutTime : HEX;        VAR IbcPath     : INTEGER;        VAR IbcFile     : TEXT                      ) : BOOLEAN;entry;BEGIN  open(IbcFile,DeviceName, Update);  IbcPath := get_path( addr(IbcFile) );  IbcInitialize := IbcTime(IbcPath,TimeoutTime);END; { IbcInitialize}(*****************************************************************************)(*     Importet from:                                                        *)(*     lag2.i                                      JS/4510   04/04/89        *)(*                                                                           *)(*                                                                           *)(*****************************************************************************)(*                                                                           *)(*     IeeeInit                                                              *)(*     InterFaceClear                                                        *)(*     Remote                                                                *)(*     DevClearAll                                                           *)(*     DevClear (addresslist : STRING [No_instruments] );                    *)(*     LocalLock                                                             *)(*     Send (message : STRING; addresslist : STRING [No_instruments] );      *)(*     Receive (VAR message:STRING; address:INTEGER)                         *)(*     GroupTrig (addresslist:STRING)                                        *)(*     Local                                                                 *)(*     IeeeTerminate                                                         *)(*                                                                           *)(*                                                                           *)(*****************************************************************************)(*****************************************************************************)(*                                                                           *)(*                      >>>   IeeeInit   <<<                                 *)(*                                                                           *)(*      input  : none                                                        *)(*      output : none                                                        *)(*                                                                           *)(*      Definitions in ibc_typ.i are used as parameters                      *)(*                                                                           *)(*****************************************************************************)PROCEDURE IeeeInit; entry;   begin       if not IbcInitialize(IbcDevice,TimeOut,IbcPath,IbcFile) then          writeln('IbcInitialize  Error in Init: ',IbcError);   end; {Init}   (*****************************************************************************)	PROCEDURE InterfaceClear; entry;     begin   if not IbcIfc(IbcPath) then      writeln('Interface clear error in InterFaceClear: ',IbcError);   end; {InterFaceClear}(*****************************************************************************)	PROCEDURE Remote; entry;   begin   if not IbcRemote(Ibcpath) then      writeln('Remote enable error in Remote: ',IbcError);   end; {Remote}(*****************************************************************************)	PROCEDURE DevClearAll; entry;   begin      if not IbcClear(IbcPath) then         Writeln ('IbcClear error in DevClearAll: ',IbcError);   end; {DevClearAll}(*****************************************************************************)	PROCEDURE DevClear(addresslist : STRING[No_instruments]); entry;   begin       addresslist := concat(addresslist,chr($FF));       if not IbcDclear(IbcPath,addresslist) then         Writeln ('IbcDclear error in DevClear: ',IbcError);   end; {DevClear}(*****************************************************************************)	PROCEDURE LocalLock; entry;   begin      if not IbcLlo(IbcPath) then         Writeln ('IbcLlo error in LocalLock: ',IbcError);   end; {LocalLock}(*****************************************************************************)	PROCEDURE Send(message : STRING; addresslist : STRING [No_instruments] ); entry;   begin      addresslist := concat(addresslist,chr($FF));       if not IbcSend(IbcPath,1,EOSchr,$FF,SendMode,addresslist) then         writeln('IbcSend error in Send: ',IbcError)      else         begin            message := concat(message,chr(EOSchr));            write(Ibcfile,message);          end;    end; {Send}(*****************************************************************************)	PROCEDURE Receive(VAR message : STRING; address : INTEGER); entry;   begin      if not IbcRecv(IbcPath,EOSchr,address,ReceiveMode) then         begin            writeln('IbcRecv error in Receive-Procedure: ',IbcError);            message := '';         end      else         readln (IbcFile,message);   end; {Receive}   (*****************************************************************************)	PROCEDURE Local; entry;   begin      if not IbcLocal(IbcPath) then         Writeln ('IbcLocal error in Local-Procedure: ',IbcError);   end; {Local}(*****************************************************************************)	PROCEDURE GroupTrig(addresslist : STRING[No_instruments]); entry;   begin       if not IbcTrig(IbcPath,addresslist) then         Writeln ('IbcTrig error in GroupTrig-Procedure: ',IbcError);   end; {GroupTrig}(*****************************************************************************)	PROCEDURE IeeeTerminate; entry;   begin       close (IbcFile);   end;(*****************************************************************************)	modend.