 psect move_c,0,0,0,0,0 nam move_c ttl countcount: pshs u ldu 4,s  Hand-optimized to hell by MJK ldb 0,u addb 1,u addb 2,u addb 3,u addb 4,u addb 5,u sex puls u,pc ttl makelmakel: pshs u   Hand-optimized MJK 85/2/17* _strass(newbrd,oldbrd,14); ldd #14 pshs d ldd 8,s pshs d ldd 12,s pshs d lbsr _strass leas 6,s* nm = newbrd[move]; ldb 5,s  b == move forever ldx 8,s  x == newbrd forever lda b,x  a == nm forever* if(!nm) return(0); bne _4_3 clrb      return (int) 0 puls u,pc_4* newbrd[move]=0; clr b,x* LOOP TOP.  if(++move >13) move = 0;_8 incb cmpb #13 ble _13_12 clrb_13* newbord[move]++; inc b,x_11* for( ; nm; nm--) ... ; deca bne _8******** LOOP BOTTOM_9* return(newbrd[move] - 1); ldb b,x decb sex      better return fullword int puls u,pc endsect