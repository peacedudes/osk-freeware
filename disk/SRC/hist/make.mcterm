#		makefile fuer hist#		==================##		Stand :		11.06.88##		Aenderungen :##---------------------- defines --------------------##ODIR	= /dd/CMDSSDIR	= .RDIR	= /r0TEMPDIR	= /r0PROG	= $(ODIR)/hist.mctermOBJECTS	= $(RDIR)/h_edit.r\	  $(RDIR)/h_expand.r\	  $(RDIR)/h_main.r\	  $(RDIR)/h_rw.r\	  $(RDIR)/h_term.rPATH0	= ../INCPATH1	= /dd/DEFSLPATH0	= ../RELSLPATH1	= /dd/LIBSEARCH	= -v=$(PATH0) -v=$(PATH1)#	mcWyse-Terminal-Emulation oder Original-mc68000 Terminal# MACROS	= -dMCWYSEMACROS	= -dMCTERMMATH	= -xCIO		= -iDEBUG	= # DEBUG		= -gVERBOSE	= # VERBOSE	= -yUSERLIB	= CFLAGS	= $(SEARCH) $(MACROS) $(MATH) -t=$(TEMPDIR) $(VERBOSE)LFLAGS	= $(DEBUG) $(CIO) $(MATH) -t=$(TEMPDIR) $(VERBOSE)#---------------------- action --------------------$(PROG)		: $(OBJECTS)			  cc $(LFLAGS) $(OBJECTS) $(USERLIB) -f=$(PROG)$(OBJECTS)	: $(PATH0)/h_def.h\		  $(PATH0)/h_edidef.h\		  $(PATH0)/h_var.h\		  $(PATH1)/ctype.h\		  $(PATH1)/dir.h\		  $(PATH1)/modes.h\		  $(PATH1)/stdio.h