CC=	ccG=	-gCFLAGS=	-qt=/dd/TMP $G -Dvoid=intLIBS=	-l=/dd/LIB/os9lib.lLFLAGS=	-q $(LIBS) $GODIR=	/h0/ETC/CMDSBATCHC=	batch.c s_batch.c s_none.c s_com.c s_com7.c s_file.c s_exec.cBATCHR=	batch.r s_batch.r s_none.r s_com.r s_com7.r s_file.r s_exec.rsbatch:	$(BATCHR)	$(CC) $(LFLAGS) $(BATCHR) -f=$(ODIR)/sbatch	fixmod -uo2.39 -ua8002 $(ODIR)/sbatchtags:	$(BATCHC)	echo "Ctags:" $?	ctags $?