CC=	ccCFLAGS=	-qt=/dd/TMPLFLAGS=	-m=10 -ql=/dd/LIB/os9lib.lSCTRL=	ctrl.c ccan.c cnew.c crm.c cssys.c csuu.c csver.c cchk.c getd.c mcan.cSHEAD=	delh.c ghead.c makh.c ihead.c mhead.c rhead.c shead.c spch.c app.cSHEAD2=	ddst.cSACT=	achk.c ract.c wact.cSSYS=	psys.c rsys.c tsys.cSADM=	build.c crct.c exp.c sect.cSMISC=	ffrom.c mail.c mid.c misc.c ohist.c sinfo.c unln.c rsat.c inrd.cSINEWS=	inews.c pargs.c wgrp.c wit.c mit.c pit.c crth.cINEWSSRC=$(SINEWS) $(SCTRL) $(SHEAD) $(SHEAD2) $(SACT) $(SSYS) $(SADM) $(SMISC) uidummy.cOCTRL=	ctrl.r ccan.r cnew.r crm.r cssys.r csuu.r csver.r cchk.r getd.r mcan.rOHEAD=	delh.r ghead.r makh.r ihead.r mhead.r rhead.r shead.r spch.r app.rOHEAD2=	ddst.rOACT=	achk.r ract.r wact.rOSYS=	psys.r rsys.r tsys.rOADM=	build.r crct.r exp.r sect.rOMISC=	ffrom.r mail.r mid.r misc.r ohist.r sinfo.r unln.r rsat.r inrd.rOINEWS=	inews.r pargs.r wgrp.r wit.r mit.r pit.r crth.rINEWS=	$(OINEWS) $(OCTRL) $(OHEAD) $(OHEAD2) $(OACT) $(OSYS) $(OADM) $(OMISC) uidummy.rinews:	$(INEWS)	$(CC) $(INEWS) -f=/h0/ETC/CMDS/inews $(LFLAGS)	fixmod -uo2.39 -ua8002 /h0/ETC/CMDS/inewsinews.r:	inews.c inews.hinews.tags:	ctags $(INEWSSRC)