CC     = ccCFLAGS = -qt=/dd/TMP -DM_SIGINFO=80LIBS   = -l=/dd/LIB/err.l -l=/dd/LIB/os9lib.l -l=/dd/lib/varargs.rSHELL  = shellMASTER = master.r collect.r expire.r update.r global.r options.r active.r \         db.r nntp.r pack_date.r pack_name.r pack_subject.r news.r digest.r \         match.rNN  = nn.r admin.r update.r global.r options.r active.r db.r nntp.r init.r \      variable.r term.r keymap.r macro.r regexp.r menu.r more.r rc.r \      group.r folder.r articles.r sequence.r selection.r kill.r answer.r \      reroute.r save.r unshar.r decode.r execute.r pack_date.r pack_name.r \      pack_subject.r news.r digest.r match.rMAIL = nnmail.r reroute.r global.r options.r update.rLOG = log_entry.r global.r update.rall: nn nnmaster nnadmin nnaux nncheck cvt_helpnn: $(NN)	$(CC) $(CFLAGS) -m=50 $(NN) -l=/h0/LIB/termlib.l $(LIBS) \	-f=/h0/ETC/CMDS/nn -BGnnadmin: nnmisc.c	$(CC) nnmisc.c -DPNAME="$@" $(CFLAGS) \	-f=/h0/ETC/CMDS/$@ -l=/h0/LIB/os9lib.lnncheck: nnmisc.c	$(CC) nnmisc.c -DPNAME="$@" $(CFLAGS) \	-f=/h0/ETC/CMDS/$@ -l=/h0/LIB/os9lib.lnnmaster: $(MASTER)	$(CC) $(CFLAGS) -m=20 $(MASTER) $(LIBS) -f=/h0/ETC/CMDS/nnmaster	fixmod -uo90.90 -ua8002 /h0/ETC/CMDS/nnmasternnaux:	aux.c	$(CC) $(CFLAGS) -m=6 aux.c $(LIBS) -f=/h0/ETC/CMDS/nnaux	fixmod -uo90.90 -ua8002 /h0/ETC/CMDS/nnauxlog_entry: $(LOG)        $(CC) $(CFLAGS) $(LOG) $(LIBS) -f=/h0/etc/cmds/log_entry -BGcvt_help: cvt_help.c        $(CC) $(CFLAGS) cvt_help.c -f=/h0/etc/cmds/cvt_help 