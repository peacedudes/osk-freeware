# Convert the NN manual file nn.1 to a folder which can be read by nn# invoke:# sh osk_mk_manecho Deleting old manual...del /h0/usr/lib/nn/Manualecho Installing new manual...sed 	-e 's/\\f[BPI]//g' \	-e 's/\\-/-/g' \	-e 's/\\&//' \	-e '/^\.\\" /d' \	-e '/^\.nf/d' \	-e '/^\.fi/d' \	-e '/^\.if/d' \	-e '/^\.ta/d' \	-e '/^\.nr/d' \	-e '/^\.in/d' \	-e 's/^\.[BI] //' nn.1 | oman>/h0/usr/lib/nn/Manualecho Changing file attributes to public read...attr /h0/usr/lib/nn/Manual -pr