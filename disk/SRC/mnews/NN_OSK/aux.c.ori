# include	<stdio.h># include	<ctype.h># include	<modes.h># define	Write(s)	writeln(1,s,strlen(s))extern int	os9forkc ();extern char	*findmod ();extern char	*getenv ();extern char	*index ();extern char	*rindex ();extern FILE	*xpopen ();char	*operation;char	*work;char	*ed_line;char	*first_action;char	*record;main (argc, argv, envp)int argc;char *argv[];char *envp[];{	FILE		*pp, *fp;	char		cmd[512];	char		buf[128];	char		*ptr;	int		ret;	int		n, prompt, loop;	int		fdi, fdo;	char		c;	char		copy[256];	char		trace[256];	char		act[128];	char		*edit;	char		*user;	if (argc < 2)		exit (_errmsg (1, "Missing operation.\n"));	operation = argv[1];	if (!strcmp (operation, "cancel")) {		if (argc < 4)			exit (_errmsg (1, "aux cancel <id> <group>\n"));#if 0		setuid (getmuid ());#endif		strcpy (cmd, findmod ("/h0/ETC/CMDS/inews", "inews"));		sprintf (buf, " '-c=cancel:%s'", argv[2]);		strcat (cmd, buf);#if 0		if (ptr = index (argv[3], '.'))			*ptr = '\0';		sprintf (buf, " '-d=%s'", argv[3]);		strcat (cmd, buf);#endif		strcat (cmd, " </nil");		if (ret = system (cmd))			sleep (3);		exit (ret);	}	if (argc < 5)		exit (_errmsg (1, "Missing options..\n"));	work = argv[2];	ed_line = argv[3];	first_action = argv[4];	record = argv[5];	copy[0] = '\0';	strcpy (trace, work);	strcat (trace, "T");	if (!strcmp (first_action, "edit")) {		strcpy (copy, work);		strcat (copy, "C");	}	loop = 1;	prompt = 0;	if (!(edit = getenv ("EDITOR")))		if (!(edit = getenv ("EDIT")))			edit = "me";	while (loop) {		if (prompt) {			Write ("Action: (a)bort (e)dit (o)k (s)end: ");			while ((n = readln (0, act, 20)) <= 0)				;			act[n-1] = '\0';		} else {			strcpy (act, first_action);			prompt = 1;		}		switch (tolower (act[0])) {			case 'a':				unlink (work);				unlink (copy);				exit (22);				break;			case 'e':				if (ptr = rindex (edit, '/'))					++ptr;				else					ptr = edit;				strcpy (cmd, edit);				if ((!_strccmp (ptr, "me")) || (!_strccmp (ptr, "emacs"))) {					strcat (cmd, " '-g");					strcat (cmd, ed_line);					strcat (cmd, "'");				} else if ((!_strccmp (ptr, "vi")) || (!_strccmp (ptr, "stevie"))) {					strcat (cmd, " '+");					strcat (cmd, ed_line);					strcat (cmd, "'");				}				strcat (cmd, " ");				strcat (cmd, work);				system (cmd);				break;			case 'o':			case 's':				loop = 0;				break;		}	}	if ((!strcmp (operation, "mail")) || (!strcmp (operation, "reply")) || (!strcmp (operation, "forward"))) {		strcpy (cmd, "cmail <");		strcat (cmd, work);		ret = system (cmd);	} else if ((!strcmp (operation, "follow")) || (!strcmp (operation, "post"))) {		if (!(ptr = getenv ("HOME")))			ptr = "/dd";		strcpy (buf, ptr);		strcat (buf, "/");		strcat (buf, ".signature");		if (access (buf, S_IREAD) != -1)			if ((fdo = open (work, S_IWRITE)) != -1) {				lseek (fdo, 0, 2);				if ((fdi = open (buf, S_IREAD)) != -1) {					while ((n = readln (fdi, buf, 120)) > 0)						writeln (fdo, buf, n);					close (fdi);				} else					Write ("\007Can't open your .signature-File\n");				close (fdo);			}		strcpy (cmd, "inews -h <");		strcat (cmd, work);		ret = system (cmd);	} else {		sprintf (buf, "Invalid operation: '%s' -- help!\n", operation);		Write (buf);		ret = 1;	}	if (ret) {		if (!(user = getenv ("USER")))			user = "Postmaster";		strcpy (cmd, "cmail '");		strcat (cmd, user);		strcat (cmd, "'");		if (pp = xpopen ("cmail", "w")) {			fprintf (pp, "To: %s\n", user);			fprintf (pp, "Subject: %s failed\n", operation);			fprintf (pp, "\nYour article/letter follows:\n\n");			if (fp = fopen (work, "r")) {				while (fgets (buf, 120, fp))					fputs (buf, pp);				fclose (fp);			}		}		ret = pclose (pp);	}	unlink (work);	unlink (copy);	exit (0);}