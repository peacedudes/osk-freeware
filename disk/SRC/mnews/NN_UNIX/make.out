	cp xmakefile MF.c	/bin/cc -M2lt32 -F a000 -SEG 512 -E -DCOMPILER="/bin/cc -M2lt32 -F a000 -SEG 512" -DPREPROC="/bin/cc -M2lt32 -F a000 -SEG 512 -E" \	       -DCDEBUG="-Ox -K -LARGE -s" MF.c | \	sed -e '1,/MAKE WILL CUT HERE/d' \	    -e '/^#/d' \	    -e '/^[ \f	]$/d' \	    -e '/^[ /]*[*]/d' | \	sed -n -e '/^..*$/p' > ymakefile	rm -f MF.c	make  -f ymakefile all	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c nn.cnn.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c admin.cadmin.c	/bin/cc -M2lt32 -F a000 -SEG 512 -c -Ox -K -LARGE -s update.cupdate.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c global.cglobal.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c options.coptions.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c active.cactive.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c db.cdb.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c nntp.cnntp.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c init.cinit.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c variable.cvariable.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c term.cterm.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c keymap.ckeymap.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c macro.cmacro.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c regexp.cregexp.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c menu.cmenu.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c more.cmore.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c rc.crc.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c group.cgroup.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c folder.cfolder.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c articles.carticles.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c sequence.csequence.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c selection.cselection.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c kill.ckill.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c answer.canswer.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c reroute.creroute.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c save.csave.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c unshar.cunshar.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c decode.cdecode.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c execute.cexecute.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c pack_date.cpack_date.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c pack_name.cpack_name.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c pack_subject.cpack_subject.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c news.cnews.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c digest.cdigest.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c match.cmatch.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s nn.o admin.o update.o  global.o options.o active.o db.o nntp.o  init.o variable.o term.o keymap.o macro.o regexp.o  menu.o more.o rc.o group.o folder.o  articles.o sequence.o selection.o kill.o  answer.o reroute.o save.o unshar.o decode.o execute.o  pack_date.o pack_name.o pack_subject.o news.o digest.o match.o  -ltermcap -lx -o nn	cp prefix.sh prefix.c	/bin/cc -M2lt32 -F a000 -SEG 512 -E prefix.c | \	sed -e '1,/CUT PREFIX HERE/d' \	    -e '/prefix.c/d' \	    -e '/^[ 	]*$/d' \	    -e 's/^&/#/' \	    -e 's/[ 	]*=[ 	]*/=/' > prefix	rm -f prefix.c	cat prefix nntidy.sh > nntidy	chmod +x nntidy	cat prefix nngrep.sh > nngrep	chmod +x nngrep	cat prefix nnquery.sh > nnquery	chmod +x nnquery	cat prefix nnusage.sh > nnusage	chmod +x nnusage	cat prefix nngoback.sh > nngoback	chmod +x nngoback	cat prefix aux.sh > aux	chmod +x aux	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c date_regexp.cdate_regexp.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s date_regexp.o -lx -o date_regexp	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c log_entry.clog_entry.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s log_entry.o global.o update.o -lx -o log_entry	cat prefix back_act.sh > back_act	chmod +x back_act	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c master.cmaster.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c collect.ccollect.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s -c expire.cexpire.c	/bin/cc -M2lt32 -F a000 -SEG 512 -Ox -K -LARGE -s master.o collect.o expire.o update.o  global.o options.o active.o db.o nntp.o  pack_date.o pack_name.o pack_subject.o news.o digest.o match.o  -lx -o nnmaster