# CONFIG is inserted above this line during INSTALLtrap : 2 3PATH=/bin:$PATHexport PATH# first argument is operation to be performed:# when saved, we shift it offOPERATION=$1shift# first we handle 'cancel'# $1 is ident, $2 is group name.if [ "$OPERATION" = "cancel" ] ; then	$INEWS -h  << EOF > /tmp/nn$$c 2>&1Newsgroups: $2Subject: cancel $1Control: cancel $1cancel $1 in newsgroup $2EOF#	$INEWS -t 'cmsg cancel '"$1" -n "$2" < /dev/null > /tmp/nn$$c 2>&1	x=$?	if [ $x != 0 ]; then		echo ''		cat /tmp/nn$$c		sleep 2	fi	rm -f /tmp/nn$$c	exit $xfiWORK="$1"ED_LINE="$2"FIRST_ACTION="$3"RECORD="$4"TRACE=${WORK}TCOPY=""if [ "${FIRST_ACTION}" = "edit" ] ; then	COPY=${WORK}C	cp $WORK $COPYfi# loop until sent or aborted.loop=trueprompt=falsewhile $loop ; do	if $prompt ; then		echo ''		awk 'END{printf "Action: (a)bort (e)dit (o)k (s)end (w)rite: "}' < /dev/null		read act	else		act="${FIRST_ACTION}"		prompt=true	fi	case $act in	a*) 		rm -f $WORK $COPY		exit 22		;;	e*)		# call editor to enter at line $2 of work file		case `basename "${EDITOR-med}"` in		vi|emacs )			# Berkeley vi display editor			# GNU emacs disply editor			${EDITOR-vi} +${ED_LINE} $WORK			;;		ded )			# QMC ded display editor			$EDITOR -l${ED_LINE} $WORK			;;		uemacs )			# micro emacs			$EDITOR -g${ED_LINE} $WORK			;;		med    )			# med			${EDITOR-med} $WORK ${ED_LINE}			rm -f $WORK".bak"			;;		* )			# Unknown editor			$EDITOR $WORK			;;		esac		if [ -n "$COPY" ] ; then			if [ -s $WORK ] ; then				if cmp -s $WORK $COPY ; then					rm -f $WORK $COPY					exit 22				fi			else				rm -f $WORK $COPY				exit 22			fi			rm -f $COPY		fi		;;	o*|s*)		loop=false		;;	w*)		echo "Append article to file:"		read FNAME		if [ -n "$FNAME" ] ; then			{ cat $WORK ; echo ; } >> $FNAME		fi		;;	esacdoneif [ -n "$COPY" ] ; then	rm -f $COPYficase "$OPERATION" inreply|forward|mail)	if $APPENDSIG ; then	    if [ -f $HOME/.signature ] ; then		awk 'END{printf "Append .signature? (y) : "}' < /dev/null		read ans		case $ans in		''|y*|Y*)			echo "--" >> $WORK			cat $HOME/.signature >> $WORK			;;		esac	    fi	fi	;;follow|post)	LOGNAME=`logname`	UNAME=`uname -n`	NAME=`cat /../lorien/usr/lib/uucp/L-users | fgrep $LOGNAME | fgrep $UNAME | head -1 | cut -d\  -f1`	if test "X"$NAME = "X"	then		echo "Sie haben leider keine zulaessige UUCP-Adresse und koennen deshalb nicht"		echo "posten. Wenden sie sich an 'postmaster', falls sie eine UUCP-Adresse"		echo "benoetigen. Ihr Artikel wurde nicht verschickt."		echo "                                                                 <Return>"		read DUMMY		exit 2	fi	PAT=$NAME	FROM=$NAME"@uniol.UUCP"	if test -s $HOME/.fullname ; then		FULLNAME=`cat $HOME/.fullname`	else		echo -n "Enter your full name: "		read FULLNAME		echo Your name is now stored in "~/.fullname"		echo $FULLNAME > $HOME/.fullname		sleep 2	fi	if $APPENDSIG ; then	    if [ -f $HOME/.signature ] ; then		awk 'END{printf "Append .signature? (y) : "}' < /dev/null		read ans		case $ans in		''|y*|Y*)			echo "--" >> $WORK			cat $HOME/.signature >> $WORK			;;		esac	    else		echo "File $HOME/.signature does not exist."		sleep 2	    fi	fi	echo "Be patient! Your new article will not show up immediately."	sleep 3	;;esac{	trap 'echo SIGNAL' 1 2 3	case "$OPERATION" in	reply|forward|mail)		{		echo "From: `logname` (`cat $HOME/.fullname`)"		cat $WORK		} | grep -v "^Orig-To: " | /usr/lib/sendmail -bm -t		x=$?		;;	follow|post)		{		echo "From: $FROM ($FULLNAME)"		echo "Path: $PAT"		grep -v "^Orig-To: " $WORK		} | $INEWS -h		x=$?		# wait for inews to finish		sleep 60		;;	*)		echo "Invalid operation: $OPERATION -- help"		OPERATION="nn response operation"		x=1		cat > /dev/null		;;	esac > $TRACE 2>&1	if [ 0"$x" -ne 0 -o -s $TRACE ] ; then		if [ -s $HOME/dead.letter ] ; then			cat $HOME/dead.letter >> $HOME/dead.letters			echo '' >> $HOME/dead.letters		fi		grep -v "^Orig-To: " $WORK > $HOME/dead.letter		{		echo "To: ${LOGNAME-$USER}"		echo "Subject: $OPERATION failed"		echo ''		cat $TRACE		echo ''		echo 'Your response has been saved in ~/dead.letter'		echo ''		echo 'Your article/letter follows:'		cat $WORK		} | $RECMAIL			elif [ -n "${RECORD}" ] ; then		{		# keep a copy of message in $RECORD (in mail format)		unset LANGUAGE		set `date`		if [ $3 -gt 9 ] ; then			echo From ${LOGNAME-$USER} $1 $2 $3 $4 $6 $7		else			echo From ${LOGNAME-$USER} $1 $2 ' '$3 $4 $6 $7		fi		echo "From: ${LOGNAME-$USER}"		grep -v '^Orig-To: ' $WORK		echo '' 		} >> "$RECORD"	fi	rm -f $WORK $TRACE} > /dev/null 2>&1 &exit 0