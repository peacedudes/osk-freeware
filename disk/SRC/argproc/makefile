********************************************************************************	This is the makefile for argproc compilation under OS9********************************************************************************	Default directories*	DDIR =*	SDIR =*	RDIR =*	Compiler, assembler & linker flagsCFLAGS = -t=/r0 -dos9RFLAGS =LFLAGS = -t=/r0 -dos9 -m=100 -g*	ObjectsObjects = varargs.r argproc.r makeargv.r lose.r demo.rdemo: demo.r lose.r argproc.r varargs.r	cc $(LFLAGS) -f=demo demo.r lose.r argproc.r varargs.r$(Objects): varargs.hargproc.l: argproc.r makeargv.r lose.r varargs.r	merge makeargv.r lose.r argproc.r varargs.r >argproc.l*	End of makefile