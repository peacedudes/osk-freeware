#! /bin/csh -f## Compare OS-9/68000 relocatable files here with those on a remote computer.## Julian Blake, CERN, October 1990.#echo -n ' Remote host ? 'set RMTHOST = $<echo -n ' Remote user ? 'set RMTUSER = $<echo -n ' Remote password ? 'set RMTPASS = $<echo -n ' Remote directory ? 'set RMTDIR = $<foreach I ($argv)	set J = $I	echo Comparing $I $J	ftp -n $RMTHOST <<EOFuser $RMTUSER $RMTPASScd $RMTDIRbinaryget $J "| cmpr $I -"quitEOFend