** alloca for OSK**   MicroWare's CC uses stack pointer to address local variables,*   regardless of the codes `link a5,#0' and `unlk a5' it generates. *   Furthermore, local variables in a block are allocated dynamically*   and stack pointer may vary in a function execution.  Consequentally,*   alloca.c is not suitable for the use in OSK.  (A.S.)* psect alloca_a,0,0,0,0,0 nam alloca vsect__last_alloca_header dc.l 0__alloca_max_size: dc.l 0 endsalloca: link    a5,#0 movem.l d0/a2-a4,-(sp) cmp.l   __alloca_max_size(a6),d0 bls.s   alloca0 move.l d0,__alloca_max_size(a6)alloca0 movea.l (a5),a2 lea.l   __last_alloca_header(a6),a3 movea.l (a3),a4 bra.s   free1free0 cmpa.l  4(a4),a2 bls.s   alloc movea.l (a4),a4 bsr     freefree1 move.l  a4,d0 bne.s   free0alloc move.l  a4,(a3) move.l  (sp),d0 beq.s   rts0 addq.l  #8,d0 bsr     malloc tst.l   d0 beq.s   ca_err movea.l d0,a4 move.l  (a3),(a4) move.l  a2,4(a4) move.l  a4,(a3) addq.l  #8,d0rts0 movem.l -12(a5),a2-a4 unlk    a5 rtsca_err lea     err_msg(pc),a0 move.l  a0,d1 lea     _iob+56(a6),a0 move.l  a0,d0 bsr     fprintf moveq.l #1,d0 bsr     exit unlk    a5 rts**  gcc for OSK call _free_allocaed at function epilogue if that function*  call alloca.*_free_allocaed: link    a5,#0 movem.l d0/a2-a4,-(sp) movea.l (a5),a2 lea     __last_alloca_header(a6),a3 movea.l (a3),a4 bra.s   free3free4 cmpa.l  4(a4),a2 blo.s   rts1 movea.l (a4),a4 bsr     freefree3 move.l  a4,d0 bne.s   free4rts1 move.l  a4,(a3) movem.l (sp),d0/a2-a4 unlk    a5 rtserr_msg dc.b   "alloca : Memory exhausted",$d,$0 ends