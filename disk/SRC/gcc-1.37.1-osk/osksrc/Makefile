##  make cccp cppcccp (module name cpp) move_if_change and really_new#                                         90/04/05  A.S.###  copy source files  (use with -b option)#ODIR = .XDIR = /dd/cmdsall: do_copy force	@make cccp cppcccp move_if_change really_new ODIR=$(XDIR)do_copy: ../cccp.c ../cexp.c ../version.c	copy -b=200K -rapw=. $?	@touch do_copyforce:##  compile files      (use sans -b option)#CFLAGS = -qRFLAGS = -qLFLAGS = -i -e=1 -bg	# make ghost modulecccp: cccp.r cexp.r version.r perror.r alloca.r	cc $(LFLAGS) -f=$@ -m=32K cccp.r cexp.r version.r perror.r alloca.rcccp.r cexp.r: config.hcppcccp: cppcccp.r	cc $(LFLAGS) -f=$@ -n=cpp cppcccp.rmove_if_change:really_new: