#! /bin/csh -f## Compare ASCII files here with those on a remote computer.## Julian Blake, CERN, October 1990.#echo -n ' Remote host ? 'set RMTHOST = $<echo -n ' Remote user ? 'set RMTUSER = $<echo -n ' Remote password ? 'set RMTPASS = $<echo -n ' Remote directory ? 'set RMTDIR = $<foreach I ($argv)	set J = $I	echo Comparing $I $J	ftp -n $RMTHOST <<EOFuser $RMTUSER $RMTPASScd $RMTDIRget $J "| diff -h $I -"quitEOFend