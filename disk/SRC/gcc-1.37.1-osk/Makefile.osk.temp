# Makefile for GNU C compiler.#   Copyright (C) 1987, 1988 Free Software Foundation, Inc.# This file is part of GNU CC.# GNU CC is free software; you can redistribute it and/or modify# it under the terms of the GNU General Public License as published by# the Free Software Foundation; either version 1, or (at your option)# any later version.# GNU CC is distributed in the hope that it will be useful,# but WITHOUT ANY WARRANTY; without even the implied warranty of# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the# GNU General Public License for more details.# You should have received a copy of the GNU General Public License# along with GNU CC; see the file COPYING.  If not, write to# the Free Software Foundation, 675 Mass Ave, Cambridge, MA 02139, USA.# OSK specialization by A.Seyama 89/08/05, 90/04/03# Last modified by Julian Blake, 91/02/25# edition number of cc1CC1ED = 20# edition number of cccpCCCPED = 3# edition number of gccGCCED = 4# Stage dependent macros.## R = /H0/OSK/CMDS# S=STAGE0# CC=cc# CFLAGS = -DMWC68 -DUSE_C_ALLOCA# O68 =# RF = -r# LDFLAGS = -m=9K -i# OF = -f=# IDIR = -v=## R=STAGE0# S=STAGE1# C0=gcc# CFLAGS=# RF=-c# "LDFLAGS=-s 9K -cio"# IDIR = -I# "OF=-o "## R=STAGE1# S=STAGE2# C0=gcc# "CFLAGS=-O -fcombine-regs"# "O68=-o68"# "RF=-c"# "LDFLAGS=-s 9K -cio"# IDIR = -I# "OF=-o "R=SELFS=$RC0=gccCFLAGS=-O -fcombine-regs -mgssO68=-o68RF=-cIDIR=-IOF=-o # host library directoryHOST_LIBDIR = /H0/LIB# home directory where this file is (used if full path is needed)# and stage directory (ABS is absolute path)home_gcc = /H0/GCCABS = $(home_gcc)/$S# directory of library sources for OSKlibsrc = osksrc# Temporary directory used to make gnulib1 and gnulib2tmplibdir = GNULIBTEMP# In stage0, CC is overwritten by stage0.sh.CC = $(home_gcc)/$R/$(C0) -B$(home_gcc)/$R/LDFLAGS = -s 9K -cio -L$(home_gcc)/$R# Only for documentationNO68 =DO_NOTHING = echo >>>/nil#INCLUDES = $(IDIR)$(home_gcc) $(IDIR)$(home_gcc)/config $(IDIR)$(home_gcc)/$(libsrc)LIBINCLUDES = $(IDIR)$(home_gcc)/$(libsrc)#OBJDIR = $(OF)$(ABS)# OLDCC should not be the GNU C compiler.OLDCC = ccBISON = bisonBISONFLAGS = -v# missing libraries for OSKCLIB = $S/perror.r $S/getcd.r $S/ldexp.r $S/stat.r $S/qsort.rLCLIB = -l=$S/perror.r -l=$S/getcd.r -l=$S/ldexp.r -l=$S/stat.r -l=$S/qsort.rALLOCA = $S/alloca.rLALLOCA = -l=$S/alloca.rMALLOC =LMALLOC =OBSTACK = $S/obstack.rLOBSTACK = -l=$S/obstack.r# Dependency on obstack, alloca, malloc or whatever library facilities# are not installed in the system libraries.LIBDEPS= $(OBSTACK) $(ALLOCA) $(MALLOC) $(CLIB)# How to link with both our special library facilities# and the system's installed libraries.LIBS = $(OBSTACK) $(ALLOCA) $(MALLOC) $(CLIB)LLIBS = $(LOBSTACK) $(LALLOCA) $(LMALLOC) $(LCLIB)# Language-specific object files for C.C_OBJS = $S/c_parse.tab.r $S/c_decl.r $S/c_typeck.r $S/c_convert.r# Language-independent object files.OBJS1 = $S/toplev.r $S/version.r $S/tree.r $S/print_tree.r $S/stor_layout.r \	$S/fold_const.r $S/rtl.rOBJS2 = $S/rtlanal.r $S/expr.r $S/stmt.r $S/expmed.r $S/explow.r $S/optabs.r \	$S/varasm.r $S/symout.r $S/dbxout.r $S/sdbout.rOBJS3 = $S/emit_rtl.r $S/insn_emit.r $S/integrate.r $S/jump.r $S/cse.r \	$S/loop.r $S/flow.r $S/stupid.rOBJS4 = $S/combine.r $S/regclass.r $S/local_alloc.r $S/global_alloc.r \	$S/reload.r $S/reload1.rOBJS5 = $S/caller_save.r $S/insn_peep.r $S/final.r $S/recog.r $S/insn_recog.r \	$S/insn_extract.rOBJS6 = $S/insn_output.rOBJS  = $(OBJS1) $(OBJS2) $(OBJS3) $(OBJS4) $(OBJS5) $(OBJS6)# Library members defined in gnulib.c# Don't change order of names.  (A.S.)# Fortunately, output of MicroWare's c68 does not use d2 and d3 in # _eprintf, _builtin_new, _builtin_gNew and _builtin_del.LIBFUNCS = _eprintf _umulsi3 _mulsi3 _udivsi3 _divsi3 _umodsi3 _modsi3 \  _lshrsi3 _lshlsi3 _ashrsi3 _ashlsi3 _divdf3 _muldf3 _negdf2 _adddf3 \  _subdf3 _cmpdf2 _fixunsdfsi _fixdfsi _floatsidf _truncdfsf2 _extendsfdf2 \  _addsf3 _negsf2 _subsf3 _cmpsf2 _mulsf3 _divsf3 _builtin_new _builtin_gNew \  _builtin_del _stack_check# Library members defined in gnulib2.c.# Don't change order of names.  (A.S.)LIB2FUNCS = _anddi3 _ashldi3 _divdi3 _udivdi3 _fixdfdi _fixunsdfdi _adddi3 \  _floatdidf _ashrdi3 _lshldi3 _subdi3 _iordi3 _lshrdi3 _moddi3 _cmpdi2 \  _negdi2 _umoddi3 _bdiv _muldi3 _one_cmpldi2 _ucmpdi2 _varargs _xordi3# Header files that are made available to programs compiled with gcc.USER_H = stddef.h stdarg.h assert.h limits.h va_osk.h# If you want to recompile everything, just do rm *.o.# CONFIG_H = config.h tm.hCONFIG_H =RTL_H = rtl.h rtl.def machmode.defTREE_H = tree.h real.h tree.def machmode.def# Generate all objectsall: $S/gnulib1 $S/gnulib2 $S/gcc $S/cccp $S/cc1	@echo done.gnulib: $S/gnulib1 $S/gnulib2	@echo done.gcc: $S/gcc	@echo done.cccp: $S/cccp	@echo done.cc1: $S/cc1	@echo done.# Making the preprocessor$S/cccp: $S/cccp.r $S/cexp.r $S/version.r $(LIBDEPS)	l68 #32K -o=$(ABS)/cccp -ga -e=$(CCCPED) -M=32K \	$(HOST_LIBDIR)/cstart.r $S/cccp.r $S/cexp.r $S/version.r $(LLIBS) \	-l=$S/gnulib.l -l=$(home_gcc)/cio.l -l=$(HOST_LIBDIR)/clibn.l \	-l=$(HOST_LIBDIR)/math.l -l=$(HOST_LIBDIR)/sys.l$S/cexp.r: cexp.c $(CONFIG_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) cexp.c	@copy cexp.r -rapw=$S ; del cexp.rcexp.c: cexp.y	$(BISON) -o cexp.c cexp.y$S/cccp.r: cccp.c $(CONFIG_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) cccp.c	@copy cccp.r -rapw=$S ; del cccp.r# Making compiler driver$S/gcc: $S/gccosk.r $S/version.r $(LIBDEPS)	l68 #32K -o=$(ABS)/gcc -ga -e=$(GCCED) -M=32K \	$(HOST_LIBDIR)/cstart.r $S/gccosk.r $S/version.r $(LLIBS) \	-l=$S/gnulib.l -l=$(home_gcc)/cio.l -l=$(HOST_LIBDIR)/clibn.l \	-l=$(HOST_LIBDIR)/math.l -l=$(HOST_LIBDIR)/sys.l$S/gccosk.r: gccosk.c $(CONFIG_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) gccosk.c	@copy gccosk.r -rapw=$S ; del gccosk.r# Making the compiler## `echo -n': Command buffer of OSK's shell is too small (512bytes) to#            use $(OBJS) directory.# `l68'    : If linker l68 is called from $(CC), then l68's stack overflows.$S/cc1: $(C_OBJS) $(OBJS) $(LIBDEPS)	@echo -n $(HOST_LIBDIR)/cstart.r>-$S/rof.names	@echo -n $(C_OBJS)>+$S/rof.names	@echo -n $(OBJS1)>+$S/rof.names	@echo -n $(OBJS2)>+$S/rof.names	@echo -n $(OBJS3)>+$S/rof.names	@echo -n $(OBJS4)>+$S/rof.names	@echo -n $(OBJS5)>+$S/rof.names	@echo -n $(OBJS6)>+$S/rof.names	l68 #32K -o=$(ABS)/cc1 -ga -e=$(CC1ED) -M=7K \	-z=$S/rof.names $(LLIBS) \	-l=$S/gnulib.l -l=$(home_gcc)/cio.l -l=$(HOST_LIBDIR)/clibn.l \	-l=$(HOST_LIBDIR)/math.l -l=$(HOST_LIBDIR)/sys.l	@echo -r "Compilation finished at " ; date# C language specific files.$S/c_parse.tab.r : c_parse.tab.c $(CONFIG_H) $(TREE_H) c_parse.h c_tree.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) c_parse.tab.c	@copy c_parse.tab.r -rapw=$S ; del c_parse.tab.rc_parse.tab.c : c_parse.y	$(BISON) $(BISONFLAGS) c_parse.y$S/c_decl.r : c_decl.c $(CONFIG_H) $(TREE_H) c_tree.h c_parse.h flags.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) c_decl.c	@copy c_decl.r -rapw=$S ; del c_decl.r$S/c_typeck.r : c_typeck.c $(CONFIG_H) $(TREE_H) c_tree.h flags.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) c_typeck.c	@copy c_typeck.r -rapw=$S ; del c_typeck.r$S/c_convert.r : c_convert.c $(CONFIG_H) $(TREE_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) c_convert.c	@copy c_convert.r -rapw=$S ; del c_convert.r# Language-independent files.$S/tree.r : tree.c $(CONFIG_H) $(TREE_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) tree.c	@copy tree.r -rapw=$S ; del tree.r$S/print_tree.r : print_tree.c $(CONFIG_H) $(TREE_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) print_tree.c	@copy print_tree.r -rapw=$S ; del print_tree.r$S/stor_layout.r : stor_layout.c $(CONFIG_H) $(TREE_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) stor_layout.c	@copy stor_layout.r -rapw=$S ; del stor_layout.r$S/fold_const.r : fold_const.c $(CONFIG_H) $(TREE_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) fold_const.c	@copy fold_const.r -rapw=$S ; del fold_const.r$S/toplev.r : toplev.c $(CONFIG_H) $(TREE_H) flags.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) toplev.c	@copy toplev.r -rapw=$S ; del toplev.r$S/rtl.r : rtl.c $(CONFIG_H) $(RTL_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) rtl.c	@copy rtl.r -rapw=$S ; del rtl.r$S/rtlanal.r : rtlanal.c $(CONFIG_H) $(RTL_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) rtlanal.c	@copy rtlanal.r -rapw=$S ; del rtlanal.r$S/varasm.r : varasm.c $(CONFIG_H) $(TREE_H) $(RTL_H) flags.h expr.h \  insn_codes.h hard_reg_set.h	-really_new $@ $? insn_codes.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) varasm.c ;\	copy varasm.r -rapw=$S ; del varasm.r$S/stmt.r : stmt.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h insn_flags.h expr.h \  insn_config.h regs.h insn_codes.h recog.h	-really_new $@ $? insn_flags.h insn_config.h insn_codes.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) stmt.c ;\	copy stmt.r -rapw=$S ; del stmt.r$S/expr.r : expr.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h insn_flags.h \  insn_codes.h expr.h insn_config.h recog.h	-really_new $@ $? insn_flags.h insn_codes.h insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) expr.c ;\	copy expr.r -rapw=$S ; del expr.r$S/expmed.r : expmed.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h insn_flags.h \  insn_codes.h expr.h insn_config.h recog.h	-really_new $@ $? insn_flags.h insn_codes.h insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) expmed.c ;\	copy expmed.r -rapw=$S ; del expmed.r$S/explow.r : explow.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h expr.h \  insn_codes.h	-really_new $@ $? insn_codes.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) explow.c ;\	copy explow.r -rapw=$S ; del explow.r$S/optabs.r : optabs.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h insn_flags.h \  insn_codes.h expr.h insn_config.h recog.h	-really_new $@ $? insn_flags.h insn_codes.h insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) optabs.c ;\	copy optabs.r -rapw=$S ; del optabs.r$S/symout.r : symout.c $(CONFIG_H) $(TREE_H) $(RTL_H) symseg.h gdbfiles.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) symout.c	@copy symout.r -rapw=$S ; del symout.r$S/dbxout.r : dbxout.c $(CONFIG_H) $(TREE_H) $(RTL_H) flags.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) dbxout.c	@copy dbxout.r -rapw=$S ; del dbxout.r$S/sdbout.r : sdbout.c $(CONFIG_H) $(TREE_H) $(RTL_H) c_tree.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) sdbout.c	@copy sdbout.r -rapw=$S ; del sdbout.r$S/emit_rtl.r : emit_rtl.c $(CONFIG_H) $(RTL_H) regs.h insn_config.h real.h	-really_new $@ $? insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) emit_rtl.c ;\	copy emit_rtl.r -rapw=$S ; del emit_rtl.r$S/integrate.r : integrate.c $(CONFIG_H) $(RTL_H) $(TREE_H) flags.h expr.h \  insn_flags.h insn_codes.h	-really_new $@ $? insn_flags.h insn_codes.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) integrate.c ;\	copy integrate.r -rapw=$S ; del integrate.r$S/jump.r : jump.c $(CONFIG_H) $(RTL_H) flags.h regs.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) jump.c	@copy jump.r -rapw=$S ; del jump.r$S/stupid.r : stupid.c $(CONFIG_H) $(RTL_H) regs.h hard_reg_set.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) stupid.c	@copy stupid.r -rapw=$S ; del stupid.r$S/cse.r : cse.c $(CONFIG_H) $(RTL_H) regs.h hard_reg_set.h flags.h real.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) cse.c	@copy cse.r -rapw=$S ; del cse.r$S/loop.r : loop.c $(CONFIG_H) $(RTL_H) insn_config.h insn_codes.h \  regs.h recog.h flags.h expr.h	-really_new $@ $? insn_config.h insn_codes.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) loop.c ;\	copy loop.r -rapw=$S ; del loop.r$S/flow.r : flow.c $(CONFIG_H) $(RTL_H) basic_block.h regs.h hard_reg_set.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) flow.c	@copy flow.r -rapw=$S ; del flow.r$S/combine.r : combine.c $(CONFIG_H) $(RTL_H) flags.h  \  insn_config.h regs.h basic_block.h recog.h	-really_new $@ $? insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) combine.c ;\	copy combine.r -rapw=$S ; del combine.r$S/regclass.r : regclass.c $(CONFIG_H) $(RTL_H) flags.h regs.h \  insn_config.h recog.h hard_reg_set.h	-really_new $@ $? insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) regclass.c ;\	copy regclass.r -rapw=$S ; del regclass.r$S/local_alloc.r : local_alloc.c $(CONFIG_H) $(RTL_H) basic_block.h regs.h \  insn_config.h recog.h hard_reg_set.h	-really_new $@ $? insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) local_alloc.c ;\	copy local_alloc.r -rapw=$S ; del local_alloc.r$S/global_alloc.r : global_alloc.c $(CONFIG_H) $(RTL_H) flags.h  \  basic_block.h regs.h hard_reg_set.h insn_config.h	-really_new $@ $? insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) global_alloc.c ;\	copy global_alloc.r -rapw=$S ; del global_alloc.r$S/reload.r : reload.c $(CONFIG_H) $(RTL_H)  \  reload.h recog.h hard_reg_set.h insn_config.h regs.h	-really_new $@ $? insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) reload.c ;\	copy reload.r -rapw=$S ; del reload.r$S/reload1.r : reload1.c $(CONFIG_H) $(RTL_H) flags.h reload.h regs.h \  hard_reg_set.h insn_config.h basic_block.h recog.h	-really_new $@ $? insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) reload1.c ;\	copy reload1.r -rapw=$S ; del reload1.r$S/caller_save.r : caller_save.c $(CONFIG_H) $(RTL_H) flags.h reload.h regs.h \  hard_reg_set.h insn_config.h basic_block.h recog.h	-really_new $@ $? insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) caller_save.c ;\	copy caller_save.r -rapw=$S ; del caller_save.r$S/final.r : final.c $(CONFIG_H) $(RTL_H) regs.h recog.h conditions.h \  gdbfiles.h insn_config.h real.h	-really_new $@ $? insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) final.c ;\	copy final.r -rapw=$S ; del final.r$S/recog.r : recog.c $(CONFIG_H) $(RTL_H) regs.h recog.h hard_reg_set.h \  insn_config.h	-really_new $@ $? insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) recog.c ;\	copy recog.r -rapw=$S ; del recog.r$S/version.r : version.c	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) version.c	@copy version.r -rapw=$S ; del version.r# Now the source files that are generated from the machine description.#.PRECIOUS: insn_config.h insn_flags.h insn_codes.h insn_emit.c insn_recog.c \# insn_extract.c insn_output.c insn_peep.c# The following pair of rules has this effect:# genconfig is run only if the md has changed since genconfig was last run;# but the file insn_config.h is touched only when its contents actually change.# Each of the other insn_* files is handled by a similar pair of rules.# For OSK, really_new is needed to imitate orignal behavior.  (A.S.)insn_config.h: $S/stamp_config.h	@$(DO_NOTHING)$S/stamp_config.h: md $S/genconfig	$(ABS)/genconfig md>-tmp_config.h	move_if_change tmp_config.h insn_config.h	@touch $S/stamp_config.hinsn_flags.h: $S/stamp_flags.h	@$(DO_NOTHING)$S/stamp_flags.h: md $S/genflags	$(ABS)/genflags md>-tmp_flags.h	move_if_change tmp_flags.h insn_flags.h	@touch $S/stamp_flags.hinsn_codes.h: $S/stamp_codes.h	@$(DO_NOTHING)$S/stamp_codes.h: md $S/gencodes	$(ABS)/gencodes md>-tmp_codes.h	move_if_change tmp_codes.h insn_codes.h	@touch $S/stamp_codes.h$S/insn_emit.r : insn_emit.c $(CONFIG_H) $(RTL_H) expr.h insn_config.h real.h \  insn_codes.h	-really_new $@ $? insn_emit.c insn_config.h insn_codes.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) insn_emit.c ;\	copy insn_emit.r -rapw=$S ; del insn_emit.rinsn_emit.c: $S/stamp_emit.c	@$(DO_NOTHING)$S/stamp_emit.c: md $S/genemit	$(ABS)/genemit md>-tmp_emit.c	move_if_change tmp_emit.c insn_emit.c	@touch $S/stamp_emit.c$S/insn_recog.r : insn_recog.c $(CONFIG_H) $(RTL_H) insn_config.h real.h \  recog.h	-really_new $@ $? insn_recog.c insn_config.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) insn_recog.c ;\	copy insn_recog.r -rapw=$S ; del insn_recog.rinsn_recog.c: $S/stamp_recog.c	@$(DO_NOTHING)$S/stamp_recog.c:md $S/genrecog	$(ABS)/genrecog md>-tmp_recog.c	move_if_change tmp_recog.c insn_recog.c	@touch $S/stamp_recog.c$S/insn_extract.r : insn_extract.c $(RTL_H)	-really_new $@ $? insn_extract.c ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) insn_extract.c ;\	copy insn_extract.r -rapw=$S ; del insn_extract.rinsn_extract.c: $S/stamp_extract.c	@$(DO_NOTHING)$S/stamp_extract.c: md $S/genextract	$(ABS)/genextract md>-tmp_extract.c	move_if_change tmp_extract.c insn_extract.c	@touch $S/stamp_extract.c$S/insn_peep.r : insn_peep.c $(CONFIG_H) $(RTL_H) regs.h real.h	-really_new $@ $? insn_peep.c ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) insn_peep.c ;\	copy insn_peep.r -rapw=$S ; del insn_peep.rinsn_peep.c: $S/stamp_peep.c	@$(DO_NOTHING)$S/stamp_peep.c: md $S/genpeep	$(ABS)/genpeep md>-tmp_peep.c	move_if_change tmp_peep.c insn_peep.c	@touch $S/stamp_peep.c$S/insn_output.r : insn_output.c $(CONFIG_H) $(RTL_H) regs.h real.h \  conditions.h insn_config.h insn_flags.h output.h aux_output.c \  hard_reg_set.h	-really_new $@ $? insn_output.c insn_config.h insn_flags.h ;\	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) insn_output.c ;\	copy insn_output.r -rapw=$S ; del insn_output.rinsn_output.c: $S/stamp_output.c	@$(DO_NOTHING)$S/stamp_output.c: md $S/genoutput	$(ABS)/genoutput md>-tmp_output.c	move_if_change tmp_output.c insn_output.c	@touch $S/stamp_output.c# Now the programs that generate those files.$S/genconfig : $S/genconfig.r $S/rtl.r $(LIBDEPS)	$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genconfig $S/genconfig.r $S/rtl.r $(LIBS)$S/genconfig.r : genconfig.c $(RTL_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) genconfig.c	@copy genconfig.r -rapw=$S ; del genconfig.r$S/genflags : $S/genflags.r $S/rtl.r $(LIBDEPS)	$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genflags $S/genflags.r $S/rtl.r $(LIBS)$S/genflags.r : genflags.c $(RTL_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) genflags.c	@copy genflags.r -rapw=$S ; del genflags.r$S/gencodes : $S/gencodes.r $S/rtl.r $(LIBDEPS)	$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/gencodes $S/gencodes.r $S/rtl.r $(LIBS)$S/gencodes.r : gencodes.c $(RTL_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) gencodes.c	@copy gencodes.r -rapw=$S ; del gencodes.r$S/genemit : $S/genemit.r $S/rtl.r $(LIBDEPS)	$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genemit $S/genemit.r $S/rtl.r $(LIBS)$S/genemit.r : genemit.c $(RTL_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) genemit.c	@copy genemit.r -rapw=$S ; del genemit.r$S/genrecog : $S/genrecog.r $S/rtl.r $(LIBDEPS)	$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genrecog $S/genrecog.r $S/rtl.r $(LIBS)$S/genrecog.r : genrecog.c $(RTL_H)	$(CC) $(INCLUDES) $(CFLAGS) $(NO68) $(RF) genrecog.c	@copy genrecog.r -rapw=$S ; del genrecog.r$S/genextract : $S/genextract.r $S/rtl.r $(LIBDEPS)	$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genextract $S/genextract.r $S/rtl.r $(LIBS)$S/genextract.r : genextract.c $(RTL_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) genextract.c	@copy genextract.r -rapw=$S ; del genextract.r$S/genpeep : $S/genpeep.r $S/rtl.r $(LIBDEPS)	$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genpeep $S/genpeep.r $S/rtl.r $(LIBS)$S/genpeep.r : genpeep.c $(RTL_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) genpeep.c	@copy genpeep.r -rapw=$S ; del genpeep.r$S/genoutput : $S/genoutput.r $S/rtl.r $(LIBDEPS)	$(CC) $(INCLUDES) $(LDFLAGS) $(OBJDIR)/genoutput $S/genoutput.r $S/rtl.r $(LIBS)$S/genoutput.r : genoutput.c $(RTL_H)	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) genoutput.c	@copy genoutput.r -rapw=$S ; del genoutput.r$S/obstack.r: obstack.c obstack.h	$(CC) $(INCLUDES) $(CFLAGS) $(O68) $(RF) obstack.c	@copy obstack.r -rapw=$S ; del obstack.r# missing libraries for OSK.$S/qsort.r: $(libsrc)/qsort.c	@copy $(libsrc)/qsort.c ; attr -a -w qsort.c	$(CC) $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) qsort.c	@copy qsort.r -rapw=$S ; del qsort.r qsort.c$S/perror.r: $(libsrc)/perror.c	@copy $(libsrc)/perror.c ; attr -a -w perror.c	$(CC) $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) perror.c	@copy perror.r -rapw=$S ; del perror.r perror.c$S/getcd.r: $(libsrc)/getcd.c	@copy $(libsrc)/getcd.c ; attr -a -w getcd.c	$(CC) $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) getcd.c	@copy getcd.r -rapw=$S ; del getcd.r getcd.c$S/ldexp.r: $(libsrc)/ldexp.c	@copy $(libsrc)/ldexp.c ; attr -a -w ldexp.c	$(CC) $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) ldexp.c	@copy ldexp.r -rapw=$S ; del ldexp.r ldexp.c$S/stat.r: $(libsrc)/stat.c	@copy $(libsrc)/stat.c ; attr -a -w stat.c	$(CC) $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) stat.c	@copy stat.r -rapw=$S ; del stat.r stat.c$S/alloca.r: $(libsrc)/alloca.a	@copy $(libsrc)/alloca.a ; attr -a -w alloca.a	$(CC) $(LIBINCLUDES) $(CFLAGS) $(O68) $(RF) alloca.a	@copy alloca.r -rapw=$S ; del alloca.r alloca.a# Library of arithmetic subroutines# Don't compile this with gcc!$S/gnulib1: gnulibosk.c	makdir $(tmplibdir)	copy gnulibosk.c $(tmplibdir)/temp	@chd $(tmplibdir) ; attr -a -w temp ; echo -n $(LIBFUNCS) !\	cfp -zne "-s=rename temp *.c ; $(OLDCC) -qsr -DL* *.c ;\	rename *.c temp" ! shell -np	@chd $(tmplibdir) ; echo -n $(LIBFUNCS) !\	cfp -zne "-s=echo *.r" ! shell -np >>/nil ! merge -z>-../$S/gnulib1	deldir -q $(tmplibdir)	copy -r $S/gnulib1 $S/gnulib.l# gnulib2.c$S/gnulib2: $S/gnulib1 gnulib2.c $S/cc1 $S/gccosk $S/cccp $(CONFIG_H)	makdir $(tmplibdir)	copy gnulib2.c $(tmplibdir)/temp	@chd $(tmplibdir) ; attr -a -w temp ; echo -n $(LIB2FUNCS) !\	cfp -zne "-s=rename temp *.c ; $(CC) -c -I.. -I../config -o68 \	-mnostack-check -fcombine-regs -fstrength-reduce \	-Dalloca=__builtin_alloca -DL* *.c ; rename *.c temp" ! shell -np	@chd $(tmplibdir) ; echo -n $(LIB2FUNCS) !\	cfp -zne "-s=echo *.r" ! shell -np >>/nil ! merge -z>-../$S/gnulib2	deldir -q $(tmplibdir)	merge $S/gnulib2 $S/gnulib1>-$S/gnulib.l