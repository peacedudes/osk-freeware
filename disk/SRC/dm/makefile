# Makefile to compile Diskmaster# Copyright (c) 1995 by Bob Devries# For the SECAD AS-68KVER = 1REV = 3CC = ccODIR    = /r0RDIR	= relsSDIR    = .CFLAGS  = -t=/r0 -dVER=$(VER) -dREV=$(REV)RFILES	= diskmaster.r screen.r dirread.r showfiles.r misc.r error.r unarc.r \mouse.r multicopy.r multidel.r multimove.r multiattr.r shellsort.r \multitag.r listarc.rdm: $(RFILES)	chd $(RDIR); l68 /dd/lib/cstart.r $(RFILES) -o=/r0/dm \-l=/dd/lib/cio.l -l=../lib/alib.l -l=/dd/lib/clib.l -l=/dd/lib/sys.l -a    copy -r /r0/dm CMDS/dm.secad    touch dm.secad.datedm.doc: .dm.vpt       vpt .dm.vpt -i=/h0/usr/vpt/init/vpt..txt >-dm.doc# Dependenciesdiskmaster.r: diskmaster.c diskmaster.h screen.h       $(CC) $(CFLAGS) -r=$(RDIR) diskmaster.cscreen.r: screen.c screen.h       $(CC) $(CFLAGS) -r=$(RDIR) screen.cdirread.r: dirread.c diskmaster.h       $(CC) $(CFLAGS) -r=$(RDIR) dirread.cshowfiles.r: showfiles.c diskmaster.h screen.h       $(CC) $(CFLAGS) -r=$(RDIR) showfiles.cmisc.r: misc.c diskmaster.h screen.h       $(CC) $(CFLAGS) -r=$(RDIR) misc.cerror.r: error.c screen.h       $(CC) $(CFLAGS) -r=$(RDIR) error.cunarc.r: unarc.c diskmaster.h screen.h       $(CC) $(CFLAGS) -r=$(RDIR) unarc.cmouse.r: mouse.c       $(CC) $(CFLAGS) -r=$(RDIR) mouse.cmulticopy.r: multicopy.c diskmaster.h       $(CC) $(CFLAGS) -r=$(RDIR) multicopy.cmultidel.r: multidel.c diskmaster.h       $(CC) $(CFLAGS) -r=$(RDIR) multidel.cmultimove.r: multimove.c diskmaster.h       $(CC) $(CFLAGS) -r=$(RDIR) multimove.cmultiattr.r: multiattr.c diskmaster.h       $(CC) $(CFLAGS) -r=$(RDIR) multiattr.cshellsort.r: shellsort.c       $(CC) $(CFLAGS) -r=$(RDIR) shellsort.cmultitag.r:  multitag.c diskmaster.h       $(CC) $(CFLAGS) -r=$(RDIR) multitag.clistarc.r:   listarc.c diskmaster.h       $(CC) $(CFLAGS) -r=$(RDIR) listarc.c# EOF makefile