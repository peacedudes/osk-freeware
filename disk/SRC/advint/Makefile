#Makefile for adventure systemRDIR = RELSODIR = /h0/cmds/dogCFLAGS = -qixt=/r0all: advcom advint	@echo all madeadvcom: advcom.h advavl.h advcom.r advfcn.r advscn.r advexp.r advavl.r advfio.r	chd $(RDIR); cc -g $(CFLAGS) -f=advcom \					advcom.r advfcn.r advscn.r advexp.r advavl.r advfio.radvint: advint.h advmsg.r advtrm.r advprs.r advdbs.r advint.r advjunk.r advexe.r	chd $(RDIR); cc -g $(CFLAGS) -f=advint \				advmsg.r advtrm.r advprs.r advdbs.r advint.r advjunk.r advexe.r