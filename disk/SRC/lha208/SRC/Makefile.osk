# Microware C - Makefile for LHa for OSKTEMP      = /R0CC        = ccODIR      = /DD/CMDSOFILE     = LHaRDIR      = RELSMEM       = 16KEDITION   = 8LFLAGS    = -q -m=$(MEM) -e=$(EDITION)SWITCHIES = -DNOBSTRING -DTIME_H -DNOFTRUNCATE -DSYSV_SYSTEM_DIR -DOSK \            -DNOSTRDUP -DMKTIME -DNEED_INCREMENTAL_INDICATORLHOBJS    = lhadd.r header.r lharc.r lhext.r lhlist.rHUFOBJS   = append.r crcio.r dhuf.r extract.r huf.r larc.r maketbl.r \            maketree.r shuf.r slide.r util.rLIBOBJS   = strdup.r  osk.r ln.r #memmove.rCFLAGS    = -qt=$(TEMP) $(SWITCHIES)RFILES    = $(LHOBJS) $(HUFOBJS) $(LIBOBJS)$(OFILE)		: $(RFILES)	chd $(RDIR) ; $(CC) $(RFILES) $(LFLAGS) -f=$(ODIR)/$(OFILE)append.r		: append.c lharc.h lhdir.h intrface.hcrcio.r			: crcio.c slidehuf.h intrface.hdhuf.r			: dhuf.c slidehuf.hextract.r		: extract.c lharc.h lhdir.h intrface.hheader.r		: header.c lharc.h lhdir.hhuf.r			: huf.c slidehuf.hlarc.r			: larc.c slidehuf.hlhadd.r			: lhadd.c lharc.h lhdir.hlharc.r			: lharc.c lharc.h lhdir.hlhdir.r			: lhdir.c lhdir.hlhext.r			: lhext.c lharc.h lhdir.hlhlist.r		: lhlist.c lharc.h lhdir.hmaketbl.r		: maketbl.c slidehuf.hmaketree.r		: maketree.c slidehuf.hmemmove.r		: memmove.cmemset.r		: memset.cosk.r           : osk.cpatmatch.r		: patmatch.crename.r		: rename.cshuf.r			: shuf.c slidehuf.hslide.r			: slide.c lharc.h lhdir.h slidehuf.h intrface.hstrdup.r		: strdup.cstrucmp.r		: strucmp.cutil.r			: util.c lharc.h lhdir.hln.r            : ln.c   $(CC) -dLINK ln.c -qst=/r0 -r=$(RDIR)