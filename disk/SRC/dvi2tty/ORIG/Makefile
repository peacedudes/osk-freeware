# Makefile for dvi2tty and disdvi       23/01/89   M.J.E. Mol## For BSD Unix use the following CFLAGS definition# CFLAGS = -Dstrchr=index## This Makefile does not work for MSDOS. Make your # own one, or compile by hand.#CFLAGS=-it=/r0 -r -dstrchr=index# LFLAGS=-l=/dd/lib/unix.lLFLAGS=-l=/dd/lib/os9lib.lRDIR=RELSdvi2tty:dvi2tty.r dvistuff.r	chd $(RDIR);\	cc $(LFLAGS) dvi2tty.r dvistuff.r -f=dvi2ttydvi2tty.r: dvi2tty.c dvi2tty.hdvistuff.r: dvistuff.c dvi2tty.h commands.h