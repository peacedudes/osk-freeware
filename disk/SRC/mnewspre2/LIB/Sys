## $Log$##      Send all local written news and all news not received#      (expect local distributions and local groups)#      from `myfeed' to `myfeed':myfeed> C:!local\..* .*:!local *##      Send articles to scndfeed if articles haven't passed scndfeed#      and myfeed (expect local stuff):scndfeed/myfeed> C:!local\..* .*:!local *##      Hisfeed just get articles with distribution sub and muc, don't#      convert eight bit characters to a seven bit sequencehisfeed> N:.*:sub muc##      Forward all articels to local notes system (No change takes#      place on direct feeding to another program):to-notes:.*:*:newsinput