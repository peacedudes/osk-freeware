# $Id: Makefile_v 1.1 90/08/31 15:40:27 ud Exp $# $Log:        Makefile_v $# Revision 1.1  90/08/31  15:40:27  ud# Initial revision# #CC=    ccG=     -gCFLAGS=        -qt=/dd/TMP $G -v=.. -v=../8BITLIBS=  -l=/dd/LIB/os9lib.l -l=/h3/LIB/8bit.lLFLAGS=        -q $(LIBS) $GODIR=  /h0/ETC/CMDSBATCHC=        sbatch.c batch.c none.c com.c com7.c file.c exec.c conv.cBATCHR=        sbatch.r batch.r none.r com.r com7.r file.r exec.r conv.r$(ODIR)/sbatch:        $(BATCHR)       $(CC) $(LFLAGS) $(BATCHR) -f=$(ODIR)/sbatch       fixmod -uo2.39 -ua8002 $(ODIR)/sbatchtags:  $(BATCHC)       echo "Ctags:" $?       ctags $?sbatch.r:      sbatch.c sbatch.h