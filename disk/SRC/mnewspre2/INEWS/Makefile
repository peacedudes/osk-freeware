# $Id: Makefile_v 1.4 91/09/11 18:16:06 ud Exp $## $Log:        Makefile_v $# Revision 1.4  91/09/11  18:16:06  ud# Added pmail.[cr]# # Revision 1.3  91/01/02  21:27:07  ud# Added optional ndbm support# Added optional profiling options# # Revision 1.2  90/12/01  15:50:22  ud# Inserted two new files (adm.c and arc.c)# # Revision 1.1  90/08/31  15:05:15  ud# Initial revision# ## LIBDIR: where to find the converting library and (if desired) dbm-libLIBDIR=        /dd/LIB## If you use NDBM for history, then enter here the name of your library# DBMLIB=      -l=$(LIBDIR)/sdbm.lDBMLIB=## If you are using event locking use this library and include-directory# EVLIB=       -l=$(LIBDIR)/lock.l# EVDIR=       -v=../LOCKEVLIB=EVDIR=## ODIR: where to place the binaryRDIR=  RELSODIR=  /h0/ETC/CMDSCC=    ccG=     -gCFLAGS=        $G -qt=/dd/TMP -v=.. -v=../8BIT $(EVDIR)LIBS=  -l=/dd/LIB/os9lib.l -l=$(LIBDIR)/8bit.l \       $(DBMLIB) $(EVLIB)#CURSES=       -l=/dd/LIB/ncurses.lCURSES=        -l=.../MLIB/menulib.l -l=/dd/LIB/termlib.lLFLAGS=        $G -m=10 -q $(LIBS)REV=   1.7STATE= ExpCI=    ci -wud -u$(REV) -s$(STATE)SCTRL= ctrl.c ccan.c cnew.c crm.c cssys.c csuu.c csver.c cchk.c csme.c \       getd.c mcan.cSUTIL= limit.c list.c store.c ohist.c oart.c dbg.c pmail.c gfh.c hash.cSHEAD= delh.c ghead.c makh.c ihead.c mhead.c rhead.c shead.c spch.c app.cSHEAD2=        ddst.c alias.cSACT=  achk.c ract.c wact.cSSYS=  psys.c rsys.c tsys.cSADM=  adm.c arc.c build.c crct.c exp.c retr.c sect.cSMISC= ffrom.c ffup.c mail.c mid.c misc.c sinfo.c unln.c rsat.c inrd.cSINEWS=        inews.c pargs.c wgrp.c wit.c sit.c pit.c crth.cINEWSSRC=$(SINEWS) $(SCTRL) $(SUTIL) $(SHEAD) $(SHEAD2) $(SACT) $(SSYS) \       $(SADM) $(SMISC)IUSERSRC=uidummy.cMNEWSSRC=$(SINEWS) $(SCTRL) $(SUTIL) $(SHEAD) $(SHEAD2) $(SACT) $(SSYS) \       $(SADM) $(SMISC)MNEWSSRC=HEADS= ext.h inews.h hist.hFILES= $(INEWSSRC) $(HEADS) MakefileOCTRL= ctrl.r ccan.r cnew.r crm.r cssys.r csuu.r csver.r cchk.r csme.r \       getd.r mcan.rOUTIL= limit.r list.r store.r ohist.r oart.r dbg.r pmail.r gfh.r hash.rOHEAD= delh.r ghead.r makh.r ihead.r mhead.r rhead.r shead.r spch.r app.rOHEAD2=        ddst.r alias.rOACT=  achk.r ract.r wact.rOSYS=  psys.r rsys.r tsys.rOADM=  adm.r arc.r build.r crct.r exp.r retr.r sect.rOMISC= ffrom.r ffup.r mail.r mid.r misc.r sinfo.r unln.r rsat.r inrd.rOINEWS=        inews.r pargs.r wgrp.r wit.r sit.r pit.r crth.rINEWS= $(OINEWS) $(OUTIL) $(OCTRL) $(OHEAD) $(OHEAD2) $(OACT) $(OSYS) \       $(OADM) $(OMISC)IUSER= ../uidummy.rMNEWS= $(OINEWS) $(OUTIL) $(OCTRL) $(OHEAD) $(OHEAD2) $(OACT) $(OSYS) \       $(OADM) $(OMISC)MUSER=$(ODIR)/inews: $(INEWS) $(IUSER)       chd $(RDIR);$(CC) *.r $(IUSER) -f=$@ $(LFLAGS)       fixmod -uo2.39 -ua8002 $(ODIR)/inewsinews.r:       inews.c inews.h$(IUSER):      $(IUSERSRC)       $(CC) $(CFLAGS) -r=. $(IUSERSRC)inews.tags:       ctags $(INEWSSRC)mnews: $(MNEWS)       $(CC) $(MNEWS) $(MUSER) UI/*.r -f=mnews $(CURSES) $(LFLAGS)rcs:       $(CI) $(FILES)