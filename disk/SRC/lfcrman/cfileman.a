 nam lfcrman ttl lfcrman - Network TEXT file manager use defsfileEdition set 1Typ_Lang set (FlMgr<<8)+ObjctAttr_Rev set (ReEnt+SupStat)<<8+0PD_fd equ PD_FST psect netman,Typ_Lang,Attr_Rev,Edition,0,Entryerrno: equ $1e ; !!! PD_Errno in /DEFS/sysio.a !!! pageEntry: dc.w _Create-Entry dc.w _Open-Entry dc.w _MakDir-Entry dc.w _ChgDir-Entry dc.w _Delete-Entry dc.w _Seek-Entry dc.w _Read-Entry dc.w _Write-Entry dc.w _ReadLn-Entry dc.w _WriteLn-Entry dc.w _GetStat-Entry dc.w _SetStat-Entry dc.w _Close-Entry_Create: movem.l d0-d7/a0-a6,-(sp) bsr _setup bra Create_Open: movem.l d0-d7/a0-a6,-(sp) bsr _setup bra Open_MakDir: movem.l d0-d7/a0-a6,-(sp) bsr _setup bra MakDir_ChgDir: movem.l d0-d7/a0-a6,-(sp) bsr _setup bra ChgDir_Delete: movem.l d0-d7/a0-a6,-(sp) bsr _setup bra Delete_Seek: movem.l d0-d7/a0-a6,-(sp) bsr _setup bra Seek_Read: movem.l d0-d7/a0-a6,-(sp) bsr.s _setup bra Read_ReadLn: movem.l d0-d7/a0-a6,-(sp) bsr.s _setup bra ReadLn_Write: movem.l d0-d7/a0-a6,-(sp) bsr.s _setup bra Write_WriteLn: movem.l d0-d7/a0-a6,-(sp) bsr.s _setup bra WriteLn_GetStat: cmpi.w #SS_DevNm,R$d1+2(a5) bne.s _GetStat10 movem.l d0-d7/a0-a6,-(sp) bsr.s _setup bra GetStat_GetStat10: movem.l d1-d7/a0-a6,-(sp) move.l PD_fd(a1),d0 movem.l 4(a5),d1-d7/a0 OS9 I$GetStt movem.l d1-d7/a0,4(a5) movem.l (sp)+,d1-d7/a0-a6 rts* movem.l d0-d7/a0-a6,-(sp)* bsr.s _setup* bra GetStat_SetStat: movem.l d1-d7/a0-a6,-(sp) move.l PD_fd(a1),d0 movem.l 4(a5),d1-d7/a0 OS9 I$SetStt movem.l d1-d7/a0,4(a5) movem.l (sp)+,d1-d7/a0-a6 rts* movem.l d0-d7/a0-a6,-(sp)* bsr.s _setup* bra SetStat_Close: movem.l d0-d7/a0-a6,-(sp) bsr.s _setup bra Close_setup: move.l a6,PD_SysGlob(a1) ; System globals move.l a1,a6 ; Globals for C move.l (sp)+,a0 ; Return address move.l a4,d0 ; Process descriptor move.l a5,d1 ; User stack frame jsr (a0) ; Return tst.l d0 beq.s _setup90 ; No error movem.l (sp)+,d0-d7/a0-a6 move.l PD_ErrNo(a1),d1 ori.w #Carry,ccr rts _setup90: movem.l (sp)+,d0-d7/a0-a6 andi.w #NoCarry,ccr rts ends