CF        = -gCFLAGS    = -qxit=/r0 $(CF)LFLAGS    = $(CFLAGS)SYSLIB    = -l=/h0/LIB/sys.lCLIB      = -l=/h0/LIB/clib.lLFCRMAN_OBJS = cfileman.r lfcrman.rRDIR      = RELSODIR      = ../CMDSCC = ccLC = l68all: $(ODIR)/BOOTOBJS/lfcrman  \     $(ODIR)/BOOTOBJS/thlpct \     $(ODIR)/BOOTOBJS/h0t  @echo "LFCRMan driver and example descriptors made"$(ODIR)/BOOTOBJS/lfcrman: $(LFCRMAN_OBJS)  chd $(RDIR); $(LC) -O=../$@ $(LFCRMAN_OBJS) $(CLIB) $(SYSLIB) -g  attr $@ -elfcrman.r: lfcrman.c  cc -v=/h0/DEFS -qt=/r0 -r=$(RDIR) -s lfcrman.c$(ODIR)/BOOTOBJS/thlpct: $(RDIR)/thlpct.r  $(LC) $(RDIR)/thlpct.r -O=$@ $(SYSLIB)  attr $@ -e$(ODIR)/BOOTOBJS/h0t: $(RDIR)/h0t.r  $(LC) $(RDIR)/h0t.r -O=$@ $(SYSLIB)  attr $@ -e