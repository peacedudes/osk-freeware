# Makefile for shuffle V1.0 for OS-9LIBS =	-l=/dd/lib/curses.l -l=/dd/lib/termlib.l -l=/dd/lib/egetopt.r\		-l=/dd/lib/math.l CFLAGS = -qxm=24kRDIR =	RELSODIR =	/h0/cmds/dogHEADERS = 	shuffle.hSRC =	game.c main.c switch.c visual.c xrand.cOBJ = 	game.r main.r switch.r visual.r xrand.rshuffle: $(OBJ) $(HEADERS)	chd rels; cc -f=shuffle $(OBJ) $(CFLAGS) $(LIBS)debug: $(OBJ) $(HEADERS)	chd rels; cc -f=shuffle $(OBJ) $(CFLAGS) $(LIBS) -g$(OBJ) : $(HEADERS)shar:	@/bin/rm -rf ../shuffle.shar	shar -vc README FILES Makefile *.c *.h shuffle.man >-../shuffle.shar