********************************************************************************	This is the makefile for proff compilation under OS9********************************************************************************	Default directories*	DDIR =*	SDIR =*	RDIR =*	Compiler, assembler & linker flagsCFLAGS = -t=/r0 -dos9RFLAGS =LFLAGS = -t=/r0 -dos9 -m=100*	ObjectsObjects = proff.r proff01.r proff02.r lookup.r pinit.r putwrd.r\	pxlex.r pxxparse.r dostuff2.r eval.r stack.r map.rIncludes = lextab.h lextab.dproff: $(Objects)	cc $(LFLAGS) -fd=../cmds/proff $(Objects)$(Objects): $(Includes)$(Includes): proffsym.new ltb	ltb proffsym.new lextabltb: ltb.r look.r	cc $(LFLAGS) -fd=../cmds/ltb ltb.r look.r*	End of makefile