##	Makefile for cctrap system-state trap handler to get current#       cacr register setting##DEBUG = ODIR  = ../CMDS/OBJSLDIR  = ../LIBRDIR  = ../RELSall: $(ODIR)/cctrap $(LDIR)/cctraplib.l	echo "cctrap trap handler and library made."CCTRAP.OBJS = $(RDIR)/trapmain.r $(RDIR)/cctrap.r $(RDIR)/trapdefs.r$(ODIR)/cctrap: $(CCTRAP.OBJS)	l68 $(CCTRAP.OBJS) -l=/h0/LIB/sys.l -n=cctrap -M=2k -O=$@ $(DEBUG)	attr -epe -a $@$(RDIR)/trapmain.r: trapmain.a	r68 trapmain.a -o=$(RDIR)/trapmain.r -q$(RDIR)/cctrap.r: cctrap.a	r68 -qo=$(RDIR)/cctrap.r cctrap.a## The cctraplib.l library#LIB.OBJS = $(RDIR)/cctraplib.r $(RDIR)/trapdefs.r $(RDIR)/inittrap.r$(LDIR)/cctraplib.l: $(LIB.OBJS)	merge $(LIB.OBJS) >-$@$(RDIR)/cctraplib.r: cctraplib.a	r68 -qo=$(RDIR)/cctraplib.r cctraplib.a$(RDIR)/trapdefs.r: trapdefs.a	r68 -qo=$(RDIR)/trapdefs.r trapdefs.a$(RDIR)/inittrap.r: inittrap.a	r68 -qo=$(RDIR)/inittrap.r inittrap.a