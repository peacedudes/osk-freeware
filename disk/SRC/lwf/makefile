CC=gccCFLAGS = -O# Where to put lwfLWF = /dd/usr/cmds/lwf# Where to put the man pageMAN = /dd/usr/man/lwf.1# Where to put the PostScript prologue filePROLOGUE = /dd/usr/lib/lwf.prologue# Environment options:##-D PR= /dd/cmds/pr# -DSYSV			Indicates SysV (implies SysV-style pr)# -DUNISTD			Same as -DSYSV but also implies <unistd.h> is present#                   (which defines R_OK for the access() system call)# -DR_OK=X			Required for SysV without <unistd.h> and with R_OK #					not the default of 4# -DREVERSE=0		Set to non-zero if page reversal is to be the default#-DHOSTNAME=evtechENV = -DPROLOGUE="$(PROLOGUE)" -DREVERSE=0 -DHOSTNAME="evtech" -DPR="/dd/cmds/pr" -DOS9lwf: range.r lwf.r;	$(CC) lwf.r range.r -o /dd/usr/cmds/lwf -n lwf -l/dd/lib/math.l -l/dd/lib/os9lib.lrange.r: range.c;	$(CC) $(CFLAGS) -c range.clwf.r: lwf.c;	$(CC) $(CFLAGS) -c $(ENV) lwf.c