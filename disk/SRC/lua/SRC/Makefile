# makefile for lua distribution (main library)-oLUA= ..include $(LUA)/configIFILES = auxlib.i fallback.i func.i hash.i inout.i lex.i luamem.i\	     opcode.i parser.i table.i tree.i undump.i zio.iOBJS=	auxlib.r\	fallback.r\	func.r\	hash.r\	inout.r\	lex.r\	luamem.r\	opcode.r\	parser.r\	table.r\	tree.r\	undump.r\	zio.rSRCS=	auxlib.c\	auxlib.h\	fallback.c\	fallback.h\	func.c\	func.h\	hash.c\	hash.h\	inout.c\	inout.h\	lex.c\	lex.h\	luamem.c\	luamem.h\	opcode.c\	opcode.h\	parser.c\	parser.h\	table.c\	table.h\	tree.c\	tree.h\	types.h\	undump.c\	undump.h\	zio.c\	zio.h\	lua.stxSLIB= $(LIB)/lua.lILIB= $(LIB)/lua.ilall: $(SLIB)        @echo "LUA main library Ok!"opt: $(ILIB)        @echo "LUA main library Ok!"$(SLIB): $(OBJS)    chd $(RDIR); $(RANLIB) -o=../$(SLIB) $(OBJS)$(ILIB): $(IFILES)    chd $(IDIR); $(CC) -ilm $(IFILES) -eil -fd=../$(ILIB)parser:	yacc -d lua.stx	sed 's/yy/luaY_/g' y.tab.c >-parser.c	sed 's/yy/luaY_/g' y.tab.h >-parser.h	del y.tab.c y.tab.h