-o# makefile for lua distribution (compiler)LUA= ../..EXTRA_INCS = -v=..include $(LUA)/configIFILES= $(IDIR)/dump.i $(IDIR)/luac.i $(IDIR)/print.i $(IDIR)/luamod.iOBJS= $(RDIR)/dump.r $(RDIR)/luac.r $(RDIR)/print.r $(RDIR)/luamod.rSRCS= dump.c luac.c print.c luac.h print.h luamod.cT=$(BIN)/luacO=$(BIN)/luac.optall: $T        @echo "luac Ok!"opt: $O        @echo "luac Ok!"$T: $(OBJS)        $(CC) -fd=$@ $(OBJS) -l=$(LIB)/lua.l $(LFLAGS) -i$O: $(IFILES)        $(CC) -fd=$@ $(IFILES) $(LIB)/lua.il $(LOFLAGS) -i -j -oln=luac