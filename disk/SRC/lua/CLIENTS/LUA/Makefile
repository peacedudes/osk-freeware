-o# makefile for lua interpreterLUA= ../..EXTRA_INCS = -v=../$(LUA)/LDBinclude $(LUA)/configOBJS= $(RDIR)/lua.rIFILES = $(IDIR)/lua.i SRCS= lua.cT=$(BIN)/luaTO=$(BIN)/lua.optR=$(BIN)/runcall: $T        @echo "Lua Ok!"run: $R        @echo "shell add-on Ok!"opt: $(TO)        @echo "Lua opt Ok!"$(TO): $(IFILES)    $(CC) -fd=$@ $(IFILES)\        $(LIB)/lua.il\        $(LIB)/ldblib.il \        $(LIB)/lualib.il $(LIB)/osklib.il\        -ill=/h0/ucc/lib/sys_clib.il\        $(LOFLAGS) -i -j -oln=lua -b    $T: $(OBJS) $(LIB)/lua.l $(LIB)/lualib.l	$(CC) -fd=$@ $(OBJS) \        -w=/h0/ucc/lib/xcc\        -l=$(LIB)/lua.l\        -D=$(LIB)/ldblib.l\        -l=$(LIB)/lualib.l -l=$(LIB)/osklib.l\        -l=/h0/ucc/lib/sys_clib.l\        -l=$(LIB)/scanf.l\        $(LFLAGS) -ola -i    $R: $(RDIR)/runc.r	$(CC) -fd=$@ $(RDIR)/runc.r $(LFLAGS)