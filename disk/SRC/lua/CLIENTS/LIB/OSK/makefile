-o# makefile for lualibLUA= ../../..EXTRA_INCS = -v=. -DA_MODE include $(LUA)/configOBJS= $(RDIR)/fnmatch.r $(RDIR)/stat.r $(RDIR)/popen.r\      $(RDIR)/init.r $(RDIR)/misc.r $(RDIR)/module.r $(RDIR)/statlib.r\      $(RDIR)/getpass.rIFILES= $(IDIR)/fnmatch.i $(IDIR)/stat.i $(IDIR)/popen.i\      $(IDIR)/init.i $(IDIR)/misc.i $(IDIR)/module.i $(IDIR)/statlib.i\      $(IDIR)/getpass.iSRCS= popen.c fnmatch.c stat.c init.c misc.c module.c statlib.c getpass.cLSRCS= fnmatch.c statlib.c init.c misc.c module.cSLIB= $(LIB)/osklib.lILIB= $(LIB)/osklib.ilall: $(SLIB)        @echo "OSK Lib Ok!"opt: $(ILIB)        @echo "OSK Lib opt Ok!"head: osklib.h   @echo "Def file Ok!"osklib.h: $(SRCS)   cextract +A -P +p -I..../include -I/h0/ucc/defs -D_OSK -o osklib.h $(LSRCS)$(SLIB): $(OBJS)	libgen -c -o=$(SLIB) $(OBJS)$(ILIB): $(IFILES)    $(CC) -ilm $(IFILES) -eil -fd=$(ILIB)