-o# makefile for lualibLUA= ../..include $(LUA)/configOBJS= $(RDIR)/iolib.r $(RDIR)/mathlib.r $(RDIR)/strlib.r IFILES=$(IDIR)/iolib.i $(IDIR)/mathlib.i $(IDIR)/strlib.iSRCS= iolib.c mathlib.c strlib.cSLIB= $(LIB)/lualib.lILIB= $(LIB)/lualib.ilall: $(SLIB)        @echo "Lib Ok!"opt: $(ILIB)        @echo "Lib opt Ok!"$(SLIB): $(OBJS)	libgen -c -o=$(SLIB) $(OBJS)$(ILIB): $(IFILES)    $(CC) -ilm $(IFILES) -eil -fd=$(ILIB)