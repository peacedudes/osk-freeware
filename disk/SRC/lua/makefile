-b# makefile for lua hierarchyall:	chd src; make $@	chd src/luac; make $@	chd clients/lib; make $@	chd clients/lua; make $@opt:    chd src; make $@	chd src/luac; make $@	chd clients/lib; make $@	chd clients/lua; make $@rclean:	chd src; del RELS/*	chd src/luac; del RELS/*	chd clients/lib; del RELS/*	chd clients/lua; del RELS/*dclean:    -(chd bin; dir -u!grep -E "stb|dbg"!del -z)bclean:    chd bin; del lua luac runciclean:	chd src; del ICODE/*	chd src/luac; del ICODE/*	chd clients/lib; del ICODE/*	chd clients/lua; del ICODE/*    chd lib; del *.il