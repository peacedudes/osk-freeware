$ On Control_Y Then Goto The_Exit$ On Error Then Goto The_Exit$ cc  curses$ cc  hit$ cc  init$ cc  inventory$ cc  level$ cc  machdep$ cc  main$ cc  message$ cc  monster$ cc  move$ cc  object$ cc  pack$ cc  play$ cc  random$ cc  ring$ cc  room$ cc  save$ cc  score$ cc  spec_hit$ cc  throw$ cc  trap$ cc  use$ cc  zap$ cc  vmsterm$ open/write foo rtl.opt$ write foo "SYS$LIBRARY:VAXCRTLG/SHARE"$ close foo$ link /exe=rogue curses.obj,	hit.obj,	init.obj,-	inventory.obj,		level.obj,	machdep.obj,-	main.obj,		message.obj,	monster.obj,-	move.obj,		object.obj,	pack.obj,-	play.obj,		random.obj,	ring.obj,-	room.obj,		save.obj,	score.obj,-	spec_hit.obj,		throw.obj,	trap.obj,-	use.obj,		zap.obj,	vmsterm.obj, rtl.opt/opt$ rogue :== $'f$env("default")'rogue.exe$The_Exit:$ Save_Status = $STATUS$ exit Save_Status