##	VMS makefile for rogue#ROGUE_OBJS = curses.obj,	hit.obj,	init.obj,	\	inventory.obj,		level.obj,	machdep.obj,	\	main.obj,		message.obj,	monster.obj,	\	move.obj,		object.obj,	pack.obj,	\	play.obj,		random.obj,	ring.obj,	\	room.obj,		save.obj,	score.obj,	\	spec_hit.obj,		throw.obj,	trap.obj,	\	use.obj,		zap.obj,	vmsterm.objCC = ccCFLAGS = rogue: $(ROGUE_OBJS) rtl.opt	link /exe=rogue $(ROGUE_OBJS), rtl.opt/opt	rogue :== $'f$env("default")'rogue.exertl.opt:	open/write foo rtl.opt	write foo "SYS$LIBRARY:VAXCRTLG/SHARE"	close foo*.obj:	*.c rogue.h	$(CC) $(CFLAGS) $*allclean:	clean	msg = f$env("MESSAGE")	set mess /nofac/noid/nosev/notext	delete/nolog	rogue.exe;*	set mess 'msg'clean:	msg = f$env("MESSAGE")	set mess /nofac/noid/nosev/notext	purge/nolog	delete/nolog	*.lis;*	delete/nolog	*.obj;*	delete/nolog	rogue.scores;*	delete/nolog	rogue.save;*	delete/nolog	rtl.opt;*	set mess 'msg'