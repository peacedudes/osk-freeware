INCL    =COPTS   = -qigt=/r0CFLAGS  = $(COPTS) $(INCL)CC  = ccLOADLIBES = -l=/dd/lib/os9lib.lRDIR=relsPREFIX  = /r0BINDIR  = $(PREFIX)ALL = m4HDRS    = m4.hSRCS    = m4.c input.c output.c symtab.c builtin.c macro.c eval.c oskvprintf.cOBJS    = m4.r input.r output.r symtab.r builtin.r macro.r eval.r oskvprintf.rMISC    = Makefile README PLANSLIBHDRS = obstack.h version.hLIBSRCS = obstack.c # vfprintf.cLIBOBJS = obstack.r # vfprintf.rLIBMISC = COPYINGALLHDRS = $(HDRS) $(LIBHDRS)ALLSRCS = $(SRCS) $(LIBSRCS)ALLOBJS = $(OBJS) $(LIBOBJS)ALLMISC = $(MISC) $(LIBMISC)DIST    = $(ALLMISC) $(ALLSRCS) $(ALLHDRS) vfprintf.c newvers.sh m4.texinfo m4.dvi examples test$(ALL): $(ALLOBJS)    chd $(RDIR);$(CC) -fd=../$@ $(CFLAGS) $(ALLOBJS) $(LOADLIBES)version.h: always    ./newvers.sh m4.cclean:    del $(ALL) $(RDIR)/*.r *.baktest:     zsh dotest.zsh# If anybody wants these scripts, write to me (seindal@diku.dk)examples: always    rm -f examples/*    ./get_examples.sh m4.texinfocheck:  examples    ./check_examples.sh examples/*input.r : input.c m4.h obstack.h     $(CC) $(CFLAGS) -Disp=ibsp $*.c -r=$(RDIR)# DO NOT DELETE THIS LINEm4.r : m4.c m4.h obstack.h version.houtput.r : output.c m4.h obstack.hsymtab.r : symtab.c m4.h obstack.hbuiltin.r : builtin.c m4.h obstack.hmacro.r : macro.c m4.h obstack.heval.r : eval.c m4.h obstack.hobstack.r : obstack.c obstack.h# DEPENDENCIES MUST END AT END OF FILE# IF YOU PUT STUFF HERE IT WILL GO AWAY# see make depend above