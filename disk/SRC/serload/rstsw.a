	nam	rxmod state switcher	ttl	state switcher	use	/dd/defs/defsfile	use	marker.m*************** state's handling for receiving a module from another*	machine****** edt  date* --- -------- --------------------------*  0  17-se-90 initial version*  1  10-oct-90 send recno=0 if waiting for "0,T"*  2  15-oct-90 debug aid "marker" included (optional assy)*		return sys mem if failure*  3  21-oct-90 common trap handler needs a5 to exit routineEdition	equ	3	psect	rstsw,0,0,0,0,0RX	set	1	for rt_comm, pack, unpack* macro spack(recno,len,type)*	recno is byte*	len: if "S" or "D"-type: rest of bytes totally to do;*					updated to new rest*	     else              : no of chars to pack*	type: character*	buffer is for "S" or "D" specified in a1 -- not in macro*		  else string must be placed before call to errbuff++spack	macro	ifne	\#-3	FAIL	spack needs 3 arguments	endc	move.b	\1,d0	recno	move.l	\2,d6	len - if bin: rest to do if not, word used	move.b	\3,d2	type	bsr	txpack	endm* macro rpack (maxbytes.l in d0, dest buff in a1 for "S" & "D")*	maxbytes: max user bytes to readrpack	macro	bsr	rxpack	endm* macro to increment recno : new = mod(old+1,$40)increcn	macro	addq.b	#1,\1	andi.b	#$3f,\1	endm	*--------------------------------------------------------- state switcher ---* state switcher* --------------* the state switcher controls advances from state to state* initial state is "O" for Open* O: get input, display if not "T" or do "Y" after timeout* S: get module size - get sys mem for module*     if ok then "D" else "Error" and Exit* D: get data up to module size*     if ok goto "Final"*     if not ok then "Error" and Exit* F: make module known, ack for next "O" or "B"* Break: close connection** E Error msg recived : show msg & exit* A Error state detecetd (timeout, device read etc: send "E" & exit*statswitch:	bsr	flush		empty garbage	bsr	ropen		executed only one timestsw$lp:	move.b	d0,state(a6)	for debugging	move.b	state(a6),d0stsw$10	cmp.b	#'S',d0		try get size	bne	stsw$20	bsr	rsize	bra	stsw$lpstsw$20	cmp.b	#'D',d0		try get data	bne	stsw$30	bsr	rdata	bra	stsw$lpstsw$30	cmp.b	#'E',d0		err packet received	bne	stsw$40	bsr	tprerr		print err	bra	stsw$exstsw$40	cmp.b	#'A',d0		send err packet	bne	stsw$50	bsr	terrp	move.l	Memsiz(a6),d0	mem allocated?	beq.s	stsw$ex		no	movea.l	TrapEx(a6),a5	set trap exit routine ptr	movea.l	Memptr(a6),a2	add of it	tcall	VmodTr,-1	return it	bra	stsw$exstsw$50	cmp.b	#'B',d0		break connection	beq	stsw$ex		ok, readystsw$60	cmp.b	#'F',d0		make module known?	bne	stsw$70	bsr	rfinal	bra	stsw$lpstsw$70	move.b	#'?',d0		undefined statestsw$ex:	move	errno(a6),d1	<>0 if OS9 err	rts*----------------------------------------------------- end state switcher ---*----------------------------------------------------- ropen ----------------* ropen -- open file & check for connection*	only for first entry !*	if fnptr <>0: send "TXMod module(s)"; clr fnptr*		- rem: for later: first start TXMod, then*		       send a "Module"-package*	get input within time*	if timeout: send "Y for recno 1"*	if input:*	   if "T": return "S" else show it if "line" definded -*				may be error msg from host*	if errcount exceeded: return "A"**	if error "A" and a2 with ptr to reasonropen:	bsr	txmodls		send modules if any, reset fnptr	bcs.s	rop$ex		return err & "A"** wait for "T". If not, try with "0Y"*		clr.b	recno(a6)	this is the first expected recno	bsr	inipdfltrop$lp:	clr.l	d0		set no bin input expected	bsr	tstans		get input	cmp.b	#'E',d0		err msg in?	beq.s	rop$ex		y	cmp.b	#'B',d0		break line ?	beq.s	rop$ex		ok, done	cmp.b	#'T',d0		start xmiss.?	beq.s	rop$ok		y	cmp.b	#-1,d0		was timeout?	beq.s	rop$tx		y, send "Y" & try again	cmp.b	#-2,d0		was bad cks?	bne.s	rop$tx		no, anything	bsr	shwinp		y, assume msg from host* send a "Y" msg if numtry not outrop$tx	subq	#1,numtry(a6)	bmi.s	rop$ab		abort w. last err	spack	#0,#0,#"'Y'"	bra.s	rop$lprop$ok	increcn	recno(a6)	set next expected	move.b	#'S',d0		set to "S"	rop$ex	rtsrop$ab	move.b	#'A',d0		set aborted 	rts			with a2 to reason*----------------------------------------------------- end ropen ------------*----------------------------------------------------- rsize ----------------* rsize -- get size, then get mem & send "Y" if ok**		"E" if err packet else "A" with errmsgrsize:	move.b	#1,recno(a6)	size record is always recno 1	bsr	inipdflt	set numtry & default errrsz$lp:	subq	#1,numtry(a6)	bmi.s	rsz$ab			all tries done	spack	recno(a6),#0,#"'Y'"	moveq.l	#3,d0			3 bytes to get	clr.b	ModSiz(a6)			lea	ModSiz+1(a6),a1		... to module size	bsr	tstans			test answer from RX	cmp.b	#'E',d0	beq.s	rsz$ex		err msg - handle imm.	cmp.b	#'S',d0		size package?	bne.s	rsz$lp		no, repeat	increcn	recno(a6)	ok, set to next	bsr	getmem		try install mem	bne.s	rsz$ab		not poss - abort	move.b	#'D',d0		ok, goto Datarsz$ex:	rtsrsz$ab:	move.b	#'A',d0		a2 to reason string	rts*----------------------------------------------------- end rsize ------------*----------------------------------------------------- rdata ----------------* rdata -- get data*rdata:	move.l	Memptr(a6),a1	move.l	ModSiz(a6),d6rdt$gd:	move.l	d6,restln(a6)	move.l	a1,Curptr(a6)	bsr	inipdflt	set numtry & default errrdt$lp:	subq	#1,numtry(a6)	bmi	rdt$ab	spack	recno(a6),#0,#"'Y'"	move.l	Curptr(a6),a1		move.l	restln(a6),d0	all more than read except last package	bsr	tstans	cmp.b	#'E',d0	beq	rdt$ex	cmp.b	#'D',d0		was ACK	bne	rdt$lp	increcn	recno(a6)	move.l	restln(a6),d6	sub.l	d2,d6		make new rest	bhi	rdt$gd		do next* complete - return "F"	move.b	#'F',d0rdt$ex:	rtsrdt$ab:	move.b	#'A',d0	rts*----------------------------------------------------- end rdata ------------*----------------------------------------------------- rfinal ---------------* rfinal -- make module known & send ok if sucessful**	make module known*	if ok, ack for next package*	get it & return "S" for next module or "B" for breakrfinal:	bsr	rlink		try link module or return sys mem	bne.s	rfi$ab		with a2 to err msg 	bsr	inipdfltrfi$lp:	subq	#1,numtry(a6)	bmi.s	rfi$ab	spack	recno(a6),#0,#"'Y'"	clr.l	d0	bsr	tstans	cmp.b	#'E',d0	beq	rfi$ex	cmp.b	#'B',d0	beq	rfi$ex	cmp.b	#'T',d0	bne	rfi$lp	move.b	#'S',d0rfi$ex:	rtsrfi$ab	move.b	#'A',d0	rts*----------------------------------------------------- end rfinal -----------*--test answer for ok or errors ---* testans* returns -1 timeouted, -2 cks err, A bad record or*	received record typetstans:	rpack	tst.b	d0		timeout or cks?	bmi	taw$ex	cmp.b	#'E',d0		err msg in?	beq	taw$ex		y, don't test recno	cmp.b	#'T',d0		is "T" ?	bne	taw$10		no	tst.b	d1		recno=0 ?	beq	taw$ex		ok - T always 0	bra	taw$br* test for valid package number received -1 is oktaw$10	cmp.b	recno(a6),d1	expected recno	beq	taw$ex		ytaw$br	move.b	#'A',d0	lea	m$badrec(pcr),a2taw$ex:	rtsm$badrec:	dc.b	"bad recno ",0*----------------------------------*--------------shwinp:	tst	line(a6)	defined?	beq	shwiex		no, don'T echo to host	movem.l	d0-d1/a0,-(a7)	lea	inbuff(a6),a0	move	#StdErr,d0	move.l	#120,d1	OS9	I$WritLn	movem.l	(a7)+,d0-d1/a0shwiex	rts*----------------*-------------* send TXMOD module(s) if fnptr <>0. Return CC for oktxmodls:	tst.l	fnptr(a6)		anything to send?	beq	txm$ex			no, cc clr	lea	outbuff(a6),a1	move.l	a1,a0			for I$WritLn	clr	d1			byte count	lea	txname(pcr),a2	bsr	concat	move.l	fnptr(a6),a2	bsr	concat	move.b	#C$CR,-1(a1)		move	line(a6),d0	move	#100,d1	OS9	I$WritLn	bcc	txm$ex	move	d1,errno(a6)		set err exit cond.	lea	m$mdwrit(pcr),a2	& ret with CS	txm$ex:	rtstxname	dc.b	"TXMod",0m$mdwrit dc.b	"Err when writing >TXMod modlist<",0	align*-------------* --- get System Mem for the module -----------------------------------getmem:	clr.l	Memsiz(a6)		preset for fail cond	clr.l	Memptr(a6)	move.l	ModSiz(a6),d0	movea.l	TrapEx(a6),a5		set trap exit routine ptr	tcall	VmodTr,0		alloc sys mem in sys state	bcc	gtm$10			ok	move	d1,errno(a6)	lea	m$allocerr(pcr),a2	move.b	#'A',d0	rtsgtm$10	move.l	a2,Memptr(a6)		add of mem ...	move.l	d0,Memsiz(a6)		... & size	cmp.l	ModSiz(a6),d0		enough mem granted?	bhs	gtm$ex			y		lea	m$nomem(pcr),a2	move.b	#'A',d0	rts		gtm$ex	clr	d1	rtsm$allocerr	dc.b	"Mem alloc err",0m$nomem	dc.b	"not enough mem",0	align* --------------------------- end getmem----------------------------------* --- make Module known to system ----------------------------------------rlink:	movea.l	TrapEx(a6),a5		move.l	Memptr(a6),a0	move.l	M$Owner(a0),d0	set owner	clr.w	d0		only hold group	move.l	M$Size(a0),d1	set size	tcall	VmodTr,1	call F$Vmodul	bcc.s	rli$ex	lea	m$moddir(pcr),a2	move	d1,errno(a6)	& clr ZERO	rtsrli$ex	bsr	showmod		show linked module	clr.l	Memsiz(a6)	set sys mem in use - don't release	rts			& ZEROm$moddir:	dc.b	"Can't insert in ModDir",0	align*------------------------------------------------- end rlink ------------*------------------------------------------------- showmod --------------* show modules name & location if line <> 0showmod:	tst	line(a6)	beq	shwm$ex	movem.l	d0-d3/a0-a2,-(a7)	lea	outbuff(a6),a1		start of data in outbuff	move	#$D0A,(a1)+		(outbuff always word aligned)	move.b	#C$LF,(a1)+	moveq.l	#3,d1		byte count	lea	m$modms(pcr),a2	bsr	concat	movea.l	Memptr(a6),a2	adda.l	M$Name(a2),a2		show name of module	bsr	concat	lea	m$from(pcr),a2	bsr	concat	move.l	Memptr(a6),d2		show start add	bsr.s	makehex	lea	m$to(pcr),a2	bsr	concat	movea.l	Memptr(a6),a2	move.l	a2,d2	add.l	M$Size(a2),d2	bsr	makehex			show end add	move.b	#C$CR,(a1)+	move.b	#C$LF,(a1)+	move.b	#C$LF,(a1)+	addq.l	#3,d1	move	#StdOut,d0	lea	outbuff(a6),a0	OS9	I$Write		movem.l	(a7)+,d0-d3/a0-a2shwm$ex	rtsmakehex	moveq	#7,d3makehx1	rol.l	#4,d2	move.b	d2,d0	andi.b	#$F,d0	cmp.b	#9,d0	bls	makehx2	addq.b	#7,d0makehx2	addi.b	#'0',d0	move.b	d0,(a1)+	addq.l	#1,d1	dbra	d3,makehx1	rtsm$modms	dc.b	"Module ",'"',0m$from	dc.b	'"'," linked at $",0m$to	dc.b	" to $",0	align*------------------------------------------------- end showmod ----------	use	../rt_comm/rt_comm.a	use	../rt_comm/pack.a	use	../rt_comm/unpack.a	ends