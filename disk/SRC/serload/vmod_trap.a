	nam	vmod_trap	ttl	do a privileged "include in Module Dir" call	use	/dd/defs/defsfile	use	marker.m**************************************** Function:* this handler enables user insert a user loaded*   module in the module directory by F$Vmodul* to keep system memory allocated after termination of*   calling program, F$SrqMem is done here* it must run in supervisory mode** function codes:*       0 allocate system memory*      >0 do F$Vmodul*       <0 dealloc sys mem*----------------------------------------------------------------------* OS9 Versions under V2.3 in Supervisory mode have to return*	 with RTE and put condition codes on stack before RTE* V2.3 works in SuperVis Mode as in Technical Manual.* The different behaviour is handled by passing version at Trap*	initialisation and returning a pointer to appropriate*	return** F$VModul sometimes destroyes the User Stack Pointer. This problem* 	is solved by saving and restoring it before/after F$VModul call	page* 1 10-oct-90: usable only with v2.3 - V2.1 needs*		rte at end of trapinit and trap* 2 11-oct-90: d1.l module size for F$VModul * 3 15-oct-90: dealloc sys mem function included, marker is conditional*		assembly if "dbg" defined*		common for V2.1 / V2.3  -- if latter, define OS9V2.3 !* 4 21-oct-90: commom module for V2.1/V2.3Edition set	4Revisn	set	0Type	set	(TrapLib<<8)+ObjctRevs	set	(ReEnt+SupStat)<<8+Revisn	psect	traphand,Type,Revs,Edition,0,trapent	dc.l	TrapInit	dc.l	TrapTerm********************************** Trap initialisation** entry: d2 OS9 version: 0: under V2.3*        a5 where to store pointer to rts/rte* exit:  a5 to rts/rte routineTrapInit	tst	d2	V2.3 ?	beq.s	ti$10	no	lea	V2.3Ex(pcr),a5	bra	TrapExti$10	lea	V2.1Ex(pcr),a5	bra	TrapEx	page********************************** trap handling routine*** function code 0 - alloc system mem*   entry:* 	d0.l	requested mem size in bytes*	a5.l	ptr to rts/rte routine*   exit:*	d0.l	size of mem granted (rounded to alloc size)*	a2	ptr to mem*       d1,cc   error cond  (E$MemFul, E$NoRAM)** function code >0 - make Module known*   entry:* 	d0.l	Module group ID*	d1.l	Module size (see update notes pg. 3.5)*	a0	Add of module*	a5.l	ptr to rts/rte routine*   exit:*	a2	ptr to ModDir where module entered*       d1,cc   error cond  (E$KwnMod,E$DirFul,E$BMCRC,E$BMHP ?)*		(system mem is returned if error)* function code <0 - dealloc system mem*   entry:*	d0.l	mem to return*	a2	add of mem *	a5.l	ptr to rts/rte routine** module directory offsets (OS9 v2.1, V2.3 , other's ??)md$addr	set	0	where module is locatedmd$mem	set	4	sys mem to return if unlinked - if 0 never unlinkedmd$size	set	8	mem allocation size (module size rounded up)md$link	set	12	link count (word)md$attr	set	14	something like module type/lang etc (word)	org	0S.a6	do.l	1S.func	do.w	1trapent:	tst	S.func(a7)	bne.s	t$10* get system memory	OS9	F$SRqMem		returns mem in a2		bra	TrapExt$10	bmi	t$30* make module known	move.l	a4,-(a7)	save	move	USP,a4		save user stack ptr	OS9	F$VModul	move	a4,USP		restore USP	movea.l	(a7)+,a4	restore a4	bcs.s	TrapEx		error - remove it	move.l	a0,md$mem(a2)	make removable module	move.w	#1,md$link(a2)	set link count = 1	bra.s	TrapEx		with carry clear* return memt$30	OS9	F$SRtMem	return it*** do exit ***TrapEx	movem.l	(a7)+,a6-a7	jmp	(a5)		do approp. exitV2.3Ex	rtsV2.1Ex	bcc.s	t$exok	ori.w	#Carry,(a7)t$exok	rte**************************** TrapTerm - never called - force errTrapTerm	move.w	#1<<8+199,d1	os9	F$Exit		crash program	ends