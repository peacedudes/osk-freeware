*-----------------------------------* topenf - test open file for next module or*   try open a file containing module**	entry: file open (InPath <>0) or*		fnptr(a6) to next filename or blanks to*		skip*	*	exit ok:*		InPath closed if it was EOF*		fnptr(a6) after filename*		carry clear; notzero*		InPath path number*		ModSiz len of module as in Header*	exit no more:*		carry clear, zero*	exit error:*		carry set; a2 ptr to err message*		errno has OS9 err no if any* ----*  1  20-sep-90 initialtopenf:	move	InPath(a6),d0	beq	tfno$0		test for next module* file is open - test for EOF	move	#SS_EOF,d1	OS9	I$GetStt	test for eof	bcc	tfo$08		not eof* EOF - close file	OS9	I$Close		eof - close file	clr	InPath(a6)	set ZERO & no file open* no file open - get next of argumentstfno$0	move.l	fnptr(a6),a0		get next filetfilnm	move.b	(a0)+,d0	beq	filsdone	cmp.b	#' ',d0		skip blanks	beq	tfilnm	lea	-1(a0),a0********************************* load module to link ********************************** --- open the file ---	move	accmod(a6),d0	OS9	I$Open	bcc	tfo$05	lea	m$opnerr(pcr),a2	bra	tfo$erm$opnerr:	dc.b	"can't open file",0tfo$05	move	d0,InPath(a6)	save path number	move.l	a0,fnptr(a6)	to next if any* --- read first part of module to determine Module size ---tfo$08	move.l	#inbfsiz,d1	set initial size	bsr	rdbin	bcs	tfo$er* --- is it a Module ? -------------* tested byte by byte to prevent from*	generating a sync byte heretfo$10:	cmpi.b	#$4a,binbuff(a6)	bne	tfo$nomod	cmpi.b	#$FC,binbuff+1(a6)	beq	tfo$20tfo$nomod:	clr	d1	lea	m$nomod(pcr),a2	bra	tfo$erm$nomod:        dc.b    "no sync byte - no Module",0* --- get Size of module -----------------------------------tfo$20	move.l	binbuff+M$Size(a6),ModSiz(a6)* exit ok	move.b	#1,d1	set nonzero, clr carry* --- exit all done* carry clear, zero setfilsdone:	rts* --- exit on error*tfo$er:	move	d1,errno(a6)	ori.b	#Carry,ccr	rts*-------------------------------------------- rdbin -------------------* rdbin - read binary data from InPath to binbuff* entry: d1.l no of bytes to read* exit:	case ok: carry clr, d1.l number of bytes read*	case error:*		carry set*		d1: error number (OS9)*		a2: to error msgrdbin:	lea	binbuff(a6),a0	buffer	move	InPath(a6),d0	path	OS9	I$Read	bcc	rdb$ex	lea	m$reader(pcr),a2	move	d1,errno(a6)	ori.b	#Carry,ccrrdb$ex:	rtsm$reader:	dc.b	"Error when reading file",0*-------------------------------------------- rdbin end ---------------*-------------------------------------------- getdata-------------------* get data from input file to binbuff - max inbufsiz bytes* entry:*	d6 rest of module size to do - must be non zero* exit:*	case more data: noCarry noZero*			d1.l =bytes read*	case read error:*			see rdbin getdata:	move.l	d6,d1	all done	cmp.l	#inbfsiz,d1 rest > bufsiz	bls.s	gdt$d0	no	move.l	#inbfsiz,d1 set max	gdt$d0	bsr	rdbin	get more	bcs	gdt$d1	with errno and a2 set*  case more data: noCarry noZero	tst.l	d1		clr carry, set non zerogdt$d1	rts*-------------------------------------------- getdata end----------------