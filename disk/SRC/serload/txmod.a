	nam	TxMod Test	ttl	load a module and make it known to sys	use	/dd/defs/defsfile**************************************** Function:*  Send an OS9 module to be load by other system* see usage for help	page****** edt  date* --- -------- --------------------------*  0  07-sep-90 initial version*  1  18-sep-90 total ueberarbeitet*  2  22-oct-90 opt. "r" includedEdition	equ	1Revisn	equ	2Type	set	(Prgrm<<8)+ObjctRevs	set	(ReEnt<<8)+Revisnstacksz	set	200	psect	TxMod,Type,Revs,Edition,stacksz,TxModentUsage:	dc.b	"TXMod Ed.",'0'+Edition," Rv.",'0'+Revisn	dc.b	" - send Module via SCF to RXMod to link there",C$CR,C$LF	dc.b	"Syntax: TXMod [<opts>] module(s) [<opts>]",C$CR,C$LF	dc.b	"Options:",C$CR,C$LF	dc.b	"  -x       :  all modules in EXE dir",C$CR,C$LF	dc.b	"  -l[=]<dev> : use dev for xmission",C$CR,C$LF	dc.b	"              else StdIn/StdOut/StdErr",C$LF,C$CR	dc.b	"  -r       :  send RXMOD to other, show 2 sec "	dc.b	"responses",C$CR,C$LFusaglen	equ	*-Usage	alignStdIn:	equ	0	std pathesStdOut:	equ	1StdErr:	equ	2	std err msgTX	equ	1	define for pack/unpack cond. assembly* ------------------------------------------	vsectModSiz: ds.l	1	module sizerestln:	ds.l	1	- rest of module to sendfnptr:	ds.l	1	- pointer to curr file nameInPath:	ds.w	1	module read pathaccmod: ds.w	1	read or execute access modenumtry:	ds.w	1	- number of tries in error caseerrno:	ds.w	1	- OS9 error numberline:	ds.w	1	- path number of line or 0prgmes:	ds.w	1	- print progress msg if 0s_set:	ds.b	1	- flag options are sets_DTP:	ds.b	1	- saved device classs_EKO:	ds.b	1	- saved entry ECHO state of lines_ALF	ds.b	1	- saved entry AutoLF staterecno:	ds.b	1	- record to send or expectedstate:	ds.b	1	current stateo_rxm	ds.b	1	option "send 'RXMOD <CR>'" set* following buff size definition depends on max bytes which may*  be xferd in one buffermaxpackl: equ 127-' '	max len which can be expressed in len field of recrdmaxdatab: equ maxpackl-3 bytes used by recno, len, typemaxbind:  equ (maxdatab/4)*3  3 bytes packed in 4 charsbinbuff: ds.l 1		align long for easier m$size handling	ds.b maxbind-4inbfsiz: equ maxbind	outbuff: ds.w	1	- buffer with responses          ) same buff	ds.b	1	- ... this is the header part    )inbuff:	equ	outbuff	- same                           )errbuff: ds.b	maxpackl+2-3	- buffer to send err msgs        )	ds.b	128-(maxpackl+2) 128 needed for getstat/setstat	ds.b	10	ends**********************************TxModent:	bsr	tparsopt	test for options & errs	bne	SLExit		error - d1 has code	bsr	rxinit		send "rxmod" if req	bsr	statswitch	do itSLExit	bsr	ClosLine	OS9	F$Exit		with error code*---------------------------------*-------------------------------------------rxinit --------------------* init rxmod on other system if o_rxm set*	sends "RXMOD <CR>*	echos for 2 seconds responses from other systemrxinit:	tst.b	o_rxm(a6)	beq.s	rxi$ex	move	line(a6),d0	beq.s	rxi$ex		makes no sense if no line* send command	lea	m$rxcmd(pc),a0	move.l	#l$rxcmd,d1	OS9	I$WritLn*	bcs	??rxi$lp	movem.l	d0/d2,-(a7)	move	#2,d2		set timeout time 2 seconds	lea	inbuff(a6),a0	move.l	#maxpackl+3,d1	move	line(a6),d0	if undefined, it's 0=StdIn	bsr	rdlin_tim	movem.l	(a7)+,d0/d2	bcs.s	rxi$ex		timeoted (hope no other err)* echo input	move	#StdOut,d0	OS9	I$Write	bra.s	rxi$lprxi$ex	rtsm$rxcmd	dc.b	"RXMOD",C$CRl$rxcmd	equ	*-m$rxcmd	align*-------------------------------------------rxinit end ----------------	use	tparsopt.a	use	../rt_comm/Setopt.a	ends	