	nam	tparsopt.a	ttl	tx options parser*-----------------------------------------------tx parse opts ---* txmod option parser*	entry: a5 to start of params*	exit ok: (zero)*		a1 to start of 1. possible path name*		line set & open if defined*		all params removed*	exit err: (non zero)*		errno OS9 err number or 0*		a2 to bad param or text*tparsopt:*   --- find ending CR and replace by Null ---	move.l	a5,a1		save param start	clr	errno(a6)par$prp	move.b	(a5)+,d0	beq	par$prx	cmp.b	#C$CR,d0	bne	par$prp	clr.b	-1(a5)		set 0 at endpar$prx*   --- find -x, -l, undefined options and start of 1. name	move	#Read_,accmod(a6) preset	clr.b	o_rxm(a6)	preset no "RXMOD" cmd	move.l	a1,a5	movea	#0,a1		will get ptr to first filetpar$lp:	move.l	a5,a2		save poss start of bad param	move.b	(a5)+,d0	beq	tpar$ex	cmp.b	#'-',d0	beq	tpar$10		no file name*     case file name	cmp.l	#0,a1		ptr set?	bne	tpar$05		y	lea	-1(a5),a1	set ptrtpar$05	move.b	(a5)+,d0	beq	tpar$ex		all done	cmp.b	#C$Spac,d0	terminator	bne	tpar$05	bra	tpar$lp		continue**    case poss. optiontpar$10:	move.b	(a5)+,d0	get param	beq	tpar$il		illtpar$1a	or.b	#$20,d0		make nonCAP	cmp.b	#'x',d0	bne	tpar$11		no -x* case -x	ori	#Exec_,accmod(a6)	bra	tpar$12		clr & continuetpar$11	cmp.b	#'r',d0	bne	tpar$20* case -r	move.b	d0,o_rxm(a6)	set nonzerotpar$12	move.b	#C$Spac,-2(a5)	to "-"	move.b	#C$Spac,-1(a5)	to "x"	move.b	(a5)+,d0	get next char	beq	tpar$ex		all done	cmp.b	#C$Spac,d0	beq	tpar$lp		continue	bra	tpar$1a		cont in opt mode*    test for -ltpar$20	cmp.b	#'l',d0	bne	tpar$il		no, ill	tst	line(a6)	defined?	bne	tpar$il		y, don't do it twice	lea	-2(a5),a2	set start of -l to blank ittpar$21	move.b	(a5)+,d0	beq.s	tpar$il		no line defined	cmp.b	#C$Spac,d0	beq.s	tpar$il			cmp.b	#'=',d0	beq.s	tpar$21		'=' found, find poss. device name start	*   try open path	lea	-1(a5),a0	move.b	#Updat_,d0	OS9	I$Open	bcc	tpar$25		ok	move	d1,errno(a6)	bra	tpar$iltpar$25	move	d0,line(a6)	save line	move.l	a0,a5		set behind dev name* blank line opt	move.b	#C$Spac,d0tpar$27	move.b	d0,(a2)+	cmp.l	a2,a5	bhi	tpar$27	move.b	(a5)+,d0	bne	tpar$lp		continue	bra	tpar$ex*  --- ill param ---*	make mess to StdErr as Err Package - user may be*		RXMod*	a2 to bad param, errno OS9 err numbertpar$il:	move.l	a2,a0	bsr	terrp		send Error package	move	#StdErr,d0	move.l	#usaglen,d1	lea	Usage(pcr),a0	OS9	I$Write		to make many lines	move	errno(a6),d1	& OS9 err if any	move	#-1,d0		return error	rts*tpar$ex:	bsr	SetOpt	bcc.s	tpar$e1	lea	m$opterr(pcr),a2	move	d1,errno(a6)	bra.s	tpar$il*	test for file definedtpar$e1	cmp.l	#0,a1	bne	tpar$xx		ok	lea	m$nofil(pcr),a2	bra	tpar$iltpar$xx	move.l	a1,fnptr(a6)	save 1. filename start	clr	d0	rts			zero if okm$nofil	dc.b	"no filename given !",0m$opterr dc.b	"cannot set line options !",0	align*----------------------------------------------------------------