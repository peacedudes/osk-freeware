	nam	txmod state switcher	ttl	state switcher	use	/dd/defs/defsfile*************** state's handling for sending a module to another*	machine****** edt  date* --- -------- --------------------------*  0  17-se-90 initial version*  1  28-sep-90 unpack included*  2  20-oct-90 test file for containing more than one moduleEdition	equ	2	psect	tstsw,0,0,0,0,0TX	set	1	for cond. assembly* macro spack(recno,len,type)*	recno is byte*	len: if "S" or "D"-type: rest of bytes totally to do;*					updated to new rest*	     else              : no of chars to pack*	type: character*	buffer is for "S" or "D" specified in a1 -- not in macro*		  else string must be placed before call to errbuff++spack	macro	move.b	\1,d0	recno	move.l	\2,d6	len - if bin: rest to do if not, word used	move.b	\3,d2	type	bsr	txpack	endmrpack	macro	bsr	rxpack	endm*--------------------------------------------------------- state switcher ---* state switcher* --------------* the state switcher controls advances from state to state* initial state is "O" for Open* if "Open" ok then "S" else "Error" and exit* S: send module size - get RX's ok msg*     if ok then "D" else "Error" and Exit* D: send data and get RX's ok or com to ready*     if ok send next D or goto "Open"*     if not ok then "Error" and Exit* Break: close connection** E Error msg recived : show msg & exit* A Error state detecetd (timeout, device read etc: send "E" & exit*statswitch:	bsr	flush		empty line	move.b	#'O',d0		init for open	clr.b	recno(a6)	init recno 0	clr	InPath(a6)	set no file openstsw$lp:	move.b	d0,state(a6)	for debugging	move.b	state(a6),d0	cmp.b	#'O',d0		in open?	bne	stsw$10	bsr	topen		try get connection	bra	stsw$lpstsw$10	cmp.b	#'S',d0		try send size	bne	stsw$20	bsr	tsize	bra	stsw$lpstsw$20	cmp.b	#'D',d0		try send data	bne	stsw$30	bsr	tdata	bra	stsw$lpstsw$30	cmp.b	#'E',d0		err packet received	bne	stsw$40	bsr	tprerr		print err	bra	stsw$exstsw$40	cmp.b	#'A',d0		send err packet	bne	stsw$50	bsr	terrp	bra	stsw$exstsw$50	cmp.b	#'B',d0		break connection	bne	stsw$60	bsr	tbreak	bra	stsw$exstsw$60	move.b	#'?',d0		undefined statestsw$ex:	move	errno(a6),d1	<>0 if OS9 err	rts*----------------------------------------------------- end state switcher ---*----------------------------------------------------- topen ----------------* topen -- open file & check for connection**	if open file: test for other module.*	else get filename & test for opt "-x"*	if none: return "B" - break, all done*	if any: test file for present and module*		if neither, set errmsg & return "A" for abort*	try to get connection to RX*	if sucessfull: return "S" else errmsg & "A"*	if error "A" and a2 with ptr to reasontopen:	bsr	topenf	bcs	top$ab	error at open	bne	top$05	move.b	#'B',d0	no more to do	rts** more to to - test RX ready*top$05	clr.b	recno(a6)	bsr	inipdflttop$lp:	subi	#1,numtry(a6)	bmi	top$ab		abort w. last err	spack	recno(a6),#0,#"'T'"	bsr	tstans	cmp.b	#'E',d0		err msg in?	beq	top$ex		y	cmp.b	#'Y',d0		ok?	bne	top$lp	move.b	#'S',d0		set next state Sizetop$ex:	rtstop$ab:	move.b	#'A',d0		set aborted 	rts			with a2 to reason*----------------------------------------------------- end topen ------------*----------------------------------------------------- tsize ----------------* tsize -- send size & wait for RX's ok**	send "S"ize packet*	get RX's ACK and return "D" or return*		"E" if err packet else "A" with errmsgtsize:	bsr	inipdflt	set numtry & default errtsz$lp:	subi	#1,numtry(a6)	bmi	tsz$ex			all tries done	lea	binbuff+M$Size+1(a6),a4	here is size	spack	recno(a6),#3,#"'S'"		build & send package	bsr	tstans			test answer from RX	cmp.b	#'E',d0	beq	tsz$ex		err msg - handle imm.	cmp.b	#'Y',d0		ACK?	bne	tsz$lp		no, repeat	move.b	#'D',d0		ok, goto Datatsz$ex:	rts*----------------------------------------------------- end tsize ------------*----------------------------------------------------- tdata ----------------* tdata -- send data & wait for RX's ok**	send data packages till end of file*	return "O" for complete or "E" for RX errmsg *		or "A"**  at first entry, binbuff has first part of module data !tdata:	move.l	ModSiz(a6),restln(a6)	save rest for repeat on err	bra	tdt$g5		at 1. entry data are intdt$gd	bsr	getdata		gets rest or max inbfsiz bytes	bcc	tdt$g5	move.b	#'A',d0	bra	tdt$extdt$g5	bsr	inipdflt	set numtry & default errtdt$lp	subi	#1,numtry(a6)	bmi	tdt$ex	lea	binbuff(a6),a4	spack	recno(a6),restln(a6),#"'D'"	bsr	tstans	cmp.b	#'E',d0	beq	tdt$ex	cmp.b	#'Y',d0		was ACK	bne	tdt$lp* data ACKed by rxmod	move.l	d6,restln(a6)	update rest to send (from spack)	bne	tdt$gd		get more	move.b	#'O',d0		return donetdt$ex:	rts*----------------------------------------------------- end tdata ------------*----------------------------------------------------- tbreak ----------------* tbreak -- send break to close connection**	send "B" & return "completed sucessfully"tbreak:	spack	recno(a6),#0,#"'B'"	clr	d1	rts*----------------------------------------------------- end tbreak ------------*--test answer for ok or errors ---tstans:	clr.l	d0		set no bin expected	rpack	cmp.b	#'E',d0		err msg in?	beq	taw$ex		y	cmp.b	#'Y',d0		ok?	bne	taw$ex* test for valid package number received -1 is ok	subq.b	#1,d1	andi.b	#63,d1		keep in range	cmp.b	recno(a6),d1	next rec	beq.s	taw$14	move.b	#'A',d0	lea	m$badrec(pcr),a2	bra.s	taw$ex		no, bad recnotaw$14:	addq.b	#1,recno(a6)	inc recno	andi.b	#63,recno(a6)	... in range	move.b	#'Y',d0		set go next statetaw$ex:	rtsm$badrec:	dc.b	"bad recno ",0	align*----------------------------------*---------------	use	../rt_comm/rt_comm.a	use	topenf.a	use	../rt_comm/pack.a	use	../rt_comm/unpack.a	ends