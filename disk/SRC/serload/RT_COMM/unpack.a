*---- rxpack -- get a package  -------------------------------* rxpack (rpack (len, addr)*	get package & unpack it if "S" or "D"*	show progress if line<>0 & "pgmess" =0 with*		"xy" x: received recno (0...F) or*			c cks err or*			? bad record len or*			. timeouted*		     y: own recno (0...F)**	entry: d0 max bytes to unpack if "S" or "D" ('cause*		packing makes always 3 bytes)*	exit ok:*		d0 type, d1 recno, d2 len. If "S" or "D": a1*		updated after last byte unpacked*	exit err:*		d0 type: 0 OS9 err  -1 timeouted  -2 cks err*		d1         OS9 errno if approp.*		a2 ptr to err msg* set diffent times for timeout 	ifdef	RXTIMOT	equ	10	tx may be loaded heavily	endc	ifdef	TXTIMOT	equ	5	rx has no more to do than loading (we hope !)	endcrxpack:	movem	d0/d2,-(a7)	move	#TIMOT,d2	set timeout time	lea	inbuff(a6),a0	move.l	#maxpackl+3,d1	move	line(a6),d0	if undefined, it's 0=StdIn	bsr	rdlin_tim	movem	(a7)+,d0/d2	bcc	rxp$10	clr	d0		set OS9 error	cmp	#$100,d1	timeouted?	bne	rxp$05	move.b	#'.',d0	bsr	tprog		tell progress	moveq	#-1,d0	lea	m$timo(pcr),a2	y, set so	bra	rxp$exrxp$05	lea	m$rderr(pcr),a2	bra	rxp$exrxp$10	bsr	UnPackrxp$ex:	move	d0,-(a7)	save result	move.b	recno(a6),d0	bsr	tphex		make 0...f	bsr	tprog		show if req	move.b	#C$Spac,d0	bsr	tprog	move	(a7)+,d0	restore	rtsm$timo	dc.b	"Timeouted",0m$rderr	dc.b	"Error Reading line",0	align*---------------------------------------------- end rxpack ---*---- unpack data package ------------------------------------* Data packages: Size and Data: both are packed 3 original*     bytes a, b & c into 4 Transfer bytes:*     remaining bytes may occur in last data record and are*     removed by knowledge of module size** checksum: bytes from n to last ahead of cks summed up, then*      cks= $20+( $3F and (cks>>6 + cks) - bytes are those*	which are really send !* len at entry: move max len bytes if D or S-package** call: unpack (len, dest buffer,source buff) in d0, a1, a0* ret :        (recno, no of bytes, type) in d0, d1, d2*               if type =-1 cks err*               data ptr to next byte -also if error*UnPack:	movem.l	d0-d6/a0,-(a7)	save used regs	move.b	(a0)+,d5	move.b	d5,d3		init cks	subi.b	#$20,d5		unchar(recno)* get size of package	clr	d6	move.b	(a0)+,d6	add.b	d6,d3		update cks	subi.b	#$23,d6		unchar it & sub header size	bmi	UPrp$bl		bad len	cmp	#maxdatab,d6	bhi	UPrp$bl* get type of record	move.b	(a0)+,d4	add.b	d4,d3		update cks* get data if any or check cks	move	d6,d1		work copy	beq	UPrp$90		no data or done* if not "S" or "D" - only check	cmp.b	#'D',d4	beq	UPrp$20	cmp.b	#'S',d4	beq	UPrp$20* check nonbin package	bra	UPrp$12UPrp$10:	move.b	(a0)+,d0	add.b	d0,d3UPrp$12	dbra	d1,UPrp$10	bra	UPrp$90* get binary data & unpack up to max sizeUPrp$20:	clr.l	d6		forget char count - use as byte cntUPrp$22	 moveq	#3,d2		get 4 bytes from inbuffUPrp$24	move.b	(a0)+,d0	add.b	d0,d3	ror.l	#8,d0	dbra	d2,UPrp$24	bsr	unpack4_3	make 3 bytes*  storing - 3 lower bytes in d0 to any buff add	cmp.l	(a7),d6		max bytes in		beq	UPrp$28		y, skip storing	addq.l	#1,d6	swap	d0	move.b	d0,(a1)+	upper	swap	d0	bsr	UPstr		store lower bytes	bsr	UPstrUPrp$28	subq	#4,d1		all done?	bne	UPrp$22		no** all data done - prep for tell progress  & build cks*UPrp$90:	move.b	d5,d0		get recno	bsr	tphex		make hex 0...f* test cks ok	move.b	d3,d1	lsr.b	#6,d1		upper 2 bits to lowest 2 bits	add.b	d3,d1		add cks itsself	andi.b	#$3F,d1	addi.b	#$20,d1		char(d0)	sub.b	(a0)+,d1	cks ok?	beq	UPrpEx		y	move.b	#'c',d0		mark cks	move.b	#-2,d4		no	lea	m$cks(pcr),a2	set err ptr	bra	UPrpEx* bad len - return as cksUPrp$bl	lea	m$badlen(pcr),a2	move.b	#'?',d0	move.b	#-2,d4*  * return*UPrpEx:	bsr	tprog		report error or rec. recno	movem.l	d4-d6,(a7)	update recno,len,type	movem.l	(a7)+,d0-d6/a0	restore incl buff add	rtsUPstr:	cmp.l	4(a7),d6		max bytes in		beq	UPstrex	addq.l	#1,d6	ror.w	#8,d0	move.b	d0,(a1)+	middleUPstrex	rtsm$cks	dc.b	"Checksum error",0m$badlen dc.b	"Bad Record len",0	align*-----------------------------------------------------------------------------*---- unpack 4 to 3 bytes -----------** unpack  4 ascii bytes to 3 bin bytes.**  entry:  d0 has 4 ascii chars*  exit :  d0 with 3 lower bytes*unpack4_3:	movem.l	d1-d2,-(a7)	subi.l	#$20202020,d0	move.l	d0,d1	clr.l	d0	moveq	#3,d2		do 3 times	bra	p43$12p43$10	lsl.l	#6,d0	lsr.l	#8,d1p43$12	or.b	d1,d0	dbra	d2,p43$10	movem.l	(a7)+,d1-d2	rts*---------------------------- end pack_data ---------------------------------tphex	andi.b	#$f,d0		make lower nibble a HEX digit	cmpi.b	#$A,d0		... for TellPROGress	blo.s	tphex1	addq.b	#7,d0tphex1	addi.b	#'0',d0	rts*------------------------------------------------------ tprog ---------------* tprog - tell progress of transmission*	prints a character if line <> 0 and "prgmes" is 0*	char is in d0*	output to std outtprog:	tst	line(a6)	beq	tpg$ex	tst	prgmes(a6)	bne	tpg$ex	movem.l	d0-d1/a0,-(a7)	moveq	#StdOut,d0	moveq	#1,d1		no of chars	lea	3(a7),a0	to callers byte in d0	OS9	I$Write*	bcs	???		what to do here ??	movem.l	(a7)+,d0-d1/a0tpg$ex	rts*------------------------------------------------------ end tprog -----------	use	../rt_comm/rdlin_tim.a