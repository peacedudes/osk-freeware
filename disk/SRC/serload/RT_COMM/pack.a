*---------------* if bin (S or D package):* a4 used permanently & updated by PrepPack* d6 permanently as rest of data to dotxpack	bsr.s	PrepPack	make package	move	line(a6),d0	bne.s	txpk$10		line used	move	#StdOut,d0txpk$10	move.l	#maxpackl+3,d1	lea	outbuff(a6),a0	OS9	I$WritLn*	bcs	???	rts*---------------* pack a transmit package*---- record format ---* n : record number - mod 63* l : record size from n to last data without cks and CR*     valid len 3 to 96 - send from $23 to $7f*      * Data packages: Size and Data: both are packed 3 original*     bytes a, b & c into 4 Transfer bytes:*     remaining bytes may occur in last data record and are*     removed by knowledge of module size*   all other types with data (msg) are unconverted** checksum: bytes from n to last ahead of cks summed up, then*      cks= $20+( $3F and (cks>>6 + cks) - bytes are those*	which are really send !** call: sendpack recno, [noofbytes], type, [data ptr]*       argumends in d0,   d6.l,      d2,    a4*        recno: record number*        noofbytes: rest of data bytes to send for bin or (.l)*		non bin data byte count (onlu lower .w used)*        data ptr only for bin; non bin have to be placed to outbuff+3   *       returns:  noofbytes updated to rest (d6)*		  data ptr to next byte     (a4)*PrepPack:	movem.l	d0-d3/a1,-(a7)	save arguments & used regs	lea	outbuff(a6),a1	point to buffer start	addi.b	#$20,d0		char(recno)	move.b	d0,(a1)	move.b	d0,d3		init cks* insert type	move.b	d2,2(a1)		add.b	d2,d3* check len depending on type "D" or "S"	cmp.b	#'D',d2	beq	Prp$10		data (binary)	cmp.b	#'S',d2	bne	Prp$50		no data nor sizePrp$10	subi.l	#maxbind,d6	if more than fit in buff	bmi	Prp$12		less than max* more or just max bytes to do	move.l	#maxbind,d4		bra	Prp$14Prp$12:	move.l	d6,d4	clr.l	d6		set all done	add.l	#maxbind,d4* compute len/3 * 4 to next number dividible by 4Prp$14	addq	#2,d4		to get rounding	divu	#3,d4		get integer result	lsl	#2,d4		multiply by 4* set record len & update cks	move.b	d4,d0	addi.b	#$23,d0		char(+3 for recno,len,type)	add.b	d0,d3		update cks	move.b	d0,1(a1)	set len	lea	outbuff+3(a6),a1 where to place data* do binary dataPrp$20:	bsr	packm3_4	get them to d0 packed	subq	#4,d4	bne	Prp$20	bra	Prp$90		do cks* do char dataPrp$50:	move.b	d6,d0	addi.b	#$23,d0	add.b	d0,d3	move.b	d0,1(a1)	lea	errbuff(a6),a1	bra	Prp$54Prp$52:	add.b	(a1)+,d3	update cksPrp$54:	dbra	d6,Prp$52** all data out - build cks*Prp$90:	move.b	d3,d0	lsr.b	#6,d0		upper 2 bits to lowest 2 bits	add.b	d3,d0		add cks itsself	andi.b	#$3F,d0	addi.b	#$20,d0		char(d0)	move.b	d0,(a1)+	move.b	#$d,(a1)+	set end of line** return*	movem.l	(a7)+,d0-d3/a1	rts*-----------------------------------------------------------------------------*--- packm3_4 --- pack 3 bytes from mem---------------------------------------* entry: a4 pointing to 1. Byte of data buffer*        a1 pointing to 1. Byte of transmit buffer*	 d3.w checksum* exit:  a4 after 3. byte*        a1 after 4. char*        d3 updatedpackm3_4:	movem.l	d0-d2,-(a7)* get 3 data bytes* ----------------	clr	d0	move.b	(a4)+,d0	swap	d0	move.b	(a4)+,d0	lsl	#8,d0	move.b	(a4)+,d0* convert them* ------------	move.l	d0,d1	clr.l	d0	moveq	#3,d2		do 3 times	bra	p34$12p34$10	lsl.l	#8,d0	lsr.l	#6,d1p34$12	or.b	d1,d0	and.b	#$3F,d0	dbra	d2,p34$10	addi.l	#$20202020,d0* store in buffer & update cks* ----------------------------	moveq	#3,d2Prp$24	move.b	d0,(a1)+	add.b	d0,d3	lsr.l	#8,d0	dbra	d2,Prp$24	movem.l	(a7)+,d0-d2	rts*---------------------------- end pack_data ---------------------------------