	ttl	read line within time	nam	rdlin_tim.a*	psect	rdlin_tim,0,0,0,0*--------------------------------------------- rdlin_tim ------* rdlin_tim* read a line up to CR or given number of chars to buff*	within time*	timeout is exact up to some system ticks !** entry:*	d0.w	path*	d1.l	chars to read*	d2.w	timeout in seconds*	a0.l	buffer* exit ok:*	d1.l	chars really read - including cr (as I$ReadLn)* exit error:*	d1 error number*		$0100 timeouted*		others from from I$GetStt, F$Sleep, I$Read	org	0r_d0	do.l	1r_d1	do.l	1r_d2	do.l	1rdlin_tim:	movem.l d0-d7/a0,-(a7)* set date & time of timeout	move	#3,d0		get juldat + ticks	os9	F$Time	move.l 	d0,d5		time	move.l 	d1,d4		day	move.l 	d3,d6		tickrate/tick	move.l 	r_d2(a7),d0	compute end time	andi.l 	#$FFFF,d0	add.l 	d0,d5	cmp.l 	#86400,d5	next day	bcs.s 	g$data		no	addq.l 	#1,d4		y, next day	sub.l 	#86400,d5	clean seconds	clr.l	d7		byte count* wait for byte in or timeout or errorg$data move.w	r_d0+2(a7),d0	path	move.w #SS_Ready,d1	os9 I$GetStt	bcc.s datin	cmp.w #E$NotRdy,d1			bne.s	 anyerr	moveq	#1,d0		nothing in -wait	os9 F$Sleep	bcs.s	 anyerr* test for time out	move.w #3,d0		get new time	os9 F$Time	cmp.l d1,d4		day reached?	bhi.s	 g$data 		no	cmp.l d0,d5		time reached	bhi.s	 g$data 		no	cmp.w d3,d6		ticks reached	bhi.s	g$data 		no	move	 #256,d1		timeoutanyerr:	move.l d1,r_d1(a7)		set err code	ori.b #1,ccr		mark err	bra.s	rdl$ex* get present data - one byte only to prevent from reading over*	max bytes or end of linedatin:	moveq.l	#1,d1	os9 I$Read	bcs.s anyerr		err		addq	#1,d7	cmp.l	r_d1(a7),d7	max in?	bhs.s	rdl$ok		yes	move.b	(a0)+,d0	inc char ptr	cmp.b	#C$CR,d0	EOL?	bne.s	g$data		nordl$ok:	move.l	d7,r_d1(a7)	return bytes inrdl$ex:	movem.l	(a7)+,d0-d7/a0	rts*------------------------------------------end rdlin_tim ------