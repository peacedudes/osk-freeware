*---------------------------------------------------set options ---------* setopt sets NoEcho & NoLF if line is no SCF device*---------------------------------------------------*   get current options & Device class*SetOpt:	movem.l	d0-d1/a0-a1,-(a7)	move	line(a6),d0	move.w	#SS_Opt,d1	lea.l	outbuff(a6),a0	os9	I$GetStt	bcs.s	SetOex* save auto lf & echo and disable them if SCF device	lea.l	-PD_DTP(a0),a1	to use PD_... definitions	move.b	PD_DTP(a1),s_DTP(a6)	bne.s	noscf	move.b	PD_EKO(a1),s_EKO(a6)	save Echo	clr.b	PD_EKO(a1)		set no echo	move.b	PD_ALF(a1),s_ALF(a6)	save auto lf	clr.b	PD_ALF(a1)		set no auto lf	os9	I$SetStt	bcs.s	SetOex	move.b	#-1,s_set(a6)	mark options set	clr	d1		set ok, no carry	bra	SetOexnoscf:	clr	d1	ori.b	#Carry,ccrSetOex	movem.l	(a7)+,d0-d1/a0-a1	rts*-----------------------------------------------end set options ---------*-----------------------------------------------close Line --------------* reset entry options & close Line if not 0** all registers & status saved for exitClosLine:	movem.l	d0-d1/a0-a1,-(a7)	move	ccr,-(a7)	move	line(a6),d0	get line	tst.b	s_DTP(a6)	bne.s	Clos$10	tst.b	s_set(a6)	beq	Clos$10		don't reset if not set	move.w	#SS_Opt,d1	get all opts again	lea.l	outbuff(a6),a0	os9	I$GetStt	bcs.s	Clos$ex	lea.l	-PD_DTP(a0),a1	move.b	s_EKO(a6),PD_EKO(a1)	move.b	s_ALF(a6),PD_ALF(a1)	os9	I$SetSttClos$10	tst	d0		std path or none open?	beq.s	Clos$ex		y	OS9	I$Close		no, close itClos$ex	move	(a7)+,ccr	restore ccr	movem.l	(a7)+,d0-d1/a0-a1	rts*-----------------------------------------------end close Line ---------