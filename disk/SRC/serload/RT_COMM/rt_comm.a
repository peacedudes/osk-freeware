	nam	rt_comm	ttl	rxmod & txmod common routines************************************************************ this module has parts which have conditional assembly ! **          so it can't be a commom .r-file !              *************************************************************----------------------------------------------------- terrp ----------------* terrp -- send error message**	send errmsg to stderr*	if "Line" send it to line too*	return 	"Aborted with err"**	entry:	a2   - ptr to err msg*		fnptr - ptr to currently processed file*		errno - OS9 error number (0: no OS9 err)terrp:	movem.l	a2,-(a7)		save err msg ptr	lea	outbuff+3(a6),a1	start of data in outbuff	clr	d1			byte count	lea	pgname(pcr),a2	bsr	concat	tst	errno(a6)	beq	ter$20			no OS9 errter$12:	lea	oserr(pcr),a2	bsr	concat	lea	-1(a1),a1		remove blank	clr.l	d0	move	errno(a6),d0	andi	#$FF,d0			use only lower part	divu	#100,d0	bsr	divstr			100	divu	#10,d0	bsr	divstr			10	bsr	divstr			1	move.b	#' ',(a1)+	addq	#1,d1ter$20:	movem.l	(a7)+,a2	bsr	concat	spack	recno(a6),d1,#"'E'"	to line or stderr	lea	outbuff+3(a6),a0	bsr	pstderr			to stderr if <> lineter$ex:	move.b	#-1,d1	set error	rtspgname		ifdef	RX	dc.b	"RX"	endc	ifdef	TX	dc.b	"TX"	endc	dc.b	"Mod - Err: ",0oserr	dc.b	"xxx:",0	align*----------------------------------------------------- end terrp ------------*----------------------------------------------------- terrp ----------------* tprerr -- print error message**	if "line": print it *	return "Aborted with err"tprerr:	lea	inbuff+3(a6),a0	bsr	pstderr	move.b	#1,d1	set error	rts*----------------------------------------------------- end terrp ------------*---------------divstr:	add.b	#'0',d0	move.b	d0,(a1)+	store	addq	#1,d1		inc char count	clr	d0	swap	d0	rts*---------------*---------------* concat (a2)+ to (a1)+, replace 0 by space, inc d1* returns 0 if max len reachedconcat:	cmp	#maxdatab-1,d1	beq	conc$ex	addq	#1,d1	move.b	(a2)+,(a1)+	bne	concat	move.b	#' ',-1(a1)conc$ex	rts*---------------*---------------* print (a0) to std err path if line <> stderr* --?? replace "0" ??pstderr:	tst	line(a6)	beq	pstde$x	move	#StdErr,d0	move.l	#127,d1	OS9	I$WritLnpstde$x	rts*---------------*---------------* init package defaultsinipdflt:	move	#10,numtry(a6)	lea	m$noresp(pcr),a2   default abort reason	rtsm$noresp:	ifdef	TX	dc.b	"RX"	endc	ifdef	RX	dc.b	"TX"	endc	dc.b	" sends no valid response",0	align*-------------------------------------------*--------------------------------------------- flush ------* read out all present data from line before* 	starting work	org	0f_byte	do.b	1f_d0	do.l	1f_d1	do.l	1flush:	movem.l d0-d1/a0,-(a7)	lea	-1(a7),a7	place for one byte	move.l	a7,a0	move	line(a6),d0	get path* test for data presentfls$10	move.w #SS_Ready,d1	os9 I$GetStt	bcs.s fls$20* get data	moveq.l	#1,d1	os9 I$Read	bcs.s	fls$er	bra.s	fls$10		test for more* no more ?fls$20	cmp	#E$NotRdy,d1			beq.s	fls$exfls$er	move.l d1,f_d1(a7)		set err code	ori.b #1,ccr		mark errfls$ex:	lea	1(a7),a7	movem.l	(a7)+,d0-d1/a0	rts*------------------------------------------end flush ------