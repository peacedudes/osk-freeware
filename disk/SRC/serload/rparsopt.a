	nam	rparsopt.a	ttl	rx options parser*-----------------------------------------------tx parse opts ---* rxmod option parser*	entry: a5 to start of params*	exit ok: (zero)*		a1 to start of 1. possible path name*		line set & open if defined*		all params removed*	exit err: (non zero)*		errno OS9 err number or 0*		a2 to bad param or text*rparsopt:*   --- find ending CR and replace by Null ---	move.l	a5,a1	clr	errno(a6)par$prp	move.b	(a5)+,d0	beq.s	par$prx	cmp.b	#C$CR,d0	bne.s	par$prp	clr.b	-1(a5)		set 0 at endpar$prx*   --- find -l, undefined options and start of 1. name	move.l	a1,a5	movea	#0,a1		will get ptr to first filerpar$lp:	move.l	a5,a2		save poss start of bad param	move.b	(a5)+,d0	beq.s	rpar$ex	cmp.b	#'-',d0	bne.s	rpar$il		no param	move.b	(a5)+,d0	get param	beq	rpar$il		ill	or.b	#$20,d0		make nonCAP	cmp.b	#'l',d0	bne	rpar$il		no -l	lea	-2(a5),a2	set start of -lrpar$21	move.b	(a5)+,d0	beq.s	rpar$il		no line defined	cmp.b	#C$Spac,d0	beq.s	rpar$il			cmp.b	#'=',d0	beq.s	rpar$21		'=' found, find poss. device name start	*   try open path	lea	-1(a5),a0	move.b	#Updat_,d0	OS9	I$Open	bcc.s	rpar$25		ok	move	d1,errno(a6)	bra.s	rpar$il	* test for <module(s)> presentrpar$25	move	d0,line(a6)	save line	move.b	(a0),d0	beq	rpar$ex		no 	move.l	a0,fnptr(a6)		set behind dev namerpar$ex:	bsr	SetOpt		set NoEcho, NoLF	bcc.s	rpar$e1	lea	m$opterr(pcr),a2	move	d1,errno(a6)	bra.s	rpar$ilrpar$e1	clr	d0	rts			zero if ok*  --- ill param ---*	make mess to StdErr as Err Package - user may be*		TXMod*	a2 to bad param, errno OS9 err numberrpar$il:	move.l	a2,a0	for terrp	bsr	terrp		send Error package	move	#StdErr,d0	move.l	#usaglen,d1	lea	Usage(pcr),a0	OS9	I$Write		to make many lines	move	errno(a6),d1	& OS9 err if any	move	#-1,d0		return error	rtsm$opterr dc.b	" cannot set line options !",0	align*----------------------------------------------------------------