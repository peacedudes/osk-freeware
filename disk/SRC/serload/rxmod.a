	nam	RXmod	ttl	Header & Usage	use	/dd/defs/defsfile	use	marker.m**************************************** Function:*  Get OS9 module(s) from other system & make them*	known to system (load via serial link)* see usage for help	page****** edt  date* --- -------- --------------------------*  0  07-sep-90 initial version*  1  18-sep-90 total ueberarbeitet*  2  10-oct-90 align outbuff for OS9 v2.3 - getsts needs it*  3  11-oct-90 progress msg added, inc recno ok*  4  21-oct-90 handle diff versions of OS9 (V2.1, V2.3)Edition	equ	4Revisn	equ	2Type	set	(Prgrm<<8)+ObjctRevs	set	(ReEnt<<8)+Revisnstacksz	set	250	psect	rxmod,Type,Revs,Edition,stacksz,rxmodentUsage:	dc.b	"RXmod Ed.",'0'+Edition," Rv.",'0'+Revisn	dc.b	" - load Module via SCF from TXMod on Host",C$CR,C$LF	dc.b	"Syntax: rxmod [<opts> [module(s)]]",C$CR,C$LF	dc.b	"Options:",C$CR,C$LF	dc.b	"  -l[=]<dev> : use dev for xmission",C$CR,C$LF	dc.b	"              else StdIn/StdOut/StdErr",C$LF,C$CR	dc.b	"   Module(s) : all after <dev> to EOL is send to",C$CR,C$LF	dc.b	"              Host, preceeded by 'TXMOD'. For",C$CR,C$LF	dc.b	"              wildchards on host use "	dc.b	'"','*','"'," in double-quotes",C$CR,C$LFusaglen	equ	*-Usage	alignStdIn:	equ	0	std pathesStdOut:	equ	1StdErr:	equ	2	std err msgRX	equ	1	define for pack/unpack cond. assembly* ------------------------------------------	vsectModSiz: ds.l	1	module sizeMemptr:	ds.l	1	where to load moduleMemsiz:	ds.l	1	size of allocated memCurptr:	ds.l	1	where to load current packagerestln:	ds.l	1	- rest of module to sendfnptr:	ds.l	1	- pointer to curr file nameTrapEx:	ds.l	1	- ptr to trap exit routine in vmod_trapInPath:	ds.w	1	module read pathaccmod: ds.w	1	read or execute access modenumtry:	ds.w	1	- number of tries in error caseerrno:	ds.w	1	- OS9 error numberline:	ds.w	1	- path number of line or 0prgmes:	ds.w	1	- print progress msg if 0s_set:	ds.b	1	- flag options sets_DTP:	ds.b	1	- saved device classs_EKO:	ds.b	1	- saved entry ECHO state of lines_ALF	ds.b	1	- saved entry AutoLF staterecno:	ds.b	1	- record to send or expectedstate:	ds.b	1	current state* following buff size definition depends on max bytes which may*  be xferd in one buffermaxpackl: equ 127-' '	max len which can be expressed in len field of recrdmaxdatab: equ maxpackl-3 bytes used by recno, len, typemaxbind:  equ (maxdatab/4)*3  3 bytes packed in 4 charsoutbuff: ds.w	1	- buffer with responses          ) same buff	ds.b	1	- ... this is the header part    )inbuff:	equ	outbuff	- same                           )errbuff: ds.b	maxpackl+2-3	- buffer to send err msgs        )	ds.b	128-(maxpackl+2) 128 needed for getstat/setstat	ds.b	10	ends**********************************rxmodent:	bsr	Trapins	bcs.s	SLExit	bsr	rparsopt	test for options & errs	bne	SLExit		error - d1 has code	inimark			for *dbg*	bsr	statswitch	do itSLExit	bsr	ClosLine	OS9	F$Exit		with error code*---------------------------------VmodTr:	equ	2	number of trapTrapnam	dc.b	"VMod_trap",0	name of handlerininam	dc.b	"init",0	align* -------------------------------------------	********************************** Trap install** this routine installs the trap handler for performing* system memory allocation & module insertion depending* from systems OS9 version* (V2.3 needs rts at supervisory trap handler exit, others*  a rte)Trapins:	move.l	a5,-(a7)	save arg ptr	clr	d0		get any type	lea	ininam(pcr),a0	OS9	F$Link	bcc.s	Tpi$10	lea	m$inierr(pcr),a0	bra	Tpi$erTpi$10	clr	d2		assume not 2.3	cmpi.b	#2,M$OS9Lvl+1(a2)	test version	blo	Tpi$12		lower 2.x	cmpi.b	#3,M$OS9Lvl+2(a2)	blo	Tpi$12		lower 2.3	move.b	#-1,d2		set 2.3Tpi$12	moveq	#VmodTr,d0	no of trap to assign	moveq	#0,d1		no add. mem	lea	Trapnam(pc),a0	os9	F$TLink		install handler	bcc.s	Tpi$ex		okTpi$er	lea	m$tpierr(pcr),a0	move	d1,errno(a6)	move	#StdErr,d0	move	#80,d1	OS9	I$WritLn	move	errno(a6),d1	movea.l	(a7)+,a5	ori	#Carry,ccr	rtsTpi$ex	move.l	a5,TrapEx(a6)	save return routine ptr	movea.l	(a7)+,a5	rtsm$tpierr dc.b	"can't install Vmod Trap handler",C$CR,0m$inierr dc.b	"can't link to INIT to get version",C$CR,0	align*-------------------------------------------------------------	use	rparsopt.a	use	../rt_comm/setopt.a	ends	