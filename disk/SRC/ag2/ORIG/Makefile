# Makefile for ag - Anagram Generator# Written by Morten Lerskau Ronseth # May 30, 1991#CC            = gccCCFLAGS       = -O #-gSHELL         = /bin/shINSTALL       = installBINDIR        = /export/users/morten/binCSOURCES      = anagram.c postf.cFILES         = Makefile README $(CSOURCES) pref.l fagall: ag pref postfag : anagram.c	$(CC) $(CCFLAGS) $? -o agpostf: postf.c	$(CC) $(CCFLAGS) postf.c -o postfpref: pref.l	@$(LEX) pref.l	@mv lex.yy.c $@.c	$(CC) $(CCFLAGS) -ll $@.c -o prefinstall : ag	$(INSTALL) -s ag $(BINDIR)clean : NOTREACHED	rm -f ag pref postf *.o lex.yy.c shar.outshar : NOTREACHED	@shar $(FILES) > shar.out	@echo Archive in shar.outlint: NOTREACHED	lint  $(CSOURCES) 2>&1 | tee lint.outctags: NOTREACHED	ctags anagram.cdiff: NOTREACHED	@echo > ag.pch	@(for i in $(FILES); do \		if [ -r $${i}.orig -a -r $${i} ]; then \			set +e; \			diff -c $${i}.orig $${i} > tmp; \			case $$? in \				1)	cat tmp >> ag.pch;; \				2)	echo diff: error 2; exit 2;; \			esac \		else \			echo either $${i}.orig or $${i} does not exist; \		fi \	done)	@echo Context diff created in ag.pchpatch: *.pch	for i in $(FILES); do \		cp $${i} ${i}.orig; \	done	patch < $?NOTREACHED: