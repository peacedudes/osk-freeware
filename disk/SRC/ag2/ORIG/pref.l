/*	ANAGRAM FILTER *//*	Sean Barrett May 1991 *//*	This lex filter removes all numeric and capitalized entries *//*	from stdin.  This may result in a more "useful" dictionary *//*	for anagramming from, which you can do by *//*	% lex pre_filter.l *//*	% cc -ll -o pref lex.yy.c *//*	% pref </usr/dict/words >words *//*	and by tailoring anagram.c to look for the right dictionary. */%%^[a-z]+$	{ ECHO; printf("%\n"); }.		{ }\n		{ }%%yywrap() { return 1; }