# file: xfmt/Makefile# 04/88  bgray, rev. 05/88 by Greg LeeBINDIR = /usr/lbinMANDIR = /usr/man/u_man/man1CATMAN = /usr/catman/u_man/man1LIBS = -ltermcapCFLAGS = -OLDFLAGS = -sCC = /bin/ccRM = /bin/rm -fCP = /bin/cpOBJS =all: xfmtxfmt:	xfmt.c	$(CC) $(CFLAGS) $(LDFLAGS) -o xfmt xfmt.c $(LIBS)xfmt.c:	xfmt.l	@rm -f xfmt.c	flex -t xfmt.l >xfmt.cxfmt.doc: xfmt.1 xfmt	xfmt -jmo xfmt.1 >xfmt.docshar:	xfmt.l xfmt.1 README Makefile MANIFEST cmds.tex flex.skel.diff	@rm -f xfmt.shar	makekit -m -nxfmt.shar.install: all xfmt.doc	$(CP) xfmt $(BINDIR)	chown bin $(BINDIR)/xfmt	chgrp bin $(BINDIR)/xfmt	chmod 755 $(BINDIR)/xfmt	$(CP) xfmt.doc $(CATMAN)/xfmt.1	chown bin $(CATMAN)/xfmt.1	chgrp bin $(CATMAN)/xfmt.1	chmod 644 $(CATMAN)/xfmt.1clean:	rm xfmt.c