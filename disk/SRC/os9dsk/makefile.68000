# Makefile to compile os9dsk# Copyright (c) 1995 by Bob DevriesCC = ccODIR    = /r0RDIR	= ../RELSSDIR    = .CFLAGS  = -t=/r0LFLAGS  = -M=8RFILES	= os9dsk.r diskid.r os9dir.r os9proc.r os9copy.r usage.r finddir.r \get_attr.ros9dsk: $(RFILES)	chd $(RDIR); l68 $(LFLAGS) /dd/lib/cstart.r $(RFILES) -o=/r0/os9dsk \    -l=/h0/lib/alib.l -l=/h0/lib/clib.l -l=/h0/lib/sys.l   copy -r /r0/os9dsk ../CMDS/os9dsk.68000# Dependenciesos9dsk.r: os9dsk.c       $(CC) $(CFLAGS) -r=$(RDIR) os9dsk.cos9dir.r: os9dir.c coco_direct.h       $(CC) $(CFLAGS) -r=$(RDIR) os9dir.cusage.r: usage.c       $(CC) $(CFLAGS) -r=$(RDIR) usage.cos9copy.r: os9copy.c coco_direct.h       $(CC) $(CFLAGS) -r=$(RDIR) os9copy.cos9proc.r: os9proc.c coco_direct.h       $(CC) $(CFLAGS) -r=$(RDIR) os9proc.cfinddir.r: finddir.c coco_direct.h       $(CC) $(CFLAGS) -r=$(RDIR) finddir.cget_attr.r: get_attr.c       $(CC) $(CFLAGS) -r=$(RDIR) get_attr.c# EOF makefile