# Makefile for GNU tar program.SHELL = sh# -DSTDC_MSG		If you are using an ANSI compiler, and have vfprintf().# -DVARARGS_MSG		If you have varargs.h and vfprintf()# -DDOPRNT_MSG		If you have _doprnt(), and no useful varargs support# -DLOSING_MSG		If nothing else works.## Some non-BSD systems may have to add -DNEED_TZSET in order to have getdate.y# compile correctly.## If you can't use remote tar with the rmt library, you can still get# some stuff to work right by adding -DUSE_REXEC.## Some people's systems define a prototype for signal handlers which# require them to be declared as void.  If you get such problems in# rtape_lib, function command, then define -DSIGNAL_VOID.  ## getdate.y has 8 shift/reduce conflicts.### OSKCC	  		= gccDEFS	  		= -DSTDC_MSG # -DVARARGS_MSGYACC			= bison -yLOCAL_SRC 		= getdate.y  rtape_lib.cLOCAL_OBJ 		= getdate.$O rtape_lib.$OLDFLAGS   		= LIBS 	  		= -los9lib.l -lusr.l #-lblarslib.lLINT 	  		= lintLINTFLAGS 		= -abchxDEF_AR_FILE 		= \"/mt0\"DEFBLOCKING 		= 4O 			= rCFLAGS			= $(COPTS) $(ALLDEFS)ALLDEFS 		= $(DEFS) -DDEF_AR_FILE=$(DEF_AR_FILE) -DDEFBLOCKING=$(DEFBLOCKING)COPTS			= -O2 -o68 -cio -m68000 -fkeep-inline-functions -I -I/dd/defs -I/dd/defs/unix# Destination directory and installation program for make installbindir 			= .SRC1 =	tar.c create.c extract.c buffer.c getoldopt.c update.c gnu.c mangle.c rmdir.cSRC2 =  version.c list.c names.c diffarch.c port.c wildmat.c getopt.c getopt1.c regex.cSRC3 =  $(LOCAL_SRC) $(SUBSRC)SRCS =	$(SRC1) $(SRC2) $(SRC3)OBJ1 =	tar.$O create.$O extract.$O buffer.$O getoldopt.$O list.$O update.$O rmdir.$OOBJ2 =	version.$O names.$O diffarch.$O port.$O wildmat.$O getopt.$O getopt1.$O regex.$OOBJ3 =  gnu.$O mangle.$O $(LOCAL_OBJ) $(SUBOBJ)OBJS =	$(OBJ1) $(OBJ2) $(OBJ3)# all:	tar rmttar:	$(OBJS)	$(CC) $(LDFLAGS) -o $(bindir)/gtar $(OBJS) $(LIBS)# rmt:	rtape_server.c#	$(CC) $(CFLAGS) $(LDFLAGS) -o rmt rtape_server.c $(LIBS)# testpad.h: testpad#	$(SHELL) testpad > testpad.h# testpad: testpad.r#	$(CC) -o testpad testpad.r$(OBJS): tar.h port.h testpad.hregex.$O tar.$O: regex.h.SUFFIXES:.SUFFIXES: .r .c.c.r:	$(CC) $(CFLAGS) -c $*.c