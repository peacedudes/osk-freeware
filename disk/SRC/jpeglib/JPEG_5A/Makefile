# Makefile for Independent JPEG Group's software# This makefile is suitable for Unix-like systems with ANSI-capable compilers.# If you have a non-ANSI compiler, makefile.unix is a better starting point.# Read installation instructions before saying "make" !!# The name of your C compiler:CC= gcc2# You may need to adjust these cc options:CFLAGS= -O -o68 -I/dd/blarslib/defs -T/r0 -ucc -mcpu32 -oldlibs -Fcc2s300# Generally, we recommend defining any configuration symbols in jconfig.h,# NOT via -D switches here.# Link-time cc options:LDFLAGS= -oldlibsODIR =/h0/cmds# To link any special libraries, add the necessary -l commands here.LDLIBS= -l/dd/lib/os9lib.l.c.r:    $(CC) $(CFLAGS) -c -o $*.r $*.c# Put here the object file name for the correct system-dependent memory# manager file.  For Unix this is usually jmemnobs.o, but you may want# to use jmemansi.o or jmemname.o if you have limited swap space.SYSDEPMEM= jmemnobs.r# miscellaneous OS-dependent stuff# linkerLN= $(CC)# file deletion commandRM= -del -f# library (.l) file creation commandAR= merge# second step in .l creation (use "touch" if not needed)AR2= touch# End of configurable options.# source files: JPEG library properLIBSOURCES= jcapi.c jccoefct.c jccolor.c jcdctmgr.c jchuff.c jcmainct.c \        jcmarker.c jcmaster.c jcomapi.c jcparam.c jcprepct.c jcsample.c \        jdapi.c jdatasrc.c jdatadst.c jdcoefct.c jdcolor.c jddctmgr.c \        jdhuff.c jdmainct.c jdmarker.c jdmaster.c jdpostct.c jdsample.c \        jerror.c jutils.c jfdctfst.c jfdctflt.c jfdctint.c jidctfst.c \        jidctflt.c jidctint.c jidctred.c jquant1.c jquant2.c jdmerge.c \        jmemmgr.c jmemansi.c jmemname.c jmemnobs.c jmemdos.c# source files: cjpeg/djpeg applications, also rdjpgcom/wrjpgcomAPPSOURCES= cjpeg.c djpeg.c rdcolmap.c rdppm.c wrppm.c rdgif.c wrgif.c \        rdtarga.c wrtarga.c rdbmp.c wrbmp.c rdrle.c wrrle.c rdjpgcom.c \        wrjpgcom.cSOURCES= $(LIBSOURCES) $(APPSOURCES)# files included by source filesINCLUDES= jdct.h jerror.h jinclude.h jmemsys.h jmorecfg.h jpegint.h \        jpeglib.h jversion.h cdjpeg.h cderror.h# documentation, test, and support filesDOCS= README install.doc usage.doc cjpeg.1 djpeg.1 rdjpgcom.1 wrjpgcom.1 \        example.c libjpeg.doc structure.doc coderules.doc filelist.doc \        change.logMKFILES= configure makefile.cfg makefile.ansi makefile.unix makefile.manx \        makefile.sas makcjpeg.st makdjpeg.st makljpeg.st makefile.bcc \        makefile.mc6 makefile.dj makefile.mms makefile.vms makvms.optCONFIGFILES= jconfig.cfg jconfig.manx jconfig.sas jconfig.st jconfig.bcc \        jconfig.mc6 jconfig.dj jconfig.vmsOTHERFILES= jconfig.doc ckconfig.c ansi2knr.c ansi2knr.1 jmemdosa.asmTESTFILES= testorig.jpg testimg.ppm testimg.gif testimg.jpgDISTFILES= $(DOCS) $(MKFILES) $(CONFIGFILES) $(SOURCES) $(INCLUDES) \        $(OTHERFILES) $(TESTFILES)# library object files common to compression and decompressionCOMOBJECTS= jcomapi.r jutils.r jerror.r jmemmgr.r $(SYSDEPMEM)# compression library object filesCLIBOBJECTS= jcapi.r jcparam.r jdatadst.r jcmaster.r jcmarker.r jcmainct.r \        jcprepct.r jccoefct.r jccolor.r jcsample.r jchuff.r jcdctmgr.r \        jfdctfst.r jfdctflt.r jfdctint.r# decompression library object filesDLIBOBJECTS= jdapi.r jdatasrc.r jdmaster.r jdmarker.r jdmainct.r jdcoefct.r \        jdpostct.r jddctmgr.r jidctfst.r jidctflt.r jidctint.r jidctred.r \        jdhuff.r jdsample.r jdcolor.r jquant1.r jquant2.r jdmerge.r# These objectfiles are included in libjpeg.lLIBOBJECTS= $(CLIBOBJECTS) $(DLIBOBJECTS) $(COMOBJECTS)# object files for cjpeg and djpeg applications (excluding library files)COBJECTS= cjpeg.r rdppm.r rdgif.r rdtarga.r rdrle.r rdbmp.rDOBJECTS= djpeg.r wrppm.r wrgif.r wrtarga.r wrrle.r wrbmp.r rdcolmap.rall: libjpeg.l cjpeg djpeg rdjpgcom wrjpgcomlibjpeg.l: $(LIBOBJECTS)	$(RM) libjpeg.l	$(AR) $(LIBOBJECTS) >libjpeg.l	$(AR2) libjpeg.lcjpeg: $(COBJECTS) libjpeg.l	$(LN) $(LDFLAGS) -o cjpeg $(COBJECTS) -llibjpeg.l $(LDLIBS)djpeg: $(DOBJECTS) libjpeg.l	$(LN) $(LDFLAGS) -o djpeg $(DOBJECTS) -llibjpeg.l $(LDLIBS)rdjpgcom: rdjpgcom.r	$(LN) $(LDFLAGS) -o rdjpgcom rdjpgcom.r $(LDLIBS)wrjpgcom: wrjpgcom.r	$(LN) $(LDFLAGS) -o wrjpgcom wrjpgcom.r $(LDLIBS)jconfig.h: jconfig.doc	echo You must prepare a system-dependent jconfig.h file.	echo Please read the installation directions in install.doc.	exit 1clean:	$(RM) *.r cjpeg djpeg libjpeg.l rdjpgcom wrjpgcom core testout.*test: cjpeg djpeg	$(RM) testout.ppm testout.gif testout.jpg	./djpeg -dct int -ppm -outfile testout.ppm  testorig.jpg	./djpeg -dct int -gif -outfile testout.gif  testorig.jpg	./cjpeg -dct int -outfile testout.jpg  testimg.ppm	cmp testimg.ppm testout.ppm	cmp testimg.gif testout.gif	cmp testimg.jpg testout.jpgjcapi.r : jcapi.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjccoefct.r : jccoefct.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjccolor.r : jccolor.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjcdctmgr.r : jcdctmgr.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jdct.hjchuff.r : jchuff.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjcmainct.r : jcmainct.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjcmarker.r : jcmarker.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjcmaster.r : jcmaster.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjcomapi.r : jcomapi.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjcparam.r : jcparam.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjcprepct.r : jcprepct.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjcsample.r : jcsample.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjdapi.r : jdapi.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjdatasrc.r : jdatasrc.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.hjdatadst.r : jdatadst.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.hjdcoefct.r : jdcoefct.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjdcolor.r : jdcolor.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjddctmgr.r : jddctmgr.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jdct.hjdhuff.r : jdhuff.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjdmainct.r : jdmainct.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjdmarker.r : jdmarker.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjdmaster.r : jdmaster.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjdpostct.r : jdpostct.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjdsample.r : jdsample.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjerror.r : jerror.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jversion.h jerror.hjutils.r : jutils.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjfdctfst.r : jfdctfst.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jdct.hjfdctflt.r : jfdctflt.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jdct.hjfdctint.r : jfdctint.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jdct.hjidctfst.r : jidctfst.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jdct.hjidctflt.r : jidctflt.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jdct.hjidctint.r : jidctint.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jdct.hjidctred.r : jidctred.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jdct.hjquant1.r : jquant1.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjquant2.r : jquant2.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjdmerge.r : jdmerge.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.hjmemmgr.r : jmemmgr.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jmemsys.hjmemansi.r : jmemansi.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jmemsys.hjmemname.r : jmemname.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jmemsys.hjmemnobs.r : jmemnobs.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jmemsys.hjmemdos.r : jmemdos.c jinclude.h jconfig.h jpeglib.h jmorecfg.h jpegint.h jerror.h jmemsys.hcjpeg.r : cjpeg.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.h jversion.hdjpeg.r : djpeg.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.h jversion.hrdcolmap.r : rdcolmap.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hrdppm.r : rdppm.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hwrppm.r : wrppm.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hrdgif.r : rdgif.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hwrgif.r : wrgif.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hrdtarga.r : rdtarga.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hwrtarga.r : wrtarga.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hrdbmp.r : rdbmp.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hwrbmp.r : wrbmp.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hrdrle.r : rdrle.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hwrrle.r : wrrle.c cdjpeg.h jinclude.h jconfig.h jpeglib.h jmorecfg.h jerror.h cderror.hrdjpgcom.r : rdjpgcom.c jinclude.h jconfig.hwrjpgcom.r : wrjpgcom.c jinclude.h jconfig.h