# Makefile for world and support programs for OS-9# NOTE: Edit helper.c to adjust the pathname for q1text.dat for# your particular system.WHEADERS = arrays.h variab.hWOBJS = demons.r helper.r motion.r parser.r verbs1.r verbs2.r world.rCFLAGS = -qixm=8kLFLAGS = -q -l=/dd/lib/rand.r -m=4kODIR = /h0/cmds/dogRDIR = RELSworld:  ./convert $(WOBJS) $(WHEADERS) 		chd $(RDIR); cc $(LFLAGS) -f=world $(WOBJS)./convert:        vcnvrt vtxtcn vtext.dat        @echo "creating data files..."        ./vtxtcn        ./vcnvrt        touch ./convertvtext.dat:        merge vtext.dat.aa vtext.dat.ab vtext.dat.ac >vtext.datvcnvrt: vcnvrt.c        cc $(CFLAGS) -f=vcnvrt vcnvrt.cvtxtcn: vtxtcn.c        cc $(CFLAGS) -f=vtxtcn vtxtcn.c