CFLAGS =	-t=/r0 -v=/h0/blarslib/defsRDIR   =	RELSODIR   =        /h0/cmdsLIBS   =        -l=/h0/blarslib/blarslib.lLFLAGS =	-i -m=10 -bgOBJS = dcp.r dcpsys.r dcpxfer.r dcpgpkt.r dcpfpkt.r dcpmisc.r dcpio.r mfgets.rall: $(ODIR)/uucico $(ODIR)/uux $(ODIR)/uuxqt $(ODIR)/uucp $(ODIR)/uupoll# $(ODIR)/mail $(ODIR)/lmail $(ODIR)/uumailclean  @touch all.date$(ODIR)/uucico:	$(OBJS)  chd $(RDIR); cc $(LFLAGS) $(OBJS) -f=$@ $(LIBS)  attr -e -pe $@$(ODIR)/uux: uux.r getseq.r  chd $(RDIR); cc $(LFLAGS) uux.r getseq.r -f=$@ $(LIBS)  attr -e -pe $@$(ODIR)/uuxqt: uuxqt.r mfgets.r getargs.r  chd $(RDIR); cc $(LFLAGS) uuxqt.r mfgets.r getargs.r -f=$@ $(LIBS)  attr -e -pe $@$(ODIR)/uucp: uucp.r mfgets.r getseq.r  chd $(RDIR); cc $(LFLAGS) uucp.r mfgets.r getseq.r -f=$@ $(LIBS)  attr -e -pe $@$(ODIR)/uupoll: uupoll.r  chd $(RDIR); cc $(LFLAGS) uupoll.r -f=$@ $(LIBS)  attr -e -pe $@