TARGET=browseDEBUG=HOME=/h0/CFILES=$(TARGET).cOFILES=$(TARGET).rHELP=$(HOME)SYS/$(TARGET).hlpCFLAGS=-ixt=/dd/TMP $(DEBUG)LFLAGS=-ixe=10LIBS=-l=/dd/LIB/os9lib.l -l=/dd/LIB/termlib.lEXEC=$(HOME)CMDS/$(TARGET): $(OFILES)	cc $(LFLAGS) $(OFILES) $(LIBS) $(DEBUG) -f=$(EXEC)$(TARGET)	attr $(EXEC)$(TARGET) -pe	uuencode $(EXEC)$(TARGET) >-$(TARGET).uu	xshar -c -D $(HELP) makefile >$(TARGET)01	xshar -c -D $(CFILES) >$(TARGET)02	xshar -c -D $(TARGET).uu >$(TARGET)03$(OFILES): $(CFILES)