		nam		Apfel		ttl		OS-9/68000		use		<oskdefs.d>Edition equ		1Typ_Lang equ 	(Prgrm<<8)+ObjctAttr_Rev equ 	(ReEnt<<8)		psect	Apfel,Typ_Lang,Attr_Rev,Edition,8192,entryStdIn	equ		0StdOut	equ		1StdErr	equ		2		use		<graphmakros>		use		<mathmakros>		vsectxmin	ds.l	2xmax	ds.l	2ymin	ds.l	2ymax	ds.l	2cx		ds.l	2cy		ds.l	2limit	ds.l	2zwei	ds.l	2xmult	ds.l	2ymult	ds.l	2temp	ds.l	2		endsentry:			MInit		GInit		GNewScreen		MNumber	-2.75		MSave	xmin		MNumber	1.25		MSave	xmax		MNumber	-1.25		MSave	ymin		MNumber	+1.25		MSave	ymax		MNumber	0.0		MSave	cx		MNumber	0.0		MSave	cy		MNumber	640.0		MSave	temp		MLoad1	xmax		MSub	xmin		MDiv	temp		MSave	xmult		MNumber	400.0		MSave	temp		MLoad1	ymax		MSub	ymin		MDiv	temp		MSave	ymult		MNumber	4.0		MSave	limit		MNumber	2.0		MSave	zwei				GClearScreen		vsectx_lauf	ds.w	1y_lauf	ds.w	1n		ds.w	1x0		ds.l	2y0		ds.l	2x		ds.l	2y		ds.l	2x_quad	ds.l	2y_quad	ds.l	2		ends		clr		x_lauf(a6)		clr.l	d0loop1	MToReal		MMult	xmult		MAdd	xmin		MSave	x0		clr.l	d0		move	d0,y_lauf(a6)loop2	MToReal		MMult	ymult		MAdd	ymin		MSave	y0*** Anfangswert laden		MLoad1	cx		MSave	x		MLoad1	cy		MSave	y		clr		n(a6)*** WHILE-Ueberpruefung:while	cmpi	#50,n(a6)		bgt		draw_point		MLoad1	x		MMult	x		MSave	x_quad		MLoad1	y		MMult	y		MSave	y_quad		MAdd	x_quad		MGreater limit,out		MLoad1	x_quad		MSub	y_quad		MAdd	x0		MSave	temp		MLoad1	x		MMult	y		MMult	zwei		MAdd	y0		MSave	y		MLoad1	temp		MSave	x		addq	#1,n(a6)		bra		whileout		move	n(a6),d0		btst	#0,d0		beq		no_pointdraw_point		move	x_lauf(a6),d0		move	y_lauf(a6),d1		tcall	T$Graph,T$PutPixelno_point		clr.l	d0		move	y_lauf(a6),d0		addq	#1,d0		move	d0,y_lauf(a6)		cmp		#400,d0		bne	loop2		clr.l	d0		move	x_lauf(a6),d0		addq	#1,d0		move	d0,x_lauf(a6)		cmp		#640,d0		bne		loop1exit:		GSavePic	/r0/apfel.pic		moveq 	#0,d1		os9 	F$Exit		ends