******************************************************************************* GRAPH v2.1a*        ^^^ \*        |||  \__ a steht fuer Atari (fuer Anpassungen an andere Computer)* Versions-nr******************************************************************************** DIESER VORSPANN DARF BEI WEITERKOPIEREN DES SOURCES NICHT GELOESCHT WERDEN!* ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^** Copyright : Andreas Greulich, Juli 1988*			  Aarhaldenstr. 9*			  CH-3084 Wabern*			  email: v04c@cbebda3t*					 Dust in OS-9-Mailbox*							 (Kometh)*             Diese Version (2.0) ist      >>>Freeware<<<** Betriebssystem : OS-9/68000* Hardware : Atari-ST mit monochrom-Monitor* Zweck : Benutzung von Grafik unter OS-9 (s. Anleitung)* Bem.: Diese Version ist als Traphandler formuliert (Supervisor-Mode)** Anpassungen an andere Hardware sollte leicht moeglich sein. Um kein* Durcheinander mit den Versionsbezeichnungen zu erhalten, sollte die* Hardware durch einen nachgestellten Buchstaben gekennzeichnet sein* (wie oben) und folgende Liste sinngemaess ergaenzt werden. Ausserdem* sollte mir Bericht davon erstattet werden. Die Versionsnummer selbst* darf nur von mir persoenlich geaendert werden! Bei Korrekturen* und/oder Ergaenzungen, die nicht eine spezielle Hardware-Anpassung* betreffen, ist dies mir mitzuteilen. Danke.** Anmerkung: ueberall, wo maschinenabhaengige Teile stehen, ist dies* mit '#####' vermerkt (Suchen im Texteditor).** Hardware-Endungen (bitte bei weiteren Anpassungen ergaenzen) :**  a	: Atari-ST*  g	: Gepard*******************************************************************************		nam		Graph		ttl		OS9 Graphik-Routinen v2.1a, (C) A.Greulich 1988		use		<oskdefs.d>Edition equ		4Typ_Lang equ 	(TrapLib<<8)+ObjctAttr_Rev equ 	(SupStat<<8)+(ReEnt<<8)		psect	Graph,Typ_Lang,Attr_Rev,Edition,0,TrapEnt		dc.l	TrapInit		dc.l	TrapTerm******* ##### Systemspezifische Konstanten !!! ************* v_high : diese Adresse enthaelt die Basis des momentan ANGEZEIGTEN*** Bildschirminhaltes. Beim Atari ST sind in dieser und der*** UEBERNAECHSTEN das Highbyte und das Midbyte abgespeichert. Das*** Lowbyte ist immer Null, d.h., Screen beginnt immer auf einer*** 256-er Grenze. Will man also von aufrufenden Programm mit malloc*** Platz reservieren, sollte man das Lowbyte auf 0 bringen (vgl.*** Demoprogramme). Bei anderen Grafiksystemen sind die Routinen*** init und show anzupassen.v_high 	equ		$ff8201		High-Byte Video-Base*** ##### x_aufl und y_aufl geben die entsprechenden Aufloesungen minus 1 an.x_aufl	equ		639		Fuer x_Aufloesung von 640.y_aufl	equ		399		analog y_Aufloesung von 400.*** ##### line_mem : Speicher, der fuer eine Bildschirmzeile benoetigt wird.*** beim Atari ST 80 Bytes, da 640 Punkte soviel benoetigen.lin_mem	equ		80*** ##### tot_mem : totaler Speicherbedarf eines Bildschirmspeichers.*** beim Atari ST 32000, denn 640*400/8 = 32000tot_mem	equ		32000* Tabellen (Zeilenoffsets, Shiftpositionen)		vsect	remote		aligntrash	ds.b	lin_mem		'Trash-Bereich' fuer out-of-window-Befehletable	ds.l	y_aufl+1	Tabelle fuer relative Positionen der 400 Zeilenpattern	ds.w	4096		Muster fuer 256 Grauwerte (je 16 Worte)dither	ds.w	256			Dither-Matrix fuer Grauwerte		ends		vsecthtable	dc.w	%1111111111111111		dc.w	%0111111111111111		dc.w	%0011111111111111		dc.w	%0001111111111111		dc.w	%0000111111111111		dc.w	%0000011111111111		dc.w	%0000001111111111		dc.w	%0000000111111111		dc.w	%0000000011111111		dc.w	%0000000001111111		dc.w	%0000000000111111		dc.w	%0000000000011111		dc.w	%0000000000001111		dc.w	%0000000000000111		dc.w	%0000000000000011		dc.w	%0000000000000001etable	dc.w	%1000000000000000		dc.w	%1100000000000000		dc.w	%1110000000000000		dc.w	%1111000000000000		dc.w	%1111100000000000		dc.w	%1111110000000000		dc.w	%1111111000000000		dc.w	%1111111100000000		dc.w	%1111111110000000		dc.w	%1111111111000000		dc.w	%1111111111100000		dc.w	%1111111111110000		dc.w	%1111111111111000		dc.w	%1111111111111100		dc.w	%1111111111111110		dc.w	%1111111111111111* Pointer auf entsprechende tables der remote vsect:base	ds.l	1			Dort wird momentan gezeichnetptrash	ds.l	1			Pointer auf Trashbereichptable	ds.l	1			Pointer auf Offsettabelle (remote)ppats	ds.l	1			Pointer auf Anfang Grauwerte-Tabellenppat	ds.l	1			Pointer auf aktuelles Grauwertmusterpdither	ds.l	1			Pointer auf Dither-Matrixcol		ds.w	1			0:Hintergrund (loeschen), 1:Vordergrund, 2:inversdark	ds.w	1			enthaelt gesetzte Dunkelheit.wx1		ds.w	1			Window-Wertewx2		ds.w	1wy1		ds.w	1wy2		ds.w	1w_rest	ds.w	4			Sicherstellungsbereich fuer Windowscr_tab ds.l	256			Pointer auf verschiedene Screens (Lowbyte nicht 0!)nbr_scr	dc.w	0			Anfangs 0 Screens installiert.		endsTrapInit:		movem.l	(a7)+,a6-a7		rte*** Entry-Point mit Dekodierung		org	0S.d1	do.l	1S.d2	do.l	1S.d3	do.l	1S.d4	do.l	1S.d5	do.l	1S.d6	do.l	1S.d7	do.l	1S.a0	do.l	1S.a1	do.l	1S.a2	do.l	1S.a3	do.l	1S.a4	do.l	1S.a5	do.l	1S.a6	do.l	1S.func	do.w	1S.vect	do.w	1S.pc	do.l	1		vsectsys_sp	ds.l	1func_cd	ds.w	1		endsTrapEnt:		movem.l	d1-d7/a0-a5,-(a7)	sichern der Register* Lies aktuelle Zeichenparameter aus dem Parameterblock		move	(a1),d7		move	d7,col(a6)			Farbe speichern		move	2(a1),d7		move	d7,dark(a6)			darkness setzen		move	4(a1),d7		move	d7,wx1(a6)			Window speichern		move	6(a1),d7		move	d7,wy1(a6)		move	8(a1),d7		move	d7,wx2(a6)		move	10(a1),d7		move	d7,wy2(a6)		move.l	12(a1),d7		move.l	d7,ppat(a6)			aktuelles Muster speichern		move.w	16(a1),d7			Hole Pfadnummer 0 bis 255 des Screen		cmp		nbr_scr(a6),d7		Mal schauen, ob die Nummer legal ist.		bls.s	scr_ok				falls nicht, auf 0 setzen.		clr		d7scr_ok  move	d7,16(a1)		lsl.w	#2,d7				Das sind Langworte (Adressen)		lea		scr_tab(a6),a5		A5 zeigt nun auf interne Tabelle		move.l	0(a5,d7.w),d7		D7 auf den betreffenden Screen...		cmpi.l	#-1,d7				Falls -1, ist der Screen freigegeben...		bne.s	scr2_ok				dann nimm ersten Screen (Path 0).		clr		d7		move    d7,16(a1)		move.l	(a5),d7scr2_ok	clr.b	d7					Low Byte loeschen...		addi.l	#$100,d7			und Mid Byte erhoehen.		move.l	d7,base(a6)			Das ist nun die echte Basis.		move.l	20(a1),d7		move.l	d7,w_rest(a6)		move.l	24(a1),d7		move.l	d7,w_rest+4(a6)		ev. zwischengespeichertes Fenster sp.		move	S.func(a7),d7		d7 enthaelt Funktionsnummer*** Wir wechseln jetzt den Stackpointer!		move.l	a7,sys_sp(a6)		System-Stackptr sichern.		move	usp,a7				User-Stackptr verwenden.		tst		d7		bne.s	not_0		bsr		color		bra		TrapEndnot_0	cmpi	#1,d7		bne.s	not_1		bsr		darkness		bra		TrapEndnot_1	cmpi	#2,d7		bne.s	not_2		bsr		show		bra		TrapEndnot_2	cmpi	#3,d7		bne.s	not_3		bsr		window		bra		TrapEndnot_3	cmpi	#4,d7		bne.s	not_4		bsr		getwindow		bra		TrapEndnot_4	cmpi	#5,d7		bne.s	not_5		bsr		s_window		bra		TrapEndnot_5	cmpi	#6,d7		bne.s	not_6		bsr		r_window		bra		TrapEndnot_6	cmpi	#7,d7		bne.s	not_7		bsr		save		bra		TrapEndnot_7	cmpi	#8,d7		bne.s	not_8		bsr		load		bra		TrapEndnot_8	cmpi	#9,d7		bne.s	not_9		bsr		new_screen		bra		TrapEndnot_9	cmpi	#10,d7		bne.s	not_10		bsr		free_screen		bra.s	TrapEndnot_10	cmpi	#15,d7		bne.s	not_15		bsr		init		bra.s	TrapEndnot_15	cmpi	#16,d7		bne.s	not_16		bsr		clearscreen		bra.s	TrapEndnot_16	cmpi	#17,d7		bne.s	not_17		bsr		putpixel		bra.s	TrapEndnot_17	cmpi	#18,d7		bne.s	not_18		bsr		getpixel		bra.s	TrapEndnot_18	cmpi	#19,d7		bne.s	not_19		bsr		hline		bra.s	TrapEndnot_19	cmpi	#20,d7		bne.s	not_20		bsr		line		bra.s	TrapEndnot_20	cmpi	#21,d7		bne.s	not_21		bsr		circle		bra.s	TrapEndnot_21	cmpi	#22,d7		bne.s	not_22		bsr		fill_rect		bra.s	TrapEndnot_22	cmpi	#23,d7		bne.s	not_23		bsr		segment		bra.s	TrapEndnot_23	cmpi	#24,d7		bne.s	TrapEnd		bsr		copy_screenTrapEnd	move.l	sys_sp(a6),a7	Damit wieder im Super-Stackptr.		move.l	S.a1(a7),a1		move	col(a6),d7		move	d7,(a1)		move	dark(a6),d7		move	d7,2(a1)		move	wx1(a6),d7		move	d7,4(a1)		move	wy1(a6),d7		move	d7,6(a1)		move	wx2(a6),d7		move	d7,8(a1)		move	wy2(a6),d7		move	d7,10(a1)		move.l	ppat(a6),d7		move.l	d7,12(a1)		move.l	w_rest(a6),d7		move.l	d7,20(a1)		move.l	w_rest+4(a1),d7		move.l	d7,24(a1)		movem.l	(a7)+,d1-d7/a0-a7	Register zurueckspeichern		rte							und fertig.*** MAKROS**** set_line: Uebergabe Parameter 1: Zeile (0..399),* in a3 aktuelle base , in a1 tableptr --> a2: Ptr Zeilenbeginn* aendert d0.*set_line	macro		move	\1,d0		cmp		wy1(a6),d0		Pruefe, ob Zeile im Window liegt.		blt.s	ynok\@			y-Wert ist nicht ok		cmp		wy2(a6),d0		ble.s	yok\@ynok\@	move.l	ptrash(a6),a2	y nicht ok: Zeile in Trash schreiben.		bra.s	exit\@yok\@	movea.l	a3,a2			A2 zeigt auf Screenbeginn		asl.w	#2,d0			Zeilennr. mal 4 (Eintraege in table long)		adda.l	0(a1,d0.w),a2	addiere Zeilenoffset.exit\@		endm** plot: zeichne Punkt (Parameter 1: x-Wert, Parameter 2: 0,1,2 (Farbe) ). * a2: Zeilenbeginn (ev. durch set_line setzen).* aendert d0,d1,a0*plot	macro		move	\1,d0	D0: x-Koordinate		cmp		wx1(a6),d0		Pruefe, ob x-Wert in Window liegt.		blt.s	xnok\@		cmp		wx2(a6),d0		bgt.s	xnok\@		movea.l	a2,a0	A0: Pointer auf Zeilenbeginn		move	d0,d1	D1: x-Koordinate		andi.l	#$fff0,d1	D1: unterste 4 Bit ausblenden		asr		#3,d1	D1: (x-Koordinate div 16) * 2 -> Offset in Zeile (even)		adda.l	d1,a0	A0: Pointer auf angesprochene Speicherstelle		andi	#$f,d0	D0: x-Kooridnate mod 16  ( = Shiftposition)		move	#$8000,d1	D1: Maske, falls D0=0 (oberstes Bit gesetzt)		lsr		d0,d1	D1: effektive Maske fuer x-Koordinate		IFEQ \2		  eori	#$ffff,d1	Punkt loeschen (and mit inverser Maske)		  and	d1,(a0)		ELSE		  IFEQ \2-1			or		d1,(a0)	Punkt schwarz zeichnen		  ELSE			eor		d1,(a0)	Punkt invers zeichnen		  ENDC		ENDCxnok\@		endm***** ROUTINEN** Memory-Managment Routinen T$NewScreen und T$FreeScreen* Vor: a1 zeigt auf Parameterblock, a5 auf Screen-Pointer-Tabelle*		vsectpar_ptr	ds.l	1				temporaere Aufnahme von a1 (Par.-Ptr)		endsnew_screen:		move.l	a1,par_ptr(a6)	Parameter-Pointer sichern.		move.l	#(tot_mem+256),d0	Anzahl zu reservierender Bytes		os9		F$SRqMem		Reserviere den Speicher.		bcs.s	out_new			Fehlerausgang...		move	nbr_scr(a6),d0	D0: Anzahl vorhandener Tabelleneintraege		subq	#1,d0			NB: ein Screen existiert immer!sr_free	cmpi.l	#-1,(a5)+		schauen, ob er frei ist...		beq.s	scr_fd			ja: Leereintrag gefunden.		dbra	d0,sr_free		nein: weitersuchen.		addq.l	#4,a5			A5 weiterzaehlen (da spaeter -(a5)....)		addi	#1,nbr_scr(a6)	neuen Screen einrichten.scr_fd	move.l	a2,-(a5)		speichere den Screen-Pointer.		lea		scr_tab(a6),a4		suba.l	a4,a5		move.l	a5,d0		lsr		#2,d0			D0: Screen-Nummer.		move.l	par_ptr(a6),a1	A1: Parameter-Pointer.		move	d0,16(a1)		speichere sie ab.out_new	rtsfree_screen:		move	16(a1),d0		d0: Screen-Nummer		tst		d0				Screen 0 kann nicht geloescht werden!!!		beq.s	out_free		lsl		#2,d0		move.l	0(a5,d0.w),a2	a2: Zeiger auf Screen		move.l	#-1,0(a5,d0.w)	als frei markieren		clr		16(a1)			und 0 als neuen Screen zurueckgeben.		move.l	#(tot_mem+256),d0   Anzahl Bytes, die ein Screen belegt.		os9		F$SRtMem		Speicher zurueckgeben.out_free rts** Disk-Routinene*		vsectnamptr	ds.l	1pathnbr	ds.w	1		endssave:			move.l	a0,namptr(a6)		und des Pointers auf den Namen		move.b	#2,d0				Oeffnen zum Schreiben		os9		I$Open		bcc.s	openok				Neu eroeffnen, falls noch nicht existent		move.b	#2,d0				Neu eroeffnen zum Schreiben		move	#11,d1				Owner:r+w, Public:read only		move.l	namptr(a6),a0		Sicher ist sicher...		os9		I$Create		bcs.s	exitsave			falls Fehler auftrat...openok	move	d0,pathnbr(a6)		Path-nbr sichern		move.l	#tot_mem,d1			Schreibe 32000 Bytes...		move.l	base(a6),a0			aus dem Bildschirmspeicher.		os9		I$Write				abspeichern...		move	pathnbr(a6),d0		os9		I$Close				und schliessen.exitsave		rtsload:			move.l	a0,namptr(a6)		und des Pointers auf den Namen		move.b	#1,d0				Oeffnen zum Lesen		os9		I$Open		bcs.s	exitload			Fehlerausgang		move	d0,pathnbr(a6)		Path-nbr sichern		move.l	#tot_mem,d1			Schreibe 32000 Bytes...		move.l	base(a6),a0			in den Bildschirmspeicher.		os9		I$Read				lesen...		move	pathnbr(a6),d0		os9		I$Close				und schliessen.exitload		rts* color: Setzt eine Farbe (sie ist vorher in D0 abzulegen)*color	move.w	d0,col(a6)		rts** darkness: Bestimmte Helligkeit 0..255 setzen (vorher in D0 ablegen)*darkness		cmp		#255,d0		bls.s	dark_ok		move	#255,d0dark_ok	move.w	d0,dark(a6)		Grauwert speichern		move.l	ppats(a6),a0	a0: Pointer auf Muster		lsl.w	#5,d0			Offset mal 32 : Pattern-Offset...		ext.l	d0		adda.l	d0,a0			...aufaddieren		move.l	a0,ppat(a6)		und als aktuelles Muster speichern.		rts** window: Fenster, innerhalb dessen gezeichnet wird, legen.* Stack: x1.w, y1.w, x2.w, y2.w*window	tst		d0		bpl.s	wi_x1ok		clr		d0wi_x1ok	tst	d1		bpl.s	wi_y1ok		clr		d1wi_y1ok	cmp		#x_aufl,d2		ble.s	wi_x2ok		move	#x_aufl,d2wi_x2ok	cmp		#y_aufl,d3		ble.s	wi_y2ok		move	#y_aufl,d3wi_y2ok	cmp		d0,d2		bge.s	wi_xok		clr		d2		moveq	#1,d0wi_xok	cmp		d1,d3		bge.s	wi_yok		clr		d3		moveq	#1,d1wi_yok	move	d0,wx1(a6)		move	d1,wy1(a6)		move	d2,wx2(a6)		move	d3,wy2(a6)		rts** s_window : store window. Window-Werte speichern.* r_window : restore window. Window-Werte wiederherstellen.*s_window:		move.l	wx1(a6),d0		move.l	d0,w_rest(a6)		move.l	wx1+4(a6),d0		move.l	d0,w_rest+4(a6)		rtsr_window:		move.l	w_rest(a6),d0		move.l	d0,wx1(a6)		move.l	w_rest+4(a6),d0		move.l	d0,wx2(a6)		rts** init: Anfangsinitialisierung.* Setzt Pointer der vsect und initialisiert Offset-Tabelle* A1 muss auf Parameterblock zeigen.*init	clr		16(a1)			auf jeden Fall anfangs auf Originalscreen!		tst		nbr_scr(a6)		Wurde der Originalscreen schon einerichtet?		bne.s	scr_done* ###### folgende 6 Zeilen sind maschinenabhaengig!!! Ermitteln* der video-base Adresse.		movea.l	#v_high,a2		A2: Zeiger auf Video-Base, High Byte		clr.l 	d2		move.b 	(a2),d2			D2: High Byte des Video-Base		lsl.l 	#8,d2		move.b 	2(a2),d2 	    und Mid Byte (1 Byte wird uebersprungen)		lsl.l 	#8,d2			D2: Pointer auf Video-Anfang (Low Byte immer 0)		move.l	d2,base(a6)		Pointer auf Beginn sichern...		subq.l	#1,d2			da wir spaeter aufrunden werden! (Korrektur)		move.l	d2,scr_tab(a6)	nun in Pointertabelle sichern!		move	#1,nbr_scr(a6)	1 Screen ist eingerichtet (Original)scr_done		move.l	a6,d0		add.l	#trash,d0		move.l	d0,ptrash(a6)	Pointer auf Trash-Bereich		clr		wx1(a6)			Anfangswindow setzen.		clr		wy1(a6)		move	#x_aufl,wx2(a6)		move	#y_aufl,wy2(a6)		move.l	a6,d0		add.l	#pattern,d0		move.l	d0,ppats(a6)	Pointer auf globale Patterns setzen		move.l	a6,d0		add.l	#dither,d0		move.l	d0,pdither(a6)	Pointer auf Dithermatrix setzen		move.l	a6,d0		add.l	#table,d0		move.l	d0,ptable(a6)	Pointer auf table sichern		movea.l	d0,a0			A0: Zeiger auf Offsettabelle* ##### folgende 6 Zeilen muessen abgeaendert werden, falls das Bild im* Speicher nicht linear liegt, d.h., nicht eine Zeile nach der anderen.* Meistens duerfte er aber linear sein. Im Zweifelsfall probieren...* (der Apple ][ ist der einzige Composter, den ich kenne, dessen Bild* nicht linear liegt... aber er hat ja auch kein os-9!)		adda.l	#4*(y_aufl+1),a0	A0: auf Ende der Tabelle (4*400 Zeilen)		move.l	#(tot_mem-lin_mem),d0		D0: relative Pos. der letzten Zeile		move	#y_aufl,d1			D1: Schleifenzaehler (400 Zeilen)in_loop	move.l	d0,-(a0)		Eintrag in Offsettabelle schreiben		sub.l	#lin_mem,d0			1 Zeile = 80 Bytes		dbra	d1,in_loop		fuer alle 400 Zeilen* im folgenden wird die Dither-Matrix erstellt.		move.l	pdither(a6),a0	a0 zeigt auf Dither-Matrix		move.w	#0,(a0)			d[1,1]:=0		move.w	#2,2(a0)		d[1,2]:=2		move.w	#3,32(a0)		d[2,1]:=3		move.w	#1,34(a0)		d[2,2]:=1		move.l	#4,d0			enthaelt n (naechste zu erstellende Dimension)		move.l	#2,d1			und die Haelfte davon,		move.l	#64,d2			resp. das 16-fache.di_loop	movea.l	a0,a1		adda.l	d0,a1			a1 zeigt auf oberes rechtes Viertel		movea.l	a0,a2		adda.l	d2,a2			a2 zeigt auf unteres linkes Viertel		movea.l	a2,a3		adda.l	d0,a3			a3 zeigt auf unteres rechtes Viertel		move.w	d1,d3		subi.w	#1,d3			i:=n-1dith_o	move.w	d1,d4		subi.w	#1,d4			j:=n-1dith_i	move.w	d3,d5		lsl.w	#5,d5		add.w	d4,d5		add.w	d4,d5			d5:32i+2j : relat. Offset		move.w	(a0,d5.w),d6	d6: alter entry		lsl.w	#2,d6			Multiplikation mit 4		move.w	d6,(a0,d5.w)	im 1. Viertel speichern		addi.w	#1,d6		move.w	d6,(a3,d5.w)	im 4. Viertel speichern		addi.w	#1,d6		move.w	d6,(a1,d5.w)	im 2. Viertel speichern		addi.w	#1,d6		move.w	d6,(a2,d5.w)	im 3. Viertel speichern		dbra	d4,dith_i		dbra	d3,dith_o		lsl.w	#1,d0			n:=2n		lsl.w	#1,d1		lsl.w	#1,d2		cmpi.w	#32,d0			durchlaufe fuer Dimensionen 4,8 und 16.		bne.s	di_loop* Im Folgenden werden die Muster aufgrund der Dither-Matrix erstellt.		move.w	#255,d0			d0: aktuelles Muster		move.l	ppats(a6),a1	a1: Pointer auf Musterbeginn		adda.l	#8160,a1		Pointer auf letztes Muster: 32*256-32		move.l	a1,ppat(a6)		letztes Muster zugleich aktuelles.		move.w	#255,dark(a6)pa_loop	move.l	pdither(a6),a0	A0 zeigt auf Dither-Matrix		move.w	#15,d1patt_o	move.w	#15,d2		clr.w	d3				d3: eine Musterzeilepatt_i	lsr.w	#1,d3			    naechstes Bit freimachen		lsl.w	#1,d2			Vorbereitung fuer Pointer (word)		cmp.w	(a0,d2.w),d0	Teste, ob Farbe>=Dither-Eintrag		blt.s	nopoint			(nein: weiter)		ori.w	#$8000,d3		(ja: Pixel im Musterzeile setzen)nopoint	lsr.w	#1,d2			wieder normaler Zaehler		dbra	d2,patt_i		lsl.w	#1,d1			bereite d1 als Pointer fuer Pattern vor		move.w	d3,(a1,d1.w)	speichere Musterzeile im Pattern		lsr.w	#1,d1			d1 wieder normal		adda.l	#32,a0			naechste Zeile in Dither-Matrix bereitstellen		dbra	d1,patt_o		suba.l	#32,a1			Pointer auf vorhergehendes Muster setzen		dbra	d0,pa_loop		und naechstes Pattern behandeln.		move.w	#1,col(a6)			Anfangsfarbe : schwarz		rts** show: Zeige best. Grafikscreen** ##### Folgende 6 Zeilen sind maschinenabhaengig: der base-pointer wird* gesetzt, um einen beliebigen RAM-Bereich zum Video-Bereich zu machen.* je nach Hardware ist dies nicht moeglich... Ev. durch rts ersetzen,* falls Harware das nicht zulaesst.show	movea.l	#v_high,a0	Pointer auf Hardware-Register in a0		move.l	base(a6),d1	zu setzende Basis in d1		lsr.l	#8,d1		Low-Byte loeschen		move.b	d1,2(a0)	Mid-Byte setzen		lsr.l	#8,d1		move.b	d1,(a0)		High-Byte setzen		rts** clearscreen: Loesche Grafikscreen, auf dem gezeichnet wird.*clearscreen		move.l	base(a6),a0	A0 zeigt auf Screenbeginn		add.l	#tot_mem,a0	A0 zeigt auf Screenende		move.l	#(tot_mem/40)-1,d0	D7: Schleifenzaehler (800*40 Bytes)		clr.l	d1			Register loeschen		movea.l	d1,a1		movea.l	d1,a2		movea.l	d1,a3		move.l	d1,d2		move.l	d1,d3		move.l	d1,d4		move.l	d1,d5		move.l	d1,d6		move.l	d1,d7cl_loop	movem.l	d1-d7/a1-a3,-(a0)	Loesche 40 Bytes auf's Mal		dbra	d0,cl_loop		rts** putpixel: Punkt zeichnen. Stack: x.w, y.w (beruecksichtigt Farbe!)*putpixel		move	d0,d2		move	d1,d3		move.l	base(a6),a3		move.l	ptable(a6),a1		set_line d3					Zeilenwerte setzen		tst		col(a6)		bne.s	pixel1		plot	d2,0		bra.s	pixel3pixel1	cmpi	#1,col(a6)		bne.s	pixel2		plot	d2,1		bra.s	pixel3pixel2	plot	d2,2pixel3		rts** getpixel: 0 oder 1 in D0 als Resultat. Stack: x.w, y.w*getpixel		move	d1,d2		move.l	base(a6),a3		move.l	ptable(a6),a1		move	d0,d1		set_line d2			a2 zeigt auf Zeilenbeginn		move	d1,d0		andi.l	#$fff0,d0		asr		#3,d0		D0: Byte-Offset des Wortes in der Zeile		adda.l	d0,a2		A2: Ptr auf Byte, das das Pixel enthaelt		andi	#$f,d1		D1: x mod 15		move	#$8000,d0		lsr		d1,d0		D0: Bit in richtiger Position		and		(a2),d0		    mit Background anden.		rts** fill_rect: Rechteck fuellen (mit gegebener darkness resp. Farbe).* Parameter auf dem Stack (von oben nach unten):* x1.w,y1.w,x2.w,y2.w.*fill_rect:		move	d0,d4		move	d1,d5		move	d2,d6		move	d3,d7		move	d1,d2rect_l	move	d4,d0		move	d6,d1		move	d5,d2		movem	d4-d7,-(a7)		bsr.s	hline		erste 3 Parameter gerade fuer hline korrekt		movem	(a7)+,d4-d7		addq	#1,d5		Zeileninkrement		cmp		d5,d7		auf Ende testen		bge.s	rect_l		rts** hline: horizontal line (beruecksichtigt Farbe)* Parameter auf dem Stack (von oben nach unten):* x1.w, y1.w, x2.w** mhline: Makro der Hauptschleife davon. \1 gibt Farbe an (0, 1 oder 2)mhline	macro		tst		d3				Anf. und Ende im gleichen Wort?		bne.s	j1\@			ja: Anf. und Ende in gleichem Wort:		and		#$f,d1			  D1: Bitnummer 2		lsl		#1,d1		and		0(a2,d1.w),d2	  D2: Bitmuster fuer Zeilenende AND Anfang.		IFEQ	\1				  weisse Farbe		  eori	#$ffff,d2		  and	d2,(a0)		ELSE		  IFEQ	\1-1			  schwarze Farbe			eori	#$ffff,d2			and		d2,(a0)			  Zeile zuerst loeschen			eori	#$ffff,d2			and		d5,d2			or		d2,(a0)			  dann Vordergrund zeichnen		  ELSE			eor	d2,(a0)			  inverse Farbe		  ENDC		ENDC		bra.s	ext\@			  und fertig.j1\@	IFEQ	\1				  weisse Farbe		  eori	#$ffff,d2		  and	d2,(a0)		ELSE		  IFEQ	\1-1			  schwarze Farbe			eori	#$ffff,d2			and		d2,(a0)			eori	#$ffff,d2			and		d5,d2			or		d2,(a0)		  Zeile zeichnen		  ELSE			eor	d2,(a0)			  inverse Farbe		  ENDC		ENDC		subq	#1,d3			1 Wort schon gezeichnet		tst		d3				dazwischen keine vollen Worte?		bne.s	j2\@			falls nein: keine Zwischenschleife:		and		#$f,d1			  wie oben.		lsl		#1,d1		move	0(a2,d1.w),d4		IFEQ	\1				  weisse Farbe		  eori	#$ffff,d4		  and	d4,2(a0)		ELSE		  IFEQ	\1-1			  schwarze Farbe			eori	#$ffff,d4			and		d4,2(a0)			eori	#$ffff,d4			and		d5,d4			or		d4,2(a0)		  Zeile zeichnen		  ELSE			eor	d4,2(a0)			  inverse Farbe		  ENDC		ENDC		bra.s	ext\@			  und fertig.j2\@	subq	#1,d3			falls doch: Loop dazwischenlp\@	addq.l	#2,a0			  naechstes Wort		IFEQ	\1		  clr	(a0)		ELSE		  IFEQ	\1-1			move	d5,(a0)		  ELSE			eori	#$ffff,(a0)		  ENDC		ENDC		dbra	d3,lp\@		  alle volle Segmente.		and		#$f,d1		lsl		#1,d1		move	0(a2,d1.w),d4		IFEQ	\1				  weisse Farbe		  eori	#$ffff,d4		  and	d4,2(a0)		ELSE		  IFEQ	\1-1			  schwarze Farbe			eori	#$ffff,d4			and		d4,2(a0)			eori	#$ffff,d4			and		d5,d4			or		d4,2(a0)	  Zeile zeichnen		  ELSE			eor	d4,2(a0)		  inverse Farbe		  ENDC		ENDCext\@		rts		endm* eff. Entry in hline:hline		clr.l	d3				Register loeschen		move.l	d3,d4		ext.l	d0		ext.l	d1		ext.l	d2		cmp		wy1(a6),d2		Kontrolliere, ob Zeile sichtbar		blt.s	hl_out		cmp		wy2(a6),d2		ble.s	hl_vishl_out	rts						vorzeitiger Ausstieg (nicht strukturiert...)hl_vis	cmp		wx1(a6),d0		Anfangspunkt ins Window setzen		bge.s	hl_x1ok		move	wx1(a6),d0hl_x1ok	cmp		wx2(a6),d1		Endpunkt ins Window setzen		ble.s	hl_x2ok		move	wx2(a6),d1hl_x2ok	cmp		d0,d1			x1 muss kleiner als x2 sein, sonst Ende		blt.s	hl_out		move.l	base(a6),a0		A0: Pointer auf Screenbeginn		move.l	ptable(a6),a1	A1: Pointer auf Offsettable		asl		#2,d2			D2: Zeilenzahl*4 (entry in Offsettable)		adda.l	0(a1,d2.w),a0	A0: Pointer auf Zeilenbeginn		move.l	ppat(a6),a2		A2: Pointer auf Pattern		asr		#1,d2			D2: doppelte Zeilenzahl		andi	#30,d2			D2: (Zeile mod 16)*2		move	(a2,d2.w),d5	D5: Pattern-Muster der Zeile		move	d1,d3		asr		#4,d3			D3: x2 div 16		move	d0,d4		asr		#4,d4			D4: x1 div 16		sub		d4,d3			D3: Anzahl Worte		asl		#1,d4			D4: Byteoffset (even) von Linienbeginn		adda.l	d4,a0			D0: Pointer auf 1. Wort der Linie		andi	#$f,d0			D0: x1 mod 16 (Bitnummer)		lsl		#1,d0			    mal 2 (fuer htable : Wort)		lea		htable(a6),a2	A2: Pointer auf htable		move	0(a2,d0.w),d2	D2: Bitmuster fuer Zeilenbeginn		lea		etable(a6),a2	A2: Pointer auf etable		tst		col(a6)			Farbe testen:		bne.s	hl_1		mhline	0				Dies ist weisshl_1	cmpi	#1,col(a6)		bne.s	hl_2		mhline	1				Dies ist schwarzhl_2	mhline	2				Dies ist invers** circle: Zeichnen eines Kreises* Uebergabe in Stack (erstes zuoberst)* x0.w, y0.w, radius.w* Zuerst entspr. vsect, dann ein Makro fuer Mainloop, dann Routine.*		vsectx1		ds.w	1x2		ds.w	1x3		ds.w	1x4		ds.w	1y1		ds.w	1y2		ds.w	1y3		ds.w	1y4		ds.w	1		ends* circlem: Hauptloop von circle (Makro). \1 bestimmt Farbe (0, 1 oder 2)circlem	macroclp\@	move	d3,x1(a6)		x1:=x2:=x3:=x4:=x0		move	d3,x2(a6)		move	d3,x3(a6)		move	d3,x4(a6)		add		d6,x1(a6)		x1:=x0+x  1.+4. Achtel		add		d7,x2(a6)		x2:=x0+y  2.+3. Achtel		sub		d6,x3(a6)		x3:=x0-x  5.+8. Achtel		sub		d7,x4(a6)		x4:=x0-y  6.+7. Achtel		move	d4,y1(a6) 		y1:=y2:=y3:=y4:=y0		move	d4,y2(a6)		move	d4,y3(a6)		move	d4,y4(a6)		add		d6,y1(a6)		y1:=y0+x  3.+6. Achtel		add		d7,y2(a6)		y2:=y0+y  4.+5. Achtel		sub		d6,y3(a6)		y3:=y0-x  2.+7. Achtel		sub		d7,y4(a6)		y4:=y0-y  1.+8. Achtel		bclr	#31,d6			zusaetzl Flag noetig (d6 nur als word benutzt!)		cmp		d6,d7			falls x=y oder x=0 werden 2 Punkte doppelt		beq.s	ct0\@			gesetzt (Fehler im Inversmodus); deshalb in		tst		d6				diesem Fall Flag setzen, um nicht alle		bne.s	ct\@			Punkte zu zeichnen (nur 4 von 8)!ct0\@	bset	#31,d6ct\@	set_line y4(a6)		plot	x3(a6),\1		Achtel 8		btst	#31,d6		bne.s	ct1\@		plot	x1(a6),\1		ev. Achtel 1ct1\@	set_line y3(a6)		plot	x2(a6),\1		Achtel 2		btst	#31,d6		bne.s	ct2\@		plot	x4(a6),\1		ev. Achtel 7ct2\@	set_line y1(a6)		plot	x4(a6),\1		Achtel 6		btst	#31,d6		bne.s	ct3\@		plot	x2(a6),\1		ev. Achtel 3ct3\@	set_line y2(a6)		plot	x1(a6),\1		Achtel 4		btst	#31,d6		bne.s	ct4\@		plot	x3(a6),\1		ev. Achtel 5ct4\@	move	d6,d0		temp:=x		tst		d5			D<0?		bmi.s	cng\@		nein:		sub		d7,d0		asl		#2,d0		add		d0,d5		addq	#6,d5		  D := D + 4*(x-y) + 6		subq	#1,d7		  y:=y-1		bra.s	ccn\@		  ja:cng\@	asl		#2,d0		add		d0,d5		addq	#2,d5		  D := d + 4*x + 2ccn\@	addq	#1,d6		x:=x+1		cmp		d7,d6		x>y?		ble		clp\@		ja: weitermachen, sonst fertig		rts		endm* eigentliche Einsprungstelle von circle:circle:	move	d0,d3			D3: x0		move	d1,d4			D4: y0		move	d2,d5			D5: r		lea		table(a6),a1	A1: Offsettable		move.l	base(a6),a3		A3: Offset Screenbeginn		clr		d6				D6: x:=0		move	d5,d7			D7: y:=r		asl		#1,d5		neg		d5		add		#3,d5			D5: D := 3 - 2*r  (r nicht mehr benutzt)		tst		col(a6)			unterscheide die 3 Farben (sind in Makros)		beq		ci_back		cmpi	#1,col(a6)		bne		ci_inv		circlem \1ci_back	circlem	\0ci_inv	circlem	\2** line : beliebige Linie ziehen* Stackwerte: x1.w,y1.w,x2.w,y2.w* zuerst 1 Makro fuer Hauptschleife, dann entry mit Fallunterscheidungen* Registerbelegungen: d0=delta_x, d1=delta_y, d2=x1=lauf_x, d3=y1=lauf_y,* d4=x2 (low word) / pattern (high word), d5=y2, d6=epsilon, d7=u* nach Algoritmus von Bresneham** Makro linem. \1=0 heisst flach, sonst steil. \2=0 heisst aufwaerts,* sonst abwaerts (-> 4 verschiedene Lagen der Geraden).*linem	macro		clr		d6		epsilon:=0		IFEQ	\1		  move	d1,d7		  lsl	#1,d7		  sub	d0,d7	u:=2*delta_y - delta_x		ELSE		  move	d0,d7		  lsl	#1,d7		  sub	d1,d7	u:=2*delta_x - delta_y		ENDC		move.l	a3,a0		lsl		#2,d3		adda.l	0(a1,d3.w),a0	A0: Zeiger auf Zeilenbeginn		lsr		#2,d3		move	d2,a2			A2 speichert temporaer d2		andi.l	#$fff0,d2		vgl. plot-Makro		lsr		#3,d2		adda.l	d2,a0			A0: Zeiger auf aktuelles Wort von (x1,y1)		move	a2,d2			D2 aus A2 wieder restaurieren		andi	#$f,d2		swap	d4				D4, high word: Bitmaske		move	#$8000,d4		lsr		d2,d4		swap	d4				wieder low word in D4.		move	a2,d2			D2 (x1) endgueltig restaurierenllp\@	swap	d4				D4: Bitmaske		cmp		wx1(a6),d2		Pruefe, ob Punkt im Window liegt.		blt.s	all\@		cmp		wx2(a6),d2		bgt.s	all\@		cmp		wy1(a6),d3		blt.s	all\@		cmp		wy2(a6),d3		bgt.s	all\@		tst		col(a6)		bne.s	nwh\@		eori	#$ffff,d4		and		d4,(a0)		eori	#$ffff,d4		bra.s	all\@nwh\@	cmpi	#1,col(a6)		bne.s	inv\@		or		d4,(a0)			Punkt zeichnen		bra.s	all\@inv\@	eor		d4,(a0)all\@	add		d7,d6			epsilon:=epsilon+u		tst		d6		bpl.s	eps\@			epsilon<=0:		IFEQ	\1		  add	d0,d6			  epsilon:=epsilon+delta_x		ELSE					    oder		  add	d1,d6			  epsilon:=epsilon+delta_y		ENDC		bra.s	cnt\@eps\@	IFEQ	\1				epsilon>0:		  IFEQ	\2		 	adda.l	#lin_mem,a0	  y1:=y1+1			addq	#1,d3		  ELSE						oder			suba.l	#lin_mem,a0	  y1:=y1-1			subq	#1,d3		  ENDC		  sub	d0,d6			  epsilon:=epsilon-delta_x		ELSE							oder		  IFEQ	\2			addq	#1,d2			lsr		#1,d4		  x1:=x1+1 (Shiften!)			bcc.s	ok\@			move	#$8000,d4			addq.l	#2,a0		  ELSE						oder			subq	#1,d2			lsl		#1,d4		  x1:=x1-1			bcc.s	ok\@			moveq	#1,d4			subq.l	#2,a0		  ENDCok\@	  sub	d1,d6			  epsilon:=epsilon-delta_y		ENDCcnt\@	IFEQ	\1		  lsr	#1,d4			x1:=x1+1		  bcc.s	ok2\@		  move	#$8000,d4		  addq.l	#2,a0ok2\@	  addq	#1,d2		ELSE		  adda.l	#lin_mem,a0	y1:=y1+1		  addq		#1,d3		ENDC		swap	d4				d4: x2		IFEQ	\1		  cmp	d2,d4		ELSE		  cmp	d3,d5		ENDC		bhi.s	llp\@		swap	d4		cmp		wx1(a6),d2		Endpunkt: nochmals Test, ob im Fenster		blt.s	al2\@		cmp		wx2(a6),d2		bgt.s	al2\@		cmp		wy1(a6),d3		blt.s	al2\@		cmp		wy2(a6),d3		bgt.s	al2\@		tst		col(a6)		bne.s	nw2\@		eori	#$ffff,d4		and		d4,(a0)		eori	#$ffff,d4		bra.s	al2\@nw2\@	cmpi	#1,col(a6)		bne.s	in2\@		or		d4,(a0)			Punkt zeichnen		bra.s	al2\@in2\@	eor		d4,(a0)al2\@		rts		endm* eigentlicher Entry-Punktline:	move	d3,d5		D2: y2		move	d2,d4		D3: x2		move	d1,d3		D4: y1		move	d0,d2		D5: x1		move.l	base(a6),a3		A3: Pointer Screen		move.l	ptable(a6),a1	A1: Pointer Offsettabelle		move	d4,d0		sub		d2,d0			D0: delta_x:=x2-x1		move	d5,d1		sub		d3,d1			D1: delta_y:=y2-y1		tst		d0		bpl.s	posx		neg		d0				D0: abs(delta_x)posx	tst		d1		bpl.s	posy		neg		d1				D1: abs(delta_y)posy	cmp		d1,d0		blt		steep			delta_x >= delta_y: flache Gerade:		cmp		d2,d4			  Punkte so, dass x1<x2.		bhi.s	nex1		exg		d2,d4		exg		d3,d5nex1	cmp		d5,d3			  y1<=y2: Gerade nach oben		bhi		down		linem	0,0down	linem	0,1				  sonst nach unten gerichtet.steep	cmp		d3,d5			delta_x y delta_y: steile Gerade:		bhi.s	nex2			  Punkte so, dass y1<y2.		exg		d2,d4		exg		d3,d5nex2	cmp		d4,d2			  x1<=x2 : Gerade nach rechts		bhi		left		linem	1,0left	linem	1,1				  sonst nach links.** segment: Zeichnen eines Kurvensegments, gegeben durch 3 Punkte.* Parameter : x1.w y1.w x2.w y2.w x3.w y3.w*segment:		ext.l	d0		ext.l	d1		ext.l	d2		ext.l	d3		ext.l	d4		ext.l	d5		move	#20,d6		Die x/y-Koordinaten werden um 20 Bit nach		asl.l	d6,d0		links verschoben, um eine hoehere Rechen-		asl.l	d6,d1		genauigkeit zu erreichen.		asl.l	d6,d2		asl.l	d6,d3		asl.l	d6,d4		asl.l	d6,d5		move.l	d5,-(a7)		move.l	d4,-(a7)		move.l	d3,-(a7)		move.l	d2,-(a7)		move.l	d1,-(a7)		move.l	d0,-(a7)		bsr.s	r_seg		adda.l	#24,a7		rtsr_seg	movem.l	4(a7),d0-d5	D0 enthaelt x1, D5 enthaelt y3.		move	#20,d6		asr.l	d6,d0	Zuerst wieder auf Normalpixel bringen.		asr.l	d6,d1		asr.l	d6,d2		asr.l	d6,d3		asr.l	d6,d4		asr.l	d6,d5		sub		d2,d4	Berechne alle 4 Differenzen (wortweise)		sub		d3,d5		sub		d0,d2		sub		d1,d3		tst		d2		und deren Betraege nehmen		bpl.s	abs_1		neg		d2abs_1	tst		d3		bpl.s	abs_2		neg		d3abs_2	tst		d4		bpl.s	abs_3		neg		d4abs_3	tst		d5		bpl.s	abs_4		neg		d5abs_4	cmpi	#1,d2	auf Rekursionsabbruch testen (Pixelgroesse err.)		bgt.s	var_2		cmpi	#1,d3		ble.s	endrekvar_2	cmpi	#1,d4		bgt.s	rek		cmpi	#1,d5		bgt.s	rekendrek	movem.l	4(a7),d0-d5	D0 enthaelt x1, D5 enthaelt y3.		asr.l	d6,d0	Zuerst wieder auf Normalpixel bringen.		asr.l	d6,d1		asr.l	d6,d2		asr.l	d6,d3		asr.l	d6,d4		asr.l	d6,d5		movem	d0-d7,-(a7)		bsr		line		movem	(a7)+,d0-d7		move	d5,d1		move	d4,d0		movem	d0-d7,-(a7)			bsr		line		Linie Punkt2-Punkt3 zeichnen		movem	(a7)+,d0-d7		rtsrek		movem.l	4(a7),d0-d3	D0/D1: Punkt1		move.l	d2,d4		move.l	d3,d5		add.l	d0,d2		add.l	d1,d3		asr.l	#1,d2		asr.l	#1,d3		D2/D3: Punkt4		add.l	20(a7),d4		add.l	24(a7),d5		asr.l	#1,d4		asr.l	#1,d5		D4/D5: Punkt5		move.l	d2,d6		move.l	d3,d7		add.l	d4,d6		add.l	d5,d7		asr.l	#1,d6		asr.l	#1,d7		D6/D7: Punkt6		move.l	d4,-(a7)		move.l	d5,-(a7)	vorerst retten		move.l	d7,-(a7)		move.l	d6,-(a7)		movem.l	d0-d3,-(a7)		bsr		r_seg		1. rekursiver Aufruf		adda.l	#16,a7		move.l	(a7)+,d6		move.l	(a7)+,d7		move.l	(a7)+,d5		move.l	(a7)+,d4		move.l	20(a7),d2		move.l	24(a7),d3		movem.l	d2-d7,-(a7)		bsr		r_seg		2. rekursiver Aufruf		adda.l	#24,a7		rtscopy_screen		rtsgetwindow		rts*** Ende der Grafikroutinen.***TrapTerm		move.w	#1<<8+199,d1		os9		F$Exit		ends