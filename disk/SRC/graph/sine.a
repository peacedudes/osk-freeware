		nam		Sine		ttl		OS-9/68000		use		<oskdefs.d>Edition equ		1Typ_Lang equ 	(Prgrm<<8)+ObjctAttr_Rev equ 	(ReEnt<<8)		psect	Sine,Typ_Lang,Attr_Rev,Edition,8192,entryStdIn	equ		0StdOut	equ		1StdErr	equ		2		use		<graphmakros>		use		<mathmakros>entry:			MInit		GInit						Graphik-Traphandler installiert		GNewScreen		GClearScreen		vsectx_lauf	ds.l	1			x-Laufwert 0 bis 639divisor	ds.l	2prec	ds.l	2stretch	ds.l	2offset	ds.l	2		ends		MNumber	0.001		MSave	prec		MNumber	+1.0		MSave	offset		MNumber	+100.0		MSave	divisor		MNumber	+190.0		MSave	stretch		move.l	#0,d5				d5: x-Laufwert 0 bis 639loop	move.l	d5,x_lauf(a6)		speichern		move.l	d5,d0		MToReal		MDiv	divisor		MSin	prec		MAdd	offset		MMult	stretch		MRound		MToInt		add		#10,d0		move	d0,d1		move.l	x_lauf(a6),d0		lea		graphdaten(a6),a1		tcall	T$Graph,T$PutPixel		move.l	x_lauf(a6),d5		addq.l	#1,d5		cmpi.l	#640,d5		bne.s	loop		GSavePic	sine.pic		GFreeScreenexit:		moveq 	#0,d1		os9 	F$Exit		ends