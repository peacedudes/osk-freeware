****************** Definitionen fuer Graphik-Traphandler*edition	equ	2		psect	gdefs,0,0,edition,0,0****** Trap-Befehlsaufrufe***T$Graph:			equ	5T$Color:			equ	0T$Darkness:			equ	1T$Show:				equ	2T$Window:			equ	3T$GetWindow:		equ	4T$SaveWindow:		equ	5T$RestoreWindow: 	equ	6T$SavePic:			equ	7T$LoadPic:			equ	8T$NewScreen: 		equ 9T$FreeScreen: 		equ 10T$Init:				equ	15T$ClearScreen:		equ	16T$PutPixel:			equ	17T$GetPixel:			equ	18T$Hline:			equ	19T$Line:				equ	20T$Circle:			equ	21T$FillRect:			equ	22T$Segment:			equ	23T$CopyScreen:		equ	24****** Offsets im Parameterblock***			org	0O$Color:	do	1O$Darkness:	do	1O$Wind_x1:	do	1O$Wind_y1:	do	1O$Wind_x2:	do	1O$Wind_y2:	do	1O$Pattern:	do.l 1O$Base:		do.l 1O$Wind_mem:	do.l 2		ends