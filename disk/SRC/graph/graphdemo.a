		nam		GraphTest		ttl		OS9 Graphik-Routinen v0.2 Test, (C) A.Greulich 1988		use		<oskdefs.d>Edition equ		1Typ_Lang equ 	(Prgrm<<8)+ObjctAttr_Rev equ 	(ReEnt<<8)		psect	GraphTst,Typ_Lang,Attr_Rev,Edition,4096,test		use		<graphmakros>test:	GInit		GClearScreen		clr		d5			Flag, dass erster Durchlauf stattfindetagain:	GColor	#0		GFillRect	#0,#0,#639,#399		GColor	#1* Schleife zeichnen		move	#64,d0		clr		d1curve:	move	d1,d4	zuerst Versatzwerte berechnen		move	d1,d6		subi	#120,d4		addq	#5,d6		move	#519,d2		move	#639,d3		sub		d1,d2		sub		d1,d3		GSegment	d1,#200,d1,d2,#320,#200		GSegment	#320,#200,d3,d4,d3,#200		GSegment	d3,#200,d3,d2,#320,#200		GSegment	#320,#200,d6,d4,d6,#200		addq	#5,d1		dbra	d0,curve* Hintergrund in verschiedenen Grauwerten :		move.w	#399,d1loop0:	move	d1,d0		lsr		#1,d0		tcall	T$Graph,T$Darkness		GHline	#0,#639,d1		dbra	d1,loop0* Schwarzes Dreieck		GDarkness	#255		move	#320,d0		move	#320,d1		move	#300,d2loop	addi	#50,d2		GHline	d0,d1,d2		subi	#50,d2		subq	#1,d0		addq	#1,d1		dbra	d2,loop* Weisses Dreieck		GColor	#0		move	#320,d0		move	#320,d1		move.w	#250,d2loop2	addi	#75,d2		GHline	d0,d1,d2		subi	#75,d2		subq	#1,d0		addq	#1,d1		dbra	d2,loop2* invertierte Kreise		GColor	#2		move	#310,d1loop41	move	#100,d0loop4	GCircle	d1,#175,d0		dbra	d0,loop4		addq	#1,d1		cmpi	#330,d1		bne.s	loop41* inverse Linien oben und unten		GColor	#2		move	#0,d0loop5	GLine	d0,#0,#320,#200		GLine	d0,#399,#320,#200		addq	#1,d0		cmp		#640,d0		bne.s	loop5* inverse Linien links und rechts		move	#1,d0loop6	GLine	#0,d0,#320,#200		GLine	#639,d0,#320,#200		addq	#1,d0		cmp		#399,d0		bne.s	loop6* Ganzes Bild invertieren (20-mal)		GColor	#2		move	#19,d1times	move	#399,d0loop3	GHline	#0,#639,d0		dbra	d0,loop3		dbra	d1,times* Bild mit Muster fuellen (zuinnerst am hellsten)		GColor	#1		move	#0,d1fill	move	#210,d0		sub		d1,d0		tcall	T$Graph,T$Darkness		move	#399,d0		sub		d1,d0	entspricht y2		move	#639,d2		sub		d1,d2		GFillRect	d1,d1,d2,d0		addq	#1,d1		cmp		#199,d1		bne.s	fill* eventuell 2. Durchlauf starten.		tst		d5		bne.s	fin* schwarzen Rahmen zeichnen		moveq	#1,d5		GWindow	#10,#20,#370,#370		bra		againfin		moveq 	#0,d1		os9 	F$Exit		ends