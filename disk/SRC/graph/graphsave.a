		nam		GraphSave		ttl		OS-9 Demo: Speichern eines Bildes, (C) A.Greulich 1988		use		<oskdefs.d>Edition equ		1Typ_Lang equ 	(Prgrm<<8)+ObjctAttr_Rev equ 	(ReEnt<<8)		psect	GraphTst,Typ_Lang,Attr_Rev,Edition,4096,test		use		<graphmakros>*** Das Programm benutzt seinen eigenen Bildschirmspeicher, ist also*** voll multitasking-faehig!test:	GInit				Initialisierung.		GNewScreen			Nimm einen neuen Screen!		GClearScreen		clr		d5			Flag, dass erster Durchlauf stattfindetagain	GColor	#0		GFillRect	#0,#0,#639,#399		GColor	#1* Schleife zeichnen		move	#64,d0		clr		d1curve	move	d1,d4	zuerst Versatzwerte berechnen		move	d1,d6		subi	#120,d4		addq	#5,d6		move	#519,d2		move	#639,d3		sub		d1,d2		sub		d1,d3		GSegment	d1,#200,d1,d2,#320,#200		GSegment	#320,#200,d3,d4,d3,#200		GSegment	d3,#200,d3,d2,#320,#200		GSegment	#320,#200,d6,d4,d6,#200		addq	#5,d1		dbra	d0,curve*** Das gezeichnete Bild wird nun auf die Disk geschrieben (Name: bild)		GSavePic	/r0/bild*** Belegten Speicher freigeben!!!		GFreeScreenfin		moveq 	#0,d1		os9 	F$Exit		ends