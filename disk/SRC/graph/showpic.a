		nam		GraphLoad		ttl		OS-9 Laden eines Bildes von Disk, (C) A.Greulich 1988		use		<oskdefs.d>StdOut	equ		1StdIn	equ		0Edition equ		1Typ_Lang equ 	(Prgrm<<8)+ObjctAttr_Rev equ 	(ReEnt<<8)		psect	GraphTst,Typ_Lang,Attr_Rev,Edition,4096,test		use		<graphmakros>		vsectbildname		ds.b	82prompt	dc.b	"Bitte ganzen Bildnamen eingeben : ",C$CRplen	equ		*-prompt		align		endstest:	GInit		GNewScreen		move	#StdOut,d0		move.l	#plen,d1		lea		prompt(a6),a0		os9		I$WritLn						Prompt ausgeben (Namenseing.)		move	#StdIn,d0		move.l	#20,d1		lea		bildname(a6),a0		os9		I$ReadLn						Namen lesen		lea		graphdaten(a6),a1		lea		bildname(a6),a0		tcall	T$Graph,T$LoadPic				Bild von Disk laden		GShow									Bild anzeigen.		move	#StdIn,d0						Warte auf ein Return...		move.l	#20,d1		lea		bildname(a6),a0		os9		I$ReadLn						hier ist Return gekommen.		GFreeScreen								Wieder freigeben...		GShow									und alten Screen anzeigen.fin		moveq 	#0,d1		os9 	F$Exit		ends