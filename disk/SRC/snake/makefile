#       Makefile        4.1     83/07/04RDIR=	RELSODIR=   /h0/cmds/gamesCFLAGS= -gxm=2k -t=/ddLIBS=   -l=/dd/lib/usr.l -l=/dd/lib/termlib.l -l-/dd/lib/cio.lLIB=    /h0/games/snakeRELS=   snake.r move.r rand.rALL=    snake snscore./makefile:    $(ALL)	touch $*snake:  $(RELS)        chd $(RDIR); cc $(RELS) -f=snake $(LIBS)snake.r move.r : snake.hrnd.r:snscore: snscore.rbusy: busy.rinstall: all	touch $(LIB)/snakerawscoresclean:        rm -f *.r $(ALL)