all: cut pastepaste: paste.r spaste.r getopt.r	cc -ixf=paste paste.r spaste.r getopt.rcut: cut.r getopt.r	cc -ixf=cut cut.r getopt.rpaste.r: paste.c	cc -t=/dd -ixr paste.ccut.r: cut.c	cc -ixrt=/dd cut.cgetopt.r: getopt.c	cc -ixrt=/dd getopt.cspaste.r: spaste.c	cc -ixrt=/dd spaste.clint: lint_cut lint_pastelint_cut:	lint cut.c getopt.clint_paste:	lint paste.c spaste.c getopt.c