# Makefile for poker## Define HPUXs300 if you are running that OS#CFLAGS = # -DHPUXs300# # remove the -ltermcap from the line below, to compile in# System V version 2#LIBS = -lcurses -ltermcapOBJS = poker.o p_scr.o p_deal.o p_hand.o p_strat.o p_decide.o input.opoker:	$(OBJS)	cc -o poker $(OBJS) $(LIBS)poker.o:	poker.c poker.hp_scr.o:	p_scr.c poker.hp_deal.o:	p_deal.c poker.hp_strat.o:      p_strat.c poker.hp_hand.o:       p_hand.c poker.hp_decide.o:     p_decide.c poker.hinput.o:        input.c poker.h