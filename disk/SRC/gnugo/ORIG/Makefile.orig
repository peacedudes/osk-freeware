# program to play the game of Go (Wei-Chi)#	makefile modified 3/13/89 billr@saab.cna.tek.comSRC = count.c countlib.c endgame.c eval.c exambord.c findcolr.c \      findnext.c findopen.c findpatn.c findsavr.c findwinr.c \      fioe.c genmove.c getij.c getmove.c initmark.c main.c matchpat.c \      opening.c openregn.c random.c seed.c sethand.c \      showbord.c showinst.c suicide.cOBJ = count.o countlib.o endgame.o eval.o exambord.o findcolr.o \      findnext.o findopen.o findpatn.o findsavr.o findwinr.o \      fioe.o genmove.o getij.o getmove.o initmark.o main.o matchpat.o \      opening.o openregn.o random.o seed.o sethand.o \      showbord.o showinst.o suicide.oPRG = gnugoCFLAGS = -O$(PRG) : $(OBJ)	$(CC) $(OBJ) -o $@matchpat.o : patterns.c