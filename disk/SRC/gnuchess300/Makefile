.r \                    -l=$(LIBS)/ncurses.l -l=$(LIBS)/os9lib.l -m=20Kgnuchessr: gnuchess.r nondsp.r	$(CC) $(CFLAGS) -f=$(OLIB)/gnuchessr gnuchess.r nondsp.r \                  -l=$(LIBS)/os9lib.lgnuchessn: gnuchess.r nuxdsp.r	$(CC) $(CFLAGS) -f=$(OLIB)/gnuchessn gnuchess.r nuxdsp.r \                  -l=$(LIBS)/ncurses.l -l=$(LIBS)/os9lib.l -M=20Kgnuchess.r: gnuchess.c	$(CC) $(CFLAGS) "-DHASHFILE="/h0/usr/src/chess/gnuchess.hash"" -r \                    gnuchess.cuxdsp.r: uxdsp.c gnuchess.h	$(CC) $(CFLAGS) -r uxdsp.c # -t=/ddnuxdsp.r: nuxdsp.c gnuchess.h	$(CC) $(CFLAGS) -r nuxdsp.c # -t=/ddnondsp.r: nondsp.c gnuchess.h	$(CC) $(CFLAGS) -r nondsp.c #  -t=/dd -DCHESSTOOL gnuchess.r: gnuchess.h