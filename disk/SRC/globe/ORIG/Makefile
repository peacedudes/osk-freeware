# CONFIGURE: the directory where you want the executables installed.# This directory needs to be secure against modification by random users.INSTDIR =	/usr/local/bin# CONFIGURE: the directory tree where you want the man pages installed.MANDIR =	/usr/local/man# CONFIGURE: your favorite C compiler.CC =		cc# CONFIGURE: your favorite C flags.CFLAGS =	-O# CONFIGURE: your favorite linker flags.LDFLAGS =	-sall:		globeglobe:		globe.c	$(CC) $(CFLAGS) globe.c $(LDFLAGS) -o globeinstall:	all	rm -f $(INSTDIR)/globe	cp globe $(INSTDIR)	chmod 755 $(INSTDIR)/globe	rm -f $(MANDIR)/man1/globe.1	cp globe.1 $(MANDIR)/man1clean:	rm -f globe a.out core