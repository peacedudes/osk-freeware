##  Makefile for OS-9/68020 UNIX library##  Makefile Flags:#  DEBUG      print debugging informations#  STATIC     hide internal functions and data structures#  CATCH_ALL  catch all signals (incl. bus error, addr. error, CoProc..)#RDIR=RELSCFLAGS= -st=/h0 -dSTATIC -uCATCH_ALL -uDEBUG -k=2wf -ix#lib:    alarm.r ioctl.r ttyname.r isatty.r signal.r strchr.r strrchr.r\        rand.r strpbrk.r strtok.r strspn.r strcspn.r execl.r bcmp.r stat.r\        _secsince70.r perror.r        merge -b99 -z=lib_list >-/h0/lib/unix.l        attr /h0/lib/unix.l -pr        rdump -l /h0/lib/unix.l#        copy /h0/lib/unix.l -rw=/h0/lib -b99alarm.r:         alarm.cexecl.r:         execl.cioctl.r:         ioctl.c /dd/defs/unix/ioctl.hstat.r:          stat.c_secsince70.r:   _secsince70.cperror.r:        perror.cisatty.r:        isatty.cttyname.r:       ttyname.csignal.r:        signal.c /dd/defs/unix/signal.hstrchr.r:        strchr.cstrrchr.r        strrchr.cstrpbrk.r:       strpbrk.cstrtok.r:        strtok.cstrspn.r:        strspn.cstrcspn.r:       strcspn.crand.r:          rand.cbcmp.r:          bcmp.c