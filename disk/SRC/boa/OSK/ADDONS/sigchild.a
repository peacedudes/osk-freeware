    nam     os9p2    ttl     extension module for os-9********************************************************************   Extension to OS-9/68000*   This code adds additional system calls to the kernel********************************************************************   Edition History*    #    date      Comments                                    by*   ---  --------   ----------------------------------------    ---*    1   95/02/20   Created                                     gdb*    2   95/02/27   Eliminated use of reserved fields.*                   Changed to allow user-selected signal.      gdb*    3   95/03/06   Signal wasn't sent if child had already*                   exited when signal was requested.  Fixed.   gdb*    4   95/03/22   Changed from using E$Permit to E$IPrcID.    gdb********************************************************************Edition equ 4        use <defsfile>Type    set (Systm<<8)+ObjctRevs    set ((ReEnt+SupStat)<<8)+0        psect os9p2,Type,Revs,Edition,0,os9p2SIGCHLD         set 192         define a signal numberB_SIGCHLD       set 6           define a bit for SigFlg***********************************************   os9p2 - initialization for os9p2**   Passed: (a6) = system global pointer*           (a7) = system stack pointeros9p2:  move.l a1,-(a7)             save regs        lea     SrvcTbl(pc),a1      point at svc table        os9     F$SSvc              install new routine        move.l (a7)+,a1             restore regs        rts**************************************************   The service requests tableSrvcTbl:    dc.w    F$UAcct,SigChld-*-4            dc.w    -1**************************************************   SigChld - send signal on child exit**   Passed by System:*       (a3) = address of static data*       (a4) = process descriptor*       (a5) = address of caller's register stack*       (a6) = system global variables**   Passed by Caller:*       none**   Returns:*       none - chains to old DelTsk routineSigChld:cmpi.b #F$Exit,d0               process exiting?        beq.b Chld4                     yes, branch to exit handling        cmpi.b #F$UAcct,d0              process requesting a SIGCHLD signal?        bne.b Chld5                     no, returnChld2:  move.w d1,d0                    put id in d0        os9 F$GProcP                    get ptr to process descriptor        move.w P$PID(a1),d0             get parent of target process        move.w P$ID(a4),d1              get id of calling process        cmp d0,d1                       are they the same?        beq.b Chld3                     yes, set up for a signal        move.l #E$IPrcID,d1             no, return permission error        ori.b #Carry,ccr                error        rts                             returnChld3:  move.w d2,P$Acct(a1)            record the signal number requested        btst #Condemn,P$State(a1)       is process died?        beq.b Chld5                     no, just return        btst #Dead,P$State(a1)        beq.b Chld5*        cmpi.b #'-',P$QueuID(a1)        is process dead already?*        bne.b Chld5                     no, return        move.l a1,a4                    make child's proc desc the current oneChld4:  move.w P$Acct(a4),d1            get signal to send, if any        beq.b Chld5                     no signal requested, just return        move.w P$PID(a4),d0             parent still alive?        beq.b Chld5                     no, just return        os9 F$Send                      send itChld5:  andi.b #NoCarry,ccr             clear error code        rts                             return    ends