CC = uccMACROS = /h0/macrosGLOB   = /h0/defsRFLAGS = -qb -u=$(MACROS) -u=$(GLOB)LFLAGS = -kRDIR  = RELSODIR = .../CMDSOLDIR = .../LIBULIB = /h0/ucc/libSYSLIB = $(ULIB)/sys.lOSLIB = $(ULIB)/os_lib.lOSILIB = $(ULIB)/os_lib.ilOPTS = -io=i=16 -ao=i=5000 -t=5 -s=1 -io=m -r -tp=68kcCOPTFLAGS   = -eas=$(RDIR) -ill=$(OSILIB) $(OPTS) DEFOPT = -r* Default optimization (resulting size 2462)CFLAGS = $(DEFOPT)* Directly taken from PTXM archive  (resulting size 2580)CFLAGS = $(COPTFLAGS)OBJS  = sigchild.rOBJS2 = libchild.rPOBJS = ptxmglue.r ptxm.r all: sigchild ptxm lib        @echo "Ok"sigchild: $(OBJS)        chd $(RDIR); $(CC) $(LFLAGS) -l=$(SYSLIB) -fd=$(ODIR)/sigchild $(OBJS)lib: $(OBJS2)        chd $(RDIR); libgen $(OBJS2) -c -o=$(OLDIR)/libchild.lptxm: $(POBJS)        chd $(RDIR); $(CC) $(LFLAGS) -l=$(OSLIB) -l=$(SYSLIB)\        -fd=$(ODIR)/ptxm $(POBJS)ptxm_opt: $(POBJS)         chd $(RDIR); $(CC) $(LFLAGS) -l=$(OSLIB) -l=$(SYSLIB)\              -fd=$(ODIR)/ptxm $(POBJS) -tp=68k -olx=2 -olb=2