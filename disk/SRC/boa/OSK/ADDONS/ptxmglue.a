* -------------------------------------------------------------------------- ** PTXM - The path table extension module is an OS9 P2 module that allows*        user state processes to open an unlimited number of I/O paths.**        Copyright (c) 1995  Nick Holgate, Southampton, UK*                            nick@bvmltd.demon.co.uk**        The PTXM is courtesyware, it is entirly free in the hope*        that it will be of some use, but it would be a nice*        gesture to let me know if you like it enough to use it. ** -------------------------------------------------------------------------- ** Edition History**  #  Date      By   Comments* --  --------  ---  ------------------------------------------------------- **  1  16.02.95  NJH  First created.*  2  22.02.95  NJH  Oops, forgot to close open paths when process chained.*  3  27.02.95  NJH  Recoded IOMAN interface in assembler.*                    Read and write buffers are validated with F$ChkMem.*                    Maintain I/O byte counters in process descriptor.*                    Open paths closed on F$Fork in case a previous*                    process that used the new process id terminated*                    abnormally.*                    Remaining 'C' handlers now get pointer to register image*                    at call to PTXM, rather than callers register image and*                    process descriptor pointers.*Edition		equ 3 	current edition numberRevision	set	0 psect ptxmglue,(Systm<<8)+Objct,((ReEnt+SupStat)<<8)+Revision,Edition,0,Entry use <oskdefs.d> use <os9svc.m>* -------------------------------------------------------------------------- *** Known limitations:* ~~~~~~~~~~~~~~~~~* 1. Only the first 32 open paths may be inherited by a child process.* 2. To be able to close user paths that are left open when the a process*    terminates it is necessary to install a user accounting routine.*    As OS-9 provides no way to install multiple user accounting routines*    any user accounting software installed after the PTXM will likely*    replace the PTXM's handler, however provided the PTXM is installed after*    any other user accounting software there should be no problem, as the PTXM*    calls the user accounting handler that it replaced before it returns*    to the kernel.* 3. Will not work with OS-9 V3 ATOMIC kernel, as there is no user accounting*    support.** -------------------------------------------------------------------------- *Copyright:	dc.b "PTXM"	dc.b "[==============]"	dc.b "[ Copyright    ]"	dc.b "[     (c) 1995 ]"	dc.b "[ Nick Holgate ]"	dc.b "[==============]"* -------------------------------------------------------------------------- ** Entry Point** Passed:  (a3) = static storage pointer*          (a6) = system globals pointer** Returns:	nothing** Error Return:	 d1.w = error code*				 (cc) = carry set** Destroys:	 d0 & d1** caller allocates our static storage*Entry:	move.l	a6,-(a7)					save register	move.l	a3,d0						pass static storage pointer	move.l	a6,d1						pass system globals pointer	move.l	a3,a6						set 'C' global storage	bsr		initialise					intialise	move.l	(a7)+,a6					restore register	move.w	d0,d1						get error code	neg.w	d0							set carry if non-zero	rts* -------------------------------------------------------------------------- ** Dispatch entry:** Passed:  (a3) = private static storage*          (a4) = process descriptor pointer*          (a5) = caller's registers*          (a6) = system global data ptr** Returns:	nothing** Error Return:	 d1.w = error code*				 (cc) = carry set** Destroys:	 d0, d1, a0 & a6*U_create:	movem.l	d0-d7/a0-a6,-(a7)			save call register image	lea		u_create(pc),a0				get function pointer	bra.s	go_cU_open:	movem.l	d0-d7/a0-a6,-(a7)			save call register image	lea		u_open(pc),a0				get function pointer	bra.s	go_c* -------------------------------------------------------------------------- *U_dup:	movem.l	d0-d7/a0-a6,-(a7)			save call register image	lea		u_dup(pc),a0				get function pointer*	bra.s	go_c* -------------------------------------------------------------------------- ** call:**	error_code (*a0)(REGISTERS *reg)*go_c	move.l	a7,d0						pass register image	move.l	a3,a6						set 'C' global storage	jsr		(a0)						call handler	lea.l	(4*15)(a7),a7				discard callers register image	move.w	d0,d1						get error code	neg.w	d0							set carry if non-zero	rts* -------------------------------------------------------------------------- *U_seek:	bsr		get_sys_path				convert to system path number	bcs.s	seek_done					branch if error	move.l	D_SysDis(a6),a3				get system dispatch table pointer	move.l	I$Seek+I$Seek+I$Seek+I$Seek(a3),-(a7)		set dispatch address	move.l	I$Seek+I$Seek+I$Seek+I$Seek+1024(a3),a3		get data pointerseek_done	rts* -------------------------------------------------------------------------- *U_read:	move.l	a0,a2						get data pointer	move.l	d1,d0						get count	moveq.l	#Write_,d1					get permission	OS9svc	F$ChkMem					check permission	bcs.s	read_done					branch if no permission	move.l	R$d0(a5),d0					restore register	bsr		get_sys_path				convert to system path number	bcs.s	read_done					branch if error	OS9svc	I$Read						read the data	bcs.s	read_done					branch if error	move.l	R$d1(a5),d1					get number of bytes read	add.l	d1,P$RBytes(a4)				keep running total	bcc.s	read_done					overflow?	moveq	#-1,d1						get maximum	move.l	d1,P$RBytes(a4)				set maximumread_done	rts	* -------------------------------------------------------------------------- *U_readln:	move.l	a0,a2						get data pointer	move.l	d1,d0						get count	moveq.l	#Write_,d1					get permission	OS9svc	F$ChkMem					check permission	bcs.s	readln_done					branch if no permission	move.l	R$d0(a5),d0					restore register	bsr		get_sys_path				convert to system path number	bcs.s	readln_done					branch if error	OS9svc	I$ReadLn					read the data	bcs.s	readln_done					branch if error	move.l	R$d1(a5),d1					get number of bytes read	add.l	d1,P$RBytes(a4)				keep running total	bcc.s	readln_done					overflow?	moveq	#-1,d1						get maximum	move.l	d1,P$RBytes(a4)				set maximumreadln_done	rts* -------------------------------------------------------------------------- *U_write:	move.l	a0,a2						get data pointer	move.l	d1,d0						get count	moveq.l	#Read_,d1					get permission	OS9svc	F$ChkMem					check permission	bcs		write_done					branch if no permission	move.l	R$d0(a5),d0					restore register	bsr		get_sys_path				convert to system path number	bcs.s	write_done					branch if error	OS9svc	I$Write						write the data	bcs.s	write_done					branch if error	move.l	R$d1(a5),d1					get number of bytes read	add.l	d1,P$WBytes(a4)				keep running total	bcc.s	write_done					overflow?	moveq	#-1,d1						get maximum	move.l	d1,P$WBytes(a4)				set maximumwrite_done	rts* -------------------------------------------------------------------------- *U_writeln:	move.l	a0,a2						get data pointer	move.l	d1,d0						get count	moveq.l	#Read_,d1					get permission	OS9svc	F$ChkMem					check permission	bcs		writeln_done				branch if no permission	move.l	R$d0(a5),d0					restore register	bsr		get_sys_path				convert to system path number	bcs.s	writeln_done				branch if error	OS9svc	I$WritLn					write the data	bcs.s	writeln_done				branch if error	move.l	R$d1(a5),d1					get number of bytes read	add.l	d1,P$WBytes(a4)				keep running total	bcc.s	writeln_done				overflow?	moveq	#-1,d1						get maximum	move.l	d1,P$WBytes(a4)				set maximumwriteln_done	rts* -------------------------------------------------------------------------- *U_getstt:	bsr		get_sys_path				convert to system path number	bcs.s	getstt_done					branch if error	move.l	D_SysDis(a6),a3				get system dispatch table pointer	move.l	I$GetStt+I$GetStt+I$GetStt+I$GetStt(a3),-(a7)	set dispatch address	move.l	I$GetStt+I$GetStt+I$GetStt+I$GetStt+1024(a3),a3	get data pointergetstt_done	rts* -------------------------------------------------------------------------- *U_setstt:	bsr		get_sys_path				convert to system path number	bcs.s	setstt_done					branch if error	move.l	D_SysDis(a6),a3				get system dispatch table pointer	move.l	I$SetStt+I$SetStt+I$SetStt+I$SetStt(a3),-(a7)	set dispatch address	move.l	I$SetStt+I$SetStt+I$SetStt+I$SetStt+1024(a3),a3	get data pointersetstt_done	rts* -------------------------------------------------------------------------- *U_close:	bsr		get_sys_path				convert to system path number	bcs.s	close_done					branch if error	movem.l	d0-d1/a6,-(a7)				save registers	move.w	R$d0+2(a5),d0				get user extended path number	move.l	a4,d1						get process decriptor pointer	move.l	a3,a6						set up 'C' global storage	bsr		free_user_path_slot			release it	movem.l	(a7)+,d0-d1/a6				restore registers	move.l	D_SysDis(a6),a3				get system dispatch table pointer	move.l	I$Close+I$Close+I$Close+I$Close(a3),-(a7)	set dispatch address	move.l	I$Close+I$Close+I$Close+I$Close+1024(a3),a3	get data pointerclose_done	rts* -------------------------------------------------------------------------- ** Call user accounting handler to clean up when process terminates,* then redispatch to original user accounting handler. This allows* us to operate with other user accounting modules, (provided we are* installed last or that the other modules call our handler when they* are done). If this function is not called, the system may appear to* operate correctly, but if a process terminates or is killed, any path* with a path number of 32 or greater will be left open with a corresponding* memory loss associated with the data structures to manage the extend* path table.** Passed:	d0.w	= function code (F$Exit, F$Fork or F$Chain)*			(a0)	= process descriptor pointer*			(a3)	= private static storage*			(a6)	= system global data ptrU_uacct:	move.l	uacct_handler(a3),-(a7)		set original dispatch address	movem.l	d0-d1/a6,-(a7)				save registers	move.l	a3,a6						set 'C' global storage	ext.l	d0							make function code long	move.l	a0,d1						get process descriptor pointer	bsr		u_uacct						void u_uacct(int func, procid *proc)	move.l	uacct_dataptr(a6),a3		get original data pointer	movem.l	(a7)+,d0-d1/a6				restore registers	rts									dispatch to original handler* -------------------------------------------------------------------------- ** error_code i_create(REGISTERS *callregs)*i_create:	movem.l	d1-d7/a0-a6,-(a7)			save registers	move.l	d0,a0						get pointer to register image	movem.l	(a0),d0-d7/a0-a6			get registers as of call to P2	OS9svc	I$Create					do it	bcs.s	i_create_error				branch if error	moveq	#0,d0						say successi_create_done	movem.l	(a7)+,d1-d7/a0-a6			restore register	rts									returni_create_error	moveq	#0,d0						clear register	move.w	d1,d0						get error code	bra.s	i_create_done				return it* -------------------------------------------------------------------------- ** error_code i_open(REGISTERS *callregs)*i_open:	movem.l	d1-d7/a0-a6,-(a7)			save registers	move.l	d0,a0						get pointer to register image	movem.l	(a0),d0-d7/a0-a6			get registers as of call to P2	OS9svc	I$Open						do it	bcs.s	i_open_error				branch if error	moveq	#0,d0						say successi_open_done	movem.l	(a7)+,d1-d7/a0-a6			restore register	rts									returni_open_error	moveq	#0,d0						clear register	move.w	d1,d0						get error code	bra.s	i_open_done					return it ends* -----------------------------< end of file >------------------------------ *