# Add -DVERBOSE_CGI_LOGS if you want logs of CGI program start and stop timesISPLIB = /h0/isp/libULIB = /h0/ucc/libCLIB = /h0/lib   # UltraC 1.1 haven't math.l libraryISPDEFS = /h0/isp/defsMYDEFS = DEFSRDIR = RELSODIR = ../CMDSCDEBUG = # -DVERBOSE_CGI_LOGS -g -D_OSK_DEBUGLDEBUG = #-gCFLAGS = -v=$(ISPDEFS) -v=$(MYDEFS) -eas=$(RDIR) $(CDEBUG)CMDARGS = $(CFLAGS)# Need -a (ANSI-mode) to make ucc define _STDC_ macro CMD2ARGS = $(CFLAGS) -aLFLAGS = -l=../LIB/os9.l\         -l=$(ISPLIB)/socklib.l -l=$(ISPLIB)/netdb.l\         -l=$(ULIB)/sys_clib.l -l=$(CLIB)/math.l\         -olM=30 -l=../LIB/libchild.l $(LDEBUG) -i# Change these if necessaryYACC = yaccLEX = flexCC = uccOBJS =  alias.r boa.r cgi.r config.r get.r hash.r log.r queue.r\        read.r request.r response.r signals.r util.r y.tab.r lex.yy.rall:	boa    @echo "BOA HTTP server compiled OK"# boa dependenciesboa: $(OBJS)	chd $(RDIR); $(CC) -fd=$(ODIR)/$* $(LFLAGS) $(OBJS)# parser dependenciesy.tab.r:	y.tab.c globals.h	$(CC) $(CMD2ARGS) y.tab.c -Dlinty.tab.c y.tab.h:	boa_grammar.y	$(YACC) -d -l boa_grammar.ylex.yy.r:	lex.yy.c y.tab.h	$(CC) $(CMD2ARGS) lex.yy.clex.yy.c:	boa_lexer.l	$(LEX) -L boa_lexer.l# boa at largealias.r:	alias.c boa.h globals.h defines.h	$(CC) $(CMDARGS) alias.c boa.r:	boa.c boa.h globals.h defines.h	$(CC) $(CMDARGS) boa.ccgi.r:	cgi.c boa.h globals.h defines.h	$(CC) $(CMDARGS) cgi.c -o=0 #-io=i=16 -io=mconfig.r:	config.c boa.h globals.h defines.h	$(CC) $(CMDARGS) config.cget.r:	get.c boa.h globals.h defines.h	$(CC) $(CMDARGS) get.c hash.r:	hash.c boa.h globals.h defines.h	$(CC) $(CMDARGS) hash.clog.r:	log.c boa.h globals.h defines.h	$(CC) $(CMDARGS) log.cqueue.r:	queue.c boa.h globals.h defines.h	$(CC) $(CMDARGS) queue.cread.r:	read.c boa.h globals.h defines.h	$(CC) $(CMDARGS) read.crequest.r:	request.c boa.h globals.h defines.h	$(CC) $(CMDARGS) request.cresponse.r:	response.c boa.h globals.h defines.h	$(CC) $(CMDARGS) response.csignals.r:	signals.c boa.h globals.h defines.h	$(CC) $(CMDARGS) signals.cutil.r:	util.c boa.h globals.h defines.h	$(CC) $(CMDARGS) util.cdebug.r:	debug.c boa.h globals.h defines.h	$(CC) $(CMDARGS) debug.c