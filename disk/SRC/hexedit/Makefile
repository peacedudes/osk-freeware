# This is the makefile for building hex on OS-9 # It works with gmake and gcc and needs the TOP os9.l and curses.l libraries##CC = gcc -DOS9 -g -DDEBUG=1 -T/r0CC = gcc -DOS9   -T/r0#CC = gcc -DOS9 -O -T/r0# Adjust this for your directory structureCFLAGS = -I/dd/top/defs -I/dd/top/os9lib/defs -I/dd/top/os9lib/defs/sysLIBS =  -l/dd/top/lib/ncurses.l -l/dd/top/os9lib/lib/os9.l -l/dd/top/os9lib/lib/os9.l # Curses needs the extra stack spaceLDFLAGS = -s 16hex:	hex.r	$(CC) $(LDFLAGS)  -o hex $(LIBS)  hex.r