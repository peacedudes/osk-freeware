##  Makefile for OS-9/680x0 UNIX library##  Makefile Flags:#  DEBUG      print debugging informations#  STATIC     hide internal functions and data structures#  CATCH_ALL  catch all signals (incl. bus error, addr. error, CoProc..)#TEMP    = /r0RDIR    = RELSSDIR    = .# Standard Microware CCOPTS   = -qst=$(TEMP) -k=0RFLAG   = -r# Ultra-C#COPTS   = -bc -td=$(TEMP)#RFLAG   = -easCDEFS   = -dSTATIC -dCATCH_ALL -uDEBUG -dOSKCHDRS   = -v=../HDRSCFLAGS  = $(COPTS) $(CDEFS) $(CHDRS)UTILDIR = /DD/CMDSLIB     = osk.lCC      = cc# if you wish to use the included password routinesPWENT  = pwent.r pwcryp.r# else if you DO NOT want the included password routines#PWENT  =RFILES = stat.r umask.r gettz.r $(PWENT) stricmp.r# gethname.r popen.r make.date        : $(RFILES)     chd $(RDIR) ; merge -b99 $(RFILES) >-.../$(LIB)    attr -pr ../$(LIB)    rdump -l ../$(LIB)    touch make.dategethname.r      : gethname.cstricmp.r       : stricmp.cpopen.r         : popen.cstat.r          : stat.cumask.r         : umask.cgettz.r         : gettz.cpwcryp.r        : pwcryp.cpwent.r         : pwent.c    cc $(CFLAGS) $(RFLAG)=$(RDIR) -dLPWD pwent.c