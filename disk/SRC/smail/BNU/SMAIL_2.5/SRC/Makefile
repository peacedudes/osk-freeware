# OSK Makefile for smail (not a installation makefile)## @(#)Makefile	2.5 (smail) 9/15/87RM      = delCD      = chdCP      = copy -rCHMOD   = attrALLEXEC = -epeTEMP    = /r0# if you want to use 'cio' or 'csl'TRAPLIB = -i# no traplib#TRAPLIB =# Stock Microware CCOPTS   = -qt=$(TEMP) -s $(TRAPLIB)RFLAG   = -rMEM     = -M=24KLOPTS   = $(MEM) $(TRAPLIB)# Ultra C#COPTS   = -bc -td=$(TEMP) -r $(TRAPLIB)#RFLAG   = -eas#MEM     = -ol=M=24K#LOPTS   = -bc $(MEM) $(TRAPLIB)CDEFS   = -dOSK -dLPWDCHDRS   = -v=HDRSDBGFLAG = #DBGFLAG= -g# For Microware CCCC      = ccCFLAGS  = $(COPTS) $(CDEFS) $(CHDRS) $(DBGFLAG)# I believe both blarslib.l or os9lib.l can replace unix.lLIBS    = -l=../osk.l#LIBS    =LFLAGS  = $(LOPTS) $(LIBS) $(DBGFLAG)# if you don't have getoptGETOPT = getopt.r# if you DO have getopt#GETOPT  =TFILES	=	Makefile.osk Makefile.unix Patchlevel SHFILES	=	make.cf.sh mkfnames.sh pathproc.sh smail.prompt template.cfHDRS	=	defs.h sysexits.hSFILES	=	alias.c deliver.c getopt.c getpath.c headers.c lcasep.c main.c \         	map.c misc.c nptx.c pw.c resolve.c str.c svbinmail.cRDIR    =	RELSDESTDIR =	/DD/ETC/CMDSODIR    =	../BINOBJECTS =	main.r map.r resolve.r deliver.r misc.r alias.r pw.r \			headers.r getpath.r str.r $(GETOPT) gethname.r popen.r \			stat.r umask.r gettz.r pwent.r stricmp.rOFILES  =	smail rmail lcasep nptx pwparse# pathproc mkfnames svbinmail## we can't use svbinmail with most OSK uucp setups# pathproc and mkfnames aren't needed for us eithermake.date   : $(OFILES)    touch make.datesmail       :  $(OBJECTS)    $(CD) $(RDIR) ; $(CC) $(OBJECTS) $(LFLAGS) -fd=../$(ODIR)/smail    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@rmail       :  $(OBJECTS)    $(CD) $(RDIR) ; $(CC) $(OBJECTS) $(LFLAGS) -fd=../$(ODIR)/rmail    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@$(OBJECTS)	:	defs.hsvbinmail   :   svbinmail.r	$(CD) $(RDIR) ; $(CC) $(LFLAGS) svbinmail.r -fd=../$(ODIR)/$@	@$(CHMOD) $(ALLEXEC) $(ODIR)/$@lcasep      :   lcasep.r $(GETOPT)    $(CD) $(RDIR) ; $(CC) $(LFLAGS) lcasep.r $(GETOPT) -fd=../$(ODIR)/$@    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@pathproc    :	pathproc.sh    $(CP) pathproc.sh $(ODIR)/$@    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@mkfnames    :	mkfnames.sh    $(CP) mkfnames.sh $(ODIR)/$@    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@NOBJS = str.r pwent.r stricmp.rnptx        :	nptx.r $(NOBJS)    $(CD) $(RDIR) ; $(CC) $(LFLAGS) nptx.r pw.r $(NOBJS) -fd=../$(ODIR)/$@    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@nptx.r      :	nptx.c    $(CC) $(CFLAGS) nptx.c $(RFLAG)=$(RDIR)pwparse     :	nptx2.r pwparse.r $(NOBJS)    $(CD) $(RDIR) ; $(CC) $(LFLAGS) nptx2.r pwparse.r $(NOBJS) -fd=../$(ODIR)/$@    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@pwparse.r      :	pw.c    copy pw.c -r pwparse.c    $(CC) $(CFLAGS) pwparse.c -DPWPARSE $(RFLAG)=$(RDIR)    del pwparse.cnptx2.r      :	nptx.c    copy nptx.c -r nptx2.c    $(CC) $(CFLAGS) nptx2.c -DPWPARSE $(RFLAG)=$(RDIR)    del nptx2.cinstall     :	all    $(CD) $(ODIR) ; $(CP) $(OFILES) -w=$(DESTDIR)	@echo read doc/Installclean       :    $(CD) $(RDIR) ; $(RM) *.rclobber     :	clean    $(CD) $(ODIR) ; $(RM) $(OFILES)bundle		:	$(CD) .. ; lha -ur smail2_5.lzh *    $(RM) ../smail2_5.bakgethname.r : OSK/gethname.cpopen.r    : OSK/popen.cstat.r     : OSK/stat.cumask.r    : OSK/umask.cgettz.r    : OSK/gettz.cpwent.r    : OSK/pwent.cstricmp.r  : OSK/stricmp.cmisc.r      : misc.c nptx.r      : nptx.csvbinmail.r : svbinmail.c defs.hlcasep.r    : lcasep.cpw.r        : pw.cgetopt.r    : getopt.c