# OSK Makefile for smail (not a installation makefile)## @(#)Makefile	2.5 (smail) 9/15/87RM      = delCD      = chdCP      = copy -rCHMOD   = attrALLEXEC = -epeTEMP    = /r0DBGFLAG =#DBGFLAG= -gi# For Microware CCCC      = ccCFLAGS  = -v=/dd/defs/unix -qt=$(TEMP) $(DBGFLAG)# I believe both blarslib.l or os9lib.l can replace unix.lLIBS    = -l=/dd/lib/unix.lMEM     = -m=24KLFLAGS  = $(DBGFLAG) $(LIBS) $(MEM)# if you don't have getopt#GETOPT = getopt.r# if you DO have getoptGETOPT  =TFILES	=	Makefile.osk Makefile.unix Patchlevel SHFILES	=	make.cf.sh mkfnames.sh pathproc.sh smail.prompt template.cfHDRS	=	defs.h sysexits.hSFILES	=	alias.c deliver.c getopt.c getpath.c headers.c lcasep.c main.c \         	map.c misc.c nptx.c pw.c resolve.c str.c svbinmail.cRDIR    =	relsDESTDIR =	/DD/ETC/CMDSODIR    =	../BINOBJECTS =	main.r map.r resolve.r deliver.r misc.r alias.r pw.r \			headers.r getpath.r str.r $(GETOPT)OFILES  =	smail rmail lcasep nptx pwparse# pathproc mkfnames svbinmail## we can't use svbinmail with most OSK uucp setups# pathproc and mkfnames aren't needed for us eitherall         : $(OFILES)smail       :   $(OBJECTS)    $(CD) $(RDIR) ; $(CC) $(OBJECTS) $(LFLAGS) -fd=../$(ODIR)/smail    $(CHMOD) $(ALLEXEC) $(ODIR)/$@rmail       :   $(OBJECTS)    $(CD) $(RDIR) ; $(CC) $(OBJECTS) $(LFLAGS) -fd=../$(ODIR)/rmail    @@$(CHMOD) $(ALLEXEC) $(ODIR)/$@$(OBJECTS)	:	defs.hsvbinmail   :   svbinmail.r	$(CD) $(RDIR) ; $(CC) $(LFLAGS) svbinmail.r -fd=../$(ODIR)/$@	@$(CHMOD) $(ALLEXEC) $(ODIR)/$@lcasep      :   lcasep.r    $(CD) $(RDIR) ; $(CC) $(LFLAGS) lcasep.r -fd=../$(ODIR)/$@    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@pathproc    :	pathproc.sh    $(CP) pathproc.sh $(ODIR)/$@    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@mkfnames    :	mkfnames.sh    $(CP) mkfnames.sh $(ODIR)/$@    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@nptx        :	nptx.r pw.r str.r    $(CD) $(RDIR) ; $(CC) $(LFLAGS) nptx.r pw.r str.r -fd=../$(ODIR)/$@    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@nptx.r      :	nptx.c    $(CC) $(CFLAGS) nptx.c -r=$(RDIR)pwparse     :	nptx2.r pwparse.r str.r    $(CD) $(RDIR) ; $(CC) $(LFLAGS) nptx2.r pwparse.r str.r -fd=../$(ODIR)/$@    @$(CHMOD) $(ALLEXEC) $(ODIR)/$@pwparse.r      :	pw.c    copy pw.c -r pwparse.c    $(CC) $(CFLAGS) pwparse.c -DPWPARSE -r=$(RDIR)    del pwparse.cnptx2.r      :	nptx.c    copy nptx.c -r nptx2.c    $(CC) $(CFLAGS) nptx2.c -DPWPARSE -r=$(RDIR)    del nptx2.cinstall     :	all	@echo read doc/Installclean       :    $(CD) $(RDIR) ; $(RM) *.rclobber     :	clean    $(CD) $(ODIR) ; $(RM) $(OFILES)bundle		:	$(CD) .. ; lha -ur smail2_5.lzh *    $(RM) ../smail2_5.bakmisc.r      : misc.c nptx.r      : nptx.csvbinmail.r : svbinmail.c defs.hlcasep.r    : lcasep.cpw.r        : pw.cgetopt.r    : getopt.c