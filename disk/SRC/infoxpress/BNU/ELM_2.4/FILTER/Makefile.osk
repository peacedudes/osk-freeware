## @(#)$Id: Makefile.SH,v 5.4 1993/02/03 16:22:06 syd Exp $#  Makefile for the Elm system filter program##         (C) Copyright 1986,1987, by Dave Taylor#         (C) Copyright 1988-1992, USENET Community Trust## Bug reports, patches, comments, suggestions should be sent to:##	Syd Weinstein - elm@DSI.COM#			dsinc!elm##  $Log: Makefile.SH,v $# Revision 5.4  1993/02/03  16:22:06  syd# add libutil.a as strtokq moved to lib## Revision 5.3  1993/01/27  19:40:01  syd# I implemented a change to filter's default verbose message format# including %x %X style date and time along with username# From: mark@drd.com (Mark Lawrence)## Revision 5.2  1992/11/15  01:40:43  syd# Add regexp processing to filter.# Add execc operator# From: Jan Djarv <Jan.Djarv@sa.erisoft.se>## Revision 5.1  1992/10/03  22:18:09  syd# Initial checkin as of 2.4 Release at PL0### Variables#	Variables established by ConfigureTEMP		=	/dd/TMPRDIR		=	RELSG   		=	# -gCD  		=	chdCHMOD		=	attrCP  		=	copyDEST		=	/dd/usr/cmdsECHO		=	echoLIB 		=	-l=../../lib/libutil.lLIB2		= 	-l=../../OSK/osk.l#-l=/dd/lib/unix.l # os9lib.lLIBS		=	-l=/dd/lib/termlib.l # -l=/dd/lib/gdbm.lMAILERMODE	=	-penpwprewrMAKE		=	makeMV  		=	renameOPTIMIZE	=	-O=1RM  		= 	del -fTOUCH		=	touchCC			=	cc# Ultra  C#COMPAT		=	-mode=compat# Standard Microware CCOMPAT		=# Standard Microware COPTIMIZE	=	-O=1CCFLAGS		=	$(COMPAT) -k0l -qt=$(TEMP)LFLAGS		=	$(COMPAT) -m=6K -k0l -q $(G) $(LIB) $(LIB2) $(LIBS)# Ultra  C#OPTIMIZE	=#CCFLAGS		=	-bc -td=$(TEMP)#LFLAGS		=	-bc -ol=M=6K -i $(G) $(LIB) $(LIB2) $(LIBS)DACSNET		=#	Variables you may want to manually edit#		If you want debug logging then you'll#		want to uncomment the following.DEBUG		=	-DDEBUG#	Other variablesBIN 		=	../binINCLDIR		=	../hdrsSTDDEFS		=	-v=$(INCLDIR) -v=../OSK/DEFS# -v=/dd/DEFS/UNIXCFLAGS		=	$(CCFLAGS) $(OPTIMIZE) $(STDDEFS) $(DEBUG) $(DACSNET) LINTFLAGS	=	-v=$(INCLDIR).c.r:     $(CC) $(CFLAGS) -r=$(RDIR) $*.c# Definitions of variablesFILTER_SRC	= \	actions.c buffer.c filter.c	lock.c parse.c regexp.c rules.c	\	summarize.c utils.c audit.cFILTER_OBJ	= \	actions.r buffer.r filter.r lock.r parse.r regexp.r rules.r	\	summarize.r utils.r	audit.r# Standard targetsall:		$(BIN)/filter    touch make.date		install:	$(DEST)/filteruninstall:		$(RM) $(DEST)/filterclean:			$(CD) $(RDIR) ; $(RM) $(FILTER_OBJ)	$(RM) $(BIN)/filter# Dependencies and rules#	Dependencies of header files upon other header files they include.PRECIOUS:		$(INCLDIR)/defs.h $(INCLDIR)/elm.h $(INCLDIR)/headers.h$(INCLDIR)/defs.h:	../config.h $(INCLDIR)/sysdefs.h	$(TOUCH) $@$(INCLDIR)/elm.h:	$(INCLDIR)/curses.h $(INCLDIR)/defs.h	$(TOUCH) $@$(INCLDIR)/headers.h:	$(INCLDIR)/curses.h $(INCLDIR)/defs.h	$(TOUCH) $@#	Dependencies and rules for C object filesactions.r:		$(INCLDIR)/defs.h $(INCLDIR)/filter.h $(INCLDIR)/s_filter.hfilter.r:		$(INCLDIR)/defs.h $(INCLDIR)/filter.h $(INCLDIR)/s_filter.hlock.r:			$(INCLDIR)/defs.h $(INCLDIR)/filter.h $(INCLDIR)/s_filter.hparse.r:		$(INCLDIR)/defs.h $(INCLDIR)/filter.h $(INCLDIR)/s_filter.hregexp.r:		$(INCLDIR)/defs.h $(INCLDIR)/regexp.hrules.r:		$(INCLDIR)/defs.h $(INCLDIR)/filter.h $(INCLDIR)/s_filter.hsummarize.r:	$(INCLDIR)/defs.h $(INCLDIR)/filter.h $(INCLDIR)/s_filter.hutils.r:		$(INCLDIR)/defs.h $(INCLDIR)/filter.h $(INCLDIR)/s_filter.haudit.r:		$(INCLDIR)/defs.h $(INCLDIR)/filter.h $(INCLDIR)/s_filter.h#	Dependencies and rules for compiling programs#$(BIN)/filter:	$& $(FILTER_OBJ) ../lib/libutil.l$(BIN)/filter:	$(FILTER_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(FILTER_OBJ)#	Dependencies and rules for installing programs from bin directory$(DEST)/filter:		$(BIN)/filter	-$(MV) $(DEST)/filter $(DEST)/filter.old#	-$(RM) $(DEST)/filter.old	$(CP) $(BIN)/filter $@	$(CHMOD) $(MAILERMODE) $@