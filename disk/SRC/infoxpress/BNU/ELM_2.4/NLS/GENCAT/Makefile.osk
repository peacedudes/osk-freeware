###CFLAGS= -g -DSYSV -I../../hdrsCFLAGS=  -qt=/r0 -v=../../hdrs -v=/dd/defs/unixLFLAGS= -l=/dd/lib/unix.lall:	gencat dumpmsggencat:	gencat.r genlib.r	$(CC) $(LFLAGS) -f=$@ gencat.r genlib.rdumpmsg: dumpmsg.r genlib.r	$(CC) $(LFLAGS) -f=$@ dumpmsg.r genlib.rclean:	rm -f gencat.r genlib.r dumpmsg.r *~ *.bak gencat dumpmsggencat.r:	gencat.hgenlib.r:	gencat.h ../../hdrs/msgcat.h