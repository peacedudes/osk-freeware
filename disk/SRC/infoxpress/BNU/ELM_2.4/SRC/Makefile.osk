# $Id: Makefile.SH,v 5.1 1992/10/03 22:58:40 syd Exp $##  Makefile for the ELM mail program.##	Copyright (c) 1988-1992 USENET Community Trust#	Copyright (c) 1986,1987 Dave Taylor## Bug reports, patches, comments, suggestions should be sent to:##	Syd Weinstein - elm@DSI.COM#			dsinc!elm## $Log: Makefile.SH,v $# Revision 5.1  1992/10/03  22:58:40  syd# Initial checkin as of 2.4 Release at PL0## Revision 5.1  1992/10/03  22:58:40  syd# Initial checkin as of 2.4 Release at PL0## ## Variables#	Variables established by ConfigureTEMP		=	/r0#TEMP		=	.G   		=	# -gCHMOD		=	attrCP  		=	copyCD			=	chdDEST		=	/dd/usr/cmdsECHO		=	echoCGFXLIB		=	-l=/dd/lib/cgfx.lLIB 		=	-l=../../lib/libutil.lLIB2		=	-l=../../osk/osk.l#LIB2		=	-l=/dd/lib_old/unix.lLIBS		=	-l=/dd/lib/termlib.lCC			=	cc#COMPAT		=	-mode=compatCOMPAT		=# /dd/lib/pwd.r /dd/lib/signal.rMAILERMODE	=	-x -penpwprewrMV  		=	renameRM  		= 	del -fTOUCH		=	touchTAGS		=	ctagsRDIR		=	RELS#	Variables you may want to manually edit#		If you want debug logging then you'll#		want to uncomment the following.DEBUG		=	-DDEBUG $(G)#		If you're on an ACSnet system (Australia) then#		you'll want to uncomment the following.# DACSNET	=	-DACSNETDACSNET		=#       if you have the Kwindows CGFX.L#		This is only for the _gs_scsz() call to get the screen size,#       If call is unimplemented the TERMCAP size is used.#KWINDOWS	=	-DKWINDOWS# Normal Microware CRFLAG		=	-rOPTIMIZE	=   -O=1CCFLAGS		=	$(COMPAT) -k0l -qt=$(TEMP)LFLAGS		=	$(COMPAT) -i -m=50 -k0l $(LIB) $(LIB2) $(CGFXLIB) $(LIBS)# Ultra C#CPUSW       =	-tp=cpu340#RFLAG		=	-eas#OPTIMIZE	=   # optimize defaults to level 7#CCFLAGS		=	-b -be=pl -be=m=0 -td=$(TEMP) $(CPUSW)#LFLAGS		=	-b -bc -ol=a -ol=M=50k $(LIB) $(LIB2) $(CGFXLIB) $(LIBS)#	Other general variablesCDEFS		=	$(DEBUG) $(DACSNET) $(KWINDOWS) -dOSKBIN 		=	../binINCLDIR		=	../hdrsSTDHDRS		=   -v=$(INCLDIR) -v=../OSK/DEFS#-v=/dd/defs/UNIXCFLAGS		=	$(CCFLAGS) $(OPTIMIZE) $(STDHDRS) $(CDEFS).c.r:    $(CC) $(CFLAGS) $(RFLAG)=$(RDIR) $*.c#  ListsELM_SRC = \	addr_util.c alias.c aliaslib.c args.c a_edit.c a_screen.c \	a_sort.c a_quit.c bouncebk.c builtin.c calendar.c curses.c \	date.c delete.c edit.c editmsg.c elm.c encode.c exitprog.c \	expires.c file.c file_util.c fileio.c find_alias.c forms.c \	hdrconfg.c help.c in_utils.c init.c leavembox.c lock.c limit.c \	mailmsg1.c mailmsg2.c mime.c mkhdrs.c newmbox.c options.c \	out_utils.c pattern.c pmalloc.c quit.c read_rc.c remail.c \	reply.c returnadd.c save_opts.c savecopy.c screen.c showmsg.c \	showmsg_c.c signals.c softkeys.c sort.c string2.c strings.c \	syscall.c utils.c wildcards.c wordwrap.cELM_OBJ1 = \	addr_util.r alias.r aliaslib.r args.r a_edit.r a_screen.r \	a_sort.r a_quit.r bouncebk.r builtin.r calendar.r curses.r \	date.r delete.r edit.r editmsg.r elm.r encode.r exitprog.r \	expires.r file.r file_util.r fileio.r find_alias.r forms.r \	hdrconfg.r help.r in_utils.r init.r leavembox.rELM_OBJ2 = \	lock.r limit.r mailmsg1.r mailmsg2.r mime.r mkhdrs.r newmbox.r \	options.r out_utils.r pattern.r pmalloc.r quit.r read_rc.r \	remail.r reply.r returnadd.r save_opts.r savecopy.r screen.r \	showmsg.r showmsg_c.r signals.r softkeys.r sort.r string2.r \	strings.r syscall.r utils.r wildcards.r wordwrap.r# Standard targetsall:		$(BIN)/elm    touch make.dateinstall:	$(DEST)/elmuninstall:			$(RM) $(DEST)/elmtags:		$(TAGS) $(ELM_SRC)clean:				$(CD) $(RDIR) ; $(RM) $(ELM_OBJ1)		#(CD) $(RDIR) ; $(RM) $(ELM_OBJ2)		$(RM) $(BIN)/elm# Dependencies and rules#	Dependencies of header files upon other header files they include.PRECIOUS:		$(INCLDIR)/defs.h $(INCLDIR)/elm.h $(INCLDIR)/headers.h$(INCLDIR)/defs.h:	../config.h $(INCLDIR)/sysdefs.h	$(TOUCH) $@$(INCLDIR)/elm.h:	$(INCLDIR)/curses.h $(INCLDIR)/defs.h	$(TOUCH) $@$(INCLDIR)/headers.h:	$(INCLDIR)/curses.h $(INCLDIR)/defs.h	$(TOUCH) $@#	Dependencies of C object filesaddr_util.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.halias.r:	$(INCLDIR)/headers.h $(INCLDIR)/ndbz.h $(INCLDIR)/s_aliases.h $(INCLDIR)/s_elm.haliaslib.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hargs.r:		$(INCLDIR)/headers.h $(INCLDIR)/patchlevel.h $(INCLDIR)/s_elm.ha_edit.r:	$(INCLDIR)/headers.ha_screen.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_aliases.ha_sort.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_aliases.ha_quit.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_aliases.hbouncebk.r:	$(INCLDIR)/headers.hbuiltin.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hcalendar.r:	$(INCLDIR)/headers.hcurses.r:	$(INCLDIR)/headers.hdate.r:		$(INCLDIR)/headers.hdelete.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hedit.r:		$(INCLDIR)/headers.h $(INCLDIR)/s_elm.heditmsg.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.helm.r:		$(INCLDIR)/elm.h $(INCLDIR)/s_elm.hencode.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hexitprog.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hexpires.r:	$(INCLDIR)/headers.hfile.r:		$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hfile_util.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hfileio.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hfind_alias.r:	$(INCLDIR)/headers.hforms.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hhdrconfg.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hhelp.r:		$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hin_utils.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hinit.r:		$(INCLDIR)/headers.h $(INCLDIR)/patchlevel.h $(INCLDIR)/s_elm.hleavembox.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hlock.r:		$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hlimit.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.h $(INCLDIR)/s_aliases.hmailmsg1.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hmailmsg2.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hmkhdrs.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hmime.r:		$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hnewmbox.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hoptions.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.h $(INCLDIR)/save_opts.hout_utils.r:	$(INCLDIR)/headers.hpattern.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hpmalloc.r:	$(INCLDIR)/defs.h $(INCLDIR)/s_elm.hquit.r:		$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hread_rc.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.h $(INCLDIR)/save_opts.hremail.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hreply.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hreturnadd.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hsave_opts.r:	$(INCLDIR)/save_opts.h $(INCLDIR)/headers.h $(INCLDIR)/s_elmrc.hsavecopy.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hscreen.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hshowmsg.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hshowmsg_c.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hsignals.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hsoftkeys.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hsort.r:		$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hstring2.r:	$(INCLDIR)/headers.hstrings.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hsyscall.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hutils.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hwildcards.r:	$(INCLDIR)/defs.hwordwrap.r:	$(INCLDIR)/headers.h#	Dependencies and rules for compiling C programs#$(BIN)/elm:	$& elm_obj.r ../lib/libutil.l$(BIN)/elm:	 elm_obj.l ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ elm_obj.r#	Dependencies and rules for installing C programs$(DEST)/elm:	$(BIN)/elm	-$(MV) $@ $@.old	$(CP) $(BIN)/elm $@	$(CHMOD) $(MAILERMODE) $@elm_obj.l : $(ELM_OBJ1) $(ELM_OBJ2)	$(CD) $(RDIR) ; merge -b100 $(ELM_OBJ1) >-elm_obj.r	$(CD) $(RDIR) ; merge -b100 $(ELM_OBJ2) >+elm_obj.r