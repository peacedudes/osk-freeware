# @(#)$Id: Makefile.SH,v 5.1 1992/10/04 00:46:45 syd Exp $##  Makefile for the Elm system utilities##         (C) Copyright 1986,1987, by Dave Taylor#         (C) Copyright 1988-1992, USENET Community Trust## Bug reports, patches, comments, suggestions should be sent to:##	Syd Weinstein - elm@DSI.COM#			dsinc!elm## $Log: Makefile.SH,v $# Revision 5.1  1992/10/04  00:46:45  syd# Initial checkin as of 2.4 Release at PL0## ## Variables#	Variables established by ConfigureTEMP		=	/r0CD  		=	chdRDIR		=	RelsG			=	# -gCHMOD		=	attrCP  		=	copyDEST		=	/dd/USR/CMDSECHO		=	echoLN  		=	copyMAKE		=	makeMV  		=	renameRM  		= 	del -fTOUCH		=	touchCC			=	ccLIB 		=	-l=../../lib/libutil.lLIB2		= 	-l=../../osk/osk.l#LIB2		= 	-l=/dd/lib/unix.l# Ultra C#COMPAT		=	-mode=compat# Standard Microware CCOMPAT		=# Standard Microware COPTIMIZE	=	-O=1CCFLAGS		=	$(COMPAT) -k0l -qt=$(TEMP)LFLAGS		=	$(COMPAT) -i -m=6K $(G) $(LIB) $(LIB2)# Ultra C#OPTIMIZE	=#CCFLAGS		=	-bc -td=$(TEMP)#LFLAGS		=	-bc -ol=M=6K -i $(G) $(LIB) $(LIB2)DACSNET		=#	Variables you may want to manually edit#		If you want debug logging then you'll#		want to uncomment the following.DEBUG		=	-DDEBUG $(G)#	Other general variablesBIN 		=	../binINCLDIR		=	../hdrsSTDDEFS		=	-v=$(INCLDIR) -v=../OSK/DEFS#-v=/dd/defs/UNIXCFLAGS		=	$(CCFLAGS) $(OPTIMIZE) $(STDDEFS) $(DEBUG) $(DACSNET).c.r:    $(CC) $(CFLAGS) $*.c -r=$(RDIR)#	Lists#		List of installed programs - excludes wnewmail and nfrm,#		which are handled separately# Shell scriptsINSTALL_LIST	=	\			$(DEST)/answer		\			$(DEST)/arepdaemon	\			$(DEST)/autoreply	\			$(DEST)/fastmail	\			$(DEST)/frm 		\			$(DEST)/listalias	\			$(DEST)/newalias	\			$(DEST)/newmail		\			$(DEST)/readmsg 	\			$(DEST)/checkalias	\			$(DEST)/printmail	\			$(DEST)/messages#		List of programs in bin directory# Shell ScriptsBINARY_LIST	=	\			$(BIN)/answer	\			$(BIN)/arepdaemon 	\			$(BIN)/autoreply	\			$(BIN)/fastmail		\			$(BIN)/frm  		\			$(BIN)/listalias	\			$(BIN)/newalias		\			$(BIN)/newmail		\			$(BIN)/readmsg 		\			$(BIN)/checkalias	\			$(BIN)/printmail	\			$(BIN)/messages#	List of all object files in all util programs (used in parallel makes)# 			UTIL_OBJ	=	\			answer.r		\			arepdaem.r		\			autoreply.r		\			fastmail.r		\			from.r			\			listalias.r		\			newalias.r		\			newmail.r		\			readmsg.r		\            checkalias.r	\			printmail.r		\			messages.r#	Lists of source and object files for each C programANSWER_SRC	=	answer.cANSWER_OBJ	=	answer.rAREPDAEMON_SRC	=	arepdaem.cAREPDAEMON_OBJ	=	arepdaem.rAUTOREPLY_SRC	=	autoreply.cAUTOREPLY_OBJ	=	autoreply.rFASTMAIL_SRC	=	fastmail.cFASTMAIL_OBJ	=	fastmail.rFRM_SRC		=	from.cFRM_OBJ		=	from.rLISTALIAS_SRC	=	listalias.cLISTALIAS_OBJ	=	listalias.rNEWALIAS_SRC	=	newalias.cNEWALIAS_OBJ	=	newalias.rNEWMAIL_SRC	=	newmail.cNEWMAIL_OBJ	=	newmail.rREADMSG_SRC	=	readmsg.cREADMSG_OBJ	=	readmsg.rCHECKALIAS_SRC	=	checkalias.cCHECKALIAS_OBJ	=	checkalias.rPRINTMAIL_SRC	=	printmail.cPRINTMAIL_OBJ	=	printmail.rMESSAGES_SRC	=	messages.cMESSAGES_OBJ	=	messages.r# Standard targetsall:			$(UTIL_OBJ) $(BINARY_LIST)	$(TOUCH) make.date#	This unusual target enables highly efficial compilation of object files#	on systems that have the parallel make feature.#objects:		$& $(UTIL_OBJ)#	for those without#objects:		$(UTIL_OBJ)install:		$(INSTALL_LIST) $(DEST)/wnewmail $(DEST)/nfrmuninstall:			$(RM) $(INSTALL_LIST) $(DEST)/wnewmail $(DEST)/nfrmclean:				$(CD) $(RDIR) ; $(RM) $(UTIL_OBJ)	$(RM) $(BINARY_LIST)# Dependencies and rules#	Dependencies and rules for compiling and linting C programs.PRECIOUS:		$(INCLDIR)/defs.h $(INCLDIR)/elm.h \	$(INCLDIR)/headers.h ../lib/libutil.l $(BIN)/answer:		$(ANSWER_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(ANSWER_OBJ)$(BIN)/arepdaemon:	$(AREPDAEMON_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(AREPDAEMON_OBJ)$(BIN)/autoreply:	$(AUTOREPLY_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(AUTOREPLY_OBJ)$(BIN)/fastmail:	$(FASTMAIL_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(FASTMAIL_OBJ)$(BIN)/frm:		$(FRM_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(FRM_OBJ)$(BIN)/listalias:	$(LISTALIAS_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(LISTALIAS_OBJ)$(BIN)/newalias:	$(NEWALIAS_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(NEWALIAS_OBJ)$(BIN)/newmail:		$(NEWMAIL_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(NEWMAIL_OBJ)$(BIN)/readmsg:		$(READMSG_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(READMSG_OBJ)$(BIN)/checkalias:	$(CHECKALIAS_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(CHECKALIAS_OBJ)$(BIN)/printmail:	$(PRINTMAIL_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(PRINTMAIL_OBJ)$(BIN)/messages:	$(MESSAGES_OBJ) ../lib/libutil.l	$(CD) $(RDIR) ; $(CC) $(LFLAGS) -fd=../$@ $(MESSAGES_OBJ)#	Rules to make shell scripts in bin directory#	Dependencies of header files upon other header files they include$(INCLDIR)/defs.h:	../config_osk.h $(INCLDIR)/sysdefs_osk.h	$(TOUCH) $@$(INCLDIR)/elmutil.h:	$(INCLDIR)/curses.h $(INCLDIR)/defs.h	$(TOUCH) $@$(INCLDIR)/headers.h:	$(INCLDIR)/curses.h $(INCLDIR)/defs.h	$(TOUCH) $@#	Dependencies of C object filesanswer.r:	$(INCLDIR)/ndbz.h $(INCLDIR)/elmutil.h $(INCLDIR)/s_answer.harepdaem.r:	$(INCLDIR)/elmutil.hautoreply.r:	$(INCLDIR)/elmutil.hfastmail.r:	$(INCLDIR)/patchlevel.h $(INCLDIR)/elmutil.h $(INCLDIR)/s_fastmail.hfrom.r:		$(INCLDIR)/elmutil.h $(INCLDIR)/s_from.hlistalias.r:	$(INCLDIR)/elmutil.h $(INCLDIR)/sysdefs_osk.h $(INCLDIR)/s_newalias.hnewalias.r:	$(INCLDIR)/elmutil.h $(INCLDIR)/sysdefs_osk.h $(INCLDIR)/s_newalias.hnewmail.r:	$(INCLDIR)/elmutil.h $(INCLDIR)/s_newmail.hreadmsg.r:	$(INCLDIR)/elmutil.h $(INCLDIR)/s_readmsg.hmessages.r:	$(INCLDIR)/elmutil.h#	Dependencies and rules for installing programs from bin directory$(DEST)/answer:		$(BIN)/answer	-$(MV) $@ answer.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwnprewr $@$(DEST)/arepdaemon:	$(BIN)/arepdaemon	-$(MV) $@ arepdaem.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwnprewr $@$(DEST)/autoreply:	$(BIN)/autoreply	-$(MV) $@ autoreply.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwnprewr $@$(DEST)/checkalias:	$(BIN)/checkalias	-$(MV) $@ checkalias.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwprewr $@$(DEST)/fastmail:	$(BIN)/fastmail	-$(MV) $@ fastmail.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwprewr $@$(DEST)/frm:		$(BIN)/frm	-$(MV) $@ frm.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwprewr $@$(DEST)/nfrm:		$(DEST)/frm	-$(MV) $@ nfrm.old	-$(RM) $@.old	$(RM) $@	$(LN) $? $@$(DEST)/listalias:	$(BIN)/listalias	-$(MV) $@ listalias.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwprewr $@$(DEST)/messages:	$(BIN)/messages	-$(MV) $@ messages.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwprewr $@$(DEST)/newalias:	$(BIN)/newalias	-$(MV) $@ newalias.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwprewr $@$(DEST)/newmail:	$(BIN)/newmail	-$(MV) $@ newmail.old	-$(RM) $@.old	$(RM) $@	$(CP) $? $@	$(CHMOD)  $@$(DEST)/printmail:	$(BIN)/printmail	-$(MV) $@ printmail.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwprewr $@$(DEST)/readmsg:	$(BIN)/readmsg	-$(MV) $@ readmsg.old	-$(RM) $@.old	$(CP) $? $@	$(CHMOD) -penpwprewr $@$(DEST)/wnewmail:	$(DEST)/newmail	-$(MV) $@ wnmail.old	-$(RM) $@.old	$(RM) $@	$(LN) $? $@