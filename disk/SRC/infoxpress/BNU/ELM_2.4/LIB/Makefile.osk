# $Id: Makefile.SH,v 5.10 1993/02/03 16:21:03 syd Exp $##  Makefile for the ELM mail program.##	Copyright (c) 1986,1987 Dave Taylor#	Copyright (c) 1988-1992 USENET Community Trust## Bug reports, patches, comments, suggestions should be sent to:##	Syd Weinstein - elm@DSI.COM#			dsinc!elm## $Log: Makefile.SH,v $# Revision 5.10  1993/02/03  16:21:03  syd# add strtokq# From: Syd## Revision 5.9  1993/01/27  18:52:03  syd# add strftime as optional component## Revision 5.8  1993/01/19  05:07:05  syd# Trim erroreous extra log entry# From: Syd## Revision 5.7  1993/01/19  04:47:12  syd# Significant changes to provide consistent Date and From_ header# cracking.  Overhauled date utilities and moved into library.  Moved# real_from() into library.  Modified frm, newmail, and readmsg utilities# to use library version of real_from().  Moved get_word() from Elm# source into library.  Added new library routines atonum() and strfcpy().# Fixed trailing backslash bug in len_next().# From: chip@chinacat.unicom.com (Chip Rosenthal)## Revision 5.6  1992/12/24  19:33:59  syd# tune dependency list further# From: Syd## Revision 5.5  1992/12/24  19:30:46  syd# Make all object depend on config.h, so a reconfig for a new# arch in shared sources (or copied sources) forces a recompile# of all modules.# From: Syd## Revision 5.4  1992/12/20  05:15:58  syd# Add a c)hange alias, -u and -t options to listalias to list only user# and only system aliases respectively.# From: "Robert L. Howard" <robert.howard@matd.gatech.edu>## Revision 5.3  1992/11/07  20:07:23  syd# Add header_cmp routine# From: Syd## Revision 5.2  1992/10/27  01:43:40  syd# Move posix_signal to lib directory# From: tom@osf.org## Revision 5.1  1992/10/03  22:41:36  syd# Initial checkin as of 2.4 Release at PL0#### Variables#	Variables established by Configure#TEMP		=	/r0TEMP		=	.G   		=	# -gAR  		=	mergeCD  		=	chdRANLIB		=	rdump -lRM  		= 	del -fTOUCH		=	touchTAGS		=	ctagsCC			=	cc# Normal Microware CCOMPAT		=OPTIMIZE	=	-O=1CCFLAGS		=	$(COMPAT) -k0l -qt=$(TEMP) $(OPTIMIZE)# Ultra C#COMPAT		= -mode=compat#CPUSW       =	-tp=cpu32#OPTIMIZE	=#CCFLAGS		=	-b -td=$(TEMP) $(OPTIMIZE) $(CPUSW)#these are brokenMCSRC		=	mcprt.c mcprtlib.cMCOBJ		=	mcprt.r mcprtlib.rSTRSRC		=	strstr.cSTROBJ		=	strstr.rFTIMESRC	=	strftime.cFTIMEOBJ	=	strftime.r#	Variables you may want to manually edit#		If you want debug logging then you'll#		want to uncomment the following.DEBUG		=	-DDEBUG $(G)#		If you're on an ACSnet system (Australia) then#		you'll want to uncomment the following.# DACSNET	=	-DACSNETDACSNET	=#		If you're don't have a <fcntl.h> them#		you'll want to uncomment the following.# OSKMODES	=	-DOSKMODESOSKMODES	=#	Other general variablesCDEFS		=	$(DEBUG) $(DACSNET) $(OSKMODES) -dOSKINCLDIR		=	../hdrsSTDHDRS     =   -v=$(INCLDIR) -v=../OSK/DEFS#-v=/dd/DEFS/UNIXCFLAGS		=	$(CCFLAGS) $(STDHDRS) $(CDEFS)RDIR        =	RELS#.c.r:#   $(CC) $(CFLAGS) -r=$(RDIR) $*.c# 	Lists# This is broken#			$(MCSRC)LIB_SRC = \	add_site.c addrmchusr.c atonum.c mk_aliases.c aliasdb.c \	mk_lockname.c can_access.c can_open.c chloc.c date_util.c \	errno.c expand.c figadrssee.c gcos_name.c getaddrfrm.c \	getarpdate.c getfullnam.c getword.c header_cmp.c in_list.c \	in_string.c istrcmp.c ldstate.c len_next.c mail_gets.c msgcat.c \	move_left.c ndbz.c okay_addr.c opt_utils.c parsarpdat.c \	parsarpwho.c posixsig.c putenv.c realfrom.c qstrings.c \	remfirstwd.c reverse.c shiftlower.c strfcpy.c strincmp.c \	striparens.c $(STRSRC) $(FTIMESRC) strtokq.c tail_of.c validname.cLIB_OBJ1	=	\	add_site.r mk_aliases.r aliasdb.r mk_lockname.r can_access.r	\	can_open.r chloc.r errno.r expand.r figadrssee.r getaddrfrm.r	\	getarpdate.r getfullnam.r gcos_name.r header_cmp.r in_string.r	\	ldstate.r mail_gets.r msgcat.r ndbz.r okay_addr.r in_list.r		\	parsarpdat.r realfrom.r# This is broken# $(MCOBJ)LIB_OBJ2	=	\	getword.r date_util.r istrcmp.r atonum.r parsarpwho.r posixsig.r	\	putenv.r remfirstwd.r move_left.r shiftlower.r strincmp.r			\	striparens.r $(STROBJ) $(FTIMEOBJ) strtokq.r opt_utils.r		\	strfcpy.r tail_of.r reverse.r addrmchusr.r qstrings.r len_next.r	\	validname.rall:			libutil.l    touch make.date#install:		libutil.l#uninstall:		libutil.llibutil.l:		$(LIB_OBJ1) $(LIB_OBJ2)	$(CD) $(RDIR) ; $(AR) -b100 $(LIB_OBJ1) >-../$@	$(CD) $(RDIR) ; $(AR) -b100 $(LIB_OBJ2) >+../$@	$(RANLIB) $@tags:	$(TAGS) $(LIB_SRC)clean:			$(CD) $(RDIR) ; $(RM) $(LIB_OBJ1)	$(CD) $(RDIR) ; $(RM) $(LIB_OBJ2)	$(RM) libutil.l# Dependencies and rules#	Dependencies of header files upon other header files they include.PRECIOUS:		$(INCLDIR)/defs.h $(INCLDIR)/elm.h $(INCLDIR)/headers.h$(INCLDIR)/defs.h:	../config.h $(INCLDIR)/sysdefs.h			$(TOUCH) $@$(INCLDIR)/elm.h:	$(INCLDIR)/curses.h $(INCLDIR)/defs.h			$(TOUCH) $@$(INCLDIR)/headers.h:	$(INCLDIR)/curses.h $(INCLDIR)/defs.h			$(TOUCH) $@#	Dependencies of C object filesadd_site.r:	$(INCLDIR)/headers.haddrmchusr.r:	$(INCLDIR)/headers.hmk_aliases.r:	$(INCLDIR)/headers.h $(INCLDIR)/ndbz.h $(INCLDIR)/s_newalias.haliasdb.r:	$(INCLDIR)/headers.h $(INCLDIR)/ndbz.hmk_lockname.r:	$(INCLDIR)/headers.hcan_access.r:	$(INCLDIR)/headers.hcan_open.r:	$(INCLDIR)/headers.hchloc.r:	$(INCLDIR)/headers.hdate_util.r:	$(INCLDIR)/headers.herrno.r:	$(INCLDIR)/headers.hexpand.r:	$(INCLDIR)/defs.h $(INCLDIR)/s_elmrc.hfigadrssee.r:	$(INCLDIR)/headers.hgcos_name.r:	$(INCLDIR)/headers.hgetaddrfrm.r:	$(INCLDIR)/headers.hgetarpdate.r:	$(INCLDIR)/headers.hgetfullnam.r:	$(INCLDIR)/headers.hgetword.r:	$(INCLDIR)/defs.hheader_cmp.r:	$(INCLDIR)/headers.hin_list.r:	$(INCLDIR)/headers.hin_string.r:	$(INCLDIR)/headers.histrcmp.r:	$(INCLDIR)/headers.hldstate.r:	$(INCLDIR)/defs.hlen_next.r:	../config_osk.hmail_gets.r:	../config_osk.hmcprt.r:	$(INCLDIR)/mcprt.h $(INCLDIR)/mcprtlib.hmcprtlib.r:	$(INCLDIR)/mcprtlib.h $(INCLDIR)/nl_types.hmove_left.r:	$(INCLDIR)/headers.hmsgcat.r:	$(INCLDIR)/msgcat.h $(INCLDIR)/nl_types.hndbz.r:		$(INCLDIR)/headers.h $(INCLDIR)/ndbz.hokay_addr.r:	$(INCLDIR)/headers.hopt_utils.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_error.hparsarpdat.r:	$(INCLDIR)/headers.hparsarpwho.r:	$(INCLDIR)/headers.hposixsig.r:	$(INCLDIR)/headers.hputenv.r:	$(INCLDIR)/headers.hrealfrom.r:	$(INCLDIR)/headers.h $(INCLDIR)/s_elm.hqstrings.r:	../config_osk.hremfirstwd.r:	$(INCLDIR)/headers.hreverse.r:	$(INCLDIR)/headers.hshiftlower.r:	$(INCLDIR)/headers.hstrincmp.r:	$(INCLDIR)/headers.hstriparens.r:	$(INCLDIR)/headers.hstrstr.r:	$(INCLDIR)/headers.hstrtokq.r:	$(INCLDIR)/headers.htail_of.r:	$(INCLDIR)/headers.hvalidname.r:	$(INCLDIR)/defs.h