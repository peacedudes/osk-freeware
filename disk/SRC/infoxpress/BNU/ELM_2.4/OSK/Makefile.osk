##  Makefile for OS-9/680x0 UNIX library##  Makefile Flags:#  DEBUG      print debugging informations#  STATIC     hide internal functions and data structures#  CATCH_ALL  catch all signals (incl. bus error, addr. error, CoProc..)#TEMP    = /r0RDIR    = RELSSDIR    = .# Ultra-C#COMPAT  = -mode=compat# Standard Microware OR Gnu CCOMPAT	=COPTS   = $(COMPAT) -qst=$(TEMP) -k=0RFLAG   = -rSIGNAL  = signal.rSIGSRC  = signal.cALARM   = alarm.rALRMSRC = alarm.c#COPTS   = -b -be=m=0 -be=pl -td=$(TEMP) -i#RFLAG   = -eas#SIGNAL  = signal.r#SIGSRC  = signal.a#ALARM   = alarm.r#ALRMSRC = alarm.aCDEFS   = -dSTATIC -dCATCH_ALL -uDEBUG -dOSKCHDRS   = -v=../HDRS -v=DEFSCFLAGS  = $(COPTS) $(CDEFS) $(CHDRS)UTILDIR = /DD/CMDSLIB     = osk.lCC      = cc.a.r :   $(CC) $(CFLAGS) $(RFLAG)=$(RDIR) $*.a.c.r :   $(CC) $(CFLAGS) $(RFLAG)=$(RDIR) $*.c# if you wish to use the included password routinesPWENT  = pwent.r pwcryp.r# else if you DO NOT want the included password routines#PWENT  =# dbm.rRFILES = $(ALARM) getopt.r isatty.r stat.r umask.r utime.r pipe.r \		 gettz.r putenv.r $(PWENT) stricmp.r gethname.r popen.r \		 $(SIGNAL) crypt.r alloca.r bcmp.r getprocname.r osk.r \		 getlog.r cuserid.rall             : $(LIB)    touch make.date$(LIB)          : $(RFILES)     chd $(RDIR) ; merge -b99 $(RFILES) >-../$(LIB)    attr -pr ./$(LIB)    rdump -l ./$(LIB)clean           :    chd $(RDIR) ; del $(RFILES)alarm.r			: $(ALRMSRC)signal.r		: $(SIGSRC)getopt.r		: getopt.cisatty.r		: isatty.cutime.r			: utime.cpipe.r			: pipe.cputenv.r		: putenv.cosk.r           : osk.ccrypt.r         : bcmp.cdbm.r           : dbm.calloca.r        : alloca.cbcmp.r          : bcmp.ccrypt.r         : crypt.cgethname.r      : gethname.cgetprocname.r   : getprocname.cstricmp.r       : stricmp.cpopen.r         : popen.cstat.r          : stat.cumask.r         : umask.cgettz.r         : gettz.cpwcryp.r        : pwcryp.cpwent.r         : pwent.c    cc $(CFLAGS) $(RFLAG)=$(RDIR) -dLPWD pwent.c