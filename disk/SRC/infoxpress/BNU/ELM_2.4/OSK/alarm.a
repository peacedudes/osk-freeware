 psect alarm_c,0,0,0,0,0 nam alarm_c* * /***************************************************************************/* /*                                                                         */* /* alarm() : Unix library (OS9/68000)                                      */* /* =======                                                                 */* /*                                                                         */* /* Author:     K. Schmitt                                                  */* /* Compiler:   Microware C Vers. 3.0                                       */* /* OS:         OS9/68000 Vers. 2.2                                         */* /*                                                                         */* /* Edition History                                                         */* /* ===============                                                         */* /*                                                                         */* /* Ed. 0.00  Date 11/11/88                                                 */* /*           First version                                                 */* /*                                                                         */* /***************************************************************************/* /*                                                                         */* /* Description                                                             */* /** * #define ERROR -1* * unsigned alarm(secs)*           int secs;*           { ttl alarmalarm:  link a5,#0 movem.l #_1!1,-(sp) move.l #_3,d0 :6 bsr _stkcheck*           int install(), remove();* *           if (secs)*                { tst.l (sp) :2 beq _6_5*                if (install(secs)) return (ERROR); move.l (sp),d0 :2 bsr install tst.l d0 :2 beq _8_7 moveq.l #-1,d0 :2 bra _4*                }_8*           else*                { bra _9_6*                if (remove())      return (ERROR); bsr remove tst.l d0 :2 beq _11_10 moveq.l #-1,d0 :2 bra _4*                }_11* *           return (0);_9 moveq.l #0,d0 :2 bra _4* *           } /* end of alarm */ nop :2_4 unlk a5 rts :2_3 equ 0xffffffbc :0_1 equ 0x00000000 :0_2 equ 0x0000000c :0* * #asminstall   movem.l   d1-d3,-(a7)          move.l    d0,d3          moveq.l   #0,d0          move.w    #A$Set,d1          moveq.l   #5,d2 SIGALRM          lsl.l     #8,d3          bset.l    #31,d3          os9       F$Alarm          bcs.s     ErrorOK        movem.l   (a7)+,d1-d3          moveq.l   #0,d0          rtsError     move.w    d1,errno(a6)          movem.l   (a7)+,d1-d3          moveq.l   #-1,d0          rtsremove    movem.l   d1-d3,-(a7)          moveq.l   #0,d0          move.w    #A$Delete,d1          os9       F$Alarm          bcs.s     Error          bra.s     OK*  ends