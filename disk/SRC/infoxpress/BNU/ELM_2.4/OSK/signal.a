 psect signal_c,0,0,0,0,0 nam signal_c* * /***************************************************************************/* /*                                                                         */* /* signal() : Unix library (OS9/68000)                                     */* /* ========                                                                */* /*                                                                         */* /* Author:     K. Schmitt                                                  */* /* Compiler:   Microware C Vers. 3.0                                       */* /* OS:         OS9/68000 Vers. 2.2                                         */* /*                                                                         */* /* Edition History                                                         */* /* ===============                                                         */* /*                                                                         */* /* Ed. 0.00  Date 11/12/88                                                 */* /*           First version                                                 */* /*                                                                         */* /***************************************************************************/* /*                                                                         */* /* Description                                                             */* /*                                                                         */* /** * #include <signal.h>* /** * #ifdef _UCC* #include </dd/defs/signal.h>* #else* * #ifndef _SIGNAL_H* #define _SIGNAL_H* * extern int (*signal())();* * #define BADSIG      (int (*)())-1* #define SIG_DFL     (int (*)())0* #define SIG_IGN     (int (*)())1* #define SIG_CATCH   (int (*)())2 * #define SIG_HOLD    (int (*)())3* * * #define SIGILL       1        /* illegal instruction             */* #define SIGQUIT      2        /* quit                            */* #define SIGINT       3        /* interrupt                       */* #define SIGHUP       4        /* hangup                          */* #define SIGALRM      5        /* alarm clock                     */* #define SIGIOT       6        /* ?                               */* #define SIGEMT       7        /* ?                               */* #define SIGFPE       8        /* floating exception              */* #define SIGKILL      9        /* kill, uncatchable termination   */* #define SIGBUS      10        /* address error: bus error        */* #define SIGSEGV     11        /* address error: mmu error        */* #define SIGSYS      12        /* bad system call                 */* #define SIGPIPE     13        /* end of pipe                     */* #define SIGTRAP     14        /* trace or breakpoint             */* #define SIGTERM     15        /* catchable termination           */* #define SIGADDR     16        /* address error: odd address      */* #define SIGZERO     17        /* zero divide                     */* #define SIGCHK      18        /* check error                     */* #define SIGOVER     19        /* arithmetic overflow             */* #define SIGPRIV     20        /* privilege violation             */* #define SIGUSR1     21        /* user defined signal 1           */* #define SIGUSR2     22        /* user defined signal 2           */* #define SIGCLD      23        /* death of a child                */* #define SIGPWR      24        /* power-fail restart              */* * /** * #define SIGSTOP     25        /* stop process                    */* #define SIGTSTP     26        /* stop generated from keyboard    */* #define SIGCONT     27        /* continue after stop             */* #define SIGCHLD     28        /* child status has changed        */* #define SIGTTIN     29        /* read attempted from master term */* #define SIGTTOU     30        /* write attempted from ""     ""  */* #define SIGTINT     31        /* input record available          */* * #define NSIG        32* * #endif* #endif* * # ifndef TRUE* #define TRUE   1* #define FALSE  0* #define ERROR -1* # endif* * typedef int (*IntFunc)();* * #ifdef STATIC* static* #endif* IntFunc func_vec[NSIG]; vsect alignfunc_vec ds.l 32* * #ifdef STATIC* static* #endif* int sig_install();* * #ifdef STATIC* static* #endif* int _last_signal_ = 0;_last_signal_  dc.l 0 ends* * IntFunc signal(sig, new_func)*           register int sig;*           IntFunc new_func;*           { ttl signalsignal:  link a5,#0 movem.l #_1!3,-(sp) move.l d0,d4*           register IntFunc old_func;*           static unsigned char first_call = TRUE; vsect_4 dc.b 1 ends* *           if (first_call)*                { /* initialize the function vector & install the sig catcher */ tst.b _4(a6) beq _6_5*                register int i;* *                first_call = FALSE;*                for (i=0 ; i < NSIG ; i++) clr.b _4(a6) moveq.l #0,d5 :2 bra _9*                     func_vec[i] = SIG_DFL;_7*                if (i=sig_install()) return (i); move.l d5,d0 :2 lsl.l #2,d0 :2 lea func_vec(a6),a0 clr.l 0(a0,d0.l)_10 addq.l #1,d5 :2_9 moveq.l #32,d0 :2 cmp.l d5,d0 :2 bgt _7_8 bsr sig_install move.l d0,d5 :2 beq _12_11 move.l d5,d0 :2 bra _3*                }_12* *           switch (sig)_6*                { bra _14*                case SIGHUP:   /* hangup */*                case SIGINT:   /* interrupt */_15*                case SIGQUIT:  /* quit */_16*                case SIGILL:   /* illegal instruction (not reset when caught) */_17*                case SIGTRAP:  /* trace trap (not reset when caught) */_18*                case SIGFPE:   /* floating point exception */_19*                case SIGBUS:   /* bus error */_20*                case SIGSEGV:  /* segmentation violation */_21*                case SIGALRM:  /* alarm clock */_22*                case SIGZERO:  /* zero divide */_23*                case SIGCHK:   /* check error */_24*                case SIGOVER:  /* arithmetic overflow */_25*                case SIGPRIV:  /* privilege violation */_26*                case SIGUSR1:  /* user defined signal 1 */_27*                case SIGUSR2:  /* user defined signal 2 */_28*                               old_func = func_vec[sig];_29*                               func_vec[sig] = new_func;*                               break; move.l d4,d0 :2 lsl.l #2,d0 :2 lea func_vec(a6),a0 movea.l 0(a0,d0.l),a2 move.l d4,d0 :2 lsl.l #2,d0 :2 lea func_vec(a6),a0 move.l 4(sp),0(a0,d0.l) :6 bra _13* *                case SIGIOT:   /* IOT instruction */*                case SIGEMT:   /* EMT instruction */_30*                case SIGKILL:  /* kill (cannot be caught or ignored) */_31*                case SIGSYS:   /* bad argument to system call */_32*                case SIGPIPE:  /* write on a pipe with no one to read it */_33*                case SIGTERM:  /* software termination signal */_34*                case SIGCLD:   /* death of a child */_35*                case SIGPWR:   /* power fail */_36*                               old_func = func_vec[sig];_37*                               func_vec[sig] = SIG_IGN;*                               break; move.l d4,d0 :2 lsl.l #2,d0 :2 lea func_vec(a6),a0 movea.l 0(a0,d0.l),a2 move.l d4,d0 :2 lsl.l #2,d0 :2 lea func_vec(a6),a0 move.l #1,0(a0,d0.l) :8 bra _13* *                default:       /* wrong signal */_38*                               return (BADSIG); moveq.l #-1,d0 :2 bra _3*                }* *           return (old_func);_14 move.l d4,d0 :2 subq.l #1,d0 :2 cmpi.l #23,d0 :6 bhi _38 add.w d0,d0 :2 move.w _39(pcr,d0.w),d0 jmp _39(pcr,d0.w)_39 dc.w _18-_39 :2 dc.w _17-_39 :2 dc.w _16-_39 :2 dc.w _15-_39 :2 dc.w _23-_39 :2 dc.w _30-_39 :2 dc.w _31-_39 :2 dc.w _20-_39 :2 dc.w _32-_39 :2 dc.w _21-_39 :2 dc.w _22-_39 :2 dc.w _33-_39 :2 dc.w _34-_39 :2 dc.w _19-_39 :2 dc.w _35-_39 :2 dc.w _38-_39 :2 dc.w _24-_39 :2 dc.w _25-_39 :2 dc.w _26-_39 :2 dc.w _27-_39 :2 dc.w _28-_39 :2 dc.w _29-_39 :2 dc.w _36-_39 :2 dc.w _37-_39 :2_13 move.l a2,d0 :2 bra _3* *           } /* end of signal */ nop :2_3 movem.l -16(a5),#_1 unlk a5 rts :2_1 equ 0x00000530 :0_2 equ 0x00000020 :0* * * int check_signal()*           { ttl check_sicheck_signal:  link a5,#0 movem.l #_40!1,-(sp)*           register IntFunc exception;*           register int old_signal;* *           if ((old_signal=_last_signal_) == 0) return(0); move.l _last_signal_(a6),d4 bne _44_43 moveq.l #0,d0 :2 bra _42* *           _last_signal_ = 0;_44*           if (old_signal > NSIG-1)*                { /* ??? */ clr.l _last_signal_(a6) moveq.l #31,d0 :2 cmp.l d4,d0 :2 bge _46_45*                return (0); /* ignore signal */ moveq.l #0,d0 :2 bra _42*                }* *           exception = func_vec[old_signal];_46*           if (exception == SIG_DFL) exit(old_signal); move.l d4,d0 :2 lsl.l #2,d0 :2 lea func_vec(a6),a0 movea.l 0(a0,d0.l),a2 move.l a2,d0 :2 bne _48_47*           if (exception == SIG_IGN) return(0); /* ignore signal */ move.l d4,d0 :2 bsr exit_48 moveq.l #1,d0 :2 cmp.l a2,d0 :2 bne _50_49 moveq.l #0,d0 :2 bra _42* *           return (exception());_50 jsr (a2) :2 bra _42*           *           } /* end of check_signal */ nop :2_42 movem.l -12(a5),#_40 unlk a5 rts :2_40 equ 0x00000510 :0_41 equ 0x00000018 :0* * #ifdef STATIC* static* #endif* void sig_catch(sig)*           short sig;*           { ttl sig_catcsig_catch  link a5,#0 movem.l #_51!1,-(sp)* *           _last_signal_ = (int) (sig) & 0xFFFF;* *           } /* end of sig_catch */ move.w 2(sp),d0 ext.l d0 :2 andi.l #65535,d0 :6 move.l d0,_last_signal_(a6)_53 unlk a5 rts :2_51 equ 0x00000000 :0_52 equ 0x0000000c :0* * * #ifdef STATIC* static* #endif* int sig_install()*           { /* install intercept routine */ ttl sig_instsig_install  link a5,#0 movem.l #_54!1,-(sp)*           int strap_install();* *           if (intercept(sig_catch) == ERROR) return (ERROR); lea sig_catch(pc),a0 move.l a0,d0 :2 bsr intercept moveq.l #-1,d1 :2 cmp.l d0,d1 :2 bne _58_57 moveq.l #-1,d0 :2 bra _56* #ifdef CATCH_ALL*           if (strap_install() == ERROR) return (ERROR);_58 bsr strap_install moveq.l #-1,d1 :2 cmp.l d0,d1 :2 bne _60_59 moveq.l #-1,d0 :2 bra _56* #endif*           return (0);_60 moveq.l #0,d0 :2 bra _56* *           } /* end of sig_instal */ nop :2_56 movem.l -8(a5),#_54 unlk a5 rts :2_54 equ 0x00000102 :0_55 equ 0x00000014 :0* * #ifdef CATCH_ALL* #asmstrap_install          movem.l   d1/a0-a1,-(a7)          sub.l     a0,a0 clear a0 => use current stack for trap          lea.l     TrapTbl(pc),a1 point to exeption table          os9       F$STrap install error trap handler          bcc.s     NoErr          move.w    d1,errno+2(a6) save error code          moveq.l   #-1,d0          movem.l   (a7)+,d1/a0-a1          rtsNoErr     moveq.l   #0,d0          movem.l   (a7)+,d1/a0-a1 restore regs          rtsTrapTbl             dc.w      T_BusErr,bus_err-*-4          dc.w      T_AddErr,addr_err-*-4          dc.w      T_IllIns,ill_ins-*-4          dc.w      T_ZerDiv,zero_div-*-4          dc.w      T_CHK,check_ins-*-4          dc.w      T_TRAPV,trapv_err-*-4          dc.w      T_Priv,priv_err-*-4          dc.w      T_FPDivZer,float_err-*-4          dc.w      T_FPInxact,float_err-*-4          dc.w      T_FPNotNum,float_err-*-4          dc.w      T_FPOprErr,float_err-*-4          dc.w      T_FPOverFl,float_err-*-4          dc.w      T_FPUndrFl,float_err-*-4          dc.w      T_FPUnordC,float_err-*-4          dc.w      -1 end of tableaddr_errbus_err   movem.l   (a5)+,d0-d7/a0-a7 restore caller's register set          move.l    #10,_last_signal_(a6) save last signal          rtr       return from exeptionill_ins   movem.l   (a5)+,d0-d7/a0-a7 restore caller's register set          move.l    #1,_last_signal_(a6) save last signal          rtr       return from exeptionzero_div  movem.l   (a5)+,d0-d7/a0-a7 restore caller's register set          move.l    #17,_last_signal_(a6) save last signal          rtr       return from exeptioncheck_ins movem.l   (a5)+,d0-d7/a0-a7 restore caller's register set          move.l    #18,_last_signal_(a6) save last signal          rtr       return from exeptiontrapv_err movem.l   (a5)+,d0-d7/a0-a7 restore caller's register set          move.l    #19,_last_signal_(a6) save last signal          rtr       return from exeptionpriv_err  movem.l   (a5)+,d0-d7/a0-a7 restore caller's register set          move.l    #20,_last_signal_(a6) save last signal          rtr       return from exeptionfloat_err movem.l   (a5)+,d0-d7/a0-a7 restore caller's register set          move.l    #8,_last_signal_(a6) save last signal          rtr       return from exeption* * #endif /* CATCH_ALL */*  ends