-b# THE ABOVE LINE TURNS OFF THE BUILTIN RULES FOR MICROWARE'S MAKE - LEAVE IT!!## $Id: Makefile.SH,v 5.1 1992/10/03 22:12:17 syd Exp $##  Makefile for the entire ELM mail system##         (C) Copyright 1986,1987, by Dave Taylor#         (C) Copyright 1988-1992, USENET Community Trust##  $Log: Makefile.SH,v $# Revision 5.1  1992/10/03  22:12:17  syd# Initial checkin as of 2.4 Release at PL0## ##	Variables established by ConfigureCAT 		=	catGREP		=	grepECHO		=	echoMAKE		=	makePR  		=	prSLEEP		=	sleepTAR 		=	tar#	Other variablesSHELL		=	/dd/cmds/shellBIN 		=	BINUSRBIN		=	/DD/USR/CMDSSYSBIN		=	/DD/ETC/CMDSUSRPROGS	=	answer autoreply checkalias elm filter frm \				listalias messages newalias newmail printmail readmsgSYSPROGS	=	arepdaemon fastmail# Targets#	Give default target first and alone# default_target:	all#	Targets that are simply executed in each subordinate makefile as isall clean:  config.h hdrs/sysdefs.h		chd lib; $(MAKE) -f=Makefile.osk $@		chd osk; $(MAKE) -f=Makefile.osk $@		chd src; $(MAKE) -f=Makefile.osk $@		chd utils; $(MAKE) -f=Makefile.osk $@		chd filter; $(MAKE) -f=Makefile.osk $@#		chd doc; $(MAKE) -f=Makefile.osk $@realclean: clean		chd $(BIN) ; del *#	Targets that apply to all elm at onceinstall:		chd $(BIN) ; attr * -penpwnprewr		chd $(BIN) ; copy $(USRPROGS) -rw=$(USRBIN)		chd $(BIN) ; copy $(SYSPROGS) -rw=$(SYSBIN)#		chd $(BIN) ; copy -r frm $(DEST)/nfrm#		chd $(BIN) ; copy -r frm $(DEST)/ofrm#		chd $(BIN) ; copy -r frm $(DEST)/rfrm#		chd $(BIN) ; copy -r frm $(DEST)/ufrmconfig.h : config_osk.h        copy -r config_osk.h config.h        copy -r hdrs/sysdefs_osk.h hdrs/sysdefs.h#listing:#		@$(ECHO) "Making source listing in file LISTING."#		@$(PR) -n -f $(SOURCE_FILES) >LISTINGlha:		lha -ur Elm_2.4PL21 \			Changes Notice Readme Overview Patchlist Readme.PrJ \			BIN DOC			lhasrc:		lha -ur Elm_2.4PL21_src \			Changes Notice Readme Overview Patchlist Readme.PrJ \			Configure Instruct Manifest Makefile.SH config.h.SH \			config_osk.h FILTER HDRS LIB Makefile.osk NLS SRC TEST UTILS#	Targets that are really in subordinate make filesdocumentation:	chd doc; $(MAKE) -f=Makefile.osk $@elm:	chd lib; $(MAKE) -f=Makefile.osk all	chd src; $(MAKE) -f=Makefile.osk all#	The dummy dependency here prevents make from thinking the target is the#	filter directory that sits in the current directory, rather than#	an abstract target.filter: _filter_filter:	chd filter; $(MAKE) -f=Makefile.osk all#	The dummy dependency here prevents make from thinking the target is the#	utils directory that sits in the current directory, rather than#	an abstract target.utils: _utils_utils:	chd utils; $(MAKE) -f=Makefile.osk all