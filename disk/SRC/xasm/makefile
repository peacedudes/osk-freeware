COMMOBJ=as.r util.r ffwd.r output.r pseudo.r eval.r symtab.rall: as0 as1 as4 as5 as9 as11as0: do0.r $(COMMOBJ)	gcc -o as0 do0.r $(COMMOBJ)as1: do1.r $(COMMOBJ)	gcc -o as1 do1.r $(COMMOBJ)as11: do11.r $(COMMOBJ)	gcc -o as11 do11.r $(COMMOBJ)as4: do4.r $(COMMOBJ)	gcc -o as4 do4.r $(COMMOBJ)as5: do5.r $(COMMOBJ)	gcc -o as5 do5.r $(COMMOBJ)as9: do9.r $(COMMOBJ)	gcc -o as9 do9.r $(COMMOBJ)as.r: as.hdo0.r: as.hdo0.r: table0.hdo1.r: as.hdo1.r: table1.hdo11.r: as.hdo11.r: table11.hdo4.r: as.hdo4.r: table4.hdo5.r: as.hdo5.r: table5.hdo9.r: as.hdo9.r: table9.heval.r: as.hffwd.r: as.houtput.r: as.hpseudo.r: as.hsymtab.r: as.hutil.r: as.h