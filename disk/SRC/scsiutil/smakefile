# Makefile for SCSIUtil CC = sc ######################################################################## smkfile to build SCSIutil##   Heiko Rath -  25 Jan 1994##  SAS/C 6.51#######################################################################CFLAGS = STRMER UCHAR DATA AUTOADDSYM =O=O/LIBS= lib:sc.lib lib:amiga.libINCS= scsi_priv.hall :	SCSIutilSCSIutil	: $(O)SCSIutil.o	slink   FROM lib:c.o  $(O)SCSIutil.o  TO SCSIutil LIB \		$(LIBS) $(ADDSYM) NOICONS$(O)SCSIutil.o   : SCSIutil.c $(INCS) 	$(CC)   OBJECTNAME $O GST SCSIutil.gst $(CFLAGS) SCSIutil.copti:	$(CC)   OBJECTNAME $O GST SCSIutil.gst OPTIMIZE $(CFLAGS) SCSIutil.c	slink   FROM lib:c.o  $(O)SCSIutil.o  TO SCSIutil LIB \		$(LIBS) $(ADDSYM) NOICONSdebug:	$(CC)   OBJECTNAME $O GST SCSIutil.gst DEBUG FULL $(CFLAGS) SCSIutil.c	slink   FROM lib:c.o  $(O)SCSIutil.o  TO SCSIutil LIB \		$(LIBS) $(ADDSYM) NOICONSmakegst:	$(CC) MGST SCSIutil.gst SCSIutil.cindent:		indent -gnu SCSIutil.carchive:	lha -ax u SCSIUtil.lha SCSIUtil SCSIUtil.c O/SCSIUtil.o scsi_priv.h smakefile TODO HISTORY scsiutil.doc Dmakefile