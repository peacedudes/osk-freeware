# NAME#      Makefile - for the tile forth environment# SYNOPSIS#      make [option]# DESCRIPTION#      General compilation coordinator for the threaded interpreter language#      environment (TILE). Allow compilation in different modes to simplify#      program development; compiling, recompiling, debugging, profiling,#      benchmarks, and distribution.# OPTIONS#      new#              Cleans up and compiles a fresh version.#      opt#              Use all optimization tricks known by cc.#      dbx#              Recompile for debugging with dbx.#      gprof#              Recompile for profiling with gprof.#      lint#              Verify the source code using lint.#      bench#              Some benchmarks to evaluate this threading method#      kit#              Pack the available source, test and documentation files# SEE ALSO#      make(1), cc(1), touch(1), dbx(1), grof(1), lint(1), time(1), makekit(1)# AUTHOR#      Copyright (c) 1989, Mikael R.K. Patel#      Computer Aided Design Laboratory (CADLAB)#      Department of Computer and Information Science#      Linkoping University#      S-581 83 LINKOPING#      SWEDEN#      Email: mip@ida.liu.se## Source and object filesSRC = kernel.c kernel.h io.c io.h error.c error.h memory.c memory.h forth.cOBJS = kernel.r io.r error.r memory.r# Machines and separate compilation directives# Vanilla Compiler might not understand void# LIBS =# CFLAGS = -Dvoid=int# Template for your machine dependencies and libraries# LIBS = -lyourlibrary# CFLAGS = -youroption -DYOURMACHINECFLAGS= -qgixt=/r0RDIR=relsCC=ccforth: $(OBJS) forth.r       chd $(RDIR);$(CC) $(CFLAGS) -fd=../$@ $(OBJS) forth.r -l=/h0/lib/os9lib.l       attr -e $*# Object code dependenciesforth.r: kernel.h io.h error.h memory.hkernel.r: kernel.h io.h error.h memory.hmemory.r: kernel.h memory.herror.r:  kernel.h io.h error.h memory.hio.r:     io.h error.h memory.h# Cleans up and compiles a new versionnew:       touch forth.r       del *.r       make forth# Compiles for debugging with "dbx" or "dbxtool"dbx:       touch forth.r       del *.r       make forth "CFLAGS=$(CFLAGS) -g"# Run the benchmarksbench:       time forth src/*.f83 -s bye       time forth tst/byte_sieve.tst -s byte-sieve       time forth tst/colburn_sieve.tst -s colburn-sieve       time forth tst/fibonacci.tst -s recursive-fib       time forth tst/fibonacci.tst -s tail-recursive-fib       time forth tst/bubble_sort.tst -s bubble-sort       time forth tst/bubble_sort.tst -s bubble-sort-with-flag       time forth tst/tree_sort.tst -s tree-sort       time forth tst/matrix_mult.tst -s matrix-mult       time forth tst/permutations.tst -s permutations       time forth tst/towers_of_hanoi.tst -s towers-of-hanoi# Packs the available source and documentation for mailingkit:       makekit -s57k -ntile.kit. \               COPYING README PORTING RELEASES tile.1 \               Makefile $(SRC) forth.el forthtool .forthicon \               src src/* doc doc/* tst tst/* \       > tile.kit.00       mv tile.kit.* shar