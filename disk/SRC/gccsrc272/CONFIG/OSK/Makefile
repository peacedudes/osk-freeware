CFLAGS = -O -traditionalODIR = CMDSRDIR = RELSCC = gcc2ALL = exec_if_new osk.l move_if_change.c.r:     $(CC) -c -o $(RDIR)/$*.r $*.c $(CFLAGS)make.date: $(ALL)     @touch make.dateexec_if_new: exec_if_new.r     $(CC) -g -o $(ODIR)/$* $(RDIR)/$*.r -ghostmove_if_change: move_if_change.r     $(CC) -g -o $(ODIR)/$* $(RDIR)/$*.r -ghostosk.l: osk.r     copy -r $(RDIR)/osk.r osk.losk.r: osk.c     $(CC) -c -o $(RDIR)/osk.r $(CFLAGS) -mnostack-check $*.c