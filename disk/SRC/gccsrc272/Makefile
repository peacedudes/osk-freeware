# Makefile for use on OS-9/68k (OSK).V       = 2.7.2DD      = /ddsrcdir  = $(DD)/GNU/GCC_$VCSTART  = $(DD)/LIB/cstart.rDISTDIR = $(srcdir)/../DISTRINSTDIR = $(DD)/GNU/CMDSTPATH   = OSKLIBGCC2_RDIR = LIBGCC2_000RDIR    = STAGE0ODIR    = $(srcdir)/$(RDIR)LHARC   = lharc aDELDIR  = deldir -qfDEL     = del -fBISON   = bisonBISONFLAGS= #30EXECN   = exec_if_newLIBDEPS = alloca.rCPPFLAGS=CPLUS_INPUT=GCC_CFLAGS=CC2ED     = 37CC2PLUSED = 22CC2OBJED  = 1CCCP2ED   = 17GCC2ED    = 28COLED     = 10# stacksize for cc2xxxSTK = 50kTCSW = -m68000MALLOC =MD = $(TPATH)/mdCONFIG_H = $(TPATH)/config.h $(TPATH)/tm.hRTL = rtl.rRTLANAL = rtlanal.rCC = gcc2RC = r68LC = l68GCC_FOR_TARGET = $(CC)OPT  = -O -mremote -mlong-callsOPT2 = -O -mremote -mlong-callsALL_CFLAGS  = $(OPT) -mgss $(TCSW)ALL_CFLAGS2 = $(OPT2) -mgss $(TCSW)INCLUDE2 = -I../gclib/defs INCLUDES = -I. -Icp $(INCLUDE2) -Iconfig -I$(TPATH)#-I/dd/defs/os9lib#LDFLAGS= -cio -g -A $(CSTART)LDFLAGS= -g -A $(CSTART) -L$(srcdir)CFLAGS = $(OPT) -mremote $(TCSW) -mgssLIBS = -lalloca.r -l=$(DD)/LIB/os9lib.l -l=$(DD)/LIB/os9.l# Special flags for compiling enquire.ENQUIRE_CFLAGS = -DNO_SC -DNO_MEM -DNO_STDDEF $(GCC_CFLAGS)ENQUIRE_LDFLAGS = $(LDFLAGS)# Always use -I$(srcdir)/config when compiling..c.r:    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r $*.c# Language-specific object files for C.C_OBJS = c_parse.r c_decl.r c_typeck.r \   c_lang.r c_convert.r c_aux_info.r \   c_common.r c_lex.r c_pragma.r \   c_iterate.r getpwd.r# Language-specific object files for Objectionable C.OBJC_OBJS = objc_parse.r objc_act.r c_iterate.r\   c_lex.r c_decl.r c_typeck.r c_convert.r\   c_aux_info.r c_common.r c_pragma.r getpwd.r# Language-specific object files for C++.CPLUS_OBJS1 = cp_parse.r cp_decl.r cp_decl2.r \   cp_typeck.r cp_typeck2.r cp_tree.r \   cp_ptree.r cp_cvt.r cp_search.r cp_lex.r \   cp_gc.r cp_call.r cp_repo.rCPLUS_OBJS2 = cp_class.r cp_init.r cp_method.r \   cp_except.r cp_expr.r cp_pt.r cp_edsel.r \   cp_xref.r cp_sig.r $(CPLUS_INPUT) cp_spew.r \   c_common.r cp_error.r cp_errfn.rCPLUS_OBJS = $(CPLUS_OBJS1) $(CPLUS_OBJS2) getpwd.r getcd.r# Files specific to the C interpreter bytecode compiler(s).BC_OBJS = bc_emit.r bc_optab.r# Language-independent object files.OBJS1 = toplev.r version.r tree.r print_tree.r stor_layout.r fold_const.r \ function.r stmt.r expr.r calls.r expmed.r explow.r optabs.r varasm.rOBJS2 = rtl.r print_rtl.r rtlanal.r sdbout.r dwarfout.r srcdbg.r emit_rtl.r \ insn_emit.r integrate.r jump.r cse.r loop.r unroll.r flow.r stupid.r combine.rOBJS3 = regclass.r local_alloc.r global.r reload.r reload1.r caller_save.r \ insn_peep.r sched.r final.r recog.r reg_stack.rOBJS4 =  insn_recog.r insn_extract.r insn_output.r dbxout.r \ insn_attrtab.r aux_output.r convert.r insn_opinit.r real.rOBJS = $(OBJS1) $(OBJS2) $(OBJS3) $(OBJS4)# objectes for building the profiler libraryPOBJS = prof.r# GEN files are listed separately, so they can be built before doing parallel#  makes for cc1 or cc1plus.  Otherwise sequent parallel make attempts to load#  them before rtl.r is compiled.GEN= $(ODIR)/genemit $(ODIR)/genoutput $(ODIR)/genrecog $(ODIR)/genextract $(ODIR)/genflags $(ODIR)/gencodes $(ODIR)/genconfig $(ODIR)/genpeepREAL_H = real.hRTL_H = rtl.h rtl.def machmode.h machmode.defTREE_H = tree.h real.h tree.def machmode.h machmode.defCPLUS_TREE_H = $(TREE_H) cp/cp_tree.h cp/tree.defBYTECODE_H = bytecode.h bc_emit.h bc_optab.hLIB2FUNCS = _muldi3 _divdi3 _moddi3 _udivdi3 _umoddi3 _negdi2 \            _lshrdi3 _ashldi3 _ashrdi3 _ffsdi2 \            _udiv_w_sdiv _udivmoddi4 _cmpdi2 _ucmpdi2 _floatdidf _floatdisf \            _fixunsdfsi _fixunssfsi _fixunsdfdi _fixdfdi _fixunssfdi _fixsfdi \            _fixxfdi _fixunsxfdi _floatdixf _fixunsxfsi \            _fixtfdi _fixunstfdi _floatditf \            __gcc_bcmp _varargs _eprintf _op_new _op_vnew _new_handler _op_delete \            _op_vdel _bb _shtab _clear_cache __main _exit _eh _pure\            __exit _atexit _abort _tidyup _ctors#_trampoline#LIB2FUNCS = _lshrdi3 _ashldi3 _ashrdi3 _ffsdi2 _muldi3 _udiv_w_sdiv\#            _udivmoddi4 _divdi3 _moddi3 _umoddi3 _udivdi3 _cmpdi2 _ucmpdi2\#            _fixunsdfdi _fixdfdi _fixunssfdi _fixsfdi _floatdidf _floatdisf\#            _negdi2 _floatdixf\#            _fixunsdfsi _fixunssfsi __gcc_bcmp _varargs _eprintf _bb _op_new\#            _op_vnew _new_handler _op_delete _op_vdel _shtab _clear_cache\#            __main _exit _ctor_list _dtor_list _eh _pure\#            _tidyup _abort _atexit __exit#_trampoline#_ctors make.date: $(GEN) cc2 cc2plus cc2obj cccp2 gcc2 collect    @touch make.date# Define the names for selecting languages in LANGUAGES.c: cc1cpp: cc1plusobjc: cc1objclass_c: cc1objobjective_c: cc1objcompilations: $(OBJS)libgcc_000.l: libgcc1.c floatlib.c $(CONFIG_H)    $(CC) $(CFLAGS) -c -o floatlib000.l floatlib.c -m68000    -makdir LIBGCC1_000    echo cc \2dv=$(TPATH) \2dtp=68kdlcl \2dr=libgcc1_000 \2dqs \2dO=2 libgcc1.c \2dD\2a >-cfp.cmd    echo "-nx;del libgcc1_000/\2a.r >>>/nil" >+cfp.cmd    echo "-x;rename libgcc1_000/libgcc1.r \2a.r" >+cfp.cmd    fgrep L_ libgcc1.c ! sed -e s/ifdef// ! tr -d \20\23 >-cfp.inp    cfp cfp.cmd -z=cfp.inp </nil    liborder libgcc1_000/* ! merge -zb100 >-libgcc1_000.l    liborder -lump libgcc1_000.l    del cfp.cmd    merge floatlib000.l libgcc1_000.l >-libgcc_000.llibgcc_020.l: libgcc1.c floatlib.c $(CONFIG_H)    $(CC) $(CFLAGS) -c -o floatlib020.l floatlib.c -m68020    -makdir LIBGCC1_020    echo cc \2dv=$(TPATH) \2dtp=020dlcl \2dr=libgcc1_020 \2dqs \2dO=2 libgcc1.c \2dD\2a >-cfp.cmd    echo "-nx;del libgcc1_020/\2a.r >>>/nil" >+cfp.cmd    echo "-x;rename libgcc1_020/libgcc1.r \2a.r" >+cfp.cmd    fgrep L_ libgcc1.c ! sed -e s/ifdef// ! tr -d \20\23 >-cfp.inp    cfp cfp.cmd -z=cfp.inp </nil    liborder libgcc1_020/* ! merge -zb100 >-libgcc1_020.l    liborder -lump libgcc1_020.l    del cfp.cmd    merge floatlib020.l libgcc1_020.l >-libgcc_020.llibgcc_300.l: libgcc1.c floatlib.c $(CONFIG_H)    $(CC) $(CFLAGS) -c -o floatlib300.l floatlib.c -m68020 -mnobitfield    -makdir LIBGCC1_300    echo cc \2dv=$(TPATH) \2dtp=cpu32dlcl \2dr=libgcc1_300 \2dqs \2dO=2 libgcc1.c \2dD\2a >-cfp.cmd    echo "-nx;del libgcc1_300/\2a.r >>>/nil" >+cfp.cmd    echo "-x;rename libgcc1_300/libgcc1.r \2a.r" >+cfp.cmd    fgrep L_ libgcc1.c ! sed -e s/ifdef// ! tr -d \20\23 >-cfp.inp    cfp cfp.cmd -z=cfp.inp </nil    liborder libgcc1_300/* ! merge -zb100 >-libgcc1_300.l    liborder -lump libgcc1_300.l    del cfp.cmd    merge floatlib300.l libgcc1_300.l >-libgcc_300.lLIBGCC_COMP = gcc2 -O -ob -ucc -muccmode2 -mnostack-check -mnocom \                   -mlong-calls -mremote -I../gclib/defs -I$(TPATH)libgcc2_000.l: libgcc2.c $(CONFIG_H)    -deldir -qf LIBGCC2_000    makdir LIBGCC2_000    $(RC) -q -m2 config/osk/dynstack.a -o=libgcc2_000/dynstack.r    $(RC) -q -o=LIBGCC2_000/stklimit.r config/osk/stklimit.a    echo "$(LIBGCC_COMP) -c -o LIBGCC2_000/\2a.r -DL\2a libgcc2.c" >-cfp.cmd    echo -n $(LIB2FUNCS) ! cfp cfp.cmd -z    $(LIBGCC_COMP) -c -o LIBGCC2_000/__main.r -DL__main libgcc2.c -mnouccmode -muccmode2    liborder libgcc2_000/* STAGE0/alloca.r ! grep -v tidyup ! merge -b200 -z >-libgcc2_000.l    echo -n libgcc2_000/* STAGE0/alloca.r ! grep -v tidyup ! libgen -z -co=libgcc2u_000.l    -del cfp.cmdlibgcc2_300.l: libgcc2.c $(CONFIG_H)    -deldir -qf LIBGCC2_300    makdir LIBGCC2_300    $(RC) -q -m2 config/osk/dynstack.a -o=libgcc2_300/dynstack.r -a=MC68020    $(RC) -q -o=LIBGCC2_300/stklimit.r config/osk/stklimit.a    echo "$(LIBGCC_COMP) -mcpu32 -c -o LIBGCC2_300/\2a.r -DL\2a libgcc2.c" >-cfp.cmd    echo -n $(LIB2FUNCS) ! cfp cfp.cmd -z    $(LIBGCC_COMP) -c -o LIBGCC2_300/__main.r -DL__main libgcc2.c -mnouccmode -muccmode2    liborder libgcc2_300/* STAGE0/alloca.r ! grep -v tidyup ! merge -b200 -z >-libgcc2_300.l    echo -n libgcc2_300/* STAGE0/alloca.r ! grep -v tidyup ! libgen -z -co=libgcc2u_300.l    -del cfp.cmdlibgcc2_020.l: libgcc2.c $(CONFIG_H)    -deldir -qf LIBGCC2_020    makdir LIBGCC2_020    $(RC) -q -m2 config/osk/dynstack.a -o=libgcc2_020/dynstack.r -a=MC68020    $(RC) -q -o=LIBGCC2_020/stklimit.r config/osk/stklimit.a    echo "$(LIBGCC_COMP) -m68020 -c -o LIBGCC2_020/\2a.r -DL\2a libgcc2.c" >-cfp.cmd    echo -n $(LIB2FUNCS) ! cfp cfp.cmd -z    $(LIBGCC_COMP) -c -o LIBGCC2_020/__main.r -DL__main libgcc2.c -mnouccmode -muccmode2    liborder libgcc2_020/* STAGE0/alloca.r ! merge -b200 -z >-libgcc2_020.l    echo -n libgcc2_020/* STAGE0/alloca.r ! libgen -z -co=libgcc2u_020.l    -del cfp.cmdgcc2: gcc2osk.r version.r $(LIBDEPS) obstack.r getcd.r    chd $(RDIR);$(CC) -ghost $(ALL_CFLAGS) $(LDFLAGS) -o $(ODIR)/$* gcc2osk.r \    version.r obstack.r getcd.r $(LIBS) -e $(GCC2ED) -s 10# Go via `gccnew' to avoid `file busy' if gcc is `gcc'.#   mv -f gccnew gcc# Dump a specs file to make -B./ read these specs over installed ones#   gcc -dumpspecs >-specsLLIBS = -l=obstack.r -l=alloca.rCLIBS = -l=$(DD)/LIB/os9lib.l -l=$(DD)/LIB/os9.l \        -l=$(DD)/LIB/gnulib.l -l=$(srcdir)/config/OSK/osk.l -l=$(DD)/LIB/clibn.lSYSLIBS= $(CLIBS) -l=$(DD)/LIB/os9lib.l -l=$(DD)/LIB/math.l -l=$(DD)/LIB/sys.lcc2: $(OBJS) $(LIBDEPS) $(C_OBJS) $(BC_OBJS)    @echo -n $(CSTART) $(C_OBJS) >-$(RDIR)/rfiles    @echo -n $(OBJS1) >+$(RDIR)/rfiles    @echo -n $(OBJS2) >+$(RDIR)/rfiles    @echo -n $(OBJS3) >+$(RDIR)/rfiles    @echo -n $(OBJS4) >+$(RDIR)/rfiles    @echo -n $(BC_OBJS) >+$(RDIR)/rfiles    chd $(RDIR);$(LC) #32K -sm -z=rfiles -o=$(ODIR)/$* -ga -S -e=$(CC2ED) -M=$(STK) \                $(LLIBS) $(SYSLIBS) >-cc2.map    @attr -aepe $(ODIR)/$**#   remove cc2#   $(CC) $(ALL_CFLAGS) $(LDFLAGS) -o cc1 $(C_OBJS) $(OBJS) $(LIBS)cc2plus: $(CPLUS_OBJS) $(OBJS) $(LIBDEPS) $(BC_OBJS)    @echo -n $(CSTART) $(CPLUS_OBJS) >-$(RDIR)/rfiles_plus    @echo -n $(OBJS1) >+$(RDIR)/rfiles_plus    @echo -n $(OBJS2) >+$(RDIR)/rfiles_plus    @echo -n $(OBJS3) >+$(RDIR)/rfiles_plus    @echo -n $(OBJS4) >+$(RDIR)/rfiles_plus    @echo -n $(BC_OBJS) >+$(RDIR)/rfiles_plus    chd $(RDIR);$(LC) #32K -sm -z=rfiles_plus -o=$(ODIR)/$* -ga -S -e=$(CC2PLUSED) -M=7K \                      $(LLIBS) $(SYSLIBS) -M=$(STK) >-cc2plus.map#   $(CC) $(ALL_CFLAGS) $(LDFLAGS) -o cc1plus $(CPLUS_OBJS) $(OBJS) $(LIBS)cc2obj: $(OBJC_OBJS) $(OBJS) $(LIBDEPS) $(BC_OBJS)    @echo -n $(CSTART) $(OBJC_OBJS) >-$(RDIR)/rfiles_obj    @echo -n $(OBJS1) >+$(RDIR)/rfiles_obj    @echo -n $(OBJS2) >+$(RDIR)/rfiles_obj    @echo -n $(OBJS3) >+$(RDIR)/rfiles_obj    @echo -n $(OBJS4) >+$(RDIR)/rfiles_obj    @echo -n $(BC_OBJS) >+$(RDIR)/rfiles_obj    chd $(RDIR);$(LC) #32K -sm -z=rfiles_obj -o=$(ODIR)/$* -ga -S -e=$(CC2OBJED) -M=7K \                      $(LLIBS) $(SYSLIBS) -M=$(STK) >-cc2obj.map#   $(CC) $(ALL_CFLAGS) $(LDFLAGS) -o cc1obj $(OBJC_OBJS) $(OBJS) $(LIBS)collect: $(CONFIG_H) $(LIBDEPS) collect_osk.r    chd $(RDIR);$(CC) -ghost -o $(ODIR)/$* $(CFLAGS) $(INCLUDES)\            -e $(COLED) $(LDFLAGS) collect_osk.r $(LIBS)float.h : enquire    -./enquire -f >-float.h# Used to compile enquire with standard cc, but have forgotten why.# Let's try with GCC.enquire: enquire.r gnulib    $(GCC_FOR_TARGET) $(GCC_CFLAGS) $(ENQUIRE_LDFLAGS) enquire.r -o $@enquire.r: enquire.c cc1 cpp    $(GCC_FOR_TARGET) $(GCC_CFLAGS) $(CPPFLAGS) $(ENQUIRE_CFLAGS) -I. \        -c enquire.c# Compiling object files from source files.# Note that dependencies on obstack.h are not written# because that file is not part of GCC.# Dependencies on gvarargs.h are not written# because all that file does, when not compiling with GCC,# is include the system varargs.h.# C language specific files.c_parse.r : c_parse.c $(TREE_H) c_parse.h c_tree.h input.h flags.h    $(CC) $(ALL_CFLAGS) $(CPPFLAGS) $(INCLUDES) -c c_parse.c -o $(RDIR)/$*.rc_parse.c : c_parse.y    $(BISON) $(BISONFLAGS) c_parse.y -o $@c_parse.y : c_parse.in    sed -e "/^ifobjc/,/^end ifobjc/d" \        -e "/^ifc/d" -e "/^end ifc/d" \        c_parse.in >-c_parse.yc_decl.r : c_decl.c $(CONFIG_H) $(TREE_H) c_tree.h c_parse.h flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r $*.c -mlong-callsc_typeck.r : c_typeck.c $(CONFIG_H) $(TREE_H) c_tree.h flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r $*.c -mlong-callsc_lang.r : c_lang.c $(CONFIG_H) $(TREE_H)c_aux_info.r : c_aux_info.c  $(CONFIG_H) $(TREE_H) c_tree.h flags.hc_convert.r : c_convert.c $(CONFIG_H) $(TREE_H)c_pragma.r: c_pragma.c $(CONFIG_H) $(TREE_H)c_iterate.r: c_iterate.c $(CONFIG_H) $(TREE_H) $(RTL_H) c_tree.h flags.hc_lex.r : c_lex.c $(CONFIG_H) $(TREE_H) c_lex.h c_tree.h c_parse.h flags.h\          rtl.h rtl.def input.h# C++ language specific files.cp_parse.r : cp/parse.c $(CPLUS_TREE_H) flags.h    $(CC) -c $(ALL_CFLAGS) $(CPPFLAGS) $(INCLUDES) \    -o $(RDIR)/$*.r cp/parse.ccp/parse.c cp/parse.h : cp/parse.y    @echo expect 29 shift/reduce conflicts and 13 reduce/reduce conflicts    $(BISON) $(BISONFLAGS) -d -o cp/parse.c cp/parse.y    grep define cp/parse.c ! grep YYEMPTY >+cp/parse.hcp_repo.r : cp/repo.c $(CPLUS_TREE_H) input.h    $(CC) -c $(ALL_CFLAGS) $(CPPFLAGS) $(INCLUDES) \    -o $(RDIR)/$*.r cp/repo.ccp_spew.r : cp/spew.c $(CONFIG_H) $(CPLUS_TREE_H) \   cp/parse.h flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r cp/spew.ccp_lex.r: cp/lex.c $(CONFIG_H) $(CPLUS_TREE_H) \   cp/parse.h cp/input.c flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r cp/lex.c -mlong-callscp_decl.r : cp/decl.c $(CONFIG_H) $(CPLUS_TREE_H) flags.h \  cp/parse.h cp/decl.h stack.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r cp/decl.c -mlong-callscp_decl2.r : cp/decl2.c $(CONFIG_H) $(CPLUS_TREE_H) flags.h \  cp/parse.h cp/decl.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r cp/decl2.ccp_typeck2.r : cp/typeck2