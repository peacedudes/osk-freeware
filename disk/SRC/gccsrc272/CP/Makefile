# G++ Makefile for use on OS-9/68k (OSK).V       = 2.7.2DD      = /ddsrcdir  = $(DD)/GNU/GCC_$VCSTART  = $(DD)/LIB/cstart.rDISTDIR = $(srcdir)/../DISTRINSTDIR = $(DD)/GNU/CMDSTPATH   = ../OSKLIBGCC2_RDIR = LIBGCC2_000RDIR    = $(srcdir)/STAGE0ODIR    = $(RDIR)LHARC   = lharc aDELDIR  = deldir -qfDEL     = del -fBISON   = bisonBISONFLAGS= #30LIBDEPS = alloca.rCPPFLAGS=CPLUS_INPUT=GCC_CFLAGS=CC2PLUSED = 19COLED     = 9# stacksize for cc2xxxSTK = 50kTCSW = -m68000MALLOC =CONFIG_H = $(TPATH)/config.h $(TPATH)/tm.hRTL = rtl.rRTLANAL = rtlanal.rCC = gcc2RC = r68LC = l68GCC_FOR_TARGET = $(CC)OPT  = -O -mremote -mlong-callsOPT2 = -O -mremote -mlong-callsALL_CFLAGS  = $(OPT) -mgss $(TCSW)ALL_CFLAGS2 = $(OPT2) -mgss $(TCSW)INCLUDE2 = -I../../gclib/defsINCLUDES = -I.. -I. $(INCLUDE2) -I../config -I$(TPATH)#-I/dd/defs/os9lib#LDFLAGS= -cio -g -A $(CSTART)LDFLAGS= -g -A $(CSTART) -L$(srcdir)CFLAGS = $(OPT) -mremote $(TCSW) -mgssLIBS = -lalloca.r -los9lib.l -los9.l# Special flags for compiling enquire.ENQUIRE_CFLAGS = -DNO_SC -DNO_MEM -DNO_STDDEF $(GCC_CFLAGS)ENQUIRE_LDFLAGS = $(LDFLAGS)# Always use -I$(srcdir)/config when compiling..c.r:    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r $*.c# Language-specific object files for C++.CPLUS_OBJS1 = cp_parse.r cp_decl.r cp_decl2.r \   cp_typeck.r cp_typeck2.r cp_tree.r \   cp_ptree.r cp_cvt.r cp_search.r cp_lex.r \   cp_gc.r cp_call.r cp_repo.rCPLUS_OBJS2 = cp_class.r cp_init.r cp_method.r \   cp_except.r cp_expr.r cp_pt.r cp_edsel.r \   cp_xref.r cp_sig.r $(CPLUS_INPUT) cp_spew.r \   cp_error.r cp_errfn.rCPLUS_OBJS = $(CPLUS_OBJS1) $(CPLUS_OBJS2) # Files specific to the C interpreter bytecode compiler(s).BC_OBJS = bc_emit.r bc_optab.r# Language-independent object files.OBJS1 = toplev.r version.r tree.r print_tree.r stor_layout.r fold_const.r \ function.r stmt.r expr.r calls.r expmed.r explow.r optabs.r varasm.rOBJS2 = rtl.r print_rtl.r rtlanal.r sdbout.r dwarfout.r srcdbg.r emit_rtl.r \ insn_emit.r integrate.r jump.r cse.r loop.r unroll.r flow.r stupid.r combine.rOBJS3 = regclass.r local_alloc.r global.r reload.r reload1.r caller_save.r \ insn_peep.r sched.r final.r recog.r reg_stack.rOBJS4 =  insn_recog.r insn_extract.r insn_output.r dbxout.r \ insn_attrtab.r aux_output.r convert.r insn_opinit.r real.rOBJS = $(OBJS1) $(OBJS2) $(OBJS3) $(OBJS4) c_common.r getpwd.r getcd.r# objectes for building the profiler libraryPOBJS = prof.r# GEN files are listed separately, so they can be built before doing parallel#  makes for cc1 or cc1plus.  Otherwise sequent parallel make attempts to load#  them before rtl.r is compiled.GEN= $(ODIR)/genemit $(ODIR)/genoutput $(ODIR)/genrecog $(ODIR)/genextract $(ODIR)/genflags $(ODIR)/gencodes $(ODIR)/genconfig $(ODIR)/genpeepRTL_H = ../rtl.h ../rtl.def ../machmode.h ../machmode.defTREE_H = ../tree.h ../real.h tree.def ../machmode.h ../machmode.defCPLUS_TREE_H = $(TREE_H) cp_tree.h tree.defmake.date: cc2plus    @touch make.dateLLIBS = -l=obstack.r -l=alloca.rCLIBS = -l=$(DD)/LIB/os9lib.l -l=$(DD)/LIB/os9.l \        -l=$(DD)/LIB/gnulib.l -l=$(srcdir)/config/OSK/osk.l -l=$(DD)/LIB/clibn.lSYSLIBS= $(CLIBS) -l=$(DD)/LIB/math.l -l=$(DD)/LIB/sys.lcc2plus: $(CPLUS_OBJS) #$(OBJS) $(BC_OBJS)    @echo -n $(CSTART) $(CPLUS_OBJS) >-$(RDIR)/rfiles_plus    @echo -n $(OBJS1) >+$(RDIR)/rfiles_plus    @echo -n $(OBJS2) >+$(RDIR)/rfiles_plus    @echo -n $(OBJS3) >+$(RDIR)/rfiles_plus    @echo -n $(OBJS4) >+$(RDIR)/rfiles_plus    @echo -n $(BC_OBJS) >+$(RDIR)/rfiles_plus    chd $(RDIR);$(LC) #32K -sm -z=rfiles_plus -o=$(ODIR)/$* -ga -S -e=$(CC2PLUSED) -M=7K \                      $(LLIBS) $(SYSLIBS) -M=$(STK) >-cc2plus.map#   $(CC) $(ALL_CFLAGS) $(LDFLAGS) -o cc1plus $(CPLUS_OBJS) $(OBJS) $(LIBS)# C++ language specific files.cp_parse.r : parse.c $(CPLUS_TREE_H) ../flags.h    $(CC) -c $(ALL_CFLAGS) $(CPPFLAGS) $(INCLUDES) \    -o $(RDIR)/$*.r parse.cparse.c parse.h : parse.y    @echo expect 29 shift/reduce conflicts and 13 reduce/reduce conflicts    $(BISON) $(BISONFLAGS) -d -o parse.c parse.y    grep define parse.c ! grep YYEMPTY >+parse.hcp_repo.r : repo.c $(CPLUS_TREE_H) ../input.h    $(CC) -c $(ALL_CFLAGS) $(CPPFLAGS) $(INCLUDES) \    -o $(RDIR)/$*.r repo.ccp_spew.r : spew.c $(CONFIG_H) $(CPLUS_TREE_H) \   parse.h ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r spew.ccp_lex.r: lex.c $(CONFIG_H) $(CPLUS_TREE_H) \   parse.h input.c ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r lex.c -mlong-callscp_decl.r : decl.c $(CONFIG_H) $(CPLUS_TREE_H) ../flags.h \  parse.h decl.h ../stack.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r decl.c -mlong-callscp_decl2.r : decl2.c $(CONFIG_H) $(CPLUS_TREE_H) ../flags.h \  parse.h decl.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r decl2.ccp_typeck2.r : typeck2.c $(CONFIG_H) $(CPLUS_TREE_H) ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r typeck2.ccp_typeck.r : typeck.c $(CONFIG_H) $(CPLUS_TREE_H) ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r typeck.c -mlong-callscp_class.r : class.c $(CONFIG_H) $(CPLUS_TREE_H) ../stack.h \    class.h ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r class.ccp_call.r : call.c $(CONFIG_H) $(CPLUS_TREE_H) ../stack.h class.h \    ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r call.ccp_init.r : init.c $(CONFIG_H) $(CPLUS_TREE_H) ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r init.ccp_method.r : method.c $(CONFIG_H) $(CPLUS_TREE_H)    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r method.ccp_cvt.r : cvt.c $(CONFIG_H) $(CPLUS_TREE_H)    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r cvt.ccp_sig.r : sig.c $(CONFIG_H) $(CPLUS_TREE_H) ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r sig.ccp_search.r : search.c $(CONFIG_H) $(CPLUS_TREE_H) ../stack.h ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r search.ccp_tree.r : tree.c $(CONFIG_H) $(CPLUS_TREE_H) ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r tree.ccp_ptree.r : ptree.c $(CONFIG_H) $(CPLUS_TREE_H)    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r ptree.ccp_gc.r : gc.c $(CONFIG_H) $(CPLUS_TREE_H) ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r gc.ccp_except.r : except.c $(CONFIG_H) $(CPLUS_TREE_H) ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r except.ccp_expr.r : expr.c $(CONFIG_H) $(CPLUS_TREE_H) $(RTL_H) ../flags.h \  ../expr.h $(TPATH)/insn_codes.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r expr.ccp_edsel.r : edsel.c $(CONFIG_H) $(CPLUS_TREE_H) ../stack.h ../flags.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r edsel.ccp_xref.r : xref.c $(CONFIG_H) $(CPLUS_TREE_H)    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r xref.ccp_pt.r : pt.c $(CONFIG_H) $(CPLUS_TREE_H) decl.h parse.h    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r pt.ccp_error.r : error.c $(CONFIG_H) $(CPLUS_TREE_H)    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r error.ccp_errfn.r : errfn.c $(CONFIG_H) $(CPLUS_TREE_H)    $(CC) -c $(ALL_CFLAGS) $(INCLUDES) -o $(RDIR)/$*.r errfn.cclean:    -$(DEL) *.bak *.ze *.orig *.rej