-t-nxecho -r "make_all    started at " >+make.log;date -m >+make.logtmode nopause -w=1setenv SHELL shellsetenv MWOS /h1/MWOS** cleanup previous versions*makdir CONFIG/OSK/RELSmakdir STAGE0deldir -qf STAGE1makdir STAGE1deldir -qf STAGE2makdir STAGE2deldir -qf LIBGCC1makdir LIBGCC1deldir -qf LIBGCC2_000deldir -qf LIBGCC2_020deldir -qf LIBGCC2_300makdir LIBGCC2_000 LIBGCC2_020 LIBGCC2_300del -f *.l(chd ../gclib/2.7.2;make clean)(chd ../libgpp_2.7.2;make clean)-x** make stages 0..2 and gclib*(chd CONFIG/OSK;make)make_stage0make_gclibmake_stage1make_stage2** test if result ok*cmp stage1/cc2 stage2/cc2 -b500cmp stage1/cc2plus stage2/cc2plus -b500cmp stage1/cc2obj stage2/cc2obj -b500cmp stage1/gcc2 stage2/gcc2 -b500cmp stage1/cccp2 stage2/cccp2 -b500** build the C++ libraries*remove cc2 cc2plus gcc2 cccp2 collectload -d stage1/cc2 stage1/cc2plus stage1/gcc2 stage1/cccp2 stage1/collect(chd ../libgpp_2.7.0;make)** T H E   E N D*echo -r "make_all    done    at " >+make.log;date -m >+make.log