-t** create directories*-nxecho -r "make_all    started at " >+make.log;date -m >+make.logtmode nopause -w=1setenv SHELL shellmakdir OSK/RELSmakdir STAGE0deldir -qf STAGE1makdir STAGE1deldir -qf STAGE1_020makdir STAGE1_020deldir -qf STAGE2makdir STAGE2deldir -qf STAGE2_020makdir STAGE2_020deldir -qf LIBGCC1makdir LIBGCC1deldir -qf LIBGCC2_000 LIBGCC2_020makdir LIBGCC2_000 LIBGCC2_020del -f *.l-x** make stages 0..2 and gclib*(chd OSK;make)make_stage0make_gclibmake_stage1make_stage1_020make_stage2make_stage2_020** test if result ok*cmp stage1/cc2 stage2/cc2 -b500cmp stage1/cc2plus stage2/cc2plus -b500cmp stage1/cc2obj stage2/cc2obj -b500cmp stage1/gcc2 stage2/gcc2 -b500cmp stage1/cccp2 stage2/cccp2 -b500echo -r "make_all    done    at " >+make.log;date -m >+make.log