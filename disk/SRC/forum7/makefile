********************************************************************************	This is the makefile for avl library compilation under OS9********************************************************************************	Default directories*	DDIR =*	SDIR =*	RDIR =*	Compiler, assembler & linker flagsCFLAGS = -t=/r0 -dos9RFLAGS =LFLAGS = -t=/r0 -dos9 -l=/dd/lib/unix.l*	ObjectsObjects = t_trtest.r tree.rIncludes = tree.h vixie.h$(Objects): $(Includes)t_trtest: $(Objects)	cc $(LFLAGS) -f=t_trtest $(Objects)*	End of makefile