********************************************************************************	This is the makefile for config compilation under OS9********************************************************************************	Default directories*	DDIR =*	SDIR =*	RDIR =*	Compiler, assembler & linker flagsCFLAGS = -t=/r0 -dos9 -dSIGNALRFLAGS =LFLAGS = -t=/r0 -dos9 -dSIGNAL -l=/h0/lib/unix.l -l=/dd/lib/termlib.l \		-l=/dd/lib/signal.lconfig.r: config.c	cc $(CFLAGS) -r config.cconfig: config.r	cc $(LFLAGS) -f=config config.r*	End of makefile