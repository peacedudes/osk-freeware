RDIR          = RELSCFLAGS        = -t=/r0/TMP ODIR	      = /dd/USR/CMDSEXTHDRS	      =HDRS	      =LDFLAGS	      = -i -g -M=20LIBS	      = -l=/dd/usr/lib/scrstuff.l -l=/dd/lib/termlib.lLINKER	      = ccPROGRAM       = vcOBJS	      = gram.r sc.r lex.r interpret.r prog.rPRINT	      = prSRCS	      = sc.c gram.c$(PROGRAM):     $(OBJS) $(LIBS)		chd $(RDIR); $(LINKER) $(LDFLAGS) $(OBJS) $(LIBS) -F=$(ODIR)/$(PROGRAM)index: $(OBJS)		ctags -wx $(HDRS) $(SRCS)print: $(OBJS)		@$(PRINT) $(HDRS) $(SRCS)###sc.r: sc.h sc.cgram.r: gram.c sc.hgram.c: gram.y	yacc -f=gram -d -v gram.y	sed<gram.y>-experres.h -f eres.sed;sed<gram.y>-statres.h -f sres.sed	grep define gram.c>-interpret.hlex.r: lex.c sc.h gram.defprog.r: prog.c sc.hinterpret.r: interpret.c sc.h