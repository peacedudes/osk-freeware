## Important constants## If you don't have gcc, then comment out next 2 lines and uncomment the# the 2 lines after them (and then go get gcc :-)#CC = gcc#CFLAGS = -g -OCC = ccCFLAGS = -ODEPENDFILE = dependsPRINTER = chMV = mv## Individual programs#TICKTALK = ticktalkTICKTALK_C = ticktalk.cTICKTALK_H = TICKTALK_O = $(TICKTALK_C:.c=.o)XTICKTALK = xticktalkXTICKTALK_C = ticktalk.cXTICKTALK_H = XTICKTALK_O = xticktalk.oXLIBS = -lXaw -lXmu -lXt -lXext -lX11# Uncomment the following two lines if you are using OpenWindows# XINCLUDEFLAGS = -I/usr/openwin/include# XLIBRARYFLAGS = -L/usr/openwin/libTESTTALK = testtalkTESTTALK_C = ticktalk.cTESTTALK_H = TESTTALK_O = testtalk.o## All the programs#ALL = $(TICKTALK) $(XTICKTALK) $(TESTTALK)ALL_C = $(TICKTALK_C) $(XTICKTALK_C) $(TESTTALK_C)ALL_H = $(TICKTALK_H) $(XTICKTALK_H) $(TESTTALK_H)ALL_O = $(TICKTALK_O) $(XTICKTALK_O) $(TESTTALK_O)## Help user with what this file contains#help: always	@echo "make [target], where [target] is one of:"	@echo "  help - print this message"	@echo "  deps - make the dependicies file"	@echo "  clean - rm object files and temporary files"	@echo "  clobber - do a clean and then remove executables"	@echo "  tags - make tags for all the source files"	@echo ""	@echo "  ticktalk.sh - make a bundle file to send to someone"	@echo "  all - make all the following programs:"	@echo "    ticktalk - a program to print the time in words"	@echo "    xticktalk - a program to display the time in words"	@echo "    testtalk - program to test ticktalk"	@echo ""	@echo " Printing source use (prints to $(PRINTER)):"	@echo "  print-ticktalk - print the source to ticktalk"	@echo "  print-xticktalk - print the source to xticktalk"	@echo "  print-testtalk - print the source to testtalk"## Individual programs#$(TICKTALK): $(TICKTALK_O)	$(CC) -o $(TICKTALK) $(TICKTALK_O)$(TICKTALK_O): $(TICKTALK_C)	$(CC) $(CFLAGS) -c -DTEXT $(TICKTALK_C)print-ticktalk: always	lpscript -t4 -F Makefile $(TICKTALK_H) $(TICKTALK_C) | lpr -P$(PRINTER) $(XTICKTALK): $(XTICKTALK_O)	$(CC) -o $(XTICKTALK) $(XTICKTALK_O) $(XLIBRARYFLAGS) $(XLIBS)$(XTICKTALK_O): $(TICKTALK_C)	$(CC) $(CFLAGS) -c $(XINCLUDEFLAGS) $(TICKTALK_C)	$(MV) $(TICKTALK_O) $(XTICKTALK_O)print-xticktalk: always	lpscript -t4 -F Makefile $(XTICKTALK_H) $(XTICKTALK_C) | lpr -P$(PRINTER) $(TESTTALK): $(TESTTALK_O)	$(CC) -o $(TESTTALK) $(TESTTALK_O)$(TESTTALK_O): $(TICKTALK_C)	$(CC) $(CFLAGS) -DTEST -c $(TICKTALK_C)	$(MV) $(TICKTALK_O) $(TESTTALK_O)print-testtalk: always	lpscript -t4 -F Makefile $(TESTTALK_H) $(TESTTALK_C) | lpr -P$(PRINTER) ticktalk.sh: $(TICKTALK_C) README bundle Makefile xticktalk.xbm	bundle README Makefile $(TICKTALK_C) bundle xticktalk.xbm > ticktalk.sh## For every file#all: $(ALL)deps: always	$(CC) $(CFLAGS) -M $(ALL_C) > $(DEPENDFILE)clean: always	rm -f $(ALL_O) $(DEPENDFILE) core *~ .*~	touch $(DEPENDFILE)	$(MAKE) depsclobber: clean		rm -f $(ALL) ticktalk.shtags: always	etags -t $(ALL_H) $(ALL_C)always:include $(DEPENDFILE)