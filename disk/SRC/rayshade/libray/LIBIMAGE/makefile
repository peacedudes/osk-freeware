OPTIMIZE = -OCCFLAGS =CC = gccRDIR = relsLIB = libimage.lINCLUDE = -I... -I..CFLAGS = $(CCFLAGS) $(INCLUDE) $(OPTIMIZE).c.r:	$(CC) $(CFLAGS) -c -o $(RDIR)/$*.r $*.cOFILES = image.r$(LIB): $(OFILES)	chd $(RDIR);merge -b100 $(OFILES) >-../$(LIB)clean:	-chd $(RDIR); del -f $(OFILES)    -del -f $(LIB)