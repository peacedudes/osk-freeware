OPTIMIZE = -OCCFLAGS =CC = gccRDIR = relsLIB = libobj.lINCLUDE = -I... -I..CFLAGS = $(CCFLAGS) $(INCLUDE) $(OPTIMIZE).c.r:	$(CC) $(CFLAGS) -c -o $(RDIR)/$*.r $*.cOFILES = blob.r bounds.r box.r cone.r csg.r cylinder.r disc.r grid.r \	 hf.r instance.r list.r intersect.r geom.r plane.r poly.r \	 roots.r sphere.r torus.r triangle.r$(LIB): $(OFILES)	chd $(RDIR);merge -b100 $(OFILES) >-../$(LIB)clean:	-chd $(RDIR); del -f $(OFILES)    -del -f $(LIB)