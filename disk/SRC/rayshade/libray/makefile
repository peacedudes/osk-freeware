## Makefile for libray# C. Kolb 1/91## $Id: Makefile,v 4.0.1.1 91/10/10 18:33:41 cek Exp Locker: cek $#-bMAKEFLAGS =CCFLAGS =MAKE = make "CCFLAGS=$(CCFLAGS)" $(MAKEFLAGS)STUFF = libcommon libobj libimage liblight libsurf libtextMERGE = merge -b200default:	chd libcommon; $(MAKE)	chd libobj; $(MAKE)	chd libimage; $(MAKE)	chd liblight; $(MAKE)	chd libsurf; $(MAKE) 	chd libtext; $(MAKE)     @$(MERGE) libcommon/libcommon.l >-libray.l	@$(MERGE) libobj/libobj.l >+libray.l    @$(MERGE) libimage/libimage.l >+libray.l    @$(MERGE) liblight/liblight.l >+libray.l    @$(MERGE) libsurf/libsurf.l >+libray.l    @$(MERGE) libtext/libtext.l >+libray.l## Have to keep clean/depend separete so# Configure will work#clean:	chd libcommon; $(MAKE) -b clean	chd libobj; $(MAKE) -b clean	chd libimage; $(MAKE) -b clean	chd liblight; $(MAKE) -b clean	chd libsurf; $(MAKE) -b clean	chd libtext; $(MAKE) -b clean	del -f libray.l