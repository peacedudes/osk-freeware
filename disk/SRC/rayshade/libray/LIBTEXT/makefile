OPTIMIZE = -OCCFLAGS =CC = gccRDIR = relsLIB = libtext.lINCLUDE = -I... -I..CFLAGS = $(CCFLAGS) $(INCLUDE) $(OPTIMIZE).c.r:	$(CC) $(CFLAGS) -c -o $(RDIR)/$*.r $*.cOFILES = blotch.r bump.r checker.r cloud.r fbm.r fbmbump.r gloss.r \	 imagetext.r mapping.r marble.r mount.r noise.r sky.r stripe.r \	 textaux.r texture.r windy.r wood.r$(LIB): $(OFILES)	chd $(RDIR);merge -b100 $(OFILES) >-../$(LIB)clean:	-chd $(RDIR); del -f $(OFILES)    -del -f $(LIB)