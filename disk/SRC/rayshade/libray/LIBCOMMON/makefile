OPTIMIZE = -OCCFLAGS =CC = gccRDIR = relsLIB = libcommon.lINCLUDE = -I../..CFLAGS = $(CCFLAGS) $(INCLUDE) $(OPTIMIZE).c.r:	$(CC) $(CFLAGS) -c -o $(RDIR)/$*.r $*.cOFILES = memory.r expr.r transform.r rotate.r sampling.r scale.r translate.r \	vecmath.r xform.r$(LIB): $(OFILES)	chd $(RDIR);merge -b100 $(OFILES) >-../$(LIB)clean:	-chd $(RDIR); del -f $(OFILES)    -del -f $(LIB)