OPTIMIZE = -OCCFLAGS =CC = gccYACC = bisonLEX = flexLIBRAYDIR = ../../librayINCLUDE = -I$(LIBRAYDIR) -I...CFLAGS = $(CCFLAGS) $(INCLUDE) $(OPTIMIZE)LIBS =YFLAGS = -dXFLAGS =RDIR = rels.c.r:	$(CC) $(CFLAGS) -c -o $(RDIR)/$*.r $*.cCFILES = main.c yacc.c lex.cOBJS = main.r yacc.r lex.rDEPENDSRC = main.c yacc.y lex.lrsconvert: $(OBJS)	chd $(RDIR);$(CC) $(CFLAGS) -o ../rsconvert $(OBJS) $(LIBS)clean:    -del -f yacc.c lex.c y.tab.h    -chd $(RDIR);del -f $(OBJS)yacc.r: yacc.clex.r: lex.cyacc.c: yacc.y	$(YACC) $(YFLAGS) $*.y	move -r $*.tab.c $*.c	move -r $*.tab.h y.tab.hlex.c: lex.l	$(LEX) $(XFLAGS) $*.l	move -r lex.yy.c lex.c