## Makefile for rayshade distribution# C. Kolb 1/91## $Id: Makefile,v 4.0.1.1 91/10/10 18:33:14 cek Exp Locker: cek $#-bMAKEFLAGS = "CCFLAGS = -mc68040 -mlong-calls -ob"MAKE = make $(MAKEFLAGS)STUFF = libray libshade rayshade etcCMDS = ../cmdsdefault:    chd libray; $(MAKE)    chd libshade; $(MAKE)    chd rayshade; $(MAKE)    chd etc; $(MAKE)## Have to keep clean/depend separete so# Configure will work#install:    copy -b100 -rw=$(CMDS) rayshade/rayshade*    copy -b100 -rw=$(CMDS) etc/rsconvert/rsconvertclean:    chd libray; $(MAKE) -b clean    chd libshade; $(MAKE) -b clean    chd rayshade; $(MAKE) -b clean    chd etc; $(MAKE) -b clean