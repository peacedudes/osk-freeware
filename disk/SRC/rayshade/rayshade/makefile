BINDIR =OPTIMIZE = -OURTINC =CCFLAGS =URTLIB =LDFLAGS = -s 1000 -gCC = gccYACC = bisonLIBRAYDIR = ../librayLIBSHADEDIR = ../libshadeINCLUDE = -I$(LIBRAYDIR) -I$(LIBSHADEDIR) -I.. $(URTINC)YFLAGS = -dRDIR = relsLIBRAY = $(LIBRAYDIR)/libray.lLIBSHADE = $(LIBSHADEDIR)/libshade.lCFLAGS = $(CCFLAGS) $(INCLUDE) $(OPTIMIZE).c.r:	$(CC) $(CFLAGS) -c -o $(RDIR)/$*.r $*.cLIBS = $(LIBSHADE) $(LIBRAY) $(URTLIB)_LIBS = ../$(LIBSHADE) ../$(LIBRAY) $(URTLIB) -lunix.l -los9lib.l /dd/lib/libm040.lDRIVE_C =	main.c raytrace.c version.cDRIVE_H =	raytrace.hDRIVE_O = 	main.r raytrace.r version.rHFILES = $(DRIVE_H)CFILES = $(DRIVE_C)OBJ = $(DRIVE_O)DEPENDSRC = $(DRIVE_C)## Change $(CC) below to $(CLC) if using Linda.#rayshade: $(OBJ) $(LIBS)	chd $(RDIR);$(CC) $(OPTIMIZE) -o ../rayshade $(OBJ) $(_LIBS) $(LDFLAGS)clean:	chd $(RDIR);del -f $(OBJ)realclean:	chd $(RDIR);del -f $(OBJ)        del -f y.tab.h	del -f *.orig