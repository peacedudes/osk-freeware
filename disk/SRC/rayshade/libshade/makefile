OPTIMIZE = -O -Dfputc=putcURTINC =CCFLAGS =CC = gccYACC = bisonLEX = flexLIBRAYDIR = ../librayINCLUDE = -I.. -I$(LIBRAYDIR)YFLAGS = -dXFLAGS = -LRDIR = relsCFLAGS = $(CCFLAGS) $(URTINC) $(INCLUDE) $(OPTIMIZE).c.r:	$(CC) $(CFLAGS) -c -o $(RDIR)/$*.r $*.cLIB = libshade.lSUPPORT_C =	builtin.c symtab.c misc.c lightdef.c objdef.c options.c \		stats.c surfdef.cSUPPORT_H =	../config.h datatypes.h funcdefs.h \		../patchlevel.h rayshade.hPARSE_C =	yacc.c lex.cDRIVE_C =	setup.c viewing.c shade.c picture.cDRIVE_H =	y.tab.h defaults.h viewing.h raytrace.h picture.hSUPPORT_O =	builtin.r symtab.r misc.r lightdef.r objdef.r options.r \		stats.r surfdef.rPARSE_O = 	yacc.r lex.rDRIVE_O =	setup.r viewing.r shade.r picture.rHFILES = $(DRIVE_H) $(SUPPORT_H)CFILES = $(DRIVE_C) $(PARSE_C) $(SUPPORT_C)OFILES = $(DRIVE_O) $(PARSE_O) $(SUPPORT_O)DEPENDSRC = $(DRIVE_C) lex.l yacc.y $(SUPPORT_C)$(LIB): $(OFILES)	chd $(RDIR);merge -b100 >-../$(LIB) $(OFILES)clean:	chd $(RDIR);del -f $(OFILES)	del -f $(LIB)realclean:	chd $(RDIR);del -f $(OFILES)	del -f $(LIB) y.tab.h	del -f *.origyacc.r: yacc.clex.r: lex.cyacc.c: yacc.y	$(YACC) $(YFLAGS) $*.y	move -r y.tab.c yacc.clex.c: lex.l	$(LEX) $(XFLAGS) $*.l	move -r lex.yy.c lex.c