# Lander Makefile# System 5.3## OSV=SYS5_3# LIBS= -lcurses -lm# RAND_L=RAND_SYS5# BSD Unix##OSV=BSD#LIBS= -lcurses -ltermcap -lm#RAND_L=RAND_BSD# System 5.2 or earlier (untested but should work)## OSV=BSD# LIBS= -lcurses -lm# RAND_L=RAND_SYS5# OS-9/68k#ODIR=/h0/cmds/dogRDIR=RELSOSV=BSDLIBS= -l=/dd/lib/curses.l -l=/dd/lib/termlib.l -l=/dd/lib/math.l -l=/dd/lib/unix.lRAND_L=RAND_BSD# high score file name - change for your systemHSFILE= /h0/games/lander.hsOBJS= land.r screen.r move.r score.rSRC= land.c screen.c move.c score.cINC= consts.h funcs.h#BIN= $(HOME)/binOPT= -qixm=16k -t=/r0HSSTRING="$(HSFILE)"CFLAGS= $(OPT) -D$(RAND_L) -DHS_FILE=$(HSSTRING) -D$(OSV)lander: $(OBJS)	chd $(RDIR); cc -f=lander $(CFLAGS) $(OBJS) $(LIBS)$(OBJS): consts.h