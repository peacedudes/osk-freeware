# Makefile for blarslibHOSTNAME = "blars"CFLAGS = -t=/r0 -v=/h0/blarslib/defs# normal assemblyOBJS1 = alarm.r atan2.r bstring.r ctermid.r exec.r fsync.r ftime.r getcwd.r\ getgid.r getopt.r getpw.r getwd.r isatty.r makenv.r mkdir.r \ perror.r popen.r putenv.r rand.r signal.r stat.r \ strchr.r strcspn.r strpbrk.r strrchr.r strspn.r strtok.r times.r \ ttyname.r umask.r usleep.r utime.r vfprintf.r vsprintf.r# require special assemblyOBJS2 =  alloca.r gethostname.r link.rOBJS = $(OBJS1) $(OBJS2)blarslib: $(OBJS)  merge $(OBJS) >-/h0/blarslib/blarslib.l$(OBJS1):alloca.r:  cc $(CFLAGS) -r -dSTACKDIR=-1 alloca.cgethostname.r:  cc $(CFLAGS) -r -dHOSTNAME=$(HOSTNAME) $*.clink.r: ln.c  cc $(CFLAGS) -r -dlink=link -fd=link ln.c  rm -f link.r  rename link link.r