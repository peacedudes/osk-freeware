* Hilfs-Funktionen fuer Ptyman, da malloc() nicht verwendet werden kann** _srqmem( size )_srqmem: move.l a2,-(sp)  OS9 F$SRqMem bcc.s _srqmem90 move.l d1,errno(a6) moveq.l #0,d0_srqmem91 move.l (sp)+,a2 rts_srqmem90 move.l a2,d0 bra.s _srqmem91* _srtmem(addr, size)_srtmem: move.l a2,-(sp) move.l d0,a2 move.l d1,d0 OS9 F$SRtMem bcc.s _srtmem90 move.l d1,errno(a6) moveq.l #-1,d0_srtmem91 move.l (sp)+,a2 rts_srtmem90 moveq.l #0,d0 bra.s _srtmem91* wait for pid to finish I/O ( 0 --> free )iowait:    tst.w d0    beq.s io1    moveq.l #0,d1    os9 F$IOQu    move.l d1,d0io1    rts* getctrlchar(ch,pd) -- return control-char-index in d0getctrlchar: cmp.b #32,d0 bge.s g1 tst.b d0 beq.s g1 move.l d1,a0 lea PD_BSP(a0),a0  * start of ctl-char array moveq.l #8,d1      * lengthg2 cmp.b (a0)+,d0 beq.s g3 dbra d1,g2 addq.l #6,a0       * point to _xon moveq.l #2,d1      * 2 values to compare cmp.b (a0)+,d0 beq.s g5 moveq.l #1,d1 cmp.b (a0)+,d0 beq.s g5g1 clr.l d0 rtsg3 neg d1             * compute indexg5 add.w #9,d1 move.w d1,d0 rtsstrcmp:  movea.l d0,a1      * simple strcmp movea.l d1,a0 moveq.l #0,d0 :2 move.l d0,d1 bra.s _6_4 tst.b (a1) :2 beq.s _3_9_7_6 cmpm.b (a0)+,(a1)+ :2 beq.s _4_5 subq.l #1,a0 subq.l #1,a1 move.b (a0),d0 :2 move.b (a1),d1 :2 sub.l d0,d1 :2 move.l d1,d0 :2_3 rts :2memcpy:    move.l d0,a1        * simple memcpy    move.l d1,a0    move.l 4(a7),d0m1    move.b (a0)+,(a1)+    dbra d0,m1    rts* initbufinitbuf:    move.l d0,a0            * dont change this Function !!!!!    lea in2(pc),a1in1    move.b (a1)+,d0    not.b d0    cmpi.b #$d,d0    beq.s in3    move.b d0,(a0)+    dbra d1,in1in3    move.b d0,(a0)+    dbra d1,in3    rtsin2    dc.b ^' ',^'b',^'y',^' ',^'R',^'e',^'i',^'m'    * dont change !!    dc.b ^'e',^'r',^' ',^'A',^'.',^' ',^'M',^'e'    dc.b ^'l',^'l',^'i',^'n',^$d    alignkill:    tst.w d0    beq.s k1    os9 F$Sendk1    rts ends