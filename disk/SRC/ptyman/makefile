# Options:#   ST      The Cumana Implementation of OSK supports a BlkWr-like#           SetStat-Call, implement this#OPTIONS = -DST##RDIR      = RELSCFLAGS    = -t=/dd -S $(OPTIONS)LFLAGS    = -g SYSLIB    = -l=/h0/LIB/sys.lCLIB      = -l=/h0/LIB/clib.lOBJS    = cpty.r ptyman.r funcs.r miscasm.rLIBOBJS =PtyMan: $(OBJS) ptyman.h  chd $(RDIR); l68 -O=../$@ $(OBJS) $(CLIB) $(SYSLIB) $(LFLAGS) -s >-../$@.mapPtyDrv: ptydrv.r ptystat.r  chd $(RDIR); l68 -O=../$@ $(SYSLIB) ptystat.r \                   $@.r $(LFLAGS)pty: pty.r  chd $(RDIR); l68 -n=$@ -O=../$@ $(SYSLIB) $@.rtty: tty.r	chd $(RDIR); l68 -n=$@ -O=../$@ $(SYSLIB) $@.rbindist.shar: ptyman pty tty ptydrv	uuencode ptyman >-ptyman.uu	uuencode pty >-pty.uu	uuencode tty >-tty.uu	uuencode ptydrv >-ptydrv.uu	shar COPYRIGHT ptyman.doc *.uu >-bindist.shar	del *.uusrcdist: cpty.a ptyman.c funcs.c miscasm.a pty.a tty.a ptydrv.a ptystat.a ptyman.h misc.h makefile ptydev.a 	makekit -i MANIFEST.SRC -o MANIFEST.SRC COPYRIGHT ptyman.doc cpty.a ptyman.c funcs.c miscasm.a pty.a tty.a \	ptydrv.a ptystat.a ptyman.h misc.h makefile ptydev.a        del MANIFEST.SRCclean: makefile	del rels/*	del ptyman tty pty ptydrv *.stb *.map	touch makefileco:	co cpty.a ptyman.c funcs.c miscasm.a pty.a tty.a ptydrv.a \	ptystat.a ptyman.h misc.h makefile ptydev.a ci:	ci -u cpty.a ptyman.c funcs.c miscasm.a pty.a tty.a ptydrv.a \	ptystat.a ptyman.h misc.h makefile ptydev.a 