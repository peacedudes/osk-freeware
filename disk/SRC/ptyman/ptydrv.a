)<<8+0 psect ptydrv,Typ_Lang,Attr_Rev,Edition,0,Entry use defsfile page******************** Einsprungstabelle* total dummy driverEntry dc.w Init dc.w Read dc.w Write dc.w GetStat dc.w PutStat dc.w TermNat dc.w 0,0,0,0 alignInit:Read:Write: TermNat: move.w #0,d0 rtsGetStat:PutStat: move.w #E$UnkSvc,d1 ori.w #Carry,ccr rts