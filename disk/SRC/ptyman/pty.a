fsfileTypeLang set (Devic<<8)+0Att_Revs set (ReEnt)<<8)+0 psect pty,TypeLang,Att_Revs,Edition,0,0 dc.l 0 no port address dc.b 0 no trap assignment dc.b 0 no IRQ hardware interrupt level dc.b 0 0 no polling priority dc.b Dir_+Share_+ISize_+PUpdat_+Updat_ device mode capabilities dc.w PtyMgr file manager name offset dc.w PtyDrv device driver name offset dc.w 0 DevCon dc.w 0,0,0,0 reserved dc.w OptLen option byte countOptTbl dc.b 0 its a SCF-like device dc.b 0 PD_UPC dc.b 0 PD_BSO dc.b 0 PD_DLO dc.b 0 PD_EKO dc.b 0 PD_ALF dc.b 0 PD_NUL dc.b 0 PD_PAU dc.b 0 PD_PAG dc.b 0 PD_BSP dc.b 0 PD_DEL dc.b 0 PD_EOR dc.b 0 PD_EOF dc.b 0 PD_RPR dc.b 0 PD_DUP dc.b 0 PD_PSC dc.b 0 PD_INT dc.b 0 PD_QUT dc.b 0 PD_BSE dc.b 0 PD_OVF dc.b 0 PD_PAR dc.b 0 PD_BAU dc.w 0 dc.b 0 PD_XON dc.b 0 PD_XOFF dc.b 0 PD_TAB dc.b 0 PD_TABS OptLen equ *-OptTblPtyMgr dc.b "PtyMan",0  file managerPtyDrv dc.b "PtyDrv",0  device driver ends