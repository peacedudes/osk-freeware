{Omegasoft-Pascal/OS-9              W.Stehling}PROGRAM  pri (input, output);VAR     namen           : String[252];        comm            : String[32];        error, type_Id  : HEX;{$I/h0/pascal/pdef/os9calls}BEGIN  namen := cline (0);              {liest die Fileliste von der Kommandozeile}  comm  := '/r0/cmds/copy';                 { Kopierbefehl                   }  namen := Concat ('-w=/r0/list ', namen);  {kopiert die Files nach /r0/LIST }  error := f_chain (namen, comm, 200, 0, $0L, type_Id);  IF  error <> 0  THEN    WriteLn ('error in pri : ', error);      END.      