+/* set file buffering modes
+ *
+ * The port's original body was
+ *
+ *     case _IONBF: stream->_flag |= _UNBUF; break;
+ *     default:     stream->_flag &= ~_UNBUF; break;
+ *
+ * which was right for an older library where _UNBUF was the only buffering
+ * bit there was.  This one has three -- <stdio.h> defines _IONBF 0x0004,
+ * _IOLBF 0x0800 and _IOFBF 0x1000, with _BUFMASK 0x1804 covering all of them
+ * -- and `putc' is a MACRO that reads them:
+ *
+ *     #define putc(c,p) (((p)->_ptr >= (p)->_end || \
+ *                        (((p)->_flag & _IOLBF) && (c)=='\n')) \
+ *                        ? _flshbuf((p),(c)) : ... )
+ *
+ * So clearing _UNBUF and setting nothing left the stream with NO buffering
+ * mode at all, and output went astray.  Clear the whole mask, then set the
+ * one mode asked for.
+ */
