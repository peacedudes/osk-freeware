         nam       IReadT         ttl       Does I$Read honour the end-of-record character?* -------------------------------------------------------------------* Microware's OS-9/68000 Technical Reference, I$Read:**   d1.l in  = MAXIMUM number of bytes to read*   d1.l out = number of bytes ACTUALLY read*   "The number of bytes requested is read unless: the end-of-file is*    reached; an end-of-record occurs (SCF only); an error occurs."*   "SCF devices usually terminate the read when a carriage return is*    reached."** So a 256-byte I$Read on a terminal should come back when Return is* pressed, having read only what was typed.** Pure assembly on purpose.  No C, no cio, no library: nothing sits* between this and the syscall that could explain the result away.  The* path is left exactly as the shell handed it over -- no I$SetStt, so* nothing here disables or alters PD_EOR.* -------------------------------------------------------------------         use       <oskdefs.d>Edition  equ       1Typ_Lang equ       (Prgrm<<8)+ObjctAttr_Rev equ       (ReEnt<<8)StdIn    equ       0StdOut   equ       1FExit    equ       $06IRead    equ       $89IWritLn  equ       $8C         psect     ireadt,Typ_Lang,Attr_Rev,Edition,1024,entry         vsectbuff     ds.b      300         endsentry:* ---- step one: ask for ONE byte -------------------------------------         lea       msg1(pc),a0         move.w    #StdOut,d0         move.l    #msg1e-msg1,d1         os9       IWritLn         move.w    #StdIn,d0         lea       buff(a6),a0         move.l    #1,d1         os9       IRead         bcs.s     failed         lea       got1(pc),a0         move.w    #StdOut,d0         move.l    #got1e-got1,d1         os9       IWritLn* ---- step two: ask for 256 bytes ------------------------------------         lea       msg2(pc),a0         move.w    #StdOut,d0         move.l    #msg2e-msg2,d1         os9       IWritLn         move.w    #StdIn,d0         lea       buff(a6),a0         move.l    #256,d1         os9       IRead         bcs.s     failed* d1.l now holds the count actually read.  Echo the bytes back, so the* result is visible without any number formatting.         move.l    d1,d2         lea       got2(pc),a0         move.w    #StdOut,d0         move.l    #got2e-got2,d1         os9       IWritLn         move.w    #StdOut,d0         lea       buff(a6),a0         move.l    d2,d1         os9       IWritLn         moveq     #0,d1         os9       FExitfailed:         lea       ebad(pc),a0         move.w    #StdOut,d0         move.l    #ebade-ebad,d1         os9       IWritLn         moveq     #1,d1         os9       FExitmsg1     dc.b      "A: I$Read for 1 byte -- press a key",$0Dmsg1e    equ       *got1     dc.b      "A: returned",$0Dgot1e    equ       *msg2     dc.b      "B: I$Read for 256 bytes -- type a line, press return",$0Dmsg2e    equ       *got2     dc.b      "B: returned, bytes follow ->",$0Dgot2e    equ       *ebad     dc.b      "I$Read reported an error",$0Debade    equ       *         ends