         nam       EorTest         ttl       Does I$ReadLn honour PD_EOR, or assume carriage return?* -------------------------------------------------------------------* v2.4 Technical Reference, PD_EOR:*   "Defines the last character on each line entered (I$Read, I$ReadLn)."** So a program may change it.  This sets PD_EOR to LINEFEED and then calls* I$ReadLn.  Type a line ending in CARRIAGE RETURN:**   honouring PD_EOR  -> the read does NOT end (CR is no longer the*                        terminator); the manual's own WARNING says so*   assuming CR       -> the read ends anyway, and PD_EOR was ignored** Pure assembly, no library.* -------------------------------------------------------------------         use       <oskdefs.d>Edition  equ       1Typ_Lang equ       (Prgrm<<8)+ObjctAttr_Rev equ       (ReEnt<<8)StdIn    equ       0StdOut   equ       1FExit    equ       $06IReadLn  equ       $8BIWritLn  equ       $8CIGetStt  equ       $8DISetStt  equ       $8ESSOpt    equ       0PDEOR    equ       $0B                 offset of PD_EOR in the option tableLF       equ       $0A         psect     eortest,Typ_Lang,Attr_Rev,Edition,1024,entry         vsectoptbuf   ds.b      128buff     ds.b      300         endsentry:         lea       msg1(pc),a0         move.w    #StdOut,d0         move.l    #msg1e-msg1,d1         os9       IWritLn* ---- read the path options, set PD_EOR to LF, write them back --------         move.w    #StdIn,d0         move.w    #SSOpt,d1         lea       optbuf(a6),a0         os9       IGetStt         bcs.s     failed         move.b    #LF,PDEOR+optbuf(a6)      PD_EOR = linefeed         move.w    #StdIn,d0         move.w    #SSOpt,d1         lea       optbuf(a6),a0         os9       ISetStt         bcs.s     failed         lea       msg2(pc),a0         move.w    #StdOut,d0         move.l    #msg2e-msg2,d1         os9       IWritLn* ---- now read a line.  Type text then CARRIAGE RETURN ----------------         move.w    #StdIn,d0         lea       buff(a6),a0         move.l    #256,d1         os9       IReadLn         bcs.s     failed         lea       got(pc),a0         move.w    #StdOut,d0         move.l    #gote-got,d1         os9       IWritLn         moveq     #0,d1         os9       FExitfailed:         lea       ebad(pc),a0         move.w    #StdOut,d0         move.l    #ebade-ebad,d1         os9       IWritLn         moveq     #1,d1         os9       FExitmsg1     dc.b      "setting PD_EOR to LINEFEED",$0Dmsg1e    equ       *msg2     dc.b      "now type text and press RETURN (a CR, not a LF)",$0Dmsg2e    equ       *got      dc.b      "I$ReadLn RETURNED -- so it used CR and ignored PD_EOR",$0Dgote     equ       *ebad     dc.b      "a getstat/setstat/read reported an error",$0Debade    equ       *         ends