name    advint
prog    advint osample
# RECORDED AS UNPLAYABLE UNTIL 2026-08-29 -- "no compiled world ships, and
# building one needs a shell with a real chd".  The first half was true and
# the second was not: advcom's two limits are that it opens its `@objects.adi'
# include by BARE NAME in the data directory, and that it holds a filename in
# 20 characters.  Neither is about changing directory.  Put both files where
# the data directory already is, use the short name, and bash compiles it.
setup   cat /dd/GAMES/ADVSYS/osample.adv > /dd/osample.adv
setup   cat /dd/GAMES/ADVSYS/objects.adi > /dd/objects.adi
setup   advcom osample > /nil
rate    0.7
wait    10
keys    look
key     \r
wait    6
keys    n
key     \r
wait    6
keys    look
key     \r
wait    8
expect  ADVINT v1.2
expect  Welcome to the sample adventure
expect  This appears to be the livingroom
# `n' has to actually move you, or the two `look's would read the same.
expect  long narrow hallway
