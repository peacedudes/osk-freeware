name    travesty
prog    travesty
# DOC/INDEX: "make a travesty of the input -- Markov chains, DJB".  A FILTER:
# it reads standard input, so it prints nothing until fed.
rate    0.3
wait    5
keys    the quick brown fox jumps over the lazy dog and the quick red fox
key     \r
keys    runs over the lazy brown dog while the quick dog naps
key     \r
wait    3
key     \004
wait    3
snap    output
