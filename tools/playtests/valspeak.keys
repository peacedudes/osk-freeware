name    valspeak
prog    valspeak
# CONFIRMED BROKEN, 2026-08-27.  DOC/INDEX calls it a "Valley-speak text
# filter", but it produces nothing under any invocation tried: bare, with
# `-?', with a file argument, and with standard input redirected from a file.
# It exits at once every time.  Agrees with the 2026-08-26 sweep's NEEDS WORK.
rate    0.4
wait    5
keys    this is a totally excellent computer
key     \r
wait    3
snap    output
key     \004
wait    2
