name    gnuchessc
prog    gnuchessc
# GNU Chess with the curses display -- and on this terminal it draws no board
# at all: it announces itself as `Chess', takes the move and answers with its
# own.  `gnuchess' is the build that draws the board; this one plays.
rate    0.5
wait    6
snap    board
keys    e2e4
key     \r
wait    12
snap    played
expect  My move is
