name    cribbage
prog    cribbage
# BSD cribbage: the cut, and a hand dealt.
rate    0.6
wait    6
key     n
key     \r
wait    3
key     s
key     \r
# Wait for the dealt hand rather than a fixed time: under load the deal
# came later than five seconds and the snap caught the screen before it.
until   +-----+
snap    hand
key     \003
wait    2
expect  +-----+
