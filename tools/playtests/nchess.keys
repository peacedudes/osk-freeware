name    nchess
prog    /dd/CMDS/GAMES/nchess
# GNU Chess 4.0 with the plain display -- the board as characters, which is
# how it was played over a serial line.  It answers a move by thinking out
# loud: depth, score, nodes and the line it is considering.
rate    0.5
wait    6
snap    opening
keys    e2e4
key     \r
wait    12
snap    thinking
expect  Your move is
