name    chemtab
prog    chemtab
# Past the title and the two questions, iron by its symbol, the table, quit.
rate    0.8
wait    4
key     \s
wait    2
key     n
wait    1
key     n
wait    4
snap    menu
key     1
wait    2
key     3
wait    1
keys    Fe
key     \r
wait    4
snap    iron
key     \s
wait    2
key     4
wait    4
snap    table
key     \s
wait    2
key     6
wait    4
expect  iron
expect  Angstroms
expect  Lanthanides
