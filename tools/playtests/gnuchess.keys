name    gnuchess
prog    gnuchess
# THIS WAS KEPT FAILING ON PURPOSE UNTIL 2026-08-29, on a wrong diagnosis:
# `'vt100': Unknown terminal type.' was read as wanting a TERMINFO database
# the disk does not have.  It is not that.  This build's termcap library
# reads TERMCAP as the CAPABILITY STRING ITSELF rather than as the name of a
# file, so the TERMCAP=/dd/SYS/termcap that SYS/login sets -- and that the
# other ~74 termcap programs need -- reaches it as a terminal name.
# SYS/termcap.entry exists for exactly this, and DOC/howto knew; sourcing it
# makes the program draw a board, keep both clocks and play.
setup   . /dd/SYS/termcap.entry
rate    0.5
wait    8
# It opens on a menu of time controls, not on the board.
keys    1
key     \r
wait    10
keys    e2e4
key     \r
wait    12
expect  My move is
expect  Your move is
