name    hack
# HACK MUST BE GIVEN ITS FULL PATH.  Run by bare name it stops with `Cannot
# get status of hack.' -- it stats its own argv[0] to find its playground.
# Everything else here is typed the way a person types it.
prog    /dd/CMDS/GAMES/hack
# "Who are you?" -> name; "experienced player?" -> y; then pick a class.
# F is Fighter, who starts with weapons and armour, so the inventory is
# worth photographing.  'i' opens it.
rate    0.5
wait    5
keys    rodney
key     \r
wait    3
key     y
wait    3
key     F
wait    5
key     \s
wait    2
snap    dungeon
key     i
wait    3
snap    inventory
expect  --More--
