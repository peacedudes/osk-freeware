name    editor
prog    editor /dd/DOC
# UMACS-SHELL: a file PICKER, not a plain editor -- it wants a
# DIRECTORY and lists it for you to choose from.  Given a file it
# answers "can't open", which is correct behaviour, not a fault.
allow   trap handler
allow   Can't open
rate    0.6
wait    5
snap    opened
wait    2
key     \003
wait    2
