name    vcraps
prog    vcraps
# Clear the three welcome messages, bet $10 on the pass line, roll, quit.
rate    0.6
wait    4
key     \s
wait    1
key     \s
wait    1
key     \s
wait    2
key     p
wait    1
keys    10
key     \r
wait    2
snap    bet
key     r
wait    6
snap    rolled
key     \s
wait    1
key     \s
wait    1
key     X
wait    3
expect  Bankroll
expect  990
