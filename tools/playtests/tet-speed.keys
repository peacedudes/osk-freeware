name    tet-speed
prog    tet
# Start play, then photograph the board every 3 seconds without touching it.
# A piece falling at 1.5s a cell should be about 2 cells lower each time.
wait    3
key     p
wait    3
snap    t03
wait    3
snap    t06
wait    3
snap    t09
wait    3
snap    t12
key     q
wait    2
expect  HIGH SCORES
