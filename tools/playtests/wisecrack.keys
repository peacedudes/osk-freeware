name    wisecrack
prog    /dd/CMDS/cat /pipe/txtpipe
# wisecrack WRITES to /pipe/txtpipe and prints nothing itself -- it is a
# message ticker, not a program with a screen.  DOC/STATUS said so; this
# proves it.  The writer has to start FIRST: the named pipe does not exist
# until something creates it, so reading first fails with E_PNNF (216).
setup   /dd/CMDS/GAMES/wisecrack &
rate    0.5
wait    6
snap    ticker
wait    2
key     \003
wait    2
expect  COVE
