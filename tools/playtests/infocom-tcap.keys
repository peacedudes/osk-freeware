name    infocom-tcap
prog    infocom.tcap /dd/GAMES/INFORM/dejavu.z3
# The termcap build of the Infocom interpreter, playing the story file that
# ships in GAMES/INFORM.  Two commands typed at its prompt; a Z-machine that
# is reading is one that answers a verb it knows with something new.
rate    0.35
wait    10
snap    opening
keys    look
key     \r
wait    6
keys    take cube
key     \r
wait    6
snap    played
expect  cube
