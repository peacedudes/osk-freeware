name    hang
prog    hang
# Hangman.  It clears the screen when the game ends, so the FINAL frame is
# bare -- the snapshots are what show it working.
rate    0.8
wait    4
snap    opening
keys    aeiou
wait    2
snap    guessed
keys    rstln
wait    2
snap    more
key     \003
wait    2
expect  Unused Letters
