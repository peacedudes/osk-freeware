name    sod
prog    sod -l1
# Easiest level: step right, right, down, and look at the counts left behind.
rate    0.5
size    24 80
wait    5
snap    start
key     l
wait    2
key     l
wait    2
key     j
wait    3
snap    walked
key     q
wait    3
key     \r
wait    3
snap    quit
# Not `>0<': the board is dealt at random and there is no seed, so the
# count under you is whatever the deal gives, and a walk can end in the
# swamp.  It failed on that alone, now and then (2026-09-28).
expect  X
expect  Scoretable for level 1
