name    sysmon
prog    sysmon 2>/nil
# The Process Monitor: Y creates SYS/nodedef, a node name, then its CPU bars.
# Needs os9exec 143152b or later, where F$GPrDsc refuses ids past its table.
rate    0.6
size    30 80
wait    6
key     Y
wait    4
keys    osk
key     \r
wait    12
snap    monitor
key     \003
wait    3
expect  Process Monitor
expect  CPU IDLE
