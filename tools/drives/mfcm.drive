# mfcm -- Computer Modern, and the invocation maketexpk uses.
#
# cmbase.base is the SECOND base SYS/TEX/MFBASES/install.script asks for and
# it now ships beside plain.base.  cmr10 renders: 128 characters, in seconds.
#
# The job name is the one thing that is not obvious.  A command line of
# `&cmbase' alone leaves it at `mfput', so the output is mfput.120gf whatever
# the font was -- and that is not a fault, it is Metafont taking its job name
# from a file named on the COMMAND LINE.  `maketexpk' on this disk carries
# the invocation that gets it right, in its own strings:
#
#   virmf '&plain \scrollmode; \mode:=%s; \mag:=%s; \input %s; \end'
#
# `\input' with the backslash is what names the job.  (maketexpk itself then
# calls `makdir', `del' and `attr', which are Microware's and are not here,
# so run the virmf line yourself rather than the script.)

family  mfcm

setup   export TERM=vt100
setup   W=/dd/tmp/MFCM
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   export MFINPUTS=.:/dd/SYS/TEX/MFINPUTS/CM:/dd/SYS/TEX/MFINPUTS
setup   export GFFONTS=$W
setup   export PKFONTS=$W

drive   the-shipped-bases
run     /dd/CMDS/ls -l /dd/SYS/TEX/MFBASES
run     echo "--- end"

drive   maketexpks-own-line
why     with \input, so the job name is the font's name.
run     echo "\\scrollmode; \\mode:=epsonlo; \\mag:=1; \\input cmr10; \\end" > $W/r.mf
run     /dd/CMDS/cat $W/r.mf
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/virmf '&cmbase' < r.mf"
run     /dd/CMDS/ls -l $W
run     echo "--- end maketexpk-line-on-stdin"

drive   the-same-line-as-an-ARGUMENT
why     Metafont takes its job name from the COMMAND LINE, and the line
why     above went in on standard input, which is not the same thing.
why     maketexpk passes it as an argument, so try that.
run     /dd/CMDS/rm -f $W/mfput.120gf $W/mfput.tfm $W/mfput.log
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/virmf '&cmbase' '\\scrollmode; \\mode:=epsonlo; \\input cmr10; \\end'"
run     /dd/CMDS/ls -l $W
run     echo "--- end maketexpk-line-as-argument"

drive   and-then-a-pk
run     /dd/CMDS/TEXCMDS/gftopk cmr10.120gf $W/cmr10.120pk
run     /dd/CMDS/TEXCMDS/pktype cmr10.120pk > $W/pt.txt 2>&1
run     /dd/CMDS/head -n 12 $W/pt.txt
run     /dd/CMDS/wc -c $W/cmr10.120gf $W/cmr10.120pk
run     echo "--- end"
