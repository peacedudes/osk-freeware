# rcs2 -- RCS again, with a second between the two check-ins.
#
# The first run's second `ci' failed with "Date ... is not later than ... in
# existing revision 1.1": both check-ins landed inside the same clock second.
# That is not a broken program, it is a harness running faster than the
# clock's resolution -- and it is worth pinning, because a test suite that
# does everything in one second would meet it again.

family  rcs2

setup   W=/dd/tmp/RCS2
setup   /dd/CMDS/mkdir /dd/tmp/RCS2
setup   /dd/CMDS/cp /dd/SYS/motd $W/note.txt
setup   /dd/CMDS/printf 'a first note\r.\r' > /dd/tmp/d1
setup   /dd/CMDS/printf 'second revision\r.\r' > /dd/tmp/d2

drive   two-revisions-a-second-apart
run     /dd/CMDS/ci $W/note.txt < /dd/tmp/d1
run     /dd/CMDS/co -l $W/note.txt
run     echo "a second line" >> $W/note.txt
run     /dd/CMDS/sleep 2
run     /dd/CMDS/ci $W/note.txt < /dd/tmp/d2
run     echo "--- rlog now:"
run     /dd/CMDS/rlog $W/note.txt

drive   rcsdiff
run     /dd/CMDS/rcsdiff -r1.1 -r1.2 $W/note.txt

drive   rcsmerge
run     /dd/CMDS/co $W/note.txt
run     /dd/CMDS/rcsmerge -r1.1 -r1.2 $W/note.txt
run     /dd/CMDS/cat $W/note.txt

drive   rcsident
why     it wants <file>,v and OS-9 names the archive <file>_v
run     /dd/CMDS/rcsident $W/note.txt_v
