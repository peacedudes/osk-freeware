# dvifont3 -- the exact-resolution version, and the measurement that matters:
# how much bigger is a driver's output when it has a font than when it does
# not?
#
# dvijet asks for 120 dpi for this DVI, and `epsonlo' in modes.mf IS 120 dpi
# -- so cmr10 rendered under it needs no nearest-neighbour substitution at
# all, and takes about a minute rather than the twenty-four the 300dpi render
# took.

family  dvifont3

setup   export TERM=vt100
setup   W=/dd/tmp/DVF3
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   export MFINPUTS=.:/dd/SYS/TEX/MFINPUTS/CM:/dd/SYS/TEX/MFINPUTS
setup   export GFFONTS=$W
setup   export PKFONTS=$W
setup   export TEXFONTS=$W
setup   export FONTLIST=pk

drive   the-baseline-with-no-font-at-all
why     what the dvidrivers card has always shown.
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/virtex '&plain' /dd/SYS/TEX/SAMPLES/story.tex < /nil"
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/dvijet story.dvi" > $W/none.txt 2>&1
run     /dd/CMDS/cat $W/none.txt
run     /dd/CMDS/wc -c $W/story.dvi_jet
run     /dd/CMDS/cp $W/story.dvi_jet $W/nofont.jet
run     echo "--- end baseline"

drive   render-cmr10-at-120
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/virmf '&cmbase' '\\scrollmode; \\mode:=epsonlo; \\input cmr10; \\end'"
run     /dd/CMDS/TEXCMDS/gftopk cmr10.120gf $W/cmr10.120pk
run     /dd/CMDS/wc -c $W/cmr10.120gf $W/cmr10.120pk
run     echo "--- end render"

drive   the-same-driver-with-the-font
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/dvijet story.dvi" > $W/with.txt 2>&1
run     /dd/CMDS/cat $W/with.txt
run     /dd/CMDS/wc -c $W/nofont.jet $W/story.dvi_jet
run     echo "--- end with-font"
