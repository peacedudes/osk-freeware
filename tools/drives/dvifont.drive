# dvifont -- can a DVI driver be given a real font?
#
# Every DVI driver on this disk warns that it cannot open a font file, and
# the dvidrivers card says so.  That was true because SYS/TEX/FONTS carried
# .tfm METRICS and no bitmaps.  Metafont works now, so the claim is testable:
# render cmr10 at a printer resolution, put it where the driver looks, and
# see whether the warning goes away.
#
# dvips names a bitmap `%s.%dpk' -- cmr10.300pk -- and takes PKFONTS/TEXPKS.
# SYS/TEX/FONTS already has empty PK300 and PK144 directories waiting.
# CanonCX is the 300dpi mode in modes.mf.

family  dvifont

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   W=/dd/tmp/DVF
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   export MFINPUTS=.:/dd/SYS/TEX/MFINPUTS/CM:/dd/SYS/TEX/MFINPUTS

drive   what-story-dvi-asks-for
why     name the fonts before rendering any -- rendering the wrong one at
why     300dpi is minutes wasted.
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/virtex '&plain' /dd/SYS/TEX/SAMPLES/story.tex < /nil"
run     /dd/CMDS/ls -l $W
run     /dd/CMDS/TEXCMDS/dvitype $W/story.dvi > $W/dt.txt 2>&1
run     /dd/CMDS/grep "Font\|font" $W/dt.txt
run     echo "--- end"

drive   render-cmr10-at-300
why     CanonCX is 300dpi.  Slow; this stanza is the experiment.
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/virmf '&cmbase' '\\scrollmode; \\mode:=CanonCX; \\input cmr10; \\end'"
run     /dd/CMDS/ls -l $W
run     echo "--- end render300"

drive   pack-it-and-let-dvips-look
run     export PKFONTS=$W
run     export TEXPKS=$W
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/gftopk cmr10.300gf cmr10.300pk"
run     /dd/CMDS/ls -l $W
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/dvips story.dvi" > $W/ps.txt 2>&1
run     /dd/CMDS/cat $W/ps.txt
run     /dd/CMDS/ls -l $W
run     echo "--- end"
