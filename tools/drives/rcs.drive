# rcs -- the six RCS commands, none of which had a card or a case.
#
# RCS is exactly the sort of family that can be settled completely: check a
# file in, check it out, change it, check it in again, and ask rlog what
# happened. Every step's result is a file or a listing.
#
# `ci' asks for a description on first check-in and for a log message after
# that, and ends both at a `.' on a line of its own -- so each ci here is fed
# from a file. A program that asks a question is not a program that is broken.

family  rcs

setup   W=/dd/tmp/RCSWORK
setup   /dd/CMDS/mkdir /dd/tmp/RCSWORK
setup   /dd/CMDS/cp /dd/SYS/motd $W/note.txt
setup   /dd/CMDS/printf 'a first note\r.\r' > /dd/tmp/desc1
setup   /dd/CMDS/printf 'second revision\r.\r' > /dd/tmp/desc2

drive   ci
why     check in.  RCS keeps the history in <file>,v beside it.
run     /dd/CMDS/ci $W/note.txt < /dd/tmp/desc1
run     echo "--- what is in the work directory now:"
run     /dd/CMDS/ls $W

drive   co
why     check out again -- ci moves the file away, co brings it back
run     /dd/CMDS/co $W/note.txt
run     /dd/CMDS/ls $W
run     /dd/CMDS/cat $W/note.txt

drive   rlog
run     /dd/CMDS/rlog $W/note.txt

drive   rcsident
why     "RCS ident" -- it finds $Id$ keywords in a file
run     /dd/CMDS/rcsident $W/note.txt
run     /dd/CMDS/rcsident $W/note.txt,v

drive   ci-second-revision
run     /dd/CMDS/co -l $W/note.txt
run     echo "a second line" >> $W/note.txt
run     /dd/CMDS/ci $W/note.txt < /dd/tmp/desc2
run     /dd/CMDS/rlog $W/note.txt

drive   rcsdiff
why     what changed between revision 1.1 and 1.2
run     /dd/CMDS/rcsdiff -r1.1 -r1.2 $W/note.txt

drive   rcsmerge
run     /dd/CMDS/rcsmerge -r1.1 -r1.2 $W/note.txt
run     /dd/CMDS/cat $W/note.txt
