# untested4 -- crypto as a FILTER, which its own help says it becomes when
# the output is redirected, and the deterministic cypher that makes it
# assertable: -r13 is rot13, so it is its own inverse.

family  untested4

setup   export TERM=vt100
setup   W=/dd/tmp/UT4
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

drive   crypto-rot13-round-trip
run     echo "The quick brown fox jumps over the lazy dog." > $W/p.txt
run     /dd/CMDS/crypto -n -r13 $W/p.txt > $W/c.txt
run     /dd/CMDS/cat $W/c.txt
run     /dd/CMDS/crypto -n -r13 $W/c.txt > $W/back.txt
run     /dd/CMDS/cat $W/back.txt
run     /dd/CMDS/cmp $W/p.txt $W/back.txt
run     echo "--- end crypto"

drive   crypto-with-a-named-code
run     /dd/CMDS/crypto -n -czyxwvutsrqponmlkjihgfedcba $W/p.txt > $W/a.txt
run     /dd/CMDS/cat $W/a.txt
run     echo "--- end atbash"

drive   the-bog-builders-again
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/GAMES/mkdict"
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/GAMES/mkindex"
run     /dd/CMDS/ls -l $W
run     echo "--- end bog"

drive   config-prints-a-table-before-it-dies
why     last, because it takes the session with it.
run     /dd/CMDS/config > $W/cfg.txt 2>&1
run     /dd/CMDS/head -n 8 $W/cfg.txt
run     echo "--- end"
