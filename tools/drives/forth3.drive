# forth3 -- the man page says the ARGUMENTS are loaded before the top loop
# starts, so a source file is a command-line argument, not an `include'.
family  forth3
setup   export TERM=vt100
setup   export TILEPATH=.:/dd/lib/tile:/dd/lib/tile/TST
setup   W=/dd/tmp/FT3
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   echo "bye" > $W/b.f

drive   a-library-file-as-an-argument
run     /dd/CMDS/ksh -c "cd /dd/lib/tile; /dd/CMDS/forth forth.f83 < $W/b.f"
run     echo "--- end forth.f83"

drive   fibonacci
run     /dd/CMDS/ksh -c "cd /dd/lib/tile/TST; /dd/CMDS/forth fibonacci.tst < $W/b.f"
run     echo "--- end fib"

drive   towers-of-hanoi
run     /dd/CMDS/ksh -c "cd /dd/lib/tile/TST; /dd/CMDS/forth towers_of_hanoi.tst < $W/b.f"
run     echo "--- end hanoi"
