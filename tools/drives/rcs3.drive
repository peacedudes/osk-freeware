# rcs3 -- does a second revision EVER go in?
#
# There is no `sleep' on this disk, so the delay has to be work: 200000
# Dhrystones take about a second under os9exec, which is exactly the
# resolution RCS compares at.

family  rcs3

setup   W=/dd/tmp/RCS3
setup   /dd/CMDS/mkdir /dd/tmp/RCS3
setup   /dd/CMDS/cp /dd/SYS/motd $W/note.txt
setup   /dd/CMDS/printf 'a first note\r.\r' > /dd/tmp/d1
setup   /dd/CMDS/printf 'second revision\r.\r' > /dd/tmp/d2
setup   echo 400000 > /dd/tmp/runs4

drive   second-revision-after-a-real-delay
run     /dd/CMDS/today
run     /dd/CMDS/ci $W/note.txt < /dd/tmp/d1
run     /dd/CMDS/co -l $W/note.txt
run     echo "a second line" >> $W/note.txt
run     /dd/CMDS/DHRY/dhryO2 < /dd/tmp/runs4 > /nil
run     /dd/CMDS/today
run     /dd/CMDS/ci $W/note.txt < /dd/tmp/d2
run     echo "--- rlog:"
run     /dd/CMDS/rlog $W/note.txt

drive   rcsdiff-between-two-revisions
run     /dd/CMDS/rcsdiff -r1.1 -r1.2 $W/note.txt

drive   no-sleep-on-this-disk
why     worth recording: there is no `sleep', which every shell script here
why     that wants to pace itself would reach for
run     /dd/CMDS/sleep 1
run     /dd/CMDS/ls /dd/CMDS/sleep
