# setterm2 -- setterm reads /dd/sys/setterm when TERM is unhelpful, and that
# file came in its own archive and had never been installed.  DOC/DEPENDS
# has listed it as absent all along.

family  setterm2
setup   export TERMCAP=/dd/SYS/termcap

drive   with-the-config-file-present
run     /dd/CMDS/ls -l /dd/SYS/setterm
run     export TERM=vt100
run     /dd/CMDS/setterm
run     echo "--- vt100 done"
run     export TERM=
run     /dd/CMDS/setterm
run     echo "--- no TERM done"
run     export TERM=zzznosuchterm
run     /dd/CMDS/setterm
run     echo "--- end"
