# flagged3 -- give newshist the history file it insists on.
#
# newshist ignores its own -df and reads /h0/lib/news/history, which is one
# of the two `--' entries under it in DOC/DEPENDS.  /h0 IS this disk, so the
# path is makeable.  dbz's dbminit() will not CREATE its .dir/.pag pair --
# that is the classic dbz contract, the files must exist first.

family  flagged3

setup   export TERM=vt100
setup   N=/dd/lib/news
setup   /dd/CMDS/mkdir -p $N > /nil 2>/nil

drive   make-the-history-file
run     echo "<one@site.uucp>	9999999	1" > $N/history
run     echo "<two@site.uucp>	9999999	2" >> $N/history
run     /dd/CMDS/cat $N/history
run     /dd/CMDS/ls -l $N
run     echo "--- end"

drive   newshist-with-it-there
run     /dd/CMDS/NEWS/newshist "<one@site.uucp>"
run     /dd/CMDS/NEWS/newshist "<nope@site.uucp>"
run     echo "--- end newshist"

drive   dbz-wants-its-pair-to-exist-first
run     echo -n "" > $N/history.dir
run     echo -n "" > $N/history.pag
run     /dd/CMDS/ls -l $N
run     /dd/CMDS/ksh -c "cd $N; /dd/CMDS/NEWS/dbz -c history"
run     /dd/CMDS/ls -l $N
run     echo "--- end dbz"

drive   newshist-again-now-the-index-exists
run     /dd/CMDS/NEWS/newshist "<one@site.uucp>"
run     /dd/CMDS/NEWS/newshist "<two@site.uucp>"
run     echo "--- end"
