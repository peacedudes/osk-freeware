# forth4 -- load a benchmark and CALL it.  The .tst files define words and
# abort with a message if the answer is wrong, so a silent return is the
# benchmark passing.
family  forth4
setup   export TERM=vt100
setup   export TILEPATH=.:/dd/lib/tile:/dd/lib/tile/TST
setup   W=/dd/tmp/FT4
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

drive   fibonacci-run-and-checked
run     echo "20 fib . cr" > $W/f.f
run     echo "recursive-fib .( recursive-fib ok) cr" >> $W/f.f
run     echo "tail-recursive-fib .( tail-recursive-fib ok) cr" >> $W/f.f
run     echo "bye" >> $W/f.f
run     /dd/CMDS/ksh -c "cd /dd/lib/tile/TST; /dd/CMDS/forth fibonacci.tst < $W/f.f"
run     echo "--- end fib"

drive   towers-of-hanoi-run-and-checked
run     echo "towers-of-hanoi .( towers-of-hanoi ok) cr" > $W/h.f
run     echo "moves @ . .( moves) cr" >> $W/h.f
run     echo "bye" >> $W/h.f
run     /dd/CMDS/ksh -c "cd /dd/lib/tile/TST; /dd/CMDS/forth towers_of_hanoi.tst < $W/h.f"
run     echo "--- end hanoi"

drive   a-word-defined-at-the-keyboard
run     echo ": squares 10 1 do i dup * . loop cr ;" > $W/s.f
run     echo "squares" >> $W/s.f
run     echo "bye" >> $W/s.f
run     /dd/CMDS/forth < $W/s.f
run     echo "--- end"
