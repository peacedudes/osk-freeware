# untested2 -- untested1 with the invocations CORRECTED.
#
# untested1 ran `/dd/CMDS/bincheckr', `/dd/CMDS/mkdict', `/dd/CMDS/mkindex'
# and `/dd/CMDS/byteflip' and got E$PNNF from all four.  None of them is at
# that path: the first three are in CMDS/GAMES and byteflip is in CMDS/NEWS.
# The programs were never asked.  This is the lesson of the whole pass and it
# caught me again.
#
# The rest here are the ones untested1 showed have a real invocation nobody
# had tried: `yagi' READS FROM STANDARD INPUT, `crypto' has -h and -i,
# `helpindex' says outright what it is missing, and `shuffle' is not a text
# tool at all -- it draws a game board.

family  untested2

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   W=/dd/tmp/UT2
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

drive   bincheckr-on-the-book-that-ships
why     GAMES/gnuchess.book is 41413 bytes and is right here.
run     /dd/CMDS/GAMES/bincheckr
run     /dd/CMDS/GAMES/bincheckr /dd/GAMES/gnuchess.book
run     echo "--- end bincheckr"

drive   mkdict-and-mkindex-on-bogs-own-word-list
why     GAMES/BOG holds dict, dict.ind and helpfile -- exactly what these
why     two build.
run     /dd/CMDS/ls -l /dd/GAMES/BOG
run     /dd/CMDS/GAMES/mkdict
run     /dd/CMDS/GAMES/mkindex
run     echo "--- end bog"

drive   byteflip-where-it-lives
run     /dd/CMDS/NEWS/byteflip
run     echo "--- end byteflip"

drive   yagi-reads-its-numbers-from-standard-input
why     it asks for a centre frequency and then more.  Feed it.
run     echo "144" > $W/y.in
run     echo "10" >> $W/y.in
run     echo "" >> $W/y.in
run     /dd/CMDS/yagi < $W/y.in
run     echo "--- end yagi"

drive   crypto-has-its-own-help
run     /dd/CMDS/crypto -h
run     echo "--- end crypto-h"

drive   helpindex-given-files-to-index
run     /dd/CMDS/helpindex /dd/DOC/README-KSH /dd/DOC/README-CIO
run     /dd/CMDS/ls -l $W
run     echo "--- end helpindex"
