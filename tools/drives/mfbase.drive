# mfbase -- rebuild SYS/TEX/MFBASES/plain.base and hand it out through /h1.
#
# This is the recorded procedure for the one BUILT file in the TeX tree that
# is not a program.  Metafont needs a preloaded base the way TeX needs a
# format; SYS/TEX/FORMATS shipped plain.fmt from the start and MFBASES held
# only its Makefile, so `virmf' stopped at `I can't find the default base
# file!' and the eight bitmap-font tools had nothing to read.
#
# The two lines below are what SYS/TEX/MFBASES/install.script asks for,
# verbatim.  plain.base takes about a minute and is 80144 bytes; cmbase.base
# is built ON TOP of it -- `&plain cmbase dump' -- and is 128312.  cmbase is
# what the 117 Computer Modern sources under MFINPUTS/CM are written against,
# so without it `cmr10' cannot be rendered and every DVI driver on this disk
# is stuck warning that it cannot open a font file.
#
# cmbase.mf is in MFINPUTS/CM and the compiled-in MFINPUTS path does not go
# into CM, so that one line has to name it.  /h1 is a HOST directory
# under notes/drives/work, so the result can be copied into disk/ and shipped
# -- which it now is.  Re-run this only to rebuild the base (a new modes.mf,
# say); nothing on the disk needs it at run time.
#
# It is REPRODUCIBLE: a second run against the same sources differs from the
# shipped file in exactly TWO BYTES, the time Metafont stamps into the dump.
#
# `ksh -c "cd ..."' and not a bare `cd': Metafont names its own output files
# and writes them into the DATA directory, and bash's `cd' does not move
# that.  DOC/README-SHELLS has the measurement.

family  mfbase

setup   W=/dd/tmp/MFB
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

drive   dump-and-hand-out
run     export MFINPUTS=.:/dd/SYS/TEX/MFINPUTS/CM:/dd/SYS/TEX/MFINPUTS
run     echo "plain; \\input modes; dump" > $W/mf.in
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/inimf < mf.in"
run     export MFBASES=$W
run     echo "&plain cmbase dump" > $W/cm.in
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/inimf < cm.in"
run     /dd/CMDS/cp $W/plain.base /h1/plain.base
run     /dd/CMDS/cp $W/cmbase.base /h1/cmbase.base
run     /dd/CMDS/ls -l $W
run     echo "--- now: cp notes/drives/work/h1/*.base disk/SYS/TEX/MFBASES/"

drive   what-the-job-name-comes-from
why     the render writes mfput.120gf, not cmr10.120gf: Metafont takes the
why     job name from a file named on the COMMAND LINE, and a line that
why     begins with a backslash names none.  Try it the other way.
run     echo "\\mode=epsonlo; mode_setup; input cmr10" > $W/a.mf
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/virmf '&cmbase' < a.mf"
run     /dd/CMDS/ls $W/mfput.120gf $W/cmr10.120gf
run     echo "--- end"
