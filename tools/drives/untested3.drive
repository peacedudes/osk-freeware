# untested3 -- yagi with a complete answer set, and the two bog builders and
# helpindex/crypto that untested2 ran out of session before reaching.
#
# untested2 gave yagi three lines and it looped on the fourth question for
# the rest of the transcript -- EOF on a numeric read gives it the same
# answer forever.  It wants: centre frequency, element count, tubing size,
# and whatever follows.

family  untested3

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   W=/dd/tmp/UT3
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

drive   yagi-answered-all-the-way-down
run     echo "144" > $W/y.in
run     echo "12" >> $W/y.in
run     echo "3" >> $W/y.in
run     echo "3" >> $W/y.in
run     echo "3" >> $W/y.in
run     echo "3" >> $W/y.in
run     echo "3" >> $W/y.in
run     echo "3" >> $W/y.in
run     /dd/CMDS/yagi < $W/y.in > $W/y.out 2>&1
run     /dd/CMDS/wc -c $W/y.out
run     /dd/CMDS/head -n 40 $W/y.out
run     echo "--- end yagi"

drive   crypto-help
run     /dd/CMDS/crypto -h > $W/c.txt 2>&1
run     /dd/CMDS/head -n 25 $W/c.txt
run     echo "--- end crypto"

drive   helpindex-given-files
run     /dd/CMDS/helpindex /dd/DOC/README-KSH /dd/DOC/README-CIO > $W/hi.txt 2>&1
run     /dd/CMDS/wc -c $W/hi.txt
run     /dd/CMDS/head -n 12 $W/hi.txt
run     /dd/CMDS/ls -l $W
run     echo "--- end helpindex"

drive   the-bog-builders
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/GAMES/mkdict"
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/GAMES/mkindex"
run     /dd/CMDS/ls -l $W
run     echo "--- end bog"
