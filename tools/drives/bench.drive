# bench -- the eleven Dhrystone builds in CMDS/DHRY and the four floating
# point benchmarks.  Nobody has ever run them here; the point of shipping
# eleven builds of one program is to COMPARE them, and nothing on this disk
# has ever printed the comparison.

family  bench

setup   D=/dd/CMDS/DHRY

drive   dhrystones
why     each prints its own rate.  One session, eleven builds, one table.
run     echo "--- dhryO2 (Microware cc, optimised)"
run     $D/dhryO2
run     echo "--- dhryGcc"
run     $D/dhryGcc
run     echo "--- dhryGcco2"
run     $D/dhryGcco2
run     echo "--- dhryGccin"
run     $D/dhryGccin
run     echo "--- dhryGccmx"
run     $D/dhryGccmx

drive   dhrystones2
run     echo "--- dhryGcc2"
run     $D/dhryGcc2
run     echo "--- dhryGcc2o2"
run     $D/dhryGcc2o2
run     echo "--- dhryGcc2in"
run     $D/dhryGcc2in
run     echo "--- dhryGcc2mx"
run     $D/dhryGcc2mx
run     echo "--- dhryshamu"
run     $D/dhryshamu
run     echo "--- dhryshamu2"
run     $D/dhryshamu2

drive   float
run     /dd/CMDS/float

drive   savage
run     /dd/CMDS/savage

drive   paranoia
why     the classic floating-point torture test.  It is long; the first
why     screenful is what the card would show.
run     /dd/CMDS/paranoia
