# about1 -- does `about' show the how-to lines just added?  It is the
# program a person on this disk uses to ask what something is and how to run
# it, and it reads DOC/INDEX, CATEGORIES, ORIGINS and DEPENDS.

family  about1

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap

drive   about-the-programs-this-pass-corrected
run     /dd/CMDS/about yagi
run     echo "--- next"
run     /dd/CMDS/about casefix
run     echo "--- next"
run     /dd/CMDS/about virmf
run     echo "--- end"
