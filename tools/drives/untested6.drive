# untested6 -- bibtex reads its job name from STANDARD INPUT, and uuencode
# wants its arguments the other way round.

family  untested6

setup   export TERM=vt100
setup   W=/dd/tmp/UT6
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

drive   bibtex-given-an-aux-file
why     `Please type input file name (no extension)--' is a prompt, not
why     silence.  Make the .aux and the .bib it names.
run     echo "\\citation{knuth}" > $W/j.aux
run     echo "\\bibstyle{plain}" >> $W/j.aux
run     echo "\\bibdata{refs}" >> $W/j.aux
run     echo "@book{knuth, author={D. E. Knuth}, title={The TeXbook}, year=1984}" > $W/refs.bib
run     /dd/CMDS/cat $W/j.aux
run     echo "j" > $W/b.in
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/bibtex < b.in"
run     /dd/CMDS/ls -l $W
run     echo "--- end bibtex"

drive   uuencode-the-other-way-round
run     /dd/CMDS/uuencode motd.out < /dd/SYS/motd > $W/u.uu
run     /dd/CMDS/wc -c $W/u.uu
run     /dd/CMDS/head -n 3 $W/u.uu
run     /dd/CMDS/uuexpand < $W/u.uu > $W/e.txt
run     /dd/CMDS/wc -c $W/e.txt
run     /dd/CMDS/head -n 3 $W/e.txt
run     echo "--- end uuencode"
