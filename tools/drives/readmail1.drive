# readmail1 -- which key ends read_mail?  Its prompt offers
# `[L]ist again , e[X]it & delete mail , exit & [N]ot delete', and both `N'
# from a file and `N' as a keypress leave it asking again.  Try each answer
# and see which one returns to the shell.  DELIBERATELY NOT `X': that one
# deletes the mail.

family  readmail1

setup   export USER=tester
setup   W=/dd/tmp/rm
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   /dd/CMDS/head -n 5 /dd/SPOOL/MAIL/tester > /dd/MAIL/mail_tester

drive   answer-N-with-a-newline
run     echo "N" > $W/n.txt
run     /dd/CMDS/read_mail < $W/n.txt
run     echo "--- returned"

drive   answer-n-lower-case
run     echo "n" > $W/l.txt
run     /dd/CMDS/read_mail < $W/l.txt
run     echo "--- returned"

drive   answer-with-nothing-at-all
run     /dd/CMDS/read_mail < /nil
run     echo "--- returned"

drive   answer-q
run     echo "q" > $W/q.txt
run     /dd/CMDS/read_mail < $W/q.txt
run     echo "--- returned"
