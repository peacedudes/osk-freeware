# untested12 -- the process tools, each with the option its own help names.
# All four are in the "ends the emulator session" row, and three of them were
# only ever run BARE.

family  untested12

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   W=/dd/tmp/UTD
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

drive   devprc-with-its-options
why     `-a display all devices belonging to all processes', `-d [dev]',
why     `-h print header'.  Its card and its case ran it bare.
run     /dd/CMDS/devprc -a
run     echo "--- a done"
run     /dd/CMDS/devprc -h -d /term
run     echo "--- end devprc"

drive   top-once-rather-than-every-ten-seconds
why     `top [<opts>] [<num>]' displays the process table every num seconds,
why     default 10 -- so bare it never returns.  Give it a number.
run     /dd/CMDS/top -a 1
run     echo "--- end top"

drive   cpu-draws-its-chart
run     /dd/CMDS/cpu
run     echo "--- end cpu"

drive   pri-needs-a-pid
run     /dd/CMDS/pri
run     /dd/CMDS/pri 1 128
run     echo "--- end pri"
