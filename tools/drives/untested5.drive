# untested5 -- the ones recorded as "silent for every invocation".  Four of
# them read STANDARD INPUT, one needs os9lib loaded, and one is not the
# program DOC/INDEX says it is.

family  untested5

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   W=/dd/tmp/UT5
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

drive   uuexpand-is-not-a-uudecoder
why     its own usage says `uuexpand [opts] / or: uuunexpand [opts]' with
why     -16 and -8 for portability.  DOC/INDEX calls it `expand uuencoded
why     text'.  Feed it uuencoded text and see which is true.
run     /dd/CMDS/uuencode /dd/SYS/motd motd.out > $W/u.uu
run     /dd/CMDS/head -n 3 $W/u.uu
run     /dd/CMDS/uuexpand < $W/u.uu > $W/e.txt 2>&1
run     /dd/CMDS/wc -c $W/u.uu $W/e.txt
run     /dd/CMDS/head -n 3 $W/e.txt
run     echo "--- end uuexpand"

drive   casefix-and-makecrc-on-standard-input
run     echo "hELLo THERE. this IS a TEST." > $W/case.txt
run     /dd/CMDS/casefix < $W/case.txt
run     echo "--- casefix done"
run     /dd/CMDS/makecrc < $W/case.txt
run     echo "--- end"

drive   dfiles-needs-duplicates-to-find
why     it was silent for DOC/tex because there are none there.  Make some.
run     /dd/CMDS/mkdir -p $W/a > /nil 2>/nil
run     /dd/CMDS/mkdir -p $W/b > /nil 2>/nil
run     /dd/CMDS/cp /dd/SYS/motd $W/a/one
run     /dd/CMDS/cp /dd/SYS/motd $W/b/two
run     /dd/CMDS/dfiles $W
run     echo "--- end dfiles"

drive   creadoc-with-os9lib-loaded
why     DOC/README-RUNNING says lnk.org, for, creadoc and biory call F$Link
why     for os9lib, get E_MNF and exit printing nothing.
run     /dd/CMDS/load /dd/CMDS/os9lib
run     /dd/CMDS/creadoc
run     echo "--- end creadoc"

drive   bibtex-has-no-style-files-here
why     SYS/TEX/BIB holds a read.me and nothing else, so there is no .bst
why     for bibtex to format with.  Establish that rather than calling it
why     silent.
run     /dd/CMDS/ls -l /dd/SYS/TEX/BIB
run     /dd/CMDS/TEXCMDS/bibtex
run     echo "--- end bibtex"
