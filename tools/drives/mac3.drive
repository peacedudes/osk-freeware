# mac3 -- the Macintosh set, driven from what the manuals on this disk say
# rather than from guesses.
#
# `macsave' reads MacBinary FROM STANDARD INPUT and writes silently -- its
# own manual page (DOC/macsave/macsave.1) says so, which is why every sweep
# that ran it bare and scored it mute was measuring the documentation.
# `macbin' is the translator that MAKES a MacBinary file, so the pair can be
# round-tripped without anything from a real Macintosh.

family  mac3

setup   export TERM=vt100
setup   W=/dd/tmp/MAC3
setup   /dd/CMDS/rm -f $W > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   /dd/CMDS/cp /dd/SYS/motd $W/plain.txt

drive   macbin
why     the MacBinary translator, v1.1 -- "writes a 128 byte header".
why     What does it want?
run     /dd/CMDS/macbin
run     echo "--- with a file:"
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/macbin plain.txt"
run     /dd/CMDS/ls -l $W
run     echo "--- end macbin"

drive   macsave-round-trip
why     macsave reads MacBinary on STANDARD INPUT and writes `.bin' files
why     into the current directory, silently.  Give it what macbin made.
run     /dd/CMDS/ls -l $W
run     echo "--- feed the MacBinary to macsave:"
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/macsave < plain.txt.MAC"
run     /dd/CMDS/ls -l $W
run     echo "--- end macsave"

drive   elvrec
why     "run elvrec with no arguments to see a list of all recoverable
why     files".  It wants /usr/preserve/Index and OS-9 has no /usr device.
run     /dd/CMDS/elvrec
run     echo "--- named:"
run     /dd/CMDS/elvrec $W/plain.txt
run     echo "--- end elvrec"

drive   mcvert-and-macunpack
why     the other two of the macutils set, for comparison.
run     /dd/CMDS/mcvert
run     echo "--- macunpack:"
run     /dd/CMDS/macunpack
run     echo "--- end"

drive   fortran-set-with-os9lib-loaded
why     DOC/README-RUNNING: `creadoc', `biory' and `lnk.org' call F$Link for
why     a module named `os9lib', get E_MNF and exit WITHOUT PRINTING
why     ANYTHING -- which reads like three broken programs and is not.
why     `CMDS/os9lib' is the RTF Fortran run-time library.  Load it.
why     ONE PROGRAM PER STANZA: creadoc aborts once os9lib is resident and
why     took biory and lnk.org with it the first time.
run     /dd/CMDS/creadoc
run     echo "--- that was creadoc with nothing loaded.  Now load os9lib:"
run     /h1/CMDS/load /dd/CMDS/os9lib
run     echo "--- creadoc again:"
run     echo "C@ a documentation comment" > $W/f.for
run     echo "      PROGRAM MAIN" >> $W/f.for
run     echo "      END" >> $W/f.for
run     /dd/CMDS/creadoc $W/f.for
run     echo "--- end creadoc-with-os9lib"

drive   lnk-org-with-os9lib-loaded
why     the linker half of the same set, on its own stanza.
run     /h1/CMDS/load /dd/CMDS/os9lib
run     /dd/CMDS/lnk.org
run     echo "--- and `for', which README-RUNNING names beside it:"
run     /dd/CMDS/for
run     echo "--- end lnk-org"

drive   biory-with-os9lib-loaded
why     "biory prompts for a name and a birth date in German" once os9lib
why     is resident.  On its own stanza because it prompts.
run     /h1/CMDS/load /dd/CMDS/os9lib
run     echo "Tester" > $W/b.in
run     echo "1" >> $W/b.in
run     echo "1" >> $W/b.in
run     echo "1960" >> $W/b.in
run     /dd/CMDS/biory < $W/b.in
run     echo "--- end biory"
