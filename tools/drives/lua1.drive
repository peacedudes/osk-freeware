# lua1 -- lua stops with `csl traphandler mismatch'.  Which edition does it
# want?  /h5 carries the SDK's csl for this test ONLY; nothing is installed.
family  lua1
setup   export TERM=vt100
setup   W=/dd/tmp/LUA
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

drive   lua-as-it-ships
run     echo 'print("hello from lua")' > $W/h.lua
run     /dd/CMDS/lua $W/h.lua
run     echo "--- end as-ships"

drive   lua-with-the-other-csl-loaded
run     /dd/CMDS/ls /h1/CMDS
run     /dd/CMDS/load /h1/CMDS/csl
run     /dd/CMDS/lua $W/h.lua
run     /dd/CMDS/lua -v
run     echo "--- end"
