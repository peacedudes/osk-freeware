# Text tools whose output is worth looking at.
shot    ascii
cap     The ASCII table, four columns, control names and all.
run     /dd/CMDS/ascii | /dd/CMDS/head -n 20
wait    5

shot    gothic
cap     gothic sets a line in blackletter, built out of characters.  It
cap     asks where to write first; the answer here is the terminal.
run     /dd/CMDS/gothic
wait    3
send    \r
wait    2
send    OS-9\r
wait    5

shot    cursive
cap     cursive writes a joined-up banner sideways down the screen.
run     echo Freeware | /dd/CMDS/cursive
wait    6
kill

shot    cookie
cap     cookie, the fortune-cookie program, reading the collection's own
cap     sayings file.
run     /dd/CMDS/cookie
wait    2
run     /dd/CMDS/cookie
wait    3

shot    qt
cap     qt tells the time the way a person would say it.
run     /dd/CMDS/qt
wait    3

shot    soundex
cap     soundex reduces each word to its phonetic key -- Robert and Rupert
cap     come out the same, which is the whole idea.
run     echo Robert Rupert Rubin Ashcraft Ashcroft | /dd/CMDS/soundex
wait    4

shot    speech
cap     speech turns English spelling into phonemes.  It reads until you
cap     stop it.
run     /dd/CMDS/speech
wait    2
send    The quick brown fox jumps over the lazy dog\r
wait    4

shot    valspeak
cap     valspeak, a filter with an attitude, run over the disk's own motd.
run     /dd/CMDS/cat /dd/SYS/motd | /dd/CMDS/GAMES/valspeak
wait    5

shot    rot
cap     rot-13 applied to a line and then applied again, which puts it back.
run     echo "The quick brown fox" | /dd/CMDS/rot
wait    3
run     echo "Gur dhvpx oebja sbk" | /dd/CMDS/rot
wait    3

shot    fmt
cap     fmt, elvis's text formatter, folding a long paragraph to width.
run     /dd/CMDS/cat /dd/SYS/motd | /dd/CMDS/fmt
wait    5
