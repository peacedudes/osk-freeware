# TeX, its formats, WEB, the DVI drivers and the font tools, one stanza
# per program.  Every stanza makes what it reads under /dd/tmp/TEX;
# the sample story is Knuth's own, from SYS/TEX/SAMPLES, with \end
# appended so TeX finishes without a prompt.

shot    tex
size    30 80
cap     TeX typesetting Knuth's sample story: the plain format loads, the
cap     page is set, and a DVI file is written beside the source.
try     cat story.tex | head -n 6; tex story.tex; ls -l story.dvi
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex
wait    3
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     cat story.tex | head -n 6
wait    3
run     tex story.tex
wait    40
run     ls -l story.dvi
wait    4

shot    virtex
size    30 80
cap     The TeX engine itself, told which format to load: `&plain' and
cap     then the file.  tex and latex are one-line wrappers round this.
try     virtex '&plain' story.tex
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex
wait    3
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     virtex '&plain' story.tex
wait    40

shot    latex
size    30 80
cap     LaTeX setting the small sample document that ships with it, and
cap     reporting the page as it writes it.
try     latex small.tex; ls -l small.dvi
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/small.dvi /dd/tmp/TEX/small.aux; cp /dd/SYS/TEX/SAMPLES/small.tex /dd/tmp/TEX/small.tex
wait    3
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     latex small.tex
wait    60
run     ls -l small.dvi
wait    4

shot    slitex
cap     SliTeX, the slide-making variant: the same engine with the slides
cap     format loaded.  Its banner and prompt, with nothing to set.
try     slitex
run     slitex
wait    12
send    \134end\r
wait    5

shot    initex
cap     The format-building TeX: it reads macro files and dumps a format
cap     the other TeXs load.  Its banner and prompt; \end leaves it.
try     initex
run     initex
wait    12
send    \134end\r
wait    5

shot    texidx
size    24 80
cap     Sorts the \indexentry lines a LaTeX \makeindex run writes into a
cap     .idx file, into the alphabetized index LaTeX reads back in.  Even
cap     this three-entry file asks for more memory than the system has,
cap     which is as far as it gets on any input.
try     texidx sample.idx
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; printf '\\indexentry{banana}{3}\r\\indexentry{apple}{1}\r\\indexentry{cherry}{2}\r' > /dd/tmp/TEX/sample.idx
wait    2
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     texidx sample.idx
wait    10

shot    bibtex
size    30 80
cap     BibTeX, the bibliography formatter.  It asks for the job name, then
cap     reads the .aux file LaTeX left: cite.tex cites two entries of the
cap     sample database xampl.bib and asks for the plain style.  BibTeX
cap     writes cite.bbl, the formatted bibliography LaTeX reads on its next
cap     run; its head is shown.
try     bibtex
run     rm -rf /dd/tmp/BIBT; mkdir -p /dd/tmp/BIBT; cp /dd/SYS/TEX/SAMPLES/xampl.bib /dd/tmp/BIBT; builtin cd /dd/tmp/BIBT
run     cat >cite.tex
text    \documentstyle{article}
text    \begin{document}
text    See \cite{book-full} and \cite{article-full}.
text    \bibliographystyle{plain}
text    \bibliography{xampl}
text    \end{document}
eof
wait    2
run     latex cite.tex > /nil
wait    60
run     builtin cd /dd/tmp/BIBT
run     clear
wait    1
run     bibtex
wait    5
send    cite\r
wait    10
run     head -n 12 cite.bbl
wait    3

shot    afm2tfm
cap     Turns a PostScript font's metrics -- an .afm -- into the .tfm file
cap     TeX reads to set type in that font.  Here it converts one of the
cap     URW metrics this disk ships: it names the font it found inside,
cap     NimbusSanL-Regu, and writes the .tfm beside it.
try     afm2tfm n019003l.afm
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/n019003l.tfm; cp /dd/LIB/gs403/n019003l.afm /dd/tmp/TEX/n019003l.afm
wait    8
run     builtin cd /dd/tmp/TEX
wait    1
run     clear
wait    1
run     afm2tfm n019003l.afm
wait    35
run     ls -l n019003l.afm n019003l.tfm
wait    10

shot    maketexpk
cap     Its answer to no arguments.  It takes a font name, a resolution
cap     and a magnification, runs Metafont and packs the result; given
cap     them here it stops, because its recipe does not preload the
cap     Computer Modern base Metafont needs.  virmf then gftopk does the
cap     same job by hand.
try     maketexpk
run     maketexpk
wait    6

shot    tangle
size    30 80
cap     Turns a WEB source -- Knuth's literate-programming format -- into
cap     the Pascal program written in it.  It always wants a change file
cap     named as well; none.ch is an empty one.
try     tangle sample none; cat sample.p
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/sample.p; cp /dd/DOC/tex/sample.web /dd/tmp/TEX/sample.web; cp /dd/DOC/tex/none.ch /dd/tmp/TEX/none.ch
wait    3
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     tangle sample none
wait    15
run     cat sample.p
wait    5

shot    weave
size    30 80
cap     The other half of the pair: the same WEB source becomes the TeX
cap     document a person reads, with an index of the identifiers.
try     weave sample none; cat sample.tex | head -n 8
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/sample.tex; cp /dd/DOC/tex/sample.web /dd/tmp/TEX/sample.web; cp /dd/DOC/tex/none.ch /dd/tmp/TEX/none.ch
wait    3
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     weave sample none
wait    15
run     cat sample.tex | head -n 8
wait    5

shot    dvitype
size    44 80
cap     Reads a DVI file back and prints what is in it: the fonts and, at
cap     the level chosen, every command and the position TeX gave it.  It
cap     asks five questions, which run together on the first lines, and
cap     takes the default for each; the listing goes to dt.out.
try     dvitype story.dvi < /nil > dt.out; head -n 30 dt.out
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     clear
wait    1
run     dvitype story.dvi < /nil > dt.out
wait    20
run     head -n 30 dt.out
wait    4

shot    dvialw
size    36 80
cap     The DVI driver for the Apple LaserWriter: it turns the story's DVI
cap     into PostScript beside it, rendering the text from the 300 dpi
cap     Computer Modern fonts shipped in SYS/TEX/FONTS. It reports [OK]
cap     and the PostScript carries the real glyphs.
try     dvialw story.dvi; cat story.dvi_alw | head -n 6
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_alw; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dvialw story.dvi
wait    25
run     cat story.dvi_alw | head -n 6
wait    5

shot    dvidjp
size    36 80
cap     The DVI driver for the HP DeskJet, on the same story: at 300 dpi
cap     it finds the shipped Computer Modern fonts and renders the page,
cap     the output growing from the DVI by the size of the glyph rasters.
try     dvidjp story.dvi; ls -l story.dvi_djc
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dvidjp story.dvi
wait    25
run     ls -l story.dvi_djc
wait    5

shot    dvieps
size    36 80
cap     The DVI driver for Epson dot-matrix printers (240 dpi).  There is
cap     no 240 dpi font here, so it scales the shipped 300 dpi ones by
cap     nearest neighbor -- which it announces per font -- and renders.
try     dvieps story.dvi; ls -l story.dvi_eps
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dvieps story.dvi
wait    25
run     ls -l story.dvi_eps
wait    5

shot    dviimp
size    36 80
cap     The DVI driver for the Imagen laser printer (300 dpi), on the same
cap     story: it finds the shipped 300 dpi fonts and renders the page.
try     dviimp story.dvi; ls -l story.dvi_imp
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dviimp story.dvi
wait    25
run     ls -l story.dvi_imp
wait    5

shot    dvijep
size    36 80
cap     The DVI driver for the HP LaserJet Plus (300 dpi), on the same
cap     story: it finds the shipped 300 dpi fonts and renders the page.
try     dvijep story.dvi; ls -l story.dvi_jep
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dvijep story.dvi
wait    25
run     ls -l story.dvi_jep
wait    5

shot    dvijet
size    36 80
cap     The DVI driver for the HP LaserJet (120 dpi default): it scales the
cap     shipped 300 dpi fonts by nearest neighbor and renders the page.
try     dvijet story.dvi; ls -l story.dvi_jet
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dvijet story.dvi
wait    25
run     ls -l story.dvi_jet
wait    5

shot    dvilj2
size    36 80
cap     The DVI driver for the HP LaserJet II (300 dpi), on the same story:
cap     it finds the shipped 300 dpi Computer Modern fonts, reports [OK],
cap     and the PCL it writes carries the real glyph rasters.
try     dvilj2 story.dvi; ls -l story.dvi_lj2
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dvilj2 story.dvi
wait    25
run     ls -l story.dvi_lj2
wait    5

shot    dvimac
size    36 80
cap     The DVI driver for the Apple ImageWriter (144 dpi): it asks for 120
cap     dpi fonts, finds none, takes the shipped 300 dpi ones nearest in
cap     size instead, and renders the page.
try     dvimac story.dvi; ls -l story.dvi_mac
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dvimac story.dvi
wait    25
run     ls -l story.dvi_mac
wait    5

shot    dvioki
size    36 80
cap     The DVI driver for Okidata printers (144 dpi): it scales the
cap     shipped 300 dpi fonts by nearest neighbor and renders the page.
try     dvioki story.dvi; ls -l story.dvi_oki
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dvioki story.dvi
wait    25
run     ls -l story.dvi_oki
wait    5

shot    dvitos
size    36 80
cap     The DVI driver for the Toshiba P-1351 (180 dpi): it asks for 166
cap     dpi fonts and scales the shipped 300 dpi ones by nearest neighbor and renders the page.
try     dvitos story.dvi; ls -l story.dvi_tos
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dvitos story.dvi
wait    25
run     ls -l story.dvi_tos
wait    5

shot    dvips
size    36 80
cap     dvips, the fuller of the two PostScript drivers.  It reads the
cap     seven prologues in SYS/TEX/DVIPS -- you can see it name tex.pro --
cap     and writes the page out.  `-M' tells it not to offer to build a
cap     font size nobody has made yet.
try     dvips -M story.dvi -o story.ps
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; builtin cd /dd/tmp/TEX; tex story.tex > /nil
wait    40
run     builtin cd /dd/tmp/TEX
run     clear
wait    1
run     dvips -M story.dvi -o story.ps
wait    30
run     ls -l story.ps
wait    5

shot    tftopl
size    30 80
cap     Turns a binary font metric file into a readable property list:
cap     the head of what it makes of cmr10.tfm.
try     tftopl cmr10.tfm | head -n 20
run     builtin cd /dd/SYS/TEX/FONTS/TFM
run     clear
wait    1
run     tftopl cmr10.tfm | head -n 20
wait    20

shot    pltotf
size    24 90
cap     Turns a property list back into a binary .tfm: cmr10.pl, made
cap     from the shipped cmr10.tfm with tftopl, goes back to a file of the
cap     same size.
try     pltotf tmp/TEX/cmr10.pl tmp/TEX/cmr10.tfm; ls -l SYS/TEX/FONTS/TFM/cmr10.tfm tmp/TEX/cmr10.tfm
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; tftopl /dd/SYS/TEX/FONTS/TFM/cmr10.tfm > /dd/tmp/TEX/cmr10.pl
wait    20
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pltotf tmp/TEX/cmr10.pl tmp/TEX/cmr10.tfm
wait    20
run     ls -l SYS/TEX/FONTS/TFM/cmr10.tfm tmp/TEX/cmr10.tfm
wait    5

shot    vptovf
cap     Compiles a virtual-font property list into a .vf and its .tfm:
cap     here a one-character font that maps onto cmr10.
try     vptovf DOC/tex/sample.vpl tmp/TEX/s.vf tmp/TEX/s.tfm; ls -l tmp/TEX/s.vf tmp/TEX/s.tfm
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/s.vf /dd/tmp/TEX/s.tfm
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     vptovf DOC/tex/sample.vpl tmp/TEX/s.vf tmp/TEX/s.tfm
wait    20
run     ls -l tmp/TEX/s.vf tmp/TEX/s.tfm
wait    4

shot    vftovp
size    30 80
cap     Reads a virtual font back into the property list it came from.
cap     VFFONTS and TEXFONTS name the directory, because the font search
cap     paths do not include the current one.
try     vftovp s.vf s.tfm tmp/TEX/back.vpl; cat tmp/TEX/back.vpl | head -n 16
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; vptovf /dd/DOC/tex/sample.vpl /dd/tmp/TEX/s.vf /dd/tmp/TEX/s.tfm > /nil; export VFFONTS=/dd/tmp/TEX; export TEXFONTS=/dd/tmp/TEX:/dd/SYS/TEX/FONTS/TFM
wait    20
run     builtin cd /dd
wait    1
run     clear
wait    1
run     vftovp s.vf s.tfm tmp/TEX/back.vpl
wait    20
run     cat tmp/TEX/back.vpl | head -n 16
wait    5

shot    virmf
size    36 80
cap     Metafont rendering the seven-character METAFONT logo font at a
cap     low resolution, from its source in MFINPUTS: run.mf sets the mode
cap     and inputs logo10, and Metafont writes the bitmap font, its
cap     metrics and a log beside it.
try     virmf < run.mf; ls -l
run     rm -rf /dd/tmp/MFV; mkdir -p /dd/tmp/MFV; echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/MFV/run.mf
wait    3
run     builtin cd /dd/tmp/MFV
run     clear
wait    1
run     cat run.mf
wait    1
run     virmf < run.mf
wait    50
run     ls -l
wait    5

shot    inimf
cap     The base-building Metafont: it reads plain.mf and dumps the base
cap     the other Metafont loads.  Its banner and prompt.
try     inimf
run     inimf
wait    12
send    \134end\r
wait    5

shot    gftype
size    36 80
cap     Draws a bitmap font's characters as text: the M of the METAFONT
cap     logo font, from the GF file virmf wrote from the font's source,
cap     run first.
try     gftype -i logo10.120gf > gt.out; cat gt.out | head -n 22
run     mkdir -p /dd/tmp/MF > /nil 2>/nil; rm -f /dd/tmp/MF/logo10.*; echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/MF/run.mf; builtin cd /dd/tmp/MF; virmf < run.mf > /nil; export GFFONTS=/dd/tmp/MF
wait    50
run     clear
wait    1
run     gftype -i logo10.120gf > gt.out
wait    25
run     cat gt.out | head -n 22
wait    4

shot    gftopk
cap     Packs a GF bitmap font into the smaller PK form the DVI drivers
cap     read; the two sizes side by side.  logo10.120gf is the METAFONT
cap     logo font, rendered first by virmf from its source in MFINPUTS.
try     gftopk logo10.120gf logo10.120pk; ls -l logo10.120gf logo10.120pk
run     mkdir -p /dd/tmp/MF > /nil 2>/nil; rm -f /dd/tmp/MF/logo10.*; echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/MF/run.mf; builtin cd /dd/tmp/MF; virmf < run.mf > /nil; export GFFONTS=/dd/tmp/MF; export PKFONTS=/dd/tmp/MF
wait    50
run     builtin cd /dd/tmp/MF
run     clear
wait    1
run     gftopk logo10.120gf logo10.120pk
wait    20
run     ls -l logo10.120gf logo10.120pk
wait    5

shot    pktype
size    30 80
cap     Reads a packed PK font back and describes it: the head of what it
cap     says about the logo font.
try     pktype logo10.120pk > pt.out; cat pt.out | head -n 16
run     mkdir -p /dd/tmp/MF > /nil 2>/nil; rm -f /dd/tmp/MF/logo10.*; echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/MF/run.mf; builtin cd /dd/tmp/MF; virmf < run.mf > /nil; export GFFONTS=/dd/tmp/MF; export PKFONTS=/dd/tmp/MF; gftopk logo10.120gf /dd/tmp/MF/logo10.120pk > /nil
wait    70
run     clear
wait    1
run     pktype logo10.120pk > pt.out
wait    20
run     cat pt.out | head -n 16
wait    4

shot    pktogf
cap     Unpacks a PK font back to GF, the other half of gftopk.
try     pktogf logo10.120pk back.120gf; ls -l logo10.120gf back.120gf
run     mkdir -p /dd/tmp/MF > /nil 2>/nil; rm -f /dd/tmp/MF/logo10.* /dd/tmp/MF/back.120gf; echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/MF/run.mf; builtin cd /dd/tmp/MF; virmf < run.mf > /nil; export GFFONTS=/dd/tmp/MF; export PKFONTS=/dd/tmp/MF; gftopk logo10.120gf /dd/tmp/MF/logo10.120pk > /nil
wait    70
run     builtin cd /dd/tmp/MF
run     clear
wait    1
run     pktogf logo10.120pk back.120gf
wait    20
run     ls -l logo10.120gf back.120gf
wait    5
