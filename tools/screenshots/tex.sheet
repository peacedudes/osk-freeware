# TeX, its formats, WEB, the DVI drivers and the font tools, one stanza
# per program.  Every stanza makes what it reads under /dd/tmp/TEX;
# the sample story is Knuth's own, from SYS/TEX/SAMPLES, with \end
# appended so TeX finishes without a prompt.

shot    tex
size    30 80
cap     TeX typesetting Knuth's sample story: the plain format loads, the
cap     page is set, and a DVI file is written beside the source.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex
wait    3
run     clear
wait    1
run     cat /dd/tmp/TEX/story.tex | head -n 6
wait    3
run     ksh -c "cd /dd/tmp/TEX; tex story.tex"
wait    40
run     ls -l /dd/tmp/TEX/story.dvi
wait    4

shot    virtex
size    30 80
cap     The TeX engine itself, told which format to load: `&plain' and
cap     then the file.  tex and latex are one-line wrappers round this.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex
wait    3
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; virtex '&plain' story.tex"
wait    40

shot    latex
size    30 80
cap     LaTeX setting the small sample document that ships with it, and
cap     reporting the page as it writes it.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/small.dvi /dd/tmp/TEX/small.aux; cp /dd/SYS/TEX/SAMPLES/small.tex /dd/tmp/TEX/small.tex
wait    3
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; latex small.tex"
wait    60
run     ls -l /dd/tmp/TEX/small.dvi
wait    4

shot    slitex
cap     SliTeX, the slide-making variant: the same engine with the slides
cap     format loaded.  Its banner and prompt, with nothing to set.
run     slitex
wait    12
send    \134end\r
wait    5

shot    initex
cap     The format-building TeX: it reads macro files and dumps a format
cap     the other TeXs load.  Its banner and prompt; \end leaves it.
run     initex
wait    12
send    \134end\r
wait    5

shot    texidx
cap     Builds an index from the entries a TeX run writes out: its usage.
run     texidx -?
wait    5

shot    bibtex
cap     BibTeX, the bibliography processor.  It reads the job name from
cap     its input -- the prompt is that -- and then looks for the .aux
cap     file a LaTeX run left.
run     bibtex
wait    12

shot    afm2tfm
cap     Turns a PostScript font's metrics (an .afm) into the .tfm TeX
cap     needs: its usage, there being no .afm on the disk.
run     afm2tfm
wait    6

shot    maketexpk
cap     Makes a packed bitmap font for a printer by running Metafont: its
cap     usage.
run     maketexpk
wait    6

shot    tangle
size    30 80
cap     TANGLE turns a WEB source into the Pascal program in it.  It
cap     always wants a change file named as well; none.ch is an empty one.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/sample.p; cp /dd/DOC/tex/sample.web /dd/tmp/TEX/sample.web; cp /dd/DOC/tex/none.ch /dd/tmp/TEX/none.ch
wait    3
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; tangle sample none"
wait    15
run     cat /dd/tmp/TEX/sample.p
wait    5

shot    weave
size    30 80
cap     WEAVE, the other half: the same WEB source becomes a TeX document
cap     with an index.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/sample.tex; cp /dd/DOC/tex/sample.web /dd/tmp/TEX/sample.web; cp /dd/DOC/tex/none.ch /dd/tmp/TEX/none.ch
wait    3
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; weave sample none"
wait    15
run     cat /dd/tmp/TEX/sample.tex | head -n 8
wait    5

shot    dvitype
size    36 80
cap     Reads a DVI file back and prints what is in it: the fonts and, at
cap     the level chosen, every character and the position TeX gave it.
cap     It asks five questions and takes the default for each.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvitype story.dvi" < /nil | head -n 30
wait    20

shot    dvialw
size    36 80
cap     The DVI driver for the Apple LaserWriter: it turns the story's DVI
cap     into PostScript beside it, rendering the text from the 300 dpi
cap     Computer Modern fonts this collection now ships (SYS/TEX/FONTS).
cap     It reports [OK] and the PostScript carries the real glyphs.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_alw; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvialw story.dvi"
wait    25
run     cat /dd/tmp/TEX/story.dvi_alw | head -n 6
wait    5

shot    dvidjp
size    36 80
cap     The DVI driver for the HP DeskJet, on the same story: at 300 dpi
cap     it finds the shipped Computer Modern fonts and renders the page,
cap     the output growing from the DVI by the size of the glyph rasters.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvidjp story.dvi"
wait    25
run     ls -l /dd/tmp/TEX | grep story.dvi_
wait    5

shot    dvieps
size    36 80
cap     The DVI driver for Epson dot-matrix printers (240 dpi).  There is
cap     no 240 dpi font here, so it scales the shipped 300 dpi ones by
cap     nearest neighbor -- which it announces per font -- and renders.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvieps story.dvi"
wait    25
run     ls -l /dd/tmp/TEX | grep story.dvi_
wait    5

shot    dviimp
size    36 80
cap     The DVI driver for the Imagen laser printer (300 dpi), on the same
cap     story: it finds the shipped 300 dpi fonts and renders the page.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dviimp story.dvi"
wait    25
run     ls -l /dd/tmp/TEX | grep story.dvi_
wait    5

shot    dvijep
size    36 80
cap     The DVI driver for the HP LaserJet Plus (300 dpi), on the same
cap     story: it finds the shipped 300 dpi fonts and renders the page.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvijep story.dvi"
wait    25
run     ls -l /dd/tmp/TEX | grep story.dvi_
wait    5

shot    dvijet
size    36 80
cap     The DVI driver for the HP LaserJet (120 dpi default): it scales the
cap     shipped 300 dpi fonts by nearest neighbor and renders the page.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvijet story.dvi"
wait    25
run     ls -l /dd/tmp/TEX | grep story.dvi_
wait    5

shot    dvilj2
size    36 80
cap     The DVI driver for the HP LaserJet II (300 dpi), on the same story:
cap     it finds the shipped 300 dpi Computer Modern fonts, reports [OK],
cap     and the PCL it writes carries the real glyph rasters.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvilj2 story.dvi"
wait    25
run     ls -l /dd/tmp/TEX | grep story.dvi_
wait    5

shot    dvimac
size    36 80
cap     The DVI driver for the Apple ImageWriter (120 dpi): it scales the
cap     shipped 300 dpi fonts by nearest neighbor and renders the page.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvimac story.dvi"
wait    25
run     ls -l /dd/tmp/TEX | grep story.dvi_
wait    5

shot    dvioki
size    36 80
cap     The DVI driver for Okidata printers (144 dpi): it scales the
cap     shipped 300 dpi fonts by nearest neighbor and renders the page.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvioki story.dvi"
wait    25
run     ls -l /dd/tmp/TEX | grep story.dvi_
wait    5

shot    dvitos
size    36 80
cap     The DVI driver for Toshiba printers (166 dpi): it scales the
cap     shipped 300 dpi fonts by nearest neighbor and renders the page.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvitos story.dvi"
wait    25
run     ls -l /dd/tmp/TEX | grep story.dvi_
wait    5

shot    dvips
size    36 80
cap     dvips, the later PostScript driver.  It stops at once for want
cap     of its header file, tex.pro, which is not on the disk; dvialw is
cap     the PostScript driver that runs.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/story.dvi /dd/tmp/TEX/story.dvi_*; cat /dd/SYS/TEX/SAMPLES/story.tex > /dd/tmp/TEX/story.tex; printf '\\end\r' >> /dd/tmp/TEX/story.tex; ksh -c "cd /dd/tmp/TEX; tex story.tex" > /nil
wait    40
run     clear
wait    1
run     ksh -c "cd /dd/tmp/TEX; dvips story.dvi"
wait    20

shot    tftopl
size    30 80
cap     Turns a binary font metric file into a readable property list:
cap     the head of what it makes of cmr10.tfm.
run     tftopl /dd/SYS/TEX/FONTS/TFM/cmr10.tfm | head -n 20
wait    20

shot    pltotf
cap     The other way: a property list back into a binary .tfm, and the
cap     round trip gives a file of the same size.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; tftopl /dd/SYS/TEX/FONTS/TFM/cmr10.tfm > /dd/tmp/TEX/cmr10.pl
wait    20
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pltotf tmp/TEX/cmr10.pl tmp/TEX/cmr10.tfm
wait    20
run     ls -l SYS/TEX/FONTS/TFM/cmr10.tfm tmp/TEX/cmr10.tfm
wait    5

shot    vptovf
cap     Compiles a virtual-font property list into a .vf and its .tfm:
cap     here a one-character font that maps onto cmr10.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; rm -f /dd/tmp/TEX/s.vf /dd/tmp/TEX/s.tfm
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     vptovf DOC/tex/sample.vpl tmp/TEX/s.vf tmp/TEX/s.tfm
wait    20
run     ls -l tmp/TEX/s.vf tmp/TEX/s.tfm
wait    4

shot    vftovp
size    30 80
cap     Reads a virtual font back into the property list it came from.
cap     VFFONTS and TEXFONTS name the directory, because the font search
cap     paths do not include the current one.
run     mkdir -p /dd/tmp/TEX > /nil 2>/nil; vptovf /dd/DOC/tex/sample.vpl /dd/tmp/TEX/s.vf /dd/tmp/TEX/s.tfm > /nil; export VFFONTS=/dd/tmp/TEX; export TEXFONTS=/dd/tmp/TEX:/dd/SYS/TEX/FONTS/TFM
wait    20
run     builtin cd /dd
wait    1
run     clear
wait    1
run     vftovp s.vf s.tfm tmp/TEX/back.vpl
wait    20
run     cat tmp/TEX/back.vpl | head -n 16
wait    5

shot    virmf
size    36 80
cap     Metafont rendering the seven-character METAFONT logo font at a
cap     low resolution, from its source in MFINPUTS, and writing the
cap     bitmap font, its metrics and a log beside it.
run     mkdir -p /dd/tmp/MF > /nil 2>/nil; rm -f /dd/tmp/MF/logo10.*; echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/MF/run.mf
wait    3
run     clear
wait    1
run     ksh -c "cd /dd/tmp/MF; virmf < run.mf"
wait    50
run     ls -l /dd/tmp/MF
wait    5

shot    inimf
cap     The base-building Metafont: it reads plain.mf and dumps the base
cap     the other Metafont loads.  Its banner and prompt.
run     inimf
wait    12
send    \134end\r
wait    5

shot    gftype
size    36 80
cap     Draws a bitmap font's characters as text: the M of the METAFONT
cap     logo font, from the GF file Metafont wrote.  GFFONTS names the
cap     directory.
run     mkdir -p /dd/tmp/MF > /nil 2>/nil; rm -f /dd/tmp/MF/logo10.*; echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/MF/run.mf; ksh -c "cd /dd/tmp/MF; virmf < run.mf" > /nil; export GFFONTS=/dd/tmp/MF
wait    50
run     clear
wait    1
run     gftype -i logo10.120gf | sed -n 4,22p
wait    25

shot    gftopk
cap     Packs a GF bitmap font into the smaller PK form the DVI drivers
cap     read; the two sizes side by side.
run     mkdir -p /dd/tmp/MF > /nil 2>/nil; rm -f /dd/tmp/MF/logo10.*; echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/MF/run.mf; ksh -c "cd /dd/tmp/MF; virmf < run.mf" > /nil; export GFFONTS=/dd/tmp/MF; export PKFONTS=/dd/tmp/MF
wait    50
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gftopk logo10.120gf tmp/MF/logo10.120pk
wait    20
run     ls -l tmp/MF/logo10.120gf tmp/MF/logo10.120pk
wait    5

shot    pktype
size    30 80
cap     Reads a packed PK font back and describes it: the head of what it
cap     says about the logo font.
run     mkdir -p /dd/tmp/MF > /nil 2>/nil; rm -f /dd/tmp/MF/logo10.*; echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/MF/run.mf; ksh -c "cd /dd/tmp/MF; virmf < run.mf" > /nil; export GFFONTS=/dd/tmp/MF; export PKFONTS=/dd/tmp/MF; gftopk logo10.120gf /dd/tmp/MF/logo10.120pk > /nil
wait    70
run     clear
wait    1
run     pktype logo10.120pk | head -n 16
wait    20

shot    pktogf
cap     Unpacks a PK font back to GF, the other half of gftopk.
run     mkdir -p /dd/tmp/MF > /nil 2>/nil; rm -f /dd/tmp/MF/logo10.* /dd/tmp/MF/back.120gf; echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/MF/run.mf; ksh -c "cd /dd/tmp/MF; virmf < run.mf" > /nil; export GFFONTS=/dd/tmp/MF; export PKFONTS=/dd/tmp/MF; gftopk logo10.120gf /dd/tmp/MF/logo10.120pk > /nil
wait    70
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pktogf logo10.120pk tmp/MF/back.120gf
wait    20
run     ls -l tmp/MF/logo10.120gf tmp/MF/back.120gf
wait    5
