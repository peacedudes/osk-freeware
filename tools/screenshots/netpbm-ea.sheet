# netpbm "edit & analyse": the tools that take a PNM image (PBM bitmap, PGM
# greyscale or PPM colour) and change it, measure it or make one from
# scratch -- scale, crop, rotate, pad, paste, quantise, filter, and report.
#
# Each stanza is self-contained: it makes its own small test image under
# /dd/tmp/NEAB, then `clear's the screen before the run that is the picture,
# so the panel shows that one program's own work.  Geometry is shown with
# pnmfile before and after (the dimensions change); filters and generators
# are rendered back to characters with pbmtoascii so the effect is visible.

shot    pbmmake
cap     Makes a blank bitmap of a given size and fill -- the starting point
cap     most of the PBM tools build on.  `-g' lays down a grey checkerboard,
cap     `-w' all white, `-b' all black; pbmtoascii renders it back to text.
try     pbmmake -g 48 16 | pbmtoascii
os9     pbmmake -g 48 16 ! pbmtoascii
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     clear
run     pbmmake -g 48 16 | pbmtoascii
wait    5

shot    ppmmake
cap     Fills an image with a single colour -- the blank canvas the PPM
cap     tools start from.  The colour is hex r/g/b; ppmhist reads it straight
cap     back off the result, one colour over all 800 pixels.
try     ppmmake rgb:ff/80/00 40 20 > tmp/NEAB/a.ppm; pnmfile tmp/NEAB/a.ppm; ppmhist tmp/NEAB/a.ppm
os9     ppmmake rgb:ff/80/00 40 20 >-tmp/NEAB/a.ppm; pnmfile tmp/NEAB/a.ppm; ppmhist tmp/NEAB/a.ppm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     builtin cd /dd
wait    1
run     clear
run     ppmmake rgb:ff/80/00 40 20 > tmp/NEAB/a.ppm
wait    3
run     pnmfile tmp/NEAB/a.ppm
wait    3
run     ppmhist tmp/NEAB/a.ppm
wait    3

shot    ppmforge
cap     Invents a whole world from a random seed: fractal terrain, sea,
cap     polar ice and a star field, none of it drawn by hand.  `-mesh' sets
cap     how finely the land is subdivided and the seed makes it repeatable.
try     ppmforge -mesh 8 -width 72 -height 44 -seed 7 > tmp/NEAB/pl.ppm; ppmtopgm tmp/NEAB/pl.ppm | pgmtopbm | pbmtoascii -2x4
os9     ppmforge -mesh 8 -width 72 -height 44 -seed 7 >-tmp/NEAB/pl.ppm; ppmtopgm tmp/NEAB/pl.ppm ! pgmtopbm ! pbmtoascii -2x4
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     builtin cd /dd
wait    1
run     clear
run     ppmforge -mesh 8 -width 72 -height 44 -seed 7 > tmp/NEAB/pl.ppm
wait    40
run     ppmtopgm tmp/NEAB/pl.ppm | pgmtopbm | pbmtoascii -2x4
wait    6

shot    pnmscale
cap     Scales an image.  One number is a factor -- 2 doubles each side --
cap     while -xysize fits it to exact dimensions.  A 32x16 ramp doubled to
cap     64x32.  Given only a filename it takes THAT as the factor, so always
cap     name the factor.
try     pnmscale 2 tmp/NEAB/r.pgm > tmp/NEAB/b.pgm; pnmfile tmp/NEAB/r.pgm tmp/NEAB/b.pgm
os9     pnmscale 2 tmp/NEAB/r.pgm >-tmp/NEAB/b.pgm; pnmfile tmp/NEAB/r.pgm tmp/NEAB/b.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 32 16 > /dd/tmp/NEAB/r.pgm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     pnmscale 2 tmp/NEAB/r.pgm > tmp/NEAB/b.pgm
wait    4
run     pnmfile tmp/NEAB/r.pgm tmp/NEAB/b.pgm
wait    4

shot    pnmcut
cap     Cuts a rectangle out of an image -- top-left corner, then width and
cap     height.  A 24x12 window taken out of a 48x24 ramp.
try     pnmcut 8 4 24 12 tmp/NEAB/r.pgm > tmp/NEAB/c.pgm; pnmfile tmp/NEAB/r.pgm tmp/NEAB/c.pgm; pgmtopbm tmp/NEAB/c.pgm | pbmtoascii -2x4
os9     pnmcut 8 4 24 12 tmp/NEAB/r.pgm >-tmp/NEAB/c.pgm; pnmfile tmp/NEAB/r.pgm tmp/NEAB/c.pgm; pgmtopbm tmp/NEAB/c.pgm ! pbmtoascii -2x4
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 48 24 > /dd/tmp/NEAB/r.pgm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     pnmcut 8 4 24 12 tmp/NEAB/r.pgm > tmp/NEAB/c.pgm
wait    4
run     pnmfile tmp/NEAB/r.pgm tmp/NEAB/c.pgm
wait    3
run     pgmtopbm tmp/NEAB/c.pgm | pbmtoascii -2x4
wait    4

shot    pnmcrop
cap     Trims a uniform border away.  An image padded with a black margin
cap     comes back its original size, and pnmcrop reports how many rows and
cap     columns it removed from each edge.
try     pnmcrop tmp/NEAB/p.pgm > tmp/NEAB/c.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 40 20 > /dd/tmp/NEAB/r.pgm
wait    3
run     pnmpad -black -l8 -r8 -t4 -b4 /dd/tmp/NEAB/r.pgm > /dd/tmp/NEAB/p.pgm
wait    4
run     builtin cd /dd
wait    1
run     clear
run     pnmcrop tmp/NEAB/p.pgm > tmp/NEAB/c.pgm
wait    4
run     pnmfile tmp/NEAB/p.pgm tmp/NEAB/c.pgm
wait    4

shot    pnmpad
cap     Adds a border of a chosen colour and width.  The margins are written
cap     attached to the side -- -l8 for eight columns on the left, -t4 for
cap     four rows on top -- putting a white frame round a small ramp.
try     pnmpad -white -l8 -r8 -t4 -b4 tmp/NEAB/r.pgm > tmp/NEAB/p.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 24 12 > /dd/tmp/NEAB/r.pgm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     pnmpad -white -l8 -r8 -t4 -b4 tmp/NEAB/r.pgm > tmp/NEAB/p.pgm
wait    4
run     pnmfile tmp/NEAB/r.pgm tmp/NEAB/p.pgm
wait    3
run     pgmtopbm tmp/NEAB/p.pgm | pbmtoascii -2x4
wait    4

shot    pnmpaste
cap     Pastes one image into another at a given position.  A top-to-bottom
cap     ramp dropped into a left-to-right one at column 8, row 8, over-writing
cap     what was there.
try     pnmpaste tmp/NEAB/pt.pgm 8 8 tmp/NEAB/r.pgm > tmp/NEAB/ps.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 48 24 > /dd/tmp/NEAB/r.pgm
wait    3
run     pgmramp -tb 16 10 > /dd/tmp/NEAB/pt.pgm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     pnmpaste tmp/NEAB/pt.pgm 8 8 tmp/NEAB/r.pgm > tmp/NEAB/ps.pgm
wait    4
run     pgmtopbm tmp/NEAB/ps.pgm | pbmtoascii -2x4
wait    4

shot    pnmenlarge
cap     Enlarges an image by a whole-number factor, copying each pixel into
cap     an NxN block.  A 16x8 checkerboard becomes 48x24 at factor 3.
try     pnmenlarge 3 tmp/NEAB/b.pbm > tmp/NEAB/e.pbm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pbmmake -g 16 8 > /dd/tmp/NEAB/b.pbm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     pnmenlarge 3 tmp/NEAB/b.pbm > tmp/NEAB/e.pbm
wait    4
run     pnmfile tmp/NEAB/b.pbm tmp/NEAB/e.pbm
wait    3
run     pbmtoascii tmp/NEAB/e.pbm
wait    4

shot    pnmflip
cap     Mirrors or rotates an image by a right angle -- left-right,
cap     top-bottom, transpose, or 90/180/270 degrees.  A left-to-right ramp
cap     flipped left-right runs the other way.
try     pnmflip -lr tmp/NEAB/r.pgm | pgmtopbm | pbmtoascii -2x4
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 56 12 > /dd/tmp/NEAB/r.pgm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     pgmtopbm tmp/NEAB/r.pgm | pbmtoascii -2x4
wait    4
run     pnmflip -lr tmp/NEAB/r.pgm | pgmtopbm | pbmtoascii -2x4
wait    5

shot    pnmrotate
cap     Rotates an image by any angle.  The result is the smallest upright
cap     rectangle that holds the turned picture, so its size grows -- a 48x24
cap     ramp turned 20 degrees needs 55x41.
try     pnmrotate 20 tmp/NEAB/r.pgm > tmp/NEAB/o.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 48 24 > /dd/tmp/NEAB/r.pgm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     pnmrotate 20 tmp/NEAB/r.pgm > tmp/NEAB/o.pgm
wait    5
run     pnmfile tmp/NEAB/r.pgm tmp/NEAB/o.pgm
wait    4

shot    pnmshear
cap     Slants an image sideways by an angle, turning a rectangle into a
cap     parallelogram; the width grows to hold the slant.  A ramp sheared 20
cap     degrees.
try     pnmshear 20 tmp/NEAB/r.pgm > tmp/NEAB/s.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 40 24 > /dd/tmp/NEAB/r.pgm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     pnmshear 20 tmp/NEAB/r.pgm > tmp/NEAB/s.pgm
wait    5
run     pnmfile tmp/NEAB/r.pgm tmp/NEAB/s.pgm
wait    3
run     pgmtopbm tmp/NEAB/s.pgm | pbmtoascii -2x4
wait    4

shot    pnmdepth
cap     Changes the number of grey levels -- the maxval.  Taking a smooth
cap     255-level ramp down to 15 levels posterises it into visible bands,
cap     and pnmfile shows the new maxval.
try     pnmdepth 15 tmp/NEAB/r.pgm > tmp/NEAB/d.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 64 16 > /dd/tmp/NEAB/r.pgm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     pnmdepth 15 tmp/NEAB/r.pgm > tmp/NEAB/d.pgm
wait    4
run     pnmfile tmp/NEAB/r.pgm tmp/NEAB/d.pgm
wait    4

shot    pnmgamma
cap     Applies gamma correction: it bends the midtones brighter or darker
cap     while leaving black and white fixed.  A linear ramp at gamma 0.5
cap     redistributes its greys, which the dither below shows as denser mid.
try     pnmgamma 0.5 tmp/NEAB/r.pgm | pgmtopbm | pbmtoascii -2x4
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 64 16 > /dd/tmp/NEAB/r.pgm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     pgmtopbm tmp/NEAB/r.pgm | pbmtoascii -2x4
wait    4
run     pnmgamma 0.5 tmp/NEAB/r.pgm | pgmtopbm | pbmtoascii -2x4
wait    5

shot    pgmnorm
cap     Stretches the contrast: it finds the darkest and lightest greys the
cap     image actually uses and remaps them to full black and white.  A
cap     cratered moon that sits in the middle of the range is spread across
cap     all of it.
try     pgmnorm mo.pgm > mn.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmcrater -number 40 -xsize 64 -ysize 40 > /dd/tmp/NEAB/mo.pgm
wait    12
run     builtin cd /dd/tmp/NEAB
run     clear
run     pgmnorm mo.pgm > mn.pgm
wait    5
run     pgmtopbm mn.pgm | pbmtoascii -2x4
wait    5

shot    pgmedge
cap     An edge detector: it keeps the places where brightness changes and
cap     darkens the flat areas, turning a greyscale image into a map of its
cap     edges.  Here it reads a greyed gingham weave and writes a new
cap     greymap of the same size; pnmfile confirms the edge image it made.
try     pgmedge gg.pgm > eg.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     ppmpat -gingham3 40 20 | ppmtopgm > /dd/tmp/NEAB/gg.pgm
wait    5
run     builtin cd /dd/tmp/NEAB
run     clear
run     pgmedge gg.pgm > eg.pgm
wait    20
run     pnmfile gg.pgm eg.pgm
wait    5

shot    pgmkernel
cap     Generates a convolution matrix -- the weights pnmconvol multiplies
cap     an image by.  Given a size it prints the matrix as a small greyscale
cap     image, the centre weight largest and falling off to the edges.
try     pgmkernel 5
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     clear
run     pgmkernel 5
wait    4

shot    pnmconvol
cap     Convolves an image with a weighting matrix -- the operation behind
cap     blurring, sharpening and edge filters.  Here the matrix from pgmkernel
cap     averages each pixel with its neighbours, smoothing a field of noise.
try     pnmconvol tmp/NEAB/k.pgm tmp/NEAB/n.pgm > tmp/NEAB/cv.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmnoise 48 24 > /dd/tmp/NEAB/n.pgm
wait    5
run     pgmkernel 3 > /dd/tmp/NEAB/k.pgm
wait    4
run     builtin cd /dd
wait    1
run     clear
run     pnmconvol tmp/NEAB/k.pgm tmp/NEAB/n.pgm > tmp/NEAB/cv.pgm
wait    18
run     pgmtopbm tmp/NEAB/cv.pgm | pbmtoascii -2x4
wait    6

shot    pnmsmooth
cap     Averages each pixel with its neighbours to smooth an image, and it
cap     builds the averaging matrix -- shown here by its -dump option -- in a
cap     temporary file on the RAM disk /r0.  With no such disk mounted the
cap     smoothing step writes nothing; pnmconvol does the same averaging.
try     pnmsmooth -size 5 5 -dump tmp/NEAB/mk.pgm > /nil 2>/nil
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     builtin cd /dd
wait    1
run     clear
run     pnmsmooth -size 5 5 -dump tmp/NEAB/mk.pgm > /nil 2>/nil
wait    4
run     cat tmp/NEAB/mk.pgm
wait    4

shot    pnmhistmap
cap     Draws the image's histogram AS an image -- a bar for every grey
cap     level, its height the count of pixels at that level.  Fed a cratered
cap     moon it plots that image's distribution into a fresh 256x200 picture,
cap     which pnmfile identifies.
try     pnmhistmap tmp/NEAB/mo.pgm > tmp/NEAB/hm.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmcrater -number 40 -xsize 64 -ysize 40 > /dd/tmp/NEAB/mo.pgm
wait    12
run     builtin cd /dd
wait    1
run     clear
run     pnmhistmap tmp/NEAB/mo.pgm > tmp/NEAB/hm.pgm
wait    6
run     pnmfile tmp/NEAB/mo.pgm tmp/NEAB/hm.pgm
wait    4

shot    ppmmix
cap     Blends two images by a fraction -- 0.5 is an even average.  A red
cap     frame and a blue one mix to the purple ppmhist reports underneath.
try     ppmmix 0.5 tmp/NEAB/a.ppm tmp/NEAB/b.ppm > tmp/NEAB/m.ppm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     ppmmake rgb:ff/00/00 40 20 > /dd/tmp/NEAB/a.ppm
wait    3
run     ppmmake rgb:00/00/ff 40 20 > /dd/tmp/NEAB/b.ppm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     ppmmix 0.5 tmp/NEAB/a.ppm tmp/NEAB/b.ppm > tmp/NEAB/m.ppm
wait    4
run     ppmhist tmp/NEAB/m.ppm
wait    4

shot    ppmshift
cap     Shifts each row of an image sideways by a random amount, up to the
cap     number you give -- a melted, watery look.  A tartan weave shows it
cap     plainly: the straight lines break up row by row.
try     ppmshift 6 tmp/NEAB/t.ppm > tmp/NEAB/s.ppm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     ppmpat -tartan 64 32 > /dd/tmp/NEAB/t.ppm
wait    3
run     builtin cd /dd
wait    1
run     clear
run     ppmshift 6 tmp/NEAB/t.ppm > tmp/NEAB/s.ppm
wait    4
run     ppmtopgm tmp/NEAB/s.ppm | pgmtopbm | pbmtoascii -2x4
wait    5

shot    ppm3d
cap     Builds a red/blue 3-D anaglyph from two images, a left-eye and a
cap     right-eye view, taking red from one and blue-green from the other.
cap     Through coloured glasses the pair fuses into depth.
try     ppm3d tmp/NEAB/t.ppm tmp/NEAB/s.ppm > tmp/NEAB/3d.ppm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     ppmpat -tartan 64 32 > /dd/tmp/NEAB/t.ppm
wait    3
run     ppmshift 6 /dd/tmp/NEAB/t.ppm > /dd/tmp/NEAB/s.ppm
wait    4
run     builtin cd /dd
wait    1
run     clear
run     ppm3d tmp/NEAB/t.ppm tmp/NEAB/s.ppm > tmp/NEAB/3d.ppm
wait    4
run     pnmfile tmp/NEAB/3d.ppm
wait    3
run     ppmtopgm tmp/NEAB/3d.ppm | pgmtopbm | pbmtoascii -2x4
wait    5

shot    pbmreduce
cap     Shrinks a bitmap by a whole-number factor, averaging each NxN block
cap     down to one pixel.  A 48x24 checkerboard reduced by 2 comes out
cap     24x12, as pnmfile reports.
try     pbmreduce 2 tmp/NEAB/ck.pbm > tmp/NEAB/ck2.pbm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pbmmake -g 48 24 > /dd/tmp/NEAB/ck.pbm
run     builtin cd /dd
wait    1
run     clear
run     pbmreduce 2 tmp/NEAB/ck.pbm > tmp/NEAB/ck2.pbm
wait    4
run     pnmfile tmp/NEAB/ck.pbm tmp/NEAB/ck2.pbm
wait    4

shot    pgmenhance
cap     Sharpens a greyscale image by picking out its edges; -N sets the
cap     strength from 1 to 9.  A smooth left-to-right ramp comes back with
cap     its steps emphasised, rendered here to characters.
try     pgmenhance -9 tmp/NEAB/en.pgm > tmp/NEAB/enh.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 48 24 > /dd/tmp/NEAB/en.pgm
run     builtin cd /dd
wait    1
run     clear
run     pgmenhance -9 tmp/NEAB/en.pgm > tmp/NEAB/enh.pgm
wait    4
run     pgmtopbm tmp/NEAB/enh.pgm | pbmtoascii -2x4
wait    5

shot    pnmhisteq
cap     Equalises an image's tones so its brightness levels spread evenly.
cap     -verbose prints the mapping it applied, each old value to its new
cap     one and the pixel count at that level.
try     pnmhisteq -verbose tmp/NEAB/hq.pgm > tmp/NEAB/hqe.pgm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 40 20 > /dd/tmp/NEAB/hq.pgm
run     builtin cd /dd
wait    1
run     clear
run     pnmhisteq -verbose tmp/NEAB/hq.pgm > tmp/NEAB/hqe.pgm
wait    5

shot    ppmchange
cap     Replaces one colour with another throughout an image.  A solid red
cap     image becomes solid blue; ppmhist reads the single colour back
cap     before and after.
try     ppmchange rgb:ff/00/00 rgb:00/00/ff tmp/NEAB/rd.ppm > tmp/NEAB/bl.ppm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     ppmmake rgb:ff/00/00 40 20 > /dd/tmp/NEAB/rd.ppm
run     builtin cd /dd
wait    1
run     clear
run     ppmhist tmp/NEAB/rd.ppm
wait    3
run     ppmchange rgb:ff/00/00 rgb:00/00/ff tmp/NEAB/rd.ppm > tmp/NEAB/bl.ppm
wait    3
run     ppmhist tmp/NEAB/bl.ppm
wait    3

shot    ppmdim
cap     Dims an image by a factor between 0 and 1, scaling every pixel
cap     toward black.  White at 255 becomes grey at 127 when dimmed by
cap     half, as ppmhist shows.
try     ppmdim 0.5 tmp/NEAB/wh.ppm > tmp/NEAB/dm.ppm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     ppmmake rgb:ff/ff/ff 40 20 > /dd/tmp/NEAB/wh.ppm
run     builtin cd /dd
wait    1
run     clear
run     ppmhist tmp/NEAB/wh.ppm
wait    3
run     ppmdim 0.5 tmp/NEAB/wh.ppm > tmp/NEAB/dm.ppm
wait    3
run     ppmhist tmp/NEAB/dm.ppm
wait    3

shot    ppmbrighten
cap     Adjusts an image's brightness and saturation in HSV; -value gives
cap     the percentage change.  A dull brown lightened by 50 percent, its
cap     colour read back by ppmhist.
try     ppmbrighten -value +50 tmp/NEAB/br.ppm > tmp/NEAB/brr.ppm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     ppmmake rgb:80/40/20 40 20 > /dd/tmp/NEAB/br.ppm
run     builtin cd /dd
wait    1
run     clear
run     ppmhist tmp/NEAB/br.ppm
wait    3
run     ppmbrighten -value +50 tmp/NEAB/br.ppm > tmp/NEAB/brr.ppm
wait    3
run     ppmhist tmp/NEAB/brr.ppm
wait    3

shot    ppmnorm
cap     Stretches an image's contrast so its darkest and lightest pixels
cap     reach full black and white.  A flat grey remapped to white, ppmnorm
cap     reporting the range it moved.
try     ppmnorm tmp/NEAB/nd.ppm > tmp/NEAB/nn.ppm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     ppmmake rgb:ff/ff/ff 40 20 > /dd/tmp/NEAB/nw.ppm
run     ppmdim 0.4 /dd/tmp/NEAB/nw.ppm > /dd/tmp/NEAB/nd.ppm
run     builtin cd /dd
wait    1
run     clear
run     ppmhist tmp/NEAB/nd.ppm
wait    3
run     ppmnorm tmp/NEAB/nd.ppm > tmp/NEAB/nn.ppm
wait    3
run     ppmhist tmp/NEAB/nn.ppm
wait    3

shot    ppmspread
cap     Displaces each pixel by a random amount up to the number given,
cap     roughening an image.  A smooth ramp above, the same spread by 8
cap     below.
try     ppmspread 8 tmp/NEAB/sr.pgm > tmp/NEAB/sp.ppm
run     mkdir -p /dd/tmp/NEAB > /nil 2>/nil
run     pgmramp -lr 48 24 > /dd/tmp/NEAB/sr.pgm
run     builtin cd /dd
wait    1
run     clear
run     pgmtopbm tmp/NEAB/sr.pgm | pbmtoascii -2x4
wait    3
run     ppmspread 8 tmp/NEAB/sr.pgm > tmp/NEAB/sp.ppm
wait    3
run     ppmtopgm tmp/NEAB/sp.ppm | pgmtopbm | pbmtoascii -2x4
wait    4
