# The programmer's shelf: benchmarks, version control, beautifiers,
# checkers, cross-reference, tags, a debugger and two assembly tools.
# One stanza per program; every stanza makes what it reads under
# /dd/tmp/DEV.

shot    sieve
cap     The sieve of Eratosthenes benchmark: it counts primes for a fixed
cap     number of passes and reports how long that took.
run     sieve; echo "sieve returned $?"
wait    10

shot    fibo
cap     The Fibonacci benchmark: a recursive definition run to a fixed
cap     depth, timed.
run     fibo
wait    12

shot    float
cap     A floating-point loop, timed.
run     float; echo "float returned $?"
wait    12

shot    savage
size    30 80
cap     Savage's benchmark, which is about accuracy rather than speed: a
cap     chain of transcendental functions that should return exactly what
cap     went in, and the error it reports is how far the arithmetic drifted.
run     savage
wait    15

shot    dhry
size    30 80
cap     Dhrystone 2.1, the classic integer benchmark, built with Microware's
cap     cc.  It reads the number of runs from its input and then reports
cap     the checks and the rate; 500,000 runs is enough for the clock to
cap     measure.  Eleven more builds of the same source follow, so the
cap     compilers can be compared.
run     echo 500000 | dhry | tail -l=8
wait    30

shot    dhryO2
cap     Dhrystone built with Microware's cc at -O2.
run     echo 500000 | dhryO2 | tail -l=6
wait    30

shot    dhryGcc
cap     Dhrystone built with GCC 1.
run     echo 500000 | dhryGcc | tail -l=6
wait    30

shot    dhryGcco2
cap     Dhrystone built with GCC 1 at -O2.
run     echo 500000 | dhryGcco2 | tail -l=6
wait    30

shot    dhryGccin
cap     Dhrystone built with GCC 1 with inlining.
run     echo 500000 | dhryGccin | tail -l=6
wait    30

shot    dhryGccmx
cap     Dhrystone built with GCC 1, mixed options.
run     echo 500000 | dhryGccmx | tail -l=6
wait    30

shot    dhryGcc2
cap     Dhrystone built with GCC 2.
run     echo 500000 | dhryGcc2 | tail -l=6
wait    30

shot    dhryGcc2o2
cap     Dhrystone built with GCC 2 at -O2.
run     echo 500000 | dhryGcc2o2 | tail -l=6
wait    30

shot    dhryGcc2in
cap     Dhrystone built with GCC 2 with inlining.
run     echo 500000 | dhryGcc2in | tail -l=6
wait    30

shot    dhryGcc2mx
cap     Dhrystone built with GCC 2, mixed options.
run     echo 500000 | dhryGcc2mx | tail -l=6
wait    30

shot    dhryshamu
cap     Dhrystone, the shamu build.
run     echo 500000 | dhryshamu | tail -l=6
wait    30

shot    dhryshamu2
cap     Dhrystone, the second shamu build.
run     echo 500000 | dhryshamu2 | tail -l=6
wait    30

shot    time
cap     Times a command the way OS-9 accounts for it: here the sieve.
run     time sieve
wait    14

shot    timid
cap     Times a command by the clock: start, end and elapsed ticks.
run     timid today
wait    8

shot    disktest
cap     Measures how long reads and writes really take through the disk
cap     system.  Its one option is its syntax; run on a disk it ends the
cap     session, so its syntax is what there is to show.
run     disktest -?
wait    8

shot    ci
size    30 80
cap     RCS: checking a file in.  ci asks for a description, writes the
cap     archive beside the file -- note_v, because OS-9 has no comma in a
cap     file name -- and removes the working file.
run     rm -f /dd/tmp/DEV/rcs/note /dd/tmp/DEV/rcs/note_v; mkdir -p /dd/tmp/DEV/rcs > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/DEV/rcs/note
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ci tmp/DEV/rcs/note
wait    6
send    first draft\r
wait    3
send    .\r
wait    8
run     ls -l tmp/DEV/rcs
wait    4

shot    co
cap     RCS: checking the file out again from its archive.
run     rm -f /dd/tmp/DEV/rcs/note /dd/tmp/DEV/rcs/note_v; mkdir -p /dd/tmp/DEV/rcs > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/DEV/rcs/note; ci -t-draft /dd/tmp/DEV/rcs/note < /nil
wait    10
run     builtin cd /dd
wait    1
run     clear
wait    1
run     co tmp/DEV/rcs/note_v
wait    8
run     ls -l tmp/DEV/rcs; cat tmp/DEV/rcs/note
wait    4

shot    rlog
size    30 80
cap     RCS: the history of an archive -- head revision, locks, the
cap     description and each revision's log.
run     rm -f /dd/tmp/DEV/rcs/note /dd/tmp/DEV/rcs/note_v; mkdir -p /dd/tmp/DEV/rcs > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/DEV/rcs/note; ci -t-draft /dd/tmp/DEV/rcs/note < /nil
wait    10
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rlog tmp/DEV/rcs/note_v
wait    8

shot    rcsident
cap     RCS: looks for $Id$-style keywords in a file and prints them;
cap     this archive carries none, and it says so.
run     rm -f /dd/tmp/DEV/rcs/note /dd/tmp/DEV/rcs/note_v; mkdir -p /dd/tmp/DEV/rcs > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/DEV/rcs/note; ci -t-draft /dd/tmp/DEV/rcs/note < /nil
wait    10
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rcsident tmp/DEV/rcs/note_v
wait    6

shot    rcs
cap     RCS: the archive administration command -- access lists, locks,
cap     comment leaders.  It takes no -?, so its answer to one is its
cap     command format.
run     rcs -?
wait    6

shot    rcsdiff
cap     RCS: compares the working file with a revision.  It does that by
cap     running co through a shell with Microware's redirection syntax,
cap     which no shell here understands, and stops there.
run     rm -f /dd/tmp/DEV/rcs/note /dd/tmp/DEV/rcs/note_v; mkdir -p /dd/tmp/DEV/rcs > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/DEV/rcs/note; ci -t-draft /dd/tmp/DEV/rcs/note < /nil; co /dd/tmp/DEV/rcs/note_v > /nil
wait    12
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rcsdiff tmp/DEV/rcs/note_v
wait    8

shot    rcsmerge
cap     RCS: merges two revisions into the working file.  Like rcsdiff it
cap     runs co through a shell with Microware's redirection syntax, and
cap     stops where that fails.
run     rcsmerge
wait    6

shot    cb
cap     The C beautifier: it indents C that has none, reading standard
cap     input and writing standard output.
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; echo 'int main(){int i;for(i=0;i<3;i++){if(i)printf("%d ",i);else puts("zero");}return 0;}' > /dd/tmp/DEV/ugly.c
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/DEV/ugly.c
wait    3
run     cb < tmp/DEV/ugly.c
wait    8

shot    indent
size    30 80
cap     GNU indent reformatting C source to a house style: the head of
cap     what it makes of about.c, with -st sending it to the screen.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     indent SRC/keep/about.c -st | head -n 20
wait    15

shot    cpr
cap     Prints C source as a listing with a title, page numbers and line
cap     numbers, for paper: the head of one page.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cpr SRC/keep/about.c | head -n 16
wait    8

shot    unifdef
cap     Resolves #ifdef in C source for one setting of a symbol and leaves
cap     the rest alone: -dOSK keeps the OSK branch, -uOSK the other.
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; printf "#ifdef OSK\rint on_os9 = 1;\r#else\rint on_os9 = 0;\r#endif\rint always = 2;\r" > /dd/tmp/DEV/ifd.c
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/DEV/ifd.c
wait    3
run     unifdef -dOSK tmp/DEV/ifd.c
wait    5

shot    ifdef
cap     The same job by another author: -Dsymbol defines, -Usymbol
cap     undefines, and -t prints the table it worked from.
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; printf "#ifdef OSK\rint on_os9 = 1;\r#else\rint on_os9 = 0;\r#endif\rint always = 2;\r" > /dd/tmp/DEV/ifd.c
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ifdef -DOSK tmp/DEV/ifd.c
wait    5
run     ifdef -UOSK tmp/DEV/ifd.c
wait    5

shot    patch
size    30 80
cap     patch recognises a diff -- "Looks like a normal diff to me" -- and
cap     then cannot finish: it writes a temporary file and cannot read it
cap     back.  The file it was patching is left as it was.
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; printf "one\rtwo\rthree\r" > /dd/tmp/DEV/p1; printf "one\rTWO\rthree\r" > /dd/tmp/DEV/p2; diff /dd/tmp/DEV/p1 /dd/tmp/DEV/p2 > /dd/tmp/DEV/p.diff
wait    6
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/DEV/p.diff
wait    4
run     patch tmp/DEV/p1 tmp/DEV/p.diff
wait    10

shot    bcheck
cap     Counts brackets in a C source, line by line, so a mismatch can be
cap     found: the running depth beside each line.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     bcheck SRC/keep/about.c | head -n 16
wait    8

shot    ccheck
cap     Checks C source for mismatched brackets, quotes and comment
cap     markers, and for indentation that disagrees with the nesting.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ccheck SRC/keep/keep.c
wait    8

shot    ctags
cap     Builds the tags file vi uses to jump to a definition: one line
cap     per function, with the file and a search pattern.
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; rm -f /dd/tmp/DEV/tags
run     cp /dd/SRC/keep/keep.c /dd/tmp/DEV/keep.c
run     builtin cd /dd/tmp/DEV
wait    2
run     clear
wait    1
run     ctags keep.c
wait    6
run     head -n 8 tags
wait    4

shot    etags
cap     Builds the TAGS file emacs uses, the way ctags does for vi: it
cap     says nothing and leaves the file in the current directory.
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; rm -f /dd/tmp/DEV/TAGS
run     cp /dd/SRC/keep/about.c /dd/tmp/DEV/about.c
run     builtin cd /dd/tmp/DEV
wait    2
run     clear
wait    1
run     etags about.c
wait    8
run     ls -l TAGS
wait    4

shot    cxref
size    30 80
cap     A C cross-reference: the source listed with line numbers, then
cap     every symbol with the lines it appears on.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cxref SRC/keep/about.c | head -n 24
wait    10

shot    rdoc
size    30 80
cap     Reverse documentation: given C source it prints the control
cap     structure as an indented skeleton -- every if, else, for, switch
cap     and case in place, the code between them taken away.  The tail of
cap     what it makes of keep.c.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rdoc SRC/keep/keep.c | tail -l=24
wait    90

shot    xrf
size    44 80
cap     A C cross-reference generator that reads its language table,
cap     C.XRF, and the source both from the current directory; the table
cap     ships in DOC/xrf.
run     mkdir -p /dd/tmp/DEV/xrf > /nil 2>/nil; cp /dd/DOC/xrf/c.xrf /dd/tmp/DEV/xrf/C.XRF; cp /dd/SRC/keep/about.c /dd/tmp/DEV/xrf/about.c
run     builtin cd /dd/tmp/DEV/xrf
wait    4
run     clear
wait    1
run     xrf about.c
wait    12

shot    ref
cap     Looks a C function up in a tags file and prints the lines around
cap     where it is defined.  Here ctags indexes keep.c and ref shows the
cap     definition of crc_of, comment header and all.
run     rm -rf /dd/tmp/DEV/ref > /nil 2>/nil; mkdir -p /dd/tmp/DEV/ref > /nil 2>/nil
run     cp /dd/SRC/keep/keep.c /dd/tmp/DEV/ref/keep.c
run     builtin cd /dd/tmp/DEV/ref
run     ctags keep.c 2>/nil
wait    3
run     clear
wait    1
run     ref crc_of
wait    6

shot    libsplit
cap     Splits a library of the newer ROF type into its object files.
cap     The libraries on this disk are the older type, and it says so:
cap     unpacklib is the one for those.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     libsplit LIB/blarslib.l
wait    6

shot    sdb
cap     SDB 2.0, a symbolic debugger, opened on a program: its prompt.
cap     q leaves it.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sdb CMDS/today
wait    8
snap
send    q\r
wait    3

shot    trap
cap     An example trap handler.  Installing one needs system state, and
cap     from a user program it says so and stops.  Asked for by path
cap     because bash has a trap of its own.
run     /dd/CMDS/trap
wait    6

shot    tab
cap     Tabulates assembly source into label, opcode and argument
cap     columns, a filter; -b for 6809 mnemonics, 68000 otherwise.
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; printf " nam test\r start ldx #buf\rloop lda ,x+\r beq done\r bsr putc\r bra loop\rdone rts\rbuf fcc /hello/\r fcb 0\r end\r" > /dd/tmp/DEV/t.a
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/DEV/t.a
wait    3
run     tab -b < tmp/DEV/t.a
wait    6

shot    xlate
cap     Translates 6809 assembly source into 68000: registers mapped,
cap     branches sized, one instruction for one.
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; printf " nam test\r start ldx #buf\rloop lda ,x+\r beq done\r bsr putc\r bra loop\rdone rts\rbuf fcc /hello/\r fcb 0\r end\r" > /dd/tmp/DEV/t.a
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/DEV/t.a
wait    3
run     xlate tmp/DEV/t.a
wait    6
