# The programmer's shelf: benchmarks, version control, beautifiers,
# checkers, cross-reference, tags, a debugger and two assembly tools.
# One stanza per program; every stanza makes what it reads under
# /dd/tmp/DEV.

shot    sieve
cap     The sieve of Eratosthenes, a classic speed test: it finds the primes
cap     below a fixed limit and repeats the whole pass a hundred times.  Its
cap     whole output is the two lines below, and what it measures is the gap
cap     between them -- so run it under your own OS-9's `time' for a figure.
cap     The Dhrystone builds report their own rate; this one does not.
try     sieve
run     sieve
wait    10

shot    savage
cap     Savage's benchmark stresses accuracy rather than speed.  It runs a
cap     chain of functions that cancel out, so each pass should add exactly
cap     one; after a thousand passes the printed value has drifted from the
cap     round number it ought to reach, and that drift is the arithmetic's
cap     accumulated rounding error.
try     savage
run     savage
wait    15

shot    whetstone
cap     The Whetstone benchmark, the floating-point counterpart to the
cap     Dhrystone builds: a fixed mix of arithmetic, trigonometry and
cap     procedure calls, timed, with the rating in Whetstone instructions
cap     per second.  On an emulator the figure is the host's, not a 68000's.
try     whetstone
run     clear
run     whetstone
wait    10

shot    dhry
size    28 80
cap     Dhrystone 2.1, the classic integer benchmark, built with Microware's
cap     cc.  It reads the number of runs from its input and then reports the
cap     checks and the rate; 500,000 runs is enough for the clock to measure.
cap     Eleven more builds of the same source follow, so the compilers can be
cap     compared.
try     echo 500000 | dhry | tail -l=8
os9     echo 500000 ! dhry ! tail -l=8
run     echo 500000 | dhry | tail -l=8
wait    30

shot    dhryO2
cap     Dhrystone built with Microware's cc at -O2.
try     echo 500000 | dhryO2 | tail -l=6
os9     echo 500000 ! dhryO2 ! tail -l=6
run     echo 500000 | dhryO2 | tail -l=6
wait    30

shot    dhryGcc
cap     Dhrystone built with GCC 1.
try     echo 500000 | dhryGcc | tail -l=6
os9     echo 500000 ! dhryGcc ! tail -l=6
run     echo 500000 | dhryGcc | tail -l=6
wait    30

shot    dhryGcco2
cap     Dhrystone built with GCC 1 at -O2.
try     echo 500000 | dhryGcco2 | tail -l=6
os9     echo 500000 ! dhryGcco2 ! tail -l=6
run     echo 500000 | dhryGcco2 | tail -l=6
wait    30

shot    dhryGccin
cap     Dhrystone built with GCC 1 with inlining.
try     echo 500000 | dhryGccin | tail -l=6
os9     echo 500000 ! dhryGccin ! tail -l=6
run     echo 500000 | dhryGccin | tail -l=6
wait    30

shot    dhryGccmx
cap     Dhrystone built with GCC 1, mixed options.
try     echo 500000 | dhryGccmx | tail -l=6
os9     echo 500000 ! dhryGccmx ! tail -l=6
run     echo 500000 | dhryGccmx | tail -l=6
wait    30

shot    dhryGcc2
cap     Dhrystone built with GCC 2.
try     echo 500000 | dhryGcc2 | tail -l=6
os9     echo 500000 ! dhryGcc2 ! tail -l=6
run     echo 500000 | dhryGcc2 | tail -l=6
wait    30

shot    dhryGcc2o2
cap     Dhrystone built with GCC 2 at -O2.
try     echo 500000 | dhryGcc2o2 | tail -l=6
os9     echo 500000 ! dhryGcc2o2 ! tail -l=6
run     echo 500000 | dhryGcc2o2 | tail -l=6
wait    30

shot    dhryGcc2in
cap     Dhrystone built with GCC 2 with inlining.
try     echo 500000 | dhryGcc2in | tail -l=6
os9     echo 500000 ! dhryGcc2in ! tail -l=6
run     echo 500000 | dhryGcc2in | tail -l=6
wait    30

shot    dhryGcc2mx
cap     Dhrystone built with GCC 2, mixed options.
try     echo 500000 | dhryGcc2mx | tail -l=6
os9     echo 500000 ! dhryGcc2mx ! tail -l=6
run     echo 500000 | dhryGcc2mx | tail -l=6
wait    30

shot    dhryshamu
cap     Dhrystone, the shamu build.
try     echo 500000 | dhryshamu | tail -l=6
os9     echo 500000 ! dhryshamu ! tail -l=6
run     echo 500000 | dhryshamu | tail -l=6
wait    30

shot    dhryshamu2
cap     Dhrystone, a second shamu build.
try     echo 500000 | dhryshamu2 | tail -l=6
os9     echo 500000 ! dhryshamu2 ! tail -l=6
run     echo 500000 | dhryshamu2 | tail -l=6
wait    30

shot    disktest
cap     Times reads and writes through the disk system, in the current
cap     directory, with a buffer as big as it can get.  It asks your own
cap     OS-9's `free' for the sector count, so that must be resident.  The
cap     negative rates are the program's own: its arithmetic overflows on a
cap     buffer this size.  The only file it writes is disktest.tmp, which
cap     it removes.
try     disktest
run     load /h1/CMDS/free
run     rm -rf /dd/tmp/DKT; mkdir -p /dd/tmp/DKT; builtin cd /dd/tmp/DKT
wait    2
run     clear
wait    1
run     disktest
wait    15

shot    cb
cap     The C beautifier: it indents C that has none, reading standard input
cap     and writing standard output.  The one-line source goes in, laid-out C
cap     comes out.
try     cb < tmp/DEV/ugly.c
os9     cb <tmp/DEV/ugly.c
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; echo 'int main(){int i;for(i=0;i<3;i++){if(i)printf("%d ",i);else puts("zero");}return 0;}' > /dd/tmp/DEV/ugly.c
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/DEV/ugly.c
wait    3
run     cb < tmp/DEV/ugly.c
wait    8

shot    indent
size    30 80
cap     GNU indent reformatting C source to a house style: the head of what it
cap     makes of about.c, with -st sending the result to the screen.
try     indent SRC/keep/about.c -st | head -n 20
os9     indent SRC/keep/about.c -st ! head -n 20
run     builtin cd /dd
wait    1
run     clear
wait    1
run     indent SRC/keep/about.c -st | head -n 20
wait    15

shot    cpr
size    24 80
cap     Formats C source for printing: a title, a contents page listing the
cap     functions and the page each starts on, then the source itself with
cap     page and line numbers.  Here the contents page.
try     cpr SRC/keep/about.c | head -n 16
os9     cpr SRC/keep/about.c ! head -n 16
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cpr SRC/keep/about.c | head -n 16
wait    8

shot    unifdef
cap     Resolves #ifdef in C source for one setting of a symbol and leaves the
cap     rest alone: -dOSK keeps the OSK branch, -uOSK the other.
try     unifdef -dOSK tmp/DEV/ifd.c
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; printf "#ifdef OSK\rint on_os9 = 1;\r#else\rint on_os9 = 0;\r#endif\rint always = 2;\r" > /dd/tmp/DEV/ifd.c
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/DEV/ifd.c
wait    3
run     unifdef -dOSK tmp/DEV/ifd.c
wait    5

shot    ifdef
cap     The same job by another author: -Dsymbol keeps the branch for a symbol
cap     you define, -Usymbol the branch for one you leave undefined.  The same
cap     source is resolved both ways.
try     ifdef -DOSK tmp/DEV/ifd.c
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; printf "#ifdef OSK\rint on_os9 = 1;\r#else\rint on_os9 = 0;\r#endif\rint always = 2;\r" > /dd/tmp/DEV/ifd.c
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ifdef -DOSK tmp/DEV/ifd.c
wait    5
run     ifdef -UOSK tmp/DEV/ifd.c
wait    5

shot    patch
size    30 80
cap     patch applying a diff: it recognises what it was handed -- "Looks like
cap     a normal diff to me" -- takes Plan A, and the hunk succeeds.  The file
cap     is updated and the original is kept beside it as p1.orig.
cap     Until 2026-09-18 this card showed it failing, and the failure was its
cap     own: the port opened its files with Unix modes, and OS-9 reads mode 0
cap     as no access bits at all, so the read that followed was refused.
try     patch tmp/DEV/p1 tmp/DEV/p.diff
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; printf "one\rtwo\rthree\r" > /dd/tmp/DEV/p1; printf "one\rTWO\rthree\r" > /dd/tmp/DEV/p2; diff /dd/tmp/DEV/p1 /dd/tmp/DEV/p2 > /dd/tmp/DEV/p.diff
wait    6
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/DEV/p.diff
wait    4
run     patch tmp/DEV/p1 tmp/DEV/p.diff
wait    10
run     cat tmp/DEV/p1
wait    4

shot    bcheck
cap     Counts brackets in a C source, line by line, so a mismatch can be
cap     found: the running nesting depth beside each line.
try     bcheck SRC/keep/about.c | head -n 16
os9     bcheck SRC/keep/about.c ! head -n 16
run     builtin cd /dd
wait    1
run     clear
wait    1
run     bcheck SRC/keep/about.c | head -n 16
wait    8

shot    ccheck
cap     Checks C source for mismatched brackets, quotes and comment markers,
cap     and for indentation that disagrees with the nesting.
try     ccheck SRC/keep/keep.c
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ccheck SRC/keep/keep.c
wait    8

shot    ctags
cap     Builds the tags file vi uses to jump to a definition: one line per
cap     function, with the file and a search pattern to find it.
try     ctags keep.c
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; rm -f /dd/tmp/DEV/tags
run     cp /dd/SRC/keep/keep.c /dd/tmp/DEV/keep.c
run     builtin cd /dd/tmp/DEV
wait    2
run     clear
wait    1
run     ctags keep.c
wait    6
run     cat tags | head -n 8
wait    4

shot    etags
cap     Builds a tag table: by default `tags' in the form vi reads -- a
cap     name, its file and a search for its line -- or with -e the TAGS
cap     file emacs reads.  RBF names ignore case, so the two share a name
cap     here and differ only in what is inside.
try     etags keep.c
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; rm -f /dd/tmp/DEV/TAGS
run     cp /dd/SRC/keep/keep.c /dd/tmp/DEV/keep.c
run     builtin cd /dd/tmp/DEV
wait    2
run     clear
wait    1
run     etags keep.c
wait    8
run     head -4 tags
wait    4

shot    cxref
size    30 80
cap     A C cross-reference.  It prints the source with line numbers (shown
cap     here) and then a table of every symbol and the lines it appears on.
try     cxref SRC/keep/about.c | head -n 24
os9     cxref SRC/keep/about.c ! head -n 24
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cxref SRC/keep/about.c | head -n 24
wait    10

shot    rdoc
size    30 80
cap     Reverse documentation: given C source it prints the control structure
cap     as an indented skeleton -- every if, else, for, switch and case in
cap     place, the code between them taken away.  The tail of what it makes of
cap     keep.c.
try     rdoc SRC/keep/keep.c | tail -l=24
os9     rdoc SRC/keep/keep.c ! tail -l=24
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rdoc SRC/keep/keep.c | tail -l=24
wait    90

shot    xrf
size    24 80
cap     A C cross-reference generator.  It reads its language table, C.XRF,
cap     and the source from the current directory, then prints each name in
cap     the source with a count of its uses and the line numbers where it
cap     appears.
try     xrf small.c
run     rm -rf /dd/tmp/DEV/xrf > /nil 2>/nil; mkdir -p /dd/tmp/DEV/xrf; cp /dd/DOC/xrf/c.xrf /dd/tmp/DEV/xrf/C.XRF; printf "int count = 0;\rmain()\r{\r  int i;\r  for (i = 0; i < count; i++)\r    total(i);\r}\r" > /dd/tmp/DEV/xrf/small.c
run     builtin cd /dd/tmp/DEV/xrf
wait    2
run     clear
wait    1
run     xrf small.c
wait    10

shot    ref
cap     Looks a C function up in a tags file and prints the lines around where
cap     it is defined.  Here ctags indexes keep.c and ref shows the definition
cap     of crc_of, comment header and all.
try     ref crc_of
run     rm -rf /dd/tmp/DEV/ref > /nil 2>/nil; mkdir -p /dd/tmp/DEV/ref
run     cp /dd/SRC/keep/keep.c /dd/tmp/DEV/ref/keep.c
run     builtin cd /dd/tmp/DEV/ref
run     ctags keep.c 2>/nil
wait    3
run     clear
wait    1
run     ref crc_of
wait    6

shot    libsplit
cap     Splits a linker library of the newer ROF type into its object files.
cap     The libraries on this disk are the older type, and it says so:
cap     unpacklib is the one for those.
try     libsplit LIB/blarslib.l
run     builtin cd /dd
wait    1
run     clear
wait    1
run     libsplit LIB/blarslib.l
wait    6

shot    sdb
size    30 80
cap     SDB 2.0, "a Simple Database System" by David Betz -- a small
cap     relational database, not a debugger.  A relation is a file, a
cap     tuple a record, an attribute a field.  Here a relation is created
cap     with two fields, one record is typed into it (a blank line ends
cap     the entry), and `print * from people ;' reads it back.  DOC/sdb
cap     holds the manual and `help' lists the commands.
try     sdb
run     rm -rf /dd/tmp/SDBC > /nil 2>/nil; mkdir -p /dd/tmp/SDBC
wait    3
run     builtin cd /dd/tmp/SDBC
wait    1
run     clear
wait    1
run     sdb
wait    4
send    create people ( name char 12 town char 12 ) 20\r
wait    3
send    insert people\r
wait    3
send    Ada\r
wait    2
send    Bath\r
wait    2
send    \r
wait    3
send    print * from people ;\r
wait    4
snap
send    exit\r
wait    3

shot    trap
cap     An example trap handler.  Installing one needs system state, and from
cap     an ordinary program it says so and stops.  Run by path so the shell's
cap     own trap does not answer in its place.
try     CMDS/trap
run     builtin cd /dd
wait    1
run     clear
wait    1
run     CMDS/trap
wait    6

shot    tab
cap     Tabulates assembly source into label, opcode and argument columns, a
cap     filter: -b reads 6809 mnemonics, 68000 otherwise.
try     tab -b < tmp/DEV/t.a
os9     tab -b <tmp/DEV/t.a
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; printf " nam test\r start ldx #buf\rloop lda ,x+\r beq done\r bsr putc\r bra loop\rdone rts\rbuf fcc /hello/\r fcb 0\r end\r" > /dd/tmp/DEV/t.a
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/DEV/t.a
wait    3
run     tab -b < tmp/DEV/t.a
wait    6

shot    xlate
cap     Translates 6809 assembly source into 68000: registers mapped, branches
cap     sized, one instruction for one.
try     xlate tmp/DEV/t.a
run     mkdir -p /dd/tmp/DEV > /nil 2>/nil; printf " nam test\r start ldx #buf\rloop lda ,x+\r beq done\r bsr putc\r bra loop\rdone rts\rbuf fcc /hello/\r fcb 0\r end\r" > /dd/tmp/DEV/t.a
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/DEV/t.a
wait    3
run     xlate tmp/DEV/t.a
wait    6

shot    cdecl
size    18 80
cap     Reads a C declaration and says it in English, and takes the English
cap     and writes the declaration.  It prompts when run bare; fed a line it
cap     answers and stops, which is what is shown here.
try     echo "explain int *p" | cdecl
os9     echo "explain int *p" ! cdecl
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "explain int *p" | cdecl
wait    3
run     echo "explain char *(*fp)()" | cdecl
wait    3
run     echo "declare x as pointer to function returning int" | cdecl
wait    4

shot    scpp
size    24 80
cap     Only the macro named is expanded: WIDTH's #define is gone and its use
cap     is 80, while DEPTH's #define and its use are left as they were.
try     scpp -MWIDTH s.c
run     /dd/CMDS/rm -rf /dd/tmp/scppcard > /nil 2>/nil
run     /dd/CMDS/mkdir -p /dd/tmp/scppcard
run     builtin cd /dd/tmp/scppcard
run     echo "#define WIDTH 80" > s.c
run     echo "#define DEPTH 24" >> s.c
run     echo "int w = WIDTH, d = DEPTH;" >> s.c
wait    2
run     clear
wait    1
run     cat s.c
wait    2
run     scpp -MWIDTH s.c
wait    4

