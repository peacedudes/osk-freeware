# The programmer's shelf: cross-reference, beautifiers,
# benchmarks and version control.

shot    benchmarks
size    36 80
for     sieve fibo float savage
cap     Four benchmarks, each run: Eratosthenes' sieve, Fibonacci, a
cap     floating-point loop, and Savage's accuracy test, which is about
cap     arithmetic rather than speed.  Only two of them were typed on this
cap     card until 2026-08-29; the other two were credited to it and their
cap     "sample output" was somebody else's.
run     sieve
wait    10
run     fibo
wait    12
run     float
wait    12
run     savage
wait    15

shot    benchmarks2
size    36 80
for     paranoia timid time
cap     The three that stand apart from the speed benchmarks.  `paranoia'
cap     is Kahan's floating-point torture test and reports on the
cap     arithmetic rather than timing it; `timid' and `time' measure
cap     something else's running time rather than their own.  All three
cap     were credited to the benchmarks card and never run there.
run     time /dd/CMDS/today
wait    12
run     timid -?
wait    8
run     paranoia
wait    25

shot    cb
cap     cb, the C beautifier.  It reads standard input and writes standard
cap     output -- no filenames, which is what its usage line says.
run     cb < /dd/SRC/keep/about.c | head -n 18
wait    8

shot    ccheck
cap     ccheck reads C source and reports unbalanced brackets, quotes and
cap     comments -- a lint for the shape of a file rather than its meaning.
run     ccheck /dd/SRC/keep/keep.c
wait    6

shot    ctags
cap     ctags building the tags file vi and elvis use to jump to a
cap     definition, then the file it wrote.
run     ctags /dd/SRC/keep/keep.c
wait    5
run     head -n 12 tags
wait    4

shot    cxref
cap     cxref lists C source with line numbers and then every symbol in it,
cap     with the lines it appears on.
run     cxref /dd/SRC/keep/about.c | head -n 20
wait    8

shot    dhry
for     dhry dhryGcc2o2
cap     Dhrystone, built twelve ways -- Microware cc, GCC 1.x and 2.x,
cap     optimised and not -- which is what the DHRY directory is FOR.  It
cap     asks how many runs, and it has to be asked for a lot: at the
cap     default it finishes before the clock ticks and says the measured
cap     time is too small.  Two million runs apiece gives the comparison,
cap     and GCC 2 at -O2 is about 16% ahead of the Microware build.  The
cap     numbers are the emulator's speed, not a 68000's.  The other ten
cap     builds are on the `dhry-all' screen, which runs every one of them
cap     at the default count for the shape of the comparison; this one
cap     spends the time to get two of them measured properly.
run     echo 2000000 | dhry > /dd/tmp/d1.txt
wait    60
run     tail -l=2 /dd/tmp/d1.txt
wait    8
run     echo 2000000 | dhryGcc2o2 > /dd/tmp/d2.txt
wait    60
run     tail -l=2 /dd/tmp/d2.txt
wait    8

shot    dhry-all
size    36 80
for     dhry dhryO2 dhryGcc dhryGcc2 dhryGcc2o2 dhryGccin dhryGcc2in dhryGccmx dhryGcc2mx dhryGcco2 dhryshamu dhryshamu2
cap     Dhrystone built twelve ways -- Microware cc, GCC 1.x and 2.x,
cap     optimised, inlined and mixed -- and ALL TWELVE run here, one line
cap     each, on the same machine in the same session.  Comparison is the
cap     whole point of the directory and the card showed three of them
cap     until 2026-08-29.  `echo' names each build because the grep line
cap     that follows it does not.
run     echo cc; dhry | grep Dhrystones
wait    18
run     echo cc -O2; dhryO2 | grep Dhrystones
wait    18
run     echo gcc1; dhryGcc | grep Dhrystones
wait    18
run     echo gcc1 -O2; dhryGcco2 | grep Dhrystones
wait    18
run     echo gcc1 inline; dhryGccin | grep Dhrystones
wait    18
run     echo gcc1 mixed; dhryGccmx | grep Dhrystones
wait    18
run     echo gcc2; dhryGcc2 | grep Dhrystones
wait    18
run     echo gcc2 -O2; dhryGcc2o2 | grep Dhrystones
wait    18
run     echo gcc2 inline; dhryGcc2in | grep Dhrystones
wait    18
run     echo gcc2 mixed; dhryGcc2mx | grep Dhrystones
wait    18
run     echo shamu; dhryshamu | grep Dhrystones
wait    18
run     echo shamu2; dhryshamu2 | grep Dhrystones
wait    18

shot    disktest
for     disktest timid
cap     disktest measures the disk: how long a read and a write really take
cap     through RBF.
run     disktest -?
wait    8

shot    fibo
cap     The Fibonacci benchmark, and float beside it.
run     fibo
wait    8
run     float
wait    8

shot    ifdef
for     ifdef unifdef cpr
cap     unifdef and ifdef both resolve #ifdefs in C source, and neither
cap     takes the -D<symbol> form a Unix hand would reach for: their own
cap     syntax lines are what they answer with.
run     unifdef -?
wait    8
run     ifdef -?
wait    8
run     cpr < /nil
wait    8

shot    rcs
for     ci co rcs rlog rcsdiff rcsident rcsmerge
cap     RCS keeping a file: `ci' checks it in, asking for a description the
cap     way it always has, and `rlog' reads the history back.  The archive
cap     it writes is `note_v', not the `note,v' a Unix hand expects -- OS-9
cap     has no comma in a filename.  None of these take `-?'; RCS is older
cap     than that convention.
run     rm -rf /dd/tmp/rcs
wait    5
run     mkdir /dd/tmp/rcs
wait    5
run     cp /dd/SYS/motd /dd/tmp/rcs/note
wait    5
run     ci /dd/tmp/rcs/note
wait    6
send    the motd, checked in\r
wait    3
send    .\r
wait    8
run     ls -l /dd/tmp/rcs
wait    6
run     rlog /dd/tmp/rcs/note_v | head -n 8
wait    10
run     co /dd/tmp/rcs/note_v
wait    8
run     rcsdiff /dd/tmp/rcs/note_v
wait    8
run     rcsident /dd/tmp/rcs/note_v
wait    8
run     rcsmerge
wait    8

shot    sdb
for     sdb
cap     SDB 2.0, the symbolic debugger, opened on a program with no symbol
cap     file -- which is what it says.
run     sdb /dd/CMDS/today
wait    8
quit    q\r

shot    sieve
cap     The sieve of Eratosthenes benchmark, one of five here that measure
cap     the machine rather than do a job.
run     sieve
wait    10

shot    tab
for     tab xlate
cap     tab is a FILTER -- source in, tabulated source out -- and with no
cap     pipe it prints what it takes.  It knows the opcode column of both
cap     6809 and 68000 assembly; `xlate' beside it translates 6809 source
cap     into 68000.
run     tab -?
wait    8
run     xlate -?
wait    8

shot    time
cap     time, measuring a command the way OS-9 accounts for it.
run     time sieve
wait    12

shot    xrf
for     xrf ref etags ctags.elvis
cap     xrf wants its LANGUAGE TABLE, `C.XRF', in the current data directory
cap     -- the disk has it as DOC/xrf/c.xrf, and the data directory here is
cap     /dd, so it says so and stops.  Copy the table beside your source and
cap     it runs.  `etags' underneath is meant to build the TAGS file emacs
cap     wants, the way ctags builds `tags' for vi -- and it cannot: it
cap     floods `No more memory !!!' and gives up on any file it is given,
cap     the smallest included.  That is the F$SRqMem storm, the same one
cap     cvtbase and unstr hit.  `ctags' works; it has its own card.
run     xrf /dd/SRC/keep/about.c
wait    8
run     ls -l /dd/DOC/xrf
wait    8
run     etags /dd/SRC/keep/keep.c
wait    8
run     head -n 6 TAGS
wait    8
run     ref < /nil
wait    8

shot    indent
size    36 80
for     indent cb ccheck checkfile
cap     `indent' reformatting C source to a house style -- the head of what
cap     it made of the collection's own about.c -- and the three C checkers
cap     that travelled on this card without ever being run.  `cb' is the
cap     other beautifier, `ccheck' and `checkfile' look for mistakes.
run     indent /dd/SRC/keep/about.c -st | head -n 12
wait    15
run     cb < /dd/SRC/keep/about.c | head -n 6
wait    12
run     ccheck /dd/SRC/keep/about.c
wait    10
run     checkfile /dd/SRC/keep/about.c
wait    10

shot    patch
for     patch diff cdiff spiff
cap     `diff' works: it says exactly what changed.  `patch' then recognises
cap     the diff -- "Looks like a normal diff to me" -- and CANNOT FINISH:
cap     it writes a temporary file into /dd/tmp and then cannot read it
cap     back.  The file it was patching is left alone.  Measured 2026-08-28.
run     head -n 6 /dd/SYS/holidays > /dd/tmp/p1
wait    6
run     sed "s/Day/DAY/g" /dd/tmp/p1 > /dd/tmp/p2
wait    6
run     diff /dd/tmp/p1 /dd/tmp/p2 > /dd/tmp/p.diff
wait    8
run     cat /dd/tmp/p.diff
wait    6
run     patch /dd/tmp/p1 /dd/tmp/p.diff
wait    10

shot    tplot
for     tplot
cap     tplot -- hiplot inside -- plots columns of numbers from a file or
cap     from a pipe, prompting for the axes unless you give them.  A blank
cap     line lifts the pen, which is how you draw more than one curve.
run     tplot -?
wait    10

