# netpbm by pipeline.  Each stanza runs several programs for real and names
# them all, because that is what a pipeline is: the picture is evidence for
# every stage of it, not just the last.
shot    pnmcat
for     pnmcat pnminvert pnmscale
cap     pnmcat puts two images side by side -- the sphere beside its own
cap     negative, made by pnminvert.
run     pnmscale -xysize 74 88 /dd/DEMO/sphere.pgm > /dd/tmp/s.pgm
wait    10
run     pnminvert /dd/tmp/s.pgm > /dd/tmp/si.pgm
wait    6
run     pnmcat -lr /dd/tmp/s.pgm /dd/tmp/si.pgm | pgmtopbm | pbmtoascii -2x4
wait    12

shot    pgmhist
for     pgmhist pgmramp
cap     pgmramp makes a greyscale ramp and pgmhist counts what is in it --
cap     flat by construction, which is how you know both are right.
run     pgmramp -lr 64 16 > /dd/tmp/ramp.pgm
wait    6
run     pgmhist /dd/tmp/ramp.pgm | /dd/CMDS/head -n 18
wait    8

shot    pnmtops
for     pnmtops
cap     pnmtops writes PostScript around a bitmap -- how an image reached a
cap     printer in 1990.  The head of what it produced.
run     pnmtops /dd/tmp/ramp.pgm | /dd/CMDS/head -n 18
wait    10

shot    ppmhist
for     ppmhist ppmpat
cap     ppmpat weaves a pattern and ppmhist counts the colours in it, the
cap     commonest first.
run     ppmpat -tartan 80 40 > /dd/tmp/t.ppm
wait    8
run     ppmhist /dd/tmp/t.ppm | /dd/CMDS/head -n 18
wait    8

shot    pnmrotate
for     pnmrotate pnmcrop pnmflip
cap     pnmrotate turns the sphere thirty degrees and pnmcrop trims the
cap     margin the rotation left behind.
run     pnmscale -xysize 100 100 /dd/DEMO/sphere.pgm | pnmrotate 30 | pnmcrop | pnmscale -xysize 152 88 | pgmtopbm | pbmtoascii -2x4
wait    30

shot    pbmtext-big
for     pbmtext pbmpscale pbmreduce
cap     pbmtext sets a line of type, pbmpscale enlarges the bitmap without
cap     the staircase an ordinary scale would give.
run     pbmtext "netpbm" | pbmpscale 2 | pbmtoascii -2x4
wait    12

shot    pgmedge
for     pgmedge pgmenhance pgmnorm
cap     pgmedge keeps only where the brightness changes; on a photograph
cap     that leaves the outlines.
run     giftopnm /dd/DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 | pgmedge | pgmnorm | pgmtopbm | pbmtoascii -2x4
wait    35

shot    ppmdither
for     ppmdither ppmquant ppmtopgm
cap     ppmquant reduces the photograph to sixteen colours and ppmdither
cap     spreads the error -- the two halves of how a picture survived a
cap     screen that had no more colours than that.
run     giftopnm /dd/DEMO/gulls.gif | pnmscale -xysize 152 88 | ppmquant 16 | ppmtopgm | pgmtopbm | pbmtoascii -2x4
wait    40

shot    pnmarith
for     pnmarith pnmdepth
cap     pnmarith multiplies two images together -- the sphere by a ramp, so
cap     it fades across.
run     pgmramp -lr 152 88 > /dd/tmp/r2.pgm
wait    8
run     pnmscale -xysize 152 88 /dd/DEMO/sphere.pgm > /dd/tmp/s2.pgm
wait    10
run     pnmarith -multiply /dd/tmp/s2.pgm /dd/tmp/r2.pgm | pgmtopbm | pbmtoascii -2x4
wait    20

shot    pbmmake
for     pbmmake pbmupc pbmreduce
cap     pbmupc draws a real UPC-A barcode from its digits; pbmreduce halves
cap     it so the whole code fits a screen.
run     pbmupc 0 72890 00011 | pbmreduce 2 | pbmtoascii -2x4
wait    15

shot    pgmnoise
for     pgmnoise pnmsmooth pnmconvol
cap     pgmnoise makes white noise and pnmsmooth blurs it -- a convolution,
cap     and what comes out looks like cloud.
run     pgmnoise 152 88 | pnmsmooth | pgmtopbm | pbmtoascii -2x4
wait    20

shot    pnmfile-set
for     pnmfile pnmtile pnmpad
cap     pnmfile identifies each file a pipeline made: format, size, and
cap     whether it is raw or plain.  Six formats, all made on this disk.
run     pnmtile 60 30 /dd/tmp/s.pgm > /dd/tmp/tile.pgm
wait    10
run     pnmpad -white -left 10 /dd/tmp/tile.pgm > /dd/tmp/pad.pgm
wait    8
run     pnmfile /dd/tmp/ramp.pgm /dd/tmp/t.ppm /dd/tmp/tile.pgm /dd/tmp/pad.pgm /dd/tmp/s.pgm
wait    8
