# Text tools -- Transform & filter, Count & inspect, Split & join.
# One stanza per program, each on input it makes for itself under
# /dd/tmp/TEXTA.  Setup lines come before `clear'; the picture is what
# follows it.

shot    ascii
size    70 80
cap     The ASCII character table: every code from 0 to 127 with its control
cap     name, decimal, hex and octal, in two columns.
try     ascii
run     ascii
wait    6

shot    charcnt
size    26 80
cap     charcnt counts how often each character occurs in the files named,
cap     control characters included -- CR is the line ending here -- and
cap     totals the bytes read.
try     charcnt SYS/holidays SYS/motd
run     builtin cd /dd
wait    1
run     clear
wait    1
run     charcnt SYS/holidays SYS/motd
wait    6

shot    dump
cap     The head of an OS-9 program module: the sync bytes $4AFC that start
cap     every module, and at $000C the offset of the module's name, $48 --
cap     where `today' sits in clear.
try     dump CMDS/today | head -n 16
run     builtin cd /dd
wait    1
run     clear
wait    1
run     dump CMDS/today | head -n 16
wait    5

shot    file
cap     file names what a file is, from the magic table in SYS/magic: an
cap     OS-9 program module, a text file it can see is text but cannot
cap     place, a GIF with its size and colour count, a PGM image, and a
cap     tar archive made a moment before.
try     file CMDS/today DOC/INDEX DEMO/gulls.gif; file DEMO/sphere.pgm tmp/TEXTA/f.tar
run     mkdir -p /dd/tmp/TEXTA; tar cf /dd/tmp/TEXTA/f.tar /dd/SYS/motd
wait    6
run     builtin cd /dd
wait    1
run     clear
wait    1
run     file CMDS/today DOC/INDEX DEMO/gulls.gif
wait    6
run     file DEMO/sphere.pgm tmp/TEXTA/f.tar
wait    6
snap

shot    gdd
cap     gdd is GNU dd, the block copier.  `if=' names the input; `conv=ucase'
cap     converts to upper case on the way through; `bs=8 count=1' copies
cap     exactly eight bytes, which dump shows.  The two lines it prints are
cap     the records read and written.  Send its output through `>': `of='
cap     can only name a file that already exists.
try     cat tmp/TEXTA/fox.txt; gdd if=tmp/TEXTA/fox.txt conv=ucase > tmp/TEXTA/up.txt; cat tmp/TEXTA/up.txt; gdd if=tmp/TEXTA/fox.txt bs=8 count=1 > tmp/TEXTA/eight.txt; dump tmp/TEXTA/eight.txt
run     mkdir -p /dd/tmp/TEXTA; echo "the quick brown fox" > /dd/tmp/TEXTA/fox.txt; echo "jumps over the lazy dog" >> /dd/tmp/TEXTA/fox.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TEXTA/fox.txt
wait    3
run     gdd if=tmp/TEXTA/fox.txt conv=ucase > tmp/TEXTA/up.txt
wait    5
run     cat tmp/TEXTA/up.txt
wait    3
run     gdd if=tmp/TEXTA/fox.txt bs=8 count=1 > tmp/TEXTA/eight.txt
wait    5
run     dump tmp/TEXTA/eight.txt
wait    4
snap

shot    strings
cap     strings finds the runs of printable text inside a binary -- here the
cap     type names built into `file' -- and reports each
cap     with the offset it was found at.  `-l=n' sets the shortest run
cap     worth reporting, so a bigger number leaves out the accidental ones.
try     strings -l=12 CMDS/file | head -n 14
run     builtin cd /dd
wait    1
run     clear
wait    1
run     strings -l=12 CMDS/file | head -n 14
wait    6

shot    tail
cap     tail prints the last lines of a file: `-l=3' for the last three,
cap     twenty by default.  The whole file is above it for comparison.
try     cat tmp/TEXTA/hol.txt; tail -l=3 tmp/TEXTA/hol.txt
run     mkdir -p /dd/tmp/TEXTA; cat /dd/SYS/holidays | head -n 8 > /dd/tmp/TEXTA/hol.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TEXTA/hol.txt
wait    3
run     tail -l=3 tmp/TEXTA/hol.txt
wait    5
snap

shot    wc
cap     Lines, words and characters for four of the disk's own documents,
cap     and the total.
try     wc DOC/INDEX DOC/ORIGINS DOC/DEPENDS SOURCES.txt
run     builtin cd /dd
wait    1
run     clear
wait    1
run     wc DOC/INDEX DOC/ORIGINS DOC/DEPENDS SOURCES.txt
wait    6

shot    sepwords
cap     Two lines become nine words, put in order by `sort'.
try     cat tmp/TEXTA/fox.txt; sepwords < tmp/TEXTA/fox.txt | sort
run     mkdir -p /dd/tmp/TEXTA; echo "the quick brown fox" > /dd/tmp/TEXTA/fox.txt; echo "jumps over the lazy dog" >> /dd/tmp/TEXTA/fox.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TEXTA/fox.txt
wait    3
run     sepwords < tmp/TEXTA/fox.txt | sort
wait    5
snap

shot    ape
cap     ape writes gibberish in the style of whatever it reads -- here the
cap     first 12K of the Jargon File.  `-l' is how many characters must
cap     match before it follows the source text; `-b' is how much source to
cap     read.
try     ape -b=12k -l=5 < VH/jargon.txt | head -n 14
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ape -b=12k -l=5 < VH/jargon.txt | head -n 14
wait    12

shot    autolf
size    30 80
cap     autolf converts line endings.  `-c' says the input ends lines with
cap     CR; `-C -L' asks for CR LF on output -- DOS text from OS-9 text --
cap     and dump shows the 0D at the end of each line becoming 0D 0A.  It
cap     reads standard input and writes standard output; `-l' in and `-C'
cap     out goes the other way.
try     autolf -c -C -L < tmp/TEXTA/fox.txt > tmp/TEXTA/dos.txt; dump tmp/TEXTA/fox.txt; dump tmp/TEXTA/dos.txt
run     mkdir -p /dd/tmp/TEXTA; echo "the quick brown fox" > /dd/tmp/TEXTA/fox.txt; echo "jumps over the lazy dog" >> /dd/tmp/TEXTA/fox.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     autolf -c -C -L < tmp/TEXTA/fox.txt > tmp/TEXTA/dos.txt
wait    4
run     dump tmp/TEXTA/fox.txt
wait    4
run     dump tmp/TEXTA/dos.txt
wait    4
snap

shot    casefix
cap     A line of mixed-up capitals comes out sentence-cased.
try     echo "tHE qUICK bROWN fOX. jUMPS oVER the LAZY dog." | casefix
run     echo "tHE qUICK bROWN fOX. jUMPS oVER the LAZY dog." | casefix
wait    5

shot    cut
size    30 80
cap     cut picks columns out of each line of the password file: `-d, -f3'
cap     the third comma-separated field, the group and user number; `-f1-3'
cap     the first three; `-c1-4' the first four characters.
try     cat password; cut -d, -f3 password; cut -d, -f1-3 password; cut -c1-4 password
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     cat password
wait    3
run     cut -d, -f3 password
wait    4
run     cut -d, -f1-3 password
wait    4
run     cut -c1-4 password
wait    4

shot    cuts
cap     cuts, the Coco Usenet Transfer Utility, given a two-line text file
cap     in its form: an identifier line naming the file, the data, and the
cap     identifier again. `-d' reads the identifier and writes fox.txt,
cap     and dump shows the two lines back.
try     cat fox.cut; cuts -d fox.cut; dump fox.txt
run     set +H; rm -rf /dd/tmp/CUTS > /nil 2>/nil; mkdir -p /dd/tmp/CUTS; builtin cd /dd/tmp/CUTS
wait    2
run     printf '.0000.I.A.260926.ASC."fox.txt"................................................=\r.0001.Dthe quick brown fox!=jumps over the lazy dog!=#........................9\r.0000.I.A.260926.ASC."fox.txt"................................................=\r' > fox.cut
wait    3
run     clear
wait    1
run     cat fox.cut; cuts -d fox.cut; dump fox.txt
wait    8

shot    detab
size    30 80
cap     detab replaces tabs with spaces.  The line of the holidays file with
cap     09 09 between the date and the name comes out with a run of 20s;
cap     `-t4' puts the tab stops every four columns instead of three.
try     dump tmp/TEXTA/tab.txt; detab tmp/TEXTA/tab.txt > tmp/TEXTA/notab.txt; dump tmp/TEXTA/notab.txt; detab -t4 tmp/TEXTA/tab.txt > tmp/TEXTA/tab4.txt; dump tmp/TEXTA/tab4.txt
run     mkdir -p /dd/tmp/TEXTA; cat /dd/SYS/holidays | head -n 3 | tail -l=1 > /dd/tmp/TEXTA/tab.txt
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     dump tmp/TEXTA/tab.txt
wait    4
run     detab tmp/TEXTA/tab.txt > tmp/TEXTA/notab.txt
wait    4
run     dump tmp/TEXTA/notab.txt
wait    4
run     detab -t4 tmp/TEXTA/tab.txt > tmp/TEXTA/tab4.txt
wait    4
run     dump tmp/TEXTA/tab4.txt
wait    4
snap

shot    eo
cap     eo runs one command for every line of a file, with `@' standing for
cap     the line: here `wc' over the three files named in list.txt, each
cap     command echoed before its output. sh forks only resident modules, so
cap     sh and wc are loaded first.
try     load sh; load wc; SHELL=sh eo list.txt wc @
run     mkdir -p /dd/tmp/TEXTA; echo /dd/SYS/motd > /dd/tmp/TEXTA/list.txt; echo /dd/SYS/holidays >> /dd/tmp/TEXTA/list.txt; echo /dd/SYS/birthdays >> /dd/tmp/TEXTA/list.txt
wait    3
run     builtin cd /dd/tmp/TEXTA
wait    1
run     clear
wait    1
run     cat list.txt
wait    3
run     load sh; load wc; SHELL=sh eo list.txt wc @
wait    10
snap
run     builtin cd /dd
wait    1

shot    field
cap     field prints the words you pick from each line by their position:
cap     the 2nd, 4th and 1st here, then fields 1 and 3 of pw, a copy of
cap     SYS/password, whose fields are separated by commas.
try     cat fox; field 2 4 1 < fox; field -i=, 1 3 < pw
run     rm -rf /dd/tmp/fld > /nil 2>/nil; mkdir -p /dd/tmp/fld; echo "the quick brown fox" > /dd/tmp/fld/fox; echo "jumps over the lazy dog" >> /dd/tmp/fld/fox; cp /dd/SYS/password /dd/tmp/fld/pw
wait    3
run     builtin cd /dd/tmp/fld
wait    1
run     clear
wait    1
run     cat fox
wait    2
run     field 2 4 1 < fox
wait    3
run     field -i=, 1 3 < pw
wait    3

shot    fillup
size    30 80
cap     `-n=64' the length, `-i=46' the byte, a full stop: 20 of them take
cap     the file from 44 bytes to 64, and dump shows the 2E bytes after the
cap     text.
try     ls -l tmp/TEXTA/pad.txt; fillup -n=64 -i=46 tmp/TEXTA/pad.txt; ls -l tmp/TEXTA/pad.txt; dump tmp/TEXTA/pad.txt
run     mkdir -p /dd/tmp/TEXTA; echo "the quick brown fox" > /dd/tmp/TEXTA/pad.txt; echo "jumps over the lazy dog" >> /dd/tmp/TEXTA/pad.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ls -l tmp/TEXTA/pad.txt
wait    3
run     fillup -n=64 -i=46 tmp/TEXTA/pad.txt
wait    4
run     ls -l tmp/TEXTA/pad.txt
wait    3
run     dump tmp/TEXTA/pad.txt
wait    4
snap

shot    gep
cap     gep searches a file for every expression listed in a second file,
cap     named with `-e': two patterns over the holidays file.  It is grep
cap     for a whole list of patterns at once.
try     cat tmp/TEXTA/pats; gep -e=tmp/TEXTA/pats SYS/holidays
run     mkdir -p /dd/tmp/TEXTA; echo Easter > /dd/tmp/TEXTA/pats; echo Valentine >> /dd/tmp/TEXTA/pats
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TEXTA/pats
wait    3
run     gep -e=tmp/TEXTA/pats SYS/holidays
wait    6
snap

shot    paste
cap     paste joins files line by line, side by side: the first line of
cap     each, then the second.  The separator is a tab; `-d:' makes it a
cap     colon, and `-s' lays one file's lines out along a single line.
try     paste tmp/TEXTA/a.txt tmp/TEXTA/b.txt; paste -d: tmp/TEXTA/a.txt tmp/TEXTA/b.txt; paste -s tmp/TEXTA/a.txt
run     mkdir -p /dd/tmp/TEXTA; echo one > /dd/tmp/TEXTA/a.txt; echo two >> /dd/tmp/TEXTA/a.txt; echo three >> /dd/tmp/TEXTA/a.txt
wait    3
run     echo eins > /dd/tmp/TEXTA/b.txt; echo zwei >> /dd/tmp/TEXTA/b.txt; echo drei >> /dd/tmp/TEXTA/b.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     paste tmp/TEXTA/a.txt tmp/TEXTA/b.txt
wait    5
run     paste -d: tmp/TEXTA/a.txt tmp/TEXTA/b.txt
wait    5
run     paste -s tmp/TEXTA/a.txt
wait    5
snap

shot    pep
size    30 80
cap     pep is a file detergent.  `-b' strips control characters and anything
cap     outside ASCII; `-u13' keeps CR as the line ending.  dump shows the
cap     file before and after: the bell (07) has come out as a line end, and
cap     the backspace (08) took the letter before it away with it.  It lists
cap     the transformations it applied as it goes.
try     dump tmp/TEXTA/ctl.txt; pep -b -u13 tmp/TEXTA/ctl.txt > tmp/TEXTA/clean.txt; dump tmp/TEXTA/clean.txt
run     mkdir -p /dd/tmp/TEXTA; echo -e "bell\aand\bbackspace here" > /dd/tmp/TEXTA/ctl.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     dump tmp/TEXTA/ctl.txt
wait    4
run     pep -b -u13 tmp/TEXTA/ctl.txt > tmp/TEXTA/clean.txt
wait    5
run     dump tmp/TEXTA/clean.txt
wait    5
snap

shot    psc
cap     One `let' per cell, A0 at top left, then a `format' line per column.
cap     It reads standard input.
try     cat tmp/TEXTA/table.txt; psc < tmp/TEXTA/table.txt
run     mkdir -p /dd/tmp/TEXTA; echo "1 2 3" > /dd/tmp/TEXTA/table.txt; echo "4 5 6" >> /dd/tmp/TEXTA/table.txt; echo "7 8 9" >> /dd/tmp/TEXTA/table.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TEXTA/table.txt
wait    3
run     psc < tmp/TEXTA/table.txt
wait    6
snap

shot    rot
size    30 80
cap     Turned on its side a quarter-turn clockwise: the last line becomes
cap     the first column, read downwards, and the first line the last. It
cap     refuses tabs, so expand them first.
try     cat tmp/TEXTA/r.txt; rot tmp/TEXTA/r.txt
run     mkdir -p /dd/tmp/TEXTA; echo "the quick brown fox" > /dd/tmp/TEXTA/r.txt; echo "jumps over the" >> /dd/tmp/TEXTA/r.txt; echo "lazy dog" >> /dd/tmp/TEXTA/r.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TEXTA/r.txt
wait    3
run     rot tmp/TEXTA/r.txt
wait    6
snap

shot    tabs
size    30 80
cap     dump shows one line of the holidays file three ways: with its tabs,
cap     with spaces instead (-o0), and with tabs every 4 (-o4).
try     dump tmp/TEXTA/tab.txt; tabs -i8 -o0 < tmp/TEXTA/tab.txt > tmp/TEXTA/sp.txt; dump tmp/TEXTA/sp.txt; tabs -i8 -o4 < tmp/TEXTA/tab.txt > tmp/TEXTA/t4.txt; dump tmp/TEXTA/t4.txt
run     mkdir -p /dd/tmp/TEXTA; cat /dd/SYS/holidays | head -n 3 | tail -l=1 > /dd/tmp/TEXTA/tab.txt
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     dump tmp/TEXTA/tab.txt
wait    4
run     tabs -i8 -o0 < tmp/TEXTA/tab.txt > tmp/TEXTA/sp.txt
wait    4
run     dump tmp/TEXTA/sp.txt
wait    4
run     tabs -i8 -o4 < tmp/TEXTA/tab.txt > tmp/TEXTA/t4.txt
wait    4
run     dump tmp/TEXTA/t4.txt
wait    4
snap

shot    upperdir
cap     upperdir normalises the names in a directory: files to lower case,
cap     directories to upper.  It prints the names as it renames them.  A
cap     scratch directory holding MixedCase.TXT and subdir is listed before
cap     and after.
try     ls tmp/TEXTA/UD; upperdir tmp/TEXTA/UD; ls tmp/TEXTA/UD
run     mkdir -p /dd/tmp/TEXTA; rm -r /dd/tmp/TEXTA/UD
wait    3
run     mkdir -p /dd/tmp/TEXTA/UD/subdir; cp /dd/SYS/motd /dd/tmp/TEXTA/UD/MixedCase.TXT
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ls tmp/TEXTA/UD
wait    3
run     upperdir tmp/TEXTA/UD
wait    5
run     ls tmp/TEXTA/UD
wait    3
snap

shot    valspeak
cap     valspeak rewrites plain English the way a Californian valley girl of
cap     the 1980s would say it.  It is a filter: standard input in, the
cap     rewritten text out.  The file it was given is above the result.
try     cat tmp/TEXTA/val.txt; valspeak < tmp/TEXTA/val.txt
run     mkdir -p /dd/tmp/TEXTA; echo "This is the best day ever and we are all going to the beach." > /dd/tmp/TEXTA/val.txt
wait    3
run     echo "The sun is out and the ice cream is free." >> /dd/tmp/TEXTA/val.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TEXTA/val.txt
wait    3
run     valspeak < tmp/TEXTA/val.txt
wait    6
snap

shot    gawk
size    24 80
cap     GNU awk 2.11, the pattern-and-action language: the password file
cap     reformatted with `-F,' and printf to pick two fields, then the
cap     holidays file counted in an END block -- NR is the line number, so
cap     at the end it is the count of lines, and w has been adding up NF,
cap     the number of fields on each line.
try     cat password; gawk -F, "{printf \"%-8s %s\n\", \$1, \$6}" password; gawk "{w+=NF} END {print NR, w}" holidays
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     cat password
wait    4
run     gawk -F, "{printf \"%-8s %s\n\", \$1, \$6}" password
wait    12
run     gawk "{w+=NF} END {print NR, w}" holidays
wait    12
snap

shot    expand
size    30 80
cap     expand replaces tabs with spaces, at stops eight columns apart by
cap     default and `-t 4' every four.  dump shows the two tabs (09 09) of a
cap     line of the holidays file become spaces (20).
try     dump tmp/TEXTA/tab.txt; expand tmp/TEXTA/tab.txt > tmp/TEXTA/sp.txt; dump tmp/TEXTA/sp.txt; expand -t 4 tmp/TEXTA/tab.txt > tmp/TEXTA/sp4.txt; dump tmp/TEXTA/sp4.txt
run     mkdir -p /dd/tmp/TEXTA; cat /dd/SYS/holidays | head -n 3 | tail -l=1 > /dd/tmp/TEXTA/tab.txt
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     dump tmp/TEXTA/tab.txt
wait    4
run     expand tmp/TEXTA/tab.txt > tmp/TEXTA/sp.txt
wait    4
run     dump tmp/TEXTA/sp.txt
wait    4
run     expand -t 4 tmp/TEXTA/tab.txt > tmp/TEXTA/sp4.txt
wait    4
run     dump tmp/TEXTA/sp4.txt
wait    4
snap

shot    head
cap     head prints the first lines of a file, `-n 3' for three, the same
cap     whether the file is named or comes through a pipe.
try     cat tmp/TEXTA/hol.txt; head -n 3 tmp/TEXTA/hol.txt; cat tmp/TEXTA/hol.txt | head -n 3
run     mkdir -p /dd/tmp/TEXTA; cat /dd/SYS/holidays | head -n 8 > /dd/tmp/TEXTA/hol.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TEXTA/hol.txt
wait    3
run     head -n 3 tmp/TEXTA/hol.txt
wait    4
run     cat tmp/TEXTA/hol.txt | head -n 3
wait    4
snap

shot    slice
cap     In a directory holding a copy of DOC/README-SHELLS: each line in
cap     capitals starts a new file, named by the format -- part1, part2 and
cap     on. The lines before the first heading go to /nil unless -r names a
cap     file for them.
try     slice -f README-SHELLS '^[A-Z][A-Z ,-]*$' part#n
run     rm -rf /dd/tmp/SLK > /nil 2>/nil; mkdir -p /dd/tmp/SLK
run     cp /dd/DOC/README-SHELLS /dd/tmp/SLK
wait    2
run     builtin cd /dd/tmp/SLK
wait    1
run     clear
wait    1
run     slice -f README-SHELLS '^[A-Z][A-Z ,-]*$' part#n
wait    4
run     ls -l
wait    2
run     cat part2
wait    2

shot    split
cap     split cuts a file into pieces of a given size -- `-l 10' ten lines
cap     each -- named partaa, partab and so on after the prefix given.  The
cap     holidays file makes four; the last is printed.
try     split -l 10 SYS/holidays tmp/TEXTA/SP/part; ls -l tmp/TEXTA/SP; cat tmp/TEXTA/SP/partad
run     mkdir -p /dd/tmp/TEXTA/SP; rm -f /dd/tmp/TEXTA/SP/*
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     split -l 10 SYS/holidays tmp/TEXTA/SP/part
wait    5
run     ls -l tmp/TEXTA/SP
wait    4
run     cat tmp/TEXTA/SP/partad
wait    4
snap

shot    sum
cap     sum prints a checksum and a block count for each file named -- the
cap     checksum every Unix had before md5.
try     sum SYS/motd SYS/holidays SYS/birthdays DOC/INDEX
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sum SYS/motd SYS/holidays SYS/birthdays DOC/INDEX
wait    6

shot    tac
cap     tac prints a file last line first -- cat backwards -- a named file
cap     or what comes through a pipe.
try     cat tmp/TEXTA/hol.txt; tac tmp/TEXTA/hol.txt
run     mkdir -p /dd/tmp/TEXTA; cat /dd/SYS/holidays | head -n 8 > /dd/tmp/TEXTA/hol.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TEXTA/hol.txt
wait    3
run     tac tmp/TEXTA/hol.txt
wait    5
snap

shot    unexpand
size    30 80
cap     unexpand turns runs of spaces back into tabs; `-a' does it anywhere
cap     in the line, not only at the start.  A line of the holidays file has
cap     its tabs expanded to spaces first, and comes back with 09 09
cap     restored.
try     dump tmp/TEXTA/sp.txt; unexpand -a tmp/TEXTA/sp.txt > tmp/TEXTA/back.txt; dump tmp/TEXTA/back.txt
run     mkdir -p /dd/tmp/TEXTA; cat /dd/SYS/holidays | head -n 3 | tail -l=1 > /dd/tmp/TEXTA/tab.txt
wait    4
run     expand /dd/tmp/TEXTA/tab.txt > /dd/tmp/TEXTA/sp.txt
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     dump tmp/TEXTA/sp.txt
wait    4
run     unexpand -a tmp/TEXTA/sp.txt > tmp/TEXTA/back.txt
wait    4
run     dump tmp/TEXTA/back.txt
wait    4
snap

shot    more
size    24 80
cap     The first page of DOC/INDEX: 24 lines, and Enter for the next. The
cap     page length is built in, and it reads Enter from standard input, so
cap     it pages a file rather than a pipe.
try     more DOC/INDEX
run     builtin cd /dd
wait    1
run     clear
wait    1
run     more DOC/INDEX
wait    5
snap
send    q\r
wait    3

shot    diff3
size    24 80
cap     Three files -- yours, the one you both started from, and theirs:
cap     `====' opens a difference, and `1:', `2:' and `3:' are the files.
cap     The first changed the middle line and the third changed the last.
try     diff3 mine older theirs
run     rm -rf /dd/tmp/D3C > /nil 2>/nil; mkdir -p /dd/tmp/D3C
wait    3
run     cat >/dd/tmp/D3C/older
text    one
text    two
text    three
eof
wait    2
run     cat >/dd/tmp/D3C/mine
text    one
text    TWO
text    three
eof
wait    2
run     cat >/dd/tmp/D3C/theirs
text    one
text    two
text    THREE
eof
wait    2
wait    3
run     builtin cd /dd/tmp/D3C
wait    1
run     clear
wait    1
run     diff3 mine older theirs
wait    5

shot    subber
size    24 80
try     shell subber #1000k words in
os9     subber #1000k words in
cap     Substitutes word for word through a file: the list `,fox,cat' and
cap     `,here,there' rewrites the two lines under it.  It grows its memory
cap     as it reads and that growth is refused here, so it wants to be
cap     started with the memory already in hand -- the `#1000k' your own
cap     OS-9's shell understands.  From bash, hand the line to that shell,
cap     loaded from /h1 as SYS/login does; at the shell itself, the second
cap     line above.
run     load /h1/CMDS/shell
wait    3
run     rm -rf /dd/tmp/SUBB > /nil 2>/nil; mkdir -p /dd/tmp/SUBB; printf ',fox,cat\r,here,there\r' > /dd/tmp/SUBB/words; printf 'here is a fox\rthe fox went here\r' > /dd/tmp/SUBB/in
wait    3
run     builtin cd /dd/tmp/SUBB
wait    1
run     clear
wait    1
run     cat words
wait    3
run     cat in
wait    3
run     shell subber #1000k words in
wait    6

shot    tcmp
cap     Two three-line files that differ in the middle line.
try     cat tmp/TEXTA/c1.txt; cat tmp/TEXTA/c2.txt; tcmp tmp/TEXTA/c1.txt tmp/TEXTA/c2.txt
run     mkdir -p /dd/tmp/TEXTA; echo "the quick brown fox" > /dd/tmp/TEXTA/c1.txt; echo "jumps over the lazy dog" >> /dd/tmp/TEXTA/c1.txt; echo "and lands in the river" >> /dd/tmp/TEXTA/c1.txt
wait    3
run     echo "the quick brown fox" > /dd/tmp/TEXTA/c2.txt; echo "leaps over the lazy dog" >> /dd/tmp/TEXTA/c2.txt; echo "and lands in the river" >> /dd/tmp/TEXTA/c2.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TEXTA/c1.txt
wait    3
run     cat tmp/TEXTA/c2.txt
wait    3
run     tcmp tmp/TEXTA/c1.txt tmp/TEXTA/c2.txt
wait    6
snap

shot    unp
size    30 80
cap     unp strips unprintable characters from a stream and reports each one
cap     it removed, by code and line number.  dump shows the bell (07) and
cap     backspace (08) before, and the clean text after.
try     dump tmp/TEXTA/ctl.txt; unp < tmp/TEXTA/ctl.txt > tmp/TEXTA/clean.txt; dump tmp/TEXTA/clean.txt
run     mkdir -p /dd/tmp/TEXTA; echo -e "bell\aand\bbackspace here" > /dd/tmp/TEXTA/ctl.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     dump tmp/TEXTA/ctl.txt
wait    4
run     unp < tmp/TEXTA/ctl.txt > tmp/TEXTA/clean.txt
wait    4
run     dump tmp/TEXTA/clean.txt
wait    4
snap

shot    fold
size    24 80
cap     Wrapped to 24 columns: it cuts at exactly the width, mid-word.
try     fold -w 24 tmp/B3C/fox.txt
run     rm -rf /dd/tmp/B3C; mkdir -p /dd/tmp/B3C; echo "The quick brown fox jumps over the lazy dog, and then over the lazy dog again." > /dd/tmp/B3C/fox.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     fold -w 24 tmp/B3C/fox.txt
wait    5

shot    comm
size    24 80
cap     comm compares two sorted files.  The first column is what only the
cap     first file has, the second what only the second has, the third what
cap     both share.
try     comm tmp/B3C/a tmp/B3C/b
run     rm -rf /dd/tmp/B3C; mkdir -p /dd/tmp/B3C; echo apple > /dd/tmp/B3C/a; echo banana >> /dd/tmp/B3C/a; echo cherry >> /dd/tmp/B3C/a; echo banana > /dd/tmp/B3C/b; echo cherry >> /dd/tmp/B3C/b; echo damson >> /dd/tmp/B3C/b
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     comm tmp/B3C/a tmp/B3C/b
wait    5

shot    column
size    32 80
cap     column sets a list out in columns as wide as the screen -- here the
cap     names in the games directory.
try     ls CMDS/GAMES | column
os9     ls CMDS/GAMES ! column
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ls CMDS/GAMES | column
wait    5

shot    colrm
size    24 80
cap     colrm removes columns from each line.  Given two numbers it cuts from
cap     the first to the second -- the third to the fifth character here --
cap     and given one it cuts from there to the end of the line.
try     echo abcdefghij | colrm 3 5
os9     echo abcdefghij ! colrm 3 5
run     rm -rf /dd/tmp/B3M; mkdir -p /dd/tmp/B3M; echo "001 apple" > /dd/tmp/B3M/list.txt; echo "002 banana" >> /dd/tmp/B3M/list.txt; echo "003 cherry" >> /dd/tmp/B3M/list.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo abcdefghij
wait    3
run     echo abcdefghij | colrm 3 5
wait    4
run     echo abcdefghij | colrm 5
wait    4
run     cat tmp/B3M/list.txt
wait    3
run     colrm 1 4 < tmp/B3M/list.txt
wait    4

shot    col
size    24 80
cap     col cleans up text meant for a printer. The file above underlines
cap     `important' the way nroff does, an underscore struck and then each
cap     letter over it; col -b keeps the last character struck in each
cap     column, so the word comes out plain.
try     col -b < tmp/B3C/over.txt
run     rm -rf /dd/tmp/B3C; mkdir -p /dd/tmp/B3C; echo -e "an _\bi_\bm_\bp_\bo_\br_\bt_\ba_\bn_\bt word" > /dd/tmp/B3C/over.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     dump tmp/B3C/over.txt
wait    5
run     col -b < tmp/B3C/over.txt
wait    5

shot    ul
size    24 80
cap     ul reads underlining made with backspaces -- an underscore struck,
cap     then the letter over it -- and shows it the way the terminal can.
cap     With -i the underline is drawn on a line of its own, under
cap     `important'.
try     ul -i tmp/B3C/over.txt
run     rm -rf /dd/tmp/B3C; mkdir -p /dd/tmp/B3C; echo -e "an _\bi_\bm_\bp_\bo_\br_\bt_\ba_\bn_\bt word" > /dd/tmp/B3C/over.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ul -i tmp/B3C/over.txt
wait    5

shot    tsort
size    24 80
cap     tsort takes pairs -- the first must come before the second -- and
cap     prints one order that keeps every pair: underwear before trousers,
cap     trousers and socks before shoes.
try     echo "underwear trousers trousers shoes socks shoes" | tsort
os9     echo "underwear trousers trousers shoes socks shoes" ! tsort
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "underwear trousers trousers shoes socks shoes" | tsort
wait    5

shot    rev
size    24 80
cap     rev reverses the characters of each line: stressed comes back as
cap     desserts.
try     echo "stressed" | rev
os9     echo "stressed" ! rev
run     rm -rf /dd/tmp/B3R; mkdir -p /dd/tmp/B3R; echo "stressed" > /dd/tmp/B3R/w.txt; echo "drawer" >> /dd/tmp/B3R/w.txt; echo "regal" >> /dd/tmp/B3R/w.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "stressed" | rev
wait    4
run     cat tmp/B3R/w.txt
wait    3
run     rev tmp/B3R/w.txt
wait    4

shot    look
size    30 80
cap     look prints the lines of a sorted file that begin with a string -- here
cap     the words in GAMES/words that start with abs.  -f ignores case.
try     look abs GAMES/words
run     builtin cd /dd
wait    1
run     clear
wait    1
run     look abs GAMES/words
wait    5

shot    yes
size    24 80
cap     yes prints y, or what it is given, over and over, to answer a
cap     program that keeps asking.  head takes three lines and yes stops.
try     yes hello | head -n 3
os9     yes hello ! head -n 3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     yes hello | head -n 3
wait    5

shot    xd
size    20 80
cap     A hex dump that numbers its addresses in hex.  -c sets the
cap     characters alongside the bytes, a period standing for each one that
cap     will not print.  -d writes the same bytes as a C array instead, and
cap     -l reads a dump back to rebuild the file it came from.
try     xd -c motd; xd -d motd
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     xd -c motd
wait    3
run     xd -d motd
wait    4

shot    hdump
size    42 80
cap     The same 40-byte file in hexadecimal and in binary, with the
cap     characters beside the bytes and a period standing for each one that
cap     will not print. -o is octal and -d decimal; run bare it dumps in
cap     octal.
try     hdump -h motd; hdump -b motd
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     hdump -h motd
wait    3
run     hdump -b motd
wait    4

shot    undump
size    18 80
cap     Rebuilds a binary file from a hex dump that hdump wrote.  Dump a
cap     file, edit the hex with any text editor, undump it back -- which is
cap     how you patch a binary on a disk with no binary editor.  The byte
cap     counts are the proof: 345 bytes of hex, 40 bytes back.
try     hdump -h motd > m.hex; undump back < m.hex; cat back; wc -c m.hex back
run     rm -rf /dd/tmp/UND > /nil 2>/nil; mkdir -p /dd/tmp/UND
run     cp /dd/SYS/motd /dd/tmp/UND/motd
run     builtin cd /dd/tmp/UND
wait    2
run     clear
wait    1
run     hdump -h motd > m.hex
wait    2
run     undump back < m.hex
wait    3
run     cat back
wait    3
run     wc -c m.hex back
wait    3

shot    dvi2tty
size    24 80
cap     Prints a TeX .DVI file as text, so a typeset document can be read on
cap     a terminal.  The disk's other DVI programs drive printers; this one
cap     is for the screen.  Here it reads the MG manual that ships in DOC.
cap     -q keeps it from paging: left alone it pipes to a pager when its
cap     output is a terminal.
try     dvi2tty -q -w79 mg_doc.dvi | head -n 20
os9     dvi2tty -q -w79 mg_doc.dvi ! head -n 20
run     builtin cd /dd/DOC/mg
wait    1
run     clear
wait    1
run     dvi2tty -q -w79 mg_doc.dvi | head -n 20
wait    8

shot    disdvi
size    24 80
cap     Dumps a .DVI file's structure instead of its text: the preamble --
cap     version, the numerator and denominator that set its units, the
cap     magnification, the job name -- and then every command in the file,
cap     one to a line.
try     disdvi mg_doc.dvi | head -n 20
os9     disdvi mg_doc.dvi ! head -n 20
run     builtin cd /dd/DOC/mg
wait    1
run     clear
wait    1
run     disdvi mg_doc.dvi | head -n 20
wait    8
