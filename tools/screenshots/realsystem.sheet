# Programs for a real OS-9 system that this emulator cannot exercise:
# drivers and file managers, the MM/1 and X68000, multi-user and modem
# lines, OS-9/Net.  Each card shows what can be shown here -- a module's
# header, a usage line, the refusal -- and says plainly it is untested.

shot    ptyman
for     ptyman ptydrv pty
cap     PtyMan is a file manager: pairs of pseudo-terminals, /pty/<name>
cap     for the program that plays the terminal and /tty/<name> for the
cap     one that thinks it has one.  We cannot test it -- the emulator
cap     loads no file managers -- so each module's header is what there is
cap     to show: the file manager, its driver, and its two descriptors.
try     modinfo ptyman ptydrv pty tty
run     builtin cd /dd/CMDS/DRIVERS
wait    1
run     clear
wait    1
run     modinfo ptyman ptydrv pty tty
wait    4

shot    lfcrman
for     lfcrman h0t thlpct
cap     A file manager that shows another device with LF and CR swapped,
cap     for text shared with Unix over NFS; h0t and thlpct are its example
cap     descriptors.  Untested here: the emulator loads no file managers.
try     modinfo lfcrman h0t thlpct
run     builtin cd /dd/CMDS/DRIVERS
wait    1
run     clear
wait    1
run     modinfo lfcrman h0t thlpct
wait    4

shot    disp
for     disp di
cap     The C device driver from OS-9 International 1/93, with its
cap     descriptor di: a worked example of writing a driver in C, four
cap     bits to a display port.  Untested: it wants the port.
try     modinfo disp di
run     builtin cd /dd/CMDS/DRIVERS
wait    1
run     clear
wait    1
run     modinfo disp di
wait    4

shot    cpucache
for     cpucache cctrap
cap     cpucache shows and switches a 68020, 68030 or 68040's on-chip
cap     caches, through its trap handler cctrap, which ships in
cap     CMDS/DRIVERS.  The emulator has no caches to switch -- with cctrap
cap     loaded it stops at a privilege violation -- so its usage is what
cap     is shown here.
try     cpucache -?
run     clear
run     cpucache -?
wait    3

shot    vt100
cap     A terminal program for the MM/1: VT-100 and VT-52 emulation in a
cap     K-Windows window, talking on the serial line it is given.  Given
cap     the console as that line it opens it and shows its title screen,
cap     then waits for a key; past that it wants the MM/1's K-Windows.
try     vt100 /term
run     clear
run     vt100 /term
wait    5
snap

shot    x9eyes
for     x9eyes setbgptn
cap     Two programs for the Sharp X68000's personal window: x9eyes, eyes
cap     that follow the pointer, and setbgptn, the window system's
cap     background pattern.  Without the X68000's /win each stops before
cap     drawing anything, and says why.
try     x9eyes
run     clear
run     x9eyes
wait    3
run     setbgptn SYS/motd
wait    3

shot    logon
for     logon timeout
cap     logon logs a user into a multi-user OS-9: it checks the name
cap     against SYS/password, sets the user's ids, directories and
cap     environment, and chains to the program that line names -- here
cap     your own OS-9's shell, which must be resident, in tester's home
cap     directory.  Its manual is DOC/SYSADMIN/logon.prf.  timeout is its
cap     idle timer, and started by hand it ends the shell that started it:
cap     Microware's shell never reaches the `echo after'.
try     logon tester
run     load /h1/CMDS/shell
wait    1
run     clear
run     logon tester
wait    5
send    dir\r
wait    3
send    \033
wait    2
run     shell "echo before; timeout; echo after"
wait    3

shot    mmon
for     mmon watch
size    48 80
cap     mmon is TOP's timesharing monitor, the job Microware's tsmon does,
cap     configured per line: on a direct line it starts logon at once, on a
cap     modem line it initialises the modem and starts logon when a call
cap     connects, setting the speed from the modem's CONNECT message.  Each
cap     line gets a block in SYS/mmon.config, as in the sample shown, and
cap     two lock entries in SYS/sysinfo.  Its module is readable by the
cap     super-user only, who starts it.  Started on a terminal line here it
cap     stays silent; that has not been worked out.  watch waits for a
cap     modem to ring and starts a command -- also the super-user's.
try     tail -l=26 DOC/SYSADMIN/mmon.config.sample
run     builtin cd /dd
run     clear
run     tail -l=26 DOC/SYSADMIN/mmon.config.sample
wait    3
run     watch -?
wait    3

shot    errlog
for     errlog erradm
cap     errlog gathers error messages from other programs into one log;
cap     erradm starts, stops, flushes and prints it.
try     erradm -?
run     clear
run     errlog -?
wait    2
run     erradm -?
wait    3

shot    vcron
for     vcron crontab
cap     Vixie's cron.  vcron runs only for members of the group Cron,
cap     which this disk has not got, so it says so; crontab lists,
cap     installs, edits and removes a user's own table.
try     crontab -l
run     clear
run     vcron
wait    3
run     crontab -l
wait    3

shot    rex
for     rex chp remdate prexd prexdc
cap     rex runs a command on another OS-9/Net node; chp logs in to one;
cap     remdate takes its clock from one; prexd and prexdc are the daemon
cap     and server on the node that answers.  Without a network each asks
cap     for /n0 and stops.
try     rex -?
run     clear
run     rex -?
wait    3
run     remdate
wait    3

shot    uid
for     uid newgrp
cap     uid prints a user's ids from the password file -- here the tester
cap     account this disk carries; the group shows as UNKNOWN because there
cap     is no SYS/group.  newgrp changes your group, as SYS/group allows.
try     uid tester
run     clear
run     uid tester
wait    2
run     newgrp -?
wait    3

shot    mesg
for     mesg msg speak
cap     Messages between users logged in at once, whom logon records in
cap     SYS/utmp: mesg sets whether you take them, msg sends a line, speak
cap     opens a split-screen chat.  Here nobody else is logged in, so
cap     their usage and speak's refusal are what can be shown.
try     speak tester
run     clear
run     mesg -?
wait    2
run     speak tester
wait    3

shot    mmenu
cap     mmenu gives a user a menu instead of a shell, as on a BBS.  Each
cap     menu is a file: a title, a line of explanation, then one entry a
cap     line, `Name,command' -- `#menu' opens another, `:help' shows the
cap     menu's .hlp file, `:logoff' leaves.  MENUDATA names the directory,
cap     and PORT the terminal, which logon sets; here both are set by hand
cap     and the menu is one of three entries.  `l' leaves it.
try     mmenu -f=main
run     rm -rf /dd/tmp/MMC; mkdir -p /dd/tmp/MMC; builtin cd /dd/tmp/MMC
run     echo "Main Menu" > main; echo "Pick one; l leaves" >> main
run     echo "Date,date" >> main; echo "Help,:help" >> main; echo "Logoff,:logoff" >> main
run     echo "The only help there is." > main.hlp
run     export MENUDATA=/dd/tmp/MMC PORT=/term
wait    2
run     clear
wait    1
run     mmenu -f=main
wait    6
snap
quit    l\r

shot    mwb
cap     mwb, the manual workbench: it creates and edits manual entries a
cap     section at a time, writes them out in proff format, and previews,
cap     formats, prints and indexes them.  It keeps them under USR/DOC/.MAN
cap     on /h0, in a workspace directory SOURCE, which it needs to find.
try     mwb
run     mkdir -p /h0/USR/DOC/.MAN/SOURCE
wait    2
run     clear
run     mwb
wait    6
snap
