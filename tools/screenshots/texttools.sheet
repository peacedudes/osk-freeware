# The filters, each one on real text off this disk.

shot    bm
cap     bm, a Boyer-Moore grep, and fgrep beside it -- both older and
cap     faster than the GNU one, and both still here.
run     bm cribbage /dd/DOC/INDEX
wait    4
run     fgrep cribbage /dd/DOC/INDEX
wait    4

shot    cdiff
cap     cdiff is a context diff and it cannot finish one: `MAXLINECOUNT
cap     exceeded, must stop' on any pair of files given it here, down to
cap     three lines apiece.  `diff' and `ediff' both work; diff has its own
cap     card.
run     head -n 3 /dd/SYS/holidays > /dd/tmp/h1 2>/nil
wait    3
run     sed -e "s/Day/DAY/" /dd/tmp/h1 > /dd/tmp/h2
wait    4
run     cdiff /dd/tmp/h1 /dd/tmp/h2
wait    6

shot    cookie
cap     cookie, the fortune-cookie program, reading the collection's own
cap     sayings file.
run     cookie
wait    2
run     cookie
wait    3

shot    cursive
cap     cursive writes a joined-up banner sideways down the screen.
run     echo Freeware | cursive
wait    6
kill

shot    diff
cap     GNU diff 1.1 on two versions of the same file -- the disk had no
cap     diff at all before this one was added.
run     head -n 12 /dd/SYS/motd > /dd/tmp/a.txt 2>/nil
wait    2
run     sed -e "s/OS-9/OS-Nine/" /dd/tmp/a.txt > /dd/tmp/b.txt
wait    3
run     diff -c /dd/tmp/a.txt /dd/tmp/b.txt
wait    5

shot    deton
cap     deton counts down three seconds and blows the machine up, which it
cap     announces and does not do.  Run it with nothing on standard input
cap     and it goes off by itself.
run     deton < /nil
wait    8

shot    fcomp
cap     fcomp compares two text files line by line.
run     echo "alpha" > /dd/tmp/fc1
wait    4
run     echo "bravo" >> /dd/tmp/fc1
wait    4
run     cp /dd/tmp/fc1 /dd/tmp/fc2
wait    4
run     echo "charlie" >> /dd/tmp/fc2
wait    4
run     fcomp /dd/tmp/fc1 /dd/tmp/fc2
wait    6

shot    gothic
cap     gothic sets a line in blackletter.  It asks where to write and
cap     whether to halve the size before it draws.
run     gothic
wait    3
send    \r
wait    2
send    \r
wait    2
send    OS-9\r
wait    6

shot    grep
cap     GNU grep 2.0 searching the disk's own index, with the count beside
cap     the hits.
run     grep -n "chess" /dd/DOC/INDEX | head -n 10
wait    6
run     grep -c "" /dd/DOC/INDEX
wait    4

shot    jargon
cap     The Jargon File browser, looking up a word in its own database --
cap     jargon.txt and jargon.idx in /dd/VH.  The database is named by its
cap     BASE name and nothing else: given a path it says it cannot find it.
run     jargon -b kluge jargon
wait    10

shot    lout
cap     Basser Lout 2.05, a document formatter in the TeX tradition, saying
cap     what it is.
run     lout -V
wait    6

shot    sort
cap     sort and uniq counting the commonest words in the disk's own
cap     documentation -- a pipeline of five programs, all of them here.
run     sepwords < /dd/DOC/README-CIO | sort | uniq -c | sort -nr | head -n 12
wait    12

shot    soundex
cap     soundex reduces each word to its phonetic key -- Robert and Rupert
cap     come out the same, which is the whole idea.  It wants one word to
cap     a line, so sepwords feeds it.
run     echo Robert Rupert Rubin Ashcraft Ashcroft | sepwords | soundex
wait    5

shot    speech
cap     speech turns English spelling into phonemes -- the front half of a
cap     speech synthesiser, with the sound left to the hardware.
run     speech
wait    3
send    OS-9 is a real time operating system\r
wait    5

shot    what
cap     what prints the expansion cards fitted to a GEPARD, the German 68k
cap     machine much of the EFFO material was written for: address,
cap     reference byte and name.  With no GEPARD underneath it the table
cap     comes out empty, and it ignores anything given to it on the command
cap     line.
run     what
wait    8
run     what /dd/CMDS/today
wait    8

shot    tformat
cap     tformat, the SNOBOL4 text formatter.
run     head -n 24 /dd/DOC/README-KEEP | tformat
wait    8

shot    unip
cap     unip is `unique with page numbers' -- the last stage of the index
cap     chain that starts with sepwords: split a document into words, sort
cap     them, and print each one once with the pages it appeared on.  The
cap     page column is empty here because nothing upstream paginated the
cap     text; what is left is the vocabulary of the file, in order.
run     sepwords < /dd/DOC/README-CIO | sort | unip | head -n 18
wait    10

shot    btop
cap     btop turns each character of a file into a grid of O and space --
cap     how a font or a bitmap moved through a mail system that would only
cap     carry text, long before uuencode.  Twelve bytes of text become
cap     rows of O and space; `ptob' turns them back, byte for byte.
run     head -c 12 /dd/SYS/motd > /dd/tmp/b1
wait    5
run     btop /dd/tmp/b1
wait    8
run     btop /dd/tmp/b1 > /dd/tmp/b2
wait    5
run     ptob /dd/tmp/b2 > /dd/tmp/b3
wait    5
run     /dd/CMDS/cmp /dd/tmp/b1 /dd/tmp/b3
wait    6
run     cat /dd/tmp/b3
wait    5
run     rm -f /dd/tmp/b1 /dd/tmp/b2 /dd/tmp/b3
wait    4

shot    hc
cap     hc shifts text to a column, or labels every line -- and it is the
cap     program this collection had most wrong: DOC/INDEX called it a hex
cap     calculator until 2026-08-31, and its own card showed nothing but the
cap     usage line, from an invocation the usage line does not describe.
cap     `+8' indents to column 8, `-11' strips back to column 11, and
cap     `-l' puts a string in front of every line.
run     cat /dd/SYS/motd
wait    5
run     hc +8 /dd/SYS/motd
wait    5
run     hc -11 /dd/SYS/motd
wait    5
run     hc -l "> " /dd/SYS/motd
wait    5

# Formatters, fortune tools, comparers, sorters, searchers and the KWIC
# indexers, one stanza per program; each makes what it reads under
# /dd/tmp/TXT.

shot    nroff
size    30 80
cap     nroff setting a short text: a centred title, then paragraphs
cap     filled and justified to the measure.  Its macro sets are in LIB.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf ".ce\rJABBERWOCKY\r.sp\rTwas brillig, and the slithy toves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r.sp\rBeware the Jabberwock, my son -- the jaws that bite, the claws that catch.\r" > /dd/tmp/TXT/jab.r
wait    3
run     clear
wait    1
run     nroff /dd/tmp/TXT/jab.r | head -n 14
wait    10

shot    roff
size    30 80
cap     roff, the older formatter, on the same text: title centred, the
cap     paragraph filled and justified to a narrower measure.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf ".ce\rJABBERWOCKY\r.sp\rTwas brillig, and the slithy toves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r.sp\rBeware the Jabberwock, my son -- the jaws that bite, the claws that catch.\r" > /dd/tmp/TXT/jab.r
wait    3
run     clear
wait    1
run     roff /dd/tmp/TXT/jab.r | head -n 14
wait    10

shot    proff
size    30 80
cap     proff, a portable roff, on the same text; its macros are in
cap     LIB/proff.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf ".ce\rJABBERWOCKY\r.sp\rTwas brillig, and the slithy toves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r.sp\rBeware the Jabberwock, my son -- the jaws that bite, the claws that catch.\r" > /dd/tmp/TXT/jab.r
wait    3
run     clear
wait    1
run     proff /dd/tmp/TXT/jab.r | head -n 14
wait    10

shot    fmt
cap     Refills ragged text into even lines, to 72 columns or to a width
cap     given as -<n>.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Twas brillig,\rand the slithy\rtoves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r" > /dd/tmp/TXT/rag.txt
wait    3
run     clear
wait    1
run     cat /dd/tmp/TXT/rag.txt
wait    2
run     fmt /dd/tmp/TXT/rag.txt
wait    5
run     fmt -30 /dd/tmp/TXT/rag.txt
wait    5

shot    strfile
cap     Turns a file of sayings separated by %% lines into the indexed
cap     .dat file fortune reads, and reports what it found.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; rm -f /dd/tmp/TXT/say.dat; printf "A closed mouth gathers no feet.\r%%%%\rThe second mouse gets the cheese.\r%%%%\rNever test for an error you do not know how to handle.\r%%%%\r" > /dd/tmp/TXT/say
wait    3
run     clear
wait    1
run     cat /dd/tmp/TXT/say
wait    3
run     strfile /dd/tmp/TXT/say
wait    5

shot    unstr
cap     Meant to be the other way, printing the sayings back out of the
cap     .dat file strfile made.  It asks for 75 megabytes of memory
cap     before it reads a byte, is refused, and stops.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; rm -f /dd/tmp/TXT/say.dat; printf "A closed mouth gathers no feet.\r%%%%\rThe second mouse gets the cheese.\r%%%%\r" > /dd/tmp/TXT/say; strfile /dd/tmp/TXT/say > /nil
wait    4
run     clear
wait    1
run     unstr /dd/tmp/TXT/say
wait    5

shot    cookhash
cap     Builds the hash file the cookie program uses to pick a saying
cap     at random from a file of them.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "A closed mouth gathers no feet.\r%%%%\rThe second mouse gets the cheese.\r%%%%\r" > /dd/tmp/TXT/say
wait    3
run     clear
wait    1
run     cookhash < /dd/tmp/TXT/say > /dd/tmp/TXT/say.hash; ls -l /dd/tmp/TXT/say.hash
wait    5

shot    fortune
cap     A fortune at random from the collection in GAMES/FORTUNE, twice.
run     fortune
wait    5
run     fortune
wait    5

shot    ediff
cap     Puts diff's output into plain English: which lines changed, from
cap     what to what, and what was added.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "apple\rbanana\rcherry\rdate\r" > /dd/tmp/TXT/a; printf "apple\rblueberry\rcherry\rdate\relder\r" > /dd/tmp/TXT/b
wait    3
run     clear
wait    1
run     diff /dd/tmp/TXT/a /dd/tmp/TXT/b | ediff
wait    6

shot    spiff
cap     spiff compares two files and reports the differences in diff's
cap     shape: a changed line and an added one.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "apple\rbanana\rcherry\rdate\r" > /dd/tmp/TXT/a; printf "apple\rblueberry\rcherry\rdate\relder\r" > /dd/tmp/TXT/b
wait    3
run     clear
wait    1
run     spiff /dd/tmp/TXT/a /dd/tmp/TXT/b
wait    6

shot    uniq
cap     Drops repeated adjacent lines; after a sort, -c counts each.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "pear\rapple\rpear\rfig\rfig\rfig\rapple\r" > /dd/tmp/TXT/dups
wait    3
run     clear
wait    1
run     uniq < /dd/tmp/TXT/dups
wait    4
run     sort /dd/tmp/TXT/dups | uniq -c
wait    5

shot    nsort
cap     A sort filter: the same seven lines, in order.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "pear\rapple\rpear\rfig\rfig\rfig\rapple\r" > /dd/tmp/TXT/dups
wait    3
run     clear
wait    1
run     cat /dd/tmp/TXT/dups; echo ---; nsort < /dd/tmp/TXT/dups
wait    5

shot    qsort9
cap     Another sort filter, by quicksort.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "pear\rapple\rpear\rfig\rfig\rfig\rapple\r" > /dd/tmp/TXT/dups
wait    3
run     clear
wait    1
run     qsort9 < /dd/tmp/TXT/dups
wait    5

shot    join
cap     Joins two files on a common first field, the way a database
cap     joins tables: name and colour from one, name and count from the
cap     other.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "apple red\rfig purple\rpear green\r" > /dd/tmp/TXT/j1; printf "apple 3\rfig 12\rpear 7\r" > /dd/tmp/TXT/j2
wait    3
run     clear
wait    1
run     join /dd/tmp/TXT/j1 /dd/tmp/TXT/j2
wait    5

shot    ggrep
cap     GNU grep, with line numbers.
run     ggrep -n USR /dd/SYS/password
wait    5

shot    bmgtest
cap     A test program for the Boyer-Moore search in bm: given a pattern
cap     and a file it searches and prints nothing when it is satisfied.
run     bmgtest the /dd/SYS/motd; echo "status $?"
wait    5

shot    bmgtest2
cap     The second Boyer-Moore test program, the same shape.
run     bmgtest2 the /dd/SYS/motd; echo "status $?"
wait    5

shot    pagekwic
size    36 80
cap     A keyword-in-context index: every rotation of every title, one
cap     line each, the way a KWIC index is built before sorting.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "The Art of Computer Programming\rStructured Programming\rThe C Programming Language\rThe Mythical Man-Month\r" > /dd/tmp/TXT/titles
wait    3
run     clear
wait    1
run     cat /dd/tmp/TXT/titles
wait    2
run     pagekwic < /dd/tmp/TXT/titles
wait    8

shot    pagefraz
size    36 80
cap     The phrase index of the same set: each title broken into the
cap     phrases an index would list.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "The Art of Computer Programming\rStructured Programming\rThe C Programming Language\rThe Mythical Man-Month\r" > /dd/tmp/TXT/titles
wait    3
run     clear
wait    1
run     pagefraz < /dd/tmp/TXT/titles
wait    8

shot    pageline
cap     Numbers the lines of the same set for the index to refer to.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "The Art of Computer Programming\rStructured Programming\rThe C Programming Language\rThe Mythical Man-Month\r" > /dd/tmp/TXT/titles
wait    3
run     clear
wait    1
run     pageline < /dd/tmp/TXT/titles
wait    8

shot    ispell
cap     ispell listing the words it does not know in a file: -l gives
cap     the list instead of the interactive session.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Twas brilig and the slithy tovs did gyre and gimble in the wabe.\r" > /dd/tmp/TXT/spell.txt
wait    3
run     clear
wait    1
run     ispell -l /dd/tmp/TXT/spell.txt
wait    12

shot    buildhash
cap     Builds ispell's hashed dictionary from a word list and an affix
cap     file; without the word list it says which one it wants.
run     buildhash
wait    6

shot    makelex
cap     Turns a word list into C source for a dictionary table, one
cap     entry per line; given no list it shows the shape of what it
cap     writes.
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "apple 1\rfig 2\rpear 3\r" > /dd/tmp/TXT/wl
wait    3
run     clear
wait    1
run     makelex < /dd/tmp/TXT/wl
wait    6

shot    fgrep
cap     Searches for a fixed string rather than a pattern: the lines of
cap     the password file naming a home under USR.
run     fgrep -n USR /dd/SYS/password
wait    5
