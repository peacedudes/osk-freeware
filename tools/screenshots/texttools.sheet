# The filters, each one on real text off this disk.

shot    ascii
cap     The ASCII table, four columns, control names and all.
run     ascii | head -n 20
wait    5

shot    bibtex
for     bibtex afm2tfm maketexpk
cap     BibTeX, the bibliography processor, with the sample database that
cap     ships beside it.
run     bibtex
wait    12

shot    bm
cap     bm, a Boyer-Moore grep, and fgrep beside it -- both older and
cap     faster than the GNU one, and both still here.
run     bm cribbage /dd/DOC/INDEX
wait    4
run     fgrep cribbage /dd/DOC/INDEX
wait    4

shot    casefix
cap     casefix normalises letter case -- one capital at the front, the
cap     rest down.  It is a FILTER and takes no filename: given one it
cap     ignores it and reads the terminal, which is a good way to lose a
cap     script.  `upperdir' does the same job to a directory's names.
run     echo "tHE qUICK bROWN fOX" | casefix
wait    5
run     echo "hello THERE from OS-9" | casefix
wait    5

shot    cdiff
cap     cdiff is a context diff and it cannot finish one: `MAXLINECOUNT
cap     exceeded, must stop' on any pair of files given it here, down to
cap     three lines apiece.  `diff' and `ediff' both work; diff has its own
cap     card.
run     head -n 3 /dd/SYS/holidays > /dd/tmp/h1 2>/nil
wait    3
run     sed -e "s/Day/DAY/" /dd/tmp/h1 > /dd/tmp/h2
wait    4
run     cdiff /dd/tmp/h1 /dd/tmp/h2
wait    6

shot    charcnt
cap     charcnt counts characters -- and it wants FILENAMES, not a
cap     redirect, and says so when it gets one.  `tcmp' compares two text
cap     files and says where they first differ.
run     charcnt < /dd/SYS/motd
wait    5
run     charcnt /dd/SYS/motd /dd/SYS/password
wait    6
run     tcmp /dd/SYS/motd /dd/SYS/holidays
wait    6

shot    cookhash
for     cookhash cookie strfile unstr fortune
cap     The fortune machinery, both halves: cookhash builds the hash a
cap     sayings file needs, and cookie reads one out of it.
run     cookhash -?
wait    6
run     cookie
wait    6

# cookie DRAWS AT RANDOM.  Re-shooting this one changes what it says, and
# the file has some sayings that do not want to be the face of the disk --
# read what comes back before committing it.
shot    cookie
cap     cookie, the fortune-cookie program, reading the collection's own
cap     sayings file.
run     cookie
wait    2
run     cookie
wait    3

shot    cursive
cap     cursive writes a joined-up banner sideways down the screen.
run     echo Freeware | cursive
wait    6
kill

shot    cut
cap     cut taking fields out of the password file, and paste putting two
cap     streams back together.
run     cut -d, -f1,3 /dd/SYS/password
wait    5

shot    detab
cap     detab turns tabs into spaces; unexpand puts leading spaces back as
cap     tabs.  Shown here with dump, so the bytes are visible.
run     head -n 3 /dd/SYS/holidays > /dd/tmp/tabs.txt 2>/nil
wait    4
run     dump /dd/tmp/tabs.txt
wait    6
run     detab /dd/tmp/tabs.txt > /dd/tmp/notabs.txt
wait    5
run     dump /dd/tmp/notabs.txt
wait    8

shot    diff
cap     GNU diff 1.1 on two versions of the same file -- the disk had no
cap     diff at all before this one was added.
run     head -n 12 /dd/SYS/motd > /dd/tmp/a.txt 2>/nil
wait    2
run     sed -e "s/OS-9/OS-Nine/" /dd/tmp/a.txt > /dd/tmp/b.txt
wait    3
run     diff -c /dd/tmp/a.txt /dd/tmp/b.txt
wait    5

shot    dump
cap     dump, the hex dump: an OS-9 module header, byte by byte.  The first
cap     four bytes are the sync $4AFC and the module's size.
run     dump /dd/CMDS/today | head -n 16
wait    5

shot    tex
for     tex virtex initex texidx
cap     TeX itself, typesetting Knuth's own sample story out of
cap     SYS/TEX/SAMPLES: it loads the plain format, sets the page and writes
cap     a DVI file.  Note that it is `virtex' being run, not `tex' -- the
cap     `tex' wrapper forks `virtex' by bare name, and OS-9 resolves a fork
cap     against the EXECUTION directory rather than PATH, so from /dd/CMDS
cap     it cannot find it.  Run virtex yourself, or copy it up.
run     virtex "&plain" /dd/SYS/TEX/SAMPLES/story.tex
wait    40
send    \134end\r
wait    20

shot    latex
for     latex slitex
cap     LaTeX is the same program with a different format loaded: `&lplain'
cap     rather than `&plain'.  Here it sets the sample LaTeX document that
cap     ships with it, and reports the pages as it writes them.
run     virtex "&lplain" /dd/SYS/TEX/SAMPLES/small.tex
wait    60
send    \r
wait    10

shot    dvitype
for     dvitype dvips dvilj2 dvijet
cap     dvitype reads the DVI file back and prints what is in it: page by
cap     page, the font changes and the character positions TeX computed.
run     dvitype story.dvi
wait    10
send    4\r
wait    4
send    \r
wait    4
send    \r
wait    4
send    \r
wait    4
send    \r
wait    4
send    \r
wait    20

shot    expand
for     expand unexpand deton tabs autolf
cap     Tabs to spaces and back again, with dump showing the bytes so the
cap     change is visible rather than asserted: one line of SYS/holidays,
cap     09 09 becoming a run of 20s and then coming back byte for byte.
cap     `unexpand' needs -a to do it: without it, like every unexpand, it
cap     only touches whitespace at the START of a line and these tabs are
cap     in the middle.  `dump' wants a PATH -- it prints its usage for
cap     anything handed to it on standard input -- so each stage is
cap     written to a file first.
run     head -n 3 /dd/SYS/holidays 2>/nil | tail -l=1 > /dd/tmp/t2.txt
wait    5
run     dump /dd/tmp/t2.txt
wait    6
run     expand /dd/tmp/t2.txt > /dd/tmp/t3.txt
wait    5
run     dump /dd/tmp/t3.txt
wait    6
run     unexpand -a < /dd/tmp/t3.txt > /dd/tmp/t4.txt
wait    5
run     dump /dd/tmp/t4.txt
wait    8

shot    fcomp
cap     fcomp compares two text files line by line.
run     fcomp /dd/tmp/h1 /dd/tmp/h2
wait    6

shot    file
for     file
cap     file identifying what things are, out of SYS/magic: an OS-9 module,
cap     a text file, a GIF and a tar archive it makes for itself first.
run     tar cf /dd/tmp/f.tar /dd/SYS/motd
wait    8
run     file /dd/CMDS/today /dd/DOC/INDEX /dd/DEMO/gulls.gif /dd/tmp/f.tar
wait    8

shot    fmt
cap     fmt folding a long text to the terminal width.
run     head -n 30 /dd/DOC/README-KEEP | fmt
wait    6

shot    gawk
size    36 80
cap     GNU awk 2.11 over the disk's own index: count the programs by the
cap     letter they start with, then sort by that count.  It is fed on
cap     STDIN because this build ignores a filename argument and reads
cap     standard input whatever it is given -- name a file and it sits
cap     waiting for the terminal instead.
run     gawk "{print substr(\$1,1,1)}" < /dd/DOC/INDEX > /dd/tmp/1st
wait    12
run     sort /dd/tmp/1st | uniq -c | sort -nr | head -n 12
wait    10


shot    gep
for     gep lgrep ggrep bmgtest bmgtest2
cap     More pattern matchers, each from a different decade.  `ggrep' is
cap     GNU grep out of sh_utils and counts what it finds.  `lgrep' is
cap     meant to print the NAMES of files that match, the way grep -l
cap     does, and prints nothing at all here whatever it is given -- its
cap     usage line is the only output anyone has got out of it.
run     gep -?
wait    6
run     lgrep chess /dd/DOC/INDEX /dd/DOC/STATUS /dd/SYS/motd
wait    6
run     lgrep -?
wait    6
run     ggrep -c chess /dd/DOC/INDEX
wait    8

shot    gothic
cap     gothic sets a line in blackletter.  It asks where to write and
cap     whether to halve the size before it draws.
run     gothic
wait    3
send    \r
wait    2
send    \r
wait    2
send    OS-9\r
wait    6

shot    grep
cap     GNU grep 2.0 searching the disk's own index, with the count beside
cap     the hits.
run     grep -n "chess" /dd/DOC/INDEX | head -n 10
wait    6
run     grep -c "" /dd/DOC/INDEX
wait    4

shot    ispell
for     ispell buildhash makelex
cap     ispell listing the words it does not know out of a line of
cap     deliberately bad spelling -- the -l form, which is what a script
cap     uses.
run     echo The quik brown foxx jmups over the lasy dog > /dd/tmp/sp.txt
wait    5
run     ispell -l /dd/tmp/sp.txt
wait    10

shot    jargon
cap     The Jargon File browser, looking up a word in its own database --
cap     jargon.txt and jargon.idx in /dd/VH.  The database is named by its
cap     BASE name and nothing else: given a path it says it cannot find it.
run     jargon -b kluge jargon
wait    10

shot    join
for     join paste cut field
cap     paste puts two files side by side and join matches them on a common
cap     first field -- the relational pair.
run     head -n 5 /dd/SYS/holidays > /dd/tmp/j1
wait    5
run     head -n 5 /dd/SYS/birthdays > /dd/tmp/j2
wait    5
run     paste /dd/tmp/j1 /dd/tmp/j2
wait    8

shot    kwic
for     pagefraz pagekwic pageline
cap     The KWIC suite: a key-word-in-context index, the way a printed
cap     concordance was made.  pageline numbers the lines, pagekwic splits
cap     them to one phrase each, pagefraz pulls the phrases out.
run     head -n 12 /dd/SYS/holidays > /dd/tmp/k.txt
wait    6
run     pageline /dd/tmp/k.txt | head -n 12
wait    8

shot    lout
cap     Basser Lout 2.05, a document formatter in the TeX tradition, saying
cap     what it is.
run     lout -V
wait    6

shot    pep
for     pep ape eo qt cuts
cap     pep is a file `detergent' -- it strips the junk out of a file using
cap     the character tables in SYS/PEP.
run     pep -?
wait    8

shot    qsort9
for     qsort9 nsort shuffle uniq unip
cap     Three sorts on the same four numbers, and only one of them is a
cap     numeric sort.  `qsort9' compares text, which is what it is for.
cap     `nsort' answers exactly the same -- 111 before 22 before 3 --
cap     so it is NOT the numeric sort its name and DOC/INDEX promised,
cap     and the index is corrected.  `sort -n' is the one that gets it
cap     right.  The file is built with echo because this disk's printf
cap     prints nothing at all for a format with no conversion in it.
run     echo 3 > /dd/tmp/n.txt
wait    3
run     echo 22 >> /dd/tmp/n.txt
wait    3
run     echo 111 >> /dd/tmp/n.txt
wait    3
run     echo 4 >> /dd/tmp/n.txt
wait    4
run     qsort9 < /dd/tmp/n.txt
wait    8
run     nsort < /dd/tmp/n.txt
wait    8
run     sort -n /dd/tmp/n.txt
wait    8

shot    qt
cap     qt tells the time the way a person would say it.
run     qt
wait    3

shot    rot
cap     rot turns a file on its side -- the first line becomes the first
cap     column.  It is NOT a rot-13 cipher, whatever the name suggests;
cap     DOC/INDEX said so until this screen was taken.
run     head -n 6 /dd/SYS/holidays > /dd/tmp/h.txt
wait    3
run     cat /dd/tmp/h.txt
wait    3
run     rot /dd/tmp/h.txt
wait    5

shot    sepwords
cap     sepwords splits text to one word a line, splitalf splits a file
cap     alphabetically -- the two halves of preparing a word list.
run     head -n 4 /dd/SYS/motd | sepwords
wait    6

shot    shuffle
cap     shuffle puts the lines of a file in a random order; nsort sorts
cap     numerically where an ordinary sort would not.
run     head -n 8 /dd/SYS/holidays | shuffle
wait    6

shot    sort
cap     sort and uniq counting the commonest words in the disk's own
cap     documentation -- a pipeline of five programs, all of them here.
run     sepwords < /dd/DOC/README-CIO | sort | uniq -c | sort -nr | head -n 12
wait    12

shot    soundex
cap     soundex reduces each word to its phonetic key -- Robert and Rupert
cap     come out the same, which is the whole idea.  It wants one word to
cap     a line, so sepwords feeds it.
run     echo Robert Rupert Rubin Ashcraft Ashcroft | sepwords | soundex
wait    5

shot    speech
cap     speech turns English spelling into phonemes -- the front half of a
cap     speech synthesiser, with the sound left to the hardware.
run     speech
wait    3
send    OS-9 is a real time operating system\r
wait    5

shot    spiff
cap     spiff is a tolerant diff: it ignores the formatting differences an
cap     ordinary diff would report.
run     head -n 8 /dd/SYS/motd > /dd/tmp/s1
wait    2
run     detab /dd/tmp/s1 > /dd/tmp/s2
wait    3
run     spiff /dd/tmp/s1 /dd/tmp/s2
wait    5

shot    split
for     split splitalf sepwords unp fillup
cap     split cuts a file into pieces; here it splits the holidays file and
cap     ls shows what it wrote.
run     mkdir /dd/tmp/sp
wait    5
run     split -l 6 /dd/SYS/holidays /dd/tmp/sp/part
wait    8
run     ls -l /dd/tmp/sp
wait    8

shot    strfile
for     strfile unstr cookhash
cap     strfile builds the index `fortune' reads.  Here it converts the
cap     collection's own sayings file and reports what it found -- ONE
cap     string, because this file separates its quotations with a character
cap     strfile does not take as a delimiter, which is worth knowing before
cap     you rebuild an index over it.  (Its opposite number `unstr' floods
cap     `No more memory !!!' instead of dumping one; DOC/INDEX says so.)
run     cp /dd/GAMES/FORTUNE/fortunes.dat /dd/tmp/f.dat
wait    5
run     strfile /dd/tmp/f.dat
wait    8
run     ls -l /dd/tmp/f.dat*
wait    6

shot    strings
cap     strings pulls the printable text out of a binary, each hit reported
cap     with its offset.  Run here on an OS-9 module.
run     strings /dd/CMDS/today | head -n 16
wait    5

shot    subber
cap     subber substitutes text in a stream, reading the substitutions from
cap     a wordlist FILE rather than the command line.  It cannot run here:
cap     it calls F$Mem, an OS-9 system call os9exec does not implement, and
cap     the emulator says so and kills it.
run     echo ",os9exec,OS-9," > /dd/tmp/words.sub
wait    6
run     subber /dd/tmp/words.sub /dd/SYS/motd
wait    8

shot    sum
for     sum tail head tac
cap     sum, the checksum every Unix had before md5, and head and tail
cap     either end of the same file.
run     sum /dd/SYS/motd /dd/SYS/holidays
wait    8
run     tail -l=4 /dd/SYS/holidays
wait    8

shot    tac
cap     tac prints a file backwards, last line first.
run     head -n 8 /dd/SYS/holidays | tac
wait    5

shot    tangle
for     tangle weave tftopl pltotf gftype pktype
cap     tangle and weave are the WEB tools TeX itself is written with: one
cap     makes Pascal out of a .web file, the other makes TeX.
run     tangle
wait    10
run     tftopl /dd/SYS/TEX/FONTS/TFM/cmr10.tfm | head -n 14
wait    15

shot    tformat
cap     tformat, the SNOBOL4 text formatter.
run     head -n 24 /dd/DOC/README-KEEP | tformat
wait    8

shot    unip
cap     unip is `unique with page numbers' -- the last stage of the index
cap     chain that starts with sepwords: split a document into words, sort
cap     them, and print each one once with the pages it appeared on.  The
cap     page column is empty here because nothing upstream paginated the
cap     text; what is left is the vocabulary of the file, in order.
run     sepwords < /dd/DOC/README-CIO | sort | unip | head -n 18
wait    10

shot    upperdir
for     upperdir casefix
cap     upperdir normalises case across a directory: files lower,
cap     directories upper.  Shown here on a scratch copy, not on the disk.
run     upperdir -?
wait    8

shot    wc
cap     wc over the collection's own documents.
run     wc /dd/DOC/INDEX /dd/DOC/ORIGINS /dd/DOC/DEPENDS /dd/SOURCES.txt
wait    6


shot    dvidrivers
for     dvialw dvidjp dvieps dviimp dvijep dvijet dvilj2 dvimac dvioki dvitos dvips
cap     Eleven DVI drivers, one per printer that mattered in 1990:
cap     Apple LaserWriter, DeskJet, Epson, Imagen, LaserJet, Macintosh,
cap     Okidata, PostScript.  Each turns the same DVI into that machine's
cap     own language, and `wc' shows what each one made of it.
run     virtex "&plain" /dd/SYS/TEX/SAMPLES/story.tex
wait    40
send    \134end\r
wait    15
run     dvieps story.dvi | wc
wait    20
run     dvialw story.dvi | wc
wait    20


shot    texfonts
for     gftopk pktogf gftype pktype vftovp vptovf tftopl pltotf virmf inimf
cap     TeX's font tools.  tftopl turns a binary font metric into readable
cap     property lists and pltotf turns it back -- the round trip that lets
cap     you edit a font's metrics by hand.
run     tftopl /dd/SYS/TEX/FONTS/TFM/cmr10.tfm > /dd/tmp/cmr10.pl
wait    20
run     pltotf /dd/tmp/cmr10.pl /dd/tmp/cmr10.tfm
wait    20
run     ls -l /dd/SYS/TEX/FONTS/TFM/cmr10.tfm /dd/tmp/cmr10.tfm
wait    10


shot    misc-text
for     ediff fgrep gdd tcmp wc.cio
cap     Four more text tools, and `wc.cio' -- the archived build of wc,
cap     kept because it does NOT work: it prints nothing for a file
cap     argument, which is why CMDS/wc is a different binary.
run     fgrep chess /dd/DOC/INDEX | head -n 5
wait    10
run     gdd if=/dd/SYS/motd bs=8 count=3
wait    10
run     tcmp /dd/SYS/motd /dd/SYS/motd
wait    10
run     wc.cio /dd/SYS/motd
wait    10

shot    roff
for     roff nroff proff
cap     Three roffs, none of them GNU.  `proff' justifies text to a
cap     measure -- the spread-out words below are it filling the line --
cap     and takes page ranges and a statistics option.  `roff' is the
cap     small one with the same job.  `nroff' is the one to avoid: it
cap     answers `illegal switch' to -?, prints nothing for a file, and
cap     does not come back at all -- the session has to be stopped.
cap     `lout' and `tex' are what typeset properly here.
run     head -n 12 /dd/DOC/README-KEEP > /dd/tmp/r.txt 2>/nil
wait    5
run     proff /dd/tmp/r.txt | head -n 10
wait    10
run     roff -?
wait    8

shot    btop
for     btop ptob
cap     BtoP and PtoB, a pair: characters to bit patterns and back again.
cap     They are how a font or a bitmap moved through a mail system that
cap     would only carry text, long before uuencode was on this disk.
run     btop -?
wait    8
run     ptob -?
wait    8

