# The filters, each one on real text off this disk.

shot    bibtex
for     bibtex afm2tfm maketexpk
cap     BibTeX, the bibliography processor, with the sample database that
cap     ships beside it.
run     bibtex
wait    12
run     afm2tfm < /nil
wait    10
run     maketexpk < /nil
wait    10

shot    bm
cap     bm, a Boyer-Moore grep, and fgrep beside it -- both older and
cap     faster than the GNU one, and both still here.
run     bm cribbage /dd/DOC/INDEX
wait    4
run     fgrep cribbage /dd/DOC/INDEX
wait    4

shot    cdiff
cap     cdiff is a context diff and it cannot finish one: `MAXLINECOUNT
cap     exceeded, must stop' on any pair of files given it here, down to
cap     three lines apiece.  `diff' and `ediff' both work; diff has its own
cap     card.
run     head -n 3 /dd/SYS/holidays > /dd/tmp/h1 2>/nil
wait    3
run     sed -e "s/Day/DAY/" /dd/tmp/h1 > /dd/tmp/h2
wait    4
run     cdiff /dd/tmp/h1 /dd/tmp/h2
wait    6

shot    cookhash
for     cookhash cookie strfile unstr fortune
cap     The fortune machinery, both halves: cookhash builds the hash a
cap     sayings file needs, and cookie reads one out of it.
run     cookhash -?
wait    6
run     cookie
wait    6

# cookie DRAWS AT RANDOM.  Re-shooting this one changes what it says, and
# the file has some sayings that do not want to be the face of the disk --
# read what comes back before committing it.
run     fortune
wait    8
run     unstr < /nil
wait    8

shot    cookie
cap     cookie, the fortune-cookie program, reading the collection's own
cap     sayings file.
run     cookie
wait    2
run     cookie
wait    3

shot    cursive
cap     cursive writes a joined-up banner sideways down the screen.
run     echo Freeware | cursive
wait    6
kill

shot    diff
cap     GNU diff 1.1 on two versions of the same file -- the disk had no
cap     diff at all before this one was added.
run     head -n 12 /dd/SYS/motd > /dd/tmp/a.txt 2>/nil
wait    2
run     sed -e "s/OS-9/OS-Nine/" /dd/tmp/a.txt > /dd/tmp/b.txt
wait    3
run     diff -c /dd/tmp/a.txt /dd/tmp/b.txt
wait    5

shot    tex
for     tex virtex initex texidx
cap     TeX itself, typesetting Knuth's own sample story out of
cap     SYS/TEX/SAMPLES: it loads the plain format, sets the page and writes
cap     a DVI file.  Note that it is `virtex' being run, not `tex' -- the
cap     `tex' wrapper forks `virtex' by bare name, and OS-9 resolves a fork
cap     against the EXECUTION directory rather than PATH, so from /dd/CMDS
cap     it cannot find it.  Run virtex yourself, or copy it up.
run     virtex "&plain" /dd/SYS/TEX/SAMPLES/story.tex
wait    40
send    \134end\r
wait    20
run     tex /dd/SYS/TEX/SAMPLES/story.tex
wait    15
run     initex
wait    12
run     texidx
wait    10

shot    latex
for     latex slitex
cap     LaTeX is the same program with a different format loaded: `&lplain'
cap     rather than `&plain'.  Here it sets the sample LaTeX document that
cap     ships with it, and reports the pages as it writes them.
run     virtex "&lplain" /dd/SYS/TEX/SAMPLES/small.tex
wait    60
send    \r
wait    10
run     latex < /nil
wait    12
run     slitex < /nil
wait    12

shot    dvitype
for     dvitype dvips dvilj2 dvijet
cap     dvitype reads the DVI file back and prints what is in it: page by
cap     page, the font changes and the character positions TeX computed.
run     dvitype story.dvi
wait    10
send    4\r
wait    4
send    \r
wait    4
send    \r
wait    4
send    \r
wait    4
send    \r
wait    4
send    \r
wait    20

shot    deton
cap     deton counts down three seconds and blows the machine up, which it
cap     announces and does not do.  Run it with nothing on standard input
cap     and it goes off by itself.
run     deton < /nil
wait    8

shot    fcomp
cap     fcomp compares two text files line by line.
run     echo "alpha" > /dd/tmp/fc1
wait    4
run     echo "bravo" >> /dd/tmp/fc1
wait    4
run     cp /dd/tmp/fc1 /dd/tmp/fc2
wait    4
run     echo "charlie" >> /dd/tmp/fc2
wait    4
run     fcomp /dd/tmp/fc1 /dd/tmp/fc2
wait    6

shot    fmt
cap     fmt folding a long text to the terminal width.
run     head -n 30 /dd/DOC/README-KEEP | fmt
wait    6

shot    lgrep
for     lgrep ggrep bmgtest bmgtest2
cap     More pattern matchers, each from a different decade.  `ggrep' is GNU
cap     grep out of sh_utils and counts what it finds.  `lgrep' is meant to
cap     print the NAMES of files that match, the way grep -l does, and
cap     prints nothing at all here whatever it is given -- its usage line is
cap     the only output anyone has got out of it.
run     lgrep chess /dd/DOC/INDEX /dd/DOC/STATUS /dd/SYS/motd
wait    6
run     lgrep -?
wait    6
run     ggrep -c chess /dd/DOC/INDEX
wait    8
run     bmgtest < /nil
wait    8
run     bmgtest2 < /nil
wait    8

shot    gothic
cap     gothic sets a line in blackletter.  It asks where to write and
cap     whether to halve the size before it draws.
run     gothic
wait    3
send    \r
wait    2
send    \r
wait    2
send    OS-9\r
wait    6

shot    grep
cap     GNU grep 2.0 searching the disk's own index, with the count beside
cap     the hits.
run     grep -n "chess" /dd/DOC/INDEX | head -n 10
wait    6
run     grep -c "" /dd/DOC/INDEX
wait    4

shot    ispell
for     ispell buildhash makelex
cap     ispell listing the words it does not know out of a line of
cap     deliberately bad spelling -- the -l form, which is what a script
cap     uses.
run     echo The quik brown foxx jmups over the lasy dog > /dd/tmp/sp.txt
wait    5
run     ispell -l /dd/tmp/sp.txt
wait    10
run     buildhash < /nil
wait    10
run     makelex < /nil
wait    10

shot    jargon
cap     The Jargon File browser, looking up a word in its own database --
cap     jargon.txt and jargon.idx in /dd/VH.  The database is named by its
cap     BASE name and nothing else: given a path it says it cannot find it.
run     jargon -b kluge jargon
wait    10

shot    join
for     join
cap     paste puts two files side by side and join matches them on a common
cap     first field -- the relational pair.
run     head -n 5 /dd/SYS/holidays > /dd/tmp/j1
wait    5
run     head -n 5 /dd/SYS/birthdays > /dd/tmp/j2
wait    5
run     paste /dd/tmp/j1 /dd/tmp/j2
wait    8
run     join /dd/tmp/j1 /dd/tmp/j1
wait    8

shot    kwic
for     pagefraz pagekwic pageline
cap     The KWIC suite: a key-word-in-context index, the way a printed
cap     concordance was made. pageline numbers the lines, pagekwic splits
cap     them to one phrase each, pagefraz pulls the phrases out.
run     head -n 12 /dd/SYS/holidays > /dd/tmp/k.txt
wait    6
run     pageline /dd/tmp/k.txt | head -n 12
wait    8
run     pagefraz < /nil
wait    10
run     pagekwic < /nil
wait    10

shot    lout
cap     Basser Lout 2.05, a document formatter in the TeX tradition, saying
cap     what it is.
run     lout -V
wait    6

shot    qsort9
for     qsort9 nsort uniq unip
cap     Three sorts on the same four numbers, and only one of them is a
cap     numeric sort.  `qsort9' compares text, which is what it is for.
cap     `nsort' answers exactly the same -- 111 before 22 before 3 -- so it
cap     is NOT the numeric sort its name and DOC/INDEX promised, and the
cap     index is corrected.  `sort -n' is the one that gets it right.  The
cap     file is built with echo because this disk's printf prints nothing at
cap     all for a format with no conversion in it.
run     echo 3 > /dd/tmp/n.txt
wait    3
run     echo 22 >> /dd/tmp/n.txt
wait    3
run     echo 111 >> /dd/tmp/n.txt
wait    3
run     echo 4 >> /dd/tmp/n.txt
wait    4
run     qsort9 < /dd/tmp/n.txt
wait    8
run     nsort < /dd/tmp/n.txt
wait    8
run     sort -n /dd/tmp/n.txt
wait    8
run     uniq < /nil
wait    8

shot    vis
cap     Runs a command over and over and refreshes the screen with its
cap     output, the way `watch' does elsewhere: `vis {opts} <command>'.
cap     Its options.
run     vis -?
wait    8

shot    shuffle
size    24 80
cap     It is a full-screen SWITCH PUZZLE: a row of numbered switches,
cap     `LEVEL: 1', `Wich switch ?' and a move counter, and flipping one
cap     flips its neighbours.  The card used to pipe eight lines of
cap     SYS/holidays into it and capture `Unknown terminal type', which is
cap     what a game says when TERM is not set -- and the caption described a
cap     program that does not exist.  DOC/INDEX was corrected the same day;
cap     so is the category, from Text tools to Games.
run     export TERM=vt100
wait    4
run     shuffle
wait    14
quit    q

shot    sort
cap     sort and uniq counting the commonest words in the disk's own
cap     documentation -- a pipeline of five programs, all of them here.
run     sepwords < /dd/DOC/README-CIO | sort | uniq -c | sort -nr | head -n 12
wait    12

shot    soundex
cap     soundex reduces each word to its phonetic key -- Robert and Rupert
cap     come out the same, which is the whole idea.  It wants one word to
cap     a line, so sepwords feeds it.
run     echo Robert Rupert Rubin Ashcraft Ashcroft | sepwords | soundex
wait    5

shot    speech
cap     speech turns English spelling into phonemes -- the front half of a
cap     speech synthesiser, with the sound left to the hardware.
run     speech
wait    3
send    OS-9 is a real time operating system\r
wait    5

shot    spiff
cap     spiff is a tolerant diff: it ignores the formatting differences an
cap     ordinary diff would report.
run     head -n 8 /dd/SYS/motd > /dd/tmp/s1
wait    2
run     detab /dd/tmp/s1 > /dd/tmp/s2
wait    3
run     spiff /dd/tmp/s1 /dd/tmp/s2
wait    5

shot    strfile
for     strfile unstr cookhash
cap     strfile builds the index `fortune' reads.  Here it converts the
cap     collection's own sayings file and reports what it found -- ONE
cap     string, because this file separates its quotations with a character
cap     strfile does not take as a delimiter, which is worth knowing before
cap     you rebuild an index over it.  (Its opposite number `unstr' floods
cap     `No more memory !!!' instead of dumping one; DOC/INDEX says so.)
run     cp /dd/GAMES/FORTUNE/fortunes.dat /dd/tmp/f.dat
wait    5
run     strfile /dd/tmp/f.dat
wait    8
run     ls -l /dd/tmp/f.dat*
wait    6

shot    what
cap     what prints the expansion cards fitted to a GEPARD, the German 68k
cap     machine much of the EFFO material was written for: address,
cap     reference byte and name.  With no GEPARD underneath it the table
cap     comes out empty, and it ignores anything given to it on the command
cap     line.
run     what
wait    8
run     what /dd/CMDS/today
wait    8

shot    tangle
for     tangle weave
cap     tangle and weave are the WEB tools TeX itself is written with: one
cap     makes Pascal out of a .web file, the other makes TeX.  `tftopl' and
cap     `pltotf' are the font-metric pair with their own card; `gftype' and
cap     `pktype' are on the texfonts-bitmap card, which is where the ones
cap     with no bitmap font to read belong.  BOTH NEED A CHANGE FILE NAMED,
cap     and that is the whole reason this card used to be two usage lines.
cap     Given only a .web they answer `Error: `Can't open file.'' -- the
cap     absent change file is what they cannot open, not the source.
cap     DOC/tex ships sample.web and none.ch, an empty change file that
cap     changes nothing, as of 2026-08-31.  Both read the .web from the DATA
cap     directory and write there too.  The copies go to /dd because that is
cap     the data directory: bash's `cd' does not move it, so a bare filename
cap     is looked up there whatever the prompt says.
run     cp /dd/DOC/tex/sample.web /dd/sample.web
wait    6
run     cp /dd/DOC/tex/none.ch /dd/none.ch
wait    6
run     tangle /dd/DOC/tex/sample.web
wait    12
run     tangle sample none
wait    14
run     weave sample none
wait    14
run     cat /dd/sample.p
wait    10

shot    tformat
cap     tformat, the SNOBOL4 text formatter.
run     head -n 24 /dd/DOC/README-KEEP | tformat
wait    8

shot    unip
cap     unip is `unique with page numbers' -- the last stage of the index
cap     chain that starts with sepwords: split a document into words, sort
cap     them, and print each one once with the pages it appeared on.  The
cap     page column is empty here because nothing upstream paginated the
cap     text; what is left is the vocabulary of the file, in order.
run     sepwords < /dd/DOC/README-CIO | sort | unip | head -n 18
wait    10

shot    latex-wrapper
for     latex tex virtex
cap     LaTeX typesetting one of the documents that ship in
cap     SYS/TEX/SAMPLES, through the `latex' command itself.  That command
cap     is a one-line wrapper that hands `virtex "&lplain" yourfile' to a
cap     shell, and until 2026-08-31 it did NOTHING AT ALL and returned 221:
cap     SYS/login did not set SHELL, and this C library's system() forks
cap     $SHELL with the whole command line as one argument.  Of the five
cap     shells here only ksh parses an argument that way, so login now sets
cap     SHELL to it -- and tex and latex work.  The four `F$SetSys:
cap     unimplemented' lines are os9exec noise as ksh starts.
run     rm -f small.dvi small.log small.aux
wait    8
run     latex /dd/SYS/TEX/SAMPLES/small.tex
wait    45
run     ls -l small.dvi small.log
wait    8

shot    dvidrivers
for     dvialw dvidjp dvieps dviimp dvijep dvijet dvilj2 dvimac dvioki dvitos dvips
cap     Eleven DVI drivers, one per printer that mattered in 1990: Apple
cap     LaserWriter, DeskJet, Epson, Imagen, LaserJet, Macintosh, Okidata,
cap     PostScript.  Each turns the same DVI into that machine's own
cap     language, from one DVI, in one session.  Each names itself and the
cap     printer it is for, and writes to a FILE beside the DVI rather than
cap     to standard output.  They all warn that a font file could not be
cap     opened and set the text at zero size: SYS/TEX/FONTS carries .tfm
cap     METRICS and no bitmaps.  THAT IS NOW FIXABLE, as of 2026-09-01, and
cap     the `texfonts-bitmap' screen is where it is shown.  Metafont has its
cap     bases; render cmr10 at the resolution a driver asks for -- dvijet
cap     wants 120 dpi and `epsonlo' in modes.mf is 120 dpi -- pack it with
cap     gftopk, point TEXFONTS and FONTLIST at it, and dvijet's page goes
cap     from 3138 bytes of nothing to 7350 bytes of real glyph rasters.
cap     A.pk still does not ship, because a .pk is made for ONE printer at
cap     ONE resolution; what ships is the means.  `dvips' is the one
cap     exception and its trouble is not fonts: it stops at `Couldn't find
cap     header file tex.pro' and no .pro file is on this disk.  Two of the
cap     eleven were run here before 2026-08-29.
run     virtex "&plain" /dd/SYS/TEX/SAMPLES/story.tex
wait    40
send    \134end\r
wait    15
run     dvialw story.dvi
wait    20
run     dvidjp story.dvi
wait    20
run     dvieps story.dvi
wait    20
run     dviimp story.dvi
wait    20
run     dvijep story.dvi
wait    20
run     dvijet story.dvi
wait    20
run     dvilj2 story.dvi
wait    20
run     dvimac story.dvi
wait    20
run     dvioki story.dvi
wait    20
run     dvitos story.dvi
wait    20
run     dvips story.dvi
wait    25
run     ls -l /dd/story.dvi_alw /dd/story.dvi_eps
wait    12

shot    texfonts
for     tftopl pltotf
cap     TeX's font tools. tftopl turns a binary font metric into readable
cap     property lists and pltotf turns it back -- the round trip that lets
cap     you edit a font's metrics by hand.
run     tftopl /dd/SYS/TEX/FONTS/TFM/cmr10.tfm > /dd/tmp/cmr10.pl
wait    20
run     pltotf /dd/tmp/cmr10.pl /dd/tmp/cmr10.tfm
wait    20
run     ls -l /dd/SYS/TEX/FONTS/TFM/cmr10.tfm /dd/tmp/cmr10.tfm
wait    10

shot    texfonts-bitmap
size    58 82
for     gftopk pktogf gftype pktype vftovp vptovf virmf inimf
cap     TeX's BITMAP font tools, running a font from Metafont source to
cap     pixels and back.  SYS/TEX/MFBASES held its Makefile and nothing
cap     else, so Metafont answered `I can't find the default base file!'.
cap     `inimf' builds that base out of MFINPUTS/plain.mf in about a minute,
cap     and it is now built and shipped, the way SYS/TEX/FORMATS already
cap     shipped plain.fmt for TeX.  So: virmf renders logo10.mf -- the
cap     METAFONT logo font, seven characters -- at a low-resolution mode;
cap     gftype draws the M as pixels; gftopk packs 608 bytes down to 364;
cap     pktype reads the packed form back; pktogf unpacks it. vptovf and
cap     vftovp are the virtual pair: DOC/tex/sample.vpl maps one character
cap     onto cmr10 and compiles to a .vf, which vftovp reads back to the text
cap     it came from.  GFFONTS, PKFONTS, VFFONTS and TEXFONTS have to name
cap     the working directory: the FONTS search paths compiled into these
cap     binaries do NOT begin with `.' the way MFINPUTS does, so a file
cap     beside you is invisible to them.  That is the one thing here that
cap     reads like a fault and is not -- and it is also what lets the seven
cap     readers run with no `cd' at all.  Only Metafont needs one, because
cap     it writes its three outputs into the data directory and names them
cap     itself; the four `F$SetSys: unimplemented' lines are ksh starting
cap     up, not anything Metafont did.
run     rm -f /dd/tmp/GF/*
wait    6
run     mkdir -p /dd/tmp/GF
wait    6
run     export GFFONTS=/dd/tmp/GF; export PKFONTS=/dd/tmp/GF
wait    4
run     export VFFONTS=/dd/tmp/GF; export TEXFONTS=/dd/tmp/GF:/dd/SYS/TEX/FONTS/TFM
wait    4
run     echo "\\mode=epsonlo; mode_setup; input logo10" > /dd/tmp/GF/run.mf
wait    6
run     ksh -c "cd /dd/tmp/GF; virmf < run.mf"
wait    50
run     gftype -i logo10.120gf > /dd/tmp/GF/gt.txt
wait    25
run     sed -n 4,16p /dd/tmp/GF/gt.txt
wait    10
run     gftopk logo10.120gf /dd/tmp/GF/logo10.120pk
wait    20
run     pktype logo10.120pk > /dd/tmp/GF/pt.txt
wait    20
run     sed -n 2,8p /dd/tmp/GF/pt.txt
wait    10
run     pktogf logo10.120pk /dd/tmp/GF/back.120gf
wait    20
run     vptovf /dd/DOC/tex/sample.vpl /dd/tmp/GF/s.vf /dd/tmp/GF/s.tfm
wait    20
run     vftovp s.vf s.tfm /dd/tmp/GF/back.vpl
wait    20
run     ls -l /dd/tmp/GF
wait    12

shot    misc-text
for     ediff fgrep
cap     Two more text tools: `fgrep' searching the index for a word, and
cap     `ediff', which turns a diff into plain English and prints its
cap     syntax when it is given nothing.
run     fgrep chess /dd/DOC/INDEX | head -n 5
wait    10
run     ediff < /nil
wait    8

shot    roff
for     roff nroff proff
cap     Three roffs, none of them GNU.  `proff' justifies text to a measure
cap     -- the spread-out words below are it filling the line -- and takes
cap     page ranges and a statistics option.  `roff' is the small one with
cap     the same job.  `nroff' is the one to avoid: it answers `illegal
cap     switch' to -?, prints nothing for a file, and does not come back at
cap     all -- the session has to be stopped.  `lout' and `tex' are what
cap     typeset properly here.
run     head -n 12 /dd/DOC/README-KEEP > /dd/tmp/r.txt 2>/nil
wait    5
run     proff /dd/tmp/r.txt | head -n 10
wait    10
run     roff -?
wait    8
run     nroff -?
wait    8

shot    btop
for     btop ptob
cap     BtoP and PtoB, a pair: characters to bit patterns and back again.
cap     They are how a font or a bitmap moved through a mail system that
cap     would only carry text, long before uuencode was on this disk.
cap     Forty bytes of text become 640 bytes of O and space; PtoB turns
cap     those back into the same forty, byte for byte.  This card used to
cap     be the two usage lines, which showed neither.
run     head -c 12 /dd/SYS/motd > /dd/tmp/b1
wait    5
run     btop /dd/tmp/b1
wait    8
run     btop /dd/tmp/b1 > /dd/tmp/b2
wait    5
run     ptob /dd/tmp/b2 > /dd/tmp/b3
wait    5
run     /dd/CMDS/cmp /dd/tmp/b1 /dd/tmp/b3
wait    6
run     cat /dd/tmp/b3
wait    5
run     rm -f /dd/tmp/b1 /dd/tmp/b2 /dd/tmp/b3
wait    4

shot    hc
cap     hc shifts text to a column, or labels every line -- and it is the
cap     program this collection had most wrong: DOC/INDEX called it a hex
cap     calculator until 2026-08-31, and its own card showed nothing but the
cap     usage line, from an invocation the usage line does not describe.
cap     `+8' indents to column 8, `-11' strips back to column 11, and
cap     `-l' puts a string in front of every line.
run     cat /dd/SYS/motd
wait    5
run     hc +8 /dd/SYS/motd
wait    5
run     hc -11 /dd/SYS/motd
wait    5
run     hc -l "> " /dd/SYS/motd
wait    5
