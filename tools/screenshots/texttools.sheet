# The filters, each one on real text off this disk.

shot    bmg
cap     bmg, a Boyer-Moore grep, beside fgrep on the same search.
try     bmg cribbage DOC/INDEX
run     builtin cd /dd
wait    1
run     clear
wait    1
run     bmg cribbage DOC/INDEX
wait    4
run     fgrep cribbage DOC/INDEX
wait    4

shot    cdiff
cap     cdiff, an older context diff, comparing a holiday list against a
cap     copy with one word changed.  Its own shape: a line number and
cap     what it changed from and to, closed off with a line saying so.
try     cdiff tmp/h1 tmp/h2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     head -n 3 SYS/holidays > tmp/h1 2>/nil
wait    3
run     sed -e "s/Day/DAY/" tmp/h1 > tmp/h2
wait    4
run     cdiff tmp/h1 tmp/h2
wait    6

shot    cookie
cap     cookie, the fortune-cookie program, reading the collection's own
cap     sayings file.
try     cookie
run     cookie
wait    2
run     cookie
wait    3

shot    cursive
cap     cursive writes the word you give it as a single line of joined,
cap     sloping script, the kind of flourish people once signed email
cap     with.
try     cursive Carpe diem
run     cursive Carpe diem
wait    6

shot    diff
cap     GNU diff 1.4 on two versions of the same file, in context form: a
cap     header line for each file with its date, then the changed line
cap     marked with `!' in each.
try     diff -c tmp/a.txt tmp/b.txt
run     builtin cd /dd
wait    1
run     clear
wait    1
run     head -n 12 SYS/motd > tmp/a.txt 2>/nil
wait    2
run     sed -e "s/OS-9/OS-Nine/" tmp/a.txt > tmp/b.txt
wait    3
run     diff -c tmp/a.txt tmp/b.txt
wait    5

shot    diff_1.1
cap     GNU diff 1.1, the archive's build, on two short lists that differ on
cap     one line: pear becoming peach.
try     diff_1.1 tmp/BLGX/d1 tmp/BLGX/d2
run     mkdir -p /dd/tmp/BLGX > /nil 2>/nil
run     printf 'apple\rpear\rplum\r' > /dd/tmp/BLGX/d1
run     printf 'apple\rpeach\rplum\r' > /dd/tmp/BLGX/d2
run     builtin cd /dd
wait    1
run     clear
run     diff_1.1 tmp/BLGX/d1 tmp/BLGX/d2
wait    5

shot    fcomp
cap     fcomp compares two text files line by line and names what
cap     changed between them -- here, a line inserted at the end.
try     fcomp tmp/fc1 tmp/fc2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "alpha" > tmp/fc1
wait    4
run     echo "bravo" >> tmp/fc1
wait    4
run     cp tmp/fc1 tmp/fc2
wait    4
run     echo "charlie" >> tmp/fc2
wait    4
run     fcomp tmp/fc1 tmp/fc2
wait    6

shot    gothic
size    62 80
cap     Sets a word in fraktur capitals, each letter drawn large down the
cap     screen, for a title page or a poster.  This is `-h', half size,
cap     which fits 80 columns; without it the letters are over 100 wide.
try     gothic -h Ahoy
run     clear
wait    1
run     gothic -h Ahoy
wait    6
snap

shot    grep
cap     GNU grep 2.0 searching the disk's own index: -n puts the line number
cap     beside each hit, and -c "" counts the lines.
try     grep -n "chess" DOC/INDEX | head -n 10; grep -c "" DOC/INDEX
os9     grep -n "chess" DOC/INDEX ! head -n 10; grep -c "" DOC/INDEX
run     builtin cd /dd
wait    1
run     clear
wait    1
run     grep -n "chess" DOC/INDEX | head -n 10; grep -c "" DOC/INDEX
wait    10

shot    wns
cap     A windowing search of the disk's own README: every line holding
cap     `GPL', with one line either side, and a dashed line wherever two
cap     windows do not touch.
try     wns -w=1 GPL DOC/README
run     builtin cd /dd
wait    1
run     clear
wait    1
run     wns -w=1 GPL DOC/README
wait    6

shot    agrep
cap     A search that allows two mistakes: `lisense' finds the lines of the
cap     disk's README that spell the word `licence'.
try     agrep -2 lisense DOC/README
run     builtin cd /dd
wait    1
run     clear
wait    1
run     agrep -2 lisense DOC/README
wait    5

shot    sgrep
cap     Substitution from a pattern file.  arr holds a pattern that finds a
cap     comma inside brackets and the text to put back, rescanning each line
cap     until nothing matches, so every A[I,J,K] becomes A[I][J][K].
try     sgrep arr < src
run     /dd/CMDS/rm -rf /dd/tmp/sgcard > /nil 2>/nil
run     /dd/CMDS/mkdir -p /dd/tmp/sgcard
run     builtin cd /dd/tmp/sgcard
run     echo "\[:n+,@r" > arr
run     echo "[?1][" >> arr
run     echo "x = A[I,J,K] + B[N,M]" > src
wait    2
run     clear
wait    1
run     cat arr src
wait    2
run     sgrep arr < src
wait    4

shot    jargon
cap     The Jargon File browser, asked for one entry: -b prints it and
cap     exits.  Run with no options it browses the whole file full-screen,
cap     following the cross-references in braces.  It finds the Jargon File
cap     and its index in VH by itself.
try     jargon -b grok
run     clear
wait    1
run     jargon -b grok
wait    10

shot    lout
cap     Lout's version line. Setting a document needs Lout's include
cap     library, installed where the program looks for it: LOUT2/LIB on /h0,
cap     a path compiled in.
try     lout -V
run     lout -V
wait    6

shot    sort
cap     sort and uniq counting the commonest words in the disk's own
cap     documentation -- a pipeline of five programs, all of them here.
try     sepwords < DOC/README-CIO | sort | uniq -c | sort -nr | head -n 12
os9     sepwords DOC/README-CIO!sort!uniq -c!sort -nr!head -n 12
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sepwords < DOC/README-CIO | sort | uniq -c | sort -nr | head -n 12
wait    12

shot    soundex
cap     soundex reduces each word to its phonetic key -- Robert and Rupert
cap     come out the same, which is the whole idea.  It wants one word to
cap     a line, so sepwords feeds it.
try     echo Robert Rupert Rubin Ashcraft Ashcroft | sepwords | soundex
os9     echo Robert Rupert Rubin Ashcraft Ashcroft!sepwords!soundex
run     echo Robert Rupert Rubin Ashcraft Ashcroft | sepwords | soundex
wait    5

shot    speech
cap     speech turns English spelling into phonemes -- the front half of a
cap     speech synthesiser, with the sound left to the hardware.  It
cap     reads one line typed at it and prints back its phonetic
cap     transcription; a hyphen and a digit are spelled out as words.
try     speech
run     speech
wait    3
send    OS-9 is a real time operating system\r
wait    5

shot    what
cap     what prints the expansion cards fitted to a GEPARD, the German 68k
cap     machine much of the EFFO material was written for: address,
cap     reference byte and name. Without a GEPARD the table comes out empty,
cap     and it ignores anything given to it on the command line.
try     what
run     builtin cd /dd
wait    1
run     clear
wait    1
run     what
wait    8
run     what CMDS/today
wait    8

shot    tformat
cap     The opening of PVIC's own notes refilled to sixty columns, justified
cap     by spreading the spaces; the heading line runs into the paragraph.
try     head -n 12 < DOC/vi/vi.txt | tformat 60
os9     head -n 12 <DOC/vi/vi.txt!tformat 60
run     builtin cd /dd
wait    1
run     clear
wait    1
run     head -n 12 < DOC/vi/vi.txt | tformat 60
wait    8

shot    unip
cap     unip is `unique with page numbers', the last stage of the KWIC index
cap     chain: pageline splits DOC/README-CIO into words, counting 20 lines
cap     to a page, grep keeps the ones starting with a letter, sort orders
cap     them, and unip prints each word once with the pages it appears on.
try     pageline -l=20 DOC/README-CIO | grep "^[a-z]" | sort | unip -i | head -n 18
os9     pageline -l=20 DOC/README-CIO ! grep "^[a-z]" ! sort ! unip -i ! head -n 18
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pageline -l=20 DOC/README-CIO | grep "^[a-z]" | sort | unip -i | head -n 18
wait    14

shot    btop
cap     Twelve bytes of SYS/motd as btop draws them, one grid of O and
cap     middle dots per character; ptob turns the grids back into bytes, and
cap     diff finding nothing to report shows the twelve came back unchanged.
try     btop tmp/b1
run     builtin cd /dd
wait    1
run     cat SYS/motd | head -c 12 > tmp/b1
wait    3
run     clear
wait    1
run     btop tmp/b1
wait    8
run     btop tmp/b1 > tmp/b2
wait    5
run     ptob tmp/b2 > tmp/b3
wait    5
run     diff tmp/b1 tmp/b3
wait    5
run     cat tmp/b3
wait    5
run     rm -f tmp/b1 tmp/b2 tmp/b3
wait    4

shot    hc
cap     hc shifts text to a column, or labels every line.
cap     `+8' indents to column 8, `-11' strips back to column 11, and
cap     `-l' puts a string in front of every line.
try     hc +8 motd
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     cat motd
wait    5
run     hc +8 motd
wait    5
run     hc -11 motd
wait    5
run     hc -l "> " motd
wait    5

# Formatters, fortune tools, comparers, sorters, searchers and the KWIC
# indexers, one stanza per program; each makes what it reads under
# /dd/tmp/TXT.

shot    nroff
size    30 80
cap     nroff setting a short text: a centred title, then paragraphs
cap     filled and justified to the measure.  Its macro sets are in LIB.
try     nroff tmp/TXT/jab.r | head -n 14
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf ".ce\rJABBERWOCKY\r.sp\rTwas brillig, and the slithy toves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r.sp\rBeware the Jabberwock, my son -- the jaws that bite, the claws that catch.\r" > /dd/tmp/TXT/jab.r
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     nroff tmp/TXT/jab.r | head -n 14
wait    10

shot    roff
size    30 80
cap     roff on Jabberwocky: the title centred, the paragraphs filled and
cap     justified to a narrower measure.
try     roff tmp/TXT/jab.r | head -n 14
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf ".ce\rJABBERWOCKY\r.sp\rTwas brillig, and the slithy toves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r.sp\rBeware the Jabberwock, my son -- the jaws that bite, the claws that catch.\r" > /dd/tmp/TXT/jab.r
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     roff tmp/TXT/jab.r | head -n 14
wait    10

shot    proff
size    30 80
cap     Jabberwocky set as justified text.
try     proff tmp/TXT/jab.r | head -n 14
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf ".ce\rJABBERWOCKY\r.sp\rTwas brillig, and the slithy toves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r.sp\rBeware the Jabberwock, my son -- the jaws that bite, the claws that catch.\r" > /dd/tmp/TXT/jab.r
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     proff tmp/TXT/jab.r | head -n 14
wait    10

shot    fmt
cap     Three ragged lines refilled to the default 72 columns, then to 30
cap     with -30.
try     fmt tmp/TXT/rag.txt
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Twas brillig,\rand the slithy\rtoves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r" > /dd/tmp/TXT/rag.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TXT/rag.txt
wait    2
run     fmt tmp/TXT/rag.txt
wait    5
run     fmt -30 tmp/TXT/rag.txt
wait    5

shot    xfmt
cap     The other formatter here.  As well as refilling ragged text it reads
cap     the nroff -man requests a manual page is written in -- so it can set
cap     its own page, which is what it is doing.
try     xfmt -m DOC/xfmt/xfmt.1 | head -n 18
run     builtin cd /dd
wait    1
run     clear
wait    1
run     xfmt -m DOC/xfmt/xfmt.1 | head -n 18
wait    8

shot    strfile
cap     Three sayings indexed into say.dat: strfile counts them and reports
cap     the longest and shortest.
try     strfile tmp/TXT/say
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; rm -f /dd/tmp/TXT/say.dat; printf "A closed mouth gathers no feet.\r%%%%\rThe second mouse gets the cheese.\r%%%%\rNever test for an error you do not know how to handle.\r" > /dd/tmp/TXT/say
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TXT/say
wait    3
run     strfile tmp/TXT/say
wait    5

shot    unstr
cap     Two sayings that strfile made into say.dat, written back out as
cap     plain text. unstr is silent when it succeeds, so cat shows the
cap     result.
try     unstr tmp/TXT/say.dat tmp/TXT/say.out
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; rm -f /dd/tmp/TXT/say.dat /dd/tmp/TXT/say.out; printf "A closed mouth gathers no feet.\r%%%%\rThe second mouse gets the cheese.\r%%%%\r" > /dd/tmp/TXT/say; strfile /dd/tmp/TXT/say > /nil
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     unstr tmp/TXT/say.dat tmp/TXT/say.out
wait    5
run     cat tmp/TXT/say.out
wait    5

shot    cookhash
cap     Builds the hash file the cookie program uses to pick a saying at
cap     random. say holds two sayings, each ended by a %% line.
try     cookhash < tmp/TXT/say > tmp/TXT/say.hash; ls -l tmp/TXT/say.hash
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "A closed mouth gathers no feet.\r%%%%\rThe second mouse gets the cheese.\r%%%%\r" > /dd/tmp/TXT/say
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cookhash < tmp/TXT/say > tmp/TXT/say.hash; ls -l tmp/TXT/say.hash
wait    5

shot    fortune
cap     A fortune at random from the collection in GAMES/FORTUNE, twice.
try     fortune
run     fortune
wait    5
run     fortune
wait    5

shot    ediff
cap     Puts diff's output into plain English: which lines changed, from
cap     what to what, and what was added.
try     diff tmp/TXT/a tmp/TXT/b | ediff
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "apple\rbanana\rcherry\rdate\r" > /dd/tmp/TXT/a; printf "apple\rblueberry\rcherry\rdate\relder\r" > /dd/tmp/TXT/b
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     diff tmp/TXT/a tmp/TXT/b | ediff
wait    6

shot    spiff
cap     spiff compares two files and reports the differences in diff's
cap     shape, but reads numbers as numbers: 1.0 and 1.00 are the same to
cap     it, so only the changed count is reported.
try     cat tmp/TXT/s1 tmp/TXT/s2; spiff tmp/TXT/s1 tmp/TXT/s2
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "total 1.0\rcount 10\r" > /dd/tmp/TXT/s1; printf "total 1.00\rcount 11\r" > /dd/tmp/TXT/s2
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TXT/s1 tmp/TXT/s2; spiff tmp/TXT/s1 tmp/TXT/s2
wait    8

shot    uniq
cap     Drops repeated adjacent lines; after a sort, -c counts each.
try     uniq < tmp/TXT/dups; sort tmp/TXT/dups | uniq -c
os9     uniq <tmp/TXT/dups; sort tmp/TXT/dups ! uniq -c
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "pear\rapple\rpear\rfig\rfig\rfig\rapple\r" > /dd/tmp/TXT/dups
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     uniq < tmp/TXT/dups; sort tmp/TXT/dups | uniq -c
wait    9

shot    nsort
cap     The seven lines, then nsort's order: lexical, duplicates kept.
try     cat tmp/TXT/dups; echo ---; nsort < tmp/TXT/dups
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "pear\rapple\rpear\rfig\rfig\rfig\rapple\r" > /dd/tmp/TXT/dups
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TXT/dups; echo ---; nsort < tmp/TXT/dups
wait    5

shot    qsort9
cap     Sorts seven lines by quicksort, duplicates kept.
try     qsort9 < tmp/TXT/dups
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "pear\rapple\rpear\rfig\rfig\rfig\rapple\r" > /dd/tmp/TXT/dups
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     qsort9 < tmp/TXT/dups
wait    5

shot    join
cap     Joins two files on a common first field, the way a database
cap     joins tables: name and colour from one, name and count from the
cap     other.
try     join tmp/TXT/j1 tmp/TXT/j2
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "apple red\rfig purple\rpear green\r" > /dd/tmp/TXT/j1; printf "apple 3\rfig 12\rpear 7\r" > /dd/tmp/TXT/j2
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     join tmp/TXT/j1 tmp/TXT/j2
wait    5

shot    ggrep
cap     GNU grep, with line numbers.
try     ggrep -n USR password
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     ggrep -n USR password
wait    5

shot    bmgtest
cap     A demonstration of the Boyer-Moore-Gosper search that bmg is built
cap     on: given a pattern and a file it prints every line that matches,
cap     streaming through the file rather than reading it whole. A word that
cap     is there, one that is not -- the exit status is 0 either way, so it
cap     does not signal a miss -- and the same search on standard input.
try     bmgtest OS-9 SYS/motd
run     builtin cd /dd
wait    1
run     clear
wait    1
run     bmgtest OS-9 SYS/motd; echo "status $?"
wait    4
run     bmgtest nosuchword SYS/motd; echo "status $?"
wait    4
run     bmgtest OS-9 < SYS/motd
wait    4

shot    bmgtest2
cap     The other Boyer-Moore-Gosper demonstration: the same search, but it
cap     reads the whole file into memory first rather than streaming through
cap     it. The exit status is 0 for a miss as well as a hit.
try     bmgtest2 OS-9 SYS/motd
run     builtin cd /dd
wait    1
run     clear
wait    1
run     bmgtest2 OS-9 SYS/motd; echo "status $?"
wait    4
run     bmgtest2 nosuchword SYS/motd; echo "status $?"
wait    4
run     bmgtest2 OS-9 < SYS/motd
wait    4

shot    pagekwic
size    36 80
cap     It slides a window of -f words along the text and prints each
cap     rotation of it, with the page number: here three words at a time
cap     over the first verse of Jabberwocky.
try     pagekwic -f=3 < DOC/samples/jabber.txt | head -n 14
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pagekwic -f=3 < DOC/samples/jabber.txt | head -n 14
wait    6

shot    pagefraz
size    36 80
cap     Four book titles, in tmp/TXT/titles, broken into the four-word
cap     phrases an index would list, each with its page number.
try     pagefraz < tmp/TXT/titles
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "The Art of Computer Programming\rStructured Programming\rThe C Programming Language\rThe Mythical Man-Month\r" > /dd/tmp/TXT/titles
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pagefraz < tmp/TXT/titles
wait    8

shot    pageline
cap     Four book titles split into one word per line, each with its page
cap     number. The last word comes out without its number: pageline writes
cap     a word's number only when the next word begins.
try     pageline < tmp/TXT/titles
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "The Art of Computer Programming\rStructured Programming\rThe C Programming Language\rThe Mythical Man-Month\r" > /dd/tmp/TXT/titles
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pageline < tmp/TXT/titles
wait    8

shot    ispell
cap     ispell reading a line of Jabberwocky and naming the words its
cap     dictionary does not hold, one to a line.
try     ispell -l tmp/TXT/spell.txt
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Twas brilig and the slithy tovs did gyre and gimble in the wabe.\r" > /dd/tmp/TXT/spell.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ispell -l tmp/TXT/spell.txt
wait    12

shot    buildhash
cap     Builds ispell's hash table from a word list.  It reads `dict.191'
cap     by bare name from the directory you are standing in, and the
cap     dictionary it wants ships in SRC/ispell -- so stand somewhere with
cap     a copy and it counts the words, then writes `count.191' and the
cap     `stats.191' below, which is how many words hash to each bucket.
try     buildhash
run     rm -rf /dd/tmp/ISPB > /nil 2>/nil; mkdir -p /dd/tmp/ISPB
wait    3
run     cp /dd/SRC/ispell/dict.191 /dd/tmp/ISPB/dict.191
wait    4
run     builtin cd /dd/tmp/ISPB
wait    1
run     clear
wait    1
run     buildhash
wait    30
run     cat count.191; head stats.191
wait    5

shot    makelex
cap     Turns sonnet's word list into a C array, one dictionary entry
cap     per line: a word and three codes for its rhythm, stress and
cap     sound, out of which it prints the C initialiser.
try     makelex < tmp/TXT/wl
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Allah:TF:SO:0\rBMW:TDF:SU:0\rBabylon:HIF:SO:n\r" > /dd/tmp/TXT/wl
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     makelex < tmp/TXT/wl
wait    6

shot    fgrep
cap     Searches for a fixed string rather than a pattern: the lines of
cap     the password file naming a home under USR.
try     fgrep -n USR password
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     fgrep -n USR password
wait    5

shot    choose
size    24 80
cap     Three of the seven days picked at random, printed in the order they
cap     stand in the file.  With no number choose picks one.
try     choose -3 tmp/TXT/week.txt
os9     choose -3 tmp/TXT/week.txt
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Monday\rTuesday\rWednesday\rThursday\rFriday\rSaturday\rSunday\r" > /dd/tmp/TXT/week.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     choose -3 tmp/TXT/week.txt
wait    3

shot    anagram
size    24 80
cap     Every word in the disk's word list made of exactly the letters given:
cap     four for listen, and for parsley only parsley itself.
try     anagram listen parsley
run     clear
wait    1
run     anagram listen parsley
wait    6

shot    soelim
size    24 80
cap     A roff file that includes another with .so, and the same file after
cap     soelim has put the included text in the .so line's place.
try     cat tmp/TXT/main.r; soelim tmp/TXT/main.r
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf ".TH NOTE 1\r.so tmp/TXT/part.r\rThe last line of main.r.\r" > /dd/tmp/TXT/main.r
run     printf "This line lives in part.r.\r" > /dd/tmp/TXT/part.r
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TXT/main.r; soelim tmp/TXT/main.r
wait    3

shot    ag
size    24 80
cap     Every phrase the disk's word list makes from the letters of dirty room,
cap     dormitory among them.
try     ag "dirty room"
run     clear
wait    1
run     ag "dirty room"
wait    6
