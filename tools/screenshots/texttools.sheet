# The filters, each one on real text off this disk.

shot    bm
cap     bm, a Boyer-Moore grep, and fgrep beside it -- both older and
cap     faster than the GNU one, and both still here.
try     bm cribbage DOC/INDEX
run     builtin cd /dd
wait    1
run     clear
wait    1
run     bm cribbage DOC/INDEX
wait    4
run     fgrep cribbage DOC/INDEX
wait    4

shot    cdiff
cap     cdiff, an older context diff, comparing a holiday list against a
cap     copy with one word changed.  Its own shape: a line number and
cap     what it changed from and to, closed off with a line saying so.
try     cdiff tmp/h1 tmp/h2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     head -n 3 SYS/holidays > tmp/h1 2>/nil
wait    3
run     sed -e "s/Day/DAY/" tmp/h1 > tmp/h2
wait    4
run     cdiff tmp/h1 tmp/h2
wait    6

shot    cookie
cap     cookie, the fortune-cookie program, reading the collection's own
cap     sayings file.
try     cookie
run     cookie
wait    2
run     cookie
wait    3

shot    cursive
cap     cursive writes the word you give it as a single line of joined,
cap     sloping script, the kind of flourish people once signed email
cap     with.
try     cursive Freeware
run     cursive Freeware
wait    6

shot    diff
cap     GNU diff 1.1 on two versions of the same file, in context form:
cap     the changed line marked with `!' in each.
try     diff -c tmp/a.txt tmp/b.txt
run     builtin cd /dd
wait    1
run     clear
wait    1
run     head -n 12 SYS/motd > tmp/a.txt 2>/nil
wait    2
run     sed -e "s/OS-9/OS-Nine/" tmp/a.txt > tmp/b.txt
wait    3
run     diff -c tmp/a.txt tmp/b.txt
wait    5

shot    diff_1.1
cap     A second build of GNU diff 1.1.  Two short lists that differ on one
cap     line: diff_1.1 reports the change, pear becoming peach.
try     diff_1.1 tmp/BLGX/d1 tmp/BLGX/d2
run     mkdir -p /dd/tmp/BLGX > /nil 2>/nil
run     printf 'apple\rpear\rplum\r' > /dd/tmp/BLGX/d1
run     printf 'apple\rpeach\rplum\r' > /dd/tmp/BLGX/d2
run     builtin cd /dd
wait    1
run     clear
run     diff_1.1 tmp/BLGX/d1 tmp/BLGX/d2
wait    5

shot    deton
cap     deton is a demonstration of timing out a read with an alarm, not
cap     a tool in its own right.  Given nothing to read within three
cap     seconds it announces self-destruct and then, having read no
cap     password, sets it off -- all in words; nothing is actually at
cap     risk.
try     deton < /nil
os9     deton</nil
run     deton < /nil
wait    8

shot    fcomp
cap     fcomp compares two text files line by line and names what
cap     changed between them -- here, a line inserted at the end.
try     fcomp tmp/fc1 tmp/fc2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "alpha" > tmp/fc1
wait    4
run     echo "bravo" >> tmp/fc1
wait    4
run     cp tmp/fc1 tmp/fc2
wait    4
run     echo "charlie" >> tmp/fc2
wait    4
run     fcomp tmp/fc1 tmp/fc2
wait    6

shot    gothic
size    272 96
cap     Sets a word in fraktur capitals, each letter drawn large down the
cap     screen, for a title page or a poster.  `-h' draws it at half size
cap     to fit a short terminal.
try     gothic OS-9
run     gothic OS-9
wait    6
snap

shot    grep
cap     GNU grep 2.0 searching the disk's own index, with the count beside
cap     the hits.
try     grep -n "chess" DOC/INDEX
run     builtin cd /dd
wait    1
run     clear
wait    1
run     grep -n "chess" DOC/INDEX | head -n 10
wait    6
run     grep -c "" DOC/INDEX
wait    4

shot    wns
cap     A windowing search of the disk's own README: every line holding
cap     `GPL', with one line either side, and a dashed line wherever two
cap     windows do not touch.
try     wns -w=1 GPL DOC/README
run     builtin cd /dd
wait    1
run     clear
wait    1
run     wns -w=1 GPL DOC/README
wait    6

shot    agrep
cap     A search that allows two mistakes: `lisense' finds the lines of the
cap     disk's README that spell the word `licence'.
try     agrep -2 lisense DOC/README
run     builtin cd /dd
wait    1
run     clear
wait    1
run     agrep -2 lisense DOC/README
wait    5

shot    sgrep
cap     Substitution from a pattern file.  arr holds a pattern that finds a
cap     comma inside brackets and the text to put back, rescanning each line
cap     until nothing matches, so every A[I,J,K] becomes A[I][J][K].
try     sgrep arr < src
run     /dd/CMDS/rm -rf /dd/tmp/sgcard > /nil 2>/nil
run     /dd/CMDS/mkdir -p /dd/tmp/sgcard
run     builtin cd /dd/tmp/sgcard
run     echo "\[:n+,@r" > arr
run     echo "[?1][" >> arr
run     echo "x = A[I,J,K] + B[N,M]" > src
wait    2
run     clear
wait    1
run     cat arr src
wait    2
run     sgrep arr < src
wait    4

shot    jargon
cap     The Jargon File browser, jumping straight to the entry for
cap     kluge.  It reads jargon.txt and jargon.idx from the VH
cap     directory on its own; give it a document by name and it looks
cap     for that instead.
try     jargon -b kluge jargon
run     jargon -b kluge jargon
wait    10

shot    lout
cap     Basser Lout 2.05, a document formatter in the TeX tradition,
cap     saying what it is.  Setting a document needs Lout's own include
cap     library beside it; the version line is what it prints alone.
try     lout -V
run     lout -V
wait    6

shot    sort
cap     sort and uniq counting the commonest words in the disk's own
cap     documentation -- a pipeline of five programs, all of them here.
try     sepwords < DOC/README-CIO | sort | uniq -c | sort -nr | head -n 12
os9     sepwords DOC/README-CIO!sort!uniq -c!sort -nr!head -n 12
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sepwords < DOC/README-CIO | sort | uniq -c | sort -nr | head -n 12
wait    12

shot    soundex
cap     soundex reduces each word to its phonetic key -- Robert and Rupert
cap     come out the same, which is the whole idea.  It wants one word to
cap     a line, so sepwords feeds it.
try     echo Robert Rupert Rubin Ashcraft Ashcroft | sepwords | soundex
os9     echo Robert Rupert Rubin Ashcraft Ashcroft!sepwords!soundex
run     echo Robert Rupert Rubin Ashcraft Ashcroft | sepwords | soundex
wait    5

shot    speech
cap     speech turns English spelling into phonemes -- the front half of a
cap     speech synthesiser, with the sound left to the hardware.  It
cap     reads one line typed at it and prints back its phonetic
cap     transcription; a hyphen and a digit are spelled out as words.
try     speech
run     speech
wait    3
send    OS-9 is a real time operating system\r
wait    5

shot    what
cap     what prints the expansion cards fitted to a GEPARD, the German 68k
cap     machine much of the EFFO material was written for: address,
cap     reference byte and name.  With no GEPARD underneath it the table
cap     comes out empty, and it ignores anything given to it on the command
cap     line.
try     what
run     builtin cd /dd
wait    1
run     clear
wait    1
run     what
wait    8
run     what CMDS/today
wait    8

shot    tformat
cap     README-KEEP set as justified text: the ragged original refilled
cap     into even lines.
try     cat DOC/README-KEEP | head -n 24 | tformat
os9     cat DOC/README-KEEP!head -n 24!tformat
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat DOC/README-KEEP | head -n 24 | tformat
wait    8

shot    unip
cap     unip is `unique with page numbers' -- the last stage of the index
cap     chain that starts with sepwords: split a document into words, sort
cap     them, and print each one once with the pages it appeared on.  The
cap     page column is empty here because nothing upstream paginated the
cap     text; what is left is the vocabulary of the file, in order.
try     sepwords < DOC/README-CIO | sort | unip | head -n 18
os9     sepwords DOC/README-CIO!sort!unip!head -n 18
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sepwords < DOC/README-CIO | sort | unip | head -n 18
wait    10

shot    btop
cap     btop turns each character of a file into a grid of O and space --
cap     how a font or a bitmap moved through a mail system that would only
cap     carry text, long before uuencode.  ptob turns the grid back into
cap     bytes; diff finding nothing to report is the proof the twelve
cap     bytes came back unchanged.
try     btop tmp/b1
run     builtin cd /dd
wait    1
run     cat SYS/motd | head -c 12 > tmp/b1
wait    3
run     clear
wait    1
run     btop tmp/b1
wait    8
run     btop tmp/b1 > tmp/b2
wait    5
run     ptob tmp/b2 > tmp/b3
wait    5
run     diff tmp/b1 tmp/b3
wait    5
run     cat tmp/b3
wait    5
run     rm -f tmp/b1 tmp/b2 tmp/b3
wait    4

shot    hc
cap     hc shifts text to a column, or labels every line.
cap     `+8' indents to column 8, `-11' strips back to column 11, and
cap     `-l' puts a string in front of every line.
try     hc +8 motd
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     cat motd
wait    5
run     hc +8 motd
wait    5
run     hc -11 motd
wait    5
run     hc -l "> " motd
wait    5

# Formatters, fortune tools, comparers, sorters, searchers and the KWIC
# indexers, one stanza per program; each makes what it reads under
# /dd/tmp/TXT.

shot    nroff
size    30 80
cap     nroff setting a short text: a centred title, then paragraphs
cap     filled and justified to the measure.  Its macro sets are in LIB.
try     nroff tmp/TXT/jab.r | head -n 14
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf ".ce\rJABBERWOCKY\r.sp\rTwas brillig, and the slithy toves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r.sp\rBeware the Jabberwock, my son -- the jaws that bite, the claws that catch.\r" > /dd/tmp/TXT/jab.r
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     nroff tmp/TXT/jab.r | head -n 14
wait    10

shot    roff
size    30 80
cap     roff, the older formatter, on the same text: title centred, the
cap     paragraph filled and justified to a narrower measure.
try     roff tmp/TXT/jab.r | head -n 14
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf ".ce\rJABBERWOCKY\r.sp\rTwas brillig, and the slithy toves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r.sp\rBeware the Jabberwock, my son -- the jaws that bite, the claws that catch.\r" > /dd/tmp/TXT/jab.r
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     roff tmp/TXT/jab.r | head -n 14
wait    10

shot    proff
size    30 80
cap     Jabberwocky set as justified text.
try     proff tmp/TXT/jab.r | head -n 14
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf ".ce\rJABBERWOCKY\r.sp\rTwas brillig, and the slithy toves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r.sp\rBeware the Jabberwock, my son -- the jaws that bite, the claws that catch.\r" > /dd/tmp/TXT/jab.r
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     proff tmp/TXT/jab.r | head -n 14
wait    10

shot    fmt
cap     Refills ragged text into even lines, to 72 columns or to a width
cap     given as -<n>.
try     fmt tmp/TXT/rag.txt
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Twas brillig,\rand the slithy\rtoves did gyre and gimble in the wabe: all mimsy were the borogoves, and the mome raths outgrabe.\r" > /dd/tmp/TXT/rag.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TXT/rag.txt
wait    2
run     fmt tmp/TXT/rag.txt
wait    5
run     fmt -30 tmp/TXT/rag.txt
wait    5

shot    strfile
cap     Turns a file of sayings separated by %% lines into the indexed
cap     .dat file fortune reads, and reports what it found.
try     strfile tmp/TXT/say
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; rm -f /dd/tmp/TXT/say.dat; printf "A closed mouth gathers no feet.\r%%%%\rThe second mouse gets the cheese.\r%%%%\rNever test for an error you do not know how to handle.\r%%%%\r" > /dd/tmp/TXT/say
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TXT/say
wait    3
run     strfile tmp/TXT/say
wait    5

shot    unstr
cap     unstr is strfile's reverse: given the .dat file, and a name for
cap     the result, it writes the sayings back out as plain text --
cap     silently, if it succeeds, so the real proof is in the file it
cap     wrote.
try     unstr tmp/TXT/say.dat tmp/TXT/say.out
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; rm -f /dd/tmp/TXT/say.dat /dd/tmp/TXT/say.out; printf "A closed mouth gathers no feet.\r%%%%\rThe second mouse gets the cheese.\r%%%%\r" > /dd/tmp/TXT/say; strfile /dd/tmp/TXT/say > /nil
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     unstr tmp/TXT/say.dat tmp/TXT/say.out
wait    5
run     cat tmp/TXT/say.out
wait    5

shot    cookhash
cap     Builds the hash file the cookie program uses to pick a saying
cap     at random from a file of them.
try     cookhash < tmp/TXT/say > tmp/TXT/say.hash
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "A closed mouth gathers no feet.\r%%%%\rThe second mouse gets the cheese.\r%%%%\r" > /dd/tmp/TXT/say
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cookhash < tmp/TXT/say > tmp/TXT/say.hash; ls -l tmp/TXT/say.hash
wait    5

shot    fortune
cap     A fortune at random from the collection in GAMES/FORTUNE, twice.
try     fortune
run     fortune
wait    5
run     fortune
wait    5

shot    ediff
cap     Puts diff's output into plain English: which lines changed, from
cap     what to what, and what was added.
try     diff tmp/TXT/a tmp/TXT/b | ediff
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "apple\rbanana\rcherry\rdate\r" > /dd/tmp/TXT/a; printf "apple\rblueberry\rcherry\rdate\relder\r" > /dd/tmp/TXT/b
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     diff tmp/TXT/a tmp/TXT/b | ediff
wait    6

shot    spiff
cap     spiff compares two files and reports the differences in diff's
cap     shape: a changed line and an added one.
try     spiff tmp/TXT/a tmp/TXT/b
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "apple\rbanana\rcherry\rdate\r" > /dd/tmp/TXT/a; printf "apple\rblueberry\rcherry\rdate\relder\r" > /dd/tmp/TXT/b
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     spiff tmp/TXT/a tmp/TXT/b
wait    6

shot    uniq
cap     Drops repeated adjacent lines; after a sort, -c counts each.
try     uniq < tmp/TXT/dups
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "pear\rapple\rpear\rfig\rfig\rfig\rapple\r" > /dd/tmp/TXT/dups
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     uniq < tmp/TXT/dups
wait    4
run     sort tmp/TXT/dups | uniq -c
wait    5

shot    nsort
cap     A sort filter: the same seven lines, lexical order, duplicates
cap     kept.
try     cat tmp/TXT/dups; echo ---; nsort < tmp/TXT/dups
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "pear\rapple\rpear\rfig\rfig\rfig\rapple\r" > /dd/tmp/TXT/dups
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/TXT/dups; echo ---; nsort < tmp/TXT/dups
wait    5

shot    qsort9
cap     Another sort filter, by quicksort, on the same seven lines.
try     qsort9 < tmp/TXT/dups
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "pear\rapple\rpear\rfig\rfig\rfig\rapple\r" > /dd/tmp/TXT/dups
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     qsort9 < tmp/TXT/dups
wait    5

shot    join
cap     Joins two files on a common first field, the way a database
cap     joins tables: name and colour from one, name and count from the
cap     other.
try     join tmp/TXT/j1 tmp/TXT/j2
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "apple red\rfig purple\rpear green\r" > /dd/tmp/TXT/j1; printf "apple 3\rfig 12\rpear 7\r" > /dd/tmp/TXT/j2
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     join tmp/TXT/j1 tmp/TXT/j2
wait    5

shot    ggrep
cap     GNU grep, with line numbers.
try     ggrep -n USR password
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     ggrep -n USR password
wait    5

shot    bmgtest
cap     A demonstration program for the Boyer-Moore-Gosper search bm is
cap     built on: given a pattern and a file, it prints every matching
cap     line, streaming through the file rather than loading it whole.
try     bmgtest the SYS/motd
run     builtin cd /dd
wait    1
run     clear
wait    1
run     bmgtest the SYS/motd; echo "status $?"
wait    5

shot    bmgtest2
cap     The other Boyer-Moore-Gosper demonstration: the same search, but
cap     it reads the whole file into memory first rather than streaming
cap     through it.
try     bmgtest2 the SYS/motd
run     builtin cd /dd
wait    1
run     clear
wait    1
run     bmgtest2 the SYS/motd; echo "status $?"
wait    5

shot    pagekwic
size    36 80
cap     A PHRASE keyword-in-context index, not a line-by-line one: it
cap     slides a window of `-f' words along the text and prints every
cap     rotation of each window, so a phrase may span a line break.  That
cap     is the design -- its own source calls it a phrase utility -- so
cap     give it continuous prose rather than a list.  Here, three words
cap     at a time over the first verse of Jabberwocky.
try     pagekwic -f=3 < DOC/samples/jabber.txt | head -n 14
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pagekwic -f=3 < DOC/samples/jabber.txt | head -n 14
wait    6

shot    pagefraz
size    36 80
cap     The phrase index of the same set: each title broken into the
cap     phrases an index would list.
try     pagefraz < tmp/TXT/titles
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "The Art of Computer Programming\rStructured Programming\rThe C Programming Language\rThe Mythical Man-Month\r" > /dd/tmp/TXT/titles
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pagefraz < tmp/TXT/titles
wait    8

shot    pageline
cap     Numbers the lines of the same set for the index to refer to.
try     pageline < tmp/TXT/titles
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "The Art of Computer Programming\rStructured Programming\rThe C Programming Language\rThe Mythical Man-Month\r" > /dd/tmp/TXT/titles
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pageline < tmp/TXT/titles
wait    8

shot    ispell
cap     This build of ispell lists every word of the line as unknown, correct
cap     ones too, and stops with a bus error at its first dictionary lookup.
cap     REBUILT/ispell_rebuilt is the edition DOC/ispell describes, and works.
try     ispell -l tmp/TXT/spell.txt
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Twas brilig and the slithy tovs did gyre and gimble in the wabe.\r" > /dd/tmp/TXT/spell.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ispell -l tmp/TXT/spell.txt
wait    12

shot    ispell_rebuilt
cap     The words the dictionary does not hold, one to a line: -l reads the
cap     text on standard input and skips lines that are formatter commands.
try     ispell_rebuilt -l < tmp/TXT/spell2.txt
os9     ispell_rebuilt -l <tmp/TXT/spell2.txt
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Twas brilig and the slithy tovs did gyre and gimble in the wabe.\r" > /dd/tmp/TXT/spell2.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ispell_rebuilt -l < tmp/TXT/spell2.txt
wait    8

shot    buildhash
cap     Builds ispell's hashed dictionary from a word list and an affix
cap     file; without the word list it says which one it wants.
try     buildhash
run     buildhash
wait    6

shot    makelex
cap     Turns sonnet's word list into a C array, one dictionary entry
cap     per line: a word and three codes for its rhythm, stress and
cap     sound, out of which it prints the C initialiser.
try     makelex < tmp/TXT/wl
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Allah:TF:SO:0\rBMW:TDF:SU:0\rBabylon:HIF:SO:n\r" > /dd/tmp/TXT/wl
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     makelex < tmp/TXT/wl
wait    6

shot    fgrep
cap     Searches for a fixed string rather than a pattern: the lines of
cap     the password file naming a home under USR.
try     fgrep -n USR password
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     fgrep -n USR password
wait    5

shot    choose
size    24 80
cap     Three of the seven days picked at random, printed in the order they
cap     stand in the file.  With no number choose picks one.
try     choose -3 tmp/TXT/week.txt
os9     choose -3 tmp/TXT/week.txt
run     mkdir -p /dd/tmp/TXT > /nil 2>/nil; printf "Monday\rTuesday\rWednesday\rThursday\rFriday\rSaturday\rSunday\r" > /dd/tmp/TXT/week.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     choose -3 tmp/TXT/week.txt
wait    3

shot    anagram
size    24 80
cap     Every word in the disk's word list made of exactly the letters given:
cap     four for listen, and for parsley only parsley itself.
try     anagram listen parsley
run     clear
wait    1
run     anagram listen parsley
wait    6
