# Shells and the small programs written for shell scripts, one stanza
# per program.

shot    bash
cap     The shell a login on this disk hands you: GNU bash 1.12.  Its
cap     version, an arithmetic expansion, a loop.
run     bash -c "echo bash $BASH_VERSION, running a one-line script"
wait    4
run     echo $((355/113)) $((7*6))
wait    3
run     for f in one two three; do echo "item $f"; done
wait    4
try     bash -c "echo bash $BASH_VERSION, running a one-line script"

shot    sh
cap     An sh-like shell, version 2.1 edition 75, running as a program under
cap     bash: its own `%' prompt, and a real chd that moves the data
cap     directory, as pwd shows.
run     sh
wait    4
send    echo hello from sh\r
wait    3
send    chd /dd/SYS; pwd\r
wait    3
send    exit\r
wait    3
try     sh

shot    ksh
cap     pd-ksh, the Korn shell, running a three-line script from its
cap     standard input, then a one-line command given with -c.
run     mkdir -p /dd/tmp/SHL > /nil 2>/nil; printf "print hello from a ksh script\rfor f in a b c; do print item \$f; done\r" > /dd/tmp/SHL/script.ksh
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/SHL/script.ksh
wait    2
run     ksh < tmp/SHL/script.ksh
wait    5
run     ksh -c "print the date is; today"
wait    5
try     ksh < tmp/SHL/script.ksh
os9     ksh <tmp/SHL/script.ksh

shot    gshell
cap     GSHELL, a menu in place of a command line, started in SYS: the
cap     directory as a lettered list, + and - to page, . to change
cap     directory, a letter to run that file.
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     gshell
wait    6
snap
send    \003
wait    2
try     gshell

shot    mshell
cap     A menu shell: it reads a file of `label| command' lines, shows the
cap     labels numbered, and a number runs that entry's command through
cap     `shell' -- your own OS-9's, which SYS/login loads from /h1 -- then
cap     waits for RETURN and draws the menu again.  Here the sample menu's
cap     third entry, `This month', has run `cal'.  Control-C leaves.
try     mshell DOC/samples/menu
run     load /h1/CMDS/shell
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     mshell DOC/samples/menu
wait    5
send    3\r
wait    6
snap
send    \003
wait    2

shot    env
cap     Runs a command with a variable added to its environment: here
cap     printenv, which shows the variable arriving.
run     env FOO=bar printenv | grep FOO
wait    5
try     env FOO=bar printenv | grep FOO
os9     env FOO=bar printenv ! grep FOO

shot    printenv
cap     The environment SYS/login sets up: HOME, PATH, TERM, TERMCAP, USER
cap     and the rest, with what bash adds of its own.
run     printenv
wait    5
try     printenv

shot    getenv
cap     Reads one environment variable back: -p prints it with a newline,
cap     -l without one, -x makes it the exit status.  Its messages are in
cap     German.
run     getenv -p TERM
wait    3
run     getenv -p HOME
wait    3
try     getenv -p TERM

shot    checkenv
cap     TERM against its own value, then against another: status 0 for the
cap     match, 1 for the difference.  Named alone, it answers 0 when the
cap     variable is not set.  The comma in its own syntax line is not
cap     typed -- given one, it prints that line and returns 0.
run     checkenv TERM xterm-256color; echo "status $?"
wait    4
run     checkenv TERM vt100; echo "status $?"
wait    4
try     checkenv TERM xterm-256color; echo "status $?"
os9     checkenv TERM xterm-256color

shot    exist
cap     One name that exists and one that does not: 0 for the first, 1 for
cap     the second.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     exist SYS/motd; echo "exist says $?"
wait    4
run     exist SYS/no-such-file; echo "exist says $?"
wait    4
try     exist SYS/motd; echo "exist says $?"
os9     exist SYS/motd

shot    strcmp
cap     Mississippi contains ssiss (0, true) and does not begin with sipp
cap     (1, false); `-p' prints the answer as well as returning it.
try     strcmp -p Mississippi ct ssiss; strcmp -p Mississippi bw sipp
os9     strcmp -p Mississippi ct ssiss; strcmp -p Mississippi bw sipp
run     builtin cd /dd
wait    1
run     clear
wait    1
run     strcmp -p Mississippi ct ssiss; strcmp -p Mississippi bw sipp
wait    4

shot    expr
cap     Division that truncates (355/113 is 3), a `*' escaped from the
cap     shell, and `length' counting the characters of a string.
run     expr 355 / 113
wait    3
run     expr 6 \* 7 + 1
wait    3
run     expr length "OS-9/68000"
wait    3
try     expr 355 / 113

shot    if
cap     TERM is defined, so the first runs whoami; no module `nosuch' is
cap     loaded, so the second runs its `else', today.  It hands the chosen
cap     commands to your own OS-9's `shell'.  bash has an `if' of its own,
cap     a reserved word; `command if' reaches this one.
run     load /h1/CMDS/shell
wait    3
run     clear
wait    1
run     command if def TERM whoami endif
wait    5
run     command if loaded nosuch whoami else today endif
wait    5
try     command if def TERM whoami endif
os9     if def TERM whoami endif

shot    qp
cap     The output of the back-quoted command takes its place in the
cap     command line: here `cat list' names a file and wc counts it.
cap     Quoted, so that the shell leaves the back-quotes to qp.
try     qp wc -c '`cat list`'
run     rm -rf /dd/tmp/QPC > /nil 2>/nil; mkdir -p /dd/tmp/QPC; echo "/dd/SYS/motd" > /dd/tmp/QPC/list
wait    2
run     builtin cd /dd/tmp/QPC
wait    1
run     clear
wait    1
run     cat list
wait    2
run     qp wc -c '`cat list`'
wait    4

shot    xc
cap     Runs the commands marked in a file and leaves the rest alone, so
cap     the build line of a program can live in a comment in its source.
cap     A line starting `% ' is shown and run, one starting `$ ' is run
cap     quietly, and anything else is notes.  It hands each one to `shell',
cap     your own OS-9's, which SYS/login loads from /h1.
run     load /h1/CMDS/shell
wait    3
run     mkdir -p /dd/tmp/SHL > /nil 2>/nil; printf "notes to myself\r%% whoami\r$ wc -l SYS/motd\rmore notes\r" > /dd/tmp/SHL/cmds.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/SHL/cmds.txt
wait    2
run     xc tmp/SHL/cmds.txt
wait    5
try     xc tmp/SHL/cmds.txt

shot    run
cap     Runs a program with its input and output rebound to the terminal
cap     that PORT names -- for a program started from somewhere else.  Here
cap     PORT is the console, so the listing comes straight back.  It hands
cap     the command to your own OS-9's `shell', which SYS/login loads from
cap     /h1.
run     load /h1/CMDS/shell
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     export PORT=/term; run "ls SYS"
wait    6
try     export PORT=/term; run "ls SYS"
os9     setenv PORT /term; run "ls SYS"

shot    hist
cap     A command-line editor with C-shell-style history, in front of
cap     Microware's shell: cursor movement, word and line deletion, and
cap     command recall; `h' lists what you typed and `logout' leaves.
cap     It runs every command through your own OS-9's `shell' and sets the
cap     line up with its `tmode', both loaded from /h1, and keeps its
cap     history on the RAM disk /r0 unless you name a file.  Each answer
cap     starts on the line it was typed on: hist's own line feed after
cap     RETURN is a printf to an unbuffered stdout, which this C library
cap     does not write.
try     hist
run     load /h1/CMDS/shell /h1/CMDS/tmode
wait    3
run     mount -r=256k /r0
wait    3
run     clear
wait    1
run     hist
wait    3
send    whoami\r
wait    4
send    today\r
wait    5
snap
send    logout\r
wait    2

shot    printf
cap     A string left-justified in 8 columns, a number right-justified in 5,
cap     and pi rounded to two places in 6.
run     printf "%-8s|%5d|%6.2f\n" apples 12 3.14159
wait    4
try     printf "%-8s|%5d|%6.2f\n" apples 12 3.14159

shot    whoami
cap     Who you are: the user number the process runs as, looked up in
cap     SYS/password -- tester here. $USER agrees, but it is only what the
cap     login set.
run     whoami
wait    3
run     echo "USER is $USER"
wait    3
try     whoami

shot    logname
cap     Your login name, looked up the same way as whoami.
run     logname
wait    3
run     echo "logged in as $(logname), user $USER"
wait    3
try     logname

shot    su
cap     GNU su becomes another user from the password file and runs a
cap     command as them: here `tester', asked who it is.  It starts that
cap     user's shell, your own OS-9's, which SYS/login loads from /h1.
run     load /h1/CMDS/shell
wait    3
run     clear
wait    1
run     su tester whoami
wait    5
try     su tester whoami

shot    submit
size    20 80
cap     demo.sub holds three commands; each is printed, then its output.
cap     Your own OS-9's shell has to be resident, as SYS/login leaves it.
try     submit demo
run     rm -rf /dd/tmp/SUBA > /nil 2>/nil; mkdir -p /dd/tmp/SUBA
wait    2
run     load /h1/CMDS/shell
wait    3
run     cat /dd/DOC/samples/jabber.txt > /dd/tmp/SUBA/poem
wait    2
run     echo "wc poem" > /dd/tmp/SUBA/demo.sub
wait    1
run     echo "md5 poem" >> /dd/tmp/SUBA/demo.sub
wait    1
run     echo "head -n 2 poem" >> /dd/tmp/SUBA/demo.sub
wait    1
run     builtin cd /dd/tmp/SUBA
wait    1
run     clear
wait    1
run     submit demo
wait    8

shot    xargs
size    16 80
cap     Turns what it reads into arguments for a command: the names arrive
cap     on the command line rather than on standard input, which is what a
cap     program like wc needs to count them separately.
try     ls | xargs wc -l
os9     ls ! xargs wc -l
run     rm -rf /dd/tmp/XARG > /nil 2>/nil; mkdir -p /dd/tmp/XARG
run     printf "alpha\rbeta\r" > /dd/tmp/XARG/one; printf "gamma\r" > /dd/tmp/XARG/two
run     builtin cd /dd/tmp/XARG
wait    2
run     clear
wait    1
run     ls
wait    2
run     ls | xargs wc -l
wait    5
