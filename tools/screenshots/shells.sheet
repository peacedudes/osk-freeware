# Shells and the small programs written for shell scripts, one stanza
# per program.

shot    bash
cap     The shell a login on this disk hands you: GNU bash 1.12.  Its
cap     version, an arithmetic expansion, a loop.
run     bash -c "echo bash $BASH_VERSION, running a one-line script"
wait    4
run     echo $((355/113)) $((7*6))
wait    3
run     for f in one two three; do echo "item $f"; done
wait    4
try     bash -c "echo bash $BASH_VERSION, running a one-line script"

shot    sh
cap     A small Bourne shell, version 7.5, running as a program under
cap     bash: its own # prompt, and a real chd that moves the data
cap     directory, as pwd shows.
run     sh
wait    4
send    echo hello from sh\r
wait    3
send    chd /dd/SYS; pwd\r
wait    3
send    exit\r
wait    3
try     sh

shot    ksh
cap     pd-ksh, the Korn shell, running a three-line script and a one-line
cap     command.  It is the shell programs on this disk shell out through.
run     mkdir -p /dd/tmp/SHL > /nil 2>/nil; printf "print hello from a ksh script\rfor f in a b c; do print item \$f; done\r" > /dd/tmp/SHL/script.ksh
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/SHL/script.ksh
wait    2
run     ksh < tmp/SHL/script.ksh
wait    5
run     ksh -c "print the date is; today"
wait    5
try     ksh < tmp/SHL/script.ksh
os9     ksh <tmp/SHL/script.ksh

shot    gshell
cap     GSHELL, a menu in place of a command line: the directory as a
cap     lettered list, + and - to page, . to change directory, a letter
cap     to run that file.
run     gshell
wait    6
snap
send    \003
wait    2
try     gshell

shot    mshell
cap     A menu shell: it reads a file of `label,command' lines and shows
cap     them numbered, and a number runs that command through Microware's
cap     `shell' -- the shell that comes with your OS-9 -- so here you see
cap     the menu it draws.
run     mkdir -p /dd/tmp/SHL > /nil 2>/nil; printf "Who am I,whoami\rThe date,today\rList SYS,ls /dd/SYS\r" > /dd/tmp/SHL/menu
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     mshell tmp/SHL/menu
wait    5
snap
send    \003
wait    2
try     mshell tmp/SHL/menu

shot    env
cap     Runs a command with a variable added to its environment: here
cap     printenv, which shows the variable arriving.
run     env FOO=bar printenv | grep FOO
wait    5
try     env FOO=bar printenv | grep FOO
os9     env FOO=bar printenv ! grep FOO

shot    printenv
cap     The environment a login on this disk arrives with.
run     printenv
wait    5
try     printenv

shot    getenv
cap     Reads one environment variable back: -p prints it with a newline,
cap     -l without one, -x makes it the exit status.  Its messages are in
cap     German.
run     getenv -p TERM
wait    3
run     getenv -p HOME
wait    3
try     getenv -p TERM

shot    checkenv
cap     Compares an environment variable with a value, for a script to
cap     branch on: `checkenv <name> , <value>', spaces round the comma.
cap     It is meant to return an error when they differ; here it returns
cap     0 either way, and prints its syntax line every time.
run     checkenv TERM , vt100; echo "status $?"
wait    4
run     checkenv TERM , ansi; echo "status $?"
wait    4
try     checkenv TERM , vt100; echo "status $?"
os9     checkenv TERM , vt100

shot    exist
cap     Tests whether a file exists and answers in its exit status, 0 for
cap     yes and 1 for no, which is what a script wants.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     exist SYS/motd; echo "exist says $?"
wait    4
run     exist SYS/no-such-file; echo "exist says $?"
wait    4
try     exist SYS/motd; echo "exist says $?"
os9     exist SYS/motd

shot    expr
cap     GNU expr, evaluating an expression for a script.
run     expr 355 / 113
wait    3
run     expr 6 \* 7 + 1
wait    3
run     expr length "OS-9/68000"
wait    3
try     expr 355 / 113

shot    if
cap     Conditional execution for a script: `if def <var>', `if loaded
cap     <module>' or `if varval <var> <value>', then one command to run.
cap     It hands that command to Microware's `shell' to run, which is
cap     not on this disk, so here it does nothing.  bash has an `if' of
cap     its own, a reserved word; `command if' reaches this one instead.
run     command if -?
wait    4
run     command if def TERM today endif
wait    5
try     command if -?
os9     if -?

shot    qp
cap     Expands back-quotes in a command line for a shell that cannot:
cap     the output of the quoted command replaces it.  It runs the result
cap     through Microware's `shell', the one that comes with your OS-9.
run     qp -?
wait    4
run     qp echo `whoami`
wait    5
try     qp -?

shot    xc
cap     Runs the commands marked in a file and leaves the rest alone: a
cap     line starting `% ' is a command, anything else is notes.  The
cap     first command is echoed and then it stops with an exit status,
cap     because it forks the marked commands through Microware's `shell',
cap     the one that comes with your OS-9.
run     mkdir -p /dd/tmp/SHL > /nil 2>/nil; printf "notes to myself\r%% echo one\r%% whoami\rmore notes\r" > /dd/tmp/SHL/cmds.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/SHL/cmds.txt
wait    2
run     xc tmp/SHL/cmds.txt
wait    5
try     xc tmp/SHL/cmds.txt

shot    run
cap     Runs a program with its input and output rebound to the terminal
cap     that PORT names, for a program started somewhere else.  Here the
cap     console is that terminal already, and nothing comes back from it.
run     run
wait    4
run     export PORT=/term; run 'whoami'
wait    5
try     run

shot    hist
cap     A command-line editor and history in front of the shell: cursor
cap     movement, word and line deletion, and command recall.  Its own
cap     prompt stays buffered and does not reach this console; giving it
cap     a command, `whoami', flushes that buffer as a row of asterisks
cap     and returns to bash.
run     hist
wait    3
send    whoami\r
wait    4
try     hist

shot    printf
cap     printf for the shell: widths, numbers, floating point.
run     printf "%-8s|%5d|%6.2f\n" apples 12 3.14159
wait    4
run     printf "hello, %s\n" world
wait    3
run     printf "plain text, no conversion\n"
wait    3
try     printf "%-8s|%5d|%6.2f\n" apples 12 3.14159

shot    whoami
cap     Who you are, by user number in SYS/password.  Everything on this
cap     disk is owned 0.0, whose name there is su, while $USER, which the
cap     login set, says tester.
run     whoami
wait    3
run     echo "USER is $USER"
wait    3
try     whoami

shot    logname
cap     Your login name, looked up the same way as whoami.
run     logname
wait    3
run     echo "logged in as $(logname), user $USER"
wait    3
try     logname

shot    su
cap     GNU su.  Its options, and an attempt to become tester, which on a
cap     disk where every file is owned 0.0 has no one to become and
cap     returns without a word.
run     su --help
wait    5
run     su tester
wait    4
try     su --help

shot    submit
cap     Runs the commands in a .sub file with its parameters substituted
cap     into them -- a batch job: its options.
run     submit -?
wait    5
try     submit -?

shot    xargs
size    16 80
cap     Turns what it reads into arguments for a command: the names arrive
cap     on the command line rather than on standard input, which is what a
cap     program like wc needs to count them separately.
try     ls | xargs wc -l
os9     ls ! xargs wc -l
run     rm -rf /dd/tmp/XARG > /nil 2>/nil; mkdir -p /dd/tmp/XARG
run     printf "alpha\rbeta\r" > /dd/tmp/XARG/one; printf "gamma\r" > /dd/tmp/XARG/two
run     builtin cd /dd/tmp/XARG
wait    2
run     clear
wait    1
run     ls
wait    2
run     ls | xargs wc -l
wait    5
