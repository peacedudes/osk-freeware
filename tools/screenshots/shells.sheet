# Shells, and the small utilities that exist to be used from
# them.

shot    env
for     env getenv printenv checkenv whoami logname su
cap     env runs a command with the environment changed, and getenv reads
cap     one variable back.
run     /dd/CMDS/env FOO=bar /dd/CMDS/printenv | /dd/CMDS/grep FOO
wait    8
run     /dd/CMDS/getenv TERM
wait    5
run     /dd/CMDS/whoami
wait    5

shot    exist
cap     exist and checkenv answer a question for a script and set the
cap     status -- the OS-9 equivalents of test.
run     /dd/CMDS/exist /dd/SYS/motd
wait    3
run     /dd/CMDS/checkenv TERM
wait    3

shot    expr
cap     expr, doing arithmetic for a shell that cannot.
run     /dd/CMDS/expr 355 / 113
wait    2
run     /dd/CMDS/expr 2 \* 21
wait    3

shot    gshell
for     gshell mshell xc run fc hist
cap     GSHELL, a shell with a menu, and the other three small shells this
cap     disk keeps beside bash.
run     /dd/CMDS/gshell
wait    8

shot    if
for     if exist ask ynad
cap     if, exist and ask are the pieces a shell script tests with -- OS-9
cap     had no `test' and these are what stood in for it.
run     /dd/CMDS/if -?
wait    6
run     /dd/CMDS/exist /dd/SYS/motd
wait    5
run     /dd/CMDS/exist /dd/SYS/nothing-here
wait    6

shot    ksh
cap     pd-ksh, the Korn shell, running as a program under bash: its own
cap     prompt, its own builtins.
run     /dd/CMDS/ksh
wait    4
send    echo $KSH_VERSION; for i in 1 2 3; do echo line $i; done\r
wait    4
send    exit\r
wait    2

shot    printenv
cap     The environment a login on this disk actually arrives with.
run     /dd/CMDS/printenv
wait    4

shot    printf
cap     printf, formatting rather than echoing.
run     /dd/CMDS/printf "%s is %d bytes and %5.2f K\n" tar 22966 22.43
wait    4

shot    sh
cap     sh, a small Bourne shell -- and the one with a real OS-9 chd, so
cap     pwd moves when you ask it to.
run     /dd/CMDS/sh
wait    4
send    echo hello from sh; pwd\r
wait    4
send    exit\r
wait    2

shot    whoami
cap     Who the shell thinks you are, three ways.
run     /dd/CMDS/whoami
wait    2
run     /dd/CMDS/logname
wait    2
run     /dd/CMDS/tty
wait    3


shot    bash
for     bash expr
cap     The shell this disk hands you, answering for itself: its version,
cap     an arithmetic expansion, and `expr' beside it doing the same sum
cap     the way a script written for OS-9's own shell would have to.
run     echo $BASH_VERSION
wait    6
run     echo $((355/113)) $((7*6))
wait    6
run     /dd/CMDS/expr 355 / 113
wait    6
run     /dd/CMDS/expr 7 \* 6
wait    8
