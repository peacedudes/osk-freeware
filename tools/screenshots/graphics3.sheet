# Photographs, converted with a threshold rather than a dither, which is
# what makes a picture recognisable at 80 columns.
shot    gulls
for     giftopnm pbmtoascii
cap     DEMO/gulls.gif -- a real photograph -- decoded by giftopnm, scaled,
cap     normalised and thresholded, then printed as characters.  Six netpbm
cap     programs in a row, which is the toolkit's whole design.
run     giftopnm /dd/DEMO/gulls.gif | ppmtopgm | pnmscale -width 150 | pgmnorm | pgmtopbm -threshold -value 0.55 | pbmtoascii
wait    30

shot    sphere
cap     DEMO/sphere.pgm, a rendered sphere, thresholded so the terminator
cap     between lit and unlit is a hard edge.
run     pnmscale -width 150 /dd/DEMO/sphere.pgm | pgmtopbm -threshold -value 0.4 | pbmtoascii
wait    15

shot    ppmrelief
cap     ppmrelief embosses an image -- the same sphere lit from the side by
cap     arithmetic rather than by a renderer.
run     pgmtoppm white /dd/DEMO/sphere.pgm | ppmrelief | ppmtopgm | pnmscale -width 150 | pgmtopbm | pbmtoascii
wait    20

shot    pnmtile
cap     pnmtile repeats a small image to fill a larger one; pbmpscale then
cap     enlarges a bitmap without the staircase.
run     pnmscale -width 30 /dd/DEMO/sphere.pgm > /dd/tmp/t.pgm
wait    8
run     pnmtile 150 40 /dd/tmp/t.pgm | pgmtopbm -threshold -value 0.4 | pbmtoascii
wait    12

shot    pgmbentley
cap     The Bentley effect: brightness carried by how tall each pixel is.
run     pnmscale -width 150 /dd/DEMO/sphere.pgm | pgmbentley | pgmtopbm | pbmtoascii
wait    15

shot    ppmpat-madras
cap     ppmpat weaves a madras pattern; the same dither renders it.
run     ppmpat -madras 150 44 | ppmtopgm | pgmtopbm | pbmtoascii
wait    12

shot    pgmnoise
cap     pgmnoise makes white noise, pnmsmooth blurs it, and what comes back
cap     looks like cloud.
run     pgmnoise 150 44 | pnmsmooth | pgmtopbm | pbmtoascii
wait    15

shot    pnmrotate
cap     pnmrotate turning the sphere thirty degrees, with pnmcrop cutting
cap     the empty margin back off.
run     pnmscale -width 100 /dd/DEMO/sphere.pgm | pnmrotate 30 | pnmcrop | pgmtopbm -threshold -value 0.4 | pbmtoascii
wait    20
