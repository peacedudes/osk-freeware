# Calendars, clocks and the computus.

shot    cal-holidays
for     cal
cap     cal with -h: the holidays in SYS/holidays are marked on the month.
run     cal -m=12 -y=2026 -h
wait    4

shot    calen
cap     calen prints a month as a diary page, ruled for appointments -- it
cap     asks for month, year and how many months to print.
run     echo 8 2026 1 | calen | head -n 21
wait    6

shot    calender
cap     A whole year on one screen, in German -- `Fuer welches Jahr?'
run     calender
wait    2
send    2026\r
wait    3
kill

shot    digclk
cap     A digital clock drawn in block characters, with the hostname under
cap     it.  It redraws until you stop it.
run     digclk
wait    6

shot    ephem
for     ephem
cap     ephem, the astronomical ephemeris, with the configuration and
cap     database that ship in SYS.  Past the copyright page it draws its
cap     table: the sun, the moon and the planets for the date it is set to,
cap     with rise, transit and set down the side.
run     ephem -c /dd/SYS/ephem.cfg -d /dd/SYS/ephem.db
wait    8
send    \r
wait    10
quit    q


shot    setimex
for     setimex today
cap     setimex sets the clock from a hardware clock and reports what it
cap     found; `today' beside it prints the date in words.
run     setimex
wait    8
run     today
wait    10

shot    greg
for     greg combine
cap     `greg' converts a JULIAN DAY NUMBER to a Gregorian date -- 2461281
cap     is the 29th of August 2026.  It is not the regular-expression demo
cap     DOC/INDEX called it until this card was made.  `combine' beside it
cap     is the other program here whose name says less than it does: it
cap     interleaves two files byte by byte, even bytes from one and odd from
cap     the other, which is how a 16-bit EPROM image is put back together
cap     from its two 8-bit halves.  It clears the screen before it speaks,
cap     which is why it goes first here.
run     combine -?
wait    8
run     greg 2461281
wait    6
run     greg 2440588
wait    8
