# Real pictures, converted by the toolkit and rendered back to characters.
# PATH carries CMDS/NETPBM, so these read the way they were written to.
shot    giftopnm
cap     A real photograph off the disk -- DEMO/gulls.gif -- decoded by
cap     giftopnm, reduced, dithered and printed as characters.  Every stage
cap     is a separate netpbm program, which is the whole design.
run     giftopnm /dd/DEMO/gulls.gif | ppmtopgm | pnmscale -width 152 | pgmtopbm | pbmtoascii
wait    25

shot    pnmfile-gulls
cap     What each stage of that pipeline actually produced, according to
cap     pnmfile.
run     giftopnm /dd/DEMO/gulls.gif > /dd/tmp/gulls.ppm
wait    12
run     pnmscale -width 300 /dd/tmp/gulls.ppm > /dd/tmp/small.ppm
wait    12
run     pnmfile /dd/tmp/gulls.ppm /dd/tmp/small.ppm
wait    5

shot    pgmedge
cap     pgmedge finds the edges in the same photograph -- a convolution,
cap     then dithered back to black and white.
run     ppmtopgm /dd/tmp/small.ppm | pnmscale -width 152 | pgmedge | pgmtopbm | pbmtoascii
wait    20

shot    pnminvert
cap     The sphere that ships in DEMO, inverted, so the light comes from
cap     the other side.
run     pnmscale -width 152 /dd/DEMO/sphere.pgm | pnminvert | pgmtopbm | pbmtoascii
wait    15

shot    ppmhist
cap     ppmhist counts the colours in the photograph -- the most common
cap     first.  A GIF holds at most 256 and this one uses them.
run     ppmhist /dd/tmp/small.ppm | /dd/CMDS/head -n 16
wait    8

shot    ppmforge
cap     ppmforge invents a planet: fractal terrain, an atmosphere and a
cap     star field, all from a random seed.
run     ppmforge -width 152 -height 88 -seed 7 | ppmtopgm | pgmtopbm | pbmtoascii
wait    30

shot    pnmcat
cap     pnmcat puts two images side by side -- here the sphere beside its
cap     own negative.
run     pnmscale -width 60 /dd/DEMO/sphere.pgm > /dd/tmp/s.pgm
wait    8
run     pnminvert /dd/tmp/s.pgm > /dd/tmp/si.pgm
wait    5
run     pnmcat -lr /dd/tmp/s.pgm /dd/tmp/si.pgm | pgmtopbm | pbmtoascii
wait    12

shot    pnmtops
cap     pnmtops writes PostScript, which is how a bitmap reached a printer
cap     in 1990.  The head of the file it produced.
run     pnmtops /dd/tmp/s.pgm | /dd/CMDS/head -n 16
wait    8
