# Compilers and build tools, each one actually building
# something.

shot    as09
for     as09
cap     as09 assembling 6809 source.  It says nothing and writes Motorola
cap     S-records beside the source -- so the proof is the file: four
cap     instructions at $1000, in the format a ROM burner eats.  A 6809
cap     cross-assembler running on a 68000; as0, as1, as4, as5 and as11 are
cap     its cousins for the rest of the 6800 family, and not one of the six
cap     assembles 68k code.
cap     The source is written here rather than borrowed from another card:
cap     it used to be, and when that card moved the file was not there and
cap     this one showed two `can't open' messages.
run     echo "        org  \0441000" > /dd/tmp/t.a
wait    6
run     echo "        lda  #\04442" >> /dd/tmp/t.a
wait    5
run     echo "        sta  \0442000" >> /dd/tmp/t.a
wait    5
run     echo "        rts" >> /dd/tmp/t.a
wait    5
run     echo "        end" >> /dd/tmp/t.a
wait    5
run     cat /dd/tmp/t.a
wait    6
run     as09 /dd/tmp/t.a
wait    12
run     cat /dd/tmp/t.s19
wait    8
run     cat /dd/tmp/t.s19
wait    8

shot    bison
cap     GNU bison 1.19 on a two-rule grammar it writes for itself, then
cap     the report -v leaves behind: the rules as bison read them, the
cap     terminals with the rules they appear in, and the numbers it gave
cap     them.  It says nothing at all when it succeeds.
run     echo "%token NUM" > /dd/tmp/b.y
wait    3
run     echo "%%" >> /dd/tmp/b.y
wait    3
run     echo "expr : expr NUM | NUM ;" >> /dd/tmp/b.y
wait    3
run     bison -v /dd/tmp/b.y
wait    15
run     head -n 12 /dd/tmp/b.output 2>/nil
wait    6

shot    flex
cap     flex turning a lexical description into C.
run     echo "%%" > /dd/tmp/l.l
wait    5
run     echo "[0-9]+   { return NUM; }" >> /dd/tmp/l.l
wait    5
run     echo ".        ;" >> /dd/tmp/l.l
wait    5
run     flex /dd/tmp/l.l
wait    8
run     head -n 10 lex.yy.c
wait    5

shot    gcc
for     gcc gcc2 gcc_cc1 gcc_cc1plus gcc_cccp gcc_cccp2 gcc_cc2 gcc_collect
for     gpp gpp_cc1plus gpp_cccp gpp_collect cc1plus cc2 cc2plus cccp2 collect
cap     GCC 1.39 and its passes.  Asked to compile, the driver prints the
cap     preprocessor command it wants to run and then cannot find `cccp':
cap     the passes are installed under a prefix -- gcc2 wants gcc_, gpp
cap     wants gpp_ -- and the driver does not look where they live.
cap     The passes themselves are real programs and each says something
cap     when asked -- eight of the nine were credited to this card and
cap     never typed on it until 2026-08-30.
run     gcc -v
wait    4
run     gcc -v -c /dd/SRC/load/load.c
wait    12
run     gcc_cc1 -version
wait    8
run     gcc_cc2
wait    8
run     gcc_cccp2 -version
wait    8
run     gcc_collect
wait    8
run     gpp -v
wait    8
run     gpp_cc1plus -version
wait    8
run     gpp_cccp -version
wait    8
run     gpp_collect
wait    8
run     gcc2 -v
wait    8
run     gcc_cc1plus -version
wait    8
run     gcc_cccp -version
wait    8
run     /dd/CMDS/GCC2/cc1plus -version
wait    8
run     /dd/CMDS/GCC2/cc2
wait    8
run     /dd/CMDS/GCC2/cc2plus -version
wait    8
run     /dd/CMDS/GCC2/cccp2 -version
wait    8
run     /dd/CMDS/GCC2/collect
wait    8

shot    gmake
cap     GNU make, and dmake beside it, both saying what they are.
run     gmake -v
wait    5
run     dmake -V
wait    5

shot    m4
for     m4 m4_0.5
cap     m4, the macro processor, expanding a macro from a file.  What ships
cap     as `m4' from 2026-08-28 is the CMDS/REBUILT/m4_0.5 build: the one
cap     that used to be here expanded this same file as `i hr '.
run     echo "define(GREET,Hello \$1 from OS-9)" > /dd/tmp/m.m4
wait    5
run     echo "GREET(reader)" >> /dd/tmp/m.m4
wait    5
run     cat /dd/tmp/m.m4
wait    5
run     m4 < /dd/tmp/m.m4
wait    8

shot    make
size    36 80
cap     `make' keeping a rule, building the target and then saying it is
cap     up to date -- which this card said it could not do until
cap     2026-08-29.  TWO obstacles, neither of them make being broken.  A
cap     command line in a makefile must begin with a TAB, and a tab does
cap     not survive being typed at this terminal, so every makefile written
cap     here by echoing at the shell was a syntax error; DOC/make/demo.mk
cap     is one SHIPPED with its tabs intact.  And a recipe must contain no
cap     shell metacharacter: where a line has none make forks the command
cap     itself, but where it has a `>' it forks bash and hands it the whole
cap     line AS A PATHNAME rather than with -c, so `cat a > b' answers
cap     `That path name doesn't lead to a file' and `cp a b' works.
run     rm -f /dd/tmp/greeting
wait    5
run     make -f /dd/DOC/make/demo.mk greeting
wait    12
run     ls -l /dd/tmp/greeting
wait    8
run     make -f /dd/DOC/make/demo.mk greeting
wait    10


shot    makeinfo
for     makeinfo dmake gmake
cap     makeinfo turns Texinfo source into the info files emacs reads.
run     makeinfo --version
wait    8
run     gmake -v
wait    8
run     dmake -?
wait    8

shot    p2c
size    36 80
for     p2c
cap     p2c TRANSLATING PASCAL INTO C, which is the thing it is for.  It
cap     works on the CURRENT directory, so it is run through ksh -- whose
cap     `cd' moves the OS-9 data directory where bash's does not -- and it
cap     writes `h.c' beside the source.  The warning is p2c's own and
cap     correct: nothing has told it what `writeln' is, because the Pascal
cap     runtime declarations live in LIB/p2c and this one-line program does
cap     not ask for them.
cap     Until 2026-09-01 this card showed `p2c -?' and nothing else.
run     mkdir -p /dd/tmp/P2C
wait    4
run     echo "program hello; begin writeln('hi') end." > /dd/tmp/P2C/h.pas
wait    4
run     cat /dd/tmp/P2C/h.pas
wait    4
run     ksh -c "cd /dd/tmp/P2C; p2c h.pas" 2>/nil
wait    12
run     ls /dd/tmp/P2C
wait    6
run     head -n 12 /dd/tmp/P2C/h.c
wait    8

shot    xasm
for     as0 as1 as4 as5 as11
size    40 90
cap     The xasm family assembling, rather than printing its usage: as0 on
cap     6800 source and as5 on 6805.  Address, opcode bytes and the original
cap     line, then the symbol table -- `l' asks for the listing and `s' for
cap     the symbols, after a lone `-'.  A sample for each of the six ships
cap     in DOC/xasm, added 2026-08-31 because this card used to be five
cap     copies of `Usage: as0 [files]' and showed nothing about the
cap     programs.  These are 8-BIT cross-assemblers: no 68000 among them,
cap     and there has never been a 68050.
run     as0 /dd/DOC/xasm/sample.a0 - l s
wait    14
run     as5 /dd/DOC/xasm/sample.a5 - l s
wait    14

shot    yacc
for     yacc
cap     yacc DOES NOT COME BACK.  Given the three-line grammar built above
cap     -- the same one `bison' reads and reports on in a second -- it
cap     prints nothing and never returns, and the session has to be
cap     stopped.  Measured 2026-08-29.  `bison' is the parser generator
cap     that works here, and has its own card.
run     echo "%token NUM" > /dd/tmp/g.y
wait    3
run     echo "%%" >> /dd/tmp/g.y
wait    3
run     echo "expr : expr NUM | NUM ;" >> /dd/tmp/g.y
wait    3
run     cat /dd/tmp/g.y
wait    5
run     yacc -v /dd/tmp/g.y
wait    20
kill

shot    fortran
for     rtf for lnk lnk.org biory creadoc os9lib
cap     RTF/68K 2.14, 1987 -- and IT COMPILES.  Load its runtime library
cap     first (`load /dd/CMDS/os9lib'; without it the whole set prints
cap     nothing at all) and `rtf <file>.f' reads Fortran-77 and writes 68k
cap     assembly beside the source: zero errors, zero warnings, `RTF
cap     normally completed', 1008 bytes of div.a.  Assembling and linking
cap     that needs Microware's r68 and l68, which are not here.  Call `rtf'
cap     DIRECTLY: the `for' driver forks a program called `shell' to run it
cap     and this disk has none, so it prints the command and stops.  The
cap     last line is `biory', a Fortran PROGRAM from the same set, running
cap     off the same loaded library and asking for a name in German.
run     rtf
wait    6
run     load /dd/CMDS/os9lib
wait    8
run     rtf /dd/SRC/rtf/div.f
wait    30
run     ls -l /dd/SRC/rtf/div.a
wait    8
run     /dd/CMDS/for /dd/SRC/rtf/div.f
wait    10
run     biory < /nil
wait    10
run     lnk
wait    8
run     lnk.org
wait    8
run     creadoc /dd/SRC/rtf/div.f
wait    10