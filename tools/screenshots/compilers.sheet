# Compilers and build tools, each one actually building something.
# Every stanza makes what it reads under /dd/tmp/CMPA.

shot    as0
size    30 90
cap     as0, the 6800/6802 cross-assembler: address, opcode bytes and the
cap     source line, then the symbol table -- `l' for the listing and `s'
cap     for the symbols, after a lone `-'.
run     as0 /dd/DOC/xasm/sample.a0 - l s
wait    14

shot    as09
size    30 90
cap     as09, the 6809 assembler and the only one of the six xasm programs
cap     that is not a cross-assembler for an 8-bit relative of the 6809 --
cap     none of the six assembles 68000 code.  It says nothing and writes
cap     Motorola S-records beside the source: four instructions at $1000,
cap     in the format a ROM burner reads.  Run through ksh, whose `cd'
cap     moves the OS-9 data directory where bash's does not -- given the
cap     source by its full path instead, as09 cannot create its own
cap     temporary file.
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; rm -f /dd/tmp/CMPA/t.a /dd/tmp/CMPA/t.s19
wait    3
run     echo "        org  \0441000" > /dd/tmp/CMPA/t.a
wait    5
run     echo "        lda  #\04442" >> /dd/tmp/CMPA/t.a
wait    5
run     echo "        sta  \0442000" >> /dd/tmp/CMPA/t.a
wait    5
run     echo "        rts" >> /dd/tmp/CMPA/t.a
wait    5
run     echo "        end" >> /dd/tmp/CMPA/t.a
wait    5
run     cat /dd/tmp/CMPA/t.a
wait    6
run     ksh -c "cd /dd/tmp/CMPA; as09 t.a"
wait    12
run     cat /dd/tmp/CMPA/t.s19
wait    8

shot    as1
size    30 90
cap     as1, the 6801/6803 cross-assembler.  The 6801 adds MUL, ADDD and
cap     the D register over the 6800, and the sample uses all three.
run     as1 /dd/DOC/xasm/sample.a1 - l s
wait    14

shot    as4
size    30 90
cap     as4, the 6804 cross-assembler.  Its instruction set is small: no
cap     CLR on the pseudo-registers, no immediate CMP.
run     as4 /dd/DOC/xasm/sample.a4 - l s
wait    14

shot    as5
size    30 90
cap     as5, the 6805/68HC05 cross-assembler, on bit set, bit test and
cap     branch -- what the 6805 is for.
run     as5 /dd/DOC/xasm/sample.a5 - l s
wait    14

shot    as11
size    30 90
cap     as11, the 68HC11 cross-assembler.  It lists by default -- no `-l'
cap     needed -- and reads any word after the file name as one more
cap     source file rather than as an option, so the `- l s' its siblings
cap     take is not for this one.
run     as11 /dd/DOC/xasm/sample.a11
wait    14

shot    assembler
cap     The GSHELL front-end for the assembler family: a full-screen file
cap     picker, not an assembler itself.  Control-C leaves it; none of q,
cap     Q, control-D or ESC do.
run     assembler
wait    8
snap
send    \003
wait    3

shot    compiler
cap     The GSHELL front-end for the C compiler: the same file-picker
cap     menu, headed for cc.  Control-C leaves it.
run     compiler
wait    8
snap
send    \003
wait    3

shot    bison
cap     GNU bison 1.19 on a two-rule grammar it writes for itself, then
cap     the report -v leaves behind: the rules as bison read them, the
cap     terminals with the rules they appear in, and the numbers it gave
cap     them.  It says nothing at all when it succeeds.
run     echo "%token NUM" > /dd/tmp/b.y
wait    3
run     echo "%%" >> /dd/tmp/b.y
wait    3
run     echo "expr : expr NUM | NUM ;" >> /dd/tmp/b.y
wait    3
run     bison -v /dd/tmp/b.y
wait    15
run     head -n 12 /dd/tmp/b.output 2>/nil
wait    6

shot    flex
cap     flex turning a lexical description into C.
run     echo "%%" > /dd/tmp/l.l
wait    5
run     echo "[0-9]+   { return NUM; }" >> /dd/tmp/l.l
wait    5
run     echo ".        ;" >> /dd/tmp/l.l
wait    5
run     flex /dd/tmp/l.l
wait    8
run     head -n 10 lex.yy.c
wait    5

shot    gcc
cap     The GCC139 and GCC2 drivers share the name `gcc'; this is GCC2's
cap     copy, `gcc version 1.42'.  Asked to compile it prints the
cap     preprocessor command it wants and then cannot find `cccp' -- the
cap     pass lives under a prefix here (gcc_cccp, gcc_cccp2), not under
cap     its own name.
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; printf "int main() {\r  return 0;\r}\r" > /dd/tmp/CMPA/hello.c
wait    4
run     /dd/CMDS/GCC2/gcc -v
wait    6
run     /dd/CMDS/GCC2/gcc -v -c /dd/tmp/CMPA/hello.c
wait    10

shot    gcc2
cap     The GCC 2.x driver, `gcc version 2.5.6'.  Asked to stop at
cap     assembly it succeeds -- Microware's own syntax, `psect', `link.w
cap     a5,#0' -- and asked to go all the way it compiles to assembly and
cap     calls `r68' to assemble it.  `r68' is Microware's, part of your OS-9.
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; printf "int main() {\r  return 0;\r}\r" > /dd/tmp/CMPA/hello.c
wait    4
run     /dd/CMDS/GCC2/gcc2 -v
wait    5
run     /dd/CMDS/GCC2/gcc2 -S -o /dd/tmp/CMPA/hello.a /dd/tmp/CMPA/hello.c
wait    12
run     cat /dd/tmp/CMPA/hello.a | head -n 8
wait    5
run     /dd/CMDS/GCC2/gcc2 -o /dd/tmp/CMPA/hello /dd/tmp/CMPA/hello.c
wait    10

shot    gpp
cap     The C++ driver, GCC2's copy -- `gpp version 1.40.3 (based on GCC
cap     1.40)'.  Asked to compile, it runs its whole pipeline: gpp_cccp
cap     preprocesses, gpp_cc1plus compiles to assembly, and then it calls
cap     Microware's `r68' to assemble it -- `r68' comes with your OS-9.
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; printf "int main() {\r  return 0;\r}\r" > /dd/tmp/CMPA/hello.c
wait    4
run     /dd/CMDS/GCC2/gpp -v -c /dd/tmp/CMPA/hello.c
wait    16

shot    cccp2
cap     GCC 2.x's preprocessor pass, expanding a small C file -- the
cap     `# 1 "..."' line is the marker it adds; there are no macros here
cap     to expand.
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; printf "int main() {\r  return 0;\r}\r" > /dd/tmp/CMPA/hello.c
wait    4
run     /dd/CMDS/GCC2/cccp2 /dd/tmp/CMPA/hello.c /dd/tmp/CMPA/hello.i
wait    8
run     cat /dd/tmp/CMPA/hello.i
wait    5

shot    cc2
cap     GCC 2.x's C compiler pass, saying what it is.
run     /dd/CMDS/GCC2/cc2 -version
wait    8

shot    cc1plus
cap     GCC 2.x's C++ compiler pass, saying what it is.
run     /dd/CMDS/GCC2/cc1plus -version
wait    8

shot    cc2plus
cap     GCC 2.x's other C++ pass, saying what it is.
run     /dd/CMDS/GCC2/cc2plus -version
wait    8

shot    collect
cap     GCC 2.x's collect2, which builds the global constructor/destructor
cap     table a C++ program needs -- its own syntax, since it takes no -?.
run     /dd/CMDS/GCC2/collect
wait    8

shot    gcc_cc1
cap     GCC 1.39's C compiler pass, saying what it is.
run     /dd/CMDS/GCC139/gcc_cc1 -version
wait    8

shot    gcc_cc1plus
cap     GCC 1.39's C++ compiler pass, saying what it is.
run     /dd/CMDS/GCC139/gcc_cc1plus -version
wait    8

shot    gcc_cccp
cap     GCC 1.39's preprocessor pass, expanding the same small C file.
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; printf "int main() {\r  return 0;\r}\r" > /dd/tmp/CMPA/hello.c
wait    4
run     /dd/CMDS/GCC139/gcc_cccp /dd/tmp/CMPA/hello.c /dd/tmp/CMPA/hello.i
wait    8
run     cat /dd/tmp/CMPA/hello.i
wait    5

shot    gcc_collect
cap     GCC 1.39's collect2, the same program as GCC 2.x's.
run     /dd/CMDS/GCC139/gcc_collect
wait    8

shot    gcc_cc2
cap     GCC 2.x's C compiler pass, installed under the name gcc2's driver
cap     forks it by.
run     /dd/CMDS/gcc_cc2 -version
wait    8

shot    gcc_cccp2
cap     GCC 2.x's preprocessor, installed under the name gcc2's driver
cap     forks it by: its own version banner and the two directories it
cap     searches for headers.
run     /dd/CMDS/gcc_cccp2 -version
wait    8

shot    gpp_cc1plus
cap     GCC 2.x's C++ compiler pass, installed under the name gpp's
cap     driver forks it by.
run     /dd/CMDS/gpp_cc1plus -version
wait    8

shot    gpp_cccp
cap     GCC 2.x's preprocessor, installed under the name gpp's driver
cap     forks it by -- the same program as gcc_cccp2.
run     /dd/CMDS/gpp_cccp -version
wait    8

shot    gpp_collect
cap     GCC 2.x's collect2, installed under the name gpp's driver forks
cap     it by.
run     /dd/CMDS/gpp_collect
wait    8

shot    gmake
cap     GNU make 3.67, running a rule from DOC/make/demo.mk: copies
cap     one file to another and reports the file it made.
run     rm -f /dd/tmp/greeting
wait    4
run     gmake -v
wait    5
run     gmake -f /dd/DOC/make/demo.mk greeting
wait    10
run     ls -l /dd/tmp/greeting
wait    6

shot    dmake
cap     dmake 3.70, Dennis Vadura's parallel make, on the same rule --
cap     its own makefile dialect still reads DOC/make/demo.mk and builds
cap     the target.
run     rm -f /dd/tmp/greeting
wait    4
run     dmake -V
wait    5
run     dmake -f /dd/DOC/make/demo.mk greeting
wait    10
run     ls -l /dd/tmp/greeting
wait    6

shot    m4
cap     m4, the macro processor, expanding a macro from a file.
run     echo "define(GREET,Hello \$1 from OS-9)" > /dd/tmp/m.m4
wait    5
run     echo "GREET(reader)" >> /dd/tmp/m.m4
wait    5
run     cat /dd/tmp/m.m4
wait    5
run     m4 < /dd/tmp/m.m4
wait    8

shot    m4_0.5
cap     A second build of the m4 macro processor.  It reads a macro
cap     definition and expands each use of it: GREET(world) becomes
cap     hello world.
run     mkdir -p /dd/tmp/BLGX > /nil 2>/nil
run     printf 'define(GREET,hello $1)GREET(world)\r' > /dd/tmp/BLGX/mm.m4
run     clear
run     m4_0.5 /dd/tmp/BLGX/mm.m4
wait    5

shot    make
size    36 80
cap     `make' building the target, then running the same rule again with
cap     nothing to do -- it says nothing once a target is up to date.
cap     TWO obstacles along the way, neither of them make being broken.  A
cap     command line in a makefile must begin with a TAB, and a tab does not
cap     survive being typed at this terminal, so every makefile written here
cap     by echoing at the shell was a syntax error; DOC/make/demo.mk is one
cap     SHIPPED with its tabs intact.  And a recipe must contain no shell
cap     metacharacter: where a line has none make forks the command itself,
cap     but where it has a `>' it forks bash and hands it the whole line AS
cap     A PATHNAME rather than with -c, so `cat a > b' answers `That path
cap     name doesn't lead to a file' and `cp a b' works.
run     rm -f /dd/tmp/greeting
wait    5
run     make -f /dd/DOC/make/demo.mk greeting
wait    12
run     ls -l /dd/tmp/greeting
wait    8
run     make -f /dd/DOC/make/demo.mk greeting
wait    10

shot    makeinfo
cap     GNU makeinfo, Texinfo to Info -- it takes `+' options, not `--':
cap     `+version' answers, GNU-style `--version' does not.
run     makeinfo +version
wait    6

shot    p2c
size    36 80
cap     p2c TRANSLATING PASCAL INTO C, which is the thing it is for.  It
cap     works on the CURRENT directory, so it is run through ksh -- whose
cap     `cd' moves the OS-9 data directory where bash's does not -- and it
cap     writes `h.c' beside the source.  The warning is p2c's own and
cap     correct: nothing has told it what `writeln' is, because the Pascal
cap     runtime declarations live in LIB/p2c and this one-line program does
cap     not ask for them.
run     mkdir -p /dd/tmp/P2C
wait    4
run     echo "program hello; begin writeln('hi') end." > /dd/tmp/P2C/h.pas
wait    4
run     cat /dd/tmp/P2C/h.pas
wait    4
run     ksh -c "cd /dd/tmp/P2C; p2c h.pas" 2>/nil
wait    12
run     ls /dd/tmp/P2C
wait    6
run     head -n 12 /dd/tmp/P2C/h.c
wait    8

shot    yacc
cap     yacc reading a grammar and writing y.tab.c, the parser table,
cap     into the data directory -- the two-rule grammar above.  The four
cap     `F$SetSys' lines are a harmless system-call notice, not an error:
cap     status 0 and the file both confirm it finished.
run     rm -f /dd/tmp/CMPA/g.y /dd/tmp/CMPA/y.tab.c; mkdir -p /dd/tmp/CMPA > /nil 2>/nil
wait    4
run     printf "%%token NUM\r%%%%\rexpr : expr NUM | NUM ;\r" > /dd/tmp/CMPA/g.y
wait    4
run     cat /dd/tmp/CMPA/g.y
wait    4
run     clear
wait    1
run     ksh -c "cd /dd/tmp/CMPA; yacc g.y"; echo "status $?"
wait    15
run     ls -l /dd/tmp/CMPA/y.tab.c
wait    6

shot    rtf
cap     RTF/68K 2.14 (1987) compiling real Fortran-77: `load os9lib' first
cap     -- without its runtime library the whole set prints nothing at
cap     all -- then `rtf' reads the source and writes 68k assembly beside
cap     it.  Assembling and linking that is Microware's `r68' and `l68',
cap     part of your OS-9, so your system finishes the build.
run     rm -f /dd/tmp/CMPA/div.f /dd/tmp/CMPA/div.a; mkdir -p /dd/tmp/CMPA > /nil 2>/nil
wait    4
run     cp /dd/SRC/rtf/div.f /dd/tmp/CMPA/div.f
wait    4
run     load /dd/CMDS/os9lib
wait    6
run     rtf /dd/tmp/CMPA/div.f
wait    20
run     ls -l /dd/tmp/CMPA/div.a
wait    6

shot    for
cap     the RTF/68K FORTRAN driver: it prints the `rtf' command it wants to
cap     run and forks Microware's `shell' -- the one from your OS-9 -- to
cap     run it.  Or call `rtf' directly, which needs no shell at all.
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; cp /dd/SRC/rtf/div.f /dd/tmp/CMPA/div.f
wait    4
run     load /dd/CMDS/os9lib
wait    6
run     /dd/CMDS/for /dd/tmp/CMPA/div.f
wait    10

shot    lnk
cap     the RTF FORTRAN link driver: it prints the `l68' command it wants
cap     -- Microware's linker, with Microware's library -- and stops the
cap     same way `for' does, forking a shell this disk does not carry.
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; cp /dd/SRC/rtf/div.f /dd/tmp/CMPA/div.f
wait    4
run     load /dd/CMDS/os9lib
wait    6
run     lnk /dd/tmp/CMPA/div.f
wait    10

shot    lnk.org
cap     the original build of `lnk', the same program and the same stop.
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; cp /dd/SRC/rtf/div.f /dd/tmp/CMPA/div.f
wait    4
run     load /dd/CMDS/os9lib
wait    6
run     lnk.org /dd/tmp/CMPA/div.f
wait    10

shot    creadoc
cap     extracts the documentation header (C++ ... C--) of every .f file
cap     into creadoc.txt -- an early Fortran doc generator.  It reads each
cap     file name from column 53 of a `dir -eadu' listing, where this disk's
cap     dir puts it at 54 (and 2026, printed `126', pushes it further), so
cap     it opens a space-prefixed name and stops.  A dir-column brittleness.
cap     It needs the Fortran run-time loaded, and shells out to dir and del.
run     rm -rf /dd/tmp/CMPA; mkdir -p /dd/tmp/CMPA; cp /dd/SRC/rtf/biory.f /dd/tmp/CMPA/biory.f
wait    4
run     load /dd/CMDS/os9lib; load /h1/CMDS/shell; load /h1/CMDS/dir; load /h1/CMDS/del
wait    8
run     clear
wait    1
run     ksh -c "cd /dd/tmp/CMPA; creadoc"
wait    12
