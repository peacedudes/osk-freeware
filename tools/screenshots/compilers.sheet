# Compilers and build tools, each one actually building something.
# Most stanzas make what they read under /dd/tmp/CMPA.

shot    as0
size    30 90
cap     as0, the 6800/6802 cross-assembler: address, opcode bytes and the
cap     source line, then the symbol table.  `l' asks for the listing and
cap     `s' for the symbols, after a lone `-'.
try     as0 DOC/xasm/sample.a0 - l s
run     builtin cd /dd
wait    1
run     clear
wait    1
run     as0 DOC/xasm/sample.a0 - l s
wait    14

shot    as09
size    30 90
cap     as09, the 6809 assembler -- the one of the six xasm tools that
cap     assembles for the 6809 itself, not one of its 8-bit relatives;
cap     none of the six assembles 68000 code.  It says nothing and writes
cap     Motorola S-records beside the source: four instructions at $1000,
cap     in the format a ROM burner reads.
try     as09 t.a
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; rm -f /dd/tmp/CMPA/t.a /dd/tmp/CMPA/t.s19
run     echo "        org  \0441000" > /dd/tmp/CMPA/t.a
run     echo "        lda  #\04442" >> /dd/tmp/CMPA/t.a
run     echo "        sta  \0442000" >> /dd/tmp/CMPA/t.a
run     echo "        rts" >> /dd/tmp/CMPA/t.a
run     echo "        end" >> /dd/tmp/CMPA/t.a
run     builtin cd /dd/tmp/CMPA
wait    2
run     clear
wait    1
run     cat t.a
wait    4
run     as09 t.a
wait    12
run     cat t.s19
wait    8

shot    as1
size    30 90
cap     as1, the 6801/6803 cross-assembler.  The 6801 adds a hardware
cap     multiply and 16-bit accumulator arithmetic over the 6800, and the
cap     sample uses both.
try     as1 DOC/xasm/sample.a1 - l s
run     builtin cd /dd
wait    1
run     clear
wait    1
run     as1 DOC/xasm/sample.a1 - l s
wait    14

shot    as4
size    30 90
cap     as4, the 6804 cross-assembler.  Its instruction set is small: no
cap     clear on the pseudo-registers, no immediate compare.
try     as4 DOC/xasm/sample.a4 - l s
run     builtin cd /dd
wait    1
run     clear
wait    1
run     as4 DOC/xasm/sample.a4 - l s
wait    14

shot    as5
size    30 90
cap     as5, the 6805/68HC05 cross-assembler, shown on bit-set, bit-test
cap     and branch -- what the 6805 is for.
try     as5 DOC/xasm/sample.a5 - l s
run     builtin cd /dd
wait    1
run     clear
wait    1
run     as5 DOC/xasm/sample.a5 - l s
wait    14

shot    as11
size    30 90
cap     as11, the 68HC11 cross-assembler.  It lists by default -- no `-l'
cap     needed -- and treats any word after the file name as another
cap     source file rather than an option, so the `- l s' its siblings
cap     take is not for this one.
try     as11 DOC/xasm/sample.a11
run     builtin cd /dd
wait    1
run     clear
wait    1
run     as11 DOC/xasm/sample.a11
wait    14

shot    assembler
cap     A full-screen file picker that hands a chosen file to the
cap     assembler family; not an assembler itself.  Control-C leaves it;
cap     q, Q, control-D and ESC do not.
try     assembler
run     assembler
wait    8
snap
send    \003
wait    3

shot    compiler
cap     A full-screen file picker headed for the C compiler -- the same
cap     menu as `assembler', not a compiler itself.  Control-C leaves it.
try     compiler
run     compiler
wait    8
snap
send    \003
wait    3

shot    bison
cap     GNU bison on a two-rule grammar written for it, then the report
cap     `-v' leaves behind: the rules as bison read them, the terminals
cap     with the rules they appear in, and the numbers it gave them.  It
cap     prints nothing when it succeeds.
try     bison -v tmp/b.y
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "%token NUM" > tmp/b.y
wait    3
run     echo "%%" >> tmp/b.y
wait    3
run     echo "expr : expr NUM | NUM ;" >> tmp/b.y
wait    3
run     bison -v tmp/b.y
wait    15
run     head -n 12 tmp/b.output 2>/nil
wait    6

shot    flex
cap     flex turning a lexical description into C: the rules go in and the
cap     scanner `lex.yy.c' comes out.  The head of that generated file is
cap     shown below.
try     flex tmp/l.l
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "%%" > tmp/l.l
wait    5
run     echo "[0-9]+   { return NUM; }" >> tmp/l.l
wait    5
run     echo ".        ;" >> tmp/l.l
wait    5
run     flex tmp/l.l
wait    8
run     cat lex.yy.c | head -n 10
wait    5

shot    gcc
cap     The GCC drivers live in their own directory, off the command
cap     path, so each is run from there with `./'.  This is `gcc', the
cap     older driver, reporting version 1.42.  Asked to compile it prints
cap     the preprocessor command it wants, then stops: it looks for a pass
cap     called `cccp'.  DOC/rayshade shows how to put one there --
cap     `copy CMDS/GCC139/gcc_cccp cccp' in the directory it looks in.
cap     The drivers that need nothing extra are `gcc2' and `gpp'.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./gcc -v -c hello.c
run     builtin cd /dd/CMDS/GCC2
wait    3
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    3
wait    1
run     ./gcc -v
wait    6
run     ./gcc -v -c hello.c
wait    10

shot    gcc2
cap     `gcc2', the GCC 2.5.6 C driver, run from its own directory since
cap     it is off the command path.  Asked to stop at assembly (`-S') it
cap     succeeds, writing 68k assembly in Microware syntax -- `psect',
cap     `link.w a5,#0'.  Asked to go all the way it compiles and then
cap     calls `r68' to assemble, the 68k assembler that comes with your
cap     OS-9.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./gcc2 -S -o hello.a hello.c
run     builtin cd /dd/CMDS/GCC2
wait    3
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    3
wait    1
run     ./gcc2 -S -o hello.a hello.c
wait    12
run     cat hello.a | head -n 8
wait    5
run     ./gcc2 -o hello hello.c
wait    10

shot    gpp
cap     `gpp', the GCC2 C++ driver (1.40.3), run from its own directory.
cap     It runs the whole pipeline -- `gpp_cccp' preprocesses,
cap     `gpp_cc1plus' compiles to assembly -- then calls `r68' to
cap     assemble, which comes with your OS-9.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./gpp -v -c hello.c
run     builtin cd /dd/CMDS/GCC2
wait    3
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    3
wait    1
run     ./gpp -v -c hello.c
wait    16

shot    cccp2
cap     The GCC 2.x preprocessor pass, expanding a small C file.  The
cap     `# 1 "..."' line is the source marker it adds; there are no macros
cap     here to expand.  It is run from the GCC2 directory, off the
cap     command path.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./cccp2 hello.c hello.i
run     builtin cd /dd/CMDS/GCC2
wait    3
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    3
wait    1
run     ./cccp2 hello.c hello.i
wait    8
run     cat hello.i
wait    5

shot    cc2
cap     The GCC 2.x C compiler pass -- the stage that turns preprocessed
cap     C into assembly.  The driver runs it for you; on its own it
cap     reports its version and the code-generation options it was built
cap     with.
try     ./cc2 -version
run     builtin cd /dd/CMDS/GCC2
wait    1
run     clear
run     ./cc2 -version
wait    8

shot    cc1plus
cap     A GCC C++ compiler pass (version 1.40.3) from the GCC2 directory.
cap     The driver calls it; run alone it reports its version.
try     ./cc1plus -version
run     builtin cd /dd/CMDS/GCC2
wait    1
run     clear
run     ./cc1plus -version
wait    8

shot    cc2plus
cap     A second C++ compiler pass (version 2.5.8) in the GCC2 directory,
cap     reporting its version and code-generation options.
try     ./cc2plus -version
run     builtin cd /dd/CMDS/GCC2
wait    1
run     clear
run     ./cc2plus -version
wait    8

shot    collect
cap     collect2, which builds the table of global constructors and
cap     destructors a C++ program needs before linking.  It lives in the
cap     GCC2 directory with the other passes, off the command path, so it
cap     is run from there with `./'.  It takes no `-?', so with no
cap     arguments it prints its own usage.
try     ./collect
run     builtin cd /dd/CMDS/GCC2
wait    1
run     clear
run     ./collect
wait    8

shot    gcc_cc1
cap     The GCC 1.39 C compiler pass.  It reports its version; the driver
cap     runs it as part of a compile.
try     gcc_cc1 -version
run     gcc_cc1 -version
wait    8

shot    gcc_cc1plus
cap     The GCC 1.x C++ compiler pass (version 1.37.1), reporting its
cap     version.
try     gcc_cc1plus -version
run     gcc_cc1plus -version
wait    8

shot    gcc_cccp
cap     The GCC 1.39 preprocessor pass, expanding a small C file.  The
cap     `# 1 "..."' line marks the source; there are no macros to expand
cap     here.
try     gcc_cccp DOC/samples/hello.c tmp/hello.i
run     builtin cd /dd
wait    2
run     clear
wait    1
run     gcc_cccp DOC/samples/hello.c tmp/hello.i
wait    8
run     cat tmp/hello.i
wait    5

shot    gcc_collect
cap     collect2 again -- the same global-constructor collector as the
cap     GCC2 directory's, reached here under the GCC 1.39 name.  With no
cap     arguments it prints its usage.
try     gcc_collect
run     gcc_collect
wait    8

shot    gcc_cc2
cap     The GCC 2.x C compiler pass installed on the command path under
cap     this name, so the `gcc2' driver can fork it.  Run alone it reports
cap     its version and options.
try     gcc_cc2 -version
run     gcc_cc2 -version
wait    8

shot    gcc_cccp2
cap     The GCC 2.x preprocessor installed on the command path under the
cap     name the `gcc2' driver forks it by.  It reports its version and
cap     the two directories it searches for headers.
try     gcc_cccp2 -version
run     gcc_cccp2 -version
wait    8

shot    gpp_cc1plus
cap     The GCC C++ compiler pass installed on the command path under the
cap     name the `gpp' driver forks it by.  It reports its version.
try     gpp_cc1plus -version
run     gpp_cc1plus -version
wait    8

shot    gpp_cccp
cap     The GCC 2.x preprocessor under the name the `gpp' driver forks it
cap     by -- the same program as `gcc_cccp2'.  It reports its version and
cap     its header search path.
try     gpp_cccp -version
run     gpp_cccp -version
wait    8

shot    gpp_collect
cap     collect2 under the name the `gpp' driver forks it by -- the same
cap     collector as the others.  With no arguments it prints its usage.
try     gpp_collect
run     gpp_collect
wait    8

shot    gmake
cap     GNU make, running a rule from a shipped makefile: it copies one
cap     file to another and reports the file it made.
try     gmake -f DOC/make/demo.mk greeting
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rm -f tmp/greeting
wait    4
run     gmake -v
wait    5
run     gmake -f DOC/make/demo.mk greeting
wait    10
run     ls -l tmp/greeting
wait    6

shot    dmake
cap     dmake, a parallel make, on the same rule -- its own makefile
cap     dialect still reads the shipped makefile and builds the target.
try     dmake -f DOC/make/demo.mk greeting
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rm -f tmp/greeting
wait    4
run     dmake -V
wait    5
run     dmake -f DOC/make/demo.mk greeting
wait    10
run     ls -l tmp/greeting
wait    6

shot    m4
cap     m4, the macro processor.  `define' names a macro with a parameter,
cap     and each later use of it is expanded -- here `greet(reader)'
cap     becomes a short welcome with the name filled in.  One thing needs
cap     more than this disk: `syscmd' forks a module called `shell' and is
cap     silent without one, so keep your own shell loaded.
try     m4 tmp/m.m4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "define(greet,hi \0441 -- welcome)" > tmp/m.m4
wait    5
run     echo "greet(reader)" >> tmp/m.m4
wait    5
run     cat tmp/m.m4
wait    5
run     m4 tmp/m.m4
wait    8

shot    m4_0.5
cap     A second build of the m4 macro processor.  It reads a macro
cap     definition and expands each use: `greet(world)' becomes
cap     `hello world'.
try     m4_0.5 tmp/BLGX/mm.m4
run     mkdir -p /dd/tmp/BLGX > /nil 2>/nil
run     printf 'define(greet,hello $1)greet(world)\r' > /dd/tmp/BLGX/mm.m4
run     builtin cd /dd
wait    1
run     clear
run     m4_0.5 tmp/BLGX/mm.m4
wait    5

shot    make
cap     `make' building a target from a shipped makefile: it runs the
cap     rule's command and names the file it made.  Run again with the
cap     target already up to date, it does nothing and stays silent.
try     make -f DOC/make/demo.mk greeting
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rm -f tmp/greeting
wait    5
run     make -f DOC/make/demo.mk greeting
wait    12
run     ls -l tmp/greeting
wait    8
run     make -f DOC/make/demo.mk greeting
wait    10

shot    makeinfo
cap     GNU makeinfo turns Texinfo source into Info files.  Its options
cap     take a leading `+', not the GNU-style `--', so `+version' answers
cap     where `--version' would not.
try     makeinfo +version
run     makeinfo +version
wait    6

shot    a2p
size    24 80
cap     a2p turns an awk program into a perl script.  count.awk adds up the
cap     words on each line and prints the line and word counts at the end;
cap     a2p writes the perl version, and perl runs it on the password file.
try     a2p count.awk > count.pl; perl count.pl password
run     rm -rf /dd/tmp/A2PC > /nil 2>/nil; mkdir -p /dd/tmp/A2PC
wait    2
run     builtin cd /dd/tmp/A2PC
wait    1
run     cp /dd/SYS/password password; echo '{ w += NF } END { print NR, w }' > count.awk
wait    2
run     clear
wait    1
run     cat count.awk
wait    2
run     a2p count.awk > count.pl
wait    6
run     perl count.pl password
wait    6

shot    p2c
size    36 80
cap     p2c translating Pascal into C, which is what it is for.  It writes
cap     `h.c' beside the source.  The warning is p2c's own and correct:
cap     nothing has told it what `writeln' is, because the Pascal run-time
cap     declarations live elsewhere and this one-line program does not ask
cap     for them.
try     p2c h.pas
run     mkdir -p /dd/tmp/P2C > /nil 2>/nil
run     echo "program hello; begin writeln('hi') end." > /dd/tmp/P2C/h.pas
run     builtin cd /dd/tmp/P2C
wait    4
run     clear
wait    1
run     cat h.pas
wait    4
run     p2c h.pas
wait    12
run     ls
wait    4
run     head -n 12 h.c
wait    8

shot    yacc
cap     yacc reading a grammar and writing `y.tab.c', the parser tables,
cap     into the data directory -- the two-rule grammar shown above.  It
cap     prints nothing on success; the listed file and its size confirm it
cap     finished.
try     yacc g.y
run     rm -f /dd/tmp/CMPA/g.y /dd/tmp/CMPA/y.tab.c; mkdir -p /dd/tmp/CMPA > /nil 2>/nil
run     printf "%%token NUM\r%%%%\rexpr : expr NUM | NUM ;\r" > /dd/tmp/CMPA/g.y
run     builtin cd /dd/tmp/CMPA
wait    3
run     clear
wait    1
run     cat g.y
wait    4
run     yacc g.y
wait    15
run     ls -l y.tab.c
wait    6

shot    fact
size    40 80
cap     The Fortran example, end to end: the source, this disk's compiler
cap     accepting it, and the finished program printing 1! to 12!.  Twelve is
cap     as far as a 32-bit integer reaches -- 13! overflows.
cap     RTF/68K compiles Fortran-77 to 68000 ASSEMBLY, so the step from
cap     `fact.a' to a program needs an assembler and a linker, which come
cap     with your OS-9 and not with this disk.  CMDS/fact was assembled and
cap     linked that way; everything else on this card is this disk doing the
cap     work.  Every RTF program wants the run-time library resident first,
cap     which is what `load os9lib' is for.
try     load os9lib; fact
run     rm -f /dd/tmp/FACT/fact.f /dd/tmp/FACT/fact.a; mkdir -p /dd/tmp/FACT > /nil 2>/nil
wait    3
run     cp /dd/SRC/rtf/fact.f /dd/tmp/FACT/fact.f
wait    3
run     load /dd/CMDS/os9lib
wait    5
run     builtin cd /dd/tmp/FACT
wait    1
run     clear
wait    1
run     cat fact.f
wait    4
run     rtf fact.f
wait    18
run     fact
wait    8

shot    rtf
cap     RTF/68K compiling Fortran-77: with its run-time library loaded
cap     first (`load os9lib'), `rtf' reads the source and writes 68k
cap     assembly beside it.  Assembling and linking that is `r68' and
cap     `l68', which come with your OS-9, so your system finishes the
cap     build.
try     rtf div.f
run     rm -f /dd/tmp/CMPA/div.f /dd/tmp/CMPA/div.a; mkdir -p /dd/tmp/CMPA > /nil 2>/nil
wait    3
run     cp /dd/SRC/rtf/div.f /dd/tmp/CMPA/div.f
wait    3
run     load /dd/CMDS/os9lib
wait    5
run     builtin cd /dd/tmp/CMPA
wait    1
run     clear
wait    1
run     rtf div.f
wait    18
run     ls -l div.a
wait    6

shot    for
cap     The RTF Fortran compile driver: it prints the `rtf' command it
cap     means to run, then stops, because it forks a separate shell to run
cap     it.  Called directly, `rtf' needs no shell and does the compile.
cap     At the bash prompt `for' is also the loop keyword, so it is reached
cap     by path.
try     .../CMDS/for div.f
os9     for div.f
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; cp /dd/SRC/rtf/div.f /dd/tmp/CMPA/div.f
wait    3
run     load /dd/CMDS/os9lib
wait    5
run     builtin cd /dd/tmp/CMPA
wait    1
run     clear
wait    1
run     .../CMDS/for div.f
wait    10

shot    lnk
cap     The RTF Fortran link driver: it prints the `l68' command it means
cap     to run -- the linker and library from your OS-9 -- and stops the
cap     same way `for' does, forking a shell to run it.
try     lnk div.f
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; cp /dd/SRC/rtf/div.f /dd/tmp/CMPA/div.f
wait    3
run     load /dd/CMDS/os9lib
wait    5
run     builtin cd /dd/tmp/CMPA
wait    1
run     clear
wait    1
run     lnk div.f
wait    10

shot    lnk.org
cap     The original build of `lnk', the RTF Fortran linker driver.  It
cap     wants `os9lib' resident, hands its command line to `shell', and
cap     calls `l68' to link -- the last two your own OS-9's, and all three
cap     loaded here, which is how it gets as far as the linker.  What it
cap     stops on is the Fortran start-up code, `fstart.r': its source is
cap     SRC/rtf/rtfstart.a and assembling it with your own `r68' completes
cap     the chain.  DOC/README-FORTRAN says so and lists what is here.
try     lnk.org div.f
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; cp /dd/SRC/rtf/div.f /dd/tmp/CMPA/div.f
wait    3
run     load /dd/CMDS/os9lib; load /h1/CMDS/shell; load /h1/CMDS/l68
wait    8
run     builtin cd /dd/tmp/CMPA
wait    1
run     clear
wait    1
run     lnk.org div.f
wait    10

shot    creadoc
size    28 90
cap     An early Fortran documentation generator: it walks the `.f' files
cap     in the data directory and copies each one's header comment into
cap     `creadoc.txt'.  It lists the directory through your own OS-9's
cap     `dir', and needs the Fortran run-time and a `shell' loaded too.
try     creadoc
run     rm -rf /dd/tmp/CRD; mkdir -p /dd/tmp/CRD; cp /dd/SRC/rtf/biory.f /dd/tmp/CRD/biory.f
wait    3
run     load /dd/CMDS/os9lib; load /h1/CMDS/shell; load /h1/CMDS/dir; load /h1/CMDS/del
wait    6
run     builtin cd /dd/tmp/CRD
wait    1
run     clear
wait    1
run     creadoc
wait    12
