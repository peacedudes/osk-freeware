# Compilers and build tools, each one actually building something.
# Most stanzas make what they read under /dd/tmp/CMPA.

shot    as0
size    30 90
cap     as0, the 6800/6802 cross-assembler: address, opcode bytes and the
cap     source line, then the symbol table.  `l' asks for the listing and
cap     `s' for the symbols, after a lone `-'.
try     as0 sample.a0 - l s
run     rm -rf /dd/tmp/XASM > /nil 2>/nil; mkdir -p /dd/tmp/XASM; cp /dd/DOC/xasm/sample.a0 /dd/tmp/XASM
wait    1
run     builtin cd /dd/tmp/XASM
wait    1
run     clear
wait    1
run     as0 sample.a0 - l s
wait    14

shot    as09
size    30 90
cap     as09, the 6809 assembler -- the one of the six xasm tools that
cap     targets the 6809 rather than the 6800 family; none of the six
cap     assembles 68000 code.  It says nothing and writes
cap     Motorola S-records beside the source: four instructions at $1000,
cap     in the format a ROM burner reads.
try     as09 t.a
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; rm -f /dd/tmp/CMPA/t.a /dd/tmp/CMPA/t.s19
run     echo "        org  \0441000" > /dd/tmp/CMPA/t.a
run     echo "        lda  #\04442" >> /dd/tmp/CMPA/t.a
run     echo "        sta  \0442000" >> /dd/tmp/CMPA/t.a
run     echo "        rts" >> /dd/tmp/CMPA/t.a
run     echo "        end" >> /dd/tmp/CMPA/t.a
run     builtin cd /dd/tmp/CMPA
wait    2
run     clear
wait    1
run     cat t.a
wait    4
run     as09 t.a
wait    12
run     cat t.s19
wait    8

shot    as1
size    30 90
cap     as1, the 6801/6803 cross-assembler.  The 6801 adds a hardware
cap     multiply and 16-bit accumulator arithmetic over the 6800, and the
cap     sample uses both.
try     as1 sample.a1 - l s
run     rm -rf /dd/tmp/XASM > /nil 2>/nil; mkdir -p /dd/tmp/XASM; cp /dd/DOC/xasm/sample.a1 /dd/tmp/XASM
wait    1
run     builtin cd /dd/tmp/XASM
wait    1
run     clear
wait    1
run     as1 sample.a1 - l s
wait    14

shot    as4
size    30 90
cap     as4, the 6804 cross-assembler.  Its instruction set is small: no
cap     clear on the pseudo-registers, no immediate compare.
try     as4 sample.a4 - l s
run     rm -rf /dd/tmp/XASM > /nil 2>/nil; mkdir -p /dd/tmp/XASM; cp /dd/DOC/xasm/sample.a4 /dd/tmp/XASM
wait    1
run     builtin cd /dd/tmp/XASM
wait    1
run     clear
wait    1
run     as4 sample.a4 - l s
wait    14

shot    as5
size    30 90
cap     as5, the 6805/68HC05 cross-assembler, shown on bit-set, bit-test
cap     and branch -- what the 6805 is for.
try     as5 sample.a5 - l s
run     rm -rf /dd/tmp/XASM > /nil 2>/nil; mkdir -p /dd/tmp/XASM; cp /dd/DOC/xasm/sample.a5 /dd/tmp/XASM
wait    1
run     builtin cd /dd/tmp/XASM
wait    1
run     clear
wait    1
run     as5 sample.a5 - l s
wait    14

shot    as11
size    30 90
cap     as11, the 68HC11 cross-assembler.  It lists by default -- no `-l'
cap     needed -- and treats any word after the file name as another
cap     source file rather than an option, so the `- l s' its siblings
cap     take is not for this one.
try     as11 sample.a11
run     rm -rf /dd/tmp/XASM > /nil 2>/nil; mkdir -p /dd/tmp/XASM; cp /dd/DOC/xasm/sample.a11 /dd/tmp/XASM
wait    1
run     builtin cd /dd/tmp/XASM
wait    1
run     clear
wait    1
run     as11 sample.a11
wait    14

shot    assembler
cap     A full-screen file picker that hands the file you choose to the
cap     assembler: a capital letter picks a file, a small one asks for
cap     parameters too, and `!' leaves.
try     assembler
run     assembler
wait    8
snap
send    !
wait    3

shot    compiler
cap     A full-screen file picker headed for the C compiler -- the same
cap     menu as `assembler', not a compiler itself.  Control-C leaves it.
try     compiler
run     compiler
wait    8
snap
send    \003
wait    3

shot    cpp
size    26 80
cap     Decus CPP on a file with a macro, an `#if' and a string: the macro
cap     is expanded with its argument, the true arm of the `#if' is kept and
cap     the false one dropped.  `-A' asks for ordinary `#line' markers; run
cap     without it, it writes the `#P' and `#5' markers Microware's own
cap     preprocessor pass emits, which is what it was built to stand in for.
try     cat t.c; cpp -A t.c
run     builtin cd /dd/tmp
wait    1
run     rm -rf /dd/tmp/cppdemo > /nil 2>/nil; mkdir -p /dd/tmp/cppdemo > /nil 2>/nil
wait    4
run     builtin cd /dd/tmp/cppdemo
wait    1
run     echo "#define GREET(who) \"hello, \" who" > t.c
wait    3
run     echo "#define N 3" >> t.c
wait    3
run     echo "#if N > 2" >> t.c
wait    3
run     echo "int big = N;" >> t.c
wait    3
run     echo "#else" >> t.c
wait    3
run     echo "int small = N;" >> t.c
wait    3
run     echo "#endif" >> t.c
wait    3
run     echo "char *s = GREET(\"world\");" >> t.c
wait    3
run     clear
wait    1
run     cat t.c
wait    5
run     cpp -A t.c
wait    8

shot    bison
cap     GNU bison on a two-rule grammar written for it, then the report
cap     `-v' leaves behind: the rules as bison read them, the terminals
cap     with the rules they appear in, and the numbers it gave them.  It
cap     prints nothing when it succeeds.
try     bison -v tmp/b.y
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "%token NUM" > tmp/b.y
wait    3
run     echo "%%" >> tmp/b.y
wait    3
run     echo "expr : expr NUM | NUM ;" >> tmp/b.y
wait    3
run     bison -v tmp/b.y
wait    15
run     head -n 12 tmp/b.output 2>/nil
wait    6

shot    flex
cap     flex turning a lexical description into C: the rules go in and the
cap     scanner `lex.yy.c' comes out.  The head of that generated file is
cap     shown below.
try     flex tmp/l.l
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "%%" > tmp/l.l
wait    5
run     echo "[0-9]+   { return NUM; }" >> tmp/l.l
wait    5
run     echo ".        ;" >> tmp/l.l
wait    5
run     flex tmp/l.l
wait    8
run     cat lex.yy.c | head -n 10
wait    5

shot    gcc
fresh
size    30 80
cap     GCC2's `gcc', the 1.42 driver, run from its own directory with
cap     `./' since it is off the command path.  -v prints each pass as it
cap     forks it: GCC 1.39's preprocessor and compiler, which it forks as
cap     `cccp' and `cc1', and your own OS-9's r68.  All three were loaded
cap     first -- `load CMDS/GCC139/gcc_cccp CMDS/GCC139/gcc_cc1' from /dd,
cap     and r68 from your OS-9 -- and hello.r is the object it made.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./gcc -v -c hello.c
run     load /dd/CMDS/GCC139/gcc_cccp /dd/CMDS/GCC139/gcc_cc1 /h1/CMDS/r68
wait    3
run     builtin cd /dd/CMDS/GCC2
wait    2
run     rm -f hello.c hello.r
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    2
run     ./gcc -v -c hello.c
wait    14
run     ls hello.*
wait    3
snap
run     rm -f hello.c hello.r
wait    1

shot    gcc137
for     gcc137
cap     `gcc137', GNU C 1.37.1 as CERN distributed it in 1991, run from
cap     its own directory.  -B names its passes (gcc137_cccp, gcc137_cc1)
cap     by the path of their prefix -- $PWD, as the shell keeps it, is that
cap     directory; asked to stop at assembly (`-S') it writes 68k assembly
cap     for your own r68 to assemble.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./gcc137 -B$PWD/gcc137_ -S hello.c; cat hello.a
run     builtin cd /dd/CMDS/GCC137; PWD=/dd/CMDS/GCC137
wait    2
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    2
run     ./gcc137 -B$PWD/gcc137_ -S hello.c
wait    8
run     cat hello.a
wait    3
snap
run     rm -f hello.c hello.a hello.s
wait    1

shot    gcc272
size    30 80
cap     `gcc272', GNU C and C++ 2.7.2, run from its own directory.  It
cap     forks its passes by name, so GCC2_OPTS points it at each one with
cap     -F, by the path $PWD gives; asked to stop at assembly (`-S') it
cap     writes 68k assembly for your own r68.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; export GCC2_OPTS="-Fcccp2x[$PWD/gcc272_cccp2] -Fcc2x[$PWD/gcc272_cc2]"; ./gcc272 -S hello.c
run     builtin cd /dd/CMDS/GCC272; PWD=/dd/CMDS/GCC272
wait    2
run     rm -f hello.c hello.a
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    1
run     export GCC2_OPTS="-Fcccp2x[$PWD/gcc272_cccp2] -Fcc2x[$PWD/gcc272_cc2]"
wait    1
run     ./gcc272 -S hello.c
wait    8
run     cat hello.a
wait    3
snap
run     rm -f hello.c hello.a
wait    1

shot    gcc272_collect
fresh
size    30 80
cap     GNU C++ 2.7.2's collect2, which gcc272 runs at every link: it
cap     builds the table of global constructors and destructors a C++
cap     program needs.  greet.r is greet.cc compiled with `gpp -c' -- one
cap     global object whose class has a constructor.  This collect reads
cap     the whole link, so it is given what gcc272 would give it: your
cap     OS-9's cstart.r, clibn.l and sys.l, and GNULIB's libgcc000.l,
cap     copied beside greet.r, the last as gcc.l.  The table in c.a names
cap     the constructor.
try     gcc272_collect -o c.a cstart.r greet.r -l=gcc.l -l=clibn.l -l=sys.l
run     load /h1/CMDS/r68
run     export PATH=$PATH:/dd/CMDS/GCC272
run     rm -rf /dd/tmp/CL272; mkdir -p /dd/tmp/CL272; builtin cd /dd/tmp/CL272
run     cp /h1/LIB/cstart.r /h1/LIB/clibn.l /h1/LIB/sys.l .; cp /dd/GNULIB/libgcc000.l gcc.l
run     printf "class Greeter {\rpublic:\r  Greeter() { n = 1; }\r  int n;\r};\rGreeter hello;\rint main()\r{\r  return hello.n;\r}\r" > greet.cc
run     /dd/CMDS/GCC2/gpp -c greet.cc -o greet.r > /nil 2>/nil
wait    12
run     clear
wait    1
run     cat greet.cc
wait    2
run     gcc272_collect -o c.a cstart.r greet.r -l=gcc.l -l=clibn.l -l=sys.l
wait    10
run     cat c.a
wait    3

shot    gcc137_cccp
cap     GNU C 1.37.1's preprocessor, one of the passes gcc137 runs, given
cap     a small C file by hand, in its own directory: ANSWER is expanded
cap     to 42, and the `# 1 "..."' line marks where the source began.
try     ./gcc137_cccp hello.c
run     builtin cd /dd/CMDS/GCC137
wait    1
run     printf "#define ANSWER 42\rint main()\r{\r  return ANSWER;\r}\r" > hello.c
run     clear
wait    1
run     cat hello.c
wait    2
run     ./gcc137_cccp hello.c
wait    6
snap
run     rm -f hello.c
wait    1

shot    gcc137_cc1
cap     GNU C 1.37.1's compiler proper, given preprocessed C by hand: it
cap     writes 68k assembly for your own r68 -- a stack check, then the
cap     function itself, returning 42.
try     ./gcc137_cc1 hello.i -o hello.a -quiet; cat hello.a
run     builtin cd /dd/CMDS/GCC137
wait    1
run     printf "int main()\r{\r  return 42;\r}\r" > hello.i
run     clear
wait    1
run     cat hello.i
wait    2
run     ./gcc137_cc1 hello.i -o hello.a -quiet; cat hello.a
wait    8
snap
run     rm -f hello.i hello.a
wait    1

shot    gcc272_cccp2
cap     GNU C 2.7.2's preprocessor, one of the passes gcc272 runs, given a
cap     small C file by hand, in its own directory: the macro is expanded
