# Compilers and build tools, each one actually building something.
# Most stanzas make what they read under /dd/tmp/CMPA.

shot    as0
size    30 90
cap     as0, the 6800/6802 cross-assembler: address, opcode bytes and the
cap     source line, then the symbol table.  `l' asks for the listing and
cap     `s' for the symbols, after a lone `-'.
try     as0 sample.a0 - l s
run     rm -rf /dd/tmp/XASM > /nil 2>/nil; mkdir -p /dd/tmp/XASM; cp /dd/DOC/xasm/sample.a0 /dd/tmp/XASM
wait    1
run     builtin cd /dd/tmp/XASM
wait    1
run     clear
wait    1
run     as0 sample.a0 - l s
wait    14

shot    as09
size    30 90
cap     as09, the 6809 assembler -- the one of the six xasm tools that
cap     assembles for the 6809 itself, not one of its 8-bit relatives;
cap     none of the six assembles 68000 code.  It says nothing and writes
cap     Motorola S-records beside the source: four instructions at $1000,
cap     in the format a ROM burner reads.
try     as09 t.a
run     mkdir -p /dd/tmp/CMPA > /nil 2>/nil; rm -f /dd/tmp/CMPA/t.a /dd/tmp/CMPA/t.s19
run     echo "        org  \0441000" > /dd/tmp/CMPA/t.a
run     echo "        lda  #\04442" >> /dd/tmp/CMPA/t.a
run     echo "        sta  \0442000" >> /dd/tmp/CMPA/t.a
run     echo "        rts" >> /dd/tmp/CMPA/t.a
run     echo "        end" >> /dd/tmp/CMPA/t.a
run     builtin cd /dd/tmp/CMPA
wait    2
run     clear
wait    1
run     cat t.a
wait    4
run     as09 t.a
wait    12
run     cat t.s19
wait    8

shot    as1
size    30 90
cap     as1, the 6801/6803 cross-assembler.  The 6801 adds a hardware
cap     multiply and 16-bit accumulator arithmetic over the 6800, and the
cap     sample uses both.
try     as1 sample.a1 - l s
run     rm -rf /dd/tmp/XASM > /nil 2>/nil; mkdir -p /dd/tmp/XASM; cp /dd/DOC/xasm/sample.a1 /dd/tmp/XASM
wait    1
run     builtin cd /dd/tmp/XASM
wait    1
run     clear
wait    1
run     as1 sample.a1 - l s
wait    14

shot    as4
size    30 90
cap     as4, the 6804 cross-assembler.  Its instruction set is small: no
cap     clear on the pseudo-registers, no immediate compare.
try     as4 sample.a4 - l s
run     rm -rf /dd/tmp/XASM > /nil 2>/nil; mkdir -p /dd/tmp/XASM; cp /dd/DOC/xasm/sample.a4 /dd/tmp/XASM
wait    1
run     builtin cd /dd/tmp/XASM
wait    1
run     clear
wait    1
run     as4 sample.a4 - l s
wait    14

shot    as5
size    30 90
cap     as5, the 6805/68HC05 cross-assembler, shown on bit-set, bit-test
cap     and branch -- what the 6805 is for.
try     as5 sample.a5 - l s
run     rm -rf /dd/tmp/XASM > /nil 2>/nil; mkdir -p /dd/tmp/XASM; cp /dd/DOC/xasm/sample.a5 /dd/tmp/XASM
wait    1
run     builtin cd /dd/tmp/XASM
wait    1
run     clear
wait    1
run     as5 sample.a5 - l s
wait    14

shot    as11
size    30 90
cap     as11, the 68HC11 cross-assembler.  It lists by default -- no `-l'
cap     needed -- and treats any word after the file name as another
cap     source file rather than an option, so the `- l s' its siblings
cap     take is not for this one.
try     as11 sample.a11
run     rm -rf /dd/tmp/XASM > /nil 2>/nil; mkdir -p /dd/tmp/XASM; cp /dd/DOC/xasm/sample.a11 /dd/tmp/XASM
wait    1
run     builtin cd /dd/tmp/XASM
wait    1
run     clear
wait    1
run     as11 sample.a11
wait    14

shot    assembler
cap     A full-screen file picker that hands a chosen file to the
cap     assembler family; not an assembler itself.  Control-C leaves it;
cap     q, Q, control-D and ESC do not.
try     assembler
run     assembler
wait    8
snap
send    \003
wait    3

shot    compiler
cap     A full-screen file picker headed for the C compiler -- the same
cap     menu as `assembler', not a compiler itself.  Control-C leaves it.
try     compiler
run     compiler
wait    8
snap
send    \003
wait    3

shot    cpp
size    26 80
cap     Decus CPP on a file with a macro, an `#if' and a string: the macro
cap     is expanded with its argument, the true arm of the `#if' is kept and
cap     the false one dropped.  `-A' asks for ordinary `#line' markers; run
cap     without it, it writes the `#P' and `#5' markers Microware's own
cap     preprocessor pass emits, which is what it was built to stand in for.
try     cat t.c; cpp -A t.c
run     builtin cd /dd/tmp
wait    1
run     rm -rf /dd/tmp/cppdemo > /nil 2>/nil; mkdir -p /dd/tmp/cppdemo > /nil 2>/nil
wait    4
run     builtin cd /dd/tmp/cppdemo
wait    1
run     echo "#define GREET(who) \"hello, \" who" > t.c
wait    3
run     echo "#define N 3" >> t.c
wait    3
run     echo "#if N > 2" >> t.c
wait    3
run     echo "int big = N;" >> t.c
wait    3
run     echo "#else" >> t.c
wait    3
run     echo "int small = N;" >> t.c
wait    3
run     echo "#endif" >> t.c
wait    3
run     echo "char *s = GREET(\"world\");" >> t.c
wait    3
run     clear
wait    1
run     cat t.c
wait    5
run     cpp -A t.c
wait    8

shot    bison
cap     GNU bison on a two-rule grammar written for it, then the report
cap     `-v' leaves behind: the rules as bison read them, the terminals
cap     with the rules they appear in, and the numbers it gave them.  It
cap     prints nothing when it succeeds.
try     bison -v tmp/b.y
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "%token NUM" > tmp/b.y
wait    3
run     echo "%%" >> tmp/b.y
wait    3
run     echo "expr : expr NUM | NUM ;" >> tmp/b.y
wait    3
run     bison -v tmp/b.y
wait    15
run     head -n 12 tmp/b.output 2>/nil
wait    6

shot    flex
cap     flex turning a lexical description into C: the rules go in and the
cap     scanner `lex.yy.c' comes out.  The head of that generated file is
cap     shown below.
try     flex tmp/l.l
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "%%" > tmp/l.l
wait    5
run     echo "[0-9]+   { return NUM; }" >> tmp/l.l
wait    5
run     echo ".        ;" >> tmp/l.l
wait    5
run     flex tmp/l.l
wait    8
run     cat lex.yy.c | head -n 10
wait    5

shot    gcc
cap     The GCC drivers live in their own directory, off the command
cap     path, so each is run from there with `./'.  This is `gcc', the
cap     older driver, reporting version 1.42.  Asked to compile it prints
cap     the preprocessor command it wants, then stops: it looks for a pass
cap     called `cccp'.  DOC/rayshade shows how to put one there --
cap     `copy CMDS/GCC139/gcc_cccp cccp' in the directory it looks in.
cap     The drivers that need nothing extra are `gcc2' and `gpp'.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./gcc -v -c hello.c
run     builtin cd /dd/CMDS/GCC2
wait    3
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    3
wait    1
run     ./gcc -v
wait    6
run     ./gcc -v -c hello.c
wait    10

shot    gcc137
for     gcc137
cap     `gcc137', GNU C 1.37.1 as CERN distributed it in 1991, run from
cap     its own directory.  -B names its passes (gcc137_cccp, gcc137_cc1)
cap     by the path of their prefix -- $PWD, as the shell keeps it, is that
cap     directory; asked to stop at assembly (`-S') it writes 68k assembly
cap     for your own r68 to assemble.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./gcc137 -B$PWD/gcc137_ -S hello.c; cat hello.a
run     builtin cd /dd/CMDS/GCC137; PWD=/dd/CMDS/GCC137
wait    2
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    2
run     ./gcc137 -B$PWD/gcc137_ -S hello.c
wait    8
run     ls hello.*; cat hello.a
wait    2
run     rm -f hello.c hello.a hello.s
wait    1

shot    gcc272
for     gcc272 gcc272_collect
cap     `gcc272', GNU C and C++ 2.7.2, the newest gcc here, run from its own
cap     directory.  It forks its passes by name, so GCC2_OPTS points it at
cap     each one with -F, by the path $PWD gives; asked to stop at assembly
cap     (`-S') it writes 68k assembly for your own r68.
try     export GCC2_OPTS="-Fcccp2x[$PWD/gcc272_cccp2] -Fcc2x[$PWD/gcc272_cc2]"; ./gcc272 -S hello.c
run     builtin cd /dd/CMDS/GCC272; PWD=/dd/CMDS/GCC272
wait    2
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
run     clear
wait    1
run     export GCC2_OPTS="-Fcccp2x[$PWD/gcc272_cccp2] -Fcc2x[$PWD/gcc272_cc2]"
wait    1
run     ./gcc272 -S hello.c
wait    8
run     cat hello.a
wait    2
run     rm -f hello.c hello.a
wait    1

shot    gcc137_cccp
cap     GNU C 1.37.1's preprocessor, one of the passes gcc137 runs, given
cap     a small C file by hand, in its own directory: the macro is
cap     expanded, and the `# 1 "..."' line marks where the source began.
try     ./gcc137_cccp hello.c
run     builtin cd /dd/CMDS/GCC137
wait    1
run     printf "#define ANSWER 42\rint main()\r{\r  return ANSWER;\r}\r" > hello.c
run     clear
wait    1
run     ./gcc137_cccp hello.c
wait    6
snap
run     rm -f hello.c
wait    1

shot    gcc137_cc1
cap     GNU C 1.37.1's compiler proper, given preprocessed C by hand: it
cap     writes 68k assembly for your own r68 -- a stack check, then the
cap     function itself.
try     ./gcc137_cc1 hello.i -o hello.a -quiet; cat hello.a
run     builtin cd /dd/CMDS/GCC137
wait    1
run     printf "int main()\r{\r  return 42;\r}\r" > hello.i
run     clear
wait    1
run     ./gcc137_cc1 hello.i -o hello.a -quiet; cat hello.a
wait    8
snap
run     rm -f hello.i hello.a
wait    1

shot    gcc272_cccp2
cap     GNU C 2.7.2's preprocessor, one of the passes gcc272 runs, given a
cap     small C file by hand, in its own directory: the macro is expanded
cap     and the `# 1' line marks where the source began.
try     ./gcc272_cccp2 hello.c hello.i; cat hello.i
run     builtin cd /dd/CMDS/GCC272
wait    1
run     printf "#define ANSWER 42\rint main()\r{\r  return ANSWER;\r}\r" > hello.c
run     clear
wait    1
run     ./gcc272_cccp2 hello.c hello.i; cat hello.i
wait    6
snap
run     rm -f hello.c hello.i
wait    1

shot    gcc272_cc2
cap     GNU C 2.7.2's compiler proper, given preprocessed C by hand: it
cap     writes 68k assembly for your own r68.
try     ./gcc272_cc2 hello.i -o hello.a -quiet; cat hello.a
run     builtin cd /dd/CMDS/GCC272
wait    1
run     printf "int main()\r{\r  return 42;\r}\r" > hello.i
run     clear
wait    1
run     ./gcc272_cc2 hello.i -o hello.a -quiet; cat hello.a
wait    10
snap
run     rm -f hello.i hello.a
wait    1

shot    gcc272_cc2plus
cap     GNU C 2.7.2's C++ compiler proper, given a small class by hand: it
cap     writes 68k assembly for your own r68, the member function under its
cap     C++ mangled name, f__1G.
try     ./gcc272_cc2plus hello.ii -o hello.a -quiet; cat hello.a
run     builtin cd /dd/CMDS/GCC272
wait    1
run     printf "class G { public: int f() { return 42; } };\rint main() { G g; return g.f(); }\r" > hello.ii
run     clear
wait    1
run     ./gcc272_cc2plus hello.ii -o hello.a -quiet; cat hello.a
wait    12
snap
run     rm -f hello.ii hello.a
wait    1

shot    gcc2
cap     `gcc2', the GCC 2.5.6 C driver, run from its own directory since
cap     it is off the command path.  Asked to stop at assembly (`-S') it
cap     succeeds, writing 68k assembly in Microware syntax -- `psect',
cap     `link.w a5,#0'.  Asked to go all the way it compiles and then
cap     calls `r68' to assemble, the 68k assembler that comes with your
cap     OS-9.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./gcc2 -S -o hello.a hello.c
run     builtin cd /dd/CMDS/GCC2
wait    3
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    3
wait    1
run     ./gcc2 -S -o hello.a hello.c
wait    12
run     cat hello.a | head -n 8
wait    5
run     ./gcc2 -o hello hello.c
wait    10

shot    gpp
cap     `gpp', the GCC2 C++ driver (1.40.3), run from its own directory.
cap     It runs the whole pipeline -- `gpp_cccp' preprocesses,
cap     `gpp_cc1plus' compiles to assembly -- then calls `r68' to
cap     assemble, which comes with your OS-9.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./gpp -v -c hello.c
run     builtin cd /dd/CMDS/GCC2
wait    3
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    3
wait    1
run     ./gpp -v -c hello.c
wait    16

shot    cccp2
fresh
cap     The GCC 2.x preprocessor pass, expanding a small C file.  The
cap     `# 1 "..."' line is the source marker it adds; there are no macros
cap     here to expand.  It is run from the GCC2 directory, off the
cap     command path.
try     printf "int main()\r{\r  return 0;\r}\r" > hello.c; ./cccp2 hello.c hello.i
run     builtin cd /dd/CMDS/GCC2
wait    3
run     clear
wait    1
run     printf "int main()\r{\r  return 0;\r}\r" > hello.c
wait    3
wait    1
run     ./cccp2 hello.c hello.i
wait    8
run     cat hello.i
wait    5

shot    cc2
fresh
cap     The GCC 2.x C compiler pass -- the stage that turns preprocessed
cap     C into assembly.  The driver runs it for you; on its own it
cap     reports its version and the code-generation options it was built
cap     with.
try     ./cc2 -version
run     builtin cd /dd/CMDS/GCC2
wait    1
run     clear
run     ./cc2 -version
wait    8

shot    cc1plus
fresh
cap     A GCC C++ compiler pass (version 1.40.3) from the GCC2 directory.
cap     The driver calls it; run alone it reports its version.
try     ./cc1plus -version
run     builtin cd /dd/CMDS/GCC2
wait    1
run     clear
run     ./cc1plus -version
wait    8

shot    cc2plus
fresh
cap     A second C++ compiler pass (version 2.5.8) in the GCC2 directory,
cap     reporting its version and code-generation options.
try     ./cc2plus -version
run     builtin cd /dd/CMDS/GCC2
wait    1
run     clear
run     ./cc2plus -version
wait    8

shot    collect
fresh
cap     collect2, which builds the table of global constructors and
cap     destructors a C++ program needs before linking.  Given the object
cap     `gpp -c' made of a file with one global object, `hello', whose
cap     class has a constructor, it writes the assembly for that table
cap     into the file -o names: one constructor, _GLOBAL_$I$main, and no
cap     destructors.  It lives in the GCC2 directory, off the command
cap     path, and is run from there with `./'.  gpp assembles with your
cap     own OS-9's r68, resident.
cap     This 1991 build tests its scan pointer before it sets it, so
cap     where its memory lands can leave the table empty (`dc.l 0');
cap     gcc272_collect is built from the source that fixes it.
try     ./collect -o ctors.a greet.r; cat ctors.a
run     load /h1/CMDS/r68
run     builtin cd /dd/CMDS/GCC2
run     rm -f greet.cc greet.r
run     printf "class Greeter {\rpublic:\r  Greeter() { n = 1; }\r  int n;\r};\rGreeter hello;\rint main()\r{\r  return hello.n;\r}\r" > greet.cc
run     ./gpp -c greet.cc -o greet.r > /nil 2>/nil
wait    12
run     clear
wait    1
run     ./collect -o ctors.a greet.r
wait    8
run     cat ctors.a
wait    3
snap
run     rm -f greet.cc greet.r ctors.a
wait    1

