# Compilers and build tools, each one actually building something.
shot    as09
cap     as09 assembling 6809 source and listing it: address, object bytes
cap     and source, side by side.  A 6809 cross-assembler on a 68000.
run     echo "        org  \$1000" > /dd/tmp/t.a
wait    2
run     echo "start   lda  #\$41" >> /dd/tmp/t.a
wait    2
run     echo "        jsr  \$A282" >> /dd/tmp/t.a
wait    2
run     echo "        rts" >> /dd/tmp/t.a
wait    2
run     echo "        end  start" >> /dd/tmp/t.a
wait    2
run     /dd/CMDS/as09 -l /dd/tmp/t.a
wait    8

shot    m4
cap     m4, the macro processor, defining a macro and expanding it.
run     echo "define(GREET, Hello \$1 from OS-9)GREET(reader)" > /dd/tmp/m.m4
wait    3
run     /dd/CMDS/m4 /dd/tmp/m.m4
wait    5

shot    make
cap     make maintaining a file from a rule -- the rule fires, and running
cap     it again says there is nothing to do.
run     echo "hello: /dd/SYS/motd" > /dd/tmp/Makefile
wait    2
run     printf "\t/dd/CMDS/cat /dd/SYS/motd > /dd/tmp/hello\n" >> /dd/tmp/Makefile
wait    3
run     /dd/CMDS/make -f /dd/tmp/Makefile hello
wait    6
run     /dd/CMDS/make -f /dd/tmp/Makefile hello
wait    5

shot    yacc
cap     yacc reading a grammar and reporting what it built -- the states
cap     and the conflicts, which is how you know a grammar is ambiguous.
run     echo "%token NUM" > /dd/tmp/g.y
wait    2
run     printf "%%%%\nexpr : expr '+' NUM | NUM ;\n" >> /dd/tmp/g.y
wait    3
run     /dd/CMDS/yacc -v /dd/tmp/g.y
wait    8
run     /dd/CMDS/head -n 12 y.output
wait    5

shot    bison
cap     GNU bison 1.19 on the same grammar, with its statistics.
run     /dd/CMDS/bison -v /dd/tmp/g.y
wait    10

shot    flex
cap     flex turning a lexical description into C.
run     printf "%%%%\n[0-9]+   { return NUM; }\n.        ;\n" > /dd/tmp/l.l
wait    3
run     /dd/CMDS/flex /dd/tmp/l.l
wait    8
run     /dd/CMDS/head -n 10 lex.yy.c
wait    5

shot    p2c
cap     p2c translating Pascal to C -- the head of the C it wrote for a
cap     program on this disk.
run     /dd/CMDS/p2c /dd/SRC/i_am_i/i_am_i.pas
wait    10
kill

shot    gmake
cap     GNU make, and dmake beside it, both saying what they are.
run     /dd/CMDS/gmake -v
wait    5
run     /dd/CMDS/dmake -V
wait    5
