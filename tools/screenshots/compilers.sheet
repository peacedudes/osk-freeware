wait    1
run     rm -f tmp/greeting
wait    4
run     dmake -V
wait    5
run     dmake -f DOC/make/demo.mk greeting
wait    10
run     ls -l tmp/greeting
wait    6

shot    m4
cap     m4, the macro processor.  `define' names a macro with a parameter,
cap     and each later use of it is expanded -- here `greet(reader)'
cap     becomes a short welcome with the name filled in -- and `syscmd'
cap     runs a command where it stands, through your own OS-9's `shell',
cap     which SYS/login loads from /h1; without it syscmd is silent.
try     m4 tmp/m.m4
run     load /h1/CMDS/shell
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "define(greet,hi \0441 -- welcome)" > tmp/m.m4
wait    5
run     echo "greet(reader)" >> tmp/m.m4
wait    5
run     echo "syscmd(whoami)" >> tmp/m.m4
wait    5
run     cat tmp/m.m4
wait    5
run     m4 tmp/m.m4
wait    8

shot    m4_0.5
cap     The same GNU m4 0.5 as m4, kept in REBUILT under its version
cap     name.  It reads a macro definition and expands each use:
cap     `greet(world)' becomes `hello world'.
try     m4_0.5 tmp/BLGX/mm.m4
run     mkdir -p /dd/tmp/BLGX > /nil 2>/nil
run     printf 'define(greet,hello $1)greet(world)\r' > /dd/tmp/BLGX/mm.m4
run     builtin cd /dd
wait    1
run     clear
run     m4_0.5 tmp/BLGX/mm.m4
wait    5

shot    make
cap     `make' building a target from a shipped makefile.  It prints each
cap     command after `os9exec() :', the name of the C library call it
cap     starts the command with, then ls shows the file made.  Run again
cap     with the target up to date, it does nothing and stays silent.
try     make -f DOC/make/demo.mk greeting
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rm -f tmp/greeting
wait    5
run     make -f DOC/make/demo.mk greeting
wait    12
run     ls -l tmp/greeting
wait    8
run     make -f DOC/make/demo.mk greeting
wait    10

shot    makeinfo
size    36 80
cap     GNU makeinfo turning a small Texinfo file into Info: the file it
cap     writes is named by @setfilename, and each @node becomes a node an
cap     Info reader can move between.  Its options take a leading `+', not
cap     `--' -- `makeinfo +version'.
try     makeinfo hi.texi
run     rm -rf /dd/tmp/MKI; mkdir -p /dd/tmp/MKI; builtin cd /dd/tmp/MKI
run     printf '\\input texinfo\r@setfilename hi.info\r@settitle Hi\r@node Top\r@chapter Hi\r\rA small manual.\r@bye\r' > hi.texi
wait    2
run     clear
wait    1
run     cat hi.texi
wait    2
run     makeinfo hi.texi
wait    8
run     cat hi.info
wait    3

shot    a2p
size    24 80
cap     a2p turns an awk program into a perl script.  count.awk adds up the
cap     words on each line and prints the line and word counts at the end;
cap     a2p writes the perl version, and perl runs it on the password file.
try     a2p count.awk > count.pl; perl count.pl password
run     rm -rf /dd/tmp/A2PC > /nil 2>/nil; mkdir -p /dd/tmp/A2PC
wait    2
run     builtin cd /dd/tmp/A2PC
wait    1
run     cp /dd/SYS/password password; echo '{ w += NF } END { print NR, w }' > count.awk
wait    2
run     clear
wait    1
run     cat count.awk
wait    2
run     a2p count.awk > count.pl
wait    6
run     perl count.pl password
wait    6

shot    p2c
size    36 80
cap     p2c translating Pascal into C.  It writes
cap     `h.c' beside the source.  The warning is p2c's own and correct:
cap     nothing has told it what `writeln' is, because the Pascal run-time
cap     declarations live elsewhere and this one-line program does not ask
cap     for them.
try     p2c h.pas
run     mkdir -p /dd/tmp/P2C > /nil 2>/nil
run     echo "program hello; begin writeln('hi') end." > /dd/tmp/P2C/h.pas
run     builtin cd /dd/tmp/P2C
wait    4
run     clear
wait    1
run     cat h.pas
wait    4
run     p2c h.pas
wait    12
run     ls
wait    4
run     head -n 12 h.c
wait    8

shot    yacc
cap     yacc reading a grammar and writing `y.tab.c', the parser tables,
cap     into the data directory -- the two-rule grammar shown above.  It
cap     prints nothing on success; the listed file and its size confirm it
cap     finished.
try     yacc g.y
run     rm -f /dd/tmp/CMPA/g.y /dd/tmp/CMPA/y.tab.c; mkdir -p /dd/tmp/CMPA > /nil 2>/nil
run     printf "%%token NUM\r%%%%\rexpr : expr NUM | NUM ;\r" > /dd/tmp/CMPA/g.y
run     builtin cd /dd/tmp/CMPA
wait    3
run     clear
wait    1
run     cat g.y
wait    4
run     yacc g.y
wait    15
run     ls -l y.tab.c
wait    6

shot    fact
size    50 80
cap     The Fortran example built by hand, one command at a time: rtf
cap     compiles fact.f to 68000 assembly, r68 assembles it and the
cap     Fortran start-up code rtfstart.a from SRC/rtf, l68 links both
cap     against sys.l, and fact prints 1! to 12!.  r68, l68, sys.l and the
cap     oskdefs.d r68 reads are your own OS-9's; `load os9lib' came first.
cap     l68 writes the program to your execution directory, CMDS, over the
cap     fact that ships.
try     rtf fact.f
run     rm -rf /dd/tmp/FACT > /nil 2>/nil; mkdir -p /dd/tmp/FACT
wait    3
run     cp /dd/SRC/rtf/fact.f /dd/SRC/rtf/rtfstart.a /h1/DEFS/oskdefs.d /h1/LIB/sys.l /dd/tmp/FACT; rm -f /dd/CMDS/fact
wait    4
run     load /dd/CMDS/os9lib /h1/CMDS/r68 /h1/CMDS/l68
wait    5
run     builtin cd /dd/tmp/FACT
wait    1
run     clear
wait    1
run     cat fact.f
wait    4
run     rtf fact.f
wait    15
run     r68 -q fact.a -o=fact.r
wait    8
run     r68 -q rtfstart.a -o=rtfstart.r
wait    8
run     l68 rtfstart.r fact.r -l=sys.l -o=fact
wait    8
run     fact
wait    8

shot    rtf
cap     RTF/68K compiling Fortran-77: with its run-time library loaded
cap     first (`load os9lib'), `rtf' reads the source and writes 68k
cap     assembly beside it.  Assembling and linking that is `r68' and
cap     `l68', which come with your OS-9, so your system finishes the
cap     build.
try     rtf div.f
run     rm -f /dd/tmp/CMPA/div.f /dd/tmp/CMPA/div.a; mkdir -p /dd/tmp/CMPA > /nil 2>/nil
wait    3
run     cp /dd/SRC/rtf/div.f /dd/tmp/CMPA/div.f
wait    3
run     load /dd/CMDS/os9lib
wait    5
run     builtin cd /dd/tmp/CMPA
wait    1
run     clear
wait    1
run     rtf div.f
wait    18
run     ls -l div.a
wait    6

shot    for
size    40 80
cap     The RTF Fortran compile driver: `for fact' compiles fact.f with
cap     `rtf', assembles the result with `r68' and deletes the assembly,
cap     printing each command as it runs it through `shell'.  Then `lnk
cap     fact' links it into a program and `fact' runs it: 1! to 12!.  The
cap     shell, r68, l68 and del are your own OS-9's, loaded from /h1 with
cap     the Fortran run-time, os9lib.  lnk installs into CMDS.  At bash
cap     `for' is also the loop keyword,
cap     so there it is `command for'; at the OS-9 shell just `for'.
try     command for fact; lnk fact; fact
os9     for fact; lnk fact; fact
run     rm -rf /dd/tmp/FORA > /nil 2>/nil; mkdir -p /dd/tmp/FORA; cp /dd/SRC/rtf/fact.f /dd/tmp/FORA; cp /h1/LIB/sys.l /dd/LIB; rm -f /dd/CMDS/fact
wait    4
run     load /dd/CMDS/os9lib /h1/CMDS/shell /h1/CMDS/r68 /h1/CMDS/l68 /h1/CMDS/del
wait    5
run     builtin cd /dd/tmp/FORA
wait    1
run     clear
wait    1
run     command for fact
wait    15
run     lnk fact
wait    10
run     fact
wait    6

shot    lnk
cap     The RTF Fortran link driver: `lnk fact' links fact.r with the
cap     Fortran start-up code and Microware's `sys.l' into a program, and
cap     prints the `l68' command it runs.  It looks for both in LIB on /h0
cap     and writes the program to CMDS there, as its authors' systems were
cap     laid out.  The start-up code,
cap     rtfstart.r, ships in LIB from the RTF archive; sys.l is your own
cap     OS-9's, copied into LIB from /h1.  fact was compiled with `for' and
cap     the fact that ships removed first, so the fact that runs is the one
cap     lnk just made.
try     lnk fact
run     rm -rf /dd/tmp/LNKA > /nil 2>/nil; mkdir -p /dd/tmp/LNKA; cp /dd/SRC/rtf/fact.f /dd/tmp/LNKA; cp /h1/LIB/sys.l /dd/LIB; rm -f /dd/CMDS/fact
wait    4
run     load /dd/CMDS/os9lib /h1/CMDS/shell /h1/CMDS/r68 /h1/CMDS/l68 /h1/CMDS/del
wait    5
run     builtin cd /dd/tmp/LNKA
wait    1
run     command for fact > /nil
wait    15
run     clear
wait    1
run     lnk fact
wait    10
run     fact
wait    6

shot    lnk.org
cap     The original build of `lnk', the RTF Fortran link driver.  It does
cap     the same job and names the start-up code `fstart.r' where lnk says
cap     `rtfstart.r' -- the same SRC/rtf/rtfstart.a, assembled under the
cap     other name into LIB on /h0, beside Microware's `sys.l'.  With fact
cap     compiled by `for' and sys.l in LIB, it links fact.r without a
cap     word, and the program runs.
try     lnk.org fact
run     rm -rf /dd/tmp/LNKB > /nil 2>/nil; mkdir -p /dd/tmp/LNKB /dd/LIB; cp /dd/SRC/rtf/fact.f /dd/SRC/rtf/rtfstart.a /h1/DEFS/oskdefs.d /dd/tmp/LNKB; cp /h1/LIB/sys.l /dd/LIB; rm -f /dd/CMDS/fact
wait    4
run     load /dd/CMDS/os9lib /h1/CMDS/shell /h1/CMDS/r68 /h1/CMDS/l68 /h1/CMDS/del
wait    5
run     builtin cd /dd/tmp/LNKB
wait    1
run     r68 -q rtfstart.a -o=/dd/LIB/fstart.r
wait    5
run     command for fact > /nil
wait    15
run     clear
wait    1
run     lnk.org fact
wait    10
run     fact
wait    6

shot    v7make
size    24 80
cap     count depends on poem, and count does not exist, so v7make prints
cap     `wc poem' and runs it, through your own OS-9's `shell', loaded
cap     first.
try     v7make count
run     load /h1/CMDS/shell
wait    3
run     rm -rf /dd/tmp/VMK > /nil 2>/nil; mkdir -p /dd/tmp/VMK
wait    3
run     cp /dd/DOC/samples/jabber.txt /dd/tmp/VMK/poem; printf "count: poem\r\twc poem\r" > /dd/tmp/VMK/makefile
wait    3
run     builtin cd /dd/tmp/VMK
wait    1
run     clear
wait    1
run     cat makefile
wait    3
run     v7make count
wait    6

shot    ltb
size    24 80
cap     The words here are proff's own requests, from SRC/proff; ltb writes
cap     their hash table as C, lextab.h and lextab.d, which proff's parser
cap     is compiled from.
try     ltb proffsym.new lextab
run     rm -rf /dd/tmp/LTB > /nil 2>/nil; mkdir -p /dd/tmp/LTB
wait    3
run     cp /dd/SRC/proff/proffsym.new /dd/tmp/LTB
wait    3
run     builtin cd /dd/tmp/LTB
wait    1
run     clear
wait    1
run     head -n 3 < proffsym.new
wait    3
run     ltb proffsym.new lextab
wait    6
run     ls -l
wait    4
run     head -n 4 < lextab.h
wait    4

shot    creadoc
size    28 90
cap     An early Fortran documentation generator: it walks the `.f' files
cap     in the data directory and copies each one's header comment into
cap     `creadoc.txt'.  It lists the directory through your own OS-9's
cap     `dir', and needs the Fortran run-time and a `shell' loaded too.
try     creadoc
run     rm -rf /dd/tmp/CRD; mkdir -p /dd/tmp/CRD; cp /dd/SRC/rtf/biory.f /dd/tmp/CRD/biory.f
wait    3
run     load /dd/CMDS/os9lib; load /h1/CMDS/shell; load /h1/CMDS/dir; load /h1/CMDS/del
wait    6
run     builtin cd /dd/tmp/CRD
wait    1
run     clear
wait    1
run     creadoc
wait    12
