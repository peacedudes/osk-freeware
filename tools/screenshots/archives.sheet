# Archivers, module-library tools and compressors, one stanza per
# program.  Every stanza makes what it reads under /dd/tmp/ARC.

shot    ar
cap     ar gathers files into one archive and compresses them as it
cap     goes: -u adds a file, -t prints the table of contents with the
cap     stored and original sizes.  Every path it is given must be
cap     relative; an absolute one is refused.
try     ar -u tmp/k2.ar SRC/keep/keep.c
run     rm -f tmp/k2.ar
wait    4
run     clear
wait    1
run     ar -u tmp/k2.ar SRC/keep/keep.c
wait    8
run     ar -t tmp/k2.ar
wait    6

shot    ar2
cap     Ar V2.00, a later edition than the V1.2 that ships as `ar', doing
cap     the same job: -u to add, -t for the table of contents.  This one
cap     also records each file's attributes.
try     ar2 -u tmp/k3.ar SRC/keep/keep.c
run     rm -f tmp/k3.ar
wait    3
run     clear
wait    1
run     ar2 -u tmp/k3.ar SRC/keep/keep.c
wait    8
run     ar2 -t tmp/k3.ar
wait    6

shot    arc
cap     ARC, the format that came before zip: `a' adds and `v' lists with
cap     the compression column.  The archive name has to be a bare
cap     filename in the current directory, because arc writes it under a
cap     temporary name and then renames it into place; that rename fails
cap     if the target names a subdirectory.
try     arc a m.arc motd termcap
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     rm -f m.arc
wait    4
run     clear
wait    1
run     arc a m.arc motd termcap
wait    12
run     arc v m.arc
wait    8

shot    marc
cap     marc merges a named member from one arc archive into another; it
cap     does not create archives of its own.  Here termcap is copied into
cap     an archive that already held motd, and the listing shows both.
try     marc a1.arc a2.arc termcap
run     rm -f a1.arc a2.arc; arc a a1.arc /dd/SYS/motd; arc a a2.arc /dd/SYS/termcap
wait    8
run     clear
wait    1
run     marc a1.arc a2.arc termcap
wait    6
run     arc v a1.arc
wait    6

shot    cat
cap     cat, concatenating two files to standard output.
try     cat tmp/ARC/one tmp/ARC/two
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; printf "one\r" > /dd/tmp/ARC/one; printf "two\r" > /dd/tmp/ARC/two
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/ARC/one tmp/ARC/two
wait    5

shot    modbuster
cap     modbuster splits a file holding several OS-9 modules into one
cap     file per module, each named for the module it holds, in the
cap     current directory.  Here a file made by joining two commands
cap     comes apart into the two again.
try     modbuster twomods
run     rm -rf /dd/tmp/MODC > /nil 2>/nil; mkdir -p /dd/tmp/MODC
wait    2
run     cat /dd/CMDS/cat /dd/CMDS/getenv > /dd/tmp/MODC/twomods; builtin cd /dd/tmp/MODC
wait    3
run     clear
wait    1
run     modbuster twomods
wait    6

shot    compr
cap     compr, another Lempel-Ziv-Welch file compressor, with -v to
cap     report how much it saved.  The result replaces the original with
cap     a .Z file.
try     compr -v tmp/ARC/idx3
run     rm -f /dd/tmp/ARC/idx3*; mkdir -p /dd/tmp/ARC > /nil 2>/nil; cp /dd/DOC/INDEX /dd/tmp/ARC/idx3
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     compr -v tmp/ARC/idx3
wait    10
run     ls -l tmp/ARC/idx3*
wait    5

shot    compress
cap     compress, the Lempel-Ziv-Welch one, with -v to report what it
cap     saved.  The .Z file replaces the original.
try     compress -v tmp/ARC/idx4
run     rm -f /dd/tmp/ARC/idx4*; cat /dd/DOC/INDEX > /dd/tmp/ARC/idx4
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     compress -v tmp/ARC/idx4
wait    8

shot    compress_4.0
cap     compress 4.0, another edition of the compress in CMDS, on the
cap     same file.
try     compress_4.0 -v tmp/ARC/idx5
run     rm -f /dd/tmp/ARC/idx5*; cat /dd/DOC/INDEX > /dd/tmp/ARC/idx5
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     compress_4.0 -v tmp/ARC/idx5
wait    8

shot    compress_rebuilt
cap     Another build of compress, from the same source as the one in
cap     CMDS and producing the same output; -v reports what it saved.
try     compress_rebuilt -v tmp/ARC/idx6
run     rm -f /dd/tmp/ARC/idx6*; cat /dd/DOC/INDEX > /dd/tmp/ARC/idx6
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     compress_rebuilt -v tmp/ARC/idx6
wait    8

shot    gzip
cap     GNU gzip on the same file, for comparison with compress.
try     gzip -v tmp/ARC/g1
run     rm -f /dd/tmp/ARC/g1*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g1
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gzip -v tmp/ARC/g1
wait    8

shot    gzip68k_csl
cap     The same 68000 build of gzip 1.2.4, linked against csl instead.
try     gzip68k_csl -v tmp/ARC/g3
run     rm -f /dd/tmp/ARC/g3*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g3
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gzip68k_csl -v tmp/ARC/g3
wait    8

shot    gzip020_csl
cap     The 68020 build of gzip 1.2.4, linked against csl.
try     gzip020_csl -v tmp/ARC/g5
run     rm -f /dd/tmp/ARC/g5*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g5
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gzip020_csl -v tmp/ARC/g5
wait    8

shot    gzipcpu32k_csl
cap     The CPU32 build of gzip 1.2.4, linked against csl.
try     gzipcpu32k_csl -v tmp/ARC/g7
run     rm -f /dd/tmp/ARC/g7*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g7
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gzipcpu32k_csl -v tmp/ARC/g7
wait    8

shot    lha
cap     LHa 2.08: pack a file, then list it back with the ratio.
try     lha a tmp/ARC/k.lzh SRC/keep/keep.c
run     rm -f /dd/tmp/ARC/k.lzh; mkdir -p /dd/tmp/ARC > /nil 2>/nil
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     lha a tmp/ARC/k.lzh SRC/keep/keep.c
wait    8
run     lha l tmp/ARC/k.lzh
wait    5

shot    lharc
for     lharc xlharc
cap     LHarc, the older sibling of lha: pack, then list.  xlharc, a
cap     third build of the same reader, lists the same archive.
try     lharc a tmp/ARC/l.lzh SYS/motd
run     rm -f /dd/tmp/ARC/l.lzh
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     lharc a tmp/ARC/l.lzh SYS/motd
wait    10
run     lharc l tmp/ARC/l.lzh
wait    6
run     xlharc l tmp/ARC/l.lzh
wait    8

shot    lharcs
cap     An older LHarc, version 1.01, packing a file and listing it back
cap     the same way as lha 2.08.
try     lharcs a tmp/ARC/ls.lzh SYS/motd
run     rm -f /dd/tmp/ARC/ls.lzh
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     lharcs a tmp/ARC/ls.lzh SYS/motd
wait    10
run     lharcs l tmp/ARC/ls.lzh
wait    6

shot    zoo
cap     zoo, packing and then listing -- compression ratio per member.
try     zoo a tmp/ARC/k.zoo SRC/keep/keep.c
run     rm -f /dd/tmp/ARC/k.zoo
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     zoo a tmp/ARC/k.zoo SRC/keep/keep.c
wait    6
run     zoo l tmp/ARC/k.zoo
wait    5

shot    zoo_2.1
for     zoo_2.1 booz fiz
cap     zoo 2.1, newer than the 2.01 that ships as `zoo', writes an
cap     archive; booz lists it with a bare letter rather than a
cap     dash-letter; fiz walks its internal directory structure.
try     zoo_2.1 a tmp/ARC/z2.zoo SYS/motd
run     rm -f /dd/tmp/ARC/z2.zoo
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     zoo_2.1 a tmp/ARC/z2.zoo SYS/motd
wait    10
run     booz l tmp/ARC/z2.zoo
wait    8
run     fiz tmp/ARC/z2.zoo
wait    10

shot    zip
cap     Info-ZIP's zip compresses the file correctly but then cannot
cap     rename its temporary file onto the target, so the archive is
cap     never written.  unzip reads archives made elsewhere without
cap     trouble.
try     zip test.zip motd
run     rm -rf /dd/tmp/ZIPT > /nil 2>/nil; mkdir -p /dd/tmp/ZIPT; cp /dd/SYS/motd /dd/tmp/ZIPT/motd
wait    5
run     builtin cd /dd/tmp/ZIPT
wait    1
run     clear
wait    1
run     zip test.zip motd
wait    12
run     ls
wait    6

shot    unzip
cap     Info-ZIP unzip extracting an archive of two members, one deflated
cap     and one stored.  `unzip -l' lists what is inside; `unzip' on its
cap     own extracts it into the current directory.
try     unzip sample.zip
run     rm -rf /dd/tmp/UNZ > /nil 2>/nil; mkdir -p /dd/tmp/UNZ > /nil 2>/nil
run     cp /dd/DOC/zip/sample.zip /dd/tmp/UNZ/sample.zip
run     builtin cd /dd/tmp/UNZ
wait    3
run     clear
wait    1
run     unzip -l sample.zip
wait    6
run     unzip sample.zip
wait    8
run     ls
wait    5

shot    zipinfo
cap     zipinfo on an archive: one line per member with its permissions,
cap     zip version, size, compression method and date, and a total.
cap     `zipinfo -v' gives the long form.
try     zipinfo DOC/zip/sample.zip
run     builtin cd /dd
wait    1
run     clear
wait    1
run     zipinfo DOC/zip/sample.zip
wait    6

shot    zipnote
cap     zipnote writes an archive's comments as text -- one `@ name' line
cap     per member with its comment beneath -- and reads the same text
cap     back with `-w' to set them.  This archive has none, so the lines
cap     are bare.
try     zipnote DOC/zip/sample.zip
run     builtin cd /dd
wait    1
run     clear
wait    1
run     zipnote DOC/zip/sample.zip
wait    6

shot    zipsplit
cap     zipsplit cuts an archive into pieces no bigger than `-n' bytes,
cap     numbered sample1.zip, sample2.zip and so on, so a large archive
cap     fits a set of floppies.
try     zipsplit -n 6000 sample.zip
run     rm -rf /dd/tmp/ZSP > /nil 2>/nil; mkdir -p /dd/tmp/ZSP > /nil 2>/nil
run     cp /dd/DOC/zip/sample.zip /dd/tmp/ZSP/sample.zip
run     builtin cd /dd/tmp/ZSP
wait    3
run     clear
wait    1
run     zipsplit -n 6000 sample.zip
wait    8
run     ls -l
wait    5

shot    funzip
cap     funzip unzips the first member of an archive straight through a
cap     pipe and prints it; here the first member is unzip's own readme.
cap     Later members are ignored, and it says so.
try     funzip < DOC/zip/sample.zip | head -n 16
os9     funzip <DOC/zip/sample.zip ! head -n 16
run     builtin cd /dd
wait    1
run     clear
wait    1
run     funzip < DOC/zip/sample.zip | head -n 16
wait    8

shot    shar
cap     shar wraps files as a shell archive, the way source once
cap     travelled over usenet.  One faulty check stops it here: its
cap     read-access test rejects every file, even one that `cat' and
cap     `ls' both show as world-readable.
try     shar tmp/ARC/readme
run     rm -f /dd/tmp/ARC/readme; mkdir -p /dd/tmp/ARC > /nil 2>/nil; cp /dd/readme /dd/tmp/ARC/readme
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ls -l tmp/ARC/readme
wait    4
run     shar tmp/ARC/readme
wait    6

shot    unshar
size    24 80
cap     unshar unpacks a shell archive -- the form programs were posted to
cap     Usenet in -- with its own interpreter, no Unix shell needed.  This is
cap     the 1991 posting that `which' on this disk came from; the three files
cap     it carried come out beside it.  chmod has no meaning here, so unshar
cap     says so and carries on.
try     unshar which6.shar
run     rm -rf /dd/tmp/UNSHAR; mkdir -p /dd/tmp/UNSHAR; cp /dd/DOC/unshar/which6.shar /dd/tmp/UNSHAR/which6.shar
wait    3
run     builtin cd /dd/tmp/UNSHAR
wait    1
run     clear
wait    1
run     unshar which6.shar
wait    8
run     ls -l
wait    3

shot    tar
cap     GNU tar 1.10 packing a directory into a .tar and listing what it
cap     wrote, with permissions, sizes and dates.
try     tar cvf tmp/ARC/keep.tar SRC/keep
run     rm -f /dd/tmp/ARC/keep.tar; mkdir -p /dd/tmp/ARC > /nil 2>/nil
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     tar cvf tmp/ARC/keep.tar SRC/keep
wait    6
run     tar tvf tmp/ARC/keep.tar
wait    5

shot    gtar
cap     Another build of GNU tar, packing the same directory and listing
cap     it back with owner and permissions.
try     gtar cvf tmp/ARC/keep2.tar SRC/keep
run     rm -f /dd/tmp/ARC/keep2.tar
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gtar cvf tmp/ARC/keep2.tar SRC/keep
wait    6
run     gtar tvf tmp/ARC/keep2.tar
wait    5

shot    liborder
cap     Given relocatable objects it prints them in the order you would feed
cap     them to `merge' to build a library -- last first, which is the order
cap     the linker wants.  Measured: it reverses whatever list it is given.
cap     It does not read a finished .l; handed one it takes the first bytes
cap     for an object header and asks for a length that is not there.
cap     `-modinfo' prints an object's public names instead.
try     liborder make.r parse.r stat.r
run     builtin cd /dd/SRC/eff_make
wait    1
run     clear
wait    1
run     liborder make.r parse.r stat.r
wait    5
run     liborder -modinfo stat.r
wait    5

shot    unpacklib
cap     Splits an OS-9 library apart into its member modules -- it gets
cap     the first two out of this one and then stops on a bad sync word
cap     partway through.
try     unpacklib -verbose LIB/blarslib.l
run     builtin cd /dd
wait    1
run     clear
wait    1
run     unpacklib -verbose LIB/blarslib.l
wait    10
