# Archivers, module-library tools and compressors, one stanza per
# program.  Every stanza makes what it reads under /dd/tmp/ARC.

shot    ar
cap     ar gathers files into one archive and compresses them as it
cap     goes: -u adds a file, -t prints the table of contents with the
cap     stored and original sizes.  Every path it is given must be
cap     relative; an absolute one is refused.
try     ar -u tmp/k2.ar SRC/keep/keep.c
run     rm -f tmp/k2.ar
wait    4
run     clear
wait    1
run     ar -u tmp/k2.ar SRC/keep/keep.c
wait    8
run     ar -t tmp/k2.ar
wait    6

shot    ar2
cap     Ar V2.00, a later edition than the V1.2 that ships as `ar', doing
cap     the same job: -u to add, -t for the table of contents.  This one
cap     also records each file's attributes.
try     ar2 -u tmp/k3.ar SRC/keep/keep.c
run     rm -f tmp/k3.ar
wait    3
run     clear
wait    1
run     ar2 -u tmp/k3.ar SRC/keep/keep.c
wait    8
run     ar2 -t tmp/k3.ar
wait    6

shot    arc
cap     In a directory holding copies of SYS/motd and SYS/termcap, `a' adds
cap     both and `v' lists them with the compression column.  The archive
cap     name has to be a bare filename in the current directory: arc
cap     writes under a temporary name and renames it into place, and that
cap     rename fails if the target names a subdirectory.
try     arc a m.arc motd termcap
run     rm -rf /dd/tmp/ARCA > /nil 2>/nil; mkdir -p /dd/tmp/ARCA; cp /dd/SYS/motd /dd/SYS/termcap /dd/tmp/ARCA
wait    4
run     builtin cd /dd/tmp/ARCA
wait    1
run     clear
wait    1
run     arc a m.arc motd termcap
wait    12
run     arc v m.arc
wait    8

shot    marc
cap     marc copies a named member from one arc archive into another: here
cap     termcap goes from a2.arc into a1.arc, which already held motd, and
cap     the listing shows both.
try     marc a1.arc a2.arc termcap
run     rm -rf /dd/tmp/MARC > /nil 2>/nil; mkdir -p /dd/tmp/MARC; builtin cd /dd/tmp/MARC
wait    2
run     arc a a1.arc /dd/SYS/motd; arc a a2.arc /dd/SYS/termcap
wait    8
run     clear
wait    1
run     marc a1.arc a2.arc termcap
wait    6
run     arc v a1.arc
wait    6

shot    cat
cap     cat, concatenating two files to standard output.
try     cat tmp/ARC/one tmp/ARC/two
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; printf "one\r" > /dd/tmp/ARC/one; printf "two\r" > /dd/tmp/ARC/two
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/ARC/one tmp/ARC/two
wait    5

shot    modbuster
cap     A file made by joining two commands, cat and getenv, comes apart
cap     into the two again, each named for the module it holds.  The empty
cap     file `?' is what it made of the end of the input, after the last
cap     module it recognised.
try     modbuster twomods
run     rm -rf /dd/tmp/MODC > /nil 2>/nil; mkdir -p /dd/tmp/MODC
wait    2
run     cat /dd/CMDS/cat /dd/CMDS/getenv > /dd/tmp/MODC/twomods; builtin cd /dd/tmp/MODC
wait    3
run     clear
wait    1
run     modbuster twomods
wait    6
run     ls -l
wait    4

shot    compr
cap     compr, another Lempel-Ziv-Welch file compressor, with -v to
cap     report how much it saved.  The result replaces the original with
cap     a .Z file.
try     compr -v tmp/ARC/idx3
run     rm -f /dd/tmp/ARC/idx3*; mkdir -p /dd/tmp/ARC > /nil 2>/nil; cp /dd/DOC/INDEX /dd/tmp/ARC/idx3
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     compr -v tmp/ARC/idx3
wait    10
run     ls -l tmp/ARC/idx3*
wait    5

shot    compress
cap     compress, the Lempel-Ziv-Welch one, with -v to report what it
cap     saved.  The .Z file replaces the original.
try     compress -v tmp/ARC/idx4
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/idx4*; cat /dd/DOC/INDEX > /dd/tmp/ARC/idx4
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     compress -v tmp/ARC/idx4
wait    8

shot    compress_4.0
cap     compress 4.0, another edition of the compress in CMDS, on the
cap     same file.
try     compress_4.0 -v tmp/ARC/idx5
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/idx5*; cat /dd/DOC/INDEX > /dd/tmp/ARC/idx5
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     compress_4.0 -v tmp/ARC/idx5
wait    8

shot    gzip
cap     gzip -v on a copy of DOC/INDEX: 65% smaller, and the file is
cap     replaced by one ending .gz.
try     gzip -v tmp/ARC/g1
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/g1*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g1
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gzip -v tmp/ARC/g1
wait    8

shot    gzip68k_csl
cap     The 68000 build of gzip 1.2.4, linked against csl, on a copy of
cap     DOC/INDEX.
try     gzip68k_csl -v tmp/ARC/g3
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/g3*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g3
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gzip68k_csl -v tmp/ARC/g3
wait    8

shot    gzip020_csl
cap     The 68020 build of gzip 1.2.4, linked against csl.
try     gzip020_csl -v tmp/ARC/g5
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/g5*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g5
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gzip020_csl -v tmp/ARC/g5
wait    8

shot    gzipcpu32k_csl
cap     The CPU32 build of gzip 1.2.4, linked against csl.
try     gzipcpu32k_csl -v tmp/ARC/g7
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/g7*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g7
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gzipcpu32k_csl -v tmp/ARC/g7
wait    8

shot    lha
cap     LHa 2.08: pack a file, then list it back with the ratio.
try     lha a tmp/ARC/k.lzh SRC/keep/keep.c
run     rm -f /dd/tmp/ARC/k.lzh; mkdir -p /dd/tmp/ARC > /nil 2>/nil
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     lha a tmp/ARC/k.lzh SRC/keep/keep.c
wait    8
run     lha l tmp/ARC/k.lzh
wait    5

shot    lharc
cap     LHarc, the older sibling of lha: pack SYS/motd, then list the
cap     archive with its ratio.
try     lharc a tmp/ARC/l.lzh SYS/motd
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/l.lzh
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     lharc a tmp/ARC/l.lzh SYS/motd
wait    10
run     lharc l tmp/ARC/l.lzh
wait    6

shot    xlharc
cap     A third build of C-LHarc 1.00, listing an archive that lharc made
cap     of SYS/motd, then extracting it into an empty directory.
try     xlharc l l.lzh; xlharc x l.lzh
run     rm -rf /dd/tmp/XLH > /nil 2>/nil; mkdir -p /dd/tmp/XLH; builtin cd /dd/tmp/XLH
wait    2
run     cp /dd/SYS/motd motd; lharc a l.lzh motd; rm motd
wait    8
run     clear
wait    1
run     xlharc l l.lzh; xlharc x l.lzh
wait    10
run     ls -l
wait    4

shot    lharcs
cap     An older LHarc, version 1.01, packing a file and listing it back
cap     the same way as lha 2.08.
try     lharcs a tmp/ARC/ls.lzh SYS/motd
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/ls.lzh
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     lharcs a tmp/ARC/ls.lzh SYS/motd
wait    10
run     lharcs l tmp/ARC/ls.lzh
wait    6

shot    zoo
cap     zoo, packing and then listing -- compression ratio per member.
try     zoo a tmp/ARC/k.zoo SRC/keep/keep.c; zoo l tmp/ARC/k.zoo
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/k.zoo
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     zoo a tmp/ARC/k.zoo SRC/keep/keep.c; zoo l tmp/ARC/k.zoo
wait    10

shot    zoo_2.1
cap     zoo 2.1, newer than the 2.01 that ships as `zoo': it adds SYS/motd
cap     to an archive and lists it back.
try     zoo_2.1 a tmp/ARC/z2.zoo SYS/motd; zoo_2.1 l tmp/ARC/z2.zoo
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/z2.zoo
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     zoo_2.1 a tmp/ARC/z2.zoo SYS/motd; zoo_2.1 l tmp/ARC/z2.zoo
wait    12

shot    booz
cap     booz listing an archive that zoo made of SYS/motd: `l' lists, `x'
cap     extracts and `t' tests.
try     booz l tmp/ARC/zb.zoo
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/zb.zoo
wait    2
run     builtin cd /dd
wait    1
run     zoo a tmp/ARC/zb.zoo SYS/motd
wait    8
run     clear
wait    1
run     booz l tmp/ARC/zb.zoo
wait    8

shot    fiz
cap     fiz searching a zoo archive that holds SYS/motd for the tags that
cap     mark its parts: each DIR line is a directory entry, with its offset
cap     in the archive, the path and name it holds, and after `==>' where
cap     it says the file's data starts; each DATA line is where fiz found
cap     data.  The DIR at 42 points to 117, and the data is at 117.
try     fiz tmp/ARC/zf.zoo
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/zf.zoo
wait    2
run     builtin cd /dd
wait    1
run     zoo_2.1 a tmp/ARC/zf.zoo SYS/motd
wait    8
run     clear
wait    1
run     fiz tmp/ARC/zf.zoo
wait    10

shot    zip
cap     zip deflates into a temporary named _Z<number>, and the rename onto
cap     the name you gave fails; the temporary is the archive, and once it
cap     is renamed unzip lists it.
try     zip test.zip motd
run     rm -rf /dd/tmp/ZIPT > /nil 2>/nil; mkdir -p /dd/tmp/ZIPT; cp /dd/SYS/termcap /dd/tmp/ZIPT/motd
wait    5
run     builtin cd /dd/tmp/ZIPT
wait    1
run     clear
wait    1
run     zip test.zip motd
wait    12
run     mv _Z* test.zip
wait    4
run     unzip -l test.zip
wait    8

shot    unzip
cap     Info-ZIP unzip extracting an archive of two members, one deflated
cap     and one stored.  `unzip -l' lists what is inside; `unzip' on its
cap     own extracts it into the current directory.
try     unzip -l sample.zip; unzip sample.zip
run     rm -rf /dd/tmp/UNZ > /nil 2>/nil; mkdir -p /dd/tmp/UNZ > /nil 2>/nil
run     cp /dd/DOC/zip/sample.zip /dd/tmp/UNZ/sample.zip
run     builtin cd /dd/tmp/UNZ
wait    3
run     clear
wait    1
run     unzip -l sample.zip; unzip sample.zip
wait    14
run     ls
wait    5

shot    zipinfo
cap     zipinfo on an archive: one line per member with its permissions,
cap     zip version, size, compression method and date, and a total.
cap     `zipinfo -v' gives the long form.
try     zipinfo DOC/zip/sample.zip
run     builtin cd /dd
wait    1
run     clear
wait    1
run     zipinfo DOC/zip/sample.zip
wait    6

shot    zipnote
cap     zipnote writes an archive's comments as text -- one `@ name' line
cap     per member with its comment beneath -- and reads the same text
cap     back with `-w' to set them.  This archive has none, so the lines
cap     are bare.
try     zipnote DOC/zip/sample.zip
run     builtin cd /dd
wait    1
run     clear
wait    1
run     zipnote DOC/zip/sample.zip
wait    6

shot    zipsplit
cap     zipsplit cuts an archive into pieces no bigger than `-n' bytes,
cap     numbered sample1.zip, sample2.zip and so on, so a large archive
cap     fits a set of floppies.
try     zipsplit -n 6000 sample.zip
run     rm -rf /dd/tmp/ZSP > /nil 2>/nil; mkdir -p /dd/tmp/ZSP > /nil 2>/nil
run     cp /dd/DOC/zip/sample.zip /dd/tmp/ZSP/sample.zip
run     builtin cd /dd/tmp/ZSP
wait    3
run     clear
wait    1
run     zipsplit -n 6000 sample.zip
wait    8
run     ls -l
wait    5

shot    funzip
cap     funzip unzips the first member of an archive straight through a
cap     pipe and prints it; here the first member is unzip's own readme.
cap     Later members are ignored, and it says so.
try     funzip < DOC/zip/sample.zip | head -n 16
os9     funzip <DOC/zip/sample.zip ! head -n 16
run     builtin cd /dd
wait    1
run     clear
wait    1
run     funzip < DOC/zip/sample.zip | head -n 16
wait    8

shot    shar
cap     shar wraps files as a shell archive, the way source once
cap     travelled over usenet: a header naming the files, then each
cap     one as a here-document for sh to write back out.
try     shar note
run     rm -rf /dd/tmp/SHA > /nil 2>/nil; mkdir -p /dd/tmp/SHA
wait    2
run     echo "Two lines of text," > /dd/tmp/SHA/note; echo "wrapped for the mail." >> /dd/tmp/SHA/note
wait    2
run     builtin cd /dd/tmp/SHA
wait    1
run     clear
wait    1
run     shar note
wait    6

shot    unshar
size    24 80
cap     unshar unpacks a shell archive -- the form programs were posted to
cap     Usenet in -- with its own interpreter, no Unix shell needed.  This is
cap     the 1991 posting that `which' on this disk came from; the three files
cap     it carried come out beside it.  chmod has no meaning here, so unshar
cap     says so and carries on.
try     unshar which6.shar
run     rm -rf /dd/tmp/UNSHAR; mkdir -p /dd/tmp/UNSHAR; cp /dd/DOC/unshar/which6.shar /dd/tmp/UNSHAR/which6.shar
wait    3
run     builtin cd /dd/tmp/UNSHAR
wait    1
run     clear
wait    1
run     unshar which6.shar
wait    8
run     ls -l
wait    3

shot    tar
cap     GNU tar 1.10 packing a directory into a .tar and listing what it
cap     wrote, with permissions, sizes and dates.
try     tar cvf tmp/ARC/keep.tar SRC/keep; tar tvf tmp/ARC/keep.tar
run     rm -f /dd/tmp/ARC/keep.tar; mkdir -p /dd/tmp/ARC > /nil 2>/nil
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     tar cvf tmp/ARC/keep.tar SRC/keep; tar tvf tmp/ARC/keep.tar
wait    11

shot    gtar
cap     Another build of GNU tar, packing SRC/keep and listing it back with
cap     owner and permissions.
try     gtar cvf tmp/ARC/keep2.tar SRC/keep; gtar tvf tmp/ARC/keep2.tar
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/keep2.tar
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gtar cvf tmp/ARC/keep2.tar SRC/keep; gtar tvf tmp/ARC/keep2.tar
wait    11

shot    liborder
cap     Three of make's relocatable objects, printed last first, the order to
cap     merge them into a library; then `-modinfo' naming one object's
cap     public names.  It reads .r files, not a finished .l library.
try     liborder make.r parse.r stat.r
run     builtin cd /dd/SRC/eff_make
wait    1
run     clear
wait    1
run     liborder make.r parse.r stat.r
wait    5
run     liborder -modinfo stat.r
wait    5

shot    unpacklib
cap     Splits an OS-9 library into its member modules, writing each as its
cap     own file; -verbose names each one and its size as it goes.
try     unpacklib -verbose pbm.l
run     rm -rf /dd/tmp/UPL > /nil 2>/nil; mkdir -p /dd/tmp/UPL; cp /dd/LIB/pbm.l /dd/tmp/UPL/pbm.l
wait    3
run     builtin cd /dd/tmp/UPL
wait    1
run     clear
wait    1
run     unpacklib -verbose pbm.l
wait    6
run     ls
wait    10

shot    jaw
size    24 80
cap     A one-line sentence after compress has packed it, and jaw -- a zcat
cap     in 22 lines of obfuscated C -- writing it back out.
try     dump q.Z; jaw < q.Z
os9     dump q.Z; jaw <q.Z
run     /dd/CMDS/rm -rf /dd/tmp/jawcard > /nil 2>/nil
run     /dd/CMDS/mkdir -p /dd/tmp/jawcard
run     builtin cd /dd/tmp/jawcard
run     echo "Quartz glyph jocks vend, fix, BMW." > q
run     compress < q > q.Z
wait    2
run     clear
wait    1
run     dump q.Z; jaw < q.Z
wait    4

shot    bru
super
cap     bru backing up a directory, then listing the archive in long
cap     form: each file's attributes, owner, date and size are kept, and
cap     `bru -x' puts them back.  The year prints as `<6' -- it is
cap     OS-9's 126, for 2026, squeezed into two digits.
try     bru -c -q -v -f tmp/ARC/keep.bru SRC/keep
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; rm -f /dd/tmp/ARC/keep.bru
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     bru -c -q -v -f tmp/ARC/keep.bru SRC/keep
wait    5
run     bru -t -q -vvv -f tmp/ARC/keep.bru
wait    5
