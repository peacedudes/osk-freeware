# Archivers, module-library tools and compressors, one stanza per
# program.  Every stanza makes what it reads under /dd/tmp/ARC.

shot    ar
cap     Carl Kreider's ar, the OS-9 archive librarian: -u to add, -t for
cap     the table of contents.  Every path it is given must be RELATIVE --
cap     handed an absolute one it answers `absolute path illegal' -- so
cap     these are written from the data directory, which is /dd.
run     rm -f tmp/k2.ar
wait    4
run     clear
wait    1
run     ar -u tmp/k2.ar SRC/keep/keep.c
wait    8
run     ar -t tmp/k2.ar
wait    6

shot    ar2
cap     Ar V2.00, a later edition than the V1.2 that ships as `ar', doing
cap     the same job: -u to add, -t for the table of contents.
run     rm -f tmp/k3.ar
wait    3
run     clear
wait    1
run     ar2 -u tmp/k3.ar SRC/keep/keep.c
wait    8
run     ar2 -t tmp/k3.ar
wait    6

shot    arc
cap     ARC, the format that came before zip -- Stephan Paschedag's OS-9
cap     port of System Enhancement Associates' 5.21.  `a' adds and `v'
cap     lists with the compression column.  The archive name has to be a
cap     bare filename in the current directory: arc builds it under a
cap     temporary name and then renames it into place, and that rename
cap     fails as soon as the target names a subdirectory.
run     rm -f m.arc
wait    4
run     clear
wait    1
run     arc a m.arc /dd/SYS/motd /dd/SYS/termcap
wait    12
run     arc v m.arc
wait    8

shot    dearc
cap     dearc is built to extract archives from the MS-DOS ARC program,
cap     not this disk's own `arc' -- and the difference is real: reading
cap     back what `arc' just wrote here, dearc reports a CRC failure and
cap     the extracted file does not match the original.
run     rm -f /dd/m.arc /dd/motd; arc a m.arc /dd/SYS/motd
wait    6
run     clear
wait    1
run     dearc m.arc
wait    6
run     chksum /dd/SYS/motd /dd/motd
wait    5

shot    marc
cap     marc merges a named member from one arc archive into another --
cap     it does not create archives of its own.
run     rm -f a1.arc a2.arc; arc a a1.arc /dd/SYS/motd; arc a a2.arc /dd/SYS/termcap
wait    8
run     clear
wait    1
run     marc a1.arc a2.arc termcap
wait    6
run     arc v a1.arc
wait    6

shot    cat
cap     cat, concatenating two files to standard output.
run     mkdir -p /dd/tmp/ARC > /nil 2>/nil; printf "one\r" > /dd/tmp/ARC/one; printf "two\r" > /dd/tmp/ARC/two
wait    3
run     clear
wait    1
run     cat /dd/tmp/ARC/one /dd/tmp/ARC/two
wait    5

shot    modbuster
cap     modbuster splits a file of several merged OS-9 modules into one
cap     file per module, in the current directory -- shown here on a
cap     single ordinary module.  A larger merged file, such as the
cap     CyberWar game's own binary, makes it hang with no output at all.
run     rm -f /dd/today2; cp /dd/CMDS/today /dd/today2
wait    3
run     clear
wait    1
run     modbuster today2
wait    6

shot    compr
cap     compr, a second OS-9 file compressor, on the disk's index.
run     rm -f /dd/tmp/ARC/idx3*; mkdir -p /dd/tmp/ARC > /nil 2>/nil; cp /dd/DOC/INDEX /dd/tmp/ARC/idx3
wait    4
run     clear
wait    1
run     compr /dd/tmp/ARC/idx3
wait    10
run     ls -l /dd/tmp/ARC/idx3*
wait    5

shot    compress
cap     compress, the LZW one, reporting what it saved.
run     rm -f /dd/tmp/ARC/idx4*; cat /dd/DOC/INDEX > /dd/tmp/ARC/idx4
wait    3
run     clear
wait    1
run     compress -v /dd/tmp/ARC/idx4
wait    8

shot    compress_4.0
cap     compress 4.0, another edition of CMDS/compress, on the same file.
run     rm -f /dd/tmp/ARC/idx5*; cat /dd/DOC/INDEX > /dd/tmp/ARC/idx5
wait    3
run     clear
wait    1
run     compress_4.0 -v /dd/tmp/ARC/idx5
wait    8

shot    compress_rebuilt
cap     Our own source build of compress, from the same source as
cap     CMDS/compress -- and it writes byte for byte what that one does.
run     rm -f /dd/tmp/ARC/idx6*; cat /dd/DOC/INDEX > /dd/tmp/ARC/idx6
wait    3
run     clear
wait    1
run     compress_rebuilt -v /dd/tmp/ARC/idx6
wait    8

shot    gzip
cap     GNU gzip on the same file, for comparison with compress.
run     rm -f /dd/tmp/ARC/g1*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g1
wait    3
run     clear
wait    1
run     gzip -v /dd/tmp/ARC/g1
wait    8

shot    gzip68k_nocsl
cap     gzip 1.2.4 built for the 68000, without the csl trap library.
run     rm -f /dd/tmp/ARC/g2*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g2
wait    3
run     clear
wait    1
run     gzip68k_nocsl -v /dd/tmp/ARC/g2
wait    8

shot    gzip68k_csl
cap     The same 68000 build of gzip 1.2.4, linked against csl instead.
run     rm -f /dd/tmp/ARC/g3*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g3
wait    3
run     clear
wait    1
run     gzip68k_csl -v /dd/tmp/ARC/g3
wait    8

shot    gzip020_nocsl
cap     gzip 1.2.4 built for the 68020, without csl.
run     rm -f /dd/tmp/ARC/g4*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g4
wait    3
run     clear
wait    1
run     gzip020_nocsl -v /dd/tmp/ARC/g4
wait    8

shot    gzip020_csl
cap     The 68020 build of gzip 1.2.4, linked against csl.
run     rm -f /dd/tmp/ARC/g5*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g5
wait    3
run     clear
wait    1
run     gzip020_csl -v /dd/tmp/ARC/g5
wait    8

shot    gzipcpu32_nocsl
cap     gzip 1.2.4 built for the CPU32, without csl.
run     rm -f /dd/tmp/ARC/g6*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g6
wait    3
run     clear
wait    1
run     gzipcpu32_nocsl -v /dd/tmp/ARC/g6
wait    8

shot    gzipcpu32k_csl
cap     The CPU32 build of gzip 1.2.4, linked against csl.
run     rm -f /dd/tmp/ARC/g7*; cat /dd/DOC/INDEX > /dd/tmp/ARC/g7
wait    3
run     clear
wait    1
run     gzipcpu32k_csl -v /dd/tmp/ARC/g7
wait    8

shot    lha
cap     LHa 2.08: pack, then list with the ratio.
run     rm -f /dd/tmp/ARC/k.lzh; mkdir -p /dd/tmp/ARC > /nil 2>/nil
wait    2
run     clear
wait    1
run     lha a /dd/tmp/ARC/k.lzh /dd/SRC/keep/keep.c
wait    8
run     lha l /dd/tmp/ARC/k.lzh
wait    5

shot    lharc
for     lharc xlharc
cap     LHarc, the older sibling of lha: pack, then list.  xlharc, a
cap     third build of the same reader, lists the same archive.
run     rm -f /dd/tmp/ARC/l.lzh
wait    2
run     clear
wait    1
run     lharc a /dd/tmp/ARC/l.lzh /dd/SYS/motd
wait    10
run     lharc l /dd/tmp/ARC/l.lzh
wait    6
run     xlharc l /dd/tmp/ARC/l.lzh
wait    8

shot    lharcs
cap     C-LHarc 1.01, an older build than lha 2.08, on the same job.
run     rm -f /dd/tmp/ARC/ls.lzh
wait    2
run     clear
wait    1
run     lharcs a /dd/tmp/ARC/ls.lzh /dd/SYS/motd
wait    10
run     lharcs l /dd/tmp/ARC/ls.lzh
wait    6

shot    zoo
cap     zoo, packing and then listing -- compression ratio per member.
run     rm -f /dd/tmp/ARC/k.zoo
wait    2
run     clear
wait    1
run     zoo a /dd/tmp/ARC/k.zoo /dd/SRC/keep/keep.c
wait    6
run     zoo l /dd/tmp/ARC/k.zoo
wait    5

shot    zoo_2.1
for     zoo_2.1 booz fiz
cap     zoo 2.1, newer than the 2.01 that ships as `zoo', writes an
cap     archive; booz lists it with a BARE LETTER, not a dash-letter; fiz
cap     walks its internal directory structure.
run     rm -f /dd/tmp/ARC/z2.zoo
wait    2
run     clear
wait    1
run     zoo_2.1 a /dd/tmp/ARC/z2.zoo /dd/SYS/motd
wait    10
run     booz l /dd/tmp/ARC/z2.zoo
wait    8
run     fiz /dd/tmp/ARC/z2.zoo
wait    10

shot    zip
cap     Info-ZIP's zip DEFLATES correctly and then cannot rename its
cap     temporary file over the target -- the archive is never written.
cap     unzip reads other people's archives perfectly well.
run     rm -rf /dd/tmp/ARC/zt; mkdir /dd/tmp/ARC/zt > /nil 2>/nil; cp /dd/SYS/motd /dd/tmp/ARC/zt/motd
wait    5
run     clear
wait    1
run     zip /dd/tmp/ARC/zt/test.zip /dd/tmp/ARC/zt/motd
wait    12
run     dir /dd/tmp/ARC/zt
wait    6

shot    unzip
cap     Info-ZIP unzip listing and then extracting an archive: two members,
cap     one deflated and one stored, with their dates and sizes.
cap     `unzip -l' lists, `unzip' extracts into the current directory, and
cap     `-o' overwrites without asking.  DOC/zip/sample.zip is the archive.
run     rm -rf /dd/tmp/UNZ; mkdir /dd/tmp/UNZ > /nil 2>/nil
wait    3
run     clear
wait    1
run     unzip -l /dd/DOC/zip/sample.zip
wait    6
run     ksh -c "cd /dd/tmp/UNZ; unzip -o /dd/DOC/zip/sample.zip"
wait    8
run     ls -l /dd/tmp/UNZ
wait    5

shot    zipinfo
cap     zipinfo on an archive: one line per member with its permissions,
cap     zip version, size, compression method and date, and a total.
cap     `zipinfo -v' gives the long form.
run     clear
wait    1
run     zipinfo /dd/DOC/zip/sample.zip
wait    6

shot    zipnote
cap     zipnote writes an archive's comments as text -- one `@ name' line
cap     per member with its comment beneath -- and reads the same text
cap     back with `-w' to set them.  This archive has none, so the lines
cap     are bare.
run     clear
wait    1
run     zipnote /dd/DOC/zip/sample.zip
wait    6

shot    zipsplit
cap     zipsplit cuts an archive into pieces no bigger than `-n' bytes,
cap     numbered sample1.zip, sample2.zip and so on, so a large archive
cap     fits a set of floppies.
run     rm -rf /dd/tmp/ZSP; mkdir /dd/tmp/ZSP > /nil 2>/nil
wait    3
run     clear
wait    1
run     ksh -c "cd /dd/tmp/ZSP; zipsplit -n 6000 /dd/DOC/zip/sample.zip"
wait    8
run     ls -l /dd/tmp/ZSP
wait    5

shot    funzip
cap     funzip unzips the first member of an archive straight through a
cap     pipe -- `funzip < archive.zip' -- and prints it; here the first
cap     member is unzip's own readme.  Later members are ignored, and it
cap     says so.
run     clear
wait    1
run     funzip < /dd/DOC/zip/sample.zip | head -n 16
wait    8

shot    shar
cap     shar wraps files as a shell archive -- how source travelled over
cap     usenet.  ONE BROKEN CHECK stops it: its read-access test rejects
cap     every file that EXISTS, even one `cat' and `ls' both show as
cap     world-readable.
run     rm -f /dd/tmp/ARC/readme; mkdir -p /dd/tmp/ARC > /nil 2>/nil; cp /dd/readme /dd/tmp/ARC/readme
wait    3
run     clear
wait    1
run     ls -l /dd/tmp/ARC/readme
wait    4
run     shar /dd/tmp/ARC/readme
wait    6

shot    tar
cap     GNU tar 1.10 packing a directory off this disk and listing what it
cap     wrote -- the same tar the image build uses to populate the disk.
run     rm -f /dd/tmp/ARC/keep.tar; mkdir -p /dd/tmp/ARC > /nil 2>/nil
wait    2
run     clear
wait    1
run     tar cvf /dd/tmp/ARC/keep.tar /dd/SRC/keep
wait    6
run     tar tvf /dd/tmp/ARC/keep.tar
wait    5

shot    gtar
cap     Another build of GNU tar, on the same directory -- it strips the
cap     leading slash from absolute names going into the archive.
run     rm -f /dd/tmp/ARC/keep2.tar
wait    2
run     clear
wait    1
run     gtar cvf /dd/tmp/ARC/keep2.tar /dd/SRC/keep
wait    6
run     gtar tvf /dd/tmp/ARC/keep2.tar
wait    5

shot    arc_5.12
cap     ARC v5.12, an earlier edition than CMDS/arc's 5.21.  It never gets
cap     past writing its own temporary file: the rename into place fails
cap     every time, with `No Children' -- so it cannot write an archive on
cap     this disk at all.
run     rm -f /dd/tmp/o5.arc
wait    2
run     clear
wait    1
run     arc_5.12 -a /dd/tmp/o5.arc /dd/SYS/motd
wait    8
run     arc_5.12 -v /dd/tmp/o5.arc
wait    6

shot    liborder
cap     Reports the order to concatenate OS-9 modules in a library, read
cap     from an OS-9 ROF file.
run     clear
wait    1
run     liborder /dd/LIB/alib.l
wait    10

shot    unpacklib
cap     Splits an OS-9 library apart into its member modules -- it gets
cap     the first two out of this one and then stops on a bad sync word
cap     partway through.
run     clear
wait    1
run     unpacklib -verbose /dd/LIB/blarslib.l
wait    10
