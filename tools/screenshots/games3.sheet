# The rest of the games shelf: the data builders, the chess tools, and the
# ones whose value is a board rather than a title screen.
shot    bincheckr
cap     bincheckr reads GNU Chess's opening book and checks it -- the book
cap     ships here, so it has something to check.
run     /dd/CMDS/GAMES/bincheckr /dd/GAMES/gnuchess.book
wait    8
kill

shot    postprint
cap     postprint writes a chess position as PostScript, for printing a
cap     diagram.
run     /dd/CMDS/GAMES/postprint | /dd/CMDS/head -n 20
wait    8

shot    mkdict
cap     mkdict and mkindex build Boggle's dictionary and its index out of
cap     the word list in GAMES/BOG.
run     /dd/CMDS/GAMES/mkdict -?
wait    5
run     /dd/CMDS/GAMES/mkindex -?
wait    5

shot    gnuchess
cap     GNU Chess 4.0 in its plain build, thinking about a move: depth,
cap     score, nodes and the line it is considering.
run     /dd/CMDS/GAMES/gnuchess
wait    6
send    e2e4\r
wait    12

shot    checkgame
cap     game replays a saved chess game move by move.
run     /dd/CMDS/GAMES/checkgame /dd/GAMES/gnuchess.book 1 3
wait    8

shot    maze
cap     maze generates a maze and draws it.
run     /dd/CMDS/GAMES/maze
wait    8

shot    queens
cap     The eight-queens problem, solved and drawn -- an IOCCC entry that
cap     reads the board size on standard input.
run     echo 6 | /dd/CMDS/queens | /dd/CMDS/head -n 21
wait    8

shot    fuddle
cap     fuddle, a chess variant.
run     /dd/CMDS/GAMES/fuddle
wait    8
