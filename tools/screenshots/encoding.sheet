# Encoders, hashes and conversions, with a round trip wherever
# one is possible.

shot    binhex
for     binhex hexbin
cap     binhex encodes a file the way a Macintosh expected to receive it --
cap     but it will only take MACBINARY in, not a plain file, and no
cap     MacBinary file ships here.  So what it does is refuse, politely and
cap     by name, which is the useful thing to know before you feed it
cap     something.
run     binhex /dd/DOC/INDEX
wait    8

shot    btoa
cap     btoa, the denser alternative to uuencode: five ASCII characters per
cap     four binary bytes, with a checksum line at the end.
run     btoa < /dd/SYS/motd | head -n 14
wait    5

shot    btoa-round
for     btoa atob
cap     btoa encodes a file as printable text and atob decodes it again.
cap     Five characters for four bytes, with a checksum on the end line.
run     btoa < /dd/SYS/motd > /dd/tmp/m.btoa
wait    4
run     cat /dd/tmp/m.btoa
wait    4
run     atob < /dd/tmp/m.btoa | md5
wait    6

shot    checksum
cap     Two older checksums beside each other on the same file.
run     checksum /dd/SYS/motd
wait    3
run     chksum /dd/SYS/motd
wait    3

shot    crypto
cap     crypto, the cryptogram solver's assistant, showing what it offers.
run     crypto -h
wait    6

shot    cvtbase
cap     cvtbase names its bases by KEY -- b, d, h or x, o, or the digits of
cap     any base you like -- and this is it saying so.  Asked to convert
cap     anything it floods `No more memory !!!' instead, which is in
cap     DOC/INDEX and in the data tests; a wall of that message is not a
cap     picture of what the program is for.
run     cvtbase
wait    6

shot    des
for     des
cap     DES asks for the key twice, writes its output as `<file>.n' and
cap     REMOVES the original.  It encrypts: 40 bytes in, 40 bytes out.  It
cap     does NOT come back -- run over its own output with the same key, the
cap     file it writes checksums 00000000 rather than the 4b68af85 it
cap     started from.  `xcrypt' is the cipher here that round-trips.
run     rm -f /dd/tmp/d.txt.n
wait    4
run     cp /dd/SYS/motd /dd/tmp/d.txt
wait    5
run     chksum /dd/tmp/d.txt
wait    5
run     des /dd/tmp/d.txt
wait    4
send    freeware\r
wait    3
send    freeware\r
wait    6
run     des /dd/tmp/d.txt.n
wait    4
send    freeware\r
wait    3
send    freeware\r
wait    6
run     chksum /dd/tmp/d.txt.n.n
wait    8

shot    divide
for     divide chardef fc
cap     divide SPLITS A FILE into pieces -- Farside Systems, 1992.  Twelve
cap     lines in, four to a piece, three pieces out.  It is not integer
cap     division, whatever the name suggests, and DOC/INDEX said it was
cap     until this screen was taken.  `fc' below is the other splitter
cap     here, cutting at 350,000 bytes to fit a 360k floppy; it needs its
cap     path because bash has an `fc' builtin.
run     head -n 12 /dd/SYS/holidays > /dd/tmp/dv.txt 2>/nil
wait    6
run     divide -l=4 /dd/tmp/dv.txt /dd/tmp/piece
wait    8
run     ls -l /dd/tmp/piece.1 /dd/tmp/piece.2 /dd/tmp/piece.3
wait    6
run     cat /dd/tmp/piece.1
wait    6
run     /dd/CMDS/fc -?
wait    6

shot    md5
cap     MD5 over three files on the disk.
run     md5 /dd/SYS/motd /dd/SYS/password /dd/DOC/INDEX
wait    5

shot    sox
cap     Sound eXchange reading one of the sample sounds in DOC/sox and
cap     reporting what is in it -- an IFF/8SVX sample from an Amiga.
run     sox /dd/DOC/sox/great_oz.iff -t au /dd/tmp/oz.au
wait    10
run     file /dd/DOC/sox/great_oz.iff /dd/tmp/oz.au
wait    6

shot    todos
cap     todos and toos9 claim to convert line endings between OS-9 and DOS.
cap     They do NOT: the file comes back byte-identical, which is what the
cap     checksums below show.  Kept here because it is the truth.
run     cat /dd/SYS/motd > /dd/tmp/le.txt
wait    3
run     chksum /dd/tmp/le.txt
wait    3
run     todos /dd/tmp/le.txt
wait    4
run     chksum /dd/tmp/le.txt
wait    5

shot    uudecode
cap     uuencode and uudecode, the pair that carried binaries through mail.
run     uuencode /dd/SYS/motd > /dd/tmp/m.uue
wait    4
run     head -n 3 /dd/tmp/m.uue
wait    4
run     uudecode /dd/tmp/m.uue
wait    6

shot    uuencode
cap     uuencode wrapping a binary as printable text -- how files crossed
cap     mail and usenet before attachments existed.
run     uuencode /dd/SYS/motd | head -n 14
wait    5

shot    uuexpand
for     uuexpand toos9 macbin mcvert hexbin
cap     uuexpand pads a uuencoded file back out; the Macintosh set beside
cap     it converts between the formats a Mac expected.
run     uuencode /dd/SYS/motd > /dd/tmp/u.uue
wait    6
run     uuexpand < /dd/tmp/u.uue | head -n 8
wait    8
run     mcvert -?
wait    6

shot    xcrypt
cap     xcrypt, a simpler file cipher, and the checksum round trip again.
run     xcrypt -k=freeware /dd/SYS/motd /dd/tmp/x.enc
wait    6
run     xcrypt -k=freeware /dd/tmp/x.enc /dd/tmp/x.dec
wait    6
run     chksum /dd/SYS/motd /dd/tmp/x.dec
wait    5


shot    macfiles
for     macsave macstream macunpack UnMacpack unsit hexbin macbin
cap     The Macintosh set: StuffIt, MacBinary, BinHex and MacPack, from
cap     when a Mac file had two forks and neither survived a plain copy.
run     unsit
wait    8
run     macunpack
wait    8
run     UnMacpack
wait    8
