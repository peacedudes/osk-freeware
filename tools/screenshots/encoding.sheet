# Encoders, hashes, ciphers and the Macintosh set, one stanza per
# program.  Every stanza makes what it reads under /dd/tmp/ENC.

shot    btoa
cap     Encodes a file as printable text, five characters for every four
cap     bytes, with a checksum on the last line -- denser than uuencode.
try     cat tmp/ENC/j.txt; btoa < tmp/ENC/j.txt
os9     cat tmp/ENC/j.txt; btoa <tmp/ENC/j.txt
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/ENC/j.txt
wait    2
run     btoa < tmp/ENC/j.txt
wait    5

shot    atob
cap     Decodes what btoa encoded: the text comes back exactly.
try     cat tmp/ENC/j.btoa; atob < tmp/ENC/j.btoa
os9     cat tmp/ENC/j.btoa; atob <tmp/ENC/j.btoa
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt; btoa < /dd/tmp/ENC/j.txt > /dd/tmp/ENC/j.btoa
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/ENC/j.btoa
wait    3
run     atob < tmp/ENC/j.btoa
wait    5

shot    uuencode
cap     Wraps a file as printable text, the way binaries crossed mail and
cap     news before attachments: a begin line with the file's mode and
cap     name, the data, an end line.
try     uuencode tmp/ENC/j.txt
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     uuencode tmp/ENC/j.txt
wait    5

shot    uudecode
cap     Undoes uuencode: the file named on the begin line is written back
cap     into the current directory.
try     cat j.uue; uudecode j.uue; ls; cat j.txt
run     rm -rf /dd/tmp/ENC/dec > /nil 2>/nil; mkdir -p /dd/tmp/ENC/dec; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
run     builtin cd /dd/tmp/ENC; uuencode j.txt > dec/j.uue
run     builtin cd /dd/tmp/ENC/dec
wait    3
run     clear
wait    1
run     cat j.uue
wait    3
run     uudecode j.uue
wait    5
run     ls
wait    2
run     cat j.txt
wait    4

shot    uuexpand
cap     Expands a file into a run of `0' and `1' characters, one for each
cap     bit -- despite the shared prefix, unrelated to uuencode.  It is
cap     meant to move a file between machines with different byte or
cap     character sizes; uuexpand -u reverses it, and the checksums here
cap     match.
try     uuexpand < tmp/ENC/j.txt > tmp/ENC/j.exp; cat tmp/ENC/j.exp; uuexpand -u < tmp/ENC/j.exp > tmp/ENC/j.back; chksum tmp/ENC/j.txt tmp/ENC/j.back
os9     uuexpand <tmp/ENC/j.txt >tmp/ENC/j.exp; cat tmp/ENC/j.exp; uuexpand -u <tmp/ENC/j.exp >tmp/ENC/j.back; chksum tmp/ENC/j.txt tmp/ENC/j.back
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     uuexpand < tmp/ENC/j.txt > tmp/ENC/j.exp
wait    3
run     cat tmp/ENC/j.exp
wait    3
run     uuexpand -u < tmp/ENC/j.exp > tmp/ENC/j.back
wait    3
run     chksum tmp/ENC/j.txt tmp/ENC/j.back
wait    4

shot    mimecode
cap     Base64, the binary-to-text encoding mail attachments and the web use.
cap     Here it turns a line of text into printable base64; `mimecode -d'
cap     turns the printable form back into the original bytes.  uuencode and
cap     btoa above are the older kinds.
try     mimecode -e < tmp/ENC/m.txt
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/m.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     mimecode -e < tmp/ENC/m.txt
wait    5

shot    compface
cap     A 48x48 black-and-white face, squeezed into the short line of
cap     printable characters that goes in a mail header's `X-Face:' field.
cap     Readers that understand the field show the picture beside the
cap     message.  The image goes in as 144 hex words, 48 rows of three.
cap     It writes the line without a line feed after it, so this keeps the
cap     output in a file and prints that.
try     compface DOC/compface/face.hex > tmp/CFACE/x; cat tmp/CFACE/x
os9     compface DOC/compface/face.hex >tmp/CFACE/x; cat tmp/CFACE/x
run     rm -f /dd/tmp/CFACE > /nil 2>/nil; mkdir -p /dd/tmp/CFACE > /nil 2>/nil
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     compface DOC/compface/face.hex > tmp/CFACE/x; cat tmp/CFACE/x
wait    6

shot    uncompface
cap     The other direction: an `X-Face:' line turned back into the 144 hex
cap     words it was made from, so the picture can be looked at again.  All
cap     48 rows come out; the last of them are what stays on the screen.
try     uncompface tmp/CFACE/y > tmp/CFACE/back; cat tmp/CFACE/back
os9     uncompface tmp/CFACE/y >tmp/CFACE/back; cat tmp/CFACE/back
run     rm -f /dd/tmp/CFACE > /nil 2>/nil; mkdir -p /dd/tmp/CFACE > /nil 2>/nil
wait    2
run     compface /dd/DOC/compface/face.hex > /dd/tmp/CFACE/y
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     uncompface tmp/CFACE/y > tmp/CFACE/back; cat tmp/CFACE/back
wait    6

shot    checksum
cap     A 16-bit checksum of a file.
try     checksum tmp/ENC/j.txt
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     checksum tmp/ENC/j.txt
wait    4

shot    chksum
cap     The checksum of two of the disk's own files.
try     chksum tmp/ENC/j.txt SYS/motd
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     chksum tmp/ENC/j.txt SYS/motd
wait    4

shot    md5
cap     MD5 digests of three files on the disk.
try     md5 SYS/motd SYS/password DOC/INDEX
run     builtin cd /dd
wait    1
run     clear
wait    1
run     md5 SYS/motd SYS/password DOC/INDEX
wait    5

shot    crypto
cap     An assistant for solving cryptograms: it takes a substitution
cap     cipher text and lets you try letter assignments and see the
cap     result.  These are its options; its interactive commands are
cap     listed by -i.
try     crypto -h
run     crypto -h
wait    6

shot    des
cap     DES file encryption.  It asks for the key twice, writes the result
cap     as the file's name with .n on the end, and removes the original:
cap     35 bytes in, 40 out.  Run over its own output with the same key
cap     it does not restore the original.
try     des tmp/ENC/d.txt; ls -l tmp/ENC/d.txt.n
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/d.txt.n; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/d.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ls -l tmp/ENC/d.txt
wait    3
run     des tmp/ENC/d.txt
wait    4
send    freeware\r
wait    3
send    freeware\r
wait    6
run     ls -l tmp/ENC/d.txt.n
wait    4

shot    xcrypt
cap     Scrambles a file against a key you type at its `Key:' prompt.  Two
cap     things it needs that its syntax line does not say.  The output file
cap     has to exist already: it asks OS-9 to create one with a Unix
cap     permission word, OS-9 reads that word as its own attribute byte and
cap     refuses, and the syntax line you get is that refusal, not a
cap     complaint about your arguments.  And the direction comes from the
cap     name it is invoked by -- one starting with `e' encrypts, anything
cap     else decrypts -- so as `xcrypt' it always takes the decrypt path.
cap     Ten characters of key or more, or it tells you the key is short.
try     xcrypt a.txt a.enc
run     rm -rf /dd/tmp/XCA > /nil 2>/nil; mkdir -p /dd/tmp/XCA
wait    2
run     cat /dd/SYS/motd > /dd/tmp/XCA/a.txt
wait    2
run     builtin cd /dd/tmp/XCA
wait    1
run     clear
wait    1
run     cat a.txt
wait    2
run     echo x > a.enc
wait    2
run     xcrypt a.txt a.enc
wait    3
send    thiskeyisplentylongenough\r
wait    4
run     dump a.enc
wait    3

shot    todos
cap     Turns OS-9 line endings into DOS ones: every CR becomes CR LF.
cap     It writes the converted text into todos.$$$.<n> in the directory
cap     you are standing in and then forks OS-9's own del and rename to
cap     move it over the original, which is where it stops here -- so the
cap     file you named is untouched and the conversion is waiting under
cap     the temporary name.  Rename it yourself, as below.  autolf -c -C
cap     -L does the same job as a filter and renames nothing.
try     todos le.txt
run     rm -rf /dd/tmp/TDOS > /nil 2>/nil; mkdir -p /dd/tmp/TDOS; printf "one\rtwo\r" > /dd/tmp/TDOS/le.txt
wait    2
run     builtin cd /dd/tmp/TDOS
wait    1
run     clear
wait    1
run     dump le.txt
wait    3
run     todos le.txt
wait    5
run     mv todos.* dos.txt
wait    3
run     dump dos.txt
wait    4

shot    toos9
cap     The other direction, DOS line endings back to OS-9, and the same
cap     arrangement: the converted text is left in toos9.$$$.<n> because
cap     the rename onto the original cannot be made here.  Rename it and
cap     there it is.  autolf -C does the same job as a filter.
try     toos9 dos.txt
run     rm -rf /dd/tmp/TOS9 > /nil 2>/nil; mkdir -p /dd/tmp/TOS9; printf "one\rtwo\r" > /dd/tmp/TOS9/le.txt
wait    2
run     builtin cd /dd/tmp/TOS9
wait    1
run     autolf -c -C -L < le.txt > dos.txt
wait    3
run     clear
wait    1
run     dump dos.txt
wait    3
run     toos9 dos.txt
wait    5
run     mv toos9.* os9.txt
wait    3
run     dump os9.txt
wait    4

shot    macbin
cap     Wraps a file in MacBinary, the form a Macintosh file with two
cap     forks travels in: a 128-byte header naming the file, its type and
cap     its creator, then the data padded to 128 bytes.
try     macbin j.txt; ls -l j.txt j.txt.MAC; dump j.txt.MAC
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/j.txt.MAC; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
run     builtin cd /dd/tmp/ENC
wait    2
run     clear
wait    1
run     macbin j.txt
wait    3
run     ls -l j.txt j.txt.MAC
wait    3
run     dump j.txt.MAC
wait    5

shot    binhex
cap     Encodes a MacBinary file as BinHex 4.0, the text form Macintosh
cap     software was posted in: a banner line, then the file in a
cap     64-character alphabet between colons.
try     binhex j.txt.MAC
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/j.txt.MAC; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
run     builtin cd /dd/tmp/ENC
run     macbin j.txt
wait    4
run     clear
wait    1
run     binhex j.txt.MAC
wait    6

shot    mcvert
cap     Converts between MacBinary and BinHex either way: -U makes the
cap     BinHex for uploading, -D takes it back to MacBinary for
cap     downloading.  Here a MacBinary file becomes a .hqx.
try     mcvert -U j.txt.MAC; ls -l j.txt.MAC j.txt01.hqx; cat j.txt01.hqx
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/j.txt.MAC /dd/tmp/ENC/j.txt01.hqx; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
run     builtin cd /dd/tmp/ENC
run     macbin j.txt
wait    4
run     clear
wait    1
run     mcvert -U j.txt.MAC
wait    6
run     ls -l j.txt.MAC j.txt01.hqx
wait    4
run     cat j.txt01.hqx
wait    4

shot    hexbin
cap     Decodes a BinHex file back into the Macintosh file it carried,
cap     written into the current directory.
try     hexbin j.txt01.hqx; ls -l
run     rm -rf /dd/tmp/ENC/hb > /nil 2>/nil; mkdir -p /dd/tmp/ENC/hb; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
run     builtin cd /dd/tmp/ENC; macbin j.txt; mcvert -U j.txt.MAC
run     cp /dd/tmp/ENC/j.txt01.hqx /dd/tmp/ENC/hb/j.txt01.hqx
run     builtin cd /dd/tmp/ENC/hb
wait    5
run     clear
wait    1
run     hexbin j.txt01.hqx
wait    4
run     ls -l
wait    3

shot    macsave
cap     Reads MacBinary from its input and writes the file it carries
cap     into the current directory, silently.
try     macsave < j.txt.MAC; ls -l
os9     macsave <j.txt.MAC; ls -l
run     rm -rf /dd/tmp/ENC/ms > /nil 2>/nil; mkdir -p /dd/tmp/ENC/ms; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
run     builtin cd /dd/tmp/ENC; macbin j.txt
run     cp /dd/tmp/ENC/j.txt.MAC /dd/tmp/ENC/ms/j.txt.MAC
run     builtin cd /dd/tmp/ENC/ms
wait    4
run     clear
wait    1
run     macsave < j.txt.MAC
wait    6
run     ls -l
wait    3

shot    macstream
cap     Combines one or more files into a MacBinary stream on standard
cap     output, the format a Mac terminal program expects.  -d treats a
cap     plain file as data and gives it a placeholder type and creator.
try     macstream -d ms.txt > ms.stream; ls -l ms.stream; dump ms.stream
os9     macstream -d ms.txt >ms.stream; ls -l ms.stream; dump ms.stream
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/ms.stream; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/ms.txt
run     builtin cd /dd/tmp/ENC
wait    2
run     clear
wait    1
run     macstream -d ms.txt > ms.stream
wait    4
run     ls -l ms.stream
wait    2
run     dump ms.stream
wait    4

shot    macunpack
size    24 80
cap     Opens PackIt archives from a Macintosh, listing what it can do:
cap     the fork it writes, the Macintosh-to-Unix text translation, and
cap     the listing and query modes.  `-H' is the flag it names itself;
cap     it rejects `-?'.  No PackIt archive is on this disk to open.
try     macunpack -H
run     clear
wait    1
run     macunpack -H
wait    8

shot    UnMacpack
size    24 80
cap     Another PackIt extractor, listing what it can do: the fork it
cap     writes, the Macintosh-to-Unix text translation, and the listing
cap     and query modes.  `-H' is the flag it names itself; it rejects
cap     `-?'.  No PackIt archive is on this disk to open.
try     UnMacpack -H
run     clear
wait    1
run     UnMacpack -H
wait    8

shot    unsit
cap     Opens StuffIt archives from a Macintosh: its options.  No StuffIt
cap     archive is on this disk to open.
try     unsit -?
run     unsit -?
wait    5

shot    sox
cap     Sound eXchange converting one of the sample sounds in DOC/sox,
cap     an Amiga 8SVX, to Sun .au, and `file' reporting both.  There is
cap     no sound device here, so it converts rather than plays.
try     sox DOC/sox/great_oz.iff -t au tmp/ENC/oz.au; file DOC/sox/great_oz.iff tmp/ENC/oz.au
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/oz.au
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sox DOC/sox/great_oz.iff -t au tmp/ENC/oz.au
wait    10
run     file DOC/sox/great_oz.iff tmp/ENC/oz.au
wait    6

shot    chardef
size    26 80
cap     Loads a soft character set into a VT220 from a definition file --
cap     a character code, then its glyph drawn in `*' and `.' -- and the
cap     disk ships one in DOC/chardef.  What it sends is a DECDLD control
cap     string, which a terminal that is not a VT220 will not show, so it
cap     is put through `dump' here: `ESC P 1;1;1{' opens it and the glyph
cap     follows as letters, one per column.  It calls itself defchar.
try     sed -n '1,12p' DOC/chardef/test; chardef DOC/chardef/test >tmp/cd; dump tmp/cd
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sed -n '1,12p' DOC/chardef/test
wait    4
run     chardef DOC/chardef/test >tmp/cd; dump tmp/cd
wait    8

# Two splitters that used to share a card here.

shot    divide
cap     Splits a file into pieces of so many lines: twelve lines in,
cap     four to a piece, three pieces out, named piece.1, .2 and .3.
try     divide -l=4 tmp/ENC/dv.txt tmp/ENC/piece; ls -l tmp/ENC/piece.1 tmp/ENC/piece.2 tmp/ENC/piece.3; cat tmp/ENC/piece.2
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/piece.*; cat /dd/SYS/holidays | head -n 12 > /dd/tmp/ENC/dv.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     divide -l=4 tmp/ENC/dv.txt tmp/ENC/piece
wait    6
run     ls -l tmp/ENC/piece.1 tmp/ENC/piece.2 tmp/ENC/piece.3
wait    4
run     cat tmp/ENC/piece.2
wait    4

shot    fc
cap     Cuts a big file in two at exactly 350,000 bytes, to carry it on
cap     360K floppies.  Asked for by path because bash has an fc of its
cap     own.  This file is shorter than the cut, so the first piece is
cap     the whole of it.
try     CMDS/fc tmp/ENC/fc.txt; ls -l tmp/ENC/fc.txt tmp/ENC/fc.txt_1
os9     fc tmp/ENC/fc.txt; ls -l tmp/ENC/fc.txt tmp/ENC/fc.txt_1
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/fc.*; cat /dd/SYS/holidays | head -n 12 > /dd/tmp/ENC/fc.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     CMDS/fc tmp/ENC/fc.txt
wait    6
run     ls -l tmp/ENC/fc.txt tmp/ENC/fc.txt_1
wait    5

shot    caesar
size    24 80
cap     caesar breaks a Caesar cipher without being told the shift: it tries
cap     all 25 and keeps the one whose letters look most like English.  Given
cap     a number, as in `caesar 13', it simply shifts by that much.
try     echo "gur dhvpx oebja sbk whzcf bire gur ynml qbt" | caesar
os9     echo "gur dhvpx oebja sbk whzcf bire gur ynml qbt" ! caesar
run     builtin cd /dd
wait    1
run     clear
wait    1
run     echo "gur dhvpx oebja sbk whzcf bire gur ynml qbt" | caesar
wait    5

shot    morse
size    24 80
cap     morse writes text as Morse code: dit and daw, or with -s dots and
cap     dashes, a comma after each letter.
try     morse -s sos
run     builtin cd /dd
wait    1
run     clear
wait    1
run     morse -s sos
wait    5
run     morse hi
wait    5

shot    ppt
size    24 80
cap     ppt punches text onto paper tape: one row of holes for each character,
cap     its bits read across, with the sprocket hole down the middle.
try     ppt OS-9
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppt OS-9
wait    5

shot    bcd
size    24 80
cap     bcd prints text as an 80-column punched card, with a hole punched in
cap     the rows each character's code needs.
try     bcd OS-9
run     builtin cd /dd
wait    1
run     clear
wait    1
run     bcd OS-9
wait    5

shot    translit
cap     Russian text in KOI8 turned into Library of Congress romanization,
cap     from the example that comes with it.
try     translit -t koi8-lc.rus -i ex.ko8 | head -7
run     rm -rf /dd/tmp/TLC > /nil 2>/nil; mkdir -p /dd/tmp/TLC
wait    2
run     builtin cd /dd/tmp/TLC
wait    1
run     uudecode /dd/SRC/translit/ORIG/example.ko8.UU; autolf -C < example.ko8 > ex.ko8
wait    4
run     clear
wait    1
run     translit -t koi8-lc.rus -i ex.ko8 | head -7
wait    8
