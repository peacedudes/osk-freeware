# Encoders, hashes, ciphers and the Macintosh set, one stanza per
# program.  Every stanza makes what it reads under /dd/tmp/ENC.

shot    btoa
cap     Encodes a file as printable text, five characters for every four
cap     bytes, with a checksum on the last line -- denser than uuencode.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/ENC/j.txt
wait    2
run     btoa < tmp/ENC/j.txt
wait    5

shot    atob
cap     Decodes what btoa encoded: the text comes back exactly.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt; btoa < /dd/tmp/ENC/j.txt > /dd/tmp/ENC/j.btoa
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat tmp/ENC/j.btoa
wait    3
run     atob < tmp/ENC/j.btoa
wait    5

shot    uuencode
cap     Wraps a file as printable text, the way binaries crossed mail and
cap     news before attachments: a begin line with the file's mode and
cap     name, the data, an end line.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     uuencode tmp/ENC/j.txt
wait    5

shot    uudecode
cap     Undoes uuencode: the file named on the begin line is written back
cap     into the current directory.
run     mkdir -p /dd/tmp/ENC/dec > /nil 2>/nil; rm -f /dd/tmp/ENC/dec/j.txt; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt; ksh -c "cd /dd/tmp/ENC; uuencode j.txt" > /dd/tmp/ENC/j.uue
wait    3
run     clear
wait    1
run     cat /dd/tmp/ENC/j.uue
wait    3
run     ksh -c "cd /dd/tmp/ENC/dec; uudecode ../j.uue"
wait    5
run     ls -l /dd/tmp/ENC/dec; cat /dd/tmp/ENC/dec/j.txt
wait    4

shot    uuexpand
cap     Pads a uuencoded file's lines out to a fixed width, for a link
cap     that strips trailing spaces; uuunexpand takes them back.  It is
cap     not a decoder -- uudecode is.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt; uuencode /dd/tmp/ENC/j.txt > /dd/tmp/ENC/j.uue
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     uuexpand < tmp/ENC/j.uue
wait    5

shot    checksum
cap     A 16-bit checksum of a file.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     checksum tmp/ENC/j.txt
wait    4

shot    chksum
cap     The checksum of two of the disk's own files.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     chksum tmp/ENC/j.txt SYS/motd
wait    4

shot    md5
cap     MD5 digests of three files on the disk.
run     builtin cd /dd
wait    1
run     clear
wait    1
run     md5 SYS/motd SYS/password DOC/INDEX
wait    5

shot    crypto
cap     An assistant for solving cryptograms: it takes a substitution
cap     cipher text and lets you try letter assignments and see the
cap     result.  These are its options; its interactive commands are
cap     listed by -i.
run     crypto -h
wait    6

shot    des
cap     DES file encryption.  It asks for the key twice, writes the result
cap     as the file's name with .n on the end, and removes the original:
cap     35 bytes in, 40 out.  Run over its own output with the same key
cap     it does not restore the original.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/d.txt.n; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/d.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ls -l tmp/ENC/d.txt
wait    3
run     des tmp/ENC/d.txt
wait    4
send    freeware\r
wait    3
send    freeware\r
wait    6
run     ls -l tmp/ENC/d.txt.n
wait    4

shot    xcrypt
cap     A simple file cipher with a key, and it round-trips: encrypt,
cap     decrypt, and the checksums match.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/x.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     xcrypt -k=freeware tmp/ENC/x.txt tmp/ENC/x.enc
wait    5
run     xcrypt -k=freeware tmp/ENC/x.enc tmp/ENC/x.dec
wait    5
run     chksum tmp/ENC/x.txt tmp/ENC/x.dec
wait    5

shot    todos
cap     Meant to turn OS-9 line endings into DOS ones in place.  It
cap     converts into a temporary file and then cannot rename it back
cap     over the original, so the file comes out unchanged, as the
cap     checksums show.  autolf does the job as a filter.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/le.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     chksum tmp/ENC/le.txt
wait    3
run     todos tmp/ENC/le.txt
wait    4
run     chksum tmp/ENC/le.txt
wait    4

shot    toos9
cap     The other direction, DOS line endings to OS-9, and the same
cap     story: the temporary file cannot be renamed over the original,
cap     so nothing changes.  autolf does the job as a filter.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r\n" > /dd/tmp/ENC/dos.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     chksum tmp/ENC/dos.txt
wait    3
run     toos9 tmp/ENC/dos.txt
wait    4
run     chksum tmp/ENC/dos.txt
wait    4

shot    macbin
cap     Wraps a file in MacBinary, the form a Macintosh file with two
cap     forks travels in: a 128-byte header naming the file, its type and
cap     its creator, then the data padded to 128 bytes.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/j.txt.MAC; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt
wait    2
run     clear
wait    1
run     ksh -c "cd /dd/tmp/ENC; macbin j.txt"; ls -l /dd/tmp/ENC/j.txt /dd/tmp/ENC/j.txt.MAC
wait    5
run     dump /dd/tmp/ENC/j.txt.MAC | head -n 12
wait    5

shot    binhex
cap     Encodes a MacBinary file as BinHex 4.0, the text form Macintosh
cap     software was posted in: a banner line, then the file in a
cap     64-character alphabet between colons.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/j.txt.MAC; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt; ksh -c "cd /dd/tmp/ENC; macbin j.txt"
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     binhex tmp/ENC/j.txt.MAC
wait    6

shot    mcvert
cap     Converts between MacBinary and BinHex either way: -U makes the
cap     BinHex for uploading, -D takes it back to MacBinary for
cap     downloading.  Here a MacBinary file becomes a .hqx.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/j.txt.MAC /dd/tmp/ENC/j.txt01.hqx; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt; ksh -c "cd /dd/tmp/ENC; macbin j.txt"
wait    4
run     clear
wait    1
run     ksh -c "cd /dd/tmp/ENC; mcvert -U j.txt.MAC"
wait    6
run     ls -l /dd/tmp/ENC/j.txt.MAC /dd/tmp/ENC/j.txt01.hqx
wait    4
run     cat /dd/tmp/ENC/j.txt01.hqx
wait    4

shot    hexbin
cap     Decodes a BinHex file back into the Macintosh file it carried,
cap     written into the current directory.
run     mkdir -p /dd/tmp/ENC/hb > /nil 2>/nil; rm -f /dd/tmp/ENC/j.txt.MAC /dd/tmp/ENC/j.txt01.hqx /dd/tmp/ENC/hb/*; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt; ksh -c "cd /dd/tmp/ENC; macbin j.txt; mcvert -U j.txt.MAC"
wait    5
run     clear
wait    1
run     ksh -c "cd /dd/tmp/ENC/hb; hexbin ../j.txt01.hqx"; ls -l /dd/tmp/ENC/hb
wait    6

shot    macsave
cap     Reads MacBinary from its input and writes the file it carries
cap     into the current directory, silently.
run     mkdir -p /dd/tmp/ENC/ms > /nil 2>/nil; rm -f /dd/tmp/ENC/j.txt.MAC /dd/tmp/ENC/ms/*; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/ENC/j.txt; ksh -c "cd /dd/tmp/ENC; macbin j.txt"
wait    4
run     clear
wait    1
run     ksh -c "cd /dd/tmp/ENC/ms; macsave < ../j.txt.MAC"; ls -l /dd/tmp/ENC/ms
wait    6

shot    macstream
cap     Reads a MacBinary stream and lists or extracts the files in it:
cap     its options.
run     macstream -?
wait    5

shot    macunpack
cap     Opens PackIt archives from a Macintosh: its options.  No PackIt
cap     archive is on this disk to open.
run     macunpack -?
wait    5

shot    UnMacpack
cap     Another PackIt extractor: its options.  No PackIt archive is on
cap     this disk to open.
run     UnMacpack -?
wait    5

shot    unsit
cap     Opens StuffIt archives from a Macintosh: its options.  No StuffIt
cap     archive is on this disk to open.
run     unsit -?
wait    5

shot    sox
cap     Sound eXchange converting one of the sample sounds in DOC/sox,
cap     an Amiga 8SVX, to Sun .au, and `file' reporting both.  There is
cap     no sound device here, so it converts rather than plays.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/oz.au
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sox DOC/sox/great_oz.iff -t au tmp/ENC/oz.au
wait    10
run     file DOC/sox/great_oz.iff tmp/ENC/oz.au
wait    6

shot    chardef
cap     Loads a character set into a VT220 terminal from a definition
cap     file: its syntax.  It calls itself defchar.
run     chardef -?
wait    5

# Two splitters that used to share a card here.

shot    divide
cap     Splits a file into pieces of so many lines: twelve lines in,
cap     four to a piece, three pieces out, named piece.1, .2 and .3.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/piece.*; cat /dd/SYS/holidays | head -n 12 > /dd/tmp/ENC/dv.txt
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     divide -l=4 tmp/ENC/dv.txt tmp/ENC/piece
wait    6
run     ls -l tmp/ENC/piece.1 tmp/ENC/piece.2 tmp/ENC/piece.3
wait    4
run     cat tmp/ENC/piece.2
wait    4

shot    fc
cap     Cuts a big file in two at exactly 350,000 bytes, to carry it on
cap     360K floppies.  Asked for by path because bash has an fc of its
cap     own.  This file is shorter than the cut, so the first piece is
cap     the whole of it.
run     mkdir -p /dd/tmp/ENC > /nil 2>/nil; rm -f /dd/tmp/ENC/fc.*; cat /dd/SYS/holidays | head -n 12 > /dd/tmp/ENC/fc.txt
wait    3
run     clear
run     ksh -c "cd /dd/tmp/ENC; /dd/CMDS/fc fc.txt" 2>/nil
wait    6
run     ls -l /dd/tmp/ENC/fc.txt /dd/tmp/ENC/fc.txt_1
wait    5
