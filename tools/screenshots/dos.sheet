# mtools 3.6: MS-DOS media read and written from OS-9, one stanza per
# program.  The floppy image is /dd/DOS/a.img, drive a: in
# SYS/mtools.conf.  Every stanza puts the image into the state it needs
# before its picture, so the sheet means the same thing on every run.

shot    msinfo
cap     What the DOS floppy image is, read out of its own boot sector:
cap     the geometry, the FAT layout and the media byte.
run     msinfo a: | head -n 13
wait    12

shot    mslabel
cap     Puts a volume label on the DOS disk; msdir shows it on its first
cap     line.
run     mscd a:/ > /nil
wait    4
run     clear
wait    1
run     mslabel a:FREEWARE
wait    8
run     msdir a: | head -n 3
wait    6

shot    msformat
cap     Formats DOS media.  Bare, it refuses the image because it is not
cap     removable media, and that is as far as it goes here.
run     msformat a:
wait    10

shot    msdir
cap     The DOS disk's directory, with DOS's own 8.3 names, dates and
cap     free-space line.
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil
wait    10
run     clear
wait    1
run     msdir a:
wait    10

shot    mscopy
cap     Copies a file from OS-9 onto the DOS disk, and the listing shows
cap     it there.
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil
wait    8
run     clear
wait    1
run     mscopy motd a:MOTD.TXT
wait    10
run     msdir a:
wait    10

shot    mstype
cap     Types a file that lives on the DOS disk.
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil
wait    10
run     clear
wait    1
run     mstype a:MOTD.TXT
wait    8

shot    msdel
cap     Deletes a file on the DOS disk: there before, gone after.
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil
wait    10
run     clear
wait    1
run     msdir a: | grep MOTD
wait    8
run     msdel a:MOTD.TXT
wait    8
run     msdir a: | grep -c MOTD
wait    8

shot    msmd
cap     Makes a directory on the DOS disk.
run     mscd a:/ > /nil; msdeltree a:/DOCS > /nil 2>/nil
wait    8
run     clear
wait    1
run     msmd a:/DOCS
wait    8
run     msdir a:
wait    10

shot    mscd
cap     Sets the current directory on the DOS disk, which the other
cap     commands then use, and reports it when asked bare.
run     mscd a:/ > /nil; msdeltree a:/DOCS > /nil 2>/nil; msmd a:/DOCS > /nil
wait    10
run     clear
wait    1
run     mscd a:/DOCS
wait    6
run     mscd
wait    5
run     msdir
wait    8

shot    msrd
cap     Removes an empty directory from the DOS disk.
run     mscd a:/ > /nil; msdeltree a:/EMPTY > /nil 2>/nil; msmd a:/EMPTY > /nil
wait    10
run     clear
wait    1
run     msdir a: | grep EMPTY
wait    8
run     msrd a:/EMPTY
wait    8
run     msdir a: | grep -c EMPTY
wait    8

shot    msdeltree
cap     Removes a directory and everything in it.
run     mscd a:/ > /nil; msdeltree a:/DOCS > /nil 2>/nil; msmd a:/DOCS > /nil; mscopy /dd/SYS/motd a:/DOCS/README.TXT > /nil
wait    12
run     clear
wait    1
run     msdir a:/DOCS
wait    8
run     msdeltree a:/DOCS
wait    8
run     msdir a: | grep -c DOCS
wait    8

shot    msattrib
cap     Sets a DOS attribute and reads it back: R is the read-only bit.
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil
wait    10
run     clear
wait    1
run     msattrib +r a:MOTD.TXT
wait    8
run     msattrib a:MOTD.TXT
wait    8
run     msattrib -r a:MOTD.TXT
wait    8

shot    msmove
cap     Moves a file to another directory on the DOS disk.
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil; msdeltree a:/MOVED > /nil 2>/nil; msmd a:/MOVED > /nil
wait    14
run     clear
wait    1
run     msmove a:MOTD.TXT a:/MOVED/MOTD.TXT
wait    8
run     msdir a:/MOVED
wait    8

shot    msren
cap     Renames a file on the DOS disk.
run     mscd a:/ > /nil; msdel a:OLD.TXT a:NEW.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:OLD.TXT > /nil
wait    10
run     clear
wait    1
run     msren a:OLD.TXT a:NEW.TXT
wait    8
run     msdir a: | grep TXT
wait    8

shot    mswrite
cap     Writes a file onto the DOS disk raw, with none of the DOS
cap     filename rules involved; the checksums show it arrived unchanged.
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     mscd a:/ > /nil; msdel a:RAW.TXT > /nil 2>/nil; rm -f /dd/tmp/raw.out
wait    8
run     clear
wait    1
run     mswrite motd a:RAW.TXT
wait    10
run     msread a:RAW.TXT /dd/tmp/raw.out
wait    10
run     chksum motd /dd/tmp/raw.out
wait    8

shot    msread
cap     Reads a file off the DOS disk raw into an OS-9 file, the other
cap     half of mswrite.
run     mscd a:/ > /nil; msdel a:RAW.TXT > /nil 2>/nil; mswrite /dd/SYS/motd a:RAW.TXT > /nil; rm -f /dd/tmp/raw.out
wait    12
run     clear
wait    1
run     msread a:RAW.TXT /dd/tmp/raw.out
wait    10
run     cat /dd/tmp/raw.out
wait    6

shot    msbadblocks
cap     Reads the whole DOS disk looking for bad blocks, and reports none.
run     msbadblocks a:; echo "status $?"
wait    12

shot    mstoolstest
cap     mtools' own self-test, exercising the library on the disk.
run     mstoolstest
wait    12

shot    mtools
cap     The mtools front end, listing the sub-commands that ship with it;
cap     each is a separate program on this disk.
run     mtools
wait    10

shot    mscheck
cap     A shell script that reads every file on the DOS disk to make sure
cap     each can be read: first the directory, then each file in turn.
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil
wait    10
run     clear
wait    1
run     mscheck
wait    12
