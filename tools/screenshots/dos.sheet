# mtools 3.6: MS-DOS media read and written from OS-9, one stanza per
# program.  The floppy image is /dd/DOS/a.img, drive a: in
# SYS/mtools.conf.  Every stanza puts the image into the state it needs
# before its picture, so the sheet means the same thing on every run.

shot    msinfo
cap     msinfo reads a DOS disk image's own boot sector: the drive
cap     geometry, the sector size, the volume banner, and the mformat
cap     command line that would recreate a disk with the same layout.
try     msinfo a: | head -n 13
os9     msinfo a: ! head -n 13
run     msinfo a: | head -n 13
wait    12
snap

shot    mslabel
cap     mslabel writes a volume label into a DOS disk's boot sector.
cap     msdir's first line then names the label mslabel just set.
try     mslabel a:FREEWARE; msdir a: | head -n 3
os9     mslabel a:FREEWARE; msdir a: ! head -n 3
run     mscd a:/ > /nil
wait    4
run     clear
wait    1
run     mslabel a:FREEWARE
wait    8
run     msdir a: | head -n 3
wait    6
snap

shot    msformat
size    24 150
cap     msformat writes a fresh MS-DOS filesystem to a floppy. Run
cap     against the plain disk image here it refuses outright, because
cap     the drive is not removable media; even given the image's own
cap     geometry it does not complete. A real floppy drive is what the
cap     command wants.
try     msformat a:
run     msformat a:
wait    10
snap

shot    msdir
cap     msdir lists a DOS disk's directory in its own format: 8.3 names,
cap     dates, and the free space left on the disk.
try     msdir a:
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil
wait    10
run     clear
wait    1
run     msdir a:
wait    10
snap

shot    mscopy
cap     mscopy copies a file from OS-9 onto the DOS disk. The directory
cap     listing afterward shows it arrived with a DOS name, a size, and
cap     today's date.
try     mscopy motd a:MOTD.TXT; msdir a:
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil
wait    8
run     clear
wait    1
run     mscopy motd a:MOTD.TXT
wait    10
run     msdir a:
wait    10
snap

shot    mstype
cap     mstype prints the contents of a file that lives on the DOS disk.
try     mstype a:MOTD.TXT | cat
os9     mstype a:MOTD.TXT ! cat
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil
wait    10
run     clear
wait    1
run     mstype a:MOTD.TXT | cat
wait    10
snap

shot    msdel
cap     msdel deletes a file from the DOS disk. The listing before and
cap     the count after show it gone.
try     msdir a: | grep MOTD; msdel a:MOTD.TXT; msdir a: | grep -c MOTD
os9     msdir a: ! grep MOTD; msdel a:MOTD.TXT; msdir a: ! grep -c MOTD
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil
wait    10
run     clear
wait    1
run     msdir a: | grep MOTD
wait    8
run     msdel a:MOTD.TXT
wait    8
run     msdir a: | grep -c MOTD
wait    8
snap

shot    msmd
cap     msmd makes a directory on the DOS disk, the way `mkdir' does on
cap     OS-9's own filesystem.
try     msmd a:/DOCS; msdir a:
run     mscd a:/ > /nil; msdeltree a:/DOCS > /nil 2>/nil; msdel a:MOTD.TXT > /nil 2>/nil
wait    8
run     clear
wait    1
run     msmd a:/DOCS
wait    8
run     msdir a:
wait    10
snap

shot    mscd
cap     mscd sets mtools' own idea of the current directory on the DOS
cap     disk, so the other mtools commands can use a name instead of a
cap     full DOS path; asked bare it reports where it is. DOS counts the
cap     `.' and `..' entries every directory carries as files of their
cap     own, which is why an empty new directory still shows two.
try     mscd a:/DOCS; mscd; msdir
run     mscd a:/ > /nil; msdeltree a:/DOCS > /nil 2>/nil; msmd a:/DOCS > /nil
wait    10
run     clear
wait    1
run     mscd a:/DOCS
wait    6
run     mscd
wait    5
run     msdir
wait    8
snap

shot    msrd
cap     msrd removes an empty directory from the DOS disk. The listing
cap     before and the count after show it gone.
try     msdir a: | grep EMPTY; msrd a:/EMPTY; msdir a: | grep -c EMPTY
os9     msdir a: ! grep EMPTY; msrd a:/EMPTY; msdir a: ! grep -c EMPTY
run     mscd a:/ > /nil; msdeltree a:/EMPTY > /nil 2>/nil; msmd a:/EMPTY > /nil
wait    10
run     clear
wait    1
run     msdir a: | grep EMPTY
wait    8
run     msrd a:/EMPTY
wait    8
run     msdir a: | grep -c EMPTY
wait    8
snap

shot    msdeltree
cap     msdeltree removes a directory and everything inside it in one
cap     step, naming each file as it goes.  Beforehand the directory holds
cap     three -- the file and the two markers DOS keeps; afterwards it is gone.
try     msdir a:/DOCS; msdeltree a:/DOCS; msdir a: | grep -c DOCS
os9     msdir a:/DOCS; msdeltree a:/DOCS; msdir a: ! grep -c DOCS
run     mscd a:/ > /nil; msdeltree a:/DOCS > /nil 2>/nil; msmd a:/DOCS > /nil; mscopy /dd/SYS/motd a:/DOCS/README.TXT > /nil
wait    12
run     clear
wait    1
run     msdir a:/DOCS
wait    8
run     msdeltree a:/DOCS
wait    8
run     msdir a: | grep -c DOCS
wait    8
snap

shot    msattrib
cap     msattrib sets and reads back a DOS file's attribute bits. `+r'
cap     turns on the read-only bit; asked bare it prints the current
cap     flags, `R' for read-only among them and `A' for the archive bit,
cap     which mscopy already set when it wrote the file. `-r' turns
cap     read-only back off.
try     msattrib +r a:MOTD.TXT; msattrib a:MOTD.TXT; msattrib -r a:MOTD.TXT
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil
wait    10
run     clear
wait    1
run     msattrib +r a:MOTD.TXT
wait    8
run     msattrib a:MOTD.TXT
wait    8
run     msattrib -r a:MOTD.TXT
wait    8
snap

shot    msmove
cap     msmove moves a file into a different directory on the DOS disk,
cap     the way OS-9's own `move' does.
try     msmove a:MOTD.TXT a:/MOVED/MOTD.TXT; msdir a:/MOVED
run     mscd a:/ > /nil; msdel a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil; msdeltree a:/MOVED > /nil 2>/nil; msmd a:/MOVED > /nil
wait    14
run     clear
wait    1
run     msmove a:MOTD.TXT a:/MOVED/MOTD.TXT
wait    8
run     msdir a:/MOVED
wait    8
snap

shot    msren
cap     msren renames a file on the DOS disk in place.
try     msren a:OLD.TXT a:NEW.TXT; msdir a: | grep TXT
os9     msren a:OLD.TXT a:NEW.TXT; msdir a: ! grep TXT
run     mscd a:/ > /nil; msdel a:OLD.TXT a:NEW.TXT a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:OLD.TXT > /nil
wait    10
run     clear
wait    1
run     msren a:OLD.TXT a:NEW.TXT
wait    8
run     msdir a: | grep TXT
wait    8
snap

shot    mswrite
cap     mswrite is mscopy under another name, the same program: without
cap     -t it copies byte for byte.  Written onto the DOS disk and read
cap     back with msread, the file checksums the same both times: nothing
cap     changed in the round trip.
try     mswrite motd a:RAW.TXT; msread a:RAW.TXT raw.out; chksum motd raw.out
run     rm -rf /dd/tmp/DOSB > /nil 2>/nil; mkdir -p /dd/tmp/DOSB; cp /dd/SYS/motd /dd/tmp/DOSB/motd
wait    6
run     builtin cd /dd/tmp/DOSB
wait    1
run     mscd a:/ > /nil; msdel a:RAW.TXT > /nil 2>/nil
wait    8
run     clear
wait    1
run     mswrite motd a:RAW.TXT
wait    10
run     msread a:RAW.TXT raw.out
wait    10
run     chksum motd raw.out
wait    8
snap

shot    msread
cap     msread is mscopy under another name, the same program: here it
cap     copies a file off the DOS disk, byte for byte, into a file on OS-9.
try     msread a:RAW.TXT raw.out; cat raw.out
run     rm -rf /dd/tmp/DOSB > /nil 2>/nil; mkdir -p /dd/tmp/DOSB
wait    4
run     builtin cd /dd/tmp/DOSB
wait    1
run     mscd a:/ > /nil; msdel a:RAW.TXT > /nil 2>/nil; mswrite /dd/SYS/motd a:RAW.TXT > /nil
wait    12
run     clear
wait    1
run     msread a:RAW.TXT raw.out
wait    10
run     cat raw.out
wait    6
snap

shot    msbadblocks
cap     msbadblocks reads every used cluster on the DOS disk looking for
cap     ones that fail to read, and marks any it finds as bad so nothing
cap     is written there again. It says nothing when the disk is fine,
cap     which this one is.
try     msbadblocks a:; echo scan finished
run     msbadblocks a:
wait    10
run     echo scan finished
wait    4
snap

shot    mstoolstest
cap     mstoolstest prints mtools' own resolved configuration: the
cap     drives it knows about, the image file behind each one, and the
cap     settings it would use. Shown here are drive a: and b:, each
cap     mapped to the image file mtools.conf points it at.
try     mstoolstest | head -n 14
os9     mstoolstest ! head -n 14
run     mstoolstest | head -n 14
wait    10
snap

shot    mtools
cap     mtools is the suite's own front end: called bare, or under any
cap     name it does not recognise, it lists every sub-command that
cap     ships with it. Each of those is also its own separate program on
cap     this disk.
try     mtools
run     mtools
wait    10
snap

shot    mscheck
cap     mscheck is a shell script that checks a DOS disk is readable: it
cap     lists the directory, then reads every file in it in turn and
cap     reports whether the disk came back clean.
try     mscheck
os9     ksh mscheck
run     mscd a:/ > /nil; msdeltree a:/MOVED > /nil 2>/nil; msdeltree a:/DOCS > /nil 2>/nil; msdel a:NEW.TXT a:RAW.TXT a:MOTD.TXT > /nil 2>/nil; mscopy /dd/SYS/motd a:MOTD.TXT > /nil
wait    12
run     clear
wait    1
run     mscheck
wait    12
snap
