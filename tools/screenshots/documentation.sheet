# The help system and the pagers.

shot    help
cap     The article on dinfo, paged from its .hlp file in SYS/HELP; at the end
cap     it offers the subtopics.  At bash, type `enable -n help' once first.
try     help dinfo
run     enable -n help
wait    1
run     clear
wait    1
run     help dinfo
wait    6
snap
send    q
wait    2

shot    helpindex
cap     Builds the index a help file needs before help can page it.
cap     Given dinfo.hlp it writes dinfo.ndx beside it, one entry per
cap     page, and says how many pages it found.
try     helpindex dinfo.hlp
run     rm -rf /dd/tmp/DOCB > /nil 2>/nil; mkdir -p /dd/tmp/DOCB; cp /dd/SYS/HELP/dinfo.hlp /dd/tmp/DOCB/dinfo.hlp
run     builtin cd /dd/tmp/DOCB
wait    3
run     clear
wait    1
run     helpindex dinfo.hlp
wait    5
run     ls -l
wait    4

shot    man
cap     The collection's librarian.  `man <name>' shows everything the disk
cap     has about a program: here elm's documents, listed on a cover page
cap     and then read one after another in less (:n for the next).
cap     `man -k <word>' finds programs by what they do; `man -s <name>'
cap     reads the source.  Written for this collection; it is a shell
cap     script, so you can read it too.
try     man elm
run     clear
wait    1
run     man elm
wait    16

shot    less
cap     The first page of the TILE Forth manual, with the file's name on the
cap     prompt line at the foot.
try     less DOC/forth/tile.doc
run     builtin cd /dd
wait    1
run     clear
wait    1
run     less DOC/forth/tile.doc
wait    5
snap
send    q
wait    2

shot    lessecho
cap     Prints its arguments back on one line, the way less hands file
cap     names to a shell: an argument containing a space comes back
cap     inside quotes, so the shell keeps it as one word.
try     lessecho one "two words" three
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     lessecho one "two words" three
wait    4

shot    lesskey
cap     Turns a key-binding file into the binary less reads from
cap     $HOME/.less.  The input names a section and then one key and one
cap     command per line; here z and Z are made to page forward and back,
cap     and -o says where to write the result.
try     lesskey -o lesskeys keys
run     rm -rf /dd/tmp/DOCK > /nil 2>/nil; mkdir -p /dd/tmp/DOCK
wait    2
run     builtin cd /dd/tmp/DOCK
wait    1
run     echo "#command" > keys; echo "z forw-screen" >> keys; echo "Z back-screen" >> keys
wait    2
run     clear
wait    1
run     cat keys
wait    2
run     lesskey -o lesskeys keys
wait    4
run     ls -l lesskeys
wait    3
