# netpbm "into PNM" readers: each takes a FOREIGN image -- a fax stream, a
# workstation bitmap, a paint-program file, a scanner or ray-tracer format --
# and writes it back OUT as a PNM (a PBM bitmap, a PGM greyscale or a PPM
# colour picture).  Where this disk also carries the matching writer, the
# card makes a real file in that format and reads it back, so the picture is
# a round trip and pnmfile confirms a valid PNM came out.  Where no writer
# for the format ships, a small file in the format is made by hand -- printf
# for the text, pbyte for the bytes printf cannot write -- wherever the
# format is simple enough; the rest are handed a file they are not meant to
# read and shown rejecting it.
#
# Every stanza is self-contained: it makes its own input under /dd/tmp,
# so `--only <name>' works.  Stanzas run top to bottom.

# ---- round trips: the matching writer ships, so read back what it wrote ----

shot    asciitopgm
cap     Turns ASCII art back into a greyscale image, each character weighted
cap     by how much ink it carries.  pbmtext and pbmtoascii draw the word
cap     `npbm' as characters, and asciitopgm reads those 8 lines of 40
cap     back; pnmfile confirms a 40x8 PGM came out.
try     pbmtext "npbm" | pbmtoascii > art.txt; cat art.txt; asciitopgm 8 40 < art.txt > a.pgm; pnmfile a.pgm
os9     pbmtext "npbm" ! pbmtoascii >-art.txt; cat art.txt; asciitopgm 8 40 <art.txt >-a.pgm; pnmfile a.pgm
run     rm -rf /dd/tmp/ASCB > /nil 2>/nil; mkdir -p /dd/tmp/ASCB
wait    3
run     builtin cd /dd/tmp/ASCB
wait    1
run     clear
wait    1
run     pbmtext "npbm" | pbmtoascii > art.txt
wait    14
run     cat art.txt
wait    14
run     asciitopgm 8 40 < art.txt > a.pgm
wait    14
run     pnmfile a.pgm
wait    14

shot    fstopgm
cap     Reads a Usenix FaceSaver file -- the mugshot format of the Usenix
cap     face database -- back into a greyscale image.  pgmtofs writes the
cap     ramp out as a FaceSaver, fstopgm reads it, pnmfile confirms the PGM.
try     fstopgm tmp/NPIB/f.fs > tmp/NPIB/back.pgm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     pgmramp -lr 48 24 > /dd/tmp/NPIB/g.pgm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     pgmtofs tmp/NPIB/g.pgm > tmp/NPIB/f.fs
wait    5
run     fstopgm tmp/NPIB/f.fs > tmp/NPIB/back.pgm
wait    5
run     pnmfile tmp/NPIB/back.pgm
wait    5

shot    lispmtopgm
cap     Reads a Lisp Machine bitmap -- the screen format of Symbolics and TI
cap     Lisp machines -- back into a greyscale image.  A ramp of 256 grey
cap     levels goes out through pgmtolispm and comes back whole.
try     lispmtopgm tmp/NPIB/l.lispm > tmp/NPIB/back.pgm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     pgmramp -lr 48 24 > /dd/tmp/NPIB/g.pgm
wait    6
run     builtin cd /dd
wait    1
run     clear
run     pgmtolispm tmp/NPIB/g.pgm > tmp/NPIB/l.lispm
wait    5
run     lispmtopgm tmp/NPIB/l.lispm > tmp/NPIB/back.pgm
wait    5
run     pnmfile tmp/NPIB/back.pgm
wait    5

shot    psidtopgm
cap     Reads the hex digits of PostScript `image' operator data into a
cap     greyscale image.  Given a width, height and bits per sample it
cap     decodes the hex: a white row over a black one.
try     psidtopgm 8 2 8 < tmp/NPIB/i.ps > tmp/NPIB/p.pgm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     builtin cd /dd
wait    1
run     clear
run     echo ffffffffffffffff0000000000000000 > tmp/NPIB/i.ps
wait    3
run     psidtopgm 8 2 8 < tmp/NPIB/i.ps > tmp/NPIB/p.pgm
wait    5
run     pnmnoraw tmp/NPIB/p.pgm
wait    5

shot    rawtopgm
cap     Reads headerless bytes as a greyscale image, given the width and
cap     height -- how you get a picture out of a machine that wrote no header
cap     at all.  Sixteen letters make an 8x2 strip, each letter's code its
cap     grey.
try     printf "ABCDEFGHabcdefgh" > r.raw; rawtopgm 8 2 r.raw | pnmnoraw
os9     printf "ABCDEFGHabcdefgh" >-r.raw; rawtopgm 8 2 r.raw ! pnmnoraw
run     rm -rf /dd/tmp/RAWG > /nil 2>/nil; mkdir -p /dd/tmp/RAWG
wait    3
run     builtin cd /dd/tmp/RAWG
wait    1
run     clear
wait    1
run     printf "ABCDEFGHabcdefgh" > r.raw; rawtopgm 8 2 r.raw | pnmnoraw
wait    8

shot    rawtoppm
cap     Reads headerless bytes as a colour image, three to a pixel, given
cap     the width and height.  Twenty-four letters make a 4x2 picture, their
cap     codes the red, green and blue that pnmnoraw spells out.
try     printf "ABCDEFGHIJKLabcdefghijkl" > r.raw; rawtoppm 4 2 r.raw | pnmnoraw
os9     printf "ABCDEFGHIJKLabcdefghijkl" >-r.raw; rawtoppm 4 2 r.raw ! pnmnoraw
run     rm -rf /dd/tmp/RAWP > /nil 2>/nil; mkdir -p /dd/tmp/RAWP
wait    3
run     builtin cd /dd/tmp/RAWP
wait    1
run     clear
wait    1
run     printf "ABCDEFGHIJKLabcdefghijkl" > r.raw
wait    3
run     rawtoppm 4 2 r.raw | pnmnoraw
wait    8

shot    sldtoppm
cap     Reads an AutoCAD slide (.sld) -- the format AutoCAD shows in a slide
cap     show -- back into a colour image.  A slide is written from a colour
cap     map, so ppmquant 16 first; ppmtoacad writes it and sldtoppm reads it.
try     sldtoppm tmp/NPIB/s.sld > tmp/NPIB/back.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmpat -gingham3 48 24 > /dd/tmp/NPIB/c.ppm
wait    5
run     ppmquant 16 /dd/tmp/NPIB/c.ppm > /dd/tmp/NPIB/q.ppm
wait    6
run     builtin cd /dd
wait    1
run     clear
run     ppmtoacad tmp/NPIB/q.ppm > tmp/NPIB/s.sld
wait    5
run     sldtoppm tmp/NPIB/s.sld > tmp/NPIB/back.ppm
wait    5
run     pnmfile tmp/NPIB/back.ppm
wait    5

shot    tgatoppm
cap     Reads a Targa (.tga) image -- the Truevision workstation format --
cap     back into a colour image.  ppmtotga writes the colour pattern out as
cap     a Targa, tgatoppm reads it, pnmfile confirms the PPM.
try     tgatoppm tmp/NPIB/t.tga > tmp/NPIB/back.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmpat -gingham3 48 24 > /dd/tmp/NPIB/c.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     ppmtotga tmp/NPIB/c.ppm > tmp/NPIB/t.tga
wait    5
run     tgatoppm tmp/NPIB/t.tga > tmp/NPIB/back.ppm
wait    5
run     pnmfile tmp/NPIB/back.ppm
wait    5

shot    xbmtopbm
cap     Reads an X11 bitmap -- the C source X uses for cursors and icons --
cap     back into a bitmap.  pbmtoxbm writes the test bitmap out as an X
cap     bitmap, xbmtopbm reads it, pnmfile confirms the PBM.
try     xbmtopbm tmp/NPIB/t.xbm > tmp/NPIB/back.pbm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     pbmmake -g 48 24 > /dd/tmp/NPIB/b.pbm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     pbmtoxbm tmp/NPIB/b.pbm > tmp/NPIB/t.xbm
wait    5
run     xbmtopbm tmp/NPIB/t.xbm > tmp/NPIB/back.pbm
wait    5
run     pnmfile tmp/NPIB/back.pbm
wait    5

shot    yuvsplittoppm
cap     Reads Abekas YUV video split across three files -- <name>.Y luma and
cap     <name>.U/.V chroma -- back into a colour image, given its width and
cap     height.  ppmtoyuvsplit writes the three, yuvsplittoppm reassembles.
try     yuvsplittoppm tmp/NPIB/y 48 24 > tmp/NPIB/back.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmpat -gingham3 48 24 > /dd/tmp/NPIB/c.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     ppmtoyuvsplit tmp/NPIB/y tmp/NPIB/c.ppm
wait    5
run     yuvsplittoppm tmp/NPIB/y 48 24 > tmp/NPIB/back.ppm
wait    5
run     pnmfile tmp/NPIB/back.ppm
wait    5

# ---- no writer for the format ships: a sample is made by hand where the
#      format allows, and otherwise the reader is shown rejecting a stranger

shot    bioradtopgm
cap     Reads a Bio-Rad confocal microscope image: a 76-byte header, then
cap     a stack of images.  No such file ships, so one is made here --
cap     printf writes the header with its 12345 signature (the `90' at byte
cap     54), pbyte sets the size to 4 by 2, one image, bytes.  Given no
cap     image number it only reports what the file holds; -0 takes the
cap     first image, and the letters' codes come back as greys.
try     bioradtopgm x.pic; bioradtopgm -0 x.pic | pnmnoraw
os9     bioradtopgm x.pic; bioradtopgm -0 x.pic ! pnmnoraw
run     rm -rf /dd/tmp/BIOB > /nil 2>/nil; mkdir -p /dd/tmp/BIOB
wait    3
run     builtin cd /dd/tmp/BIOB
wait    1
run     printf "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx90xxxxxxxxxxxxxxxxxxxx" > x.pic; printf "ABCDabcd" >> x.pic
wait    3
run     pbyte x.pic 0 04; pbyte x.pic 1 00; pbyte x.pic 2 02; pbyte x.pic 3 00; pbyte x.pic 4 01; pbyte x.pic 5 00; pbyte x.pic e 01; pbyte x.pic f 00
wait    6
run     clear
wait    1
run     bioradtopgm x.pic
wait    6
run     bioradtopgm -0 x.pic | pnmnoraw
wait    8

shot    brushtopbm
cap     Reads a Xerox doodle brush file into a bitmap.  DOC/samples holds a
cap     small one, made here from the format this program reads, of the
cap     letters OS9; pbmtoascii shows the bitmap it becomes.
try     brushtopbm DOC/samples/os9.brush | pbmtoascii
run     builtin cd /dd
wait    1
run     clear
wait    1
run     brushtopbm DOC/samples/os9.brush | pbmtoascii
wait    6

shot    gouldtoppm
cap     Reads a Gould scanner image: a 512-byte header, then the pixels.
cap     No such file ships, so one is made here -- printf pads a header of
cap     spaces, pbyte sets two lines of twelve bytes at 24 bits a pixel --
cap     and twenty-four letters come back as the colours of a 4x2 picture.
try     gouldtoppm x.gould | pnmnoraw
os9     gouldtoppm x.gould ! pnmnoraw
run     rm -rf /dd/tmp/GOUB > /nil 2>/nil; mkdir -p /dd/tmp/GOUB
wait    3
run     builtin cd /dd/tmp/GOUB
wait    1
run     printf "%512s" "" > x.gould; printf "ABCDEFGHIJKLabcdefghijkl" >> x.gould
wait    3
run     pbyte x.gould 2 02; pbyte x.gould 3 00; pbyte x.gould 4 0c; pbyte x.gould 5 00; pbyte x.gould 6 18; pbyte x.gould 7 00; pbyte x.gould 8 01; pbyte x.gould 9 00
wait    6
run     clear
wait    1
run     gouldtoppm x.gould | pnmnoraw
wait    8

shot    hipstopgm
cap     A HIPS file is nine lines of header and a line holding one dot,
cap     then one byte a pixel, so printf can write one: here rows 2,
cap     columns 8, and sixteen characters that come back as a strip of
cap     greys eight pixels by two.
try     printf "osk\rstrip\r1\rtoday\r2\r8\r8\r0\r0\r.\r" > x.hips; printf "0123456789abcdef" >> x.hips; hipstopgm x.hips | pnmnoraw
os9     printf "osk\rstrip\r1\rtoday\r2\r8\r8\r0\r0\r.\r" >-x.hips; printf "0123456789abcdef" >+x.hips; hipstopgm x.hips ! pnmnoraw
run     rm -rf /dd/tmp/HIPB > /nil 2>/nil; mkdir -p /dd/tmp/HIPB
wait    3
run     builtin cd /dd/tmp/HIPB
wait    1
run     clear
wait    1
run     printf "osk\rstrip\r1\rtoday\r2\r8\r8\r0\r0\r.\r" > x.hips
wait    10
run     printf "0123456789abcdef" >> x.hips
wait    10
run     hipstopgm x.hips | pnmnoraw
wait    10

shot    hpcdtoppm
cap     Reads a Kodak Photo CD image into a colour picture.  No Photo CD
cap     file ships here; handed a small colour picture instead it stops with
cap     a read error.
try     hpcdtoppm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     hpcdtoppm tmp/NPIB/nr.ppm
wait    5

shot    imgtoppm
cap     Reads an Img Software Set (AT&T Image-8) picture.  Its blocks are
cap     tagged in plain text -- AT with the width, height and colour-map
cap     size in four digits each, PD with the pixels, each with an
cap     eight-digit length -- so printf can write one: a 4x2 picture of
cap     greys, the letters' codes.
try     printf "IMGFILE0AT00000012000400020000PD00000008ABCDabcd" > x.img; imgtoppm x.img | pnmnoraw
os9     printf "IMGFILE0AT00000012000400020000PD00000008ABCDabcd" >-x.img; imgtoppm x.img ! pnmnoraw
run     rm -rf /dd/tmp/IMGB > /nil 2>/nil; mkdir -p /dd/tmp/IMGB
wait    3
run     builtin cd /dd/tmp/IMGB
wait    1
run     clear
wait    1
run     printf "IMGFILE0AT00000012000400020000PD00000008ABCDabcd" > x.img
wait    8
run     imgtoppm x.img | pnmnoraw
wait    8

shot    mtvtoppm
cap     An MTV image is one line of width and height, then three bytes a
cap     pixel, so printf can write one: twenty-four characters make a
cap     picture four pixels by two, and their codes are the colours that
cap     come out.
try     printf "4 2\r" > x.mtv; printf "0123456789abcdefghijklmn" >> x.mtv; mtvtoppm x.mtv | pnmnoraw
os9     printf "4 2\r" >-x.mtv; printf "0123456789abcdefghijklmn" >+x.mtv; mtvtoppm x.mtv ! pnmnoraw
run     rm -rf /dd/tmp/MTVB > /nil 2>/nil; mkdir -p /dd/tmp/MTVB
wait    3
run     builtin cd /dd/tmp/MTVB
wait    1
run     clear
wait    1
run     printf "4 2\r" > x.mtv
wait    10
run     printf "0123456789abcdefghijklmn" >> x.mtv
wait    10
run     mtvtoppm x.mtv | pnmnoraw
wait    10

shot    spctoppm
cap     Reads an Atari ST Spectrum 512 picture into a colour image.  No
cap     Spectrum file ships here; handed a colour picture it says it is not a
cap     Spectrum picture rather than guessing.
try     spctoppm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     spctoppm tmp/NPIB/nr.ppm
wait    5

shot    spottopgm
cap     Reads a SPOT satellite image into a greyscale picture, optionally
cap     cropped to a rectangle.  No SPOT file ships here; run with no
cap     arguments it prints what it expects.
try     spottopgm
run     clear
run     spottopgm
wait    5

shot    ximtoppm
cap     Reads an X image (.xim) into a colour picture.  No xim file ships
cap     here; handed a colour picture it says it cannot read the xim header
cap     rather than guessing.
try     ximtoppm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     ximtoppm tmp/NPIB/nr.ppm
wait    5

shot    xvminitoppm
cap     An XV thumbnail indexes a fixed palette -- three bits of red, three
cap     of green and two of blue a byte -- after a three-line header, so
cap     printf can write one.  Sixteen bytes make a strip eight pixels by
cap     two.
try     printf "P7 332\r#END_OF_COMMENTS\r8 2 255\r" > x.xv; printf "0123456789abcdef" >> x.xv; xvminitoppm x.xv | pnmnoraw
os9     printf "P7 332\r#END_OF_COMMENTS\r8 2 255\r" >-x.xv; printf "0123456789abcdef" >+x.xv; xvminitoppm x.xv ! pnmnoraw
run     rm -rf /dd/tmp/XVB > /nil 2>/nil; mkdir -p /dd/tmp/XVB
wait    3
run     builtin cd /dd/tmp/XVB
wait    1
run     clear
wait    1
run     printf "P7 332\r#END_OF_COMMENTS\r8 2 255\r" > x.xv
wait    10
run     printf "0123456789abcdef" >> x.xv
wait    10
run     xvminitoppm x.xv | pnmnoraw
wait    10

shot    zeisstopnm
cap     Reads a Zeiss confocal microscope image into a PNM.  No Zeiss file
cap     ships here; handed a small colour picture it says the input is not in
cap     Zeiss format rather than guessing.
try     zeisstopnm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     zeisstopnm tmp/NPIB/nr.ppm
wait    5
