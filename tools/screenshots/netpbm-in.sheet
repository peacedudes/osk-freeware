# netpbm "into PNM" readers: each takes a FOREIGN image -- a fax stream, a
# workstation bitmap, a paint-program file, a scanner or ray-tracer format --
# and writes it back OUT as a PNM (a PBM bitmap, a PGM greyscale or a PPM
# colour picture).  Where this disk also carries the matching writer, the
# card makes a real file in that format and reads it back, so the picture is
# a round trip and pnmfile confirms a valid PNM came out.  Where no writer
# for the format ships, the reader is handed a file it is not meant to read
# and shown rejecting it by name -- which is what it does when a stranger
# gives it the wrong thing.
#
# Every stanza is self-contained: it makes its own input under /dd/tmp/NPIB,
# so `--only <name>' works.  Stanzas run top to bottom.

# ---- round trips: the matching writer ships, so read back what it wrote ----

shot    asciitopgm
cap     Turns ASCII art back into a greyscale image, each character weighted
cap     by how much ink it carries.  Here it reads the picture pbmtoascii
cap     drew of the word `npbm', and pnmfile confirms a 40x8 PGM came out.
try     asciitopgm 8 40 < tmp/NPIB/art.txt > tmp/NPIB/a.pgm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     pbmtext "npbm" | pbmtoascii > /dd/tmp/NPIB/art.txt
wait    8
run     builtin cd /dd
wait    1
run     clear
run     cat tmp/NPIB/art.txt
wait    3
run     asciitopgm 8 40 < tmp/NPIB/art.txt > tmp/NPIB/a.pgm
wait    5
run     pnmfile tmp/NPIB/a.pgm
wait    5

shot    fstopgm
cap     Reads a Usenix FaceSaver file -- the mugshot format of the Usenix
cap     face database -- back into a greyscale image.  pgmtofs writes the
cap     ramp out as a FaceSaver, fstopgm reads it, pnmfile confirms the PGM.
try     fstopgm tmp/NPIB/f.fs > tmp/NPIB/back.pgm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     pgmramp -lr 48 24 > /dd/tmp/NPIB/g.pgm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     pgmtofs tmp/NPIB/g.pgm > tmp/NPIB/f.fs
wait    5
run     fstopgm tmp/NPIB/f.fs > tmp/NPIB/back.pgm
wait    5
run     pnmfile tmp/NPIB/back.pgm
wait    5

shot    lispmtopgm
cap     Reads a Lisp Machine bitmap -- the screen format of Symbolics and TI
cap     Lisp machines -- back into a greyscale image.  pgmtolispm handles at
cap     most 16 grey levels, so pnmdepth 15 first; the ramp round-trips.
try     lispmtopgm tmp/NPIB/l.lispm > tmp/NPIB/back.pgm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     pgmramp -lr 48 24 | pnmdepth 15 > /dd/tmp/NPIB/g15.pgm
wait    6
run     builtin cd /dd
wait    1
run     clear
run     pgmtolispm tmp/NPIB/g15.pgm > tmp/NPIB/l.lispm
wait    5
run     lispmtopgm tmp/NPIB/l.lispm > tmp/NPIB/back.pgm
wait    5
run     pnmfile tmp/NPIB/back.pgm
wait    5

shot    psidtopgm
cap     Reads the hex digits of PostScript `image' operator data into a
cap     greyscale image -- not a scanner format.  Given a width, height and
cap     bits per sample it decodes the hex: a white row over a black one.
try     psidtopgm 8 2 8 < tmp/NPIB/i.ps > tmp/NPIB/p.pgm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     builtin cd /dd
wait    1
run     clear
run     echo ffffffffffffffff0000000000000000 > tmp/NPIB/i.ps
wait    3
run     psidtopgm 8 2 8 < tmp/NPIB/i.ps > tmp/NPIB/p.pgm
wait    5
run     pnmnoraw tmp/NPIB/p.pgm
wait    5

shot    rawtopgm
cap     Reads headerless bytes as a greyscale image, given the width and
cap     height -- how you get a picture out of a machine that wrote no header
cap     at all.  Fed the pixel bytes of a ramp, pnmfile confirms a 48x24 PGM.
try     rawtopgm 48 24 < tmp/NPIB/g.pgm > tmp/NPIB/r.pgm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     pgmramp -lr 48 24 > /dd/tmp/NPIB/g.pgm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     rawtopgm 48 24 < tmp/NPIB/g.pgm > tmp/NPIB/r.pgm
wait    5
run     pnmfile tmp/NPIB/r.pgm
wait    5

shot    rawtoppm
cap     Reads headerless bytes as a colour image, given the width and height.
cap     Fed the pixel bytes of a colour pattern, pnmfile confirms a 48x24
cap     PPM came out.
try     rawtoppm 48 24 < tmp/NPIB/c.ppm > tmp/NPIB/r.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmpat -gingham3 48 24 > /dd/tmp/NPIB/c.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     rawtoppm 48 24 < tmp/NPIB/c.ppm > tmp/NPIB/r.ppm
wait    5
run     pnmfile tmp/NPIB/r.ppm
wait    5

shot    sldtoppm
cap     Reads an AutoCAD slide (.sld) -- the format AutoCAD shows in a slide
cap     show -- back into a colour image.  A slide is written from a colour
cap     map, so ppmquant 16 first; ppmtoacad writes it and sldtoppm reads it.
try     sldtoppm tmp/NPIB/s.sld > tmp/NPIB/back.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmpat -gingham3 48 24 > /dd/tmp/NPIB/c.ppm
wait    5
run     ppmquant 16 /dd/tmp/NPIB/c.ppm > /dd/tmp/NPIB/q.ppm
wait    6
run     builtin cd /dd
wait    1
run     clear
run     ppmtoacad tmp/NPIB/q.ppm > tmp/NPIB/s.sld
wait    5
run     sldtoppm tmp/NPIB/s.sld > tmp/NPIB/back.ppm
wait    5
run     pnmfile tmp/NPIB/back.ppm
wait    5

shot    tgatoppm
cap     Reads a Targa (.tga) image -- the Truevision workstation format --
cap     back into a colour image.  ppmtotga writes the colour pattern out as
cap     a Targa, tgatoppm reads it, pnmfile confirms the PPM.
try     tgatoppm tmp/NPIB/t.tga > tmp/NPIB/back.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmpat -gingham3 48 24 > /dd/tmp/NPIB/c.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     ppmtotga tmp/NPIB/c.ppm > tmp/NPIB/t.tga
wait    5
run     tgatoppm tmp/NPIB/t.tga > tmp/NPIB/back.ppm
wait    5
run     pnmfile tmp/NPIB/back.ppm
wait    5

shot    xbmtopbm
cap     Reads an X11 bitmap -- the C source X uses for cursors and icons --
cap     back into a bitmap.  pbmtoxbm writes the test bitmap out as an X
cap     bitmap, xbmtopbm reads it, pnmfile confirms the PBM.
try     xbmtopbm tmp/NPIB/t.xbm > tmp/NPIB/back.pbm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     pbmmake -g 48 24 > /dd/tmp/NPIB/b.pbm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     pbmtoxbm tmp/NPIB/b.pbm > tmp/NPIB/t.xbm
wait    5
run     xbmtopbm tmp/NPIB/t.xbm > tmp/NPIB/back.pbm
wait    5
run     pnmfile tmp/NPIB/back.pbm
wait    5

shot    yuvsplittoppm
cap     Reads Abekas YUV video split across three files -- <name>.Y luma and
cap     <name>.U/.V chroma -- back into a colour image, given its width and
cap     height.  ppmtoyuvsplit writes the three, yuvsplittoppm reassembles.
try     yuvsplittoppm tmp/NPIB/y 48 24 > tmp/NPIB/back.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmpat -gingham3 48 24 > /dd/tmp/NPIB/c.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     ppmtoyuvsplit tmp/NPIB/y tmp/NPIB/c.ppm
wait    5
run     yuvsplittoppm tmp/NPIB/y 48 24 > tmp/NPIB/back.ppm
wait    5
run     pnmfile tmp/NPIB/back.ppm
wait    5

# ---- no writer for the format ships, so the reader is shown rejecting a
#      file it is not meant to read; no sample in that format is on the disk

shot    bioradtopgm
cap     Reads a Bio-Rad confocal microscope image into a greyscale picture.
cap     No file in that format ships here; handed a colour picture it says
cap     so rather than guessing.
try     bioradtopgm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     bioradtopgm tmp/NPIB/nr.ppm
wait    5

shot    brushtopbm
cap     Reads a Xerox doodle brush file into a bitmap.  No file in that
cap     format ships here; handed a colour picture it reports the bad magic
cap     number rather than guessing.
try     brushtopbm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     brushtopbm tmp/NPIB/nr.ppm
wait    5

shot    gouldtoppm
cap     Reads a Gould scanner image into a colour picture.  No file in that
cap     format ships here; handed a colour picture it says the Gould header
cap     will not read rather than guessing.
try     gouldtoppm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     gouldtoppm tmp/NPIB/nr.ppm
wait    5

shot    hipstopgm
cap     Reads a HIPS image -- the format of a human-vision research
cap     library -- into a greyscale picture.  Its header is nine lines of
cap     text (where it came from, its name, how many frames, the date,
cap     rows, columns, bits a pixel, packing, pixel format) and then
cap     history lines up to a line holding one dot; after that it is one
cap     byte a pixel.  So printf writes one, and sixteen characters of
cap     text make a strip eight pixels by two.
try     hipstopgm x.hips > out.pgm
run     rm -rf /dd/tmp/HIPB > /nil 2>/nil; mkdir -p /dd/tmp/HIPB
wait    3
run     builtin cd /dd/tmp/HIPB
wait    1
run     printf "osk\rstrip\r1\rtoday\r2\r8\r8\r0\r0\r.\r" > x.hips; printf "0123456789abcdef" >> x.hips
wait    3
run     clear
wait    1
run     hipstopgm x.hips > out.pgm
wait    5
run     pnmfile out.pgm
wait    3
run     pnmnoraw out.pgm
wait    4

shot    hpcdtoppm
cap     Reads a Kodak Photo CD image into a colour picture.  No Photo CD
cap     file ships here; handed a colour picture it reports the read error
cap     rather than guessing.
try     hpcdtoppm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     hpcdtoppm tmp/NPIB/nr.ppm
wait    5

shot    imgtoppm
cap     Reads an Img Software Set (AT&T Image-8) image into a colour
cap     picture -- not GEM IMG, which gemtopbm reads.  No file in that format
cap     ships here; handed a name that is not there it says it cannot open it.
try     imgtoppm tmp/NPIB/none.img
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     builtin cd /dd
wait    1
run     clear
run     imgtoppm tmp/NPIB/none.img
wait    5

shot    mtvtoppm
cap     Reads the output of the MTV ray tracer into a colour picture.  An
cap     MTV image is one line of width and height and then three raw bytes
cap     a pixel, so one can be written with printf: twenty-four characters
cap     of text make a picture four pixels by two, and their codes are the
cap     colours that come out.
try     mtvtoppm x.mtv > out.ppm
run     rm -rf /dd/tmp/MTVB > /nil 2>/nil; mkdir -p /dd/tmp/MTVB
wait    3
run     builtin cd /dd/tmp/MTVB
wait    1
run     printf "4 2\r" > x.mtv; printf "0123456789abcdefghijklmn" >> x.mtv
wait    3
run     clear
wait    1
run     mtvtoppm x.mtv > out.ppm
wait    5
run     pnmfile out.ppm
wait    3
run     pnmnoraw out.ppm
wait    4

shot    spctoppm
cap     Reads an Atari ST Spectrum 512 picture into a colour image.  No
cap     Spectrum file ships here; handed a colour picture it says it is not a
cap     Spectrum picture rather than guessing.
try     spctoppm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     spctoppm tmp/NPIB/nr.ppm
wait    5

shot    spottopgm
cap     Reads a spot-scanner image into a greyscale picture, optionally
cap     cropped to a rectangle.  No spot file ships here; run with no
cap     arguments it prints what it expects.
try     spottopgm
run     clear
run     spottopgm
wait    5

shot    ximtoppm
cap     Reads an X image (.xim) into a colour picture.  No xim file ships
cap     here; handed a colour picture it says it cannot read the xim header
cap     rather than guessing.
try     ximtoppm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     ximtoppm tmp/NPIB/nr.ppm
wait    5

shot    xvminitoppm
cap     Reads an XV thumbnail -- the small preview the XV image viewer
cap     saves -- into a colour picture.  A thumbnail is `P7 332', a
cap     comment line, the size, and then one byte a pixel indexing a fixed
cap     palette of three bits of red, three of green and two of blue, so
cap     one can be written with printf.  Sixteen characters of text make a
cap     strip eight pixels by two.
try     xvminitoppm x.xv > out.ppm
run     rm -rf /dd/tmp/XVB > /nil 2>/nil; mkdir -p /dd/tmp/XVB
wait    3
run     builtin cd /dd/tmp/XVB
wait    1
run     printf "P7 332\r#END_OF_COMMENTS\r8 2 255\r" > x.xv; printf "0123456789abcdef" >> x.xv
wait    3
run     clear
wait    1
run     xvminitoppm x.xv > out.ppm
wait    5
run     pnmfile out.ppm
wait    3
run     pnmnoraw out.ppm
wait    4

shot    zeisstopnm
cap     Reads a Zeiss confocal microscope image into a PNM.  No Zeiss file
cap     ships here; handed a small colour picture it says the input is not in
cap     Zeiss format rather than guessing.
try     zeisstopnm tmp/NPIB/nr.ppm
run     mkdir -p /dd/tmp/NPIB > /nil 2>/nil
run     ppmmake red 16 16 > /dd/tmp/NPIB/nr.ppm
wait    5
run     builtin cd /dd
wait    1
run     clear
run     zeisstopnm tmp/NPIB/nr.ppm
wait    5
