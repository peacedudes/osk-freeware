# Printing: PostScript, printer control codes, and two print spoolers,
# one stanza per program.

shot    gs403
size    30 100
cap     Ghostscript 4.03 rendering a line of PostScript.  The page is
cap     rasterised to a bitmap at 48 dots per inch, and pbmtoascii shows
cap     that bitmap as text.  GS_LIB names its fonts and initialisation
cap     files, in LIB/gs403.
try     cat DOC/samples/hello.ps; gs403 -q -dNOPAUSE -sDEVICE=pbm -r48 -g200x60 -sOutputFile=tmp/PRT/hello.pbm DOC/samples/hello.ps -c quit; pbmtoascii tmp/PRT/hello.pbm
run     mkdir -p /dd/tmp/PRT > /nil 2>/nil; export GS_LIB=/dd/LIB/gs403
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat DOC/samples/hello.ps
wait    2
run     gs403 -q -dNOPAUSE -sDEVICE=pbm -r48 -g200x60 -sOutputFile=tmp/PRT/hello.pbm DOC/samples/hello.ps -c quit
wait    60
run     pbmtoascii tmp/PRT/hello.pbm
wait    10

shot    gs33
cap     Ghostscript 3.33, the earlier build on this disk -- gs403 is the
cap     complete one.  Its devices are printer codes, not a plain bitmap,
cap     so here it turns a line of PostScript into what an Epson-compatible
cap     printer would receive, shown as a dump.  `xmode: not found' is a
cap     helper it looks for and does without.
try     gs33 -q -dNOPAUSE -sDEVICE=epson -r48 -g200x60 -sOutputFile=tmp/PRT/old.out tmp/PRT/old.ps -c quit; dump tmp/PRT/old.out | head -n 8
os9     gs33 -q -dNOPAUSE -sDEVICE=epson -r48 -g200x60 -sOutputFile=tmp/PRT/old.out tmp/PRT/old.ps -c quit ! dump tmp/PRT/old.out ! head -n 8
run     mkdir -p /dd/tmp/PRT > /nil 2>/nil; printf "/Helvetica-Bold findfont 40 scalefont setfont\r8 14 moveto (OS-9/68000) show\rshowpage\r" > /dd/tmp/PRT/old.ps
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gs33 -q -dNOPAUSE -sDEVICE=epson -r48 -g200x60 -sOutputFile=tmp/PRT/old.out tmp/PRT/old.ps -c quit
wait    45
run     dump tmp/PRT/old.out | head -n 8
wait    5

shot    lwf
cap     Plain text to PostScript, the way enscript does it: the head of
cap     the page it sets, with its prologue from USR/LIB.
try     lwf tmp/PRT/j.txt | head -n 14
os9     lwf tmp/PRT/j.txt ! head -n 14
run     mkdir -p /dd/tmp/PRT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/PRT/j.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     lwf tmp/PRT/j.txt | head -n 14
wait    8

shot    alps
cap     Writes the control sequence that switches an ALPS ASP-1000
cap     printer to letter quality (-lq) or back (-norm): three bytes,
cap     meant to be sent to the printer device.  Shown here as a dump.
try     alps -lq > tmp/PRT/alps.out; dump tmp/PRT/alps.out
os9     alps -lq >-tmp/PRT/alps.out; dump tmp/PRT/alps.out
run     mkdir -p /dd/tmp/PRT > /nil 2>/nil; alps -lq > /dd/tmp/PRT/alps.out
wait    3
run     builtin cd /dd
wait    1
run     clear
run     dump tmp/PRT/alps.out
wait    5

shot    epson
cap     Sets condensed printing, an international character set, and a
cap     form feed -- three commands an Epson-compatible printer would
cap     receive.  It writes them to its own standard output, so
cap     redirecting that to a file shows them here in place of a printer.
try     epson -c17 -g -p > tmp/PRT/epson.out; dump tmp/PRT/epson.out
os9     epson -c17 -g -p >-tmp/PRT/epson.out; dump tmp/PRT/epson.out
run     mkdir -p /dd/tmp/PRT > /nil 2>/nil
wait    1
run     builtin cd /dd
wait    1
run     clear
wait    1
run     epson -c17 -g -p > tmp/PRT/epson.out
wait    3
run     dump tmp/PRT/epson.out
wait    4

shot    lmargin
size    30 80
cap     lmargin indents.  It reads standard input and writes it out again
cap     with a left margin of the width you ask for, so it takes a file by
cap     redirect or a program's output by pipe.  Nothing of it reaches a
cap     printer: the name `epson' in its usage line came with it from a
cap     sibling program, and the margin it sets is spaces in the text.
try     lmargin -l4 <DOC/globe.doc
run     clear
wait    1
run     lmargin -l4 <DOC/globe.doc
wait    6

shot    lp
cap     Submits a file to the print spooler, and answers that the spooler
cap     is not installed.  That is its answer whether or not one is
cap     running: `lpsched' starts here and makes the `spoolqueue' event
cap     and data module its own card shows, and lp, lpq and lpshut all
cap     three still report none.  Start it on your own printer and see.
try     lp tmp/PRT/letter.txt
run     mkdir -p /dd/tmp/PRT > /nil 2>/nil; printf "Dear reader,\rThe collection speaks for itself.\r" > /dd/tmp/PRT/letter.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     lp tmp/PRT/letter.txt
wait    5

shot    lpq
cap     Shows the spooler's queue, and reports no spooler installed --
cap     which it does even with `lpsched' running and its queue event
cap     in the event directory.  See the lp card.
try     lpq -?; lpq
run     lpq -?
wait    4
run     lpq
wait    4

shot    lprm
cap     Removes a job from the spooler's queue by its id: its options.
cap     With no spooler managing a queue there is nothing to link to,
cap     and it says exactly that instead of trying to remove anything.
try     lprm -?; lprm 1
run     lprm -?
wait    4
run     lprm 1
wait    4

shot    lpshut
cap     Stops the spooler, and reports none active -- which is its answer
cap     even when `lpsched' is running and holding the queue.  See the
cap     lp card.
try     lpshut -?; lpshut
os9     lpshut
run     lpshut -?
wait    4
run     lpshut
wait    4

shot    prjob
cap     Prints a queued job.  With no spooler installed it says so --
cap     even its own option list gives the same answer.
try     prjob -?; prjob
os9     prjob
run     prjob -?
wait    4
run     prjob
wait    4

shot    lpsched
size    24 80
fresh
cap     lpsched starts the print spooler on the devices you name.  It
cap     forks the printer job, creates the `spoolqueue' event that the
cap     rest of the set waits on, and stays resident -- which `edir -e'
cap     shows.  Name your own printer where this names the bit bucket;
cap     the spooler wants a SPOOL directory at the root, and it is there.
try     lpsched /nil & edir -e
run     clear
wait    1
run     lpsched /nil & edir -e
wait    8

shot    splman
cap     The manager of the disk's other print spooler: it
cap     opens a printer on a serial device before it does anything else.
cap     With none here it waits for one rather than returning; this
cap     shows it starting and going no further.
try     splman
run     splman
wait    6

shot    splprt
cap     The printer process of the disk's other spooler, one per printer.
cap     With no printer device it prints nothing and returns.
try     splprt; echo "status $?"
os9     splprt
run     splprt; echo "status $?"
wait    5

shot    splstat
cap     The queue status of the disk's other spooler.  Asking for its
cap     options answers instead that its device number is out of range
cap     -- as close as it comes to a queue with none running.  lpq, the
cap     other spooler's, says so in plainer words.
try     splstat -?; lpq
run     splstat -?
wait    4
run     lpq
wait    4

shot    perr
cap     Prints the text of an OS-9 error number.  These are the ones met
cap     most often: file not accessible, path name not found, path name
cap     already exists, module not found, and out of memory.
try     perr 214 216 218 221 237
run     perr 214 216 218 221 237
wait    5
