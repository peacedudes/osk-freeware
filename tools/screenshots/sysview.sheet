# The machine looking at itself -- and this collection looking at itself.
shot    about
cap     The collection's own guide: `about hack' answers what a program is,
cap     where it came from, what it opens and whether its source survived.
run     /dd/CMDS/about hack
wait    4

shot    modinfo
cap     An OS-9 module header read back: name, type, size, edition and CRC.
cap     Every program on this disk is a module like this one.
run     /dd/CMDS/modinfo /dd/CMDS/today
wait    3

shot    dam
cap     The disk allocation map -- one character per cluster across the
cap     whole 253 MB volume.
run     /dd/CMDS/dam /dd
wait    5
kill

shot    map
cap     The memory map: what OS-9 has handed out and what is left.
run     /dd/CMDS/map
wait    4

shot    aprocs
cap     A process monitor.  os9exec is the kernel here, so these are real
cap     OS-9 processes with real process IDs.
run     /dd/CMDS/aprocs
wait    5
kill

shot    oskversion
cap     What the system says it is: version, identification and the system
cap     globals OS-9 keeps about the machine.
run     /dd/CMDS/oskversion
wait    2
run     /dd/CMDS/sysid
wait    2
run     /dd/CMDS/getsys
wait    4

shot    cpu
cap     A CPU speed test, run against the emulator.
run     /dd/CMDS/cpu
wait    8

shot    ssl
cap     ssl shows a file's segment list -- the sectors RBF gave it, in
cap     order.  This is the disk's own allocation, not a summary.
run     /dd/CMDS/ssl /dd/DOC/INDEX
wait    4

shot    dinfo
cap     Device information for the volume this collection is mounted as.
run     /dd/CMDS/dinfo /dd
wait    3
run     /dd/CMDS/shdev
wait    3

shot    suse
cap     suse prints just the usage line out of a program, without running
cap     it -- it reads the module.
run     /dd/CMDS/suse /dd/CMDS/tar
wait    3
