# Games that draw a board and wait -- photographed mid-play.
shot    tttt
cap     Tic-tac-toe.  The board is numbered; you answer with a square.
run     /dd/CMDS/tttt
wait    4
send    5\r
wait    2
send    1\r
wait    3

shot    hotel
cap     hotel, a two-player board game played by coordinates.
run     /dd/CMDS/GAMES/hotel
wait    5

shot    poker
cap     Cold-hand poker, one of four SNOBOL4 games here -- the interpreter
cap     was compiled to C and the games came with it.
run     /dd/CMDS/GAMES/poker
wait    6

shot    stone
cap     The stones game: take stones from a pile, do not take the last one.
run     /dd/CMDS/GAMES/stone
wait    6

shot    blackjak
cap     Las Vegas blackjack, also SNOBOL4.
run     /dd/CMDS/GAMES/blackjak
wait    6

shot    nchess
cap     GNU Chess 4.0 with its plain display -- the board as characters,
cap     which is how it was played over a serial line.
run     /dd/CMDS/GAMES/nchess
wait    6
send    e2e4\r
wait    8

shot    backgammon
cap     Backgammon against the computer, with the board drawn in
cap     characters and the dice rolled for you.
run     /dd/CMDS/GAMES/backgammon
wait    5
send    n\r
wait    5

shot    pacman
cap     Pac-Man.
run     /dd/CMDS/GAMES/pacman
wait    6
