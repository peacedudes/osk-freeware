# Calendars and clocks.
shot    calen
cap     calen prints a run of months from one starting point -- here six
cap     months from January 2026.
run     /dd/CMDS/calen
wait    2
send    1 2026 6\r
wait    4

shot    calender
cap     A whole year on one screen, in German: `Fuer welches Jahr?'
run     /dd/CMDS/calender
wait    2
send    2026\r
wait    5

shot    easter
cap     easter computes the date of Easter for a run of years -- the
cap     computus, in one small program.
run     /dd/CMDS/easter
wait    3

shot    digclk
cap     A digital clock drawn in block characters, with the hostname under
cap     it.  It redraws until you stop it.
run     /dd/CMDS/digclk
wait    6

shot    cal-holidays
cap     cal with -h: the holidays in SYS/holidays are marked on the month.
run     /dd/CMDS/cal -m=12 -y=2026 -h
wait    4
