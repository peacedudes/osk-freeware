# There is no modem here and no site to call, so what these show
# is their own face: the prompt, the settings, the log.

shot    aterm
cap     ATerm 2.6, the terminal emulator.  Its own Example line says
cap     `ATerm /t1', so that is what is typed here -- and the answer is the
cap     useful part: it wants an SCF device driven by the same driver as the
cap     one in its control file, and os9exec's /t1 is not that.  A card that
cap     shows only the syntax block says nothing the INDEX line does not.
run     aterm
wait    6
run     aterm /t1
wait    10

shot    elm
cap     The full-screen mail reader, opening on the folder that ships for
cap     this account: one message.  `d' deletes, `r' replies, `q' quits.
run     elm
wait    10
quit    q\r

shot    answer
cap     Replies to messages in a folder one at a time, prompting `Message
cap     to:' for a recipient it checks against the alias table.  Anything
cap     else gets `Sorry, could not find ... in list!' and it asks again.
run     newalias
wait    8
run     clear
wait    1
run     answer
wait    6
send    tester\r
wait    5

shot    arepdaemon
cap     The daemon autoreply relies on.  Wants
cap     /dd/USR/LIB/ELM/autoreply.data, which is not here, and says so:
cap     `Error 216 attempting fstat' -- though it still touches
cap     autoreply.log on its way there.
run     rm -f /dd/USR/LIB/ELM/autoreply.data /dd/USR/LIB/ELM/autoreply.log
wait    3
run     clear
wait    1
run     ls -l /dd/USR/LIB/ELM
wait    4
run     arepdaemon
wait    5
run     ls -l /dd/USR/LIB/ELM
wait    5

shot    autoreply
cap     Sends an automatic reply while you are away.  It resolves your
cap     mailbox by the session's numeric owner rather than $USER, so
cap     under this identity it reaches for a mailbox named `su' and
cap     stops there; turning autoreplying off does not need the mailbox
cap     and answers for real.
run     autoreply -?
wait    6
run     clear
wait    1
run     autoreply off
wait    6

shot    checkalias
cap     Checks that an alias resolves, after `newalias' compiles the
cap     table.  It prints nothing either way and returns the same status
cap     for an alias that exists and one that does not -- `listalias' is
cap     what actually answers the question.
run     newalias
wait    8
run     clear
wait    1
run     checkalias os9; echo "exit: $?"
wait    5
run     checkalias nosuchalias; echo "exit: $?"
wait    5

shot    disable
cap     Turns MTSMon off on a serial port.  It wants the port's device
cap     driver module resident in memory to find it by name; none is
cap     loaded here, so it gets no further than looking.
run     disable -?
wait    5
run     clear
wait    1
run     disable /t1
wait    5

shot    enable
cap     The other half of `disable', with an extra option to hold its
cap     prompt until a signal comes in.  Asked for by full path -- bash
cap     has its own builtin of the same name, which answers first.  Same
cap     story as disable: it wants the /t1 module resident and none is.
run     /dd/CMDS/UUCP/enable -?
wait    5
run     clear
wait    1
run     /dd/CMDS/UUCP/enable /t1
wait    5

shot    dotilde
cap     The mailer's tilde-escape handler: it reads a message from
cap     standard input and acts on the `~' commands inside it.  An
cap     unrecognized one gets `Unrecognized tilde command' and it keeps
cap     reading.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "hello\r~x\rmore text\r" > /dd/tmp/MAILA/dt.txt
wait    3
run     clear
wait    1
run     dotilde < /dd/tmp/MAILA/dt.txt
wait    6

shot    fastmail
cap     Sends a file as mail without opening the reader.  It needs a
cap     delivery agent to actually hand the message off; there is none
cap     here, so the folder is unchanged and it returns in silence.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "hello from fastmail\r" > /dd/tmp/MAILA/fm.txt
wait    3
run     clear
wait    1
run     messages
wait    4
run     fastmail /dd/tmp/MAILA/fm.txt tester
wait    6
run     messages
wait    5

shot    filter
cap     A pipe stage that sorts incoming mail into folders by rule -- its
cap     own usage line begins with the pipe.  Piping it a message here
cap     reaches for a scratch file at /r0, the RAM disk this disk has no
cap     device for.
run     filter -?
wait    5
run     clear
wait    1
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "From tester\rSubject: test\r\rbody\r" > /dd/tmp/MAILA/msg.txt
wait    3
run     filter -v < /dd/tmp/MAILA/msg.txt
wait    6

shot    frm
cap     Lists who your mail is from, one line each.  On this disk it
cap     opens the folder, names you, and answers that there is no mail --
cap     even though `messages' and `readmsg' both find the one message
cap     that is there.
run     frm
wait    6

shot    lcasep
cap     Lower-cases a name for the mailer, reading it from standard
cap     input.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "Robert Smith\r" > /dd/tmp/MAILA/lc.txt
wait    3
run     clear
wait    1
run     lcasep < /dd/tmp/MAILA/lc.txt
wait    5

shot    listalias
cap     Lists the aliases you have, once `newalias' has compiled them:
cap     your own file first, then the system one.  Its -s and -u forms
cap     try to pipe through `egrep', which is not on this disk, and say
cap     so -- but list the aliases anyway.
run     newalias
wait    8
run     newalias -g
wait    8
run     clear
wait    1
run     listalias
wait    6
run     listalias -s
wait    6

shot    lmail
cap     Local mail delivery.  Its usage line is safe to ask for; giving
cap     it a real recipient does not return here -- it hangs and has to
cap     be broken out of.
run     lmail -?
wait    6

shot    mail
cap     A simple mail sender.  It reaches for a scratch file at /r0, the
cap     RAM disk this disk has no device for, and stops there.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil
wait    2
run     clear
wait    1
run     printf "hi\r.\r" | mail tester
wait    6

shot    mailx
cap     The mail reader and sender.  It looks your mailbox up by USER
cap     NUMBER, not by $USER -- logged in as the super user, which has no
cap     mailbox of its own, so it says it cannot change to it.
run     mailx
wait    8

shot    makedb
cap     Builds smail's path-alias database from a text source, two files
cap     beside it: a .dir and a .pag.
run     makedb -?
wait    5
run     clear
wait    1
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil
wait    2
run     makedb -o /dd/tmp/MAILA/palias /dd/USR/LIB/SMAIL/palias
wait    6
run     ls -l /dd/tmp/MAILA/palias.dir /dd/tmp/MAILA/palias.pag
wait    5

shot    messages
cap     Counts and lists what is in a folder.
run     messages
wait    5
run     messages -f /dd/SPOOL/MAIL/tester
wait    5

shot    newalias
cap     Rebuilds the alias database after you edit the alias files: your
cap     own first, then the system one with -g.
run     newalias
wait    8
run     newalias -g
wait    8
run     newalias -g
wait    8

shot    newmail
cap     Watches for mail arriving and says so; -d also reports the
cap     folder it is watching and its size.
run     newmail -?
wait    6
run     clear
wait    1
run     newmail -d tester
wait    8

shot    nptx
cap     smail's full-name permuter: give it a line of `<full name>' TAB
cap     `<login>' and it answers with the pair reversed.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "John Q Public\tjqpublic\r" > /dd/tmp/MAILA/np.txt
wait    3
run     clear
wait    1
run     nptx < /dd/tmp/MAILA/np.txt
wait    6

shot    pathalias
cap     Computes mail routes from a map of who calls whom -- its options,
cap     since no map ships here.
run     pathalias -?
wait    6

shot    philmail
cap     An off-line mail reader: it opens $MAIL, confirms the file is
cap     well formed, and lets you step through messages with return;
cap     `q' quits.
run     philmail
wait    6
send    \r
wait    5
send    q\r
wait    5

shot    printmail
cap     Formats a message for a printer.  It forks `readmsg' by bare
cap     name, so load it first; then printmail prints the message the
cap     same way `readmsg' would.
run     load /dd/CMDS/ELM/readmsg
wait    3
run     clear
wait    1
run     printmail 1
wait    6

shot    pwparse
cap     Parses a password file into the login names the mailer wants,
cap     one per line.
run     pwparse < /dd/SYS/password
wait    6

shot    read_mail
cap     vi/elvis's own mail-reading helper, not part of Elm: it opens
cap     /dd/MAIL/mail_<user> and quotes what it finds.  The file that
cap     ships is empty, so it reads to end and has nothing to quote.
run     ls -l /dd/MAIL
wait    4
run     clear
wait    1
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; echo N > /dd/tmp/MAILA/ans
wait    3
run     read_mail < /dd/tmp/MAILA/ans; echo "exit: $?"
wait    6

shot    readmsg
cap     Prints a message from a folder by number.
run     readmsg 1
wait    6

shot    rmail
cap     Delivers incoming mail -- invoked by uuxqt, not typed by hand.
cap     Local delivery expects a mailbox directory; the one that ships
cap     is a plain file, so it stops there.
run     rmail tester
wait    6

shot    smail
cap     The smart mail router: its options.
run     smail -?
wait    8

shot    uupoll
cap     Polls a UUCP site for waiting work.  It works in silence -- the
cap     only sign is the poll file it leaves in the site's spool
cap     directory.
run     ls -l /dd/SPOOL/uucp/seabass
wait    4
run     clear
wait    1
run     uupoll seabass
wait    6
run     ls -l /dd/SPOOL/uucp/seabass
wait    5

shot    uux
cap     Runs a command on another UUCP site: its options.  This is a
cap     different UUCP package from the one whose Systems file names
cap     `seabass', so asking for it that way answers `Unknown Host'.
run     uux -?
wait    6
run     clear
wait    1
run     uux seabass\!rnews
wait    6

shot    bdecode
cap     Decodes a batched news article.  Handed a file with no batch
cap     header, it says so plainly.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "not a batch\r" > /dd/tmp/MAILA/bd.txt
wait    3
run     clear
wait    1
run     bdecode /dd/tmp/MAILA/bd.txt
wait    6

shot    byteflip
cap     Byte-swaps a dbz database between architectures.  Run with
cap     nothing to swap, it ends the shell outright rather than printing
cap     anything.
run     byteflip
wait    6

shot    c7decode
cap     Decodes 7-bit-safe encoded news.  Handed text that is not
cap     encoded that way, it says so.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "not encoded\r" > /dd/tmp/MAILA/c7.txt
wait    3
run     clear
wait    1
run     c7decode < /dd/tmp/MAILA/c7.txt
wait    6

shot    dbz
cap     The news history database from C News: builds a .dir/.pag pair
cap     from a text history file.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "<one@site.uucp> 999999999 1\r" > /dd/tmp/MAILA/history
wait    3
run     clear
wait    1
run     ksh -c "cd /dd/tmp/MAILA; dbz history"
wait    8
run     ls -l /dd/tmp/MAILA/history.dir /dd/tmp/MAILA/history.pag
wait    5

shot    expire
cap     Deletes news articles past their expiry date.  -t previews
cap     without deleting, walking every newsgroup in the active file.
run     expire -t
wait    8

shot    newshist
cap     Rebuilds the news history file.  dbz's own store on this disk
cap     fails on the entry it is given here -- see dbz -- so what
cap     newshist can say about an id that really is in the file is that
cap     it has no entry for it.
run     mkdir -p /dd/lib/news > /nil 2>/nil; printf "<one@site.uucp> 9999999999 1\r" > /dd/lib/news/history
wait    3
run     clear
wait    1
run     ksh -c "cd /dd/lib/news; dbz history"
wait    8
run     newshist "<one@site.uucp>"
wait    6

shot    newslock
cap     The news system's lock, given a temporary name and the real
cap     lock name.  It leaves no trace here -- no file at either name,
cap     nothing printed.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil
wait    2
run     clear
wait    1
run     newslock /dd/tmp/MAILA/tmplock /dd/tmp/MAILA/reallock
wait    6
run     ls /dd/tmp/MAILA/tmplock /dd/tmp/MAILA/reallock
wait    5

shot    postnews
size    30 80
cap     Composes a Usenet article, prompting for newsgroup, subject,
cap     keywords, distribution and summary, then reads the body until a
cap     line with just a dot.  It builds the whole header correctly and
cap     then tries to file the article by running `rnews' as a
cap     subprocess -- which it cannot start, so that is as far as it
cap     goes.
run     postnews
wait    6
send    comp.os.os9\r
wait    3
send    a test posting\r
wait    3
send    \r
wait    3
send    world\r
wait    3
send    testing postnews\r
wait    4
send    This is only a test.\r.\r
wait    6

shot    readnews
size    30 80
cap     Reads Usenet news articles.  With nothing in .newsrc matching
cap     most of the active groups, it asks about each one in turn before
cap     it would start showing articles.
run     readnews
wait    6
send    n\r
wait    3
send    n\r
wait    3
send    n\r
wait    4

shot    rnews
size    30 80
cap     Unpacks an incoming news batch.  Given one real article with a
cap     `Newsgroups:' header, it files it under the matching directory
cap     tree in the news spool.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; rm -rf /dd/SPOOL/news/COMP
wait    3
run     printf "Newsgroups: comp.os.os9\rSubject: test article\r\rhello there\r" > /dd/tmp/MAILA/art.txt
wait    3
run     LEN=$(cat /dd/tmp/MAILA/art.txt | wc -c)
wait    2
run     clear
wait    1
run     printf "#! rnews %s\r" $LEN > /dd/tmp/MAILA/batch.txt; cat /dd/tmp/MAILA/art.txt >> /dd/tmp/MAILA/batch.txt
wait    4
run     rnews /dd/tmp/MAILA/batch.txt
wait    6
run     ls -laR /dd/SPOOL/news/COMP
wait    6

shot    subscribe
cap     Adds a newsgroup to your subscription list -- if it is already
cap     listed in .newsrc but turned off, this turns it back on.  A
cap     group that is not in .newsrc at all is silently left alone.
run     unsubscribe news.announce.newusers
wait    5
run     clear
wait    1
run     cat /dd/.newsrc
wait    4
run     subscribe news.announce.newusers
wait    6
run     cat /dd/.newsrc
wait    5

shot    unsubscribe
cap     Drops a newsgroup from your subscription list.
run     subscribe comp.sys.m68k
wait    5
run     clear
wait    1
run     cat /dd/.newsrc
wait    4
run     unsubscribe comp.sys.m68k
wait    6
run     cat /dd/.newsrc
wait    5

shot    finger
size    36 80
for     finger net osknet
cap     Half the network set, each asked for itself.  There is no interface
cap     configured here, so what they show is what they would do if there
cap     were -- and all three want /dd/startup.net, which is a file you
cap     write for your own network and no collection can ship.  The other
cap     three are on the `network' card.  `osknet' is last: it takes the
cap     session down behind it, so anything asked for after it would capture
cap     nothing.
run     finger
wait    8
run     net
wait    8
run     osknet
wait    12
kill

shot    kermit
cap     Kermit, the file-transfer program.  With no serial line to talk to
cap     it says what it can do: connect, send, receive, or be the server.
run     kermit
wait    5

shot    kermit-family
for     kermit2 kermit3 xkermit ckermit
cap     Four more Kermits.  The collection keeps every build it found, and
cap     they do not all take the same command line -- which is the reason to
cap     keep them side by side.  All four are asked for
run     kermit2
wait    8
run     xkermit
wait    8
run     kermit3
wait    8
run     ckermit
wait    10

shot    network
size    36 80
for     msntp atp infoxpress
cap     The other three of the network set, each stopped by a different
cap     thing.  `atp' is the AX.25 transport from the KA9Q packet-radio
cap     package -- NOT AppleTalk, which this caption called it until
cap     2026-09-01 -- and it names the configuration file it wants.  `msntp'
cap     would set the clock from a time server and never reaches its own
cap     code: it was built against a later `csl' than the edition 16 this
cap     disk ships, so the runtime stops it first.  `infoxpress' opens a
cap     serial device and waits; it was filed as mute until 2026-08-29 and
cap     is not.
run     atp
wait    8
run     msntp
wait    8
run     infoxpress
wait    10

shot    screen
for     screen tsmon2 connect uwho wysetime
cap     `screen' is Russ Smith's `screens': a login greeting that picks a
cap     file at random from $HOME/.SCREENS and shows it -- on OS-9 it RUNS
cap     the file through system() rather than printing it.  There is no
cap     .SCREENS directory on this disk, so it says so.  It is not the
cap     terminal multiplexer of the same name.  Beside it, `tsmon2' watches
cap     a serial line for someone logging in, `connect' dials out, `uwho'
cap     lists who is logged in and `wysetime' sets a Wyse terminal's clock.
run     screen -v
wait    8
run     tsmon2 -?
wait    8
run     connect -?
wait    8
run     uwho
wait    8
run     wysetime
wait    8

shot    sterm
size    36 80
for     sterm tterm tsu
cap     The terminal programs: `sterm' and `tterm' open a serial line and
cap     give you the far end, `tsu' switches user on one.  With no line
cap     configured they say so.  Six more used to be credited here and
cap     never typed; they are on the card below.
run     sterm
wait    8
run     tterm
wait    8
run     tsu
wait    8

shot    sterm-tools
size    36 80
for     k z blastem dld uld vmod_trap
cap     The six that travelled with sterm on its card without ever being run
cap     there.  `k' and `z' are kermit and zmodem shorthands, `dld' and
cap     `uld' download and upload, `blastem' drives a Blast link, and
cap     `vmod_trap' is the modem trap handler the rest of them call.
run     k -?
wait    6
run     z -?
wait    6
run     dld -?
wait    6
run     uld -?
wait    6
run     blastem -?
wait    6
run     vmod_trap
wait    6

shot    uuclean
cap     Removes stale jobs from the spool.
run     uuclean -?
wait    8

shot    uucp-helpers
size    36 80
for     fileserv fixtext
cap     Two UUCP helpers that print nothing here: `fileserv' answers file
cap     requests and `fixtext' repairs a mangled text transfer.  Both are
cap     real modules that exit cleanly -- they simply have no UUCP spool
cap     traffic to act on and do not say so.
run     ls -l /dd/CMDS/UUCP/fileserv /dd/CMDS/UUCP/fixtext
wait    10
run     fileserv
wait    6
run     fixtext
wait    6

shot    uucp
for     uucp uuxqt uucico
cap     The transfer set: uucp queues a copy, uuxqt runs what a remote
cap     site queued here, uucico does the talking.  `uuxqt' cannot start
cap     -- it looks for a module called `procs' to see whether it is
cap     already running, and this disk has none.
run     uucp -?
wait    6
run     uucico -?
wait    6
run     uuxqt
wait    8

shot    uuname
cap     uuname lists the UUCP sites this system could reach, out of the
cap     configuration in SYS.
run     uuname
wait    4
run     uulog
wait    4

shot    uwho
for     uwho udate input
cap     What is left of the UNAXCESS bulletin board: uwho wants /etc/utmp,
cap     which OS-9 has no equivalent of.
run     uwho
wait    6
run     udate
wait    6
run     input < /nil
wait    8

shot    wn
size    40 80
for     wn wndex authwn inetd inetdc
cap     WN SERVING A PAGE, on a 68000 OS-9 disk.  It is an inetd-style
cap     server: one HTTP request on standard input, one response on standard
cap     output -- so the request is built with `echo' and passed through
cap     `autolf', because HTTP wants CRLF and this disk's echo writes CR
cap     alone.  What comes back is a complete HTTP/1.0 200 with
cap     Last-modified, Content-length and the page itself.  The site is
cap     /h0/c/unid/wn_1.14.3/osk, a path compiled into the binary by whoever
cap     ported it, and it is on this disk -- so mount the collection as /h0
cap     as well as /dd.  `wndex' builds the index.cache that WN will not
cap     serve without; it works on the CURRENT directory and ignores a
cap     directory argument, which is why it is run through ksh, whose `cd'
cap     moves the OS-9 data directory.  The response is cut at eighteen
cap     lines so the card ends cleanly; `Content-length: 838' is the whole
cap     page, and the head of the HTML under it is the page itself arriving.
cap     `-V' takes a virtual-host file -- and the four programs asked for
cap     after it never ran at all.
run     ksh -c "cd /h0/c/unid/wn_1.14.3/osk; wndex" 2>/nil
wait    8
run     echo "GET /index.html HTTP/1.0" > /dd/tmp/rq
wait    4
run     echo "" >> /dd/tmp/rq
wait    4
run     autolf -c -C -L < /dd/tmp/rq > /dd/tmp/rq.crlf
wait    5
run     wn -L /nil -l /nil < /dd/tmp/rq.crlf | head -n 18
wait    10

shot    wn-helpers
for     authwn inetd inetdc
cap     The three programs that stand around WN.  `inetd' is the superserver
cap     that would listen on a port and hand the connection to it -- it
cap     opens /socket, which os9exec does not present, so it gets as far as
cap     its own usage and no further.  `inetdc' is what inetd forks per
cap     connection and `authwn' the authenticator for a password-protected
cap     directory; neither has a word to say when nothing called it.  All
cap     three were credited on the WN card for months without ever being
cap     typed.
run     inetd
wait    8
run     inetdc < /nil
wait    6
run     authwn < /nil
wait    6

shot    xmodem
size    36 80
for     xy xydown xyt txmod rxmod
cap     The xmodem and ymodem set from CMDS/COMMS -- send, receive, and the
cap     terminal side of a file transfer over a serial line.  All five are
cap     asked for here.  `xy' is asked for LAST and with -?: bare, it starts
cap     receiving and waits for a sender that will never come, which takes
cap     the session down and leaves nothing to capture.
run     xydown
wait    8
run     xyt
wait    8
run     txmod
wait    8
run     rxmod
wait    8
run     xy -?
wait    8


shot    terminals
for     cls fkeys initvdu setterm wysecrack wysetime
cap     The small terminal utilities, asked what they take.  `fkeys' and
cap     `initvdu' print NOTHING at all -- no usage, no error -- which is
cap     what the two blank lines under their names are.  The Wyse pair want
cap     real Wyse hardware.
run     setterm -?
wait    8
run     fkeys -?
wait    8
run     wysecrack
wait    8
run     wysetime -?
wait    8
run     cls
wait    6
run     initvdu -?
wait    8
