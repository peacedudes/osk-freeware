# There is no modem here and no site to call, so what these show
# is their own face: the prompt, the settings, the log.

shot    aterm
cap     ATerm 2.6, a terminal emulator.  Its own Example line is `ATerm
cap     /t1', naming a serial device driven the way its control file in
cap     SYS/ATERM expects.  Pointed at /t1 here it answers that the device
cap     is not a valid one, since no such serial line is configured.
run     aterm
wait    6
run     aterm /t1
wait    10

shot    elm
cap     The full-screen mail reader, opening on the folder that ships for
cap     this account: one message.  `d' deletes, `r' replies, `q' quits.
run     elm
wait    10
quit    q\r

shot    answer
cap     Replies to messages in a folder one at a time, prompting `Message
cap     to:' for a recipient it checks against the alias table.  Anything
cap     else gets `Sorry, could not find ... in list!' and it asks again.
run     newalias
wait    8
run     clear
wait    1
run     answer
wait    6
send    tester\r
wait    5

shot    arepdaemon
cap     The daemon autoreply relies on.  Wants
cap     /dd/USR/LIB/ELM/autoreply.data, which is not here, and says so:
cap     `Error 216 attempting fstat' -- though it still touches
cap     autoreply.log on its way there.
run     rm -f /dd/USR/LIB/ELM/autoreply.data /dd/USR/LIB/ELM/autoreply.log
wait    3
run     clear
wait    1
run     ls -l /dd/USR/LIB/ELM
wait    4
run     arepdaemon
wait    5
run     ls -l /dd/USR/LIB/ELM
wait    5

shot    autoreply
cap     Sends an automatic reply while you are away.  It resolves your
cap     mailbox by the session's numeric owner rather than $USER, so
cap     under this identity it reaches for a mailbox named `su' and
cap     stops there; turning autoreplying off does not need the mailbox
cap     and answers for real.
run     autoreply -?
wait    6
run     clear
wait    1
run     autoreply off
wait    6

shot    checkalias
cap     Checks that an alias resolves, after `newalias' compiles the
cap     table.  It prints nothing either way and returns the same status
cap     for an alias that exists and one that does not -- `listalias' is
cap     what actually answers the question.
run     newalias
wait    8
run     clear
wait    1
run     checkalias os9; echo "exit: $?"
wait    5
run     checkalias nosuchalias; echo "exit: $?"
wait    5

shot    disable
cap     Turns MTSMon off on a serial port.  It wants the port's device
cap     driver module resident in memory to find it by name; none is
cap     loaded here, so it gets no further than looking.
run     disable -?
wait    5
run     clear
wait    1
run     disable /t1
wait    5

shot    enable
cap     The other half of `disable', with an extra option to hold its
cap     prompt until a signal comes in.  Asked for by full path -- bash
cap     has its own builtin of the same name, which answers first.  Same
cap     story as disable: it wants the /t1 module resident and none is.
run     /dd/CMDS/UUCP/enable -?
wait    5
run     clear
wait    1
run     /dd/CMDS/UUCP/enable /t1
wait    5

shot    dotilde
cap     The mailer's tilde-escape handler: it reads a message from
cap     standard input and acts on the `~' commands inside it.  An
cap     unrecognized one gets `Unrecognized tilde command' and it keeps
cap     reading.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "hello\r~x\rmore text\r" > /dd/tmp/MAILA/dt.txt
wait    3
run     clear
wait    1
run     dotilde < /dd/tmp/MAILA/dt.txt
wait    6

shot    fastmail
cap     Sends a file as mail without opening the reader.  It needs a
cap     delivery agent to actually hand the message off; there is none
cap     here, so the folder is unchanged and it returns in silence.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "hello from fastmail\r" > /dd/tmp/MAILA/fm.txt
wait    3
run     clear
wait    1
run     messages
wait    4
run     fastmail /dd/tmp/MAILA/fm.txt tester
wait    6
run     messages
wait    5

shot    filter
cap     A pipe stage that sorts incoming mail into folders by rule -- its
cap     own usage line begins with the pipe.  Piping it a message here
cap     reaches for a scratch file at /r0, the RAM disk this disk has no
cap     device for.
run     filter -?
wait    5
run     clear
wait    1
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "From tester\rSubject: test\r\rbody\r" > /dd/tmp/MAILA/msg.txt
wait    3
run     filter -v < /dd/tmp/MAILA/msg.txt
wait    6

shot    frm
cap     Lists who your mail is from, one line each.  On this disk it
cap     opens the folder, names you, and answers that there is no mail --
cap     even though `messages' and `readmsg' both find the one message
cap     that is there.
run     frm
wait    6

shot    lcasep
cap     Lower-cases a name for the mailer, reading it from standard
cap     input.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "Robert Smith\r" > /dd/tmp/MAILA/lc.txt
wait    3
run     clear
wait    1
run     lcasep < /dd/tmp/MAILA/lc.txt
wait    5

shot    listalias
cap     Lists the aliases you have, once `newalias' has compiled them:
cap     your own file first, then the system one.  Its -s and -u forms
cap     try to pipe through `egrep', which is not on this disk, and say
cap     so -- but list the aliases anyway.
run     newalias
wait    8
run     newalias -g
wait    8
run     clear
wait    1
run     listalias
wait    6
run     listalias -s
wait    6

shot    lmail
cap     Local mail delivery.  Its usage line is safe to ask for; giving
cap     it a real recipient does not return here -- it hangs and has to
cap     be broken out of.
run     lmail -?
wait    6

shot    mail
cap     A simple mail sender.  It reaches for a scratch file at /r0, the
cap     RAM disk this disk has no device for, and stops there.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil
wait    2
run     clear
wait    1
run     printf "hi\r.\r" | mail tester
wait    6

shot    mailx
cap     The mail reader and sender.  It looks your mailbox up by USER
cap     NUMBER, not by $USER -- logged in as the super user, which has no
cap     mailbox of its own, so it says it cannot change to it.
run     mailx
wait    8

shot    makedb
cap     Builds smail's path-alias database from a text source, two files
cap     beside it: a .dir and a .pag.
run     makedb -?
wait    5
run     clear
wait    1
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil
wait    2
run     makedb -o /dd/tmp/MAILA/palias /dd/USR/LIB/SMAIL/palias
wait    6
run     ls -l /dd/tmp/MAILA/palias.dir /dd/tmp/MAILA/palias.pag
wait    5

shot    messages
cap     Counts and lists what is in a folder.
run     messages
wait    5
run     messages -f /dd/SPOOL/MAIL/tester
wait    5

shot    newalias
cap     Rebuilds the alias database after you edit the alias files: your
cap     own first, then the system one with -g.
run     newalias
wait    8
run     newalias -g
wait    8
run     newalias -g
wait    8

shot    newmail
cap     Watches for mail arriving and says so; -d also reports the
cap     folder it is watching and its size.
run     newmail -?
wait    6
run     clear
wait    1
run     newmail -d tester
wait    8

shot    nptx
cap     smail's full-name permuter: give it a line of `<full name>' TAB
cap     `<login>' and it answers with the pair reversed.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "John Q Public\tjqpublic\r" > /dd/tmp/MAILA/np.txt
wait    3
run     clear
wait    1
run     nptx < /dd/tmp/MAILA/np.txt
wait    6

shot    pathalias
cap     Computes mail routes from a map of who calls whom -- its options,
cap     since no map ships here.
run     pathalias -?
wait    6

shot    philmail
cap     An off-line mail reader: it opens $MAIL, confirms the file is
cap     well formed, and lets you step through messages with return;
cap     `q' quits.
run     philmail
wait    6
send    \r
wait    5
send    q\r
wait    5

shot    printmail
cap     Formats a message for a printer.  It forks `readmsg' by bare
cap     name, so load it first; then printmail prints the message the
cap     same way `readmsg' would.
run     load /dd/CMDS/ELM/readmsg
wait    3
run     clear
wait    1
run     printmail 1
wait    6

shot    pwparse
cap     Parses a password file into the login names the mailer wants,
cap     one per line.
run     pwparse < /dd/SYS/password
wait    6

shot    read_mail
cap     vi/elvis's own mail-reading helper, not part of Elm: it opens
cap     /dd/MAIL/mail_<user> and quotes what it finds.  The file that
cap     ships is empty, so it reads to end and has nothing to quote.
run     ls -l /dd/MAIL
wait    4
run     clear
wait    1
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; echo N > /dd/tmp/MAILA/ans
wait    3
run     read_mail < /dd/tmp/MAILA/ans; echo "exit: $?"
wait    6

shot    readmsg
cap     Prints a message from a folder by number.
run     readmsg 1
wait    6

shot    rmail
cap     Delivers incoming mail -- invoked by uuxqt, not typed by hand.
cap     Local delivery expects a mailbox directory; the one that ships
cap     is a plain file, so it stops there.
run     rmail tester
wait    6

shot    smail
cap     The smart mail router: its options.
run     smail -?
wait    8

shot    uupoll
cap     Polls a UUCP site for waiting work.  It works in silence -- the
cap     only sign is the poll file it leaves in the site's spool
cap     directory.
run     ls -l /dd/SPOOL/uucp/seabass
wait    4
run     clear
wait    1
run     uupoll seabass
wait    6
run     ls -l /dd/SPOOL/uucp/seabass
wait    5

shot    uux
cap     Runs a command on another UUCP site: its options.  This is a
cap     different UUCP package from the one whose Systems file names
cap     `seabass', so asking for it that way answers `Unknown Host'.
run     uux -?
wait    6
run     clear
wait    1
run     uux seabass\!rnews
wait    6

shot    bdecode
cap     Decodes a batched news article.  Handed a file with no batch
cap     header, it says so plainly.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "not a batch\r" > /dd/tmp/MAILA/bd.txt
wait    3
run     clear
wait    1
run     bdecode /dd/tmp/MAILA/bd.txt
wait    6

shot    byteflip
cap     Byte-swaps a dbz database between architectures.  Run with
cap     nothing to swap, it ends the shell outright rather than printing
cap     anything.
run     byteflip
wait    6

shot    c7decode
cap     Decodes 7-bit-safe encoded news.  Handed text that is not
cap     encoded that way, it says so.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "not encoded\r" > /dd/tmp/MAILA/c7.txt
wait    3
run     clear
wait    1
run     c7decode < /dd/tmp/MAILA/c7.txt
wait    6

shot    dbz
cap     The news history database from C News: builds a .dir/.pag pair
cap     from a text history file.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; printf "<one@site.uucp> 999999999 1\r" > /dd/tmp/MAILA/history
wait    3
run     clear
wait    1
run     ksh -c "cd /dd/tmp/MAILA; dbz history"
wait    8
run     ls -l /dd/tmp/MAILA/history.dir /dd/tmp/MAILA/history.pag
wait    5

shot    expire
cap     Deletes news articles past their expiry date.  -t previews
cap     without deleting, walking every newsgroup in the active file.
run     expire -t
wait    8

shot    newshist
cap     Rebuilds the news history file.  dbz's own store on this disk
cap     fails on the entry it is given here -- see dbz -- so what
cap     newshist can say about an id that really is in the file is that
cap     it has no entry for it.
run     mkdir -p /dd/lib/news > /nil 2>/nil; printf "<one@site.uucp> 9999999999 1\r" > /dd/lib/news/history
wait    3
run     clear
wait    1
run     ksh -c "cd /dd/lib/news; dbz history"
wait    8
run     newshist "<one@site.uucp>"
wait    6

shot    newslock
cap     The news system's lock, given a temporary name and the real
cap     lock name.  It leaves no trace here -- no file at either name,
cap     nothing printed.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil
wait    2
run     clear
wait    1
run     newslock /dd/tmp/MAILA/tmplock /dd/tmp/MAILA/reallock
wait    6
run     ls /dd/tmp/MAILA/tmplock /dd/tmp/MAILA/reallock
wait    5

shot    postnews
size    30 80
cap     Composes a Usenet article, prompting for newsgroup, subject,
cap     keywords, distribution and summary, then reads the body until a
cap     line with just a dot.  It builds the whole header correctly and
cap     then tries to file the article by running `rnews' as a
cap     subprocess -- which it cannot start, so that is as far as it
cap     goes.
run     postnews
wait    6
send    comp.os.os9\r
wait    3
send    a test posting\r
wait    3
send    \r
wait    3
send    world\r
wait    3
send    testing postnews\r
wait    4
send    This is only a test.\r.\r
wait    6

shot    readnews
size    30 80
cap     Reads Usenet news articles.  With nothing in .newsrc matching
cap     most of the active groups, it asks about each one in turn before
cap     it would start showing articles.
run     readnews
wait    6
send    n\r
wait    3
send    n\r
wait    3
send    n\r
wait    4

shot    rnews
size    30 80
cap     Unpacks an incoming news batch.  Given one real article with a
cap     `Newsgroups:' header, it files it under the matching directory
cap     tree in the news spool.
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil; rm -rf /dd/SPOOL/news/COMP
wait    3
run     printf "Newsgroups: comp.os.os9\rSubject: test article\r\rhello there\r" > /dd/tmp/MAILA/art.txt
wait    3
run     LEN=$(cat /dd/tmp/MAILA/art.txt | wc -c)
wait    2
run     clear
wait    1
run     printf "#! rnews %s\r" $LEN > /dd/tmp/MAILA/batch.txt; cat /dd/tmp/MAILA/art.txt >> /dd/tmp/MAILA/batch.txt
wait    4
run     rnews /dd/tmp/MAILA/batch.txt
wait    6
run     ls -laR /dd/SPOOL/news/COMP
wait    6

shot    subscribe
cap     Adds a newsgroup to your subscription list -- if it is already
cap     listed in .newsrc but turned off, this turns it back on.  A
cap     group that is not in .newsrc at all is silently left alone.
run     unsubscribe news.announce.newusers
wait    5
run     clear
wait    1
run     cat /dd/.newsrc
wait    4
run     subscribe news.announce.newusers
wait    6
run     cat /dd/.newsrc
wait    5

shot    unsubscribe
cap     Drops a newsgroup from your subscription list.
run     subscribe comp.sys.m68k
wait    5
run     clear
wait    1
run     cat /dd/.newsrc
wait    4
run     unsubscribe comp.sys.m68k
wait    6
run     cat /dd/.newsrc
wait    5

# Communications, everything but Mail and News.  Almost all of these talk
# to a peer that is not here -- a serial line, a modem, a remote UUCP or
# TCP host, a Kermit partner, a web client.  The honest card is what each
# says when it reaches for that peer, or what it does on its own.

# --- Terminal & session ---------------------------------------------------

shot    cls
cap     Clears the screen through the terminal's termcap clear capability,
cap     the way `clear' does, and returns with the cursor at the top.
run     cls
wait    4

shot    fkeys
cap     Sets the user-defined function keys on a VT220 terminal from a
cap     definition file.  Asked what it takes, it names the file argument;
cap     it needs VT220 hardware to program.
run     fkeys -?
wait    5

shot    sbreak
cap     Sends a break signal on a serial (SCF) device.  Its syntax names
cap     the device, and run without one it says a device must be given.
run     sbreak -?
wait    4
run     sbreak
wait    4

shot    initvdu
cap     Initialises the login terminal from its termcap entry.  Its help
cap     lists the reset and per-capability options.
run     initvdu -?
wait    5

shot    setterm
cap     Reports or sets the terminal type.  Run with no argument it prints
cap     what TERM currently names; give it a name to change it.
run     setterm
wait    5

shot    setfont
cap     Loads a downloadable font into a terminal from a font file.  It
cap     needs real terminal hardware to receive the font; run without a
cap     path it prints its one-line usage.
run     setfont
wait    4

shot    tsmon2
cap     A terminal monitor: it watches a serial line and starts the login
cap     program when someone connects.  Its help lists the options for DCD
cap     monitoring, idle timeout and which program to start.
run     tsmon2 -?
wait    6

shot    connect
cap     Joins two serial paths so you can talk through one to the other,
cap     with switches for echo, CRLF and flow control on each side.  Its
cap     usage lists them.
run     connect -?
wait    5

shot    tsu
cap     tterm's setup program: it creates the directory and dial-file
cap     structure tterm needs under USR, reporting each one it makes.
run     tsu
wait    6

shot    uwho
cap     Lists who is logged in, from the UNAXCESS bulletin board.  It
cap     opens /etc/utmp, and a leading /etc names a device in OS-9 rather
cap     than a directory, so it cannot find that file here.
run     uwho
wait    5

shot    input
cap     The UNAXCESS bulletin board's input helper: it copies standard
cap     input straight to standard output, a line at a time.
run     printf "line one\rline two\r" | input
wait    5

shot    udate
cap     The UNAXCESS bulletin board's date display.  It prints the day and
cap     time, writing the year into a fixed `19' field, so the present
cap     year reads 19126.
run     udate
wait    4

shot    wysecrack
cap     Probes for a Wyse terminal by asking it to identify itself and
cap     waiting for the reply.  Nothing here is a Wyse, so no answer comes
cap     and the screen stays blank.
run     /dd/CMDS/BROKEN/wysecrack
wait    6
kill

shot    wysetime
cap     A subroutine module for setting a Wyse terminal's clock, meant to
cap     be called by another program rather than run.  Asked to run it,
cap     the shell reports it cannot be executed.
run     wysetime
wait    4

# --- Terminal & transfer --------------------------------------------------

shot    sterm
cap     A serial terminal emulator with a built-in B+ file transfer.  Its
cap     usage lists the modem-port link and the transfer options; there is
cap     no serial line here for it to open.
run     sterm -?
wait    5

shot    tterm
cap     Stephen Carville's VT100-style terminal emulator.  Its usage shows
cap     the modem-port link, defaulting to the MODEM port; with no line
cap     configured there is nothing for it to connect to.
run     tterm -?
wait    5

shot    xy
cap     Tim Kientzle's XMODEM/YMODEM transfer.  Asked for its options it
cap     prints the full usage: send by naming files, receive by naming
cap     none, with flags to force ASCII or binary and to pick the protocol.
run     xy -?
wait    5

shot    z
cap     Tim Kientzle's ZMODEM transfer.  Its usage covers sending and
cap     receiving files and sending a command down the link; $MODEM names
cap     the port, -p overrides it.
run     z -?
wait    5

shot    k
cap     Tim Kientzle's Kermit-protocol transfer, the same family as `xy'
cap     and `z'.  Its usage lists the send, receive and file-type options.
run     k -?
wait    5

shot    dld
cap     Downloads a file over a serial line with the XMODEM protocol.  Its
cap     help names the single file argument.
run     dld -?
wait    5

shot    uld
cap     Uploads a file over a serial line with the XMODEM protocol, the
cap     companion to `dld'.  Its help names the file argument.
run     uld -?
wait    5

shot    txmod
cap     Sends an OS-9 module down a serial line to `rxmod' on another
cap     machine, which enters it into that machine's module directory.
cap     Its syntax lists the module and device options.
run     txmod
wait    5

shot    rxmod
cap     Receives an OS-9 module over a serial line and enters it in the
cap     module directory -- the receiving half of `txmod'.  It needs the
cap     vmod_trap handler that ships beside it, so load that first.
run     load /dd/CMDS/COMMS/vmod_trap
wait    3
run     clear
wait    1
run     rxmod -?
wait    5

shot    blastem
cap     XMODEM and YMODEM file transfer, written for the MM/1.  Its help
cap     lists the send and receive, protocol and buffer options; -p names
cap     the modem path.
run     blastem -?
wait    5

shot    xydown
cap     Tim Kientzle's XMODEM/YMODEM/YModem-Batch download.  It senses
cap     which the sender is using and follows.  Its usage names the serial
cap     port, baud and file-type options.
run     xydown -?
wait    5

shot    xyt
cap     Stephen Carville's X/Y/YModem-Batch transfer for the `tterm'
cap     emulator.  Its usage lists the file-type, remote-mode and serial
cap     port options; the modem port is the default.
run     xyt -?
wait    5

# --- Kermit ---------------------------------------------------------------

shot    kermit
cap     OS-9 Kermit 1.5, a serial file-transfer and terminal program that
cap     needs no Microware module.  With no line to talk to it prints its
cap     command letters: connect, send, receive, host-server, get, quit.
run     kermit
wait    6

shot    kermit2
cap     Kermit 1.6, the same command letters as `kermit' in less space.
cap     It prints them when run with no line to transfer over.
run     kermit2
wait    6

shot    kermit3
cap     Kermit68K 1.0, a different design: it puts up its own `Kermit68K>'
cap     prompt and reads commands and a Kermit.ini, rather than taking
cap     command letters.
run     kermit3
wait    6
snap
send    exit\r
wait    2

shot    xkermit
cap     OS-9 Kermit 1.5 again -- the same version as `kermit' in half the
cap     space, because it links the shared cio library rather than carrying
cap     its own stdio.  It prints the same command letters.
run     xkermit
wait    6

shot    ckermit
cap     C-Kermit 5A(190), the full protocol with a command language, at
cap     its `C-Kermit>' prompt.  `show features' lists what this build
cap     carries: character-set translation, a fullscreen transfer display.
run     ckermit
wait    8
send    show features\r
wait    4
snap
send    exit\r
wait    2

shot    kermit_cio
cap     A relink of `kermit' against the shared cio library, kept as the
cap     one build here that can be driven only in send mode.  Run with no
cap     line it prints the same banner and command letters as `kermit'.
run     /dd/CMDS/REBUILT/kermit_cio
wait    6

# --- TCP/IP ---------------------------------------------------------------

shot    finger
cap     Asks another machine who is logged in and shows their information.
cap     It needs a network to reach; run here it prints its one-line usage.
run     finger
wait    5

shot    net
size    30 80
cap     Phil Karn's KA9Q net -- TCP/IP over SLIP or AX.25, with telnet,
cap     ftp and smtp.  It starts, then lists the files it needs you to
cap     write for your own station: startup.net, the host and user tables,
cap     the mail directories.  Its setup guide is in DOC/ka9q.
run     net
wait    8

shot    osknet
size    30 80
cap     OSKNET, a TCP/IP package for OS-9 built on Phil Karn's KA9Q --
cap     telnet, ftp, ping and smtp over SLIP or PPP.  It starts and lists
cap     the configuration it needs for your own station: startup.okn, the
cap     host and user tables, the mail directories.  Setup is in DOC/osknet.
run     osknet
wait    8

shot    msntp
cap     Sets the system clock from a network time server.  It needs a newer
cap     edition of the shared csl runtime library than this disk carries,
cap     so the runtime stops it before its own code runs.
run     msntp
wait    6

shot    atp
cap     The AX.25 transport from the KA9Q packet-radio package.  It reads
cap     its configuration first and names the file it wants -- /dd/atprc or
cap     .atprc -- which you write for your own station.
run     atp
wait    8

shot    infoxpress
cap     An InfoXpress network client.  It opens a serial device to reach
cap     its host and waits there for the far end, which no line here
cap     provides.
run     infoxpress
wait    8

# --- UUCP -----------------------------------------------------------------

shot    uucp
cap     The UUCP copy command: it queues a file to or from another site,
cap     named `system!path'.  Its usage and version are what it prints
cap     when asked.
run     uucp -?
wait    5

shot    uucico
size    30 80
cap     The UUCP transfer program itself -- it dials a site, or answers as
cap     the slave, and moves the queued files.  Its options cover master
cap     and slave modes, retries, logging and the debug level.
run     uucico -?
wait    8

shot    uuxqt
cap     Runs the commands a remote site queued here.  Before starting it
cap     looks for a module called `procs' to check whether it is already
cap     running, and this disk has none, so it stops there.
run     uuxqt
wait    6

shot    uuname
cap     Lists the UUCP sites this system is configured to reach, out of
cap     the tables in SYS.
run     uuname
wait    5

shot    uulog
cap     Shows the UUCP transfer log, one line per event; -s limits it to
cap     a named site.
run     uulog
wait    4

shot    uuclean
cap     Removes stale jobs from the UUCP spool.  Its help lists the age
cap     and selection options.
run     uuclean -?
wait    6

# --- File transfer --------------------------------------------------------

shot    fileserv
cap     The UUCP file server: it answers file requests from remote sites.
cap     With no request waiting it has nothing to do and exits without a
cap     word, so its listing is shown to confirm the module is present.
run     ls -l /dd/CMDS/UUCP/fileserv
wait    4
run     fileserv
wait    5

shot    fixtext
cap     Repairs the line endings of a text batch received over UUCP.  Given
cap     a file whose lines end in the wrong character it rewrites them: the
cap     dump shows each line now ended by CR (0D), as OS-9 text wants.
run     mkdir -p /dd/tmp/COMB > /nil 2>/nil
wait    2
run     printf "line one\nline two\n" > /dd/tmp/COMB/ft.in
wait    2
run     clear
wait    1
run     fixtext /dd/tmp/COMB/ft.in /dd/tmp/COMB/ft.out
wait    4
run     dump /dd/tmp/COMB/ft.out
wait    4

# --- Web server -----------------------------------------------------------

shot    wn
size    40 80
cap     WN serving a page.  It is an inetd-style server: one HTTP request
cap     on standard input, one response on standard output.  The request
cap     is built with `echo' and passed through `autolf', since HTTP wants
cap     CRLF and this disk's echo writes CR alone.  Back comes a complete
cap     HTTP/1.0 200 with Last-modified, Content-length and the page.  Its
cap     document root is /h0/c/unid/wn_1.14.3/osk, on this disk, so mount
cap     the collection as /h0 as well as /dd; `wndex' builds the cache it
cap     serves from.  The reply is cut to eighteen lines to end cleanly.
run     mkdir -p /dd/tmp/COMB > /nil 2>/nil
wait    2
run     ksh -c "cd /h0/c/unid/wn_1.14.3/osk; wndex" 2>/nil
wait    6
run     echo "GET /index.html HTTP/1.0" > /dd/tmp/COMB/rq
wait    2
run     echo "" >> /dd/tmp/COMB/rq
wait    2
run     autolf -c -C -L < /dd/tmp/COMB/rq > /dd/tmp/COMB/rq.crlf
wait    3
run     clear
wait    1
run     wn -L /nil -l /nil < /dd/tmp/COMB/rq.crlf | head -n 18
wait    8

shot    wndex
cap     Builds the index.cache that WN serves from.  It works on the
cap     current directory and ignores a directory given as an argument, so
cap     it is run through ksh, whose `cd' moves the OS-9 data directory.
run     ksh -c "cd /h0/c/unid/wn_1.14.3/osk; wndex" 2>/nil
wait    8

shot    inetd
cap     The internet superserver: it listens on a port and hands each
cap     connection to WN.  Run with no arguments it prints its usage; to
cap     listen it needs a TCP/IP stack presenting the /socket device.
run     inetd
wait    5

shot    inetdc
cap     What inetd forks to handle each connection.  It carries no message
cap     strings and, run by hand with nothing to serve, exits in silence;
cap     there is nothing else it can do alone.
run     inetdc < /nil
wait    5

shot    authwn
cap     WN's authenticator for a password-protected directory.  inetd and
cap     wn invoke it per request; run alone with nothing to authenticate
cap     it has nothing to say.
run     authwn < /nil
wait    5

# --- Preserved here, catalogued under System & modules --------------------

shot    screen
cap     Russ Smith's login greeting: it shows a file chosen at random from
cap     $HOME/.screens.  With no such directory it says one is required.
cap     Not the terminal multiplexer of the same name.
run     screen -v
wait    6

shot    vmod_trap
cap     The modem trap handler that the serial-transfer programs load and
cap     call.  It is a trap-handler module, not a program; run directly the
cap     shell reports it cannot be executed.
run     /dd/CMDS/COMMS/vmod_trap
wait    4
