# There is no modem here and no site to call, so what these show
# is their own face: the prompt, the settings, the log.

shot    aterm
cap     ATerm 2.6, a terminal emulator.  Its own Example line is `ATerm
cap     /t1', naming a serial device driven the way its control file in
cap     SYS/ATERM expects.  Pointed at /t1 here it answers that the device
cap     is not a valid one, since no such serial line is configured.
try     aterm /t1
run     aterm
wait    6
run     aterm /t1
wait    10

shot    elm
cap     The full-screen mail reader, opening on the folder that ships for
cap     this account: one message.  `d' deletes, `r' replies, `q' quits.
try     elm
run     elm
wait    10
quit    q\r

shot    answer
cap     Replies to messages in a folder one at a time, prompting `Message
cap     to:' for a recipient it checks against the alias table.  Anything
cap     else gets `Sorry, could not find ... in list!' and it asks again.
try     answer
run     newalias
wait    8
run     clear
wait    1
run     answer
wait    6
send    tester\r
wait    5

shot    arepdaemon
cap     The daemon autoreply relies on.  Wants its data file, which is
cap     not here, and says so:
cap     `Error 216 attempting fstat' -- though it still touches
cap     autoreply.log on its way there.
try     arepdaemon
run     rm -f /dd/USR/LIB/ELM/autoreply.data /dd/USR/LIB/ELM/autoreply.log
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ls -l USR/LIB/ELM
wait    4
run     arepdaemon
wait    5
run     ls -l USR/LIB/ELM
wait    5

shot    autoreply
cap     Sends an automatic reply while you are away.  It resolves your
cap     mailbox by the session's numeric owner rather than $USER, so
cap     under this identity it reaches for a mailbox named `su' and
cap     stops there; turning autoreplying off does not need the mailbox
cap     and answers for real.
try     autoreply off
run     autoreply -?
wait    6
run     clear
wait    1
run     autoreply off
wait    6

shot    checkalias
cap     Checks whether a mail alias resolves.  It prints nothing and hands
cap     back the same status whether the alias is in the table or not, so
cap     listalias -- which prints the match -- is the better way to ask.
try     checkalias os9; echo "exit: $?"
os9     checkalias os9; echo exit: $?
run     newalias
wait    8
run     clear
wait    1
run     checkalias os9; echo "exit: $?"
wait    5
run     checkalias nosuchalias; echo "exit: $?"
wait    5

shot    disable
cap     Turns a serial port's terminal monitor off.  It wants the port's
cap     device driver module resident in memory to find it by name; none
cap     is loaded here, so it gets no further than looking.
try     disable /t1
run     disable -?
wait    5
run     clear
wait    1
run     disable /t1
wait    5

shot    enable
cap     The other half of `disable', with an extra option to hold its
cap     prompt until a signal comes in.  Asked for by full path -- bash
cap     has its own builtin of the same name, which answers first.  Same
cap     story as disable: it wants the /t1 module resident and none is.
try     enable /t1
run     /dd/CMDS/UUCP/enable -?
wait    5
run     clear
wait    1
run     /dd/CMDS/UUCP/enable /t1
wait    5

shot    dotilde
cap     The mailer's tilde-escape handler: it reads a message from standard
cap     input and acts on the `~' commands inside it.  An unrecognized one
cap     gets `Unrecognized tilde command' and it keeps reading.
try     dotilde <msg.txt
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC; printf "hello\r~x\rmore text\r" > /dd/tmp/EC/msg.txt
wait    3
run     builtin cd /dd/tmp/EC
wait    1
run     clear
wait    1
run     dotilde <msg.txt
wait    6

shot    fastmail
cap     Sends a file as mail without opening the reader.  It needs a delivery
cap     agent to hand the message off, and there is none here, so the folder
cap     is unchanged and it returns in silence.
try     fastmail msg.txt tester
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC; printf "hello from fastmail\r" > /dd/tmp/EC/msg.txt
wait    3
run     builtin cd /dd/tmp/EC
wait    1
run     clear
wait    1
run     messages
wait    4
run     fastmail msg.txt tester
wait    6
run     messages
wait    5

shot    filter
cap     A pipe stage that sorts incoming mail into folders by rule -- its own
cap     usage line begins with the pipe.  With no rules file at SYS/.elm it
cap     says so and mails the message through anyway, which is the safe
cap     thing for a filter to do.  It wants a scratch device at /r0: a real
cap     OS-9 system has a RAM disk there and `mount -r=256k /r0' makes one
cap     under os9exec.  It leaves the terminal without its automatic line
cap     feed, so `tmode -lf' or a fresh login puts that back.
try     filter -v <msg.txt
run     mount -r=256k /r0
wait    2
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC; printf "From tester\rSubject: test\r\rbody\r" > /dd/tmp/EC/msg.txt
wait    3
run     builtin cd /dd/tmp/EC
wait    1
run     clear
wait    1
run     filter -?
wait    4
run     filter -v <msg.txt
wait    6

shot    frm
cap     Lists who your mail is from, one line each.  On this disk it
cap     opens the folder, names you, and answers that there is no mail --
cap     even though `messages' and `readmsg' both find the one message
cap     that is there.
try     frm
run     frm
wait    6

shot    lcasep
cap     Lower-cases a name for the mailer, reading it from standard input.
try     lcasep <name.txt
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC; printf "John Q Public\r" > /dd/tmp/EC/name.txt
wait    3
run     builtin cd /dd/tmp/EC
wait    1
run     clear
wait    1
run     lcasep <name.txt
wait    5

shot    listalias
cap     Lists the mail aliases you have, once newalias has compiled them:
cap     your own aliases first, then the shared system ones.  It builds an
cap     `egrep ... | sort' pipeline and hands it to a shell, so `sort' is
cap     loaded first and the fork finds it by name.
try     listalias
run     newalias
wait    8
run     newalias -g
wait    8
run     load /dd/CMDS/sort
wait    3
run     clear
wait    1
run     listalias
wait    6

shot    lmail
cap     Local mail delivery: it reads a message on standard input and adds
cap     it to the named user's mail folder, where Elm, messages and readmsg
cap     find it.  Here a short note goes to the os9 account.
try     lmail os9 < tmp/note
run     builtin cd /dd
wait    1
run     rm -f SPOOL/MAIL/os9; echo 'Subject: hello' > tmp/note; echo '' >> tmp/note; echo 'A note for the os9 account.' >> tmp/note
wait    2
run     clear
wait    1
run     lmail os9 < tmp/note
wait    6
run     cat SPOOL/MAIL/os9
wait    3

shot    mail
size    24 80
cap     A mail reader and sender in one, from the UUCP set.  `mail <user>'
cap     takes the message from the keyboard, a line holding one dot ending
cap     it, and files it in the MAIL directory at the root of the disk.
cap     `mail' on its own opens what is waiting, one message at a time, and
cap     prompts with its number; `?' lists the commands -- t for the titles,
cap     p to print, d to delete, s to save, m to send another, r to reply,
cap     x to leave.  Here a message went to `tester' and was read back.
cap     mail wants a scratch device at /r0.  A real OS-9 system has a RAM
cap     disk there; under os9exec, `mount -r=256k /r0' makes one.
try     mail
run     mount -r=256k /r0
wait    2
run     mkdir -p /dd/MAIL > /nil 2>/nil
wait    2
run     rm -f /dd/MAIL/tester > /nil 2>/nil
wait    2
run     ksh -c "echo Hello from the collection. | mail tester"
wait    5
run     clear
wait    1
run     mail
wait    7
snap
send    x
wait    2

shot    mailx
cap     The mail reader and sender, from the UUCP set.  It goes looking for
cap     a mailbox directory of its own and names the login name the password
cap     file gives for the numeric owner -- `su', logged in as the super
cap     user, which has no mailbox here.  `mail', beside it, keeps its
cap     mailboxes in the MAIL directory at the root of the disk and works.
try     mailx
run     mailx
wait    8

shot    makedb
cap     Builds smail's path-alias database from a text source, writing two
cap     files beside the name you give: a .dir and a .pag.
try     makedb -o palias palias.src
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC
run     cat /dd/USR/LIB/SMAIL/palias > /dd/tmp/EC/palias.src
run     builtin cd /dd/tmp/EC
wait    2
run     clear
wait    1
run     makedb -o palias palias.src
wait    6
run     ls -l palias.dir palias.pag
wait    5

shot    messages
cap     Counts and lists what is in a folder.
try     messages
run     builtin cd /dd
wait    1
run     clear
wait    1
run     messages
wait    5
run     messages -f SPOOL/MAIL/tester
wait    5

shot    newalias
cap     Rebuilds the alias database after you edit the alias files: your
cap     own first, then the system one with -g.
try     newalias
run     newalias
wait    8
run     newalias -g
wait    8
run     newalias -g
wait    8

shot    newmail
cap     Watches for mail arriving and says so; -d also reports the
cap     folder it is watching and its size.
try     newmail -d tester
run     newmail -?
wait    6
run     load /dd/CMDS/UUCP/uuname
wait    3
run     clear
wait    1
run     newmail -d tester
wait    8

shot    nptx
cap     The address it builds from one name-and-login line: given the full
cap     name and the login separated by a tab, it answers with the pair.
try     nptx <name.txt
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC; printf "John Q Public\tjqpublic\r" > /dd/tmp/EC/name.txt
wait    3
run     builtin cd /dd/tmp/EC
wait    1
run     clear
wait    1
run     nptx <name.txt
wait    6

shot    pathalias
cap     Computes mail routes from a map of who calls whom.  Given a map where
cap     milkyway calls phoenix, phoenix calls seabass and seabass calls
cap     pirsqrd, it prints the cheapest route to each site; the %s is where a
cap     user name goes.
try     pathalias -l milkyway map
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC
run     printf "milkyway phoenix(20)\rphoenix seabass(30)\rseabass pirsqrd(10)\r" > /dd/tmp/EC/map
run     builtin cd /dd/tmp/EC
wait    1
run     clear
run     pathalias -l milkyway map
wait    5

shot    philmail
cap     An off-line mail reader: it opens $MAIL, confirms the file is
cap     well formed, and lets you step through messages with return;
cap     `q' quits.
try     philmail
run     philmail
wait    6
send    \r
wait    5
send    q\r
wait    5

shot    printmail
cap     Formats a message for a printer.  It forks `readmsg' by bare
cap     name, so load it first; then printmail prints the message the
cap     same way `readmsg' would.
try     printmail 1
run     load /dd/CMDS/ELM/readmsg
wait    3
run     clear
wait    1
run     printmail 1
wait    6

shot    pwparse
cap     Parses a password file into the login names the mailer wants,
cap     one per line.
try     pwparse <password
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     pwparse < password
wait    6

shot    read_mail
cap     vi/elvis's own mail helper, not part of Elm: it opens your mailbox,
cap     quotes each message, then offers to list them again, exit and delete,
cap     or exit and keep.  Here it quotes the one message and `N' keeps it.
try     read_mail
run     mkdir -p /dd/MAIL > /nil 2>/nil
run     printf "From: os9-freeware\rSubject: hello\r\rWelcome to the collection.\r" > /dd/MAIL/mail_tester
wait    3
run     clear
wait    1
run     read_mail
wait    5
send    N\r
wait    4

shot    readmsg
cap     Prints a message from a folder by number.
try     readmsg 1
run     readmsg 1
wait    6

shot    rmail
cap     Delivers incoming mail -- invoked by uuxqt, not typed by hand.
cap     Local delivery expects a mailbox directory; the one that ships
cap     is a plain file, so it stops there.
try     rmail tester
run     rmail tester
wait    6

shot    smail
cap     The options it lists.
try     smail -?
run     smail -?
wait    8

shot    uupoll
cap     Polls a UUCP site for waiting work.  It works in silence -- the
cap     only sign is the poll file it leaves in the site's spool
cap     directory.
try     uupoll seabass
run     ls -l /dd/SPOOL/uucp/seabass
wait    4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     uupoll seabass
wait    6
run     ls -l SPOOL/uucp/seabass
wait    5

shot    uux
cap     Queues a command to run on another UUCP site, named as site!command.
cap     Its options come first; then a request for `seabass', which this UUCP
cap     package has no route to -- a different package on the disk is the one
cap     whose Systems file names that site.  The backslash is bash's: it reads
cap     `!' as a history reference before it considers quoting.
try     uux seabass\!rnews
os9     uux "seabass!rnews"
run     uux -?
wait    6
run     clear
wait    1
run     uux seabass\!rnews
wait    6
snap

shot    bdecode
cap     Decodes a batched news article.  Handed a file with no batch header,
cap     it says so plainly.
try     bdecode msg.txt
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC; printf "not a batch\r" > /dd/tmp/EC/msg.txt
wait    3
run     builtin cd /dd/tmp/EC
wait    1
run     clear
wait    1
run     bdecode msg.txt
wait    6

shot    byteflip
cap     Reorders the bytes of every word it reads, so a dbz database
cap     written on one architecture can be read on another.  Four things
cap     tell it how: the word length, where each byte comes from, the
cap     word length again, and where each byte goes.  Turning a four-byte
cap     word end for end is `4 0 1 2 3 4 3 2 1 0', which is what runs
cap     here.  Give it those numbers: with none, the word length is zero,
cap     and it reads zero bytes for ever.
try     byteflip 4 0 1 2 3 4 3 2 1 0 < in.txt
run     rm -rf /dd/tmp/BFL > /nil 2>/nil; mkdir -p /dd/tmp/BFL; printf "ABCDEFGH\r" > /dd/tmp/BFL/in.txt
wait    3
run     builtin cd /dd/tmp/BFL
wait    1
run     clear
wait    1
run     cat in.txt
wait    3
run     byteflip 4 0 1 2 3 4 3 2 1 0 < in.txt > out.txt
wait    5
run     cat out.txt
wait    3

shot    c7decode
cap     Decodes 7-bit-safe encoded news.  Handed text that is not encoded
cap     that way, it says so.
try     c7decode <msg.txt
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC; printf "not encoded\r" > /dd/tmp/EC/msg.txt
wait    3
run     builtin cd /dd/tmp/EC
wait    1
run     clear
wait    1
run     c7decode <msg.txt
wait    6

shot    dbz
cap     The news history database from C News.  It reads a text history file
cap     and builds the hashed .dir and .pag index beside it; on the single
cap     sample line here the store reports it could not place the entry, and
cap     leaves the pair it had begun.
try     dbz history
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC; printf "<one@site.uucp> 999999999 1\r" > /dd/tmp/EC/history
run     builtin cd /dd/tmp/EC
wait    3
run     clear
wait    1
run     dbz history
wait    8
run     ls -l history.dir history.pag
wait    5

shot    expire
cap     Deletes news articles past their expiry date.  -t previews
cap     without deleting, walking every newsgroup in the active file.
try     expire -t
run     expire -t
wait    8

shot    newshist
cap     Rebuilds the news history file.  dbz's own store on this disk
cap     fails on the entry it is given here -- see dbz -- so what
cap     newshist can say about an id that really is in the file is that
cap     it has no entry for it.
try     newshist "<one@site.uucp>"
run     mkdir -p /dd/lib/news > /nil 2>/nil; printf "<one@site.uucp> 9999999999 1\r" > /dd/lib/news/history
run     builtin cd /dd/lib/news
wait    3
run     clear
wait    1
run     dbz history
wait    8
run     newshist "<one@site.uucp>"
wait    6

shot    newslock
cap     The news system's lock, given a temporary name and the real
cap     lock name.  It leaves no trace here -- no file at either name,
cap     nothing printed.
try     newslock tmplock reallock
run     mkdir -p /dd/tmp/MAILA > /nil 2>/nil
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     newslock tmp/MAILA/tmplock tmp/MAILA/reallock
wait    6
run     ls tmp/MAILA/tmplock tmp/MAILA/reallock
wait    5

shot    postnews
size    30 80
cap     Composes a Usenet article, prompting for newsgroup, subject,
cap     keywords, distribution and summary, then reads the body until a
cap     line with just a dot.  It builds the whole header correctly and
cap     then tries to file the article by running `rnews' as a
cap     subprocess -- which it cannot start, so that is as far as it
cap     goes.
try     postnews
run     postnews
wait    6
send    comp.os.os9\r
wait    3
send    a test posting\r
wait    3
send    \r
wait    3
send    world\r
wait    3
send    testing postnews\r
wait    4
send    This is only a test.\r.\r
wait    6

shot    readnews
size    30 80
cap     Reads Usenet news articles.  With nothing in .newsrc matching
cap     most of the active groups, it asks about each one in turn before
cap     it would start showing articles.
try     readnews
run     readnews
wait    6
send    n\r
wait    3
send    n\r
wait    3
send    n\r
wait    4

shot    rnews
size    30 80
cap     Unpacks an incoming news batch.  Given one real article with a
cap     `Newsgroups:' header, it files it under the matching directory tree in
cap     the news spool.
try     rnews batch.txt
run     rm -rf /dd/SPOOL/news/COMP /dd/art.txt /dd/batch.txt
wait    3
run     printf "Newsgroups: comp.os.os9\rSubject: test article\r\rhello there\r" > /dd/art.txt
wait    3
run     LEN=$(cat /dd/art.txt | wc -c)
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     printf "#! rnews %s\r" $LEN > batch.txt; cat art.txt >> batch.txt
wait    4
run     rnews batch.txt
wait    6
run     ls -laR SPOOL/news/COMP
wait    6

shot    subscribe
cap     Adds a newsgroup to your subscription list -- if it is already
cap     listed in .newsrc but turned off, this turns it back on.  A
cap     group that is not in .newsrc at all is silently left alone.
try     subscribe news.announce.newusers
run     unsubscribe news.announce.newusers
wait    5
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat .newsrc
wait    4
run     subscribe news.announce.newusers
wait    6
run     cat .newsrc
wait    5

shot    unsubscribe
cap     Drops a newsgroup from your subscription list.
try     unsubscribe comp.sys.m68k
run     subscribe comp.sys.m68k
wait    5
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cat .newsrc
wait    4
run     unsubscribe comp.sys.m68k
wait    6
run     cat .newsrc
wait    5

# Communications, everything but Mail and News.  Almost all of these talk
# to a peer that is not here -- a serial line, a modem, a remote UUCP or
# TCP host, a Kermit partner, a web client.  The honest card is what each
# says when it reaches for that peer, or what it does on its own.

# --- Terminal & session ---------------------------------------------------

shot    cls
cap     Clears the screen through the terminal's termcap clear capability,
cap     the way `clear' beside it does, and returns with the cursor at the
cap     top.  A directory listing is printed and then wiped -- only the
cap     line typed after it is left.
try     dir CMDS; cls; echo "cls wiped the listing above"
run     builtin cd /dd
wait    1
run     dir CMDS
wait    3
run     cls
wait    2
run     echo "cls wiped the listing above"
wait    3
snap

shot    fkeys
cap     Sets the user-defined function keys on a VT220 terminal from a
cap     definition file.  Asked what it takes, it names the file argument;
cap     it needs VT220 hardware to program.
try     fkeys -?
run     fkeys -?
wait    5

shot    sbreak
cap     Sends a break signal on a serial (SCF) device.  Its syntax names
cap     the device, and run without one it says a device must be given.
try     sbreak
run     sbreak -?
wait    4
run     sbreak
wait    4

shot    initvdu
cap     Initialises the login terminal from its termcap entry.  Its help
cap     lists the reset and per-capability options.
try     initvdu -?
run     initvdu -?
wait    5

shot    setterm
cap     Reports or sets the terminal type.  Run with no argument it prints
cap     what TERM currently names; give it a name to change it.
try     setterm
run     setterm
wait    5

shot    setfont
cap     Loads a downloadable font into a terminal from a font file.  It
cap     needs real terminal hardware to receive the font; run without a
cap     path it prints its one-line usage.
try     setfont
run     setfont
wait    4

shot    tsmon2
cap     A terminal monitor: it watches a serial line and starts the login
cap     program when someone connects.  Its help lists the options for
cap     carrier-detect monitoring, idle timeout and which program to start.
try     tsmon2 -?
run     tsmon2 -?
wait    6

shot    connect
cap     Joins two serial paths so you can talk through one to the other,
cap     with switches for echo, line-ending translation and flow control
cap     on each side.  With no paths named both ends are the terminal
cap     itself: it reports the connection, names the terminal's quit
cap     character, and waits.
try     connect
run     connect
wait    5
snap

shot    tsu
cap     tterm's setup program: it creates the directory and dial-file
cap     structure tterm needs under USR, reporting each one it makes.
try     tsu
run     tsu
wait    6

shot    input
cap     The Unaxcess bulletin board's input helper: it copies standard input
cap     straight to standard output, a line at a time.
try     input <lines.txt
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC; printf "the first line\rthe second line\rand the third\r" > /dd/tmp/EC/lines.txt
wait    3
run     builtin cd /dd/tmp/EC
wait    1
run     clear
wait    1
run     input <lines.txt
wait    5

shot    wysecrack
cap     Probes for a Wyse terminal by asking it to identify itself and
cap     waiting for the reply.  Nothing here is a Wyse, so no answer comes
cap     and the screen stays blank.
try     wysecrack
run     /dd/CMDS/COMMS/wysecrack
wait    6
kill

# --- Terminal & transfer --------------------------------------------------

shot    wysetime
cap     A Wyse terminal clock-setter in BASIC09: `runb wysetime' emits the
cap     escape sequence a Wyse smart terminal reads to set its own on-screen
cap     clock.  The bytes are shown through `dump', being terminal control
cap     codes rather than text.
try     runb wysetime
run     load /h1/CMDS/runb
wait    2
run     rm -f /dd/tmp/wysetime.out
run     runb wysetime > /dd/tmp/wysetime.out
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     dump tmp/wysetime.out
wait    4

shot    sterm
cap     A serial terminal emulator with a built-in B+ file transfer.  It
cap     links to the port MODEM names, or -l gives, and with neither it
cap     says so and stops.
try     sterm
run     sterm; echo ""
wait    5

shot    tterm
cap     A VT100-style terminal emulator.  It links to the port MODEM names,
cap     or -l gives, and with neither it says so and stops.  `tsu' makes
cap     the directories it keeps its dialling files in.
try     tterm
run     tterm
wait    5

shot    xy
cap     xy waiting to receive a file by XMODEM or YMODEM.  With no MODEM
cap     port set it talks on the terminal itself, so the `C' it sends to
cap     ask the far end for a CRC transfer lands on the screen; a sender
cap     on the line would answer with the first block.  Name files to
cap     send instead.
try     xy
run     xy
wait    6
snap

shot    z
cap     z waiting to receive by ZMODEM.  With no MODEM port set it talks on
cap     the terminal, so its receive-ready frame, sent again every few
cap     seconds until the far end answers, is what shows.  Name files to
cap     send instead; -p names a port.
try     z
run     z
wait    8
snap

shot    k
cap     k waiting for the first Kermit packet on the terminal, since no
cap     MODEM port is set; a sender on the line would start the transfer.
cap     Name files to send instead.  The same family as `xy' and `z'.
try     k
run     k
wait    5
snap

shot    dld
cap     dld sending a file down the line by XMODEM -- in its vocabulary a
cap     download goes from this machine to the terminal.  It announces the
cap     transfer and waits for the receiver's first request.
try     dld motd
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     dld motd
wait    5
snap

shot    uld
cap     uld receiving a file by XMODEM into the name given -- an upload,
cap     from the terminal to this machine, the companion to `dld'.  It
cap     creates the file, announces the transfer and sends the `C' that
cap     asks the far end for a CRC transfer.
try     uld got.txt
run     rm -f /dd/tmp/got.txt
run     builtin cd /dd/tmp
wait    1
run     clear
wait    1
run     uld got.txt
wait    5
snap

shot    txmod
cap     Sends an OS-9 module down a serial line to `rxmod' on another
cap     machine, which enters it into that machine's module directory.
cap     Its syntax lists the module and device options.
try     txmod
run     txmod
wait    5

shot    rxmod
cap     Receives an OS-9 module over a serial line and enters it in the
cap     module directory -- the receiving half of `txmod'.  It needs the
cap     vmod_trap handler that ships beside it, so load that first.
try     rxmod -?
run     load /dd/CMDS/COMMS/vmod_trap
wait    3
run     clear
wait    1
run     rxmod -?
wait    5

shot    blastem
cap     blastem asked to send a file by XMODEM: it opens the modem path,
cap     /t0 unless -p names another, and there is no such device on this
cap     system, so it says so and stops.  -y is YMODEM, -r receive.
try     blastem -s motd
run     builtin cd /dd/SYS
wait    1
run     clear
wait    1
run     blastem -s motd; echo ""
wait    5

shot    xydown
cap     An XMODEM/YMODEM/YModem-Batch download that senses which the sender
cap     is using and follows.  Run bare it opens the serial port, /T0
cap     unless -t names another, and stops when there is no such device.
try     xydown
run     xydown
wait    5

shot    xyt
cap     An X/Y/YModem-Batch transfer for the `tterm' emulator.  It uses
cap     the MODEM port unless -t names another, and with neither set it
cap     says so.
try     xyt
run     xyt
wait    5

# --- Kermit ---------------------------------------------------------------

shot    kermit
cap     OS-9 Kermit 1.5, a serial file-transfer and terminal program that
cap     needs no Microware module.  With no line to talk to it prints its
cap     command letters: connect, send, receive, host-server, get, quit.
try     kermit
run     kermit
wait    6

shot    kermit2
cap     Kermit 1.6, the same command letters as `kermit' in less space.
cap     It prints them when run with no line to transfer over.
try     kermit2
run     kermit2
wait    6

shot    kermit3
cap     Kermit68K 1.0, a different design: it puts up its own `Kermit68K>'
cap     prompt and reads commands and a Kermit.ini, rather than taking
cap     command letters.
try     kermit3
run     kermit3
wait    6
snap
send    exit\r
wait    2

shot    xkermit
cap     OS-9 Kermit 1.5 again -- the same version as `kermit' in half the
cap     space, because it links the shared cio library rather than carrying
cap     its own stdio.  It prints the same command letters.
try     xkermit
run     xkermit
wait    6

shot    ckermit
cap     C-Kermit 5A(190), the full protocol with a command language, at
cap     its `C-Kermit>' prompt.  `show features' lists what this build
cap     carries: character-set translation, a fullscreen transfer display.
try     ckermit
run     ckermit
wait    8
send    show features\r
wait    4
snap
send    exit\r
wait    2

shot    finger
cap     Shows what the system knows about a user: the home directory, the
cap     shell that account logs in with, and the `.project' and `.plan'
cap     files it would print if the account had written them.  It reads
cap     the password file this disk ships, so a local name answers here;
cap     given `user@host' it asks that machine instead.
try     finger tester
run     clear
wait    1
run     finger tester
wait    8

shot    net
size    30 80
cap     The KA9Q net -- TCP/IP over SLIP or AX.25, with telnet,
cap     ftp and smtp.  It starts, then lists the files it needs you to
cap     write for your own station: startup.net, the host and user tables,
cap     the mail directories.  Its setup guide is in DOC/ka9q.
try     net
run     net
wait    8

shot    osknet
size    30 80
cap     OSKNET, a TCP/IP package for OS-9 built on KA9Q --
cap     telnet, ftp, ping and smtp over SLIP or PPP.  It starts and lists
cap     the configuration it needs for your own station: startup.okn, the
cap     host and user tables, the mail directories.  Setup is in DOC/osknet.
try     osknet
run     osknet
wait    8

shot    msntp
cap     Sets the system clock from a network time server: name the server
cap     and it asks one, then sets the clock.  Named one here it stops at
cap     the lookup -- there is no host table on this disk to find an
cap     address in, and it says so for a dotted number as readily as for a
cap     name.  With no server named it listens for broadcasts instead and
cap     waits for one, which is what its own manual says it does.
try     msntp 127.0.0.1
run     msntp 127.0.0.1
wait    6

shot    atp
size    24 80
cap     ATP 1.40, an off-line reader for QWK mail packets -- the bundles a
cap     bulletin board packed a caller's messages into, to be read and
cap     replied to without staying connected.  It reads its configuration
cap     first: `atprc' or `.atprc' in your home directory, or in the
cap     directory ATP names.  A working one for this disk ships in
cap     DOC/ka9q, which is what is set here.
try     atp
run     export ATP=/dd/DOC/ka9q
wait    1
run     clear
wait    1
run     atp
wait    10

shot    infoxpress
cap     An InfoXpress network client.  It opens a serial device to reach
cap     its host and waits there for the far end, which no line here
cap     provides.
try     infoxpress
run     infoxpress
wait    8

# --- UUCP -----------------------------------------------------------------

shot    uucp
cap     The UUCP copy command: it queues a file to or from another site,
cap     named `system!path'.  Its usage and version are what it prints
cap     when asked.
try     uucp -?
run     uucp -?
wait    5

shot    uucico
cap     The UUCP transfer program itself.  Given a site name it dials that
cap     site and moves the queued files; -r answers as the slave instead.
cap     Run with neither it says what it is missing.
try     uucico
run     uucico
wait    5

shot    uuxqt
cap     Runs the commands a remote site queued here.  Before starting it
cap     looks for a module called `procs' to see whether another copy is
cap     already going -- your own OS-9's, loaded from /h1 here.  With it
cap     resident it gets past that and asks which site's queue to run,
cap     printing what it takes: a system name, or `ALL' for every system in
cap     the Systems file.
try     uuxqt
run     load /h1/CMDS/procs
wait    4
run     clear
wait    1
run     uuxqt
wait    6

shot    uuname
cap     The UUCP sites this system is configured to reach, out of the
cap     tables in SYS -- and `-l' for the name this machine answers to,
cap     which is what the other end sees.
try     uuname; uuname -l
run     uuname
wait    5
run     uuname -l
wait    5

shot    uulog
cap     Shows the UUCP transfer log, a line an event.  Nothing has been
cap     transferred here, so there is no log to open and it says so; -s would
cap     narrow a real log to one named site.
try     uulog
run     uulog
wait    4

shot    uuclean
cap     Removes stale jobs from the UUCP spool.  Its help lists the age
cap     and selection options.
try     uuclean -?
run     uuclean -?
wait    6

# --- File transfer --------------------------------------------------------

shot    fileserv
cap     The UUCP file server: it answers file requests from remote sites.
cap     With no request waiting it has nothing to do and exits without a
cap     word, so its listing is shown to confirm the module is present.
try     fileserv
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ls -l CMDS/UUCP/fileserv
wait    4
run     fileserv
wait    5

shot    fixtext
cap     Repairs the line endings of a text batch received over UUCP.  Given a
cap     file whose lines end in the wrong character it rewrites them: the dump
cap     shows each line now ended by CR (0D), as OS-9 text wants.
try     fixtext ft.in ft.out
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC
run     printf "line one\nline two\n" > /dd/tmp/EC/ft.in
run     builtin cd /dd/tmp/EC
wait    2
run     clear
wait    1
run     fixtext ft.in ft.out
wait    4
run     dump ft.out
wait    4

shot    wn
size    40 80
cap     WN serving a page.  It is an inetd-style server: one HTTP request on
cap     standard input, one response on standard output.  The request is built
cap     with `echo' and passed through `autolf', since HTTP wants a carriage
cap     return and line feed and this disk's echo writes the return alone.
cap     Back comes a complete HTTP/1.0 200 with
cap     Last-modified, Content-length and the page.  Its document root is a
cap     directory this disk carries, so mount the collection as /h0 as well as
cap     /dd; `wndex' builds the cache it serves from.  The reply is cut to
cap     eighteen lines to end cleanly.
try     wn -L /nil -l /nil <rq.crlf | head -n 18
os9     wn -L /nil -l /nil <rq.crlf ! head -n 18
run     rm -rf /dd/tmp/EC; mkdir -p /dd/tmp/EC
run     builtin cd /h0/c/unid/wn_1.14.3/osk
run     wndex 2>/nil
wait    6
run     echo "GET /index.html HTTP/1.0" > /dd/tmp/EC/rq
wait    2
run     echo "" >> /dd/tmp/EC/rq
wait    2
run     autolf -c -C -L < /dd/tmp/EC/rq > /dd/tmp/EC/rq.crlf
wait    3
run     builtin cd /dd/tmp/EC
wait    1
run     clear
wait    1
run     wn -L /nil -l /nil <rq.crlf | head -n 18
wait    8

shot    wndex
cap     Builds the index.cache the WN web server reads a directory from.
cap     It works on the current directory, so the demo moves there first,
cap     off-screen, and runs it by name.  The listing after it is the file
cap     it wrote.
try     wndex
run     builtin cd /dd/c/unid/wn_1.14.3/osk
wait    1
run     rm -f index.cache > /nil 2>/nil
wait    2
run     clear
wait    1
run     wndex
wait    8
run     ls -l index.cache
wait    4

shot    inetd
cap     The internet superserver: it listens on a port and hands each
cap     connection to WN.  Run with no arguments it prints its usage; to
cap     listen it needs a TCP/IP stack presenting the /socket device.
try     inetd
run     inetd
wait    5

shot    inetdc
cap     What inetd forks to handle each connection.  It carries no message
cap     strings and, run by hand with nothing to serve, exits in silence;
cap     there is nothing else it can do alone.
try     inetdc
run     inetdc < /nil
wait    5

shot    authwn
cap     WN's authenticator for a password-protected directory.  inetd and
cap     wn invoke it per request; run alone with nothing to authenticate
cap     it has nothing to say.
try     authwn
run     authwn < /nil
wait    5

# --- Preserved here, catalogued under System & modules --------------------

shot    screen
cap     A login greeting: it shows a file chosen at random from
cap     $HOME/.screens.  With no such directory it says one is required.
cap     Not the terminal multiplexer of the same name.
try     screen -v
run     screen -v
wait    6

shot    vmod_trap
cap     The trap handler that rxmod and txmod call -- a trap-handler
cap     module, not a program.  modinfo shows what it is, including the
cap     supervisor-state attribute that decides how it behaves once
cap     installed.  Asking a shell to run it can only produce a refusal.
try     modinfo vmod_trap | head -n 14
os9     modinfo vmod_trap ! head -n 14
run     builtin cd /dd/CMDS/COMMS
wait    1
run     clear
wait    1
run     modinfo vmod_trap | head -n 14
wait    8
snap

shot    tput
size    16 80
cap     Asks termcap what this terminal needs for a capability, by its
cap     System V name.  `cols' and `lines' answer with a number; `clear'
cap     and `cup' answer with the escape sequence itself, which is shown
cap     here through xd so that the bytes can be read.
try     tput -Tvt100 cols; tput -Tvt100 clear | xd -c
os9     tput -Tvt100 cols; tput -Tvt100 clear ! xd -c
run     builtin cd /dd
wait    1
run     clear
wait    1
run     tput -Tvt100 lines
run     tput -Tvt100 cols
wait    3
run     tput -Tvt100 clear | xd -c
wait    4
run     tput -Tvt100 cup 10 20 | xd -c
wait    4

shot    vttest
size    24 80
cap     vttest's menu: each test draws pages that say what a correct VT100
cap     shows.  It judges the terminal it runs on, so a screen that is not a
cap     full VT100 shows its differences.
try     vttest
run     vttest
wait    6
snap
send    0\r
wait    4

shot    uustat
cap     uustat reports on the UUCP job queue -- what is waiting, for which
cap     system, and who queued it -- and can kill a job or rejuvenate one.
cap     Nothing has been queued on this disk, so it reaches the spool, finds
cap     no jobs waiting, and says so.
try     uustat
run     uustat -?
wait    4
run     clear
wait    1
run     uustat
wait    4
