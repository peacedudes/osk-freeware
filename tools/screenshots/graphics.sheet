shot    rgb3toppm
for     ppmtorgb3 rgb3toppm
cap     A colour picture split into three greymaps and put back together.
cap     ppmtorgb3 names them after its input and writes them beside it --
cap     base.ppm becomes base.red, base.grn and base.blu -- and rgb3toppm
cap     combines the three into one PPM again.
try     ppmtorgb3 base.ppm; ls -l base.red base.grn base.blu; rgb3toppm base.red base.grn base.blu | pnmfile
os9     ppmtorgb3 base.ppm; ls -l base.red base.grn base.blu; rgb3toppm base.red base.grn base.blu ! pnmfile
run     rm -rf /dd/tmp/RGB3 > /nil 2>/nil; mkdir -p /dd/tmp/RGB3
wait    3
