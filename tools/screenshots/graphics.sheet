shot    wgen
cap     A Tektronix waveform generator: it asks for a resolution and the
cap     intensity of nine harmonics, then clears a Tektronix screen and
cap     draws the summed wave as vectors.  Those plotting codes mean nothing
cap     to an ordinary terminal, which prints them as the stray characters
cap     at the foot of the screen.
try     wgen
run     clear
wait    1
run     wgen
wait    5
send    128\r
wait    2
send    150\r75\r40\r20\r10\r5\r0\r0\r0\r
wait    8
snap

# ---- Drawing & display


shot    loadmem
super
cap     Copies a file into memory at an address you give: destination,
cap     upper limit, path, the addresses in hex.  Super user only, and it
cap     says nothing at all when it works -- so its counterpart `savemem'
cap     reads the same address straight back here, and there the file is.
try     loadmem 8000 80FF m.txt
run     rm -rf /dd/tmp/MEML > /nil 2>/nil; mkdir -p /dd/tmp/MEML
wait    3
run     builtin cd /dd/tmp/MEML
wait    1
run     cp /dd/SYS/motd m.txt
wait    3
run     clear
wait    1
run     loadmem 8000 80FF m.txt
wait    4
run     savemem 8000 8027 back.bin
wait    4
run     dump back.bin
wait    4


shot    savemem
super
cap     loadmem has put the text of a file at 8000 first; savemem writes
cap     8000 to 8027 back out to a new file, and dump shows the text coming
cap     back.
try     savemem 8000 8027 back.bin
run     rm -rf /dd/tmp/MEMS > /nil 2>/nil; mkdir -p /dd/tmp/MEMS
wait    3
run     builtin cd /dd/tmp/MEMS
wait    1
run     cp /dd/SYS/motd m.txt
wait    3
run     loadmem 8000 80FF m.txt
wait    4
run     clear
wait    1
run     savemem 8000 8027 back.bin
wait    4
run     dump back.bin
wait    4


shot    snap
cap     Writes a snapshot of the terminal screen to a file (polaroid if
cap     none is named).  It drives the hardware terminals -l lists; on any
cap     other it names the terminal type it does not know and stops.
try     snap -l
run     clear
wait    1
run     snap -l
wait    5
snap


shot    pdraw
size    30 80
cap     Pdraw 1.4 plots 3D x-y-z data as PostScript.  It reads the options
cap     file first and prints every setting it took from it, then asks
cap     before sending the plot on; RETURN there and it writes the
cap     PostScript and says so.  The sample options and curves.plot ship
cap     in DOC/pdraw, and the file it leaves is `dataplot.ps'.
try     pdraw -o options curves.plot
run     rm -rf /dd/tmp/PDA > /nil 2>/nil; mkdir -p /dd/tmp/PDA
wait    2
run     cat /dd/DOC/pdraw/options > /dd/tmp/PDA/options; cat /dd/DOC/pdraw/curves.plot > /dd/tmp/PDA/curves.plot
wait    3
run     builtin cd /dd/tmp/PDA
wait    1
run     clear
wait    1
run     pdraw -o options curves.plot
wait    12
send    \r
wait    10
run     ls -l dataplot.ps
wait    4

# ---- X11 clients
snap


shot    basicwin
cap     The classic X11 basic-window demo.  There is no X server here, so it
cap     stops at "cannot connect to X server"; with an X display it opens a
cap     window and draws into it.
try     basicwin; echo ""
os9     basicwin
run     basicwin; echo ""
wait    8
snap

shot    xengine
cap     An X11 demo that animates a running engine.  There is no X display
cap     here, so it stops at "Can't open display"; with one it draws the
cap     engine and runs it.
try     xengine; echo ""
os9     xengine
run     xengine; echo ""
wait    8
snap

shot    X11R6shl
cap     The X11R6 shared-library loader -- a type-$0B trap library, not a
cap     program.  modinfo shows what it is; asking a shell to run it can
cap     only produce a refusal, which says nothing about the library.
try     modinfo X11R6shl | head -n 14
os9     modinfo X11R6shl ! head -n 14
run     builtin cd /dd
wait    1
run     clear
wait    1
run     modinfo X11R6shl | head -n 14
wait    8
snap

# ---- Plotting
snap

shot    tplot
cap     Plots columns of numbers from a file or standard input.  It asks
cap     for the x and y intervals, two numbers each, and then the x and y
cap     divisions, and draws through the Atari ST's A-line graphics traps --
cap     a machine with those is what it needs to finish the plot.
try     tplot
run     tplot
wait    5
send    0 10\r
wait    3
send    0 5\r
wait    3
kill

# ---- Ray tracing helper

shot    rsconvert
cap     Converts a scene file written for rayshade 3 into rayshade 4's
cap     syntax, a statement to a line, ready for rayshade to render.  Name
cap     the old file, or give it on standard input.
try     rsconvert tmp/old.ray
run     builtin cd /dd
wait    1
run     echo 'screen 32 24' > tmp/old.ray; echo 'light 1 directional 0 0 1' >> tmp/old.ray
wait    2
run     clear
wait    1
run     rsconvert tmp/old.ray
wait    6

# ---- Viewers
snap

shot    mgif
size    46 80
cap     Inspects a GIF and reports its structure -- image geometry, bit
cap     depth, colour-map size and layout.  Displaying a GIF needs Atari
cap     ST graphics hardware; -i inspects on any terminal.
try     mgif -i gulls.gif
run     builtin cd /dd/DEMO
wait    1
run     clear
wait    1
run     mgif -i gulls.gif
wait    8
snap

