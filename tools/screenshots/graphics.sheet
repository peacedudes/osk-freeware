# The netpbm toolkit and the ray tracer: real images, converted
# by real programs and rendered back to characters so a screen
# can hold them.  pbmtoascii -2x4 maps a 2x4 block of pixels to
# one character, so 152x88 pixels is exactly 76x22 characters.
#
# THE SETUP STANZA COMES FIRST AND MUST STAY FIRST: it makes the three
# test images the rest of the sheet reads.  Sorted alphabetically once, it
# ran fifty stanzas too late and a dozen screens came out as `no such
# path'.  Stanzas run top to bottom in ONE session.

shot    setup-image
for     pgmramp ppmpat pnmfile
cap     The two test images every round trip below starts from: a greyscale
cap     ramp and a woven gingham, both generated on this disk.
try     pnmfile tmp/base.pgm tmp/base.ppm tmp/base.pbm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmramp -lr 48 24 > tmp/base.pgm
wait    5
run     ppmpat -gingham3 48 24 > tmp/base.ppm
wait    5
run     pbmmake -g 48 24 > tmp/base.pbm
wait    5
run     pnmfile tmp/base.pgm tmp/base.ppm tmp/base.pbm
wait    5


shot    ateri
size    30 80
for     ppmtopi1 pi1toppm pi3topbm ppmtopict picttoppm
cap     Atari ST Degas pictures and the Macintosh PICT, out and back.  Both
cap     are paletted formats: Degas PI1 holds sixteen colours and PICT is
cap     written from a colour map, so each refuses a full-colour image and
cap     writes nothing.  Reducing the colours first with `ppmquant 16' is
cap     what they want, and then both convert.
try     ppmquant 16 tmp/at.ppm | ppmtopi1 | pi1toppm | pnmfile
os9     ppmquant 16 tmp/at.ppm ! ppmtopi1 ! pi1toppm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmpat -gingham3 48 24 > tmp/at.ppm
wait    8
run     pbmmake -g 48 24 > tmp/at.pbm
wait    8
run     ppmquant 16 tmp/at.ppm > tmp/q16.ppm
wait    14
run     ppmtopi1 tmp/q16.ppm > tmp/t.pi1
wait    8
run     pi1toppm tmp/t.pi1 | pnmfile
wait    8
run     ppmtopict tmp/q16.ppm > tmp/t.pict
wait    8
run     picttoppm tmp/t.pict | pnmfile
wait    10
run     pbmtopi3 tmp/at.pbm > tmp/t.pi3
wait    8
run     pi3topbm tmp/t.pi3 | pnmfile
wait    10


shot    bmp
for     ppmtobmp bmptoppm
cap     Windows BMP, out and back: ppmtobmp writes the woven test image as a
cap     BMP, bmptoppm reads it in again, and pnmfile confirms the picture
cap     came back the size and depth it went in.
try     ppmtobmp tmp/base.ppm | bmptoppm | pnmfile
os9     ppmtobmp tmp/base.ppm ! bmptoppm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtobmp tmp/base.ppm | bmptoppm | pnmfile
wait    10


shot    fits
for     fitstopnm pnmtoxwd xwdtopnm
cap     FITS, the image format astronomers still use, and the X window dump,
cap     each written from a test image and read straight back.  pnmfile
cap     reports what returned, so the size and type either match or they
cap     do not.
try     pnmtofits tmp/base.pgm | fitstopnm | pnmfile
os9     pnmtofits tmp/base.pgm ! fitstopnm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmtofits tmp/base.pgm | fitstopnm | pnmfile
wait    8
run     pnmtoxwd tmp/base.ppm | xwdtopnm | pnmfile
wait    8


shot    g3
for     g3topbm gemtopbm
cap     Group 3 fax encoding, and the GEM bitmap.  A black-and-white test
cap     image is encoded and decoded again for each, and pnmfile confirms
cap     the bitmap came back as it went in.
try     pbmtog3 tmp/base.pbm | g3topbm | pnmfile
os9     pbmtog3 tmp/base.pbm ! g3topbm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmtog3 tmp/base.pbm | g3topbm | pnmfile
wait    8
run     pbmtogem tmp/base.pbm | gemtopbm | pnmfile
wait    8


shot    gif
for     ppmtogif giftopnm
cap     GIF out and back: ppmtogif writes it, giftopnm reads it, and
cap     pnmfile confirms the picture came back the size it went in.
try     ppmtogif tmp/base.ppm | giftopnm | pnmfile
os9     ppmtogif tmp/base.ppm ! giftopnm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtogif tmp/base.ppm | giftopnm | pnmfile
wait    10


shot    gif2
for     ppmtogif giftopnm ppmquant
cap     GIF written and read back: what `file' makes of the GIF, and what
cap     pnmfile makes of the PPM that came back out of it.
try     file tmp/t.gif
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtogif tmp/base.ppm > tmp/t.gif
wait    8
run     giftopnm tmp/t.gif > tmp/back.ppm
wait    8
run     file tmp/t.gif
wait    5
run     pnmfile tmp/back.ppm
wait    6


shot    giftopnm
cap     A real photograph off the disk -- DEMO/gulls.gif -- decoded by
cap     giftopnm, reduced, dithered and printed as characters.  Every stage
cap     is a separate netpbm program, which is the whole design.
try     giftopnm DEMO/gulls.gif | ppmtopgm | pnmscale -width 152 | pgmtopbm | pbmtoascii
os9     giftopnm DEMO/gulls.gif ! ppmtopgm ! pnmscale -width 152 ! pgmtopbm ! pbmtoascii
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif | ppmtopgm | pnmscale -width 152 | pgmtopbm | pbmtoascii
wait    25


shot    gnuplot
cap     gnuplot 2.0, and the terminals this build knows about -- there is no
cap     `dumb' among them, so it cannot draw a plot on the screen; what it
cap     can do is write PostScript, HP-GL or a printer's own language.  Its
cap     help database is SYS/gnuplot.gih and its demos are in DOC/gnuplot.
try     gnuplot
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gnuplot
wait    8
send    set terminal\r
wait    8
send    set terminal postscript\r
wait    4
send    set output "tmp/plot.ps"\r
wait    4
send    plot [-6:6] sin(x)/x\r
wait    8
quit    quit\r


shot    gulls
for     giftopnm pbmtoascii ppmtopgm
cap     DEMO/gulls.gif, a real photograph, decoded by giftopnm and carried
cap     through five more netpbm programs to arrive as characters: grey,
cap     scaled, normalised, dithered, and mapped two-by-four to a screen.
try     giftopnm DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 | pgmnorm | pgmtopbm | pbmtoascii -2x4
os9     giftopnm DEMO/gulls.gif ! ppmtopgm ! pnmscale -xysize 152 88 ! pgmnorm ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 | pgmnorm | pgmtopbm | pbmtoascii -2x4
wait    30


shot    gulls-invert
for     pnminvert
cap     The photograph inverted -- a negative, made by pnminvert.
try     giftopnm DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 | pgmnorm | pnminvert | pgmtopbm | pbmtoascii -2x4
os9     giftopnm DEMO/gulls.gif ! ppmtopgm ! pnmscale -xysize 152 88 ! pgmnorm ! pnminvert ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 | pgmnorm | pnminvert | pgmtopbm | pbmtoascii -2x4
wait    30


shot    icon
for     icontopbm macptopbm
cap     Sun icon format and MacPaint, out and back.  The test bitmap is
cap     written to each format and read again, with pnmfile reporting what
cap     came back.
try     pbmtoicon tmp/base.pbm | icontopbm | pnmfile
os9     pbmtoicon tmp/base.pbm ! icontopbm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmtoicon tmp/base.pbm | icontopbm | pnmfile
wait    8
run     pbmtomacp tmp/base.pbm | macptopbm | pnmfile
wait    8


shot    ilbm
for     ppmtoilbm ilbmtoppm sgitopnm
cap     Amiga IFF/ILBM and SGI RGB -- two more machines that had their own
cap     idea of a picture file.  ILBM round-trips through a pipe; sgitopnm
cap     reads back a file, since it seeks within it.
try     ppmtoilbm tmp/base.ppm | ilbmtoppm | pnmfile
os9     ppmtoilbm tmp/base.ppm ! ilbmtoppm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtoilbm tmp/base.ppm | ilbmtoppm | pnmfile
wait    10
run     pnmtosgi tmp/base.ppm > tmp/t.sgi
wait    6
run     sgitopnm tmp/t.sgi | pnmfile
wait    8


shot    lispm
for     lispmtopgm pbmtopk pktopbm ppmtomap
cap     A Lisp machine's bitmap format, written by pgmtolispm and read back
cap     by lispmtopgm -- which here rejects what its partner just wrote,
cap     asking to be reconfigured for more grey levels.  ppmtomap, shown
cap     below, turns an image into a colour-map table and works.
try     pgmtolispm tmp/base.pgm | lispmtopgm | pnmfile
os9     pgmtolispm tmp/base.pgm ! lispmtopgm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmtolispm tmp/base.pgm | lispmtopgm | pnmfile
wait    10
run     ppmtomap tmp/base.ppm | head -n 8
wait    8
run     pbmtopk < /nil
wait    10
run     pktopbm < /nil
wait    10


shot    pbmclean
cap     Removes lone pixels from a bitmap.  Run here over threshold-dithered
cap     noise, which is nothing but lone pixels, and shown as text after
cap     the clean: most of the speckle is gone.
try     pbmclean noise.pbm | pbmtoascii -2x4
os9     pbmclean noise.pbm ! pbmtoascii -2x4
run     rm -rf tmp/PBMA
wait    1
run     mkdir -p tmp/PBMA
wait    1
run     builtin cd tmp/PBMA
wait    1
run     pgmnoise 64 32 | pgmtopbm -threshold > noise.pbm
wait    20
run     clear
wait    1
run     pbmclean noise.pbm | pbmtoascii -2x4
wait    30

shot    pbmmask
cap     Makes a mask from a bitmap: every pixel within a set distance of a
cap     black one becomes black, the rest white.  Shown as text over the
cap     same dithered noise.
try     pbmmask noise.pbm | pbmtoascii -2x4
os9     pbmmask noise.pbm ! pbmtoascii -2x4
run     rm -rf tmp/PBMB
wait    1
run     mkdir -p tmp/PBMB
wait    1
run     builtin cd tmp/PBMB
wait    1
run     pgmnoise 64 32 | pgmtopbm -threshold > noise.pbm
wait    20
run     clear
wait    1
run     pbmmask noise.pbm | pbmtoascii -2x4
wait    30

shot    pbmtopgm
cap     Blurs a bitmap into a greyscale by averaging over a window, here a
cap     3-by-3 one.  The result is a greymap; pnmfile reports its size and
cap     that it is now a PGM.
try     pbmtopgm 3 3 noise.pbm | pnmfile
os9     pbmtopgm 3 3 noise.pbm ! pnmfile
run     rm -rf tmp/PBMC
wait    1
run     mkdir -p tmp/PBMC
wait    1
run     builtin cd tmp/PBMC
wait    1
run     pgmnoise 64 32 | pgmtopbm -threshold > noise.pbm
wait    20
run     clear
wait    1
run     pbmtopgm 3 3 noise.pbm | pnmfile
wait    8
run     pbmtopgm 3 3 noise.pbm > blur.pgm
wait    4
run     pnmfile blur.pgm
wait    4

shot    pnmnoraw
cap     Writes the plain-text form of a PBM, PGM or PPM: the same image with
cap     its pixels spelled out as ASCII numbers instead of packed bytes, so
cap     you can read or edit it by hand.
try     pnmnoraw noise.pbm | head -n 4
os9     pnmnoraw noise.pbm ! head -n 4
run     rm -rf tmp/PBMD
wait    1
run     mkdir -p tmp/PBMD
wait    1
run     builtin cd tmp/PBMD
wait    1
run     pgmnoise 40 16 | pgmtopbm -threshold > noise.pbm
wait    15
run     clear
wait    1
run     pnmnoraw noise.pbm | head -n 4
wait    6
wait    30


shot    pbmlife
cap     pbmlife runs Conway's Life one generation on a bitmap -- an image
cap     tool that is also a cellular automaton.
try     pgmnoise 60 30 | pgmtopbm | pbmlife | pbmtoascii
os9     pgmnoise 60 30 ! pgmtopbm ! pbmlife ! pbmtoascii
run     pgmnoise 60 30 | pgmtopbm | pbmlife | pbmtoascii
wait    10


shot    pbmtext
cap     pbmtext sets a line of type as a bitmap; pbmtoascii renders that
cap     bitmap back as characters.  Nothing is drawn by hand.
try     pbmtext "OS-9/68K" | pbmtoascii
os9     pbmtext "OS-9/68K" ! pbmtoascii
run     pbmtext "OS-9/68K" | pbmtoascii
wait    6


shot    pbmtext-big
for     pbmtext pbmpscale
cap     pbmtext sets a line of type, pbmpscale enlarges the bitmap without
cap     the staircase an ordinary scale would give.
try     pbmtext "netpbm" | pbmpscale 2 | pbmtoascii -2x4
os9     pbmtext "netpbm" ! pbmpscale 2 ! pbmtoascii -2x4
run     pbmtext "netpbm" | pbmpscale 2 | pbmtoascii -2x4
wait    12


shot    pbmupc
cap     pbmupc draws a real UPC-A barcode from its digits.  Rendered here
cap     through pbmtoascii, the bar widths are the code.
try     pbmupc 0 72890 00011 | pbmreduce 3 | pbmtoascii
os9     pbmupc 0 72890 00011 ! pbmreduce 3 ! pbmtoascii
run     pbmupc 0 72890 00011 | pbmreduce 3 | pbmtoascii
wait    8


shot    pcx
for     ppmtopcx pcxtoppm
cap     PCX -- the format every DOS paint program wrote.  ppmtopcx writes
cap     the test image, `ls' shows how small the run-length coding made it,
cap     and pcxtoppm reads it back for pnmfile to check.  pcxtoppm seeks in
cap     its input, so it reads a file rather than a pipe.
try     ppmtopcx tmp/base.ppm > tmp/t.pcx
os9     ppmtopcx tmp/base.ppm >tmp/t.pcx
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtopcx tmp/base.ppm > tmp/t.pcx
wait    8
run     ls -l tmp/t.pcx
wait    3
run     pcxtoppm tmp/t.pcx | pnmfile
wait    8


shot    pgmbentley
cap     The Bentley effect: brightness carried by how tall each pixel is.
try     pnmscale -width 150 DEMO/sphere.pgm | pgmbentley | pgmtopbm | pbmtoascii
os9     pnmscale -width 150 DEMO/sphere.pgm ! pgmbentley ! pgmtopbm ! pbmtoascii
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmscale -width 150 DEMO/sphere.pgm | pgmbentley | pgmtopbm | pbmtoascii
wait    15


shot    pgmcrater
cap     pgmcrater drops craters at random and shades them -- a whole moon
cap     out of a random number generator.
try     pgmcrater -number 80 -xsize 152 -ysize 88 | pgmtopbm | pbmtoascii -2x4
os9     pgmcrater -number 80 -xsize 152 -ysize 88 ! pgmtopbm ! pbmtoascii -2x4
run     pgmcrater -number 80 -xsize 152 -ysize 88 | pgmtopbm | pbmtoascii -2x4
wait    30


shot    pgmhist
for     pgmhist pgmramp
cap     pgmramp makes a greyscale ramp and pgmhist counts what is in it --
cap     flat by construction, which is how you know both are right.
try     pgmhist tmp/ramp.pgm | head -n 18
os9     pgmhist tmp/ramp.pgm ! head -n 18
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmramp -lr 64 16 > tmp/ramp.pgm
wait    6
run     pgmhist tmp/ramp.pgm | head -n 18
wait    8


shot    pgmnoise
for     pgmnoise pnmsmooth pnmconvol
cap     pgmnoise makes white noise -- every pixel an independent random
cap     grey, thresholded here to black and white. pnmsmooth would blur it
cap     into cloud, but it is a script that scratches in /r0 and this disk
cap     has no RAM disk; pnmconvol, which does the actual work, is here and
cap     takes a kernel file.
try     pgmnoise 152 88 | pgmtopbm | pbmtoascii -2x4
os9     pgmnoise 152 88 ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmnoise 152 88 | pgmtopbm | pbmtoascii -2x4
wait    20
run     pnmsmooth tmp/base.pgm
wait    10
run     pnmconvol < /nil
wait    8


shot    pgmoil
cap     pgmoil paints the photograph again as if in oils -- each pixel
cap     becomes the commonest value around it.
try     giftopnm DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 | pgmoil | pgmnorm | pgmtopbm | pbmtoascii -2x4
os9     giftopnm DEMO/gulls.gif ! ppmtopgm ! pnmscale -xysize 152 88 ! pgmoil ! pgmnorm ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 | pgmoil | pgmnorm | pgmtopbm | pbmtoascii -2x4
wait    35


shot    pgmramp
size    26 156
cap     A greyscale ramp dithered to a bitmap: the gradient survives as the
cap     density of the characters.
try     pgmramp -lr 152 44 | pgmtopbm | pbmtoascii
os9     pgmramp -lr 152 44 ! pgmtopbm ! pbmtoascii
run     pgmramp -lr 152 44 | pgmtopbm | pbmtoascii
wait    8


shot    pgmtexture
for     pgmtexture pgmkernel pnmhistmap
cap     pgmtexture measures an image the way a pattern-recognition paper
cap     does: angular second moment, contrast, correlation, entropy.  On
cap     the gulls photograph.
try     pgmtexture -d 2 tmp/gg3.pgm | head -n 14
os9     pgmtexture -d 2 tmp/gg3.pgm ! head -n 14
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif | ppmtopgm > tmp/gg2.pgm
wait    30
run     pnmscale -xysize 60 40 tmp/gg2.pgm > tmp/gg3.pgm
wait    20
run     pgmtexture -d 2 tmp/gg3.pgm | head -n 14
wait    60
run     pgmkernel < /nil
wait    10
run     pnmhistmap < /nil
wait    12


shot    plotters
for     pbmtoplot pbmtozinc pbmtogo pbmtoln03 pbmtolps
cap     Six more write-only drivers, for machines that are gone: a Unix
cap     plotter, Zinc, a BBN bitgraph, GraphOn, DEC LN03 and LPS.  All six
cap     are asked for below, one line each.
try     pbmtoplot tmp/base.pbm | wc
os9     pbmtoplot tmp/base.pbm ! wc
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmmake -g 48 24 > tmp/base.pbm
wait    12
run     pbmtoplot tmp/base.pbm | wc
wait    16
run     pbmtozinc tmp/base.pbm | head -n 6
wait    16
run     pbmtoln03 tmp/base.pbm | wc
wait    16
run     pbmtobbnbg tmp/base.pbm | wc
wait    16
run     pbmtogo tmp/base.pbm | wc
wait    16
run     pbmtolps tmp/base.pbm | wc
wait    16


shot    pnmarith
size    36 80
for     pnmarith pnmdepth
cap     pnmarith multiplies two images together, and it insists they be
cap     exactly the same size -- a scaled photograph and a ramp asked for
cap     at the same dimensions are not, because pnmscale keeps the aspect
cap     ratio.  Two ramps, one left-to-right and one top-to-bottom,
cap     multiply into a corner that fades both ways at once.
try     pnmarith -multiply tmp/r2.pgm tmp/r3.pgm | pgmtopbm | pbmtoascii -2x4
os9     pnmarith -multiply tmp/r2.pgm tmp/r3.pgm ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmramp -lr 152 88 > tmp/r2.pgm
wait    8
run     pgmramp -tb 152 88 > tmp/r3.pgm
wait    8
run     pnmarith -multiply tmp/r2.pgm tmp/r3.pgm | pgmtopbm | pbmtoascii -2x4
wait    20
run     pnmdepth < /nil
wait    8


shot    pnmcat
for     pnmcat pnminvert pnmscale
cap     pnmcat puts two images side by side -- the sphere beside its own
cap     negative, made by pnminvert.
try     pnmcat -lr tmp/s.pgm tmp/si.pgm | pgmtopbm | pbmtoascii -2x4
os9     pnmcat -lr tmp/s.pgm tmp/si.pgm ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmscale -xysize 74 88 DEMO/sphere.pgm > tmp/s.pgm
wait    10
run     pnminvert tmp/s.pgm > tmp/si.pgm
wait    6
run     pnmcat -lr tmp/s.pgm tmp/si.pgm | pgmtopbm | pbmtoascii -2x4
wait    12


shot    pnmfile
cap     pnmfile identifies what each intermediate in a pipeline actually is
cap     -- format, dimensions and whether it is raw or plain.
try     pnmfile tmp/ramp.pgm tmp/ramp.pbm tmp/ging.ppm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmramp -lr 40 20 > tmp/ramp.pgm
wait    6
run     pgmtopbm -threshold tmp/ramp.pgm > tmp/ramp.pbm
wait    3
run     ppmpat -gingham2 40 20 > tmp/ging.ppm
wait    3
run     pnmfile tmp/ramp.pgm tmp/ramp.pbm tmp/ging.ppm
wait    4


shot    pnmfile-gulls
for     pnmfile
cap     What each stage of that pipeline actually produced, according to
cap     pnmfile.
try     pnmfile tmp/gulls.ppm tmp/small.ppm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif > tmp/gulls.ppm
wait    12
run     pnmscale -width 300 tmp/gulls.ppm > tmp/small.ppm
wait    12
run     pnmfile tmp/gulls.ppm tmp/small.ppm
wait    5


shot    pnmfile-set
for     pnmfile pnmtile pnmpad
cap     pnmfile identifies each file a pipeline made: format, size, and
cap     whether it is raw or plain.  `pnmpad' takes its margins written
cap     onto the letter -- -l10, not -left 10 -- and prints its usage for
cap     anything else.
try     pnmfile tmp/ramp2.pgm tmp/tile2.pgm tmp/pad2.pgm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmramp -lr 30 16 > tmp/ramp2.pgm
wait    6
run     pnmtile 60 32 tmp/ramp2.pgm > tmp/tile2.pgm
wait    10
run     pnmpad -white -l10 -r10 tmp/tile2.pgm > tmp/pad2.pgm
wait    10
run     pnmfile tmp/ramp2.pgm tmp/tile2.pgm tmp/pad2.pgm
wait    8


shot    pnminvert
cap     The sphere that ships in DEMO, inverted, so the light comes from
cap     the other side.
try     pnmscale -width 152 DEMO/sphere.pgm | pnminvert | pgmtopbm | pbmtoascii
os9     pnmscale -width 152 DEMO/sphere.pgm ! pnminvert ! pgmtopbm ! pbmtoascii
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmscale -width 152 DEMO/sphere.pgm | pnminvert | pgmtopbm | pbmtoascii
wait    15


shot    pnmtile
size    24 156
cap     pnmtile repeats a small image to fill a larger one: here a small
cap     greymap tiled across a wide strip, shown as text.
try     pnmtile 150 40 tmp/t.pgm | pgmtopbm -threshold -value 0.4 | pbmtoascii
os9     pnmtile 150 40 tmp/t.pgm ! pgmtopbm -threshold -value 0.4 ! pbmtoascii
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmscale -width 30 DEMO/sphere.pgm > tmp/t.pgm
wait    8
run     pnmtile 150 40 tmp/t.pgm | pgmtopbm -threshold -value 0.4 | pbmtoascii
wait    12


shot    pnmtops
for     pnmtops
cap     pnmtops writes PostScript around a bitmap -- how an image reached a
cap     printer in 1990.  The head of what it produced.
try     pnmtops tmp/ramp.pgm | head -n 18
os9     pnmtops tmp/ramp.pgm ! head -n 18
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmramp -lr 40 20 > tmp/ramp.pgm
wait    6
run     pnmtops tmp/ramp.pgm | head -n 18
wait    10


shot    ppmdither
size    36 80
for     ppmdither ppmquant ppmtopgm
cap     ppmquant reduces the photograph to sixteen colours and ppmdither
cap     spreads the error -- the two halves of how a picture survived a
cap     screen that had no more colours than that.
try     ppmdither tmp/g16s.ppm | pnmfile
os9     ppmdither tmp/g16s.ppm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif > tmp/g16.ppm
wait    20
run     pnmscale -xysize 152 88 tmp/g16.ppm > tmp/g16s.ppm
wait    20
run     ppmquant 16 tmp/g16s.ppm > tmp/g16q.ppm
wait    20
run     ppmtopgm tmp/g16q.ppm | pgmtopbm | pbmtoascii -2x4
wait    20
run     ppmdither tmp/g16s.ppm | pnmfile
wait    20


shot    ppmforge-clouds
for     ppmforge
cap     The same program asked for clouds only -- no land, all atmosphere.
try     ppmforge -clouds -width 152 -height 88 -seed 3 > tmp/clouds.ppm
os9     ppmforge -clouds -width 152 -height 88 -seed 3 >tmp/clouds.ppm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmforge -clouds -width 152 -height 88 -seed 3 > tmp/clouds.ppm
wait    300
run     ppmtopgm tmp/clouds.ppm | pgmtopbm | pbmtoascii -2x4
wait    60


shot    ppmhist
for     ppmhist ppmpat
cap     ppmpat weaves a pattern and ppmhist counts the colours in it, the
cap     commonest first.
try     ppmhist tmp/t.ppm | head -n 18
os9     ppmhist tmp/t.ppm ! head -n 18
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmpat -tartan 80 40 > tmp/t.ppm
wait    8
run     ppmhist tmp/t.ppm | head -n 18
wait    8


shot    ppmpat
cap     ppmpat weaves a tartan, ppmtopgm greys it and the dither prints it.
try     ppmpat -tartan 152 88 | ppmtopgm | pgmtopbm | pbmtoascii -2x4
os9     ppmpat -tartan 152 88 ! ppmtopgm ! pgmtopbm ! pbmtoascii -2x4
run     ppmpat -tartan 152 88 | ppmtopgm | pgmtopbm | pbmtoascii -2x4
wait    15


shot    ppmpat-madras
for     ppmpat
cap     ppmpat weaves a madras pattern; the same dither renders it.
try     ppmpat -madras 150 44 | ppmtopgm | pgmtopbm | pbmtoascii
os9     ppmpat -madras 150 44 ! ppmtopgm ! pgmtopbm ! pbmtoascii
run     ppmpat -madras 150 44 | ppmtopgm | pgmtopbm | pbmtoascii
wait    12


shot    ppmrelief
cap     ppmrelief embosses an image -- the same sphere lit from the side by
cap     arithmetic rather than by a renderer.
try     pgmtoppm white DEMO/sphere.pgm | ppmrelief | ppmtopgm | pnmscale -width 150 | pgmtopbm | pbmtoascii
os9     pgmtoppm white DEMO/sphere.pgm ! ppmrelief ! ppmtopgm ! pnmscale -width 150 ! pgmtopbm ! pbmtoascii
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmtoppm white DEMO/sphere.pgm | ppmrelief | ppmtopgm | pnmscale -width 150 | pgmtopbm | pbmtoascii
wait    20


shot    printers
for     pbmtolj pbmtoepson pbmto10x pbmtoepsi
cap     The printer drivers: LaserJet, Epson, Star 10x, an EPS preview and
cap     Printronix, each turning the same bitmap into its own language.  Their
cap     sizes are the interesting part -- this is what a page cost.
try     pbmtolj tmp/base.pbm | wc
os9     pbmtolj tmp/base.pbm ! wc
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmtolj tmp/base.pbm | wc
wait    8
run     pbmtoepson tmp/base.pbm | wc
wait    8
run     pbmto10x tmp/base.pbm | wc
wait    8
run     pbmtoepsi tmp/base.pbm | head -n 10
wait    8
run     pbmtoptx tmp/base.pbm | wc
wait    8


shot    rayshade
cap     Rayshade 4.0 rendering a scene on a 68000 and reporting what it
cap     did -- primitives, eye and shadow rays, cache hits, and the time
cap     it took.  It preprocesses each scene through `cccp' by way of
cap     popen(), which runs it with `shell' -- your own OS-9's, which
cap     SYS/login loads from /h1 -- so both are loaded first; the cccp
cap     here is the one GCC 1.39 brings.
try     rayshade -R 32 24 -O tmp/out.pic GAMES/rayshade/boxball.ray
run     load /h1/CMDS/shell
wait    3
run     load /dd/CMDS/GCC139/gcc_cccp
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rayshade -R 32 24 -O tmp/out.pic GAMES/rayshade/boxball.ray
wait    45

shot    sphere
size    36 80
for     pgmtopbm pnmscale
cap     DEMO/sphere.pgm, a rendered sphere, dithered the same way.  The
cap     gradient across it is carried entirely by the dither pattern.
try     pgmtopbm tmp/sph.pgm | pbmtoascii -2x4
os9     pgmtopbm tmp/sph.pgm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmscale -xysize 152 88 DEMO/sphere.pgm > tmp/sph.pgm
wait    10
run     pgmtopbm tmp/sph.pgm | pbmtoascii -2x4
wait    15


shot    tga
for     ppmtotga tgatoppm
cap     Targa, and the Sun raster format beside it.  The test image goes out
cap     to each and comes straight back, with pnmfile confirming what
cap     returned.
try     ppmtotga tmp/base.ppm | tgatoppm | pnmfile
os9     ppmtotga tmp/base.ppm ! tgatoppm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtotga tmp/base.ppm | tgatoppm | pnmfile
wait    10
run     pnmtorast tmp/base.ppm | rasttopnm | pnmfile
wait    10


shot    tiffish
for     ppmtopj pjtoppm ppmtopjxl
cap     HP PaintJet, out and back, and two write-only drivers beside it --
cap     ppmtopjxl and ppmtoacad have no reader here, which is the shape of
cap     half this toolkit: much of it was written to feed devices, not to
cap     read their files back.
try     ppmtopj tmp/base.ppm | pjtoppm | pnmfile
os9     ppmtopj tmp/base.ppm ! pjtoppm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtopj tmp/base.ppm | pjtoppm | pnmfile
wait    10
run     ppmtopjxl tmp/base.ppm | wc
wait    8
run     ppmtoacad < /nil
wait    8


shot    workstations
for     pbmtomgr mgrtopbm pbmtoatk atktopbm pbmtocmuwm cmuwmtopbm
cap     Three workstation bitmap formats of the late eighties -- MGR, the
cap     Andrew Toolkit, and CMU's window manager -- each with its reader.
try     pbmtomgr tmp/base.pbm | mgrtopbm | pnmfile
os9     pbmtomgr tmp/base.pbm ! mgrtopbm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmtomgr tmp/base.pbm | mgrtopbm | pnmfile
wait    10
run     pbmtoatk tmp/base.pbm | atktopbm | pnmfile
wait    10
run     pbmtocmuwm tmp/base.pbm | cmuwmtopbm | pnmfile
wait    10


shot    xbm
for     xbmtopbm pbmtoybm ybmtopbm
cap     X bitmaps and Bennet Yee bitmaps: two of the eleven bitmap formats
cap     this toolkit reads.  Each is written from the test bitmap and read
cap     back, with pnmfile checking what returned.
try     pbmtoxbm tmp/base.pbm | xbmtopbm | pnmfile
os9     pbmtoxbm tmp/base.pbm ! xbmtopbm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmtoxbm tmp/base.pbm | xbmtopbm | pnmfile
wait    8
run     pbmtoybm tmp/base.pbm | ybmtopbm | pnmfile
wait    8


shot    xpm
size    30 80
for     ppmtoxpm xpmtoppm ppmtopuzz
cap     The X pixmap is C source with the image in it -- here is the head of
cap     one this disk just wrote, and the round trip back.  Both `ppmtoxpm'
cap     and `ppmtopuzz' work from a colour map and refuse a full 24-bit
cap     image, writing nothing; reducing the colours with `ppmquant 16'
cap     first is what they want.
try     ppmtoxpm tmp/qx.ppm | head -n 10
os9     ppmtoxpm tmp/qx.ppm ! head -n 10
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmpat -gingham3 48 24 > tmp/xp.ppm
wait    8
run     ppmquant 16 tmp/xp.ppm > tmp/qx.ppm
wait    14
run     ppmtoxpm tmp/qx.ppm > tmp/t.xpm
wait    8
run     head -n 10 tmp/t.xpm
wait    5
run     xpmtoppm tmp/t.xpm | pnmfile
wait    8
run     ppmtopuzz tmp/qx.ppm > tmp/t.puzz
wait    8
run     wc -c tmp/t.puzz
wait    6


shot    yuv
for     ppmtoyuv yuvtoppm yuvsplittoppm ppmtorgb3 rgb3toppm
cap     Video colour spaces: YUV as one stream and as three planes, and
cap     RGB split into three files -- ppmtorgb3 names them after the input
cap     and writes them beside it, so base.ppm becomes base.red, base.grn
cap     and base.blu, and rgb3toppm puts them back together.
try     ppmtoyuv tmp/base.ppm | yuvtoppm 48 24 | pnmfile
os9     ppmtoyuv tmp/base.ppm ! yuvtoppm 48 24 ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtoyuv tmp/base.ppm | yuvtoppm 48 24 | pnmfile
wait    10
run     ppmtorgb3 tmp/base.ppm; ls -l tmp/base.red tmp/base.grn tmp/base.blu
wait    12
run     rgb3toppm tmp/base.red tmp/base.grn tmp/base.blu | pnmfile
wait    10
run     ppmtoyuvsplit < /nil
wait    10
run     yuvsplittoppm < /nil
wait    10


shot    noreader
for     bioradtopgm hipstopgm qrttoppm sldtoppm spctoppm zeisstopnm
for     brushtopbm gouldtoppm hpcdtoppm imgtoppm mtvtoppm psidtopgm
for     spottopgm sputoppm ximtoppm xvminitoppm
cap     Sixteen of the readers here decode formats that no file on this disk
cap     is in -- confocal microscopes, ray tracers, AutoCAD slides, Atari
cap     Spectrum pictures, Photo CD, Amiga brushes, Gould scanners.  Handed
cap     something else, most say so rather than guessing -- sputoppm, which
cap     trusts its fixed 320x200 size, writes a header without complaint.  Three of the sixteen are shown; the rest answer
cap     the same way -- and the four that had never been asked at all are
cap     asked below so that "the rest answer the same way" is shown rather
cap     than assumed.
try     hipstopgm tmp/nr.ppm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmmake red 16 16 > tmp/nr.ppm
wait    8
run     hipstopgm tmp/nr.ppm
wait    18
run     qrttoppm tmp/nr.ppm | head -n 3
wait    18
run     spottopgm tmp/nr.ppm
wait    16
run     sputoppm tmp/nr.ppm
wait    16
run     ximtoppm tmp/nr.ppm
wait    16
run     xvminitoppm tmp/nr.ppm
wait    16
run     zeisstopnm tmp/nr.ppm
wait    18


shot    pnmfilters
for     pnmalias pnmcomp pnmnlfilt ppmdist ppmflash
cap     Five more netpbm filters run over the same photograph, with pnmfile
cap     confirming each one produced an image: antialiasing, compositing, a
cap     non-linear filter, a distance transform and a flash.
try     pnmnlfilt 1.0 0.5 tmp/w.ppm | pnmfile
os9     pnmnlfilt 1.0 0.5 tmp/w.ppm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif | pnmscale -xysize 76 44 > tmp/w.ppm
wait    75
run     pnmnlfilt 1.0 0.5 tmp/w.ppm | pnmfile
wait    45
run     ppmflash 0.4 tmp/w.ppm | pnmfile
wait    35
run     ppmquant 256 tmp/w.ppm | ppmdist | pnmfile
wait    45
run     pnmalias tmp/w.ppm | pnmfile
wait    35
run     pnmcomp tmp/w.ppm tmp/w.ppm | pnmfile
wait    35


shot    ppmntsc
for     ppmntsc ppmqvga pnmtorast rasttopnm
cap     ppmntsc clamps an image to what NTSC could actually transmit and
cap     ppmqvga to a 320x240 palette; Sun raster goes out and comes back,
cap     which is the check that the pair agree.
try     ppmntsc 0.8 tmp/n.ppm | pnmfile
os9     ppmntsc 0.8 tmp/n.ppm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmpat -madras 64 40 > tmp/n.ppm
wait    10
run     ppmntsc 0.8 tmp/n.ppm | pnmfile
wait    15
run     ppmqvga tmp/n.ppm | pnmfile
wait    15
run     pnmtorast tmp/n.ppm > tmp/w.ras
wait    10
run     rasttopnm tmp/w.ras | pnmfile
wait    12
run     pnmtoddif < /nil
wait    8


shot    sir
for     pnmtosir sirtopnm
cap     Solitaire Image Recorder format, out and back.  An 8x4 red image
cap     goes to SIR and returns byte for byte.  Until 2026 it did not: the
cap     reader skipped one short too few of the 1536-short header and every
cap     colour plane came back shifted two bytes.  One loop bound, in
cap     SRC/netpbm/PNM.
try     sirtopnm tmp/red.sir | pnmnoraw | head -n 6
os9     sirtopnm tmp/red.sir ! pnmnoraw ! head -n 6
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmmake rgb:ff/00/00 8 4 > tmp/red.ppm
wait    10
run     pnmtosir tmp/red.ppm > tmp/red.sir
wait    10
run     sirtopnm tmp/red.sir | pnmnoraw | head -n 6
wait    12


shot    writeonly
for     ppmtoicr ppmtouil pbmto4425 pbmtox10bm
cap     Six drivers with no reader here, for machines that are gone: an NCR
cap     terminal, a Mitsubishi dye-sublimation printer, DEC sixel, Motif UIL
cap     source, an AT&T 4425 and an X10 bitmap.  The four colour ones are
cap     given the same picture and counted in bytes -- what a page cost;
cap     the two bitmap ones get a grey pattern, and the X10 one is shown as
cap     the C source it writes.
try     ppmtosixel tmp/q.ppm | wc
os9     ppmtosixel tmp/q.ppm ! wc
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmpat -madras 64 40 > tmp/wo.ppm
wait    8
run     ppmquant 256 tmp/wo.ppm > tmp/q.ppm
wait    20
run     ppmtosixel tmp/q.ppm | wc
wait    20
run     ppmtomitsu tmp/q.ppm | wc
wait    20
run     ppmtoicr tmp/q.ppm | wc
wait    20
run     ppmtouil tmp/q.ppm | wc
wait    20
run     pbmmake -g 40 20 | pbmto4425 | wc
wait    15
run     pbmmake -g 40 20 | pbmtox10bm | head -n 6
wait    15

# ---- JPEG: the IJG codec and its comment tools, one card each.  The .070
# ---- files are alternate-processor builds, run beside their 68000 twins.


shot    cjpeg
size    24 80
cap     Makes a JPEG from a PNM.  cjpeg wants LF between the fields of a
cap     PNM header where the netpbm here writes CR, so the three `pbyte'
cap     calls patch those separators first; then a 3,469-byte image
cap     compresses to under a kilobyte.
try     cjpeg -quality 50 tmp/GFXA/j.ppm > tmp/GFXA/j.jpg
os9     cjpeg -quality 50 tmp/GFXA/j.ppm >tmp/GFXA/j.jpg
run     mkdir -p /dd/tmp/GFXA > /nil 2>/nil; ppmpat -gingham3 48 24 > /dd/tmp/GFXA/j.ppm; pbyte /dd/tmp/GFXA/j.ppm 2 0a; pbyte /dd/tmp/GFXA/j.ppm 8 0a; pbyte /dd/tmp/GFXA/j.ppm c 0a
wait    6
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cjpeg -quality 50 tmp/GFXA/j.ppm > tmp/GFXA/j.jpg
wait    15
run     ls -l tmp/GFXA/j.ppm tmp/GFXA/j.jpg
wait    5


shot    djpeg
size    36 164
cap     The JPEG library's own test image, decoded by djpeg and drawn as
cap     ASCII by netpbm.  djpeg ends its PNM header lines with LF and the
cap     netpbm here wants CR, so the three `pbyte' calls patch those
cap     separators before the picture is piped on.
try     djpeg -pnm SRC/jpeglib/JPEG_5A/testimg.jpg > tmp/dj.ppm
os9     djpeg -pnm SRC/jpeglib/JPEG_5A/testimg.jpg >tmp/dj.ppm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     djpeg -pnm SRC/jpeglib/JPEG_5A/testimg.jpg > tmp/dj.ppm
wait    50
run     pbyte tmp/dj.ppm 2 0d
wait    4
run     pbyte tmp/dj.ppm a 0d
wait    4
run     pbyte tmp/dj.ppm e 0d
wait    4
run     ppmtopgm tmp/dj.ppm | pgmtopbm | pbmtoascii -2x4
wait    35


shot    djpeg.070
size    24 80
cap     djpeg.070, a build for another processor, decoding the JPEG the
cap     68000 cjpeg has just written -- an 869-byte JPEG back to the full
cap     3,469-byte PNM it came from.
try     djpeg.070 -pnm tmp/GFXA/j.jpg > tmp/GFXA/d70.ppm
os9     djpeg.070 -pnm tmp/GFXA/j.jpg >tmp/GFXA/d70.ppm
run     mkdir -p /dd/tmp/GFXA > /nil 2>/nil; ppmpat -gingham3 48 24 > /dd/tmp/GFXA/j.ppm; pbyte /dd/tmp/GFXA/j.ppm 2 0a; pbyte /dd/tmp/GFXA/j.ppm 8 0a; pbyte /dd/tmp/GFXA/j.ppm c 0a; cjpeg -quality 50 /dd/tmp/GFXA/j.ppm > /dd/tmp/GFXA/j.jpg
wait    15
run     builtin cd /dd
wait    1
run     clear
wait    1
run     djpeg.070 -pnm tmp/GFXA/j.jpg > tmp/GFXA/d70.ppm
wait    12
run     ls -l tmp/GFXA/j.jpg tmp/GFXA/d70.ppm
wait    5


shot    cjpeg.070
cap     cjpeg.070 is the encoder from that other-processor set, and it
cap     does not run here: handed the same PNM its 68000 twin compresses,
cap     it answers `Premature end of input file' and writes nothing.
try     cjpeg.070 -quality 50 tmp/GFXA/j.ppm > tmp/GFXA/x.jpg
os9     cjpeg.070 -quality 50 tmp/GFXA/j.ppm >tmp/GFXA/x.jpg
run     mkdir -p /dd/tmp/GFXA > /nil 2>/nil; ppmpat -gingham3 48 24 > /dd/tmp/GFXA/j.ppm; pbyte /dd/tmp/GFXA/j.ppm 2 0a; pbyte /dd/tmp/GFXA/j.ppm 8 0a; pbyte /dd/tmp/GFXA/j.ppm c 0a
wait    6
run     builtin cd /dd
wait    1
run     clear
wait    1
run     cjpeg.070 -quality 50 tmp/GFXA/j.ppm > tmp/GFXA/x.jpg
wait    10


shot    rdjpgcom
cap     Prints the comment stored in a JPEG.  A comment is written into a
cap     JPEG with wrjpgcom and rdjpgcom reads it back.
try     rdjpgcom tmp/GFXA/jc.jpg
run     mkdir -p /dd/tmp/GFXA > /nil 2>/nil; ppmpat -gingham3 48 24 > /dd/tmp/GFXA/j.ppm; pbyte /dd/tmp/GFXA/j.ppm 2 0a; pbyte /dd/tmp/GFXA/j.ppm 8 0a; pbyte /dd/tmp/GFXA/j.ppm c 0a; cjpeg -quality 50 /dd/tmp/GFXA/j.ppm > /dd/tmp/GFXA/j.jpg; wrjpgcom -comment "OS-9 freeware disk" /dd/tmp/GFXA/j.jpg > /dd/tmp/GFXA/jc.jpg
wait    16
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rdjpgcom tmp/GFXA/jc.jpg; echo ""
wait    6
snap


shot    wrjpgcom
cap     Writes a comment into a JPEG.  The comment is written into a copy,
cap     then rdjpgcom reads it back to show it is there.
try     wrjpgcom -comment "OS-9 freeware disk" tmp/GFXA/j.jpg > tmp/GFXA/jc.jpg
os9     wrjpgcom -comment "OS-9 freeware disk" tmp/GFXA/j.jpg >tmp/GFXA/jc.jpg
run     mkdir -p /dd/tmp/GFXA > /nil 2>/nil; ppmpat -gingham3 48 24 > /dd/tmp/GFXA/j.ppm; pbyte /dd/tmp/GFXA/j.ppm 2 0a; pbyte /dd/tmp/GFXA/j.ppm 8 0a; pbyte /dd/tmp/GFXA/j.ppm c 0a; cjpeg -quality 50 /dd/tmp/GFXA/j.ppm > /dd/tmp/GFXA/j.jpg
wait    16
run     builtin cd /dd
wait    1
run     clear
wait    1
run     wrjpgcom -comment "OS-9 freeware disk" tmp/GFXA/j.jpg > tmp/GFXA/jc.jpg
wait    8
run     rdjpgcom tmp/GFXA/jc.jpg; echo ""
wait    6
snap


shot    wrjpgcom.070
cap     wrjpgcom.070, the comment writer from the other-processor set,
cap     works here: it writes a comment into a JPEG and rdjpgcom.070
cap     reads it back.
try     wrjpgcom.070 -comment "IJG 0.70 build" tmp/GFXA/j.jpg > tmp/GFXA/jc7.jpg
os9     wrjpgcom.070 -comment "IJG 0.70 build" tmp/GFXA/j.jpg >tmp/GFXA/jc7.jpg
run     mkdir -p /dd/tmp/GFXA > /nil 2>/nil; ppmpat -gingham3 48 24 > /dd/tmp/GFXA/j.ppm; pbyte /dd/tmp/GFXA/j.ppm 2 0a; pbyte /dd/tmp/GFXA/j.ppm 8 0a; pbyte /dd/tmp/GFXA/j.ppm c 0a; cjpeg -quality 50 /dd/tmp/GFXA/j.ppm > /dd/tmp/GFXA/j.jpg
wait    16
run     builtin cd /dd
wait    1
run     clear
wait    1
run     wrjpgcom.070 -comment "IJG 0.70 build" tmp/GFXA/j.jpg > tmp/GFXA/jc7.jpg
wait    8
run     rdjpgcom.070 tmp/GFXA/jc7.jpg; echo ""
wait    6
snap


shot    rdjpgcom.070
cap     rdjpgcom.070 reads a JPEG's comment, the reader from the
cap     other-processor set; the comment is written with wrjpgcom.070 and
cap     read back here.
try     rdjpgcom.070 tmp/GFXA/jc7.jpg
run     mkdir -p /dd/tmp/GFXA > /nil 2>/nil; ppmpat -gingham3 48 24 > /dd/tmp/GFXA/j.ppm; pbyte /dd/tmp/GFXA/j.ppm 2 0a; pbyte /dd/tmp/GFXA/j.ppm 8 0a; pbyte /dd/tmp/GFXA/j.ppm c 0a; cjpeg -quality 50 /dd/tmp/GFXA/j.ppm > /dd/tmp/GFXA/j.jpg; wrjpgcom.070 -comment "IJG 0.70 build" /dd/tmp/GFXA/j.jpg > /dd/tmp/GFXA/jc7.jpg
wait    16
run     builtin cd /dd
wait    1
run     clear
wait    1
run     rdjpgcom.070 tmp/GFXA/jc7.jpg; echo ""
wait    6

# ---- The Atari GRAPH library set.  Each program calls the Graph trap
# ---- library, which executes in supervisor state; started from the shell
# ---- it is entered and aborts.  wgen is the one that runs interactively.
snap


shot    graph
cap     The Graph trap library itself -- a type-$0B module, not a program.
cap     It is what g, striche, apfel, sine, showpic, graphdemo, graphsave
cap     and wgen all call.  modinfo shows what it is: a trap handler
cap     library marked to execute in supervisor state.
try     modinfo graph | head -n 14
os9     modinfo graph ! head -n 14
run     builtin cd /dd/CMDS/GAMES
wait    1
run     clear
wait    1
run     modinfo graph | head -n 14
wait    8
snap


shot    g
cap     An Atari GRAPH demo, paired with striche.  With the Graph trap
cap     library resident it is entered and aborts on a supervisor-only
cap     instruction: it was written to run in supervisor state, which a
cap     program started from the shell is not.
try     g
run     load /dd/CMDS/GAMES/graph
wait    4
run     clear
wait    1
run     g
wait    6
snap


shot    striche
cap     Line drawing for the Atari GRAPH display.  With the Graph trap
cap     library resident it is entered and aborts on a supervisor-only
cap     instruction: it was written to run in supervisor state.
try     striche
run     load /dd/CMDS/GAMES/graph
wait    4
run     clear
wait    1
run     striche
wait    6
snap


shot    apfel
cap     The Mandelbrot set for the Atari GRAPH display.  With the Graph
cap     trap library resident it is entered and aborts on a supervisor-only
cap     instruction: it was written to run in supervisor state.
try     apfel
run     load /dd/CMDS/GAMES/graph
wait    4
run     clear
wait    1
run     apfel
wait    6
snap


shot    sine
cap     A sine plot for the Atari GRAPH display.  With the Graph trap
cap     library resident it is entered and aborts on a supervisor-only
cap     instruction: it was written to run in supervisor state.
try     sine
run     load /dd/CMDS/GAMES/graph
wait    4
run     clear
wait    1
run     sine
wait    6
snap


shot    graphdemo
cap     An Atari GRAPH demonstration.  With the Graph trap library
cap     resident it is entered and aborts on a supervisor-only
cap     instruction: it was written to run in supervisor state.
try     graphdemo
run     load /dd/CMDS/GAMES/graph
wait    4
run     clear
wait    1
run     graphdemo
wait    6
snap


shot    graphsave
cap     Saves an Atari GRAPH screen.  With the Graph trap library resident
cap     it is entered and aborts on a supervisor-only instruction: it was
cap     written to run in supervisor state, and it wants the display.
try     graphsave
run     load /dd/CMDS/GAMES/graph
wait    4
run     clear
wait    1
run     graphsave
wait    6
snap


shot    showpic
cap     Shows a picture on the Atari GRAPH display.  With the Graph trap
cap     library resident it is entered and aborts on a supervisor-only
cap     instruction: it wants the display, not just the library.
try     showpic
run     load /dd/CMDS/GAMES/graph
wait    4
run     clear
wait    1
run     showpic
wait    6
snap


shot    wgen
cap     A Tektronix waveform generator: it asks for a resolution and then
cap     the intensity of each harmonic, and given those it emits Tektronix
cap     plotting codes, for which there is no Tektronix terminal here.
try     wgen
run     clear
wait    1
run     wgen
wait    5
send    256\r
wait    2
send    150\r75\r40\r20\r10\r
wait    6

# ---- Drawing & display
snap


shot    loadmem
super
cap     Copies a file into memory at an address you give: destination,
cap     upper limit, path, the addresses in hex.  Super user only, and it
cap     says nothing at all when it works -- so its counterpart `savemem'
cap     reads the same address straight back here, and there the file is.
try     loadmem 8000 80FF m.txt
run     rm -rf /dd/tmp/MEML > /nil 2>/nil; mkdir -p /dd/tmp/MEML
wait    3
run     builtin cd /dd/tmp/MEML
wait    1
run     cp /dd/SYS/motd m.txt
wait    3
run     clear
wait    1
run     loadmem 8000 80FF m.txt
wait    4
run     savemem 8000 8027 back.bin
wait    4
run     dump back.bin
wait    4


shot    savemem
super
cap     Writes a block of memory out to a file: from address, to address,
cap     path, in hex and the range inclusive -- 8000 to 8027 is 40 bytes.
cap     Its counterpart `loadmem' put the text there first, so there is
cap     something to recognise coming back.  Super user only, and the file
cap     it writes must not already exist: handed one that does, it prints
cap     its syntax rather than overwriting.
try     savemem 8000 8027 back.bin
run     rm -rf /dd/tmp/MEMS > /nil 2>/nil; mkdir -p /dd/tmp/MEMS
wait    3
run     builtin cd /dd/tmp/MEMS
wait    1
run     cp /dd/SYS/motd m.txt
wait    3
run     loadmem 8000 80FF m.txt
wait    4
run     clear
wait    1
run     savemem 8000 8027 back.bin
wait    4
run     dump back.bin
wait    4


shot    snap
cap     Writes a snapshot of the terminal screen to a file (polaroid if
cap     none is named).  It drives a set of specific hardware terminals,
cap     listed by -l, and does not recognise this console.
try     snap -l
run     snap
wait    5
run     snap -l
wait    5
snap


shot    pdraw
size    30 80
cap     Pdraw 1.4 plots 3D x-y-z data as PostScript.  It reads the options
cap     file first and prints every setting it took from it, then asks
cap     before sending the plot on; RETURN there and it writes the
cap     PostScript and says so.  The file it leaves is `dataplot.ps', 138
cap     KB of it for this three-curve sample.
try     pdraw -o options curves.plot
run     rm -rf /dd/tmp/PDA > /nil 2>/nil; mkdir -p /dd/tmp/PDA
wait    2
run     cat /dd/DOC/pdraw/options > /dd/tmp/PDA/options; cat /dd/DOC/pdraw/curves.plot > /dd/tmp/PDA/curves.plot
wait    3
run     builtin cd /dd/tmp/PDA
wait    1
run     clear
wait    1
run     pdraw -o options curves.plot
wait    12
send    \r
wait    10
run     ls -l dataplot.ps
wait    4

# ---- X11 clients
snap


shot    basicwin
cap     The classic X11 basic-window demo.  There is no X server here, so it
cap     stops at "cannot connect to X server"; with an X display it opens a
cap     window and draws into it.
try     basicwin
run     basicwin; echo ""
wait    8
snap

shot    xengine
cap     An X11 demo that animates a running engine.  There is no X display
cap     here, so it stops at "Can't open display"; with one it draws the
cap     engine and runs it.
try     xengine
run     xengine; echo ""
wait    8
snap

shot    X11R6shl
cap     The X11R6 shared-library loader -- a type-$0B trap library, not a
cap     program.  modinfo shows what it is; asking a shell to run it can
cap     only produce a refusal, which says nothing about the library.
try     modinfo X11R6shl | head -n 14
os9     modinfo X11R6shl ! head -n 14
run     builtin cd /dd
wait    1
run     clear
wait    1
run     modinfo X11R6shl | head -n 14
wait    8
snap

# ---- Plotting
snap

shot    tplot
cap     Plots columns of numbers from a file or standard input.  It asks
cap     for the x and y intervals, two numbers each, and then the x and y
cap     divisions, and draws through the Atari ST's A-line graphics traps --
cap     a machine with those is what it needs to finish the plot.
try     tplot
run     tplot
wait    5
send    0 10\r
wait    3
send    0 5\r
wait    3
kill

# ---- Ray tracing helper

shot    rsconvert
cap     Converts a scene file written for rayshade 3 into rayshade 4's
cap     syntax, a statement to a line, ready for rayshade to render.  Name
cap     the old file, or give it on standard input.
try     rsconvert tmp/old.ray
run     builtin cd /dd
wait    1
run     echo 'screen 32 24' > tmp/old.ray; echo 'light 1 directional 0 0 1' >> tmp/old.ray
wait    2
run     clear
wait    1
run     rsconvert tmp/old.ray
wait    6

# ---- Viewers
snap

shot    mgif
size    46 80
cap     Inspects a GIF and reports its structure -- image geometry, bit
cap     depth, colour-map size and layout.  Displaying a GIF needs Atari
cap     ST graphics hardware; -i inspects on any terminal.
try     mgif -i gulls.gif
run     builtin cd /dd/DEMO
wait    1
run     clear
wait    1
run     mgif -i gulls.gif
wait    8
snap

