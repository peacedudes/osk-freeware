# The netpbm toolkit and the ray tracer: real images, converted
# by real programs and rendered back to characters so a screen
# can hold them.  pbmtoascii -2x4 maps a 2x4 block of pixels to
# one character, so 152x88 pixels is exactly 76x22 characters.
#
# THE SETUP STANZA COMES FIRST AND MUST STAY FIRST: it makes the three
# test images the rest of the sheet reads.  Sorted alphabetically once, it
# ran fifty stanzas too late and a dozen screens came out as `no such
# path'.  Stanzas run top to bottom in ONE session.

shot    setup-image
for     pgmramp ppmpat pnmfile
cap     The two test images every round trip below starts from: a greyscale
cap     ramp and a woven gingham, both generated on this disk.
run     pgmramp -lr 48 24 > /dd/tmp/base.pgm
wait    5
run     ppmpat -gingham3 48 24 > /dd/tmp/base.ppm
wait    5
run     pbmmake -g 48 24 > /dd/tmp/base.pbm
wait    5
run     pnmfile /dd/tmp/base.pgm /dd/tmp/base.ppm /dd/tmp/base.pbm
wait    5

shot    asciitopgm
for     asciitopgm ppmtopgm pgmtoppm
cap     asciitopgm goes the other way -- characters IN, a greyscale image
cap     out, each character weighted by how much ink it has.  Here it reads
cap     back the ASCII art pbmtoascii just wrote, and pnmfile confirms a
cap     60x8 PGM came out of it.
run     pbmtext "netpbm" | pbmtoascii > /dd/tmp/art.txt
wait    12
run     asciitopgm 8 60 < /dd/tmp/art.txt | pnmfile
wait    12

shot    ateri
for     ppmtopi1 pi1toppm pbmtopi3 pi3topbm ppmtopict picttoppm
cap     Atari ST Degas pictures, and the Macintosh PICT, out and back.
run     ppmtopi1 /dd/tmp/base.ppm > /dd/tmp/t.pi1
wait    8
run     pi1toppm /dd/tmp/t.pi1 | pnmfile
wait    8
run     pbmtopi3 /dd/tmp/base.pbm | pi3topbm | pnmfile
wait    10

shot    bmp
for     ppmtobmp bmptoppm
cap     Windows BMP, the same way round.
run     ppmtobmp /dd/tmp/base.ppm > /dd/tmp/t.bmp
wait    8
run     bmptoppm /dd/tmp/t.bmp > /dd/tmp/back2.ppm
wait    8
run     ls -l /dd/tmp/t.bmp
wait    3
run     pnmfile /dd/tmp/back2.ppm
wait    6

shot    djpeg
size    36 80
for     djpeg rdjpgcom.070 wrjpgcom.070
cap     The JPEG library's own test image, decoded by djpeg and drawn as
cap     ASCII by netpbm.  TWO things had to be fixed to get this picture.
cap     The JPEG on the disk was corrupt -- an `iconv //TRANSLIT' pass had
cap     turned every byte over 0x7f into `?' -- and djpeg rightly said `Not
cap     a JPEG file'; it and nine other binaries were restored from the
cap     archives they came from.  Then djpeg's output would not pipe:
cap     djpeg ends its PNM header lines with LF, and every netpbm tool
cap     here wants CR, so ppmtopgm answered `junk in file where an integer
cap     should be'.  The three `pbyte' calls below patch those three bytes
cap     -- offsets 2, A and E of a P6 header -- and the pipeline runs.
run     djpeg -pnm /dd/SRC/jpeglib/JPEG_5A/testimg.jpg > /dd/tmp/dj.ppm
wait    50
run     pbyte /dd/tmp/dj.ppm 2 0d
wait    4
run     pbyte /dd/tmp/dj.ppm a 0d
wait    4
run     pbyte /dd/tmp/dj.ppm e 0d
wait    4
run     ppmtopgm /dd/tmp/dj.ppm | pgmtopbm | pbmtoascii -2x4
wait    35
run     rdjpgcom.070 /dd/SRC/jpeglib/JPEG_5A/testimg.jpg
wait    10
run     wrjpgcom.070 -comment hello /dd/SRC/jpeglib/JPEG_5A/testimg.jpg > /nil
wait    12
shot    fits
for     pnmtofits fitstopnm pnmtoxwd xwdtopnm
cap     FITS, which astronomers still use, and the X window dump.
run     pnmtofits /dd/tmp/base.pgm > /dd/tmp/t.fits
wait    6
run     fitstopnm /dd/tmp/t.fits | pnmfile
wait    8
run     pnmtoxwd /dd/tmp/base.ppm > /dd/tmp/t.xwd
wait    6
run     xwdtopnm /dd/tmp/t.xwd | pnmfile
wait    8

shot    g3
for     pbmtog3 g3topbm pbmtogem gemtopbm
cap     Group 3 fax encoding, and the GEM bitmap.
run     pbmtog3 /dd/tmp/base.pbm > /dd/tmp/t.g3
wait    6
run     g3topbm /dd/tmp/t.g3 | pnmfile
wait    8
run     pbmtogem /dd/tmp/base.pbm > /dd/tmp/t.gem
wait    6
run     gemtopbm /dd/tmp/t.gem | pnmfile
wait    8

shot    gif
for     ppmtogif giftopnm
cap     GIF out and back: ppmtogif writes it, giftopnm reads it, and
cap     pnmfile confirms the picture came back the size it went in.
run     ppmtogif /dd/tmp/base.ppm > /dd/tmp/t.gif
wait    8
run     giftopnm /dd/tmp/t.gif > /dd/tmp/back.ppm
wait    8
run     ls -l /dd/tmp/t.gif
wait    3
run     pnmfile /dd/tmp/base.ppm /dd/tmp/back.ppm
wait    6

shot    gif2
for     ppmtogif giftopnm ppmquant
cap     GIF written and read back: what `file' makes of the GIF, and what
cap     pnmfile makes of the PPM that came back out of it.
run     ppmtogif /dd/tmp/base.ppm > /dd/tmp/t.gif
wait    8
run     giftopnm /dd/tmp/t.gif > /dd/tmp/back.ppm
wait    8
run     file /dd/tmp/t.gif
wait    5
run     pnmfile /dd/tmp/back.ppm
wait    6

shot    giftopnm
cap     A real photograph off the disk -- DEMO/gulls.gif -- decoded by
cap     giftopnm, reduced, dithered and printed as characters.  Every stage
cap     is a separate netpbm program, which is the whole design.
run     giftopnm /dd/DEMO/gulls.gif | ppmtopgm | pnmscale -width 152 | pgmtopbm | pbmtoascii
wait    25

shot    gnuplot
cap     gnuplot 2.0, and the terminals this build knows about -- there is no
cap     `dumb' among them, so it cannot draw a plot on the screen; what it
cap     can do is write PostScript, HP-GL or a printer's own language.  Its
cap     help database is SYS/gnuplot.gih and its demos are in DOC/gnuplot.
run     gnuplot
wait    8
send    set terminal\r
wait    8
send    set terminal postscript\r
wait    4
send    set output "/dd/tmp/plot.ps"\r
wait    4
send    plot [-6:6] sin(x)/x\r
wait    8
quit    quit\r

shot    gulls
for     giftopnm pbmtoascii ppmtopgm
cap     DEMO/gulls.gif, a real photograph, decoded by giftopnm and carried
cap     through five more netpbm programs to arrive as characters: grey,
cap     scaled, normalised, dithered, and mapped two-by-four to a screen.
run     giftopnm /dd/DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 | pgmnorm | pgmtopbm | pbmtoascii -2x4
wait    30

shot    gulls-invert
for     pnminvert
cap     The photograph inverted -- a negative, made by pnminvert.
run     giftopnm /dd/DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 | pgmnorm | pnminvert | pgmtopbm | pbmtoascii -2x4
wait    30

shot    icon
for     pbmtoicon icontopbm pbmtomacp macptopbm
cap     Sun icon format and MacPaint, out and back.
run     pbmtoicon /dd/tmp/base.pbm > /dd/tmp/t.icon
wait    6
run     icontopbm /dd/tmp/t.icon | pnmfile
wait    8
run     pbmtomacp /dd/tmp/base.pbm > /dd/tmp/t.macp
wait    6
run     macptopbm /dd/tmp/t.macp | pnmfile
wait    8

shot    ilbm
for     ppmtoilbm ilbmtoppm pnmtosgi sgitopnm
cap     Amiga IFF/ILBM and SGI RGB -- two more machines that had their own
cap     idea of a picture file.
run     ppmtoilbm /dd/tmp/base.ppm > /dd/tmp/t.ilbm
wait    8
run     ilbmtoppm /dd/tmp/t.ilbm | pnmfile
wait    8
run     pnmtosgi /dd/tmp/base.ppm > /dd/tmp/t.sgi
wait    6
run     sgitopnm /dd/tmp/t.sgi | pnmfile
wait    8

shot    jpeg
for     cjpeg rdjpgcom wrjpgcom cjpeg.070 djpeg.070
cap     A JPEG made on the disk, commented, and read back.  This card said
cap     until 2026-08-29 that the JPEG tools could not read their input:
cap     cjpeg answered `Bogus data in PPM file' for a 192015-byte PPM that
cap     netpbm had just written and pnmfile was happy with.  The file was
cap     fine.  cjpeg wants LF between the fields of a PNM header and this
cap     disk's netpbm writes CR, so the three `pbyte' calls below -- at
cap     offsets 2, A and E of a `P6 320 200 255' header -- are the whole
cap     of what was missing.  DOC/STATUS has it in both directions.
run     giftopnm /dd/DEMO/gulls.gif > /dd/tmp/g.ppm
wait    20
run     pbyte /dd/tmp/g.ppm 2 0a
wait    4
run     pbyte /dd/tmp/g.ppm a 0a
wait    4
run     pbyte /dd/tmp/g.ppm e 0a
wait    4
run     cjpeg -quality 50 /dd/tmp/g.ppm > /dd/tmp/g.jpg
wait    60
run     wrjpgcom -comment "OS-9 freeware disk" /dd/tmp/g.jpg > /dd/tmp/gc.jpg
wait    15
run     rdjpgcom /dd/tmp/gc.jpg
wait    10
run     ls -l /dd/DEMO/gulls.gif /dd/tmp/g.ppm /dd/tmp/gc.jpg
wait    10
run     cjpeg.070 /dd/tmp/g.ppm > /nil
wait    20
run     djpeg.070 -pnm /dd/tmp/gc.jpg > /nil
wait    20

shot    lispm
for     pgmtolispm lispmtopgm pbmtopk pktopbm ppmtomap
cap     A Lisp machine's bitmap format, written and then read back -- and
cap     lispmtopgm refuses what pgmtolispm just wrote: `depth is too large
cap     - try reconfiguring with PGM_BIGGRAYS'.  The pair do not agree with
cap     each other in this build.  ppmtomap, underneath, works.
run     pgmtolispm /dd/tmp/base.pgm | lispmtopgm | pnmfile
wait    10
run     ppmtomap /dd/tmp/base.ppm | head -n 8
wait    8

shot    pbmclean
for     pbmclean pbmmask pbmtopgm pnmnoraw
cap     pbmclean removes lone pixels from a bitmap -- run here over dithered
cap     noise, which is nothing but lone pixels.  `pbmmask' makes a mask
cap     from a bitmap, `pbmtopgm' blurs one into greys and `pnmnoraw'
cap     writes the plain-text form of any of them; the three were credited
cap     to this card and never typed until 2026-08-30.
run     pgmnoise 152 88 | pgmtopbm > /dd/tmp/n.pbm
wait    15
run     pbmclean /dd/tmp/n.pbm | pbmtoascii -2x4
wait    20
run     pbmmask /dd/tmp/n.pbm | pnmfile
wait    15
run     pbmtopgm 3 3 /dd/tmp/n.pbm | pnmfile
wait    15
run     pnmnoraw /dd/tmp/n.pbm | head -n 3
wait    15

shot    pbmlife
cap     pbmlife runs Conway's Life one generation on a bitmap -- an image
cap     tool that is also a cellular automaton.
run     pgmnoise 60 30 | pgmtopbm | pbmlife | pbmtoascii
wait    10

shot    pbmmake
for     pbmmake pbmupc pbmreduce
cap     pbmupc draws a real UPC-A barcode from its digits; pbmreduce halves
cap     it so the whole code fits a screen.
run     pbmmake -g 24 8 | pbmtoascii -1x2
wait    8
run     pbmupc 0 72890 00011 | pbmreduce 2 | pbmtoascii -2x4
wait    15

shot    pbmtext
cap     pbmtext sets a line of type as a bitmap; pbmtoascii renders that
cap     bitmap back as characters.  Nothing is drawn by hand.
run     pbmtext "OS-9/68K" | pbmtoascii
wait    6

shot    pbmtext-big
for     pbmtext pbmpscale pbmreduce
cap     pbmtext sets a line of type, pbmpscale enlarges the bitmap without
cap     the staircase an ordinary scale would give.
run     pbmtext "netpbm" | pbmpscale 2 | pbmtoascii -2x4
wait    12

shot    pbmupc
cap     pbmupc draws a real UPC-A barcode from its digits.  Rendered here
cap     through pbmtoascii, the bar widths are the code.
run     pbmupc 0 72890 00011 | pbmreduce 3 | pbmtoascii
wait    8

shot    pcx
for     ppmtopcx pcxtoppm
cap     PCX -- the format every DOS paint program wrote.
run     ppmtopcx /dd/tmp/base.ppm > /dd/tmp/t.pcx
wait    8
run     pcxtoppm /dd/tmp/t.pcx > /dd/tmp/back3.ppm
wait    8
run     ls -l /dd/tmp/t.pcx
wait    3
run     pnmfile /dd/tmp/back3.ppm
wait    6

shot    pgmbentley
cap     The Bentley effect: brightness carried by how tall each pixel is.
run     pnmscale -width 150 /dd/DEMO/sphere.pgm | pgmbentley | pgmtopbm | pbmtoascii
wait    15

shot    pgmcrater
cap     pgmcrater drops craters at random and shades them -- a whole moon
cap     out of a random number generator.
run     pgmcrater -number 80 -xsize 152 -ysize 88 | pgmtopbm | pbmtoascii -2x4
wait    30

shot    pgmedge
for     pgmedge pgmenhance pgmnorm
cap     pgmedge keeps only where the brightness changes.  It works on a
cap     gradient and HANGS on a photograph: given the scaled gulls or the
cap     demo sphere it produces no output, no error and never returns, and
cap     the emulator has to be stopped.  Measured 2026-08-28 -- a ramp of
cap     64x36 goes through in a second, the same-sized sphere never does.
cap     pgmenhance and pgmnorm both handle either.
run     pgmramp -lr 64 36 > /dd/tmp/t64.pgm
wait    8
run     pgmedge /dd/tmp/t64.pgm > /dd/tmp/e64.pgm
wait    15
run     pnmfile /dd/tmp/t64.pgm /dd/tmp/e64.pgm
wait    8
run     pgmenhance /dd/tmp/t64.pgm | pnmfile
wait    10


shot    pgmhist
for     pgmhist pgmramp
cap     pgmramp makes a greyscale ramp and pgmhist counts what is in it --
cap     flat by construction, which is how you know both are right.
run     pgmramp -lr 64 16 > /dd/tmp/ramp.pgm
wait    6
run     pgmhist /dd/tmp/ramp.pgm | head -n 18
wait    8

shot    pgmnoise
for     pgmnoise pnmsmooth pnmconvol
cap     pgmnoise makes white noise -- every pixel an independent random
cap     grey, thresholded here to black and white.  pnmsmooth would blur
cap     it into cloud, but it is a script that scratches in /r0 and this
cap     disk has no RAM disk; pnmconvol, which does the actual work, is
cap     here and takes a kernel file.
run     pgmnoise 152 88 | pgmtopbm | pbmtoascii -2x4
wait    20
run     pnmsmooth /dd/tmp/base.pgm
wait    10

shot    pgmoil
cap     pgmoil paints the photograph again as if in oils -- each pixel
cap     becomes the commonest value around it.
run     giftopnm /dd/DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 | pgmoil | pgmnorm | pgmtopbm | pbmtoascii -2x4
wait    35

shot    pgmramp
cap     A greyscale ramp dithered to a bitmap: the gradient survives as the
cap     density of the characters.
run     pgmramp -lr 152 44 | pgmtopbm | pbmtoascii
wait    8

shot    pgmtexture
for     pgmtexture pgmkernel pnmhistmap
cap     pgmtexture measures an image the way a pattern-recognition paper
cap     does: angular second moment, contrast, correlation, entropy.  On
cap     the gulls photograph, which this card makes for itself rather than
cap     borrowing one another card happened to leave behind.
run     giftopnm /dd/DEMO/gulls.gif | ppmtopgm > /dd/tmp/gg2.pgm
wait    30
run     pnmscale -xysize 60 40 /dd/tmp/gg2.pgm > /dd/tmp/gg3.pgm
wait    20
run     pgmtexture -d 2 /dd/tmp/gg3.pgm | head -n 14
wait    60

shot    plotters
for     pbmtoplot pbmtozinc pbmtobbnbg pbmtogo pbmtoln03 pbmtolps
cap     Six more write-only drivers, for machines that are gone: a Unix
cap     plotter, Zinc, a BBN bitgraph, GraphOn, DEC LN03 and LPS.
cap     All six are asked for; three were until 2026-08-30.
run     pbmmake -g 48 24 > /dd/tmp/base.pbm
wait    12
run     pbmtoplot /dd/tmp/base.pbm | wc
wait    16
run     pbmtozinc /dd/tmp/base.pbm | head -n 6
wait    16
run     pbmtoln03 /dd/tmp/base.pbm | wc
wait    16
run     pbmtobbnbg /dd/tmp/base.pbm | wc
wait    16
run     pbmtogo /dd/tmp/base.pbm | wc
wait    16
run     pbmtolps /dd/tmp/base.pbm | wc
wait    16

shot    pnmarith
size    36 80
for     pnmarith pnmdepth
cap     pnmarith multiplies two images together, and it insists they be
cap     exactly the same size -- a scaled photograph and a ramp asked for
cap     at the same dimensions are not, because pnmscale keeps the aspect
cap     ratio.  Two ramps, one left-to-right and one top-to-bottom,
cap     multiply into a corner that fades both ways at once.
run     pgmramp -lr 152 88 > /dd/tmp/r2.pgm
wait    8
run     pgmramp -tb 152 88 > /dd/tmp/r3.pgm
wait    8
run     pnmarith -multiply /dd/tmp/r2.pgm /dd/tmp/r3.pgm | pgmtopbm | pbmtoascii -2x4
wait    20


shot    pnmcat
for     pnmcat pnminvert pnmscale
cap     pnmcat puts two images side by side -- the sphere beside its own
cap     negative, made by pnminvert.
run     pnmscale -xysize 74 88 /dd/DEMO/sphere.pgm > /dd/tmp/s.pgm
wait    10
run     pnminvert /dd/tmp/s.pgm > /dd/tmp/si.pgm
wait    6
run     pnmcat -lr /dd/tmp/s.pgm /dd/tmp/si.pgm | pgmtopbm | pbmtoascii -2x4
wait    12

shot    pnmcut
for     pnmcut pnmpaste pnmenlarge pnmshear pnmpad
cap     Five geometric filters run one after another -- cut a piece out,
cap     enlarge it, shear it, pad it and paste it back -- with pnmfile
cap     reporting the size after each, which is where the work shows.
run     pgmramp -lr 64 32 > /dd/tmp/r.pgm
wait    8
run     pnmcut 0 0 32 16 /dd/tmp/r.pgm > /dd/tmp/cut.pgm
wait    8
run     pnmenlarge 2 /dd/tmp/cut.pgm > /dd/tmp/big.pgm
wait    8
run     pnmshear 20 /dd/tmp/big.pgm > /dd/tmp/shr.pgm
wait    10
run     pnmpaste /dd/tmp/cut.pgm 0 0 /dd/tmp/r.pgm > /dd/tmp/pst.pgm
wait    10
run     pnmfile /dd/tmp/r.pgm /dd/tmp/cut.pgm /dd/tmp/big.pgm /dd/tmp/shr.pgm /dd/tmp/pst.pgm
wait    10

shot    pnmfile
cap     pnmfile identifies what each intermediate in a pipeline actually is
cap     -- format, dimensions and whether it is raw or plain.
run     pgmtopbm /dd/tmp/ramp.pgm > /dd/tmp/ramp.pbm
wait    3
run     ppmpat -gingham2 40 20 > /dd/tmp/ging.ppm
wait    3
run     pnmfile /dd/tmp/ramp.pgm /dd/tmp/ramp.pbm /dd/tmp/ging.ppm
wait    4

shot    pnmfile-gulls
for     pnmfile
cap     What each stage of that pipeline actually produced, according to
cap     pnmfile.
run     giftopnm /dd/DEMO/gulls.gif > /dd/tmp/gulls.ppm
wait    12
run     pnmscale -width 300 /dd/tmp/gulls.ppm > /dd/tmp/small.ppm
wait    12
run     pnmfile /dd/tmp/gulls.ppm /dd/tmp/small.ppm
wait    5

shot    pnmfile-set
for     pnmfile pnmtile pnmpad
cap     pnmfile identifies each file a pipeline made: format, size, and
cap     whether it is raw or plain.  Every file here is made by this card,
cap     so it does not depend on what another one left behind.  `pnmpad'
cap     takes its margins ATTACHED to the letter -- -l10, not -left 10 --
cap     and prints its usage for anything else.
run     pgmramp -lr 30 16 > /dd/tmp/ramp2.pgm
wait    6
run     pnmtile 60 32 /dd/tmp/ramp2.pgm > /dd/tmp/tile2.pgm
wait    10
run     pnmpad -white -l10 -r10 /dd/tmp/tile2.pgm > /dd/tmp/pad2.pgm
wait    10
run     pnmfile /dd/tmp/ramp2.pgm /dd/tmp/tile2.pgm /dd/tmp/pad2.pgm
wait    8

shot    pnmgamma
for     pnmgamma pnmhisteq
cap     pnmhisteq equalises the histogram of the gulls photograph -- it
cap     spreads the greys the picture actually uses across the whole range,
cap     which is why the dither has so much more to work with here than in
cap     the plain conversion above.
run     giftopnm /dd/DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 152 88 > /dd/tmp/gg.pgm
wait    25
run     pnmgamma 2.2 /dd/tmp/gg.pgm > /dd/tmp/gam.pgm
wait    15
run     pnmhisteq /dd/tmp/gg.pgm | pgmtopbm | pbmtoascii -2x4
wait    20

shot    pnminvert
cap     The sphere that ships in DEMO, inverted, so the light comes from
cap     the other side.
run     pnmscale -width 152 /dd/DEMO/sphere.pgm | pnminvert | pgmtopbm | pbmtoascii
wait    15

shot    pnmrotate
size    36 80
for     pnmrotate pnmcrop pnmflip
cap     pnmrotate turns the sphere thirty degrees and pnmcrop trims the
cap     margin the rotation left behind.
run     pnmscale -xysize 100 100 /dd/DEMO/sphere.pgm > /dd/tmp/rot1.pgm
wait    12
run     pnmrotate 30 /dd/tmp/rot1.pgm | pnmcrop > /dd/tmp/rot2.pgm
wait    20
run     pnmscale -xysize 152 88 /dd/tmp/rot2.pgm > /dd/tmp/rot3.pgm
wait    15
run     pgmtopbm /dd/tmp/rot3.pgm | pbmtoascii -2x4
wait    15


shot    pnmtile
cap     pnmtile repeats a small image to fill a larger one; pbmpscale then
cap     enlarges a bitmap without the staircase.
run     pnmscale -width 30 /dd/DEMO/sphere.pgm > /dd/tmp/t.pgm
wait    8
run     pnmtile 150 40 /dd/tmp/t.pgm | pgmtopbm -threshold -value 0.4 | pbmtoascii
wait    12

shot    pnmtops
for     pnmtops
cap     pnmtops writes PostScript around a bitmap -- how an image reached a
cap     printer in 1990.  The head of what it produced.
run     pnmtops /dd/tmp/ramp.pgm | head -n 18
wait    10

shot    ppm3d
size    36 80
for     ppm3d ppmspread ppmshift ppmmix
cap     ppmspread scatters every pixel up to eight places from where it
cap     belongs -- the photograph is still there underneath, which is the
cap     point of the filter.  ppm3d, ppmshift and ppmmix run first, over
cap     the same image.
run     giftopnm /dd/DEMO/gulls.gif | pnmscale -xysize 76 44 > /dd/tmp/s1.ppm
wait    20
run     ppmshift 6 /dd/tmp/s1.ppm > /dd/tmp/sh.ppm
wait    10
run     ppm3d /dd/tmp/s1.ppm /dd/tmp/sh.ppm > /dd/tmp/3d.ppm
wait    12
run     ppmmix 0.5 /dd/tmp/s1.ppm /dd/tmp/sh.ppm > /dd/tmp/mix.ppm
wait    12
run     pnmfile /dd/tmp/sh.ppm /dd/tmp/3d.ppm /dd/tmp/mix.ppm
wait    8
run     ppmspread 8 /dd/tmp/s1.ppm | ppmtopgm | pnmscale -xysize 152 88 | pgmtopbm | pbmtoascii -2x4
wait    25


shot    ppmdither
size    36 80
for     ppmdither ppmquant ppmtopgm
cap     ppmquant reduces the photograph to sixteen colours and ppmdither
cap     spreads the error -- the two halves of how a picture survived a
cap     screen that had no more colours than that.
run     giftopnm /dd/DEMO/gulls.gif > /dd/tmp/g16.ppm
wait    20
run     pnmscale -xysize 152 88 /dd/tmp/g16.ppm > /dd/tmp/g16s.ppm
wait    20
run     ppmquant 16 /dd/tmp/g16s.ppm > /dd/tmp/g16q.ppm
wait    20
run     ppmtopgm /dd/tmp/g16q.ppm | pgmtopbm | pbmtoascii -2x4
wait    20


shot    ppmforge
cap     ppmforge invents a planet from a random seed: fractal terrain, an
cap     atmosphere and a star field, none of it drawn by anybody.
run     ppmforge -width 152 -height 88 -seed 7 > /dd/tmp/planet.ppm
wait    300
run     ppmtopgm /dd/tmp/planet.ppm | pgmtopbm | pbmtoascii -2x4
wait    60

shot    ppmforge-clouds
for     ppmforge ppmdim ppmbrighten
cap     The same program asked for clouds only -- no land, all atmosphere.
run     ppmforge -clouds -width 152 -height 88 -seed 3 > /dd/tmp/clouds.ppm
wait    300
run     ppmtopgm /dd/tmp/clouds.ppm | pgmtopbm | pbmtoascii -2x4
wait    60

shot    ppmhist
for     ppmhist ppmpat
cap     ppmpat weaves a pattern and ppmhist counts the colours in it, the
cap     commonest first.
run     ppmpat -tartan 80 40 > /dd/tmp/t.ppm
wait    8
run     ppmhist /dd/tmp/t.ppm | head -n 18
wait    8

shot    ppmmake
for     ppmmake ppmbrighten ppmdim ppmnorm ppmchange
cap     ppmmake fills an image with one colour; ppmbrighten, ppmdim and
cap     ppmnorm change what that colour is, and ppmhist counts the result.
cap     `ppmdim', `ppmnorm' and `ppmchange' were credited here and never
cap     typed until 2026-08-30; each is asked over the same flat colour, so
cap     the histogram underneath says exactly what it did.
run     ppmmake rgb:80/40/c0 40 20 > /dd/tmp/flat.ppm
wait    16
run     ppmhist /dd/tmp/flat.ppm
wait    16
run     ppmbrighten -v 50 /dd/tmp/flat.ppm | ppmhist
wait    22
run     ppmdim 0.5 /dd/tmp/flat.ppm | ppmhist
wait    22
run     ppmnorm /dd/tmp/flat.ppm | ppmhist
wait    22
run     ppmchange rgb:80/40/c0 red /dd/tmp/flat.ppm | ppmhist
wait    22

shot    ppmpat
cap     ppmpat weaves a tartan, ppmtopgm greys it and the dither prints it.
run     ppmpat -tartan 152 88 | ppmtopgm | pgmtopbm | pbmtoascii -2x4
wait    15

shot    ppmpat-madras
for     ppmpat
cap     ppmpat weaves a madras pattern; the same dither renders it.
run     ppmpat -madras 150 44 | ppmtopgm | pgmtopbm | pbmtoascii
wait    12

shot    ppmrelief
cap     ppmrelief embosses an image -- the same sphere lit from the side by
cap     arithmetic rather than by a renderer.
run     pgmtoppm white /dd/DEMO/sphere.pgm | ppmrelief | ppmtopgm | pnmscale -width 150 | pgmtopbm | pbmtoascii
wait    20

shot    printers
for     pbmtolj pbmtoepson pbmto10x pbmtoptx pbmtoepsi
cap     The printer drivers: LaserJet, Epson, Star 10x and Printronix, each
cap     turning the same bitmap into that printer's own language.  Their
cap     sizes are the interesting part -- this is what a page cost.
run     pbmtolj /dd/tmp/base.pbm | wc
wait    8
run     pbmtoepson /dd/tmp/base.pbm | wc
wait    8
run     pbmto10x /dd/tmp/base.pbm | wc
wait    8
run     pbmtoepsi /dd/tmp/base.pbm | head -n 10
wait    8

shot    rawtopgm
for     rawtopgm rawtoppm pgmtofs fstopgm
cap     rawtopgm reads headerless bytes as an image -- how you got a picture
cap     out of a machine that wrote no header at all.
run     pgmnoise 40 20 | pnmnoraw | head -n 3
wait    8
run     rawtopgm 48 24 < /dd/tmp/base.pgm | pnmfile
wait    8
run     pgmtofs /dd/tmp/base.pgm | fstopgm | pnmfile
wait    10

shot    rayshade
for     rayshade rsconvert
cap     Rayshade 4.0 RENDERING -- a full ray tracer on a 68000, reporting
cap     what it did: primitives, eye rays, shadow rays, cache hits, time.
cap     Two things have to be in place first and neither is obvious.  It
cap     preprocesses every scene through `cccp', and it does that with
cap     popen(), which forks a program called `shell' -- this disk has bash
cap     and sh and no `shell', so the fork fails.  And the shell it forks
cap     finds a command in the DATA directory, so cccp has to be at /dd,
cap     not in CMDS.  Two copies, and the tracer runs.
run     cp /dd/CMDS/sh /dd/CMDS/shell
wait    8
run     cp /dd/CMDS/GCC139/gcc_cccp /dd/cccp
wait    8
run     rayshade -R 32 24 -O /dd/tmp/out.pic /dd/GAMES/rayshade/boxball.ray
wait    45

shot    sphere
size    36 80
for     pgmtopbm pnmscale
cap     DEMO/sphere.pgm, a rendered sphere, dithered the same way.  The
cap     gradient across it is carried entirely by the dither pattern.
run     pnmscale -xysize 152 88 /dd/DEMO/sphere.pgm > /dd/tmp/sph.pgm
wait    10
run     pgmtopbm /dd/tmp/sph.pgm | pbmtoascii -2x4
wait    15



shot    tga
for     ppmtotga tgatoppm
cap     Targa, and the Sun raster format beside it.
run     ppmtotga /dd/tmp/base.ppm > /dd/tmp/t.tga
wait    8
run     tgatoppm /dd/tmp/t.tga > /dd/tmp/back4.ppm
wait    8
run     pnmtorast /dd/tmp/base.ppm > /dd/tmp/t.ras
wait    6
run     rasttopnm /dd/tmp/t.ras > /dd/tmp/back5.ppm
wait    6
run     ls -l /dd/tmp/t.tga /dd/tmp/t.ras
wait    3
run     pnmfile /dd/tmp/back4.ppm /dd/tmp/back5.ppm
wait    6

shot    tiffish
for     ppmtopj pjtoppm ppmtopjxl ppmtoacad
cap     HP PaintJet, out and back, and two write-only drivers beside it --
cap     ppmtopjxl and ppmtoacad have no reader here, which is the shape of
cap     half this toolkit: it was written to FEED devices.
run     ppmtopj /dd/tmp/base.ppm > /dd/tmp/t.pj
wait    8
run     pjtoppm /dd/tmp/t.pj | pnmfile
wait    8
run     ppmtopjxl /dd/tmp/base.ppm | wc
wait    8

shot    workstations
for     pbmtomgr mgrtopbm pbmtoatk atktopbm pbmtocmuwm cmuwmtopbm
cap     Three workstation bitmap formats of the late eighties -- MGR, the
cap     Andrew Toolkit, and CMU's window manager -- each with its reader.
run     pbmtomgr /dd/tmp/base.pbm | mgrtopbm | pnmfile
wait    10
run     pbmtoatk /dd/tmp/base.pbm | atktopbm | pnmfile
wait    10
run     pbmtocmuwm /dd/tmp/base.pbm | cmuwmtopbm | pnmfile
wait    10

shot    xbm
for     pbmtoxbm xbmtopbm pbmtoybm ybmtopbm
cap     X bitmaps and Bennet Yee bitmaps: two of the eleven bitmap formats
cap     this toolkit reads.
run     pbmtoxbm /dd/tmp/base.pbm > /dd/tmp/t.xbm
wait    6
run     head -n 6 /dd/tmp/t.xbm 2>/nil
wait    5
run     xbmtopbm /dd/tmp/t.xbm > /dd/tmp/back6.pbm
wait    6
run     pbmtoybm /dd/tmp/base.pbm | ybmtopbm | pnmfile
wait    8

shot    xpm
for     ppmtoxpm xpmtoppm ppmtopuzz
cap     The X pixmap is C source with the image in it -- here is the head of
cap     one this disk just wrote.
run     ppmtoxpm /dd/tmp/base.ppm > /dd/tmp/t.xpm
wait    8
run     head -n 12 /dd/tmp/t.xpm
wait    5
run     xpmtoppm /dd/tmp/t.xpm | pnmfile
wait    8

shot    yuv
for     ppmtoyuv yuvtoppm ppmtoyuvsplit yuvsplittoppm ppmtorgb3 rgb3toppm
cap     Video colour spaces: YUV as one stream and as three planes, and
cap     RGB split into three files -- ppmtorgb3 names them after the input
cap     and writes them beside it, so base.ppm becomes base.red, base.grn
cap     and base.blu, and rgb3toppm puts them back together.
run     ppmtoyuv /dd/tmp/base.ppm | yuvtoppm 48 24 | pnmfile
wait    10
run     ppmtorgb3 /dd/tmp/base.ppm
wait    8
run     ls -l /dd/tmp/base.red /dd/tmp/base.grn /dd/tmp/base.blu
wait    8
run     rgb3toppm /dd/tmp/base.red /dd/tmp/base.grn /dd/tmp/base.blu | pnmfile
wait    10


shot    graphlib
for     g graph graphdemo graphsave apfel showpic sine striche wgen
cap     The Atari `Graph' library set.  These do not run here and loading
cap     does not help: the library is entered and faults on its own `RTE',
cap     a supervisor-only instruction -- it was written to run in
cap     supervisor state.  Note the module is `graph' and the programs ask
cap     for `Graph', which real OS-9 would not match either.
cap     All eight programs are asked for below; three were until 2026-08-29
cap     and the rest were credited to the card without being run.
run     load /dd/CMDS/GAMES/graph
wait    8
run     g
wait    10
run     striche
wait    10
run     graphdemo
wait    10
run     graphsave
wait    10
run     apfel
wait    10
run     showpic
wait    10
run     sine
wait    10
run     wgen
wait    10


shot    noreader
for     bioradtopgm hipstopgm qrttoppm sldtoppm spctoppm zeisstopnm
for     brushtopbm gouldtoppm hpcdtoppm imgtoppm mtvtoppm psidtopgm
for     spottopgm sputoppm ximtoppm xvminitoppm
cap     Sixteen of the readers here decode formats that no file on this
cap     disk is in -- confocal microscopes, ray tracers, AutoCAD slides,
cap     Atari Spectrum pictures, Photo CD, Amiga brushes, Gould scanners.
cap     Handed something else, they say so rather than guessing, which is
cap     the behaviour you want.  Three of the sixteen are shown; the rest
cap     answer the same way -- and the four that had never been asked at
cap     all are asked below, added 2026-08-30, so that "the rest answer the
cap     same way" is shown rather than assumed.
run     ppmmake red 16 16 > /dd/tmp/nr.ppm
wait    8
run     hipstopgm /dd/tmp/nr.ppm
wait    18
run     qrttoppm /dd/tmp/nr.ppm | head -n 3
wait    18
run     spottopgm /dd/tmp/nr.ppm
wait    16
run     sputoppm /dd/tmp/nr.ppm
wait    16
run     ximtoppm /dd/tmp/nr.ppm
wait    16
run     xvminitoppm /dd/tmp/nr.ppm
wait    16
run     zeisstopnm /dd/tmp/nr.ppm
wait    18


shot    pnmfilters
for     pnmalias pnmcomp pnmnlfilt ppmdist ppmflash
cap     Five more netpbm filters run over the same photograph, with pnmfile
cap     confirming each one produced an image: antialiasing, compositing, a
cap     non-linear filter, a distance transform and a flash.
run     giftopnm /dd/DEMO/gulls.gif | pnmscale -xysize 76 44 > /dd/tmp/w.ppm
wait    25
run     pnmnlfilt 1.0 0.5 /dd/tmp/w.ppm | pnmfile
wait    20
run     ppmflash 0.4 /dd/tmp/w.ppm | pnmfile
wait    15
run     ppmquant 256 /dd/tmp/w.ppm | ppmdist | pnmfile
wait    20
run     pnmalias /dd/tmp/w.ppm | pnmfile
wait    15
run     pnmcomp /dd/tmp/w.ppm /dd/tmp/w.ppm | pnmfile
wait    15


shot    ppmntsc
for     ppmntsc ppmqvga pnmtorast rasttopnm pnmtoddif
cap     ppmntsc clamps an image to what NTSC could actually transmit and
cap     ppmqvga to a 320x240 palette; Sun raster goes out and comes back,
cap     which is the check that the pair agree.
run     ppmntsc 0.8 /dd/tmp/w.ppm | pnmfile
wait    15
run     ppmqvga /dd/tmp/w.ppm | pnmfile
wait    15
run     pnmtorast /dd/tmp/w.ppm > /dd/tmp/w.ras
wait    10
run     rasttopnm /dd/tmp/w.ras | pnmfile
wait    12


shot    sir
for     pnmtosir sirtopnm
cap     Solitaire Image Recorder format, out and back -- and it does NOT
cap     round-trip: the size survives and the colour channels come back
cap     rotated over the first half of the pixels.  One of the three
cap     failures the data tests keep failing on purpose.
run     ppmmake rgb:ff/00/00 8 4 > /dd/tmp/red.ppm
wait    10
run     pnmtosir /dd/tmp/red.ppm > /dd/tmp/red.sir
wait    10
run     sirtopnm /dd/tmp/red.sir | pnmnoraw | head -n 6
wait    12


shot    writeonly
for     ppmtoicr ppmtomitsu ppmtosixel ppmtouil pbmto4425 pbmtox10bm
cap     Six drivers with no reader here, for machines that are gone: an NCR
cap     terminal, a Mitsubishi dye-sublimation printer, DEC sixel, Motif
cap     UIL source, an AT&T 4425 and an X10 bitmap.  What each made of the
cap     same picture, in bytes -- that is what a page cost.
cap     All six are asked for; three were until 2026-08-30.
run     ppmquant 256 /dd/tmp/w.ppm > /dd/tmp/q.ppm
wait    20
run     ppmtosixel /dd/tmp/q.ppm | wc
wait    20
run     ppmtomitsu /dd/tmp/q.ppm | wc
wait    20
run     ppmtoicr /dd/tmp/q.ppm | wc
wait    20
run     ppmtouil /dd/tmp/q.ppm | wc
wait    20
run     pbmmake -g 40 20 | pbmto4425 | wc
wait    15
run     pbmmake -g 40 20 | pbmtox10bm | head -n 6
wait    15

shot    mgif
for     mgif umusek
cap     mgif reads a GIF and can be asked to inquire rather than display --
cap     there is no screen here to display on, and it says what it takes.
cap     `umusek' beside it wants a G-Windows screen address and stops with
cap     `Can't get screen addr' where there is no G-Windows.
run     mgif -?
wait    8
run     umusek
wait    8

