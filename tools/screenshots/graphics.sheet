# The netpbm toolkit and the ray tracer: real images, converted
# by real programs and rendered back to characters so a screen
# can hold them.  pbmtoascii -2x4 maps a 2x4 block of pixels to
# one character, so 152x88 pixels is exactly 76x22 characters.
#
# THE SETUP STANZA COMES FIRST AND MUST STAY FIRST: it makes the three
# test images the rest of the sheet reads.  Sorted alphabetically once, it
# ran fifty stanzas too late and a dozen screens came out as `no such
# path'.  Stanzas run top to bottom in ONE session.

shot    setup-image
for     pgmramp ppmpat pnmfile
cap     The two test images every round trip below starts from: a greyscale
cap     ramp and a woven gingham, both generated on this disk.
try     pnmfile tmp/base.pgm tmp/base.ppm tmp/base.pbm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmramp -lr 48 24 > tmp/base.pgm
wait    5
run     ppmpat -gingham3 48 24 > tmp/base.ppm
wait    5
run     pbmmake -g 48 24 > tmp/base.pbm
wait    5
run     pnmfile tmp/base.pgm tmp/base.ppm tmp/base.pbm
wait    5


shot    ppmtopi1
cap     A Degas PI1 file is a whole Atari ST low-resolution screen, 320x200
cap     in sixteen colours, so it is 32,034 bytes whatever the picture's
cap     size.  The ST has eight levels of each colour, and ppmtopi1 rescales
cap     to them.
try     ppmtopi1 tmp/base.ppm > tmp/t.pi1; ls -l tmp/t.pi1
os9     ppmtopi1 tmp/base.ppm >-tmp/t.pi1; ls -l tmp/t.pi1
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtopi1 tmp/base.ppm > tmp/t.pi1; ls -l tmp/t.pi1
wait    12


shot    pi1toppm
cap     PI1 is always a full 320x200 Atari ST screen with eight levels of
cap     each colour, so the 48x24 test picture written by ppmtopi1 comes
cap     back 320 by 200 with a maxval of 7.
try     ppmtopi1 tmp/base.ppm > tmp/t.pi1; pi1toppm tmp/t.pi1 > tmp/b.ppm; pnmfile tmp/b.ppm
os9     ppmtopi1 tmp/base.ppm >-tmp/t.pi1; pi1toppm tmp/t.pi1 >-tmp/b.ppm; pnmfile tmp/b.ppm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtopi1 tmp/base.ppm > tmp/t.pi1
wait    16
run     pi1toppm tmp/t.pi1 > tmp/b.ppm
wait    16
run     pnmfile tmp/b.ppm
wait    16


shot    pi3topbm
cap     PI3 is the Atari ST's high-resolution screen, always 640x400 in
cap     black and white.  pbmtopi3 writes the 48x24 test bitmap into one
cap     and pi3topbm reads the whole screen back.
try     pbmtopi3 tmp/base.pbm > tmp/t.pi3; pi3topbm tmp/t.pi3 > tmp/b.pbm; pnmfile tmp/b.pbm
os9     pbmtopi3 tmp/base.pbm >-tmp/t.pi3; pi3topbm tmp/t.pi3 >-tmp/b.pbm; pnmfile tmp/b.pbm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmtopi3 tmp/base.pbm > tmp/t.pi3
wait    16
run     pi3topbm tmp/t.pi3 > tmp/b.pbm
wait    16
run     pnmfile tmp/b.pbm
wait    16


shot    ppmtopict
cap     Writes a Macintosh PICT from a colour map of the picture's colours:
cap     the woven test image has six, and becomes the file `ls' lists.
try     ppmtopict tmp/base.ppm > tmp/t.pict; ls -l tmp/t.pict
os9     ppmtopict tmp/base.ppm >-tmp/t.pict; ls -l tmp/t.pict
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtopict tmp/base.ppm > tmp/t.pict; ls -l tmp/t.pict
wait    12


shot    picttoppm
cap     A PICT written by ppmtopict, read back at its full 48x24.  The
cap     warning is about the fonts a PICT's text would be drawn in; this
cap     picture has no text, so nothing is lost.
try     ppmtopict tmp/base.ppm > tmp/t.pict; picttoppm tmp/t.pict | pnmfile
os9     ppmtopict tmp/base.ppm >-tmp/t.pict; picttoppm tmp/t.pict ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtopict tmp/base.ppm > tmp/t.pict; picttoppm tmp/t.pict | pnmfile
wait    16


shot    bmp
for     ppmtobmp bmptoppm
cap     BMP out and back.  ppmtobmp writes the OS/2 form of BMP unless it is
cap     given -windows; bmptoppm reads either and says which it found, and
cap     pnmfile confirms the picture came back the size it went in.
try     ppmtobmp -windows tmp/base.ppm | bmptoppm | pnmfile
os9     ppmtobmp -windows tmp/base.ppm ! bmptoppm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtobmp -windows tmp/base.ppm | bmptoppm | pnmfile
wait    10


shot    fits
for     fitstopnm
cap     FITS, the image format astronomers use, written from the greyscale
cap     ramp by pnmtofits and read straight back by fitstopnm; pnmfile
cap     reports the 48x24 greymap that returned.
try     pnmtofits tmp/base.pgm | fitstopnm | pnmfile
os9     pnmtofits tmp/base.pgm ! fitstopnm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmtofits tmp/base.pgm | fitstopnm | pnmfile
wait    8


shot    xwdtopnm
for     pnmtoxwd xwdtopnm
cap     The X window dump -- what xwd saves of a window -- written from the
cap     woven test image by pnmtoxwd and read back by xwdtopnm; pnmfile
cap     reports the 48x24 picture that returned.
try     pnmtoxwd tmp/base.ppm | xwdtopnm | pnmfile
os9     pnmtoxwd tmp/base.ppm ! xwdtopnm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmtoxwd tmp/base.ppm | xwdtopnm | pnmfile
wait    10


shot    g3
for     g3topbm
cap     Group 3 fax, out and back: pbmtog3 encodes the black-and-white test
cap     bitmap as a fax machine would send it, g3topbm decodes it, and
cap     pnmfile confirms the 48x24 bitmap returned.
try     pbmtog3 tmp/base.pbm | g3topbm | pnmfile
os9     pbmtog3 tmp/base.pbm ! g3topbm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmtog3 tmp/base.pbm | g3topbm | pnmfile
wait    8


shot    gemtopbm
cap     A GEM bitmap image, the picture format of the GEM desktop and
cap     Ventura Publisher, written from the test bitmap by pbmtogem and read
cap     back; pnmfile confirms the 48x24 bitmap returned.
try     pbmtogem tmp/base.pbm | gemtopbm | pnmfile
os9     pbmtogem tmp/base.pbm ! gemtopbm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmtogem tmp/base.pbm | gemtopbm | pnmfile
wait    8


shot    gif
for     ppmtogif giftopnm
cap     GIF out and back: ppmtogif writes it, giftopnm reads it, and
cap     pnmfile confirms the picture came back the size it went in.
try     ppmtogif tmp/base.ppm | giftopnm | pnmfile
os9     ppmtogif tmp/base.ppm ! giftopnm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtogif tmp/base.ppm | giftopnm | pnmfile
wait    10


shot    gif2
for     ppmtogif giftopnm ppmquant
cap     GIF written and read back: what `file' makes of the GIF, and what
cap     pnmfile makes of the PPM that came back out of it.
try     file tmp/t.gif
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtogif tmp/base.ppm > tmp/t.gif
wait    8
run     giftopnm tmp/t.gif > tmp/back.ppm
wait    8
run     file tmp/t.gif
wait    5
run     pnmfile tmp/back.ppm
wait    6


shot    giftopnm
size    28 80
cap     DEMO/gulls.gif, the picture of gulls on the disk, decoded by giftopnm
cap     and then turned grey, scaled, dithered and printed as characters by
cap     four more netpbm programs.
try     giftopnm DEMO/gulls.gif | ppmtopgm > tmp/g.pgm; pnmscale -xysize 152 88 tmp/g.pgm > tmp/gs.pgm; pgmtopbm tmp/gs.pgm | pbmtoascii -2x4
os9     giftopnm DEMO/gulls.gif ! ppmtopgm >-tmp/g.pgm; pnmscale -xysize 152 88 tmp/g.pgm >-tmp/gs.pgm; pgmtopbm tmp/gs.pgm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif | ppmtopgm > tmp/g.pgm
wait    30
run     pnmscale -xysize 152 88 tmp/g.pgm > tmp/gs.pgm
wait    20
run     pgmtopbm tmp/gs.pgm | pbmtoascii -2x4
wait    10


shot    gnuplot
size    30 80
cap     gnuplot 2.0 draws for a device named with `set terminal': here a
cap     sine curve goes to PostScript in tmp/plot.ps, and `head' shows the
cap     start of the file it wrote.  Its help database is SYS/gnuplot.gih
cap     and its demos are in DOC/gnuplot.
try     gnuplot
run     builtin cd /dd
wait    1
run     clear
wait    1
run     gnuplot
wait    8
send    set terminal postscript\r
wait    4
send    set output "tmp/plot.ps"\r
wait    4
send    plot [-6:6] sin(x)/x\r
wait    10
send    quit\r
wait    4
run     head -n 12 tmp/plot.ps
wait    5
snap


shot    gulls
size    28 80
for     pbmtoascii ppmtopgm
cap     DEMO/gulls.gif, a picture of gulls, decoded by giftopnm and carried
cap     through five more netpbm programs to arrive as characters: grey,
cap     scaled, normalised, dithered, and mapped two-by-four to a screen.
try     giftopnm DEMO/gulls.gif | ppmtopgm > tmp/g.pgm; pnmscale -xysize 152 88 tmp/g.pgm > tmp/gs.pgm; pgmnorm tmp/gs.pgm | pgmtopbm | pbmtoascii -2x4
os9     giftopnm DEMO/gulls.gif ! ppmtopgm >-tmp/g.pgm; pnmscale -xysize 152 88 tmp/g.pgm >-tmp/gs.pgm; pgmnorm tmp/gs.pgm ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif | ppmtopgm > tmp/g.pgm
wait    30
run     pnmscale -xysize 152 88 tmp/g.pgm > tmp/gs.pgm
wait    20
run     pgmnorm tmp/gs.pgm | pgmtopbm | pbmtoascii -2x4
wait    30


shot    gulls-invert
size    28 80
for     pnminvert
cap     The gulls picture as a negative, made by pnminvert.
try     giftopnm DEMO/gulls.gif | ppmtopgm > tmp/g.pgm; pnmscale -xysize 152 88 tmp/g.pgm > tmp/gs.pgm; pgmnorm tmp/gs.pgm | pnminvert | pgmtopbm | pbmtoascii -2x4
os9     giftopnm DEMO/gulls.gif ! ppmtopgm >-tmp/g.pgm; pnmscale -xysize 152 88 tmp/g.pgm >-tmp/gs.pgm; pgmnorm tmp/gs.pgm ! pnminvert ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif | ppmtopgm > tmp/g.pgm
wait    30
run     pnmscale -xysize 152 88 tmp/g.pgm > tmp/gs.pgm
wait    20
run     pgmnorm tmp/gs.pgm | pnminvert | pgmtopbm | pbmtoascii -2x4
wait    30


shot    icon
for     icontopbm
cap     A Sun icon, out and back: pbmtoicon writes the test bitmap as the C
cap     source of an icon, icontopbm reads it, and pnmfile confirms the
cap     48x24 bitmap returned.
try     pbmtoicon tmp/base.pbm | icontopbm | pnmfile
os9     pbmtoicon tmp/base.pbm ! icontopbm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmtoicon tmp/base.pbm | icontopbm | pnmfile
wait    8


shot    macptopbm
cap     A MacPaint document is always a whole 576x720 page.  The 48x24 test
cap     bitmap goes out with pbmtomacp, which centres it on that page, and
cap     macptopbm reads the page back; pnmcrop trims the white around it and
cap     reports what it took off each side.
try     pbmtomacp tmp/base.pbm | macptopbm | pnmcrop | pnmfile
os9     pbmtomacp tmp/base.pbm ! macptopbm ! pnmcrop ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pbmtomacp tmp/base.pbm | macptopbm | pnmcrop | pnmfile
wait    14


shot    ilbm
for     ppmtoilbm ilbmtoppm
cap     Amiga IFF/ILBM, out and back: ppmtoilbm writes the woven test image
cap     as bit planes and says how much its run-length coding saved,
cap     ilbmtoppm reads it, and pnmfile confirms the 48x24 picture returned.
try     ppmtoilbm tmp/base.ppm | ilbmtoppm | pnmfile
os9     ppmtoilbm tmp/base.ppm ! ilbmtoppm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtoilbm tmp/base.ppm | ilbmtoppm | pnmfile
wait    10


shot    sgitopnm
cap     An SGI image, the picture format of Silicon Graphics workstations,
cap     written from the woven test image by pnmtosgi and read back.
cap     sgitopnm seeks within its input, so it is given a file, not a pipe.
try     pnmtosgi tmp/base.ppm > tmp/t.sgi; sgitopnm tmp/t.sgi | pnmfile
os9     pnmtosgi tmp/base.ppm >-tmp/t.sgi; sgitopnm tmp/t.sgi ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmtosgi tmp/base.ppm > tmp/t.sgi; sgitopnm tmp/t.sgi | pnmfile
wait    12


shot    pbmtopk
size    30 80
cap     Builds a TeX font from bitmaps: a PK file of the glyphs and a TFM
cap     file of their metrics, at a resolution in dots per inch.  Here one
cap     character, the letter A set by pbmtext, becomes character 65 of a
cap     300-dpi font, and pktopbm reads it back out of the PK file.
try     pbmtopk t.pk t.tfm 300 -c 65 a.pbm; pktopbm t.pk -x 24 -y 20 -c 65 b.pbm; pbmtoascii b.pbm
run     rm -rf /dd/tmp/PKA > /nil 2>/nil; mkdir -p /dd/tmp/PKA
wait    3
run     builtin cd /dd/tmp/PKA
wait    1
run     pbmtext A > a.pbm
wait    4
run     clear
wait    1
run     pbmtopk t.pk t.tfm 300 -c 65 a.pbm
wait    14
run     pktopbm t.pk -x 24 -y 20 -c 65 b.pbm
wait    14
run     pbmtoascii b.pbm
wait    14


shot    pktopbm
size    30 80
cap     Unpacks characters from a TeX PK font into bitmaps, one file each,
cap     numbered from -c.  Here the capital A of the 300-dpi Computer Modern
cap     bold that ships in SYS/TEX/FONTS/PK300.  Give it -x and -y, the
cap     size of the bitmap: without them this version reads the character
cap     out of step and reports a bad PK file.
try     pktopbm cmbx10.300pk -x 40 -y 44 -c 65 a.pbm; pbmtoascii a.pbm
run     rm -rf /dd/tmp/PKB > /nil 2>/nil; mkdir -p /dd/tmp/PKB
wait    3
run     builtin cd /dd/tmp/PKB
wait    1
run     cp /dd/SYS/TEX/FONTS/PK300/cmbx10.300pk cmbx10.300pk
wait    3
run     clear
wait    1
run     pktopbm cmbx10.300pk -x 40 -y 44 -c 65 a.pbm; pbmtoascii a.pbm
wait    10


shot    ppmtomap
cap     Makes a colour map: a PPM one pixel high holding each colour of the
cap     image once.  The woven test image has six, and pnmnoraw spells the
cap     map out as numbers.
try     ppmtomap tmp/base.ppm | pnmnoraw
os9     ppmtomap tmp/base.ppm ! pnmnoraw
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtomap tmp/base.ppm | pnmnoraw
wait    8


shot    pbmclean
size    36 80
cap     The word OS-9, set by pbmtext and sprinkled with random dots, as it
cap     was and after pbmclean: most of the lone dots are gone and the
cap     letters stay.  The dots are pgmnoise thresholded to one pixel in
cap     twelve, laid over the word with pnmarith -minimum.
try     pbmtoascii speckled.pbm; pbmclean speckled.pbm | pbmtoascii
os9     pbmtoascii speckled.pbm; pbmclean speckled.pbm ! pbmtoascii
run     rm -rf tmp/PBMA
wait    1
run     mkdir -p tmp/PBMA
wait    1
run     builtin cd tmp/PBMA
wait    1
run     pbmtext OS-9 > os9.pbm; pgmnoise 57 29 | pgmtopbm -threshold -value 0.08 > dots.pbm
wait    12
run     pnmarith -minimum os9.pbm dots.pbm > speckled.pbm
wait    6
run     clear
wait    1
run     pbmtoascii speckled.pbm; pbmclean speckled.pbm | pbmtoascii
wait    12

shot    pbmmask
size    36 80
cap     The word OS-9 and the mask pbmmask makes of it.  The background is
cap     the white reachable from the corners; that goes white and everything
cap     else goes black, so the holes inside the O and the 9 fill in.
try     pbmtoascii os9.pbm; pbmmask os9.pbm | pbmtoascii
os9     pbmtoascii os9.pbm; pbmmask os9.pbm ! pbmtoascii
run     rm -rf tmp/PBMB
wait    1
run     mkdir -p tmp/PBMB
wait    1
run     builtin cd tmp/PBMB
wait    1
run     pbmtext OS-9 > os9.pbm
wait    5
run     clear
wait    1
run     pbmtoascii os9.pbm; pbmmask os9.pbm | pbmtoascii
wait    12

shot    pbmtopgm
cap     Blurs a bitmap into a greyscale by averaging over a window, here a
cap     3-by-3 one, over a bitmap of random dots.  The result is a greymap;
cap     pnmfile reports its size and that it is now a PGM.
try     pbmtopgm 3 3 noise.pbm | pnmfile
os9     pbmtopgm 3 3 noise.pbm ! pnmfile
run     rm -rf tmp/PBMC
wait    1
run     mkdir -p tmp/PBMC
wait    1
run     builtin cd tmp/PBMC
wait    1
run     pgmnoise 64 32 | pgmtopbm -threshold > noise.pbm
wait    20
run     clear
wait    1
run     pbmtopgm 3 3 noise.pbm | pnmfile
wait    8


shot    pnmnoraw
cap     Writes the plain-text form of a PBM, PGM or PPM: the same image with
cap     its pixels spelled out as ASCII numbers instead of packed bytes, so
cap     you can read or edit it by hand.
try     pnmnoraw noise.pbm | head -n 4
os9     pnmnoraw noise.pbm ! head -n 4
run     rm -rf tmp/PBMD
wait    1
run     mkdir -p tmp/PBMD
wait    1
run     builtin cd tmp/PBMD
wait    1
run     pgmnoise 40 16 | pgmtopbm -threshold > noise.pbm
wait    15
run     clear
wait    1
run     pnmnoraw noise.pbm | head -n 4
wait    6
wait    30


shot    pbmlife
cap     pbmlife runs Conway's Life one generation on a bitmap -- an image
cap     tool that is also a cellular automaton.
try     pgmnoise 60 30 | pgmtopbm | pbmlife | pbmtoascii
os9     pgmnoise 60 30 ! pgmtopbm ! pbmlife ! pbmtoascii
run     pgmnoise 60 30 | pgmtopbm | pbmlife | pbmtoascii
wait    10


shot    pbmtext
cap     pbmtext sets a line of type as a bitmap; pbmtoascii renders that
cap     bitmap back as characters.
try     pbmtext "OS-9/68K" | pbmtoascii
os9     pbmtext "OS-9/68K" ! pbmtoascii
run     pbmtext "OS-9/68K" | pbmtoascii
wait    6


shot    pbmtext-big
for     pbmtext pbmpscale
cap     pbmtext sets a line of type, pbmpscale enlarges the bitmap without
cap     the staircase an ordinary scale would give.
try     pbmtext "netpbm" | pbmpscale 2 | pbmtoascii -2x4
os9     pbmtext "netpbm" ! pbmpscale 2 ! pbmtoascii -2x4
run     pbmtext "netpbm" | pbmpscale 2 | pbmtoascii -2x4
wait    12


shot    pbmupc
size    34 80
cap     pbmupc draws a real UPC-A barcode from its digits.  Rendered here
cap     through pbmtoascii, the bar widths are the code.
try     pbmupc 0 72890 00011 | pbmreduce 3 | pbmtoascii
os9     pbmupc 0 72890 00011 ! pbmreduce 3 ! pbmtoascii
run     clear
wait    1
run     pbmupc 0 72890 00011 | pbmreduce 3 | pbmtoascii
wait    10


shot    pcx
for     ppmtopcx pcxtoppm
cap     PCX, the format of PC Paintbrush and many DOS paint programs.
cap     ppmtopcx writes the test image, `ls' shows how small the run-length
cap     coding made it, and pcxtoppm reads it back, describing the header
cap     as it goes, for pnmfile to check.  pcxtoppm seeks in its input, so
cap     it reads a file rather than a pipe.
try     ppmtopcx tmp/base.ppm > tmp/t.pcx; ls -l tmp/t.pcx; pcxtoppm tmp/t.pcx > tmp/b.ppm; pnmfile tmp/b.ppm
os9     ppmtopcx tmp/base.ppm >-tmp/t.pcx; ls -l tmp/t.pcx; pcxtoppm tmp/t.pcx >-tmp/b.ppm; pnmfile tmp/b.ppm
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtopcx tmp/base.ppm > tmp/t.pcx
wait    16
run     ls -l tmp/t.pcx
wait    16
run     pcxtoppm tmp/t.pcx > tmp/b.ppm
wait    16
run     pnmfile tmp/b.ppm
wait    16


shot    pgmbentley
size    26 80
cap     The Bentley effect: each pixel is smeared upward by an amount set
cap     by its own brightness, so the sphere from DEMO runs up the screen.
try     pnmscale -xysize 152 88 DEMO/sphere.pgm > tmp/s.pgm; pgmbentley tmp/s.pgm | pgmtopbm | pbmtoascii -2x4
os9     pnmscale -xysize 152 88 DEMO/sphere.pgm >-tmp/s.pgm; pgmbentley tmp/s.pgm ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmscale -xysize 152 88 DEMO/sphere.pgm > tmp/s.pgm
wait    10
run     pgmbentley tmp/s.pgm | pgmtopbm | pbmtoascii -2x4
wait    15


shot    pgmcrater
cap     pgmcrater drops craters at random and shades them -- a whole moon
cap     out of a random number generator.
try     pgmcrater -number 80 -xsize 152 -ysize 88 | pgmtopbm | pbmtoascii -2x4
os9     pgmcrater -number 80 -xsize 152 -ysize 88 ! pgmtopbm ! pbmtoascii -2x4
run     pgmcrater -number 80 -xsize 152 -ysize 88 | pgmtopbm | pbmtoascii -2x4
wait    30


shot    pgmhist
for     pgmhist pgmramp
cap     pgmramp makes a greyscale ramp and pgmhist counts what is in it --
cap     each grey level the same number of times, as a ramp should be.
try     pgmramp -lr 64 16 > tmp/ramp.pgm; pgmhist tmp/ramp.pgm | head -n 18
os9     pgmramp -lr 64 16 >-tmp/ramp.pgm; pgmhist tmp/ramp.pgm ! head -n 18
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmramp -lr 64 16 > tmp/ramp.pgm; pgmhist tmp/ramp.pgm | head -n 18
wait    12


shot    pgmnoise
size    26 80
cap     pgmnoise makes white noise -- every pixel an independent random
cap     grey, dithered here to black and white.
try     pgmnoise 152 88 | pgmtopbm | pbmtoascii -2x4
os9     pgmnoise 152 88 ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pgmnoise 152 88 | pgmtopbm | pbmtoascii -2x4
wait    20


shot    pgmoil
size    28 80
cap     pgmoil paints the gulls picture again as if in oils -- each pixel
cap     becomes the commonest value around it.
try     giftopnm DEMO/gulls.gif | ppmtopgm > tmp/g.pgm; pnmscale -xysize 152 88 tmp/g.pgm > tmp/gs.pgm; pgmoil tmp/gs.pgm | pgmnorm | pgmtopbm | pbmtoascii -2x4
os9     giftopnm DEMO/gulls.gif ! ppmtopgm >-tmp/g.pgm; pnmscale -xysize 152 88 tmp/g.pgm >-tmp/gs.pgm; pgmoil tmp/gs.pgm ! pgmnorm ! pgmtopbm ! pbmtoascii -2x4
run     builtin cd /dd
wait    1
run     clear
wait    1
run     giftopnm DEMO/gulls.gif | ppmtopgm > tmp/g.pgm
wait    30
run     pnmscale -xysize 152 88 tmp/g.pgm > tmp/gs.pgm
wait    20
run     pgmoil tmp/gs.pgm | pgmnorm | pgmtopbm | pbmtoascii -2x4
wait    30


shot    pgmramp
size    26 156
cap     A greyscale ramp dithered to a bitmap: the gradient survives as the
cap     density of the characters.
try     pgmramp -lr 152 44 | pgmtopbm | pbmtoascii
os9     pgmramp -lr 152 44 ! pgmtopbm ! pbmtoascii
run     pgmramp -lr 152 44 | pgmtopbm | pbmtoascii
wait    8


shot    pgmtexture
size    28 80
cap     pgmtexture measures an image the way a pattern-recognition paper
cap     does: angular second moment, contrast, correlation, entropy, each at
cap     four angles and averaged.  On the gulls picture from DEMO, cut down
cap     to 60x40 and at most 32 greys first, which keeps its matrices small.
try     pgmtexture -d 2 gg.pgm > gg.tex; cat gg.tex
os9     pgmtexture -d 2 gg.pgm >-gg.tex; cat gg.tex
run     rm -rf /dd/tmp/PGTX > /nil 2>/nil; mkdir -p /dd/tmp/PGTX
wait    3
run     builtin cd /dd/tmp/PGTX
wait    1
run     giftopnm /dd/DEMO/gulls.gif | ppmtopgm | pnmscale -xysize 60 40 | pnmdepth 31 > gg.pgm
wait    45
run     clear
wait    1
run     pgmtexture -d 2 gg.pgm > gg.tex; cat gg.tex
wait    40


shot    pbmtoplot
cap     Writes a bitmap as a Unix plot(5) file -- the device-independent
