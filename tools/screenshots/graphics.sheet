run     ppmpat -gingham3 48 24 > base.ppm
wait    5
run     clear
wait    1
run     ppmtorgb3 base.ppm
wait    16
run     ls -l base.red base.grn base.blu
wait    16
run     rgb3toppm base.red base.grn base.blu | pnmfile
wait    16


shot    qrttoppm
size    26 80
cap     Reads the output of the QRT ray tracer: a two-byte width and height,
cap     then each row as its number and its red, green and blue bytes.  No
cap     QRT file ships, so one is made here -- printf writes the rows as
cap     letters, pbyte sets the four size bytes to 4 by 2 -- and the letters'
cap     codes come back as the colours.
try     dump x.qrt; qrttoppm x.qrt | pnmnoraw
os9     dump x.qrt; qrttoppm x.qrt ! pnmnoraw
run     rm -rf /dd/tmp/QRTB > /nil 2>/nil; mkdir -p /dd/tmp/QRTB
wait    3
run     builtin cd /dd/tmp/QRTB
wait    1
run     printf "HHHH" > x.qrt; printf "00ABCDEFGHIJKL01abcdefghijkl" >> x.qrt
wait    3
run     pbyte x.qrt 0 04; pbyte x.qrt 1 00; pbyte x.qrt 2 02; pbyte x.qrt 3 00
wait    4
run     clear
wait    1
run     dump x.qrt; qrttoppm x.qrt | pnmnoraw
wait    8


shot    sputoppm
cap     An uncompressed Spectrum 512 file is an Atari ST screen, 320x200,
cap     and a palette for every line, with no header to check.  No such
cap     file ships here; handed a small red PPM instead, sputoppm reads it
cap     as one all the same and writes a 320x200 picture.
try     sputoppm nr.ppm > s.ppm; pnmfile s.ppm
os9     sputoppm nr.ppm >-s.ppm; pnmfile s.ppm
run     rm -rf /dd/tmp/SPUB > /nil 2>/nil; mkdir -p /dd/tmp/SPUB
wait    3
run     builtin cd /dd/tmp/SPUB
wait    1
run     ppmmake red 16 16 > nr.ppm
wait    5
run     clear
wait    1
run     sputoppm nr.ppm > s.ppm; pnmfile s.ppm
wait    10


shot    pnmnlfilt
size    26 80
cap     A non-linear filter with three modes chosen by its first number.
cap     At 0.5 it is an alpha-trimmed mean that shrugs off a lone speck: a
cap     flat grey of 100 with one pixel at 255, before and after, the speck
cap     pulled down to near its neighbours.
try     pnmnoraw spot.pgm; pnmnlfilt 0.5 1 spot.pgm | pnmnoraw
os9     pnmnoraw spot.pgm; pnmnlfilt 0.5 1 spot.pgm ! pnmnoraw
run     rm -rf /dd/tmp/NLFB > /nil 2>/nil; mkdir -p /dd/tmp/NLFB
wait    3
run     builtin cd /dd/tmp/NLFB
wait    1
run     printf "P2\r7 3\r255\r100 100 100 100 100 100 100\r100 100 100 255 100 100 100\r100 100 100 100 100 100 100\r" > spot.pgm
wait    3
run     clear
wait    1
run     pnmnoraw spot.pgm; pnmnlfilt 0.5 1 spot.pgm | pnmnoraw
wait    10


shot    pnmalias
size    26 80
cap     Anti-aliases the edge between a foreground and a background colour.
cap     A white staircase over black, spelled out by pnmnoraw before and
cap     after: the steps come back with greys in their corners.
try     pnmnoraw edge.pgm; pnmalias edge.pgm | pnmnoraw
os9     pnmnoraw edge.pgm; pnmalias edge.pgm ! pnmnoraw
run     rm -rf /dd/tmp/ALIB > /nil 2>/nil; mkdir -p /dd/tmp/ALIB
wait    3
run     builtin cd /dd/tmp/ALIB
wait    1
run     printf "P2\r6 4\r255\r255 255 255 255 255 0\r255 255 255 255 0 0\r255 255 0 0 0 0\r0 0 0 0 0 0\r" > edge.pgm
wait    3
run     clear
wait    1
run     pnmnoraw edge.pgm; pnmalias edge.pgm | pnmnoraw
wait    10


shot    pnmcomp
size    26 80
cap     Composites one image over another at an offset.  The word OS-9, set
cap     by pbmtext, laid over a top-to-bottom ramp at 48 across and 30 down;
cap     the bitmap's white background comes with it.
try     pnmcomp -xoff 48 -yoff 30 os9.pbm ramp.pgm | pgmtopbm | pbmtoascii -2x4
os9     pnmcomp -xoff 48 -yoff 30 os9.pbm ramp.pgm ! pgmtopbm ! pbmtoascii -2x4
run     rm -rf /dd/tmp/COMB > /nil 2>/nil; mkdir -p /dd/tmp/COMB
wait    3
run     builtin cd /dd/tmp/COMB
wait    1
run     pbmtext OS-9 > os9.pbm; pgmramp -tb 152 88 > ramp.pgm
wait    8
run     clear
wait    1
run     pnmcomp -xoff 48 -yoff 30 os9.pbm ramp.pgm | pgmtopbm | pbmtoascii -2x4
wait    20


shot    ppmdist
cap     Turns a colour picture into a greymap for a monochrome printer,
cap     giving each colour its own grey, 0 up to one less than the number
cap     of colours.  The woven test image has six; pgmhist counts the six
cap     greys they became.
try     ppmdist tmp/base.ppm | pgmhist
os9     ppmdist tmp/base.ppm ! pgmhist
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmdist tmp/base.ppm | pgmhist
wait    12


shot    ppmflash
cap     Brightens a picture towards white by a factor, as a flash would.  A
cap     dark brown, 64 32 16, flashed by 0.5 moves halfway to white, as
cap     ppmhist reads it before and after.
try     ppmhist dim.ppm; ppmflash 0.5 dim.ppm | ppmhist
os9     ppmhist dim.ppm; ppmflash 0.5 dim.ppm ! ppmhist
run     rm -rf /dd/tmp/FLSB > /nil 2>/nil; mkdir -p /dd/tmp/FLSB
wait    3
run     builtin cd /dd/tmp/FLSB
wait    1
run     ppmmake rgb:40/20/10 4 2 > dim.ppm
wait    4
run     clear
wait    1
run     ppmhist dim.ppm; ppmflash 0.5 dim.ppm | ppmhist
wait    10


shot    ppmntsc
cap     Dims every other row of a picture by a factor, as an interlaced
cap     video frame looks half-drawn.  A flat grey of 200, four by four,
cap     dimmed by 0.5: pnmnoraw shows the first and third rows at 100.
try     ppmmake rgb:c8/c8/c8 4 4 | ppmntsc 0.5 | pnmnoraw
os9     ppmmake rgb:c8/c8/c8 4 4 ! ppmntsc 0.5 ! pnmnoraw
run     clear
wait    1
run     ppmmake rgb:c8/c8/c8 4 4 | ppmntsc 0.5 | pnmnoraw
wait    10


shot    ppmqvga
cap     Quantises a picture to at most 256 colours, the palette of a VGA
cap     screen, dithering with -d.  The gulls picture has thousands of
cap     colours; ppmhist lists the commonest of those left.
try     ppmqvga -d gulls.ppm > q.ppm; ppmhist q.ppm | head -n 8
os9     ppmqvga -d gulls.ppm >-q.ppm; ppmhist q.ppm ! head -n 8
run     rm -rf /dd/tmp/QVGB > /nil 2>/nil; mkdir -p /dd/tmp/QVGB
wait    3
run     builtin cd /dd/tmp/QVGB
wait    1
run     giftopnm /dd/DEMO/gulls.gif | pnmscale -xysize 152 88 > gulls.ppm
wait    45
run     clear
wait    1
run     ppmqvga -d gulls.ppm > q.ppm; ppmhist q.ppm | head -n 8
wait    40


shot    rasttopnm
for     pnmtorast rasttopnm
cap     Sun raster, the picture format of Sun workstations, out and back:
cap     pnmtorast writes the woven test image with a colour map, rasttopnm
cap     reads it, and pnmfile confirms the 48x24 picture returned.
try     pnmtorast tmp/base.ppm | rasttopnm | pnmfile
os9     pnmtorast tmp/base.ppm ! rasttopnm ! pnmfile
run     builtin cd /dd
wait    1
run     clear
wait    1
run     pnmtorast tmp/base.ppm | rasttopnm | pnmfile
wait    12


shot    sir
for     pnmtosir sirtopnm
cap     Solitaire Image Recorder format, out and back.  An 8x4 red image
cap     goes to SIR and returns byte for byte, as pnmnoraw spells it out.
try     ppmmake rgb:ff/00/00 8 4 > red.ppm; pnmtosir red.ppm > red.sir; sirtopnm red.sir | pnmnoraw | head -n 6
os9     ppmmake rgb:ff/00/00 8 4 >-red.ppm; pnmtosir red.ppm >-red.sir; sirtopnm red.sir ! pnmnoraw ! head -n 6
run     rm -rf /dd/tmp/SIRB > /nil 2>/nil; mkdir -p /dd/tmp/SIRB
wait    3
run     builtin cd /dd/tmp/SIRB
wait    1
run     clear
wait    1
run     ppmmake rgb:ff/00/00 8 4 > red.ppm
wait    20
run     pnmtosir red.ppm > red.sir
wait    20
run     sirtopnm red.sir | pnmnoraw | head -n 6
wait    20


shot    ppmtoicr
cap     Writes a picture as NCSA Telnet's Interactive Color Raster: escape
cap     sequences that open a window on the PC running Telnet, load the
cap     colour map and send the pixels, reporting each step as it goes.  wc
cap     counts the bytes the woven test image became.
try     ppmtoicr tmp/base.ppm | wc
os9     ppmtoicr tmp/base.ppm ! wc
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtoicr tmp/base.ppm | wc
wait    14


shot    ppmtouil
size    26 80
cap     Writes a picture as a Motif UIL icon: source for the Motif user
cap     interface language, a colour table and then the rows as characters.
cap     The head of what it wrote for the woven test image.
try     ppmtouil tmp/base.ppm | head -n 16
os9     ppmtouil tmp/base.ppm ! head -n 16
run     builtin cd /dd
wait    1
run     clear
wait    1
run     ppmtouil tmp/base.ppm | head -n 16
wait    14


shot    pbmto4425
cap     Draws a bitmap on an AT&T 4425 terminal with its mosaic graphics
cap     characters, switching it to 132 columns first.  On another
cap     terminal the codes do not draw, so wc counts them instead.
try     pbmmake -g 40 20 | pbmto4425 | wc
os9     pbmmake -g 40 20 ! pbmto4425 ! wc
run     clear
wait    1
run     pbmmake -g 40 20 | pbmto4425 | wc
wait    12


shot    pbmtox10bm
cap     Writes a bitmap in the older X10 bitmap format: C source, sixteen
cap     pixels to a short.  The grey checkerboard pbmmake lays down comes
cap     out as alternating aaaa and 5555 words.
try     pbmmake -g 40 20 | pbmtox10bm | head -n 6
os9     pbmmake -g 40 20 ! pbmtox10bm ! head -n 6
run     clear
wait    1
run     pbmmake -g 40 20 | pbmtox10bm | head -n 6
wait    12

# ---- JPEG: the IJG codec and its comment tools, one card each.  The .070
# ---- files are the same programs built for the 68000, 68010 and 68070;
# ---- the unsuffixed ones for the 68020 and up (SRC/jpeglib/JPEG_5A/Readme.OSK).


shot    cjpeg
size    26 80
cap     Makes a JPEG from a PNM.  cjpeg wants LF between the fields of a
cap     PNM header where the netpbm here writes CR, so the three `pbyte'
cap     calls patch those separators first; then the 3,469-byte woven test
cap     image compresses to the size `ls' shows.
try     pbyte j.ppm 2 0a; pbyte j.ppm 8 0a; pbyte j.ppm c 0a; cjpeg -quality 50 j.ppm > j.jpg; ls -l j.ppm j.jpg
os9     pbyte j.ppm 2 0a; pbyte j.ppm 8 0a; pbyte j.ppm c 0a; cjpeg -quality 50 j.ppm >-j.jpg; ls -l j.ppm j.jpg
run     rm -rf /dd/tmp/GFXC > /nil 2>/nil; mkdir -p /dd/tmp/GFXC
wait    3
run     builtin cd /dd/tmp/GFXC
wait    1
run     ppmpat -gingham3 48 24 > j.ppm
wait    5
run     clear
wait    1
run     pbyte j.ppm 2 0a
wait    20
run     pbyte j.ppm 8 0a
wait    20
run     pbyte j.ppm c 0a
wait    20
run     cjpeg -quality 50 j.ppm > j.jpg
wait    20
run     ls -l j.ppm j.jpg
wait    20


shot    djpeg
size    50 164
cap     The JPEG library's own test image, which ships beside its source in
cap     SRC/jpeglib/JPEG_5A, decoded by djpeg and drawn as ASCII by netpbm.
cap     djpeg ends its PNM header lines with LF and the netpbm here wants
cap     CR, so the three `pbyte' calls patch those separators before the
cap     picture goes on.
try     djpeg -pnm testimg.jpg > dj.ppm; pbyte dj.ppm 2 0d; pbyte dj.ppm a 0d; pbyte dj.ppm e 0d; ppmtopgm dj.ppm | pgmtopbm | pbmtoascii -2x4
os9     djpeg -pnm testimg.jpg >-dj.ppm; pbyte dj.ppm 2 0d; pbyte dj.ppm a 0d; pbyte dj.ppm e 0d; ppmtopgm dj.ppm ! pgmtopbm ! pbmtoascii -2x4
run     rm -rf /dd/tmp/GFXD > /nil 2>/nil; mkdir -p /dd/tmp/GFXD
wait    3
run     builtin cd /dd/tmp/GFXD
wait    1
run     cp /dd/SRC/jpeglib/JPEG_5A/testimg.jpg testimg.jpg
wait    3
run     clear
wait    1
run     djpeg -pnm testimg.jpg > dj.ppm
wait    50
run     pbyte dj.ppm 2 0d; pbyte dj.ppm a 0d; pbyte dj.ppm e 0d
wait    6
run     ppmtopgm dj.ppm | pgmtopbm | pbmtoascii -2x4
wait    40


shot    djpeg.070
cap     djpeg.070 is djpeg built for the 68000, 68010 and 68070.  It decodes
cap     the JPEG cjpeg wrote from the woven test image back to a full-size
cap     PNM, as `ls' shows.
try     djpeg.070 -pnm j.jpg > d70.ppm; ls -l j.jpg d70.ppm
os9     djpeg.070 -pnm j.jpg >-d70.ppm; ls -l j.jpg d70.ppm
run     rm -rf /dd/tmp/GFXE > /nil 2>/nil; mkdir -p /dd/tmp/GFXE
wait    3
run     builtin cd /dd/tmp/GFXE
wait    1
run     ppmpat -gingham3 48 24 > j.ppm; pbyte j.ppm 2 0a; pbyte j.ppm 8 0a; pbyte j.ppm c 0a
wait    8
run     cjpeg -quality 50 j.ppm > j.jpg
wait    12
run     clear
wait    1
run     djpeg.070 -pnm j.jpg > d70.ppm; ls -l j.jpg d70.ppm
wait    16


shot    cjpeg.070
cap     cjpeg.070 is cjpeg built for the 68000, 68010 and 68070.  Handed the
cap     patched PNM its twin compresses, it stops at `Premature end of input
cap     file' and writes nothing; the library's own test images go the
cap     same way.  Use cjpeg.
try     cjpeg.070 -quality 50 j.ppm > x.jpg
os9     cjpeg.070 -quality 50 j.ppm >-x.jpg
run     rm -rf /dd/tmp/GFXF > /nil 2>/nil; mkdir -p /dd/tmp/GFXF
wait    3
run     builtin cd /dd/tmp/GFXF
wait    1
run     ppmpat -gingham3 48 24 > j.ppm; pbyte j.ppm 2 0a; pbyte j.ppm 8 0a; pbyte j.ppm c 0a
wait    8
run     clear
wait    1
run     cjpeg.070 -quality 50 j.ppm > x.jpg
wait    10


shot    rdjpgcom
cap     Prints the comment stored in a JPEG.  A comment is written into a
cap     JPEG with wrjpgcom and rdjpgcom reads it back.
try     rdjpgcom jc.jpg; echo ""
os9     rdjpgcom jc.jpg
run     rm -rf /dd/tmp/GFXG > /nil 2>/nil; mkdir -p /dd/tmp/GFXG
wait    3
run     builtin cd /dd/tmp/GFXG
wait    1
run     ppmpat -gingham3 48 24 > j.ppm; pbyte j.ppm 2 0a; pbyte j.ppm 8 0a; pbyte j.ppm c 0a
wait    8
run     cjpeg -quality 50 j.ppm > j.jpg; wrjpgcom -comment "OS-9 freeware disk" j.jpg > jc.jpg
wait    14
run     clear
wait    1
run     rdjpgcom jc.jpg; echo ""
wait    6
snap


shot    wrjpgcom
cap     Writes a comment into a JPEG.  The comment is written into a copy,
cap     then rdjpgcom reads it back to show it is there.
try     wrjpgcom -comment "OS-9 freeware disk" j.jpg > jc.jpg; rdjpgcom jc.jpg; echo ""
os9     wrjpgcom -comment "OS-9 freeware disk" j.jpg >-jc.jpg; rdjpgcom jc.jpg
run     rm -rf /dd/tmp/GFXH > /nil 2>/nil; mkdir -p /dd/tmp/GFXH
wait    3
run     builtin cd /dd/tmp/GFXH
wait    1
run     ppmpat -gingham3 48 24 > j.ppm; pbyte j.ppm 2 0a; pbyte j.ppm 8 0a; pbyte j.ppm c 0a
wait    8
run     cjpeg -quality 50 j.ppm > j.jpg
wait    12
run     clear
wait    1
run     wrjpgcom -comment "OS-9 freeware disk" j.jpg > jc.jpg
wait    10
run     rdjpgcom jc.jpg; echo ""
wait    10
snap


shot    wrjpgcom.070
cap     wrjpgcom.070 is wrjpgcom built for the 68000, 68010 and 68070.  It
cap     writes a comment into a copy of a JPEG and rdjpgcom.070 reads it
cap     back.
try     wrjpgcom.070 -comment "68000 build" j.jpg > jc7.jpg; rdjpgcom.070 jc7.jpg; echo ""
os9     wrjpgcom.070 -comment "68000 build" j.jpg >-jc7.jpg; rdjpgcom.070 jc7.jpg
run     rm -rf /dd/tmp/GFXI > /nil 2>/nil; mkdir -p /dd/tmp/GFXI
wait    3
run     builtin cd /dd/tmp/GFXI
wait    1
run     ppmpat -gingham3 48 24 > j.ppm; pbyte j.ppm 2 0a; pbyte j.ppm 8 0a; pbyte j.ppm c 0a
wait    8
run     cjpeg -quality 50 j.ppm > j.jpg
wait    12
run     clear
wait    1
run     wrjpgcom.070 -comment "68000 build" j.jpg > jc7.jpg
wait    10
run     rdjpgcom.070 jc7.jpg; echo ""
wait    10
snap


shot    rdjpgcom.070
cap     rdjpgcom.070 is rdjpgcom built for the 68000, 68010 and 68070.  It
cap     prints the comment wrjpgcom.070 wrote into a JPEG.
try     rdjpgcom.070 jc7.jpg; echo ""
os9     rdjpgcom.070 jc7.jpg
run     rm -rf /dd/tmp/GFXJ > /nil 2>/nil; mkdir -p /dd/tmp/GFXJ
wait    3
run     builtin cd /dd/tmp/GFXJ
wait    1
run     ppmpat -gingham3 48 24 > j.ppm; pbyte j.ppm 2 0a; pbyte j.ppm 8 0a; pbyte j.ppm c 0a
wait    8
run     cjpeg -quality 50 j.ppm > j.jpg; wrjpgcom.070 -comment "68000 build" j.jpg > jc7.jpg
wait    14
run     clear
wait    1
run     rdjpgcom.070 jc7.jpg; echo ""
wait    6
snap

# ---- The Atari Graph library set.  Each program calls the Graph trap
# ---- library, which executes in supervisor state; started from the shell
# ---- it is entered and aborts.  wgen is a Tektronix program and needs none.


shot    graph
cap     The Graph trap library itself -- a type-$0B module, not a program.
cap     It is what g, striche, apfel, sine, showpic, graphdemo and
cap     graphsave call.  modinfo shows what it is: a trap handler library
cap     marked to execute in supervisor state.
try     modinfo graph | head -n 14
os9     modinfo graph ! head -n 14
run     builtin cd /dd/CMDS/GAMES
wait    1
run     clear
wait    1
run     modinfo graph | head -n 14
wait    8
snap


shot    g
size    30 80
cap     With the Graph trap library loaded it starts and is stopped at
cap     once: the dump ends on vector $08, a privilege violation -- an
cap     instruction only the supervisor may run, in a program the shell
cap     started.
try     g
run     load /dd/CMDS/GAMES/graph
wait    4
run     clear
wait    1
run     g
wait    8
snap


shot    striche
size    30 80
cap     With the Graph trap library loaded it starts and is stopped at
cap     once: the dump ends on vector $08, a privilege violation -- an
cap     instruction only the supervisor may run, in a program the shell
cap     started.
try     striche
run     load /dd/CMDS/GAMES/graph
wait    4
run     clear
wait    1
run     striche
wait    8
snap


