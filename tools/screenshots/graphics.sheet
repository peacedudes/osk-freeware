shot    pnmarith
size    28 80
cap     pnmarith multiplies two images of the same size together.  Two
cap     ramps, one left-to-right and one top-to-bottom, multiply into a
cap     corner that fades both ways at once.
try     pgmramp -lr 152 88 > r2.pgm; pgmramp -tb 152 88 > r3.pgm; pnmarith -multiply r2.pgm r3.pgm | pgmtopbm | pbmtoascii -2x4
os9     pgmramp -lr 152 88 >-r2.pgm; pgmramp -tb 152 88 >-r3.pgm; pnmarith -multiply r2.pgm r3.pgm ! pgmtopbm ! pbmtoascii -2x4
run     rm -rf /dd/tmp/PNAR > /nil 2>/nil; mkdir -p /dd/tmp/PNAR
