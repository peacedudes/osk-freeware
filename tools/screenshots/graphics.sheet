wait    1
run     clear
wait    1
run     pgmramp -lr 152 88 > r2.pgm
wait    35
run     pgmramp -tb 152 88 > r3.pgm
wait    35
run     pnmarith -multiply r2.pgm r3.pgm | pgmtopbm | pbmtoascii -2x4
wait    35


