wait    3

shot    mg
cap     Mg, MicroGnuEmacs: Emacs keys in 79K, its documentation under
cap     DOC/mg.  Control-X control-C leaves it.
try     mg tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     mg tmp/EDIT/jabber.txt
wait    8
snap
send    \030\003
wait    3

shot    sedt
cap     SEDT 2.6, a DEC-style keypad editor for a VT100: the ruler at the
cap     top, the file below it, and its key bindings read from
cap     SYS/sedt.keys.
try     sedt tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sedt tmp/EDIT/jabber.txt
wait    8
snap
send    \003
wait    3

shot    new_e
cap     SEDT again, the build that reads TERM to choose its terminal setup;
cap     here it comes up for a VT100.  It needs the same three SYS files as e.
try     new_e tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     new_e tmp/EDIT/jabber.txt
wait    8
snap
send    \003
wait    3

shot    e
cap     SEDT once more, a small fixed VT100 build.  All three read the
cap     same three files in SYS: sedt.keys, sedt.ruler0 and sedt.help.
try     e tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     e tmp/EDIT/jabber.txt
wait    8
snap
send    \003
wait    3

shot    hexed
cap     A hex editor made of your text editor: it writes the file out as
cap     a hex dump, opens that in the editor named by -e, and when you
cap     leave it turns the dump back into the file.  -t names the
cap     directory for the dump.
try     hexed -t=tmp/EDIT -e=vi_nocio tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     hexed -t=tmp/EDIT -e=vi_nocio tmp/EDIT/jabber.txt
wait    10

shot    hexedit
cap     HEXPERT, a hex viewer and editor, on a module from the disk: one
cap     16-byte row and the mode is its whole display.  It reads the
cap     terminal description from TERMCAP as text rather than as a file
cap     name, so the entry is put in the variable first.
try     hexedit CMDS/today
run     . /dd/SYS/termcap.entry
wait    3
run     builtin cd /dd
wait    1
run     clear
wait    1
run     hexedit CMDS/today
wait    12
kill

shot    pbyte
cap     Patches bytes in a file at a hex offset -- the smallest binary
cap     editor here.  Three bytes at offset 0 turn `Twas' into `ABCs'.
try     pbyte tmp/EDIT/pb.txt 0 41 42 43
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r" > /dd/tmp/EDIT/pb.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    3
run     cat tmp/EDIT/pb.txt
wait    3
run     pbyte tmp/EDIT/pb.txt 0 41 42 43
wait    5
run     cat tmp/EDIT/pb.txt
wait    3

shot    chbase
size    40 80
cap     Converts a number between bases: 255 from base 10 to 16 is FF,
cap     and a target base of 0 prints every base from 2 to 36.
try     chbase 255 10 16
run     chbase 255 10 16
wait    4
run     chbase 255 10 0
wait    6

shot    sed
cap     sed, the stream editor, substituting on every line of a file.
try     sed "s/the/THE/g" tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sed "s/the/THE/g" tmp/EDIT/jabber.txt
wait    6

shot    sed_1.06
cap     A second build of sed, kept under its version number, doing the
cap     same substitution.
try     sed_1.06 "s/the/THE/g" tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     sed_1.06 "s/the/THE/g" tmp/EDIT/jabber.txt
wait    6

shot    vi
cap     The genuine Berkeley vi and ex -- `vi -x' is ex, `vi -d' is edit.
cap     It fills the screen on a real terminal; the picture here shows the
cap     first lines it paints before it waits for a command.  Its source is
cap     in SRC/effo_vi.
try     vi tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     vi tmp/EDIT/jabber.txt
wait    15
snap
send    \033
wait    2
quit    \033:q!\r

shot    view
cap     Elvis opened read-only, which is what the name `view' asks of it:
cap     the status line marks the file read-only.
try     view tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     view tmp/EDIT/jabber.txt
wait    8
snap
send    :q!\r
wait    3

shot    vi.elvis
cap     Elvis under the name a Unix hand types.  Kept in CMDS/REBUILT
cap     because CMDS/vi is the Berkeley one.
try     vi.elvis tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     vi.elvis tmp/EDIT/jabber.txt
wait    8
snap
send    :q!\r
wait    3

shot    vi_1.0
cap     PVIC 1.0, the Portable VI Clone, in CMDS/REBUILT because the name
cap     `vi' was taken.
try     vi_1.0 tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     vi_1.0 tmp/EDIT/jabber.txt
wait    8
snap
send    :q!\r
wait    3

shot    vi_cio
cap     PVIC 1.0a, the build that uses Microware's cio.  It reads the
cap     terminal description from TERMCAP as text, so the entry is put in
cap     the variable first.
try     vi_cio tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     . /dd/SYS/termcap.entry
wait    2
run     export TERM=vt100
wait    1
run     builtin cd /dd
wait    1
run     clear
wait    1
run     vi_cio tmp/EDIT/jabber.txt
wait    8
snap
send    :q!\r
wait    3

shot    vi_nocio
cap     PVIC 1.0a, the build that needs no Microware module: the smallest
cap     vi on the disk.
try     vi_nocio tmp/EDIT/jabber.txt
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; printf "Twas brillig, and the slithy toves\r     Did gyre and gimble in the wabe:\rAll mimsy were the borogoves,\r     And the mome raths outgrabe.\r" > /dd/tmp/EDIT/jabber.txt
wait    2
run     builtin cd /dd
wait    1
run     clear
wait    1
run     vi_nocio tmp/EDIT/jabber.txt
wait    8
snap
send    :q!\r
wait    3

shot    ctags.elvis
cap     Builds a tags file for elvis from C source: one line per function,
cap     with the file and a search pattern that finds it.
try     ctags.elvis exrecover.c
run     mkdir -p /dd/tmp/EDIT > /nil 2>/nil; rm -f /dd/tmp/EDIT/tags
run     cp /dd/SRC/effo_vi/exrecover.c /dd/tmp/EDIT/exrecover.c
run     builtin cd /dd/tmp/EDIT
wait    2
run     clear
wait    1
run     ctags.elvis exrecover.c
wait    8
run     cat tags | head -n 8
wait    4
