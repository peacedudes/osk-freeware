# Listing, finding and measuring what is on the disk.

shot    Ascii2Libr
cap     The pair that get data in and out: Ascii2Libr rebuilds a catalogue
cap     from plain text, Libr2Ascii dumps one back to text.
run     Ascii2Libr
wait    5
run     Libr2Ascii
wait    5

shot    Librarian
cap     Home Librarian searching a catalogue -- the program the other five
cap     exist to feed.
run     Librarian
wait    8

shot    PrintCards
cap     PrintCards and PrintLabels, the output half of the same suite.
run     PrintCards
wait    5
run     PrintLabels
wait    5

shot    basename
for     basename dirname owner fstat
cap     basename and dirname take a path apart -- neither prints a newline
cap     after its answer, which is why they run into what follows.  `owner'
cap     then says `No such user' for a file owned 0.0: everything on this
cap     disk is, and SYS/password has no name for that number.
run     basename /dd/CMDS/GAMES/hack
wait    4
run     dirname /dd/CMDS/GAMES/hack
wait    4
run     owner /dd/CMDS/hack
wait    5

shot    chgrp
for     chgrp chown eset
cap     chown and chgrp on a scratch file, with fstat either side to show
cap     the owner actually changed.
run     cp /dd/SYS/motd /dd/tmp/own.txt
wait    5
run     fstat /dd/tmp/own.txt
wait    6
run     chown 1.7 /dd/tmp/own.txt
wait    5
run     fstat /dd/tmp/own.txt
wait    6

shot    dfiles
cap     dfiles hunts for duplicate files and writes the cmp commands that
cap     would prove them identical.
run     dfiles /dd/SYS
wait    10
kill

shot    dir
for     dir mkdir cp mv rm move remove
cap     The everyday file commands, in one sitting: make a directory, copy
cap     into it, rename, list, remove.  `dir' here is the patched build --
cap     its moveq #128 was sign-extended before it was fixed.
run     mkdir /dd/tmp/work
wait    5
run     cp /dd/SYS/motd /dd/tmp/work/one
wait    5
run     mv /dd/tmp/work/one /dd/tmp/work/two
wait    5
run     dir /dd/tmp/work
wait    6
run     rm /dd/tmp/work/two
wait    5

shot    dm
cap     dm, DiskMaster 1.4 -- a full-screen file browser, and it gets as
cap     far as its title box before stopping.  It asks the shell for the
cap     working directory through a named pipe, /pipe/getcwdpipe, and the
cap     open fails with error 216.  Its help file is on the disk as
cap     SYS/dm.hlp; `edir', `dir' and `tree' are what browse here.
run     dm /dd/SYS
wait    5

shot    du
cap     Disk usage by directory.
run     du /dd/SYS
wait    5
kill

shot    du-tree
for     du
cap     du walking a directory tree and adding it up.
run     du /dd/CMDS/GAMES | head -n 21
wait    10

shot    edir
for     edir eset
cap     edir lists the EVENT directory -- OS-9 events, their values and
cap     their wait queues, not files.  There are no events set here, so
cap     what it prints is the heading and the time.  `eset' can only
cap     change an event that already exists, and nothing on this disk
cap     creates one, so it has nothing to link to.
run     edir
wait    8
run     eset -?
wait    8
run     eset testevent 1
wait    8

shot    ff
for     ff
cap     ff hunts for a file by name and asks in German -- `Was soll'n
cap     gesucht wer'n ey ???'  It then EXITS without waiting for an answer,
cap     so there is nothing to type at it.  Measured 2026-08-28.
run     ff
wait    8

shot    find
cap     GNU find 1.1.5, walking this disk.
run     find /dd/SYS -name "cal*" -print
wait    5

shot    fstat
cap     fstat reports a file's status and attributes as RBF holds them.
run     fstat /dd/CMDS/tar
wait    3

shot    l
cap     `l' should list a directory briefly.  It answers `not accessable,
cap     error: 214' for every directory tried here -- which is what it does,
cap     and why DOC/INDEX says so.  `ls', `dir' and `edir' all work.
run     l /dd/CMDS/GAMES
wait    4

shot    ls
cap     GNU ls, our own fixed build -- a real stat(), columns and -al.
run     ls -al /dd/SYS | head -n 18
wait    4

shot    ls-long
for     ls
cap     GNU ls with -al on the collection's own root: the OS-9 attributes
cap     mapped onto the mode bits ls knows how to print.
run     ls -al /dd | head -n 21
wait    8

shot    space
cap     space measures what a directory tree really costs on the disk,
cap     directory by directory.
run     space /dd/SYS
wait    6
kill

shot    tree
for     tree
cap     tree fails on this disk, and the reason is worth keeping: it opens
cap     the RAW DEVICE (/dd@) to walk the directory structure itself, and
cap     os9exec does not offer the raw device of a host directory.
run     tree /dd/SYS
wait    8


shot    filetools
for     dback delbak eunlink EditLibr Libr2Ascii PrintLabels
cap     The last of the file shelf: delbak deletes the *_bak files a whole
cap     tree has collected, and the Home Librarian pair get a catalogue in
cap     and out of plain text.
run     delbak -?
wait    8
run     Libr2Ascii
wait    8
run     EditLibr
wait    8

shot    undel
for     undel
cap     undel asks for a directory and lists what can be brought back --
cap     it PROMPTS, so it is on its own here: a program that stops to ask
cap     reads the next command as its answer.
run     undel
wait    8
send    /dd/tmp\r
wait    10
