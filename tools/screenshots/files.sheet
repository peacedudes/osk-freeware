# Listing, finding and measuring what is on the disk.

shot    Ascii2Libr
cap     The pair that get data in and out: Ascii2Libr rebuilds a catalogue
cap     from plain text, Libr2Ascii dumps one back to text.
run     /dd/CMDS/Ascii2Libr
wait    5
run     /dd/CMDS/Libr2Ascii
wait    5

shot    Librarian
cap     Home Librarian searching a catalogue -- the program the other five
cap     exist to feed.
run     /dd/CMDS/Librarian
wait    8

shot    PrintCards
cap     PrintCards and PrintLabels, the output half of the same suite.
run     /dd/CMDS/PrintCards
wait    5
run     /dd/CMDS/PrintLabels
wait    5

shot    basename
for     basename dirname owner fstat
cap     basename and dirname take a path apart -- neither prints a newline
cap     after its answer, which is why they run into what follows.  `owner'
cap     then says `No such user' for a file owned 0.0: everything on this
cap     disk is, and SYS/password has no name for that number.
run     /dd/CMDS/basename /dd/CMDS/GAMES/hack
wait    4
run     /dd/CMDS/dirname /dd/CMDS/GAMES/hack
wait    4
run     /dd/CMDS/owner /dd/CMDS/hack
wait    5

shot    chgrp
for     chgrp chown eset
cap     chown and chgrp on a scratch file, with fstat either side to show
cap     the owner actually changed.
run     /dd/CMDS/cp /dd/SYS/motd /dd/tmp/own.txt
wait    5
run     /dd/CMDS/fstat /dd/tmp/own.txt
wait    6
run     /dd/CMDS/chown 1.7 /dd/tmp/own.txt
wait    5
run     /dd/CMDS/fstat /dd/tmp/own.txt
wait    6

shot    dfiles
cap     dfiles hunts for duplicate files and writes the cmp commands that
cap     would prove them identical.
run     /dd/CMDS/dfiles /dd/SYS
wait    10
kill

shot    dir
for     dir mkdir cp mv rm move remove
cap     The everyday file commands, in one sitting: make a directory, copy
cap     into it, rename, list, remove.  `dir' here is the patched build --
cap     its moveq #128 was sign-extended before it was fixed.
run     /dd/CMDS/mkdir /dd/tmp/work
wait    5
run     /dd/CMDS/cp /dd/SYS/motd /dd/tmp/work/one
wait    5
run     /dd/CMDS/mv /dd/tmp/work/one /dd/tmp/work/two
wait    5
run     /dd/CMDS/dir /dd/tmp/work
wait    6
run     /dd/CMDS/rm /dd/tmp/work/two
wait    5

shot    dm
cap     dm, the disk and directory monitor -- a full-screen file browser
cap     with its own help.
run     /dd/CMDS/dm /dd/SYS
wait    5

shot    du
cap     Disk usage by directory.
run     /dd/CMDS/du /dd/SYS
wait    5
kill

shot    du-tree
for     du
cap     du walking a directory tree and adding it up.
run     /dd/CMDS/du /dd/CMDS/GAMES | /dd/CMDS/head -n 21
wait    10

shot    edir
cap     edir, the extended directory listing: attributes, owner, size and
cap     dates the way OS-9 keeps them.
run     /dd/CMDS/edir /dd/SYS
wait    4
kill

shot    ff
cap     ff finds files by name anywhere below a directory.
run     /dd/CMDS/ff -p=/dd/CMDS termcap
wait    4

shot    find
cap     GNU find 1.1.5, walking this disk.
run     /dd/CMDS/find /dd/SYS -name "cal*" -print
wait    5

shot    fstat
cap     fstat reports a file's status and attributes as RBF holds them.
run     /dd/CMDS/fstat /dd/CMDS/tar
wait    3

shot    l
cap     l, a brief listing -- names in columns and nothing else.
run     /dd/CMDS/l /dd/CMDS/GAMES
wait    4

shot    ls
cap     GNU ls, our own fixed build -- a real stat(), columns and -al.
run     /dd/CMDS/ls -al /dd/SYS | /dd/CMDS/head -n 18
wait    4

shot    ls-long
for     ls
cap     GNU ls with -al on the collection's own root: the OS-9 attributes
cap     mapped onto the mode bits ls knows how to print.
run     /dd/CMDS/ls -al /dd | /dd/CMDS/head -n 21
wait    8

shot    space
cap     space measures what a directory tree really costs on the disk,
cap     directory by directory.
run     /dd/CMDS/space /dd/SYS
wait    6
kill

shot    tree
for     tree
cap     tree fails on this disk, and the reason is worth keeping: it opens
cap     the RAW DEVICE (/dd@) to walk the directory structure itself, and
cap     os9exec does not offer the raw device of a host directory.
run     /dd/CMDS/tree /dd/SYS
wait    8


shot    filetools
for     dback delbak eunlink EditLibr Libr2Ascii PrintLabels
cap     The last of the file shelf: delbak deletes the *_bak files a whole
cap     tree has collected, and the Home Librarian pair get a catalogue in
cap     and out of plain text.
run     /dd/CMDS/delbak -?
wait    8
run     /dd/CMDS/Libr2Ascii
wait    8
run     /dd/CMDS/EditLibr
wait    8

shot    undel
for     undel
cap     undel asks for a directory and lists what can be brought back --
cap     it PROMPTS, so it is on its own here: a program that stops to ask
cap     reads the next command as its answer.
run     /dd/CMDS/undel
wait    8
send    /dd/tmp\r
wait    10
