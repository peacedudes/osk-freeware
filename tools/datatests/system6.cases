# system6 -- system tools that had no case (2026-09-14, UAC_view 2026-09-23): a 68000
# disassembler run over a module on the disk, and mtools' bad-block scan
# run over the FAT floppy image in /dd/DOS.

family  system6

case    unc-disassembles-pri-to-assembler-source
# unc writes the listing to standard output; pri is a small C program, so
# the listing opens on cstart and names the system calls it makes.
run     /dd/CMDS/unc /dd/CMDS/pri < /nil > /dd/tmp/unc6.a
run     /dd/CMDS/head -n 6 /dd/tmp/unc6.a
run     /dd/CMDS/grep F\$Fork /dd/tmp/unc6.a
run     /dd/CMDS/wc -l /dd/tmp/unc6.a
expect  psect     disas,Typ_Lang,Attr_Rev,Ed,stk,start
expect  os9       F$Fork
expect  1694 /dd/tmp/unc6.a

case    msbadblocks-scans-a-floppy-and-leaves-it-readable
# A good image has no bad clusters, and msbadblocks says nothing about
# the ones it did not find; the test is that it succeeds and that the
# disk still reads afterwards.
run     /dd/CMDS/msbadblocks a: < /nil
run     echo msbadblocks-rc=$?
run     /dd/CMDS/msinfo a:
expect  msbadblocks-rc=0
expect  sectors per track: 18

case    aprocs-lists-the-processes-with-their-cpu-share
run     /dd/CMDS/aprocs < /nil
expect  Id PId Prior  CPU-Time  Proc-Age SYS-% PRC-%  Module-Name
expect  aprocs

case    devprc-shows-each-open-path-and-its-device
run     /dd/CMDS/devprc < /nil
expect  NAME=devprc
expect  PROCESSPATH=0, SYSPATH=
expect  PROCESSPATH=2, SYSPATH=

case    bash-version-fits-its-buffer
# bash builds BASH_VERSION with sprintf("%s.%d") into a 12-byte stack
# buffer, and the shipped dist_version "     1.12" made it 13 with the NUL,
# which cleared the top byte of the saved A5: harmless below 16 MB, a crash
# at start-up above it.  tools/patch_bash_version.py took one leading space
# out on 2026-09-22; this asserts it is still out.
run     echo "[$BASH_VERSION]"
expect  [    1.12.12]

# UAC_view: its options, and that it names PORT when PORT is not set.
# The review pages themselves are on its card; a case cannot drive them,
# because down a pipe it draws the directory and then never sees a key.
case    UAC_view-lists-its-options
run     /dd/CMDS/UAC_view -? < /nil
expect  Utility program to access data files produced by UAC system monitor software.
expect  -w=<Alternative Data Directory>

case    UAC_view-says-when-PORT-is-not-set
run     unset PORT; /dd/CMDS/UAC_view -w=/dd/UAC/DATA < /nil
expect  Environment variable PORT undefined
