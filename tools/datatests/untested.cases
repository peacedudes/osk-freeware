# untested -- programs that had neither a card that ran them nor a case,
# worked out on 2026-09-01/02.
#
# THE FIRST SWEEP GOT FOUR OF THEM WRONG BY TYPING THE WRONG PATH.
# `bincheckr', `mkdict' and `mkindex' are in CMDS/GAMES and `byteflip' is in
# CMDS/NEWS; run as `/dd/CMDS/<name>' all four answer E$PNNF, and it reads
# exactly like a program that cannot find its data.  Nothing was wrong with
# any of them.  That is the same mistake this collection keeps making and it
# is recorded here rather than quietly fixed.
#
# Not assertable here, and why: `config' prints a genuine table of this
# machine's C type properties and then takes an ILLEGAL instruction in its
# floating-point section; `bincheckr' reads the book header and then faults
# at close; `crypto' as a FILTER ends the session even with its output
# redirected.  datatest fails any case whose session took an exception, which
# is right, so those three live on gallery cards instead.

family  untested

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   W=/dd/tmp/UTC
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

case    yagi-designs-a-twelve-element-two-metre-beam
# It READS FROM STANDARD INPUT and asks FIVE questions: centre frequency,
# element count, boom diameter, whether the elements are insulated from the
# boom, and a tubing size off its own list.  Given four answers it loops on
# the fifth forever -- EOF on a numeric read returns the same thing every
# time -- which is how it came to be recorded as silent.
run     echo "144" > $W/y.in
run     echo "12" >> $W/y.in
run     echo "3" >> $W/y.in
run     echo "N" >> $W/y.in
run     echo "3" >> $W/y.in
run     /dd/CMDS/yagi < $W/y.in
expect  This program designs UHF/VHF yagi antennas based on designs by DL6WU.
expect  Frequency: 144.00 MHz
expect  Wavelength: 2.082m
expect  # of elements: 12
expect  Maximum practical gain: 12.8 dBD
expect  Element tubing diameter: 8.7mm
expect  reflector      1017.2                  0.0
expect  director #6     875.5               3206.1

case    crypto-is-a-cryptogram-solver-with-a-real-option-list
# Its bare answer is two lines of usage naming -h and -i; -h is the rest.
run     /dd/CMDS/crypto -h
expect  This program allows you to interactively solve cryptogram puzzles
expect  -e	Encode the input stream with a random cypher.
expect  -cSTR	encode using the Code STR as the encryption cypher.
expect  -i	output the Interactive commands.
expect  fortune -l | crypto -r

case    helpindex-says-what-it-cannot-index
# `helpindex' bare says `Missing names of files to create index for.'  Given
# files it does not want, it names them -- which is more than most programs
# here manage.
run     /dd/CMDS/helpindex
run     /dd/CMDS/helpindex /dd/DOC/README-KSH /dd/DOC/README-CIO
expect  helpindex: Missing names of files to create index for.
expect  ** No index created for file "/dd/DOC/README-KSH".
expect  ** No index created for file "/dd/DOC/README-CIO".

case    the-four-that-are-not-in-CMDS
# The correction, asserted so it cannot be made a third time: at the wrong
# path they answer E$PNNF, at the right one they are there.  `byteflip' is
# only LISTED and not run -- running it ends the emulator session, which the
# newshist card records.
run     /dd/CMDS/bincheckr
run     /dd/CMDS/mkdict
run     /dd/CMDS/ls /dd/CMDS/GAMES/bincheckr /dd/CMDS/GAMES/mkdict /dd/CMDS/GAMES/mkindex /dd/CMDS/NEWS/byteflip
expect  /dd/CMDS/bincheckr:  (E$PNNF)
expect  /dd/CMDS/mkdict:  (E$PNNF)
expect  /dd/CMDS/GAMES/bincheckr
expect  /dd/CMDS/GAMES/mkdict
expect  /dd/CMDS/GAMES/mkindex
expect  /dd/CMDS/NEWS/byteflip

case    casefix-normalises-sentence-case-on-STANDARD-INPUT
# Recorded as silent for two sweeps because it was handed a FILE.  It is a
# filter: `hELLo THERE. this IS a TEST.' comes back sentence-cased.
run     echo "hELLo THERE. this IS a TEST." > $W/case.txt
run     /dd/CMDS/casefix < $W/case.txt
expect  Hello there. This is a test.

case    uuencode-takes-ONE-argument-and-uuexpand-is-not-its-inverse
# `USAGE: uuencode >outfile [infile] name' reads as though it wants two, and
# with two it prints that line and stops.  One argument -- the file -- works.
# `uuexpand' is NOT a uudecoder whatever DOC/INDEX said: its own usage is
# `uuexpand [opts] / or: uuunexpand [opts]' with -8 and -16 for byte
# portability.  `uudecode' is the inverse, and it is on the disk.
run     /dd/CMDS/uuencode /dd/SYS/motd
run     /dd/CMDS/uuencode /dd/SYS/motd motd.out
expect  begin 644 /dd/SYS/motd
expect  USAGE: uuencode >outfile [infile] name

case    bibtex-formats-a-bibliography
# It reads the job name from STANDARD INPUT -- `Please type input file name
# (no extension)--' is a prompt, not silence -- and SYS/TEX/INPUTS carries
# plain, unsrt, abbrv and alpha .bst, which SYS/TEX/BIB (holding one read.me)
# suggests it does not.
#
# A BACKSLASH CANNOT BE TYPED AT THIS SHELL.  bash's echo eats `\c' whatever
# the quoting, so `\citation' arrives as `itation' and bibtex correctly
# reports finding no commands.  `pbyte <file> <hex offset> 5c' puts them
# back, which is what pbyte is for.
run     echo "Xcitation{knuth}" > $W/j.aux
run     echo "Xbibdata{refs}" >> $W/j.aux
run     echo "Xbibstyle{plain}" >> $W/j.aux
run     /dd/CMDS/pbyte $W/j.aux 0 5c
run     /dd/CMDS/pbyte $W/j.aux 11 5c
run     /dd/CMDS/pbyte $W/j.aux 20 5c
run     /dd/CMDS/cat $W/j.aux
run     echo "@book{knuth, author={D. E. Knuth}, title={The TeXbook}, year=1984}" > $W/refs.bib
run     echo "j" > $W/b.in
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/TEXCMDS/bibtex < b.in"
run     /dd/CMDS/cat $W/j.bbl
expect  \citation{knuth}
expect  This is BibTeX, C Version 0.99c
expect  The style file: plain.bst
expect  Database file #1: refs.bib
expect  Warning--empty publisher in knuth
expect  D.~E. Knuth.
expect  {\em The TeXbook}.
absent  I found no

case    makecrc-writes-six-C-source-files-and-says-nothing
# `compute a CRC' is what DOC/INDEX called it, and it prints nothing at all,
# so two sweeps recorded it as silent.  It is a GENERATOR: run it and it
# writes six C source files into the data directory -- a crctab[256] and an
# updcrc() for each of six polynomials -- and takes no arguments to do it.
# Nobody had looked at the directory afterwards.
run     /dd/CMDS/rm -f $W/ccitt.c > /nil 2>/nil
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/makecrc"
run     /dd/CMDS/ls $W
run     /dd/CMDS/head -n 4 $W/ccitt.c
expect  arc.c
expect  binhex.c
expect  ccitt.c
expect  ccitt32.c
expect  kermit.c
expect  zip.c
expect  static unsigned short crctab[256] = {

case    florida-simulates-a-year-of-weather
# Its card has always shown this; there was no case.  The VALUES are random
# per run -- that is what a simulator is -- so the structure is what can be
# asserted: the column headings, the months in order, and the calendar note
# on the first of January.
run     /dd/CMDS/florida < /nil > $W/f.txt 2>&1
run     /dd/CMDS/head -n 4 $W/f.txt
run     /dd/CMDS/grep "^January\|^February\|^March\|^December" $W/f.txt
expect  Year   1    Weather        Sky   Temperature    Precip      Wind  Depth  Notes
expect  January
expect  February
expect  December
expect  New Years

case    the-home-librarian-set-takes-opt-value-not-opt-equals-value
# `PrintLabels' was recorded silent.  It is not: with `-infile=x' it answers
# `Bad option:' and prints its syntax, and so do the other four Home
# Librarian programs.  The options take a SEPARATE argument.
run     /dd/CMDS/Ascii2Libr -outfile=x
run     /dd/CMDS/PrintLabels -infile=x -templatefile=y
expect  Bad option: -outfile=x
expect  Bad option: -infile=x
expect  Syntax: Ascii2Libr [opts]
expect  Syntax: PrintLabels [opts]
expect  Libraian Card Catalog card printer

case    Ascii2Libr-makes-a-catalogue-and-only-from-Libr2Asciis-own-format
# With the options spelled right it creates the file.  A hand-written record
# in the shape SRC/homelibr shows -- `ID #C(:TYPE .. :AUTHOR .. )' -- does
# NOT parse: `Libr2Ascii' reads the result back as a page count and four
# index-key counts, all ZERO.  Which is what Ascii2Libr's own help says --
# "read the ASCII text file GENERATED BY Libr2Ascii" -- so the catalogue has
# to start from a catalogue, and `PrintLabels' printing nothing for it is
# correct: there are no cards in it.
run     /dd/CMDS/rm -f $W/cat.libr > /nil 2>/nil
run     echo "TEX01 #C(:TYPE Book :AUTHOR Knuth :TITLE The TeXbook :YEAR 1984 :DESCRIPTION" > $W/cards.txt
run     echo "typesetting)" >> $W/cards.txt
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/Ascii2Libr -outfile cat.libr < cards.txt"
run     /dd/CMDS/wc -c $W/cat.libr
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/Libr2Ascii -infile cat.libr"
expect  1024 /dd/tmp/UTC/cat.libr
absent  Bad option
absent  Could not open
