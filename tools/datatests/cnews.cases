family  cnews
# C News's relaynews and rn's Pnews (2026-09-23).  The state is reset each
# run -- the image is not -- and the dbz index rebuilt for an empty history.
# rn itself is on its card; it wants a terminal.

setup   set +H
setup   export HOME=/dd USER=tester
setup   W=/dd/tmp/CNT
setup   /dd/CMDS/rm -rf $W /h0/SPOOL/CNEWS/junk /h0/SPOOL/CNEWS/control > /nil 2>/nil
setup   /dd/CMDS/rm -f /h0/SPOOL/CNEWS/in.coming/0local* /h0/USR/LIB/CNEWS/history.dir /h0/USR/LIB/CNEWS/history.pag > /nil 2>/nil
setup   /dd/CMDS/printf 'control 0000000000 00001 y\rjunk 0000000000 00001 y\r' > /h0/USR/LIB/CNEWS/active
setup   /dd/CMDS/printf '0\r' > /h0/USR/LIB/CNEWS/artnum
setup   /dd/CMDS/printf '' > /h0/USR/LIB/CNEWS/history
setup   builtin cd /h0/USR/LIB/CNEWS
setup   /dd/CMDS/NEWS/dbz history
setup   /dd/CMDS/mkdir -p $W

case    relaynews-files-an-article-and-refuses-it-again
run     /dd/CMDS/printf 'Path: somewhere!someone\rFrom: someone@somewhere\rNewsgroups: junk\rSubject: case\rMessage-ID: <1@somewhere>\rDate: 23 Sep 1990 10:00:00 GMT\r\rcase body\r' > $W/art
run     /dd/CMDS/NEWS/relaynews -n < $W/art
run     /dd/CMDS/NEWS/relaynews -n < $W/art
run     /dd/CMDS/cat /h0/SPOOL/CNEWS/junk/1
run     /dd/CMDS/cat /h0/USR/LIB/CNEWS/active
expect  + <1@somewhere>
expect  - <1@somewhere> duplicate
expect  Path: osk!somewhere!someone
expect  junk 0000000001 00001 y

case    Pnews-leaves-a-post-for-relaynews-in-in-coming
run     /dd/CMDS/printf 'Newsgroups: junk\rSubject: posted\r\rpost body\r' > $W/post
run     /dd/CMDS/NEWS/Pnews -h $W/post -s > /nil
run     /dd/CMDS/cat /h0/SPOOL/CNEWS/in.coming/0local1
expect  Newsgroups: junk
expect  From: tester@osk.UUCP
expect  post body

# newsetup writes the .newsrc rn reads into HOME: every group in the
# active file, each marked `!', not subscribed.
case    newsetup-writes-a-newsrc-from-the-active-file
run     /dd/CMDS/rm -f $W/.newsrc
run     HOME=$W /dd/CMDS/NEWS/newsetup
run     /dd/CMDS/cat $W/.newsrc
expect  Creating .newsrc in /dd/tmp/CNT
expect  control!
expect  junk!

# trlf, written for this disk because newsrun calls it: LF to CR in place,
# or standard input to standard output with -s.  A CR file is unchanged.
case    trlf-turns-lf-into-cr-in-place-and-as-a-filter
run     /dd/CMDS/printf 'one\012two\012' > $W/lf
run     /dd/CMDS/NEWS/trlf $W/lf
run     /dd/CMDS/dump $W/lf
run     /dd/CMDS/printf 'three\012' | /dd/CMDS/NEWS/trlf -s > $W/cr
run     /dd/CMDS/dump $W/cr
expect  6F6E 650D 7477 6F0D
expect  7468 7265 650D

# newsrun takes each batch in in.coming through trlf and relaynews, and
# removes it once filed.  It runs trlf through the reader's shell, so trlf
# is loaded for the shell to find.  Pnews's post is cleared first: its
# name starts with a digit, so newsrun would file it too.
case    newsrun-files-a-unix-batch-through-trlf-and-relaynews
load    /h1/CMDS/shell
load    /dd/CMDS/NEWS/trlf
run     /dd/CMDS/rm -f /h0/SPOOL/CNEWS/in.coming/0local* > /nil 2>/nil
run     /dd/CMDS/printf 'Path: far!someone\012From: someone@far\012Newsgroups: junk\012Subject: via newsrun\012Message-ID: <7@far>\012Date: 23 Sep 1990 10:00:00 GMT\012\012unix line endings\012' > /h0/SPOOL/CNEWS/in.coming/1
run     /dd/CMDS/NEWS/newsrun -v
run     /dd/CMDS/cat /h0/SPOOL/CNEWS/junk/*
run     /dd/CMDS/ls /h0/SPOOL/CNEWS/in.coming
expect  Processsing `1' done
expect  Path: osk!far!someone
expect  unix line endings
absent  can't execute
