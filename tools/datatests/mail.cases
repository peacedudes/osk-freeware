family  mail
# Elm and the UUCP mail helpers, against the folder that ships at
# /dd/SPOOL/MAIL/tester.
#
# Two of these assert a DEFECT rather than a success, and they are the most
# useful cases in the file: `frm' and `subscribe' do not do what their
# DOC/INDEX lines said, and the entries now say what they do instead. A case
# that pins a known defect is what stops the entry being "corrected" back to
# the hopeful version by the next person who reads the manual instead of
# running the program.
#
# The alias files this needs -- /dd/.ELM/aliases.text and
# /dd/USR/LIB/ELM/aliases.text -- ship with the collection as of 2026-08-31.
# Before that newalias, listalias and checkalias had nothing to read and the
# gallery card for the Elm suite was a capture of "Couldn't open
# /dd/.ELM/aliases.text for input!".

setup   M=/dd/SPOOL/MAIL/tester
setup   export MAIL=$M
setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
# HOME is what tells Elm where the personal alias file is. Without it
# newalias looked for `/.ELM/aliases.text' and this file's first draft
# tested nothing but that omission.
setup   export HOME=/dd

# The other half of `last.cases' newmail-cannot-find-you-without-USER: given
# the environment SYS/login provides, newmail finds the folder and reports
# its size. Two cases in two files, because the point is the difference.
case    newmail-finds-the-folder-when-USER-is-set
run     export USER=tester
run     /dd/CMDS/ELM/newmail -d
expect  default folder: "/dd/SPOOL/MAIL/tester"
expect  size = 804

case    messages-counts-what-is-in-the-folder
run     /dd/CMDS/ELM/messages
expect  There is 1 message

case    readmsg-prints-a-message-by-number
run     /dd/CMDS/ELM/readmsg 1
expect  Subject: Welcome -- this is a real mail folder
expect  Elm reads mail from a folder

case    readmsg-finds-a-message-by-pattern
run     /dd/CMDS/ELM/readmsg -f $M Welcome
expect  From: The OS-9 Freeware Collection

# KNOWN DEFECT, measured 2026-08-31. frm opens the folder -- it names the
# user rather than reporting that it could not -- and then counts no
# messages in it, where `messages' counts one and `readmsg' prints it. It
# says the same for -s new, -s old and a folder named on the command line.
# Run as the super-user it names tester ("tester has no mail"); run as
# tester it says "You have no mail."  Either way it counts none.
case    frm-sees-no-messages-in-a-folder-that-has-one
run     /dd/CMDS/ELM/frm
expect  no mail
absent  Welcome

# lcasep lowers a line up to its first tab and copies the rest as it is:
# the host name of a pathalias line, not its path.
case    lcasep-lower-cases-an-address
run     echo "Some.Body@Example.COM" > /dd/tmp/name.txt
run     /dd/CMDS/UUCP/lcasep -f /dd/tmp/name.txt
run     /dd/CMDS/printf 'Host.Name\tSome.Path!USER\r' > /dd/tmp/pa.txt
run     /dd/CMDS/UUCP/lcasep -f /dd/tmp/pa.txt
expect  some.body@example.com
expect  host.name	Some.Path!USER

case    pwparse-lists-the-accounts-in-the-password-file
run     /dd/CMDS/UUCP/pwparse /dd/SYS/password
expect  tester
expect  uucp

# newalias compiles both alias files and listalias reads them back. That is
# the assertion, and it holds every time.
#
# SEEN AND NOT MADE TO ORDER: on some runs the FIRST newalias answers
# `** Error writing alias '<the first one>'' and `** Not saving tables!' --
# and leaves usable tables behind anyway, holding that first alias, so a
# second run says `processed 2 aliases.' and means it. Three attempts to pin
# the condition failed: deleting the tables does not bring it back, and it
# depends on something about the state of the session rather than on the
# files. DOC/INDEX therefore tells a reader to run newalias twice the first
# time, which is true whichever way it goes. Do not spend another hour on it
# without a new idea -- this comment is that hour, written down.
case    newalias-compiles-both-alias-files-and-listalias-reads-them
run     /dd/CMDS/ELM/newalias
run     /dd/CMDS/ELM/newalias -g
run     /dd/CMDS/ELM/newalias
run     /dd/CMDS/ELM/newalias -g
run     /dd/CMDS/ELM/listalias
expect  processed 2 aliases
expect  processed 6 aliases
expect  home                 os9-freeware (This Collection)
expect  postmaster           tester (The Postmaster)
expect  everyone             tester,os9 (Everybody On This Machine)

# KNOWN DEFECT. subscribe and unsubscribe leave .newsrc exactly as they
# found it -- the group is neither added nor removed.
case    subscribe-does-not-change-newsrc
run     /dd/CMDS/UUCP/subscribe comp.lang.c
run     /dd/CMDS/cat /dd/.newsrc
expect  comp.os.os9
absent  comp.lang.c

case    the-news-and-mail-commands-reject-input-that-is-not-theirs
run     /dd/CMDS/NEWS/bdecode /dd/SYS/motd
expect  Missing header

case    lmail-delivers-into-a-users-mail-folder
# lmail locks the recipient in SYS/.LOCKS/MAIL.LOCKS, which ships.  Without
# that directory it retries the lock every ten seconds for twenty minutes,
# which reads as a hang.  Delivered to tester, whose folder is put back
# afterwards: os9's folder would do as the super-user, but lmail makes it
# owner-only, and os9 is 0.0, so a case run as tester could not read it.
run     /dd/CMDS/cat /dd/SPOOL/MAIL/tester > /dd/tmp/lmail.save
run     echo "Subject: lmail case" > /dd/tmp/lmail.msg
run     echo "" >> /dd/tmp/lmail.msg
run     echo "Delivered by lmail." >> /dd/tmp/lmail.msg
run     /dd/CMDS/UUCP/lmail tester < /dd/tmp/lmail.msg
run     /dd/CMDS/cat /dd/SPOOL/MAIL/tester
run     /dd/CMDS/cat /dd/tmp/lmail.save > /dd/SPOOL/MAIL/tester
expect  Subject: lmail case
expect  Delivered by lmail.
absent  unknown user

# mailx AGREES WITH rmail AND WITH NEITHER OF THE OTHERS.  Both want the
# mailbox to be a DIRECTORY named for the user; `mail', `messages' and `frm'
# all read the plain file that ships.  mailx looks the name up by NUMBER --
# run as 0.0, whose first entry in SYS/password is `su', it asks for a
# directory named `su' and not `tester', however USER is set.
# Asserted because it is a fact about the disk's mail arrangements, not a
# passing symptom: change the password file or the mailbox shape and this
# case is the one that says so.  Measured 2026-09-21.
case    mailx-wants-a-mailbox-directory-named-for-the-user-number
run     /dd/CMDS/UUCP/mailx
expect  can't change to your mailbox directory
