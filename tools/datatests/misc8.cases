family  misc8
# What is left that CAN be asserted, from the residue.
#
# Several of these pin a program that does NOT work, and each says which of
# the three kinds of not-working it is: wrong invocation, wants hardware
# that is not here, or a defect of its own.  That distinction is the whole
# value -- a reader deciding whether to take a program onto real hardware
# needs to know which.

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   export USER=tester
setup   W=/dd/tmp/MS8
setup   /dd/CMDS/rm -f $W > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   /dd/CMDS/cp /dd/SYS/motd $W/plain.txt

# argproc_demo was rebuilt with MEM=64k on 2026-09-01 and now parses.
# Switches take their argument with NO SPACE.
case    argproc_demo-parses-a-command-line-and-fills-in-its-defaults
run     /dd/CMDS/argproc_demo readme
run     /dd/CMDS/argproc_demo -x99 -sHello readme
expect  arg=readme, b=0, c=0, sGiven=0, s=this is a test, x=32, pi=3.144500
expect  arg=readme, b=0, c=0, sGiven=1, s=Hello, x=99, pi=3.144500

# THE USAGE MESSAGE IS ASKED FOR TWICE, because once did not catch what was
# wrong with it.  Until 2026-09-24 the build linked unixlib's vsprintf,
# which copies twelve words out of the va_list and does not do %f (its own
# header says so) -- and this message has a %f.  The name was missing from
# `Usage:', pi's default read 0.000000, and the program died with a bus
# error inside that copy loop, before any output, whenever the process
# before it had left the wrong things in memory: a second -help in one
# session always, and as tester the first.  Built with `os9' defined it
# uses the author's own OS-9 vsprintf in lose.c and prints all of it,
# every time (measured 2026-09-24).
case    argproc_demo-explains-that-a-switch-takes-no-space
run     /dd/CMDS/argproc_demo -help
run     /dd/CMDS/argproc_demo -help
expect  Usage: /dd/CMDS/argproc_demo file ...
expect  Demonstration program for argproc().  Note that no spaces are allowed
expect  between a switch and its arguments (i.e. -x3 is okay, -x 3 is not allowed).
expect      -piFLOAT Set double pi [default: 3.144500]
absent  vector=

# `oleo' IS NOT A CASE, because it is full-screen and waits for keys: it
# draws its grid and then reads the terminal for ever.  It used to stop
# with `Illegal instruction: 0009 at 000465d2'; it has run since the
# os9exec trap fixes of 2026-09-11 (re-measured 2026-09-26).

# `sysmon' IS NOT A CASE ANY MORE, and the reason is worth keeping.
#
# It used to refuse on a VERSION CHECK -- `OS9/68k V4.0 is too old for SYSMON
# V6.1' -- and this asserted that. On 2026-09-02 os9exec began reporting
# **V4.10** instead of V4.0 (its own commit `Core: report V4.10, the work
# since the v4.0.0 tag'), sysmon accepted it, and the case failed for the
# best possible reason: the program now STARTS.
#
# It cannot be a case in the new state either. It asks whether to create
# `/dd/sys/nodedef', times out on the keyboard, draws its whole Process
# Monitor screen -- `OS9/68k V4.16 Process Monitor V6.1', a task table, two
# percentage rules.  It walks the process table one id at a time with
# F$GPrDsc; until os9exec 143152b (2026-09-14) ids past the table read host
# memory and sometimes answered success, and sysmon took a BUS ERROR.  It
# now stops at E$IPrcID.  It is still not a case -- it is a full-screen
# monitor that runs until stopped -- so tools/playtests/sysmon.keys plays
# it, and its gallery card shows the screen it draws.
# THE LESSON IS THE OTHER ONE: an assertion about the EMULATOR's version is
# an assertion about a moving target, and this is the only one there was.

# The UniBasic pair: the 68000 build beside the 68020 one already tested.
case    ub68kdemo-prints-the-unibasic-banner-for-the-68000
run     /dd/CMDS/DEMOS/ub68kdemo < /nil
expect  UniBasic Version 1.10
expect  DEMO VERSION
expect  Modification expressly forbidden!!!

case    aterm-reads-its-configuration-and-names-it
run     /dd/CMDS/aterm -? < /nil
expect  ATerm

# mtst drives the spline fitter and prints the coefficients it computed.
case    mtst-drives-the-spline-fitter-and-prints-its-coefficients
run     /dd/CMDS/mtst < /nil
expect  a: 1.000000		b: 1.000000		c: 1.000000
expect  i: 1			j: 1			k: 1

# `splman', `splprt' and `lmargin' ARE NOT CASES. All three END THE
# EMULATOR SESSION saying nothing at all -- splman and splprt are the two
# halves of Carl Kreider's spooler and there is no spooler device for
# either to attach to, and lmargin sets a margin on an Epson printer that
# is not there. Measured 2026-09-01, one to a stanza. A case whose session
# took an exception fails by the harness's own rule.
