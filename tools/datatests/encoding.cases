family  encoding
# Encoders prove themselves BY ROUND TRIP: encode, decode, and require the
# md5 of what comes back to equal the md5 of what went in. No reference file
# is needed and the proof is complete.
#
# BUT A ROUND TRIP ALONE IS NOT ENOUGH, and `todos' below is why: a program
# that does NOTHING round-trips perfectly. Every conversion here that should
# alter its input also asserts that it DID.
#
# Subject: /dd/SYS/termcap, 963 bytes, shipped and never regenerated. Its md5
# is the same here as on the host, which is worth knowing in itself -- this
# disk's `md5' agrees with macOS's on the same bytes.
setup   T=/dd/SYS/termcap

case    md5-agrees-with-the-host
run     /dd/CMDS/md5 $T
expect  ee2c20fa226fe6fc78feec7f123c7a99

case    btoa-atob-round-trip
run     /dd/CMDS/btoa < $T > /dd/tmp/t.btoa
run     /dd/CMDS/atob < /dd/tmp/t.btoa > /dd/tmp/t.back
run     /dd/CMDS/md5 /dd/tmp/t.back
expect  ee2c20fa226fe6fc78feec7f123c7a99

case    btoa-really-encodes
run     /dd/CMDS/md5 /dd/tmp/t.btoa
absent  ee2c20fa226fe6fc78feec7f123c7a99

# uuencode's own USAGE line reads `uuencode >outfile [infile] name' and is
# MISLEADING: with two arguments it prints that usage and does nothing, and
# with one it encodes that file. Measured 2026-08-27. 963 bytes in, 1393 out.
case    uuencode-uudecode-round-trip
run     /dd/CMDS/cp $T /dd/tmp/enc.src
run     /dd/CMDS/uuencode /dd/tmp/enc.src > /dd/tmp/t.uu
run     /dd/CMDS/uudecode /dd/tmp/t.uu
run     /dd/CMDS/md5 /dd/tmp/enc.src
expect  ee2c20fa226fe6fc78feec7f123c7a99

case    uuencode-really-encodes
run     /dd/CMDS/wc -c /dd/tmp/t.uu
expect  1393

# `todos' AND `toos9' BOTH DO THEIR WORK AND CANNOT PUT IT BACK. Recorded
# as no-ops on 2026-08-27 because the file handed to them comes back
# byte-identical; measured properly on 2026-09-19 and the conversion was
# there all along, sitting under another name:
#
#   TODOS  Version UTIL 2.80 by DESIGNA VLT 03.08.98
#   Converts TEXT-File from OS9-Format to DOS-Format
#
# Each writes `todos.$$$.<n>' / `toos9.$$$.<n>' IN THE DATA DIRECTORY -- not
# beside the file it was given -- and then forks two OS-9 utilities to move
# it into place. `del' is not on this disk, and OS-9's `rename' takes a NAME
# and not a pathname, so with an absolute target it answers E_BPNAM (215):
#
#   del: not found
#   rename: can't rename to "/dd/tmp/TE/w.txt"Error #000:215 (E_BPNAM)
#
# So stand in the directory, use a bare name, and rename the result
# yourself -- which is what the cases below do. `autolf -c -C -L < in >
# out' converts in one step and renames nothing; it is the easy answer and
# it is on this disk.
#
# THE CONVERSIONS THEMSELVES, on /dd/SYS/termcap (963 bytes, 21 lines):
# todos turns every CR into CR LF and appends ONE STRAY LF at the end, 985
# bytes; toos9 takes CR LF back to CR and leaves that lone LF where it is,
# so the return trip is 964 bytes -- the original plus that one byte. Both
# numbers are asserted, so a build that stops adding the stray byte will
# say so here.
case    todos-leaves-the-file-it-was-given-untouched
run     /dd/CMDS/rm -rf /dd/tmp/TDOS > /nil 2>/nil
run     /dd/CMDS/mkdir -p /dd/tmp/TDOS
run     /dd/CMDS/cp $T /dd/tmp/TDOS/w.txt
run     /dd/CMDS/ksh -c "cd /dd/tmp/TDOS; /dd/CMDS/todos w.txt"
run     /dd/CMDS/md5 /dd/tmp/TDOS/w.txt
expect  ee2c20fa226fe6fc78feec7f123c7a99
expect  rename todos.

case    the-dos-file-todos-could-not-name-is-in-the-data-directory
run     /dd/CMDS/ls /dd/tmp/TDOS
expect  todos.$
run     /dd/CMDS/mv /dd/tmp/TDOS/todos.* /dd/tmp/TDOS/dos.txt
run     /dd/CMDS/wc -c /dd/tmp/TDOS/dos.txt
expect  985

case    toos9-brings-it-back-the-same-way
run     /dd/CMDS/ksh -c "cd /dd/tmp/TDOS; /dd/CMDS/toos9 dos.txt"
run     /dd/CMDS/mv /dd/tmp/TDOS/toos9.* /dd/tmp/TDOS/back.txt
run     /dd/CMDS/wc -c /dd/tmp/TDOS/back.txt
expect  964

case    binhex-produces-hqx
run     /dd/CMDS/binhex $T > /dd/tmp/t.hqx
run     /dd/CMDS/wc -c /dd/tmp/t.hqx
absent  963

case    checksums-agree-with-each-other
run     /dd/CMDS/sum $T
run     /dd/CMDS/checksum $T
run     /dd/CMDS/chksum $T
expect  46801

# cvtbase's STORM lives in maths.cases, which is where the arithmetic
# programs are. It used to be here as well -- `run cvtbase 255 16' with
# `absent usage' and nothing else -- and it passed for the wrong reason: the
# storm contains no `usage', so a case whose only assertion is the absence of
# a word was satisfied by a program that had caught fire. The capture it
# passed on was 207 MEGABYTES, and after os9exec started COUNTING refused
# allocations instead of printing them (2026-08-31) the same case became a
# silent five-minute hang instead.
#
# What is kept here is the cheap half: bare, cvtbase prints the bases it
# knows and does not storm.
case    cvtbase-names-its-bases
run     /dd/CMDS/cvtbase
expect  binary
absent  No more memory

# `autolf' IS THE LINE-ENDING CONVERTER THAT WORKS, found 2026-08-29 while
# checking DOC/INDEX entries nobody had ever run. As a FILTER it turns the
# CR at the end of an OS-9 line into CRLF: 40 bytes in, 41 out. Given a
# FILENAME it converts through a temporary and cannot rename it back, which
# is the same missing rename() that stops zip, arc and todos itself -- and
# todos now says so on screen: `rename todos.$$$.3 ... (E$PNNF)'.
case    autolf-converts-cr-to-crlf-as-a-filter
run     /dd/CMDS/autolf -c -C -L < /dd/SYS/motd > /dd/tmp/al.out
run     /dd/CMDS/wc -c /dd/tmp/al.out
expect  41

case    autolf-cannot-rename-when-given-a-filename
run     /dd/CMDS/cp /dd/SYS/motd /dd/tmp/al2.txt
run     /dd/CMDS/autolf -c -C -L /dd/tmp/al2.txt
expect  couldn't rename

case    todos-fails-for-the-same-reason
run     /dd/CMDS/cp /dd/SYS/motd /dd/tmp/td.txt
# The `(E$PNNF)' half of todos's complaint goes to the TERMINAL, not to
# stderr -- OS-9 reports its own errors there -- so only this line survives
# a pipe.  It is enough: it names the temporary todos could not rename.
run     /dd/CMDS/todos /dd/tmp/td.txt 2>&1
expect  todos.$$$

# btop AND ptob ARE A PAIR, and DOC/INDEX described neither correctly until
# 2026-08-31 ("bitmap to Gepard fat-font"). What they do is characters to bit
# patterns and back, which is how a font or a bitmap crossed a mail system
# that would carry only text. The round trip is the assertion worth having.
case    btop-and-ptob-round-trip-exactly
run     /dd/CMDS/rm -f /dd/tmp/b1 /dd/tmp/b2 /dd/tmp/b3
run     /dd/CMDS/head -n 2 /dd/SYS/motd > /dd/tmp/b1
run     /dd/CMDS/btop /dd/tmp/b1 > /dd/tmp/b2
run     /dd/CMDS/wc -c /dd/tmp/b2
expect  640
run     /dd/CMDS/ptob /dd/tmp/b2 > /dd/tmp/b3
# NOT `cmp' -- THERE IS NO cmp ON THIS DISK, so `absent differ' against it
# passes whatever the files hold. `tcmp' exists and says so in words, and the
# md5 is measured rather than assumed.
run     /dd/CMDS/tcmp /dd/tmp/b1 /dd/tmp/b3
expect  are identical
run     /dd/CMDS/md5 /dd/tmp/b3
expect  f2783580b7a4c5ef6a29ec5895e6ad95
run     /dd/CMDS/cat /dd/tmp/b3
expect  Welcome to os9exec

# ediff does not compare files -- it reformats diff's output. DOC/INDEX called
# it a "visual file compare", which implies the opposite.
case    ediff-reformats-diff-output-rather-than-comparing
run     /dd/CMDS/head -n 3 /dd/SYS/holidays > /dd/tmp/e1
run     /dd/CMDS/sed -e "s/Day/DAY/" /dd/tmp/e1 > /dd/tmp/e2
run     /dd/CMDS/diff /dd/tmp/e1 /dd/tmp/e2 | /dd/CMDS/ediff
expect  1 line changed at 3
run     /dd/CMDS/rm -f /dd/tmp/e1 /dd/tmp/e2 /dd/tmp/b1 /dd/tmp/b2 /dd/tmp/b3

# caesar, morse, ppt and bcd, from 4.3BSD Net/2.
case    caesar-finds-the-shift-by-itself
run     echo "uryyb jbeyq, gur dhvpx oebja sbk whzcf bire gur ynml qbt" | /dd/CMDS/caesar
expect  hello world, the quick brown fox jumps over the lazy dog

case    caesar-13-is-rot13
run     echo "hello" | /dd/CMDS/caesar 13
expect  uryyb

case    morse-s-spells-sos-in-dots-and-dashes
run     /dd/CMDS/morse -s sos
expect  ---,

case    ppt-punches-a-letter-into-paper-tape
run     /dd/CMDS/ppt A
expect  | o   .  o|

case    bcd-punches-a-card
run     /dd/CMDS/bcd OS9
expect  /OS9
