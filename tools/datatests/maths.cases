family  maths
# THE CALCULATORS.  Arithmetic is the one thing on this disk that can be
# checked against a value everybody agrees on, so these cases are short and
# they are exact.
setup   /dd/CMDS/rm -rf /dd/tmp/mt
setup   /dd/CMDS/mkdir /dd/tmp/mt

# THE ANSWER'S DIGITS ARE NOT IN THE OPERANDS, on purpose: `expr 355 / 113'
# expecting `3' would have passed on any error message that quoted 355 or
# 113.  90 / 6 is 15, and neither operand contains a 1 or a 5.
case    expr-does-integer-arithmetic
run     /dd/CMDS/expr 90 / 6
expect  15

case    expr-multiplies
run     /dd/CMDS/expr 7 \* 6
expect  42

case    bash-arithmetic-agrees-with-expr
run     echo $((355/113)) $((7*6))
expect  3 42

# rechne takes ONE expression with no spaces in it -- `4095+1'.  Spaced out,
# it evaluates each argument separately and answers three times, which is
# what its screen in the gallery shows.
case    rechne-answers-in-three-bases-at-once
run     /dd/CMDS/rechne 4095+1
expect  4096
expect  $1000

case    rechne-multiplies-with-x
run     /dd/CMDS/rechne 12x12
expect  144

case    rechne-takes-hex-in
run     /dd/CMDS/rechne \$ff+1
expect  256

# `divide' IS NOT INTEGER DIVISION.  It splits a FILE into pieces -- Farside
# Systems, 1992, `divide -l=<lines> infile outfile'.  DOC/INDEX called it
# integer divide until 2026-08-28.
case    divide-splits-a-file-and-is-not-arithmetic
run     /dd/CMDS/divide
expect  Divide file into pieces

# `cvtbase' NAMES ITS BASES BY KEY -- b, d, h or x, o -- not by number.
#
# THIS CASE USED TO ASSERT THAT IT FLOODED, and that day came: it was
# rebuilt trap-free on 2026-08-31 and it converts. The old case said
# "asserted so that the day either is fixed, this says so", and this is what
# that looks like -- the assertion turned over rather than deleted, so the
# history of the fix is in the file that proves it. `unstr' went the same way;
# tools/datatests/cio11.cases has all eleven.
case    cvtbase-converts-now-that-it-is-rebuilt
run     echo 255 > /dd/tmp/mt/cb.in
run     /dd/CMDS/cvtbase d b < /dd/tmp/mt/cb.in
run     /dd/CMDS/cvtbase d h < /dd/tmp/mt/cb.in
expect  11111111
expect  ff
absent  No more memory

case    cvtbase-prints-its-bases-when-asked
run     /dd/CMDS/cvtbase
expect  h or x  hexadecimal

case    sqrtx-agrees-with-arithmetic
run     /dd/CMDS/sqrtx
expect  1.41421

# `rpn' PUSHES A ZERO WHERE THE SUM SHOULD BE: 12, 34, + leaves a stack of
# three with 0 on top instead of one with 46.  Asserted so it fails the day
# it is fixed.
case    rpn-still-gets-the-sum-wrong
run     echo 12 > /dd/tmp/mt/in
run     echo 34 >> /dd/tmp/mt/in
run     echo + >> /dd/tmp/mt/in
run     echo q >> /dd/tmp/mt/in
run     /dd/CMDS/rpn < /dd/tmp/mt/in
absent  stack top: 46

# `hc' answers with its usage line to every form of invocation tried,
# including the one its own usage names.
case    hc-still-only-prints-its-usage
run     echo "1f + 3" | /dd/CMDS/hc
expect  usage:
