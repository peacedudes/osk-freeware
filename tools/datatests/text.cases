family  text
# THE TEXT TOOLS, proved on data rather than on whether they printed.
#
# Most of these came out of photographing the disk on 2026-08-27/28: several
# of the programs here answer a form of invocation nobody would guess, and
# three of them do not work at all.  A case that asserts a program's ERROR is
# not a joke -- it passes today and fails the day the program is fixed, which
# is the signal you want and does not inflate the count of expected failures.
#
# Subject: a four-line file this family writes for itself, so the cases do
# not depend on the disk's own text staying what it is.
setup   T=/dd/tmp/text.src
setup   /dd/CMDS/cat /dd/SYS/motd > /dd/tmp/text.src
setup   echo "alpha beta gamma" >> /dd/tmp/text.src
setup   echo "delta epsilon zeta" >> /dd/tmp/text.src
setup   echo "alpha beta gamma" >> /dd/tmp/text.src

# All three columns, not just the line count: `4' alone would pass on any
# message that happened to contain a 4.
case    wc-counts-what-is-there
run     /dd/CMDS/wc $T
expect  4     15     93

case    sed-substitutes
run     /dd/CMDS/sed "s/beta/BETA/" $T
expect  alpha BETA gamma

case    sed-reads-a-pipe-too
run     /dd/CMDS/cat $T | /dd/CMDS/sed -n "/delta/p"
expect  delta epsilon zeta

# The build that shipped as `sed' until 2026-08-28 answered every script with
# this, and the one here now must not.
case    sed-does-not-run-out-of-memory
run     /dd/CMDS/sed "s/a/A/g" $T
absent  No more memory

# Uppercase sorts before lowercase, so the motd line comes first -- which is
# what a byte-order sort MEANS and is worth pinning down.
case    sort-orders-lines
run     /dd/CMDS/sort $T | /dd/CMDS/head -n 1
expect  Welcome to os9exec

case    uniq-drops-the-repeat
run     /dd/CMDS/sort $T | /dd/CMDS/uniq -c | /dd/CMDS/grep alpha
expect  2 alpha beta gamma

case    tac-reverses
run     /dd/CMDS/tac $T | /dd/CMDS/head -n 1
expect  alpha beta gamma

# `tail' here is DESIGNA's, not GNU's: it takes -l=<x> and refuses -n.  head
# is the GNU one and takes -n.  Two programs on one disk, two conventions.
# ASSERTS CONTENT, NOT A COUNT.  The earlier form expected `3' from a
# command whose own arguments contained a 3, so an error message quoting them
# would have passed it -- the same shape as the `shar' false pass.
case    head-takes-dash-n
run     /dd/CMDS/head -n 2 $T
expect  alpha beta gamma
absent  delta epsilon zeta

case    tail-takes-dash-l-and-refuses-dash-n
run     /dd/CMDS/tail -l=1 $T
expect  alpha beta gamma

case    tail-says-so-when-given-dash-n
run     /dd/CMDS/tail -n 1 $T
expect  unknown option

case    grep-finds-and-counts
run     /dd/CMDS/grep -c alpha $T
expect  2

case    fgrep-agrees-with-grep
run     /dd/CMDS/fgrep alpha $T | /dd/CMDS/wc -l
expect  2

# sepwords writes one word a line and NO terminator after the last, so `wc
# -l' counts one fewer than there are words.  Asserted here so that the day
# it grows one, this says so.
case    sepwords-splits-to-one-a-line
run     echo "one two three" | /dd/CMDS/sepwords | /dd/CMDS/wc -l
expect  2

case    soundex-keys-the-sound-not-the-spelling
run     echo Robert | /dd/CMDS/sepwords | /dd/CMDS/soundex
expect  R163

# `rot' is NOT a rot-13 cipher, whatever the name suggests: it turns the file
# on its side, so the first line becomes the first column.  Three lines of
# `abc' rotate to three columns of `a', `b', `c'.
case    rot-turns-the-file-on-its-side
run     echo abc > /dd/tmp/rot.src
run     echo abc >> /dd/tmp/rot.src
run     /dd/CMDS/rot /dd/tmp/rot.src
expect  cc

case    detab-removes-the-tabs
run     /dd/CMDS/detab $T | /dd/CMDS/grep -c "	"
expect  0

case    cut-takes-a-field
run     /dd/CMDS/cut -d, -f1 /dd/SYS/password | /dd/CMDS/head -n 1
expect  su

case    charcnt-counts-characters
run     /dd/CMDS/charcnt < $T
absent  can't

# gawk IGNORES A FILENAME ARGUMENT and reads standard input whatever it is
# given.  Named a file it sits waiting on the terminal, which is why this was
# once recorded as "reads no input".  Both halves are asserted: redirected it
# counts the lines, named it produces nothing.
case    gawk-counts-lines-on-stdin
run     /dd/CMDS/gawk "END{print NR\" records\"}" < $T
expect  4 records

case    gawk-ignores-a-filename-argument
run     echo "" | /dd/CMDS/gawk "END{print NR\" records\"}" $T
expect  1 records

# `nsort' IS NOT A NUMERIC SORT, whatever its name and DOC/INDEX said until
# 2026-08-29: it answers exactly what GNU `sort' answers with no options.
# `sort -n' is the numeric sort on this disk.
case    nsort-sorts-lexically-not-numerically
run     echo 3 > /dd/tmp/ns.txt
run     echo 22 >> /dd/tmp/ns.txt
run     echo 111 >> /dd/tmp/ns.txt
run     /dd/CMDS/nsort < /dd/tmp/ns.txt
expect  111
absent  3 22 111

case    sort-n-is-the-numeric-one
run     /dd/CMDS/sort -n /dd/tmp/ns.txt > /dd/tmp/ns.out
run     /dd/CMDS/cat /dd/tmp/ns.out
expect  3

# `printf' WORKS, with one flaw: the literal text BEFORE THE FIRST CONVERSION
# is dropped.  Everything between and after conversions is right.  These four
# cases fix the rule from both sides, because the first version of this note
# read as though printf were simply broken and it is not.  DOC/INDEX said it
# floods `No more memory !!!' until 2026-08-29; it does not.
case    printf-is-right-when-the-format-starts-with-a-conversion
run     /dd/CMDS/printf "%d %s %d\n" 4 "is bigger than " 3
expect  4 is bigger than  3

case    printf-keeps-every-literal-after-the-first-conversion
run     /dd/CMDS/printf "a%db%dc\n" 1 2
expect  1b2c
absent  a1b2c

case    printf-drops-what-comes-before-the-first-conversion
run     /dd/CMDS/printf "[%s]\n" X
expect  X]
absent  [X]

case    printf-prints-nothing-without-a-conversion
run     /dd/CMDS/printf "hello\n" x
absent  hello

# The build that shipped as `m4' until 2026-08-28 expanded this as `i hr ';
# the alternate build, now shipping, gets it right.
case    m4-expands-a-macro
run     echo "define(G,hi \$1)G(there)" > /dd/tmp/m.src
run     /dd/CMDS/m4 < /dd/tmp/m.src
expect  hi there

# LAST ON PURPOSE: subber's F$Mem failure takes the whole emulator session
# with it, so every case after it would report `never ran'.
case    subber-still-calls-an-unimplemented-syscall
run     echo ",a,A," > /dd/tmp/sub.words
run     /dd/CMDS/subber /dd/tmp/sub.words $T
expect  F$Mem

# RTF/68K COMPILES, measured 2026-08-29.  Its runtime library has to be in the
# module directory first; without `load os9lib' the whole Fortran set prints
# nothing, which is what the card used to show and all anyone had recorded.
# Call `rtf' DIRECTLY -- the `for' driver forks a program called `shell' to
# run it and this disk has none, so it prints the command and stops.
case    rtf-compiles-fortran-to-68k-assembly
run     /dd/CMDS/load /dd/CMDS/os9lib
run     /dd/CMDS/rm -f /dd/SRC/rtf/div.a
run     /dd/CMDS/rtf /dd/SRC/rtf/div.f
expect  Total Errors   0
expect  RTF normally completed

case    and-leaves-the-assembly-beside-the-source
run     /dd/CMDS/wc -c /dd/SRC/rtf/div.a
expect  1008

case    the-for-driver-cannot-fork-the-compiler
run     /dd/CMDS/for /dd/SRC/rtf/div.f
expect  compilation aborted

# `wisecrack' AND `ask' ARE A PAIR, found 2026-08-29.  Every sweep of this
# disk scored both as mute because neither does anything alone: wisecrack is
# a server that feeds lines through /PIPE/txtpipe and ask is its client.
# Start the server in the background and ask answers.
case    ask-says-so-when-nothing-feeds-the-pipe
run     /dd/CMDS/ask "nothing there"
expect  No Wisecracks coming

# THE SERVER NEEDS A MOMENT.  There is no `sleep' on this disk, so the two
# `ls' lines below are the delay -- without them ask runs before wisecrack
# has opened the pipe and the case fails on a race, not on the programs.
case    wisecrack-and-ask-work-as-a-pair
run     /dd/CMDS/GAMES/wisecrack &
run     /dd/CMDS/ls /dd/CMDS > /nil
run     /dd/CMDS/ls /dd/CMDS > /nil
run     /dd/CMDS/ask "and now"
absent  No Wisecracks coming

# `ksh' CAN BE THE FIRST SHELL, re-measured 2026-08-29.  DOC/README-RUNNING
# said it could not -- that it wanted cio loaded and so needed a shell first
# -- which was true before the five Microware modules shipped here.  This
# case runs a command THROUGH ksh from the outer bash, which is the same
# fork path that was said to be impossible.
case    ksh-forks-an-external-command
run     /dd/CMDS/ksh -c "/dd/CMDS/chksum /dd/SYS/motd"
expect  4b68af85
