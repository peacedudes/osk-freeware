# netpbm6 -- two netpbm programs that had no case (2026-09-14).

family  netpbm6

setup   W=/dd/tmp/NP6
setup   /dd/CMDS/rm -rf $W > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

case    pgmcrater-makes-a-graymap-the-size-asked
run     /dd/CMDS/NETPBM/pgmcrater -number 300 -xsize 40 -ysize 30 < /nil > $W/c.pgm
run     /dd/CMDS/NETPBM/pnmfile $W/c.pgm
expect  PGM raw, 40 by 30  maxval 255

case    pbmtobbnbg-writes-bitgraph-codes
run     /dd/CMDS/NETPBM/pbmmake -black 8 8 > $W/b.pbm
run     /dd/CMDS/NETPBM/pbmtobbnbg < $W/b.pbm > $W/b.bg
run     /dd/CMDS/xd -c $W/b.bg
expect  1B 50 3A 33 3B 38 3B 38  73 0D 50 20 50 20 50 20 | .P:3;8;8s.P P P

case    rayshade-names-the-preprocessor-it-could-not-start
# rayshade runs its scene through cccp by popen(), and popen() forks a module
# named `shell' -- the reader's own OS-9's, which this harness does not borrow.
# So what is asserted here is the command it builds and that it says so
# plainly; the render itself is on its card, taken with Microware's shell
# loaded from /h1.  No stand-in `shell' may be made from another program.
run     /h1/CMDS/load /dd/CMDS/GCC139/gcc_cccp
run     /dd/CMDS/ksh -c "cd /dd; /dd/CMDS/rayshade -R 32 24 -O tmp/ray6.pic GAMES/rayshade/boxball.ray" < /nil
expect  popen of "cccp  GAMES/rayshade/boxball.ray" failed!

case    rsconvert-turns-a-rayshade-3-scene-into-rayshade-4
run     echo "screen 32 24" > /dd/tmp/rsc6.ray
run     echo "light 1 directional 0 0 1" >> /dd/tmp/rsc6.ray
run     /dd/CMDS/rsconvert /dd/tmp/rsc6.ray < /nil
expect  /* Converted by rsconvert */
expect  screen 32 24
expect  directional 0 0 1
absent  Stack Overflow
