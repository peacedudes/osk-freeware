family  misc7
# Two programs already driven in `cio29.drive' that never got a case: the
# loan calculator and the disk allocation map.  Both produce a lot of
# output and both are exactly reproducible.

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   W=/dd/tmp/MS7
setup   /dd/CMDS/rm -f $W > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

# loan asks five questions and then prints a full amortisation schedule.
# Every number in it is arithmetic, so the whole thing is checkable -- and
# the first payment splitting 143.47 into 43.47 of principal and 100.00 of
# interest on a 10,000 loan at 12% is the arithmetic being right.
case    loan-prints-an-amortisation-schedule-that-adds-up
run     echo "10000" > $W/loan.in
run     echo "10" >> $W/loan.in
run     echo "12" >> $W/loan.in
run     echo "" >> $W/loan.in
run     echo "s" >> $W/loan.in
run     /dd/CMDS/loan < $W/loan.in
expect  Principal:  10000.00
expect  Future value:  17216.52
expect  Total Interest Charge:  7216.52
expect  Payment:  143.47
expect  1	 43.47		 100.00		 9956.53
expect  		Interest paid for year 1 is 1264.82

# dam draws the disk allocation map, one character per cluster. On a 253 MB
# image that is a great many lines, so what is asserted is the header --
# which names the cluster size RBF actually formatted the disk with.
case    dam-reports-the-cluster-size-and-draws-the-allocation-map
run     /dd/CMDS/dam /dd < /nil
expect  | = cluster (1024 Bytes) allocated or defective
expect  #000000 ////////////////////////////////////////////////////////////////

case    unzip-lists-what-it-can-do-with-a-zip-archive
run     /dd/CMDS/unzip
expect  UnZip:  Zipfile Extract v5.0 of 21 August 1992;  (c) 1989 S.H.Smith and others
expect  OSK Version 1.1 By Ricky Beam 10/16/93
expect    -t  test archive integrity
expect    -a  convert text (CR LF => LF)

# des takes FILES and nothing else -- no -e/-d, no -k. `-e' earns
# `Can't read -e.' because it is read as a filename, and `-?' the same.
case    des-takes-files-and-has-no-option-flags-at-all
run     /dd/CMDS/des
run     /dd/CMDS/des -?
expect  Usage: des file ...
expect  Can't read -?.

# lout runs and gets as far as its own package system: `@SysInclude { doc }'
# needs the `doc' package, which is not on this disk. It names the file,
# the line and the column, which is a working formatter failing honestly.
case    lout-runs-and-names-the-package-it-cannot-find
run     /dd/CMDS/rm -f $W/d.lt > /nil 2>/nil
run     echo "@SysInclude { doc }" > $W/d.lt
run     /dd/CMDS/lout $W/d.lt
expect  cannot open doc
expect  fatal error: Exiting now

case    gs403-reports-its-version-and-wants-its-initialisation-file
run     /dd/CMDS/gs403 -v
run     echo "quit" > $W/q.ps
run     /dd/CMDS/gs403 -q -dNOPAUSE -sDEVICE=nullpage $W/q.ps
expect  Aladdin Ghostscript 4.03 (1996-9-23)
expect  Copyright (C) 1996 Aladdin Enterprises, Menlo Park, CA.
expect  Can't find initialization file gs_init.ps.

case    wam-sbprolog-states-the-arguments-of-its-wam-engine
run     /dd/CMDS/wam.sbprolog < /nil
expect  Usage: sim [-Ttdns] [-m s_size] [-p p_size] [-b tr_size] [-ui num] pil_file_name ...

case    disktest-explains-that-it-has-one-option
run     /dd/CMDS/disktest -?
expect  Function : measure diskperformance
expect  Options  : -?  show this text
expect    V1.0, written by Stephan Paschedag

# undel scans a directory for entries RBF has marked deleted and offers to
# bring each back. On a directory with nothing deleted it says where it
# looked and stops.
case    undel-scans-the-directory-it-is-given
run     /dd/CMDS/undel $W < /nil
expect  U N D E L E T E    V1.1   by  Stephan Enzler
expect  Undeleting in Directory: /dd/tmp/MS7
