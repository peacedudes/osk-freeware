family  archives
# Archivers and compressors prove themselves BY ROUND TRIP: pack, unpack,
# and require the md5 of what comes back to equal the md5 of what went in.
# Subject: /dd/SYS/termcap, 963 bytes, md5 ee2c20fa226fe6fc78feec7f123c7a99.
setup   T=/dd/SYS/termcap

case    compress-round-trip
run     /dd/CMDS/compress -c < $T > /dd/tmp/z.Z
run     /dd/CMDS/compress -dc < /dd/tmp/z.Z > /dd/tmp/z.out
run     /dd/CMDS/md5 /dd/tmp/z.out
expect  ee2c20fa226fe6fc78feec7f123c7a99

case    compress-really-compresses
run     /dd/CMDS/wc -c /dd/tmp/z.Z
expect  631

case    gzip-round-trip
run     /dd/CMDS/gzip -c < $T > /dd/tmp/g.gz
run     /dd/CMDS/gzip -dc < /dd/tmp/g.gz > /dd/tmp/g.out
run     /dd/CMDS/md5 /dd/tmp/g.out
expect  ee2c20fa226fe6fc78feec7f123c7a99

case    gzip-really-compresses
run     /dd/CMDS/wc -c /dd/tmp/g.gz
expect  553

case    gzip-reads-what-compress-wrote
run     /dd/CMDS/gzip -dc < /dd/tmp/z.Z > /dd/tmp/zg.out
run     /dd/CMDS/md5 /dd/tmp/zg.out
expect  ee2c20fa226fe6fc78feec7f123c7a99

# tar stores the pathname it was GIVEN and does not strip a leading slash,
# so `tar xf' writes back to the absolute path. Measured 2026-08-27.
case    tar-round-trip
run     /dd/CMDS/cp $T /dd/tmp/tarme.txt
run     /dd/CMDS/tar cf /dd/tmp/t.tar /dd/tmp/tarme.txt
run     /dd/CMDS/rm /dd/tmp/tarme.txt
run     /dd/CMDS/tar xf /dd/tmp/t.tar
run     /dd/CMDS/md5 /dd/tmp/tarme.txt
expect  ee2c20fa226fe6fc78feec7f123c7a99

case    tar-lists-what-it-stored
run     /dd/CMDS/tar tvf /dd/tmp/t.tar
expect  963
expect  tarme.txt

case    zoo-adds-and-lists
run     /dd/CMDS/zoo a /dd/tmp/a.zoo $T
run     /dd/CMDS/zoo l /dd/tmp/a.zoo
expect  963
expect  1 file

case    booz-reads-a-zoo
run     /dd/CMDS/booz -l /dd/tmp/a.zoo
absent  error

# KNOWN FAILURE, found 2026-08-27. Info-ZIP `zip' deflates correctly and then
# CANNOT PUT THE RESULT ANYWHERE. It writes a temporary (_Z000003), fails to
# rename it over the target, and says so:
#
#   adding dd/SYS/termcap (deflated 44%)
#   zip warning: new zip file left as: _Z000003
#   zip error: file not found
#   zip error: Could not create output file (was replacing the original zip file)
#
# Reproduced writing into /dd/tmp and into /dd, so it is not one bad
# directory. The deflate works; only the finalising rename fails. `unzip'
# cannot be judged until there is an archive for it to read -- use zoo, tar
# or gzip meanwhile. Kept failing on purpose.
case    zip-cannot-write-its-archive
run     /dd/CMDS/zip /dd/tmp/a.zip $T
absent  Could not create output file

# THE REST OF THE FAMILY, 2026-08-28.  Every archiver on this disk that can
# be driven from a script is now here, and each one proves itself by the
# round trip: pack, take the original away, unpack, and require the md5 back.
# The commands differ more than you would expect -- `lha a', `ar -u', `marc
# -a', `zoo a' -- which is exactly why they are worth pinning down.

case    lha-round-trip
run     /dd/CMDS/cp $T /dd/tmp/lhame.txt
run     /dd/CMDS/lha a /dd/tmp/a.lzh /dd/tmp/lhame.txt
run     /dd/CMDS/rm /dd/tmp/lhame.txt
run     /dd/CMDS/lha x /dd/tmp/a.lzh
run     /dd/CMDS/md5 /dd/tmp/lhame.txt
expect  ee2c20fa226fe6fc78feec7f123c7a99

case    lha-lists-with-a-ratio
run     /dd/CMDS/lha l /dd/tmp/a.lzh
expect  963

case    lharc-makes-an-archive-lha-can-read
run     /dd/CMDS/lharc a /dd/tmp/b.lzh $T
run     /dd/CMDS/lha l /dd/tmp/b.lzh
expect  963

# `ar' REFUSES AN ABSOLUTE PATH -- "absolute path illegal </dd/SYS/termcap>"
# -- so everything it is given must be relative to the data directory, which
# here is /dd.  That is a real constraint on this disk, where `cd' in bash
# does not move the data directory at all.
case    ar-adds-and-lists
run     /dd/CMDS/ar -u tmp/a.ar SYS/termcap
run     /dd/CMDS/ar -t tmp/a.ar
expect  SYS/termcap
expect  file name

case    ar-refuses-an-absolute-path
run     /dd/CMDS/ar -u tmp/b.ar /dd/SYS/termcap
expect  absolute path illegal

case    ar2-reads-what-ar-wrote
run     /dd/CMDS/ar2 -t tmp/a.ar
expect  SYS/termcap

# `marc' IS NOT AN ARCHIVER.  It is MARC, the archive MERGER: `marc <target>
# <source> [names]' copies members from one .arc into another.  DOC/INDEX
# called it "MARC archiver" until 2026-08-28.  With no .arc to merge -- `arc'
# cannot write one, below -- what can be asserted is what it says it is.
case    marc-is-a-merger-not-an-archiver
run     /dd/CMDS/marc
expect  archive merger

# `arc' FAILS EXACTLY AS `zip' DOES: it compresses the file, writes a
# temporary (.Arc3.arc), and then cannot put it where it belongs --
# "Cannot rename .Arc3.arc to tmp/y.arc", Error 226 (E_NOCHLD).  Measured
# with relative and absolute targets, in /dd and in /dd/tmp.
#
# WHY: this C library has neither rename() nor link() -- a probe written for
# it fails to link both, `Symbol 'rename' unresolved'.  Both archivers were
# ported from Unix, where finishing an archive means renaming or linking the
# temporary over the target.  DOC/STATUS has the measurement, including the
# way it first came out wrong.
# ONE BROKEN CHECK is all that stops `shar'. Its read-access test rejects
# every file that EXISTS; hand it a name that is not there and the check
# passes vacuously and out comes the whole preamble. Both halves are asserted
# so that the day the check is fixed, the first of these fails.
#
# This case used to be a FALSE PASS worth keeping the story of: it asserted
# that `motd' appeared in the output, and it does -- inside `No read access
# for file: /dd/SYS/motd'. Corrected 2026-08-29.
case    shar-refuses-every-file-that-exists
run     /dd/CMDS/shar /dd/SYS/motd > /dd/tmp/a.shar
run     /dd/CMDS/cat /dd/tmp/a.shar
expect  No read access for file
absent  Shell Archiver

case    shar-writes-its-preamble-for-a-file-that-is-not-there
run     /dd/CMDS/shar not-a-file-here > /dd/tmp/b.shar 2>/nil
run     /dd/CMDS/cat /dd/tmp/b.shar
expect  This is a shell archive
expect  cut here

case    zoo-2.1-reads-what-zoo-wrote
run     /dd/CMDS/REBUILT/zoo_2.1 l /dd/tmp/a.zoo
expect  963

case    compress_4.0-agrees-with-compress
run     /dd/CMDS/REBUILT/compress_4.0 -dc < /dd/tmp/z.Z > /dd/tmp/c4.out
run     /dd/CMDS/md5 /dd/tmp/c4.out
expect  ee2c20fa226fe6fc78feec7f123c7a99

case    the-four-gzip-builds-all-read-the-same-file
run     /dd/CMDS/REBUILT/gzip68k_nocsl -dc < /dd/tmp/g.gz > /dd/tmp/g1.out
run     /dd/CMDS/REBUILT/gzip020_nocsl -dc < /dd/tmp/g.gz > /dd/tmp/g2.out
run     /dd/CMDS/md5 /dd/tmp/g1.out /dd/tmp/g2.out
expect  ee2c20fa226fe6fc78feec7f123c7a99

case    gtar-reads-what-tar-wrote
run     /dd/CMDS/REBUILT/gtar tf /dd/tmp/t.tar
expect  tarme.txt

# THE ZIP READERS, 2026-09-04.  `zip' cannot write an archive here (above), so
# DOC/zip/sample.zip ships as one for them to read: unzip's own `readme'
# (4033 bytes, deflated) and `ziprules' (5218 bytes, stored).  Each reader
# proves itself against the md5 of the file it was made from.
case    zipinfo-lists-the-sample
run     /dd/CMDS/zipinfo /dd/DOC/zip/sample.zip
expect  2 files
expect  ziprules

case    unzip-extracts-the-sample
run     /dd/CMDS/rm -rf /dd/tmp/UNZC
run     /dd/CMDS/mkdir /dd/tmp/UNZC
run     /dd/CMDS/ksh -c "cd /dd/tmp/UNZC; /dd/CMDS/unzip -o /dd/DOC/zip/sample.zip"
run     /dd/CMDS/md5 /dd/tmp/UNZC/readme
expect  7b7aa8ced5818e930b45a08a2439c03c
run     /dd/CMDS/md5 /dd/tmp/UNZC/ziprules
expect  cb0183b20aaca4269066d5fb68072c81

case    funzip-inflates-the-first-member
run     /dd/CMDS/funzip < /dd/DOC/zip/sample.zip > /dd/tmp/funz.out
run     /dd/CMDS/md5 /dd/tmp/funz.out
expect  7b7aa8ced5818e930b45a08a2439c03c

case    zipnote-names-both-members
run     /dd/CMDS/zipnote /dd/DOC/zip/sample.zip
expect  @ readme
expect  @ ziprules

case    zipsplit-makes-two-pieces
run     /dd/CMDS/rm -rf /dd/tmp/ZSPC
run     /dd/CMDS/mkdir /dd/tmp/ZSPC
run     /dd/CMDS/ksh -c "cd /dd/tmp/ZSPC; /dd/CMDS/zipsplit -n 6000 /dd/DOC/zip/sample.zip"
expect  2 zip files will be made
run     /dd/CMDS/zipinfo /dd/tmp/ZSPC/sample2.zip
expect  1 file

# unshar unpacks a shell archive with its own interpreter.  The sample is the
# which6 posting; its three files must come back byte for byte as the
# posting carries them (the md5s of SRC/which/ORIG).
case    unshar-unpacks-which6-byte-for-byte
run     /dd/CMDS/rm -rf /dd/tmp/UNSH
run     /dd/CMDS/mkdir -p /dd/tmp/UNSH
run     /dd/CMDS/ksh -c "cd /dd/tmp/UNSH; /dd/CMDS/unshar -n /dd/DOC/unshar/which6.shar"
run     /dd/CMDS/md5 /dd/tmp/UNSH/which6.c /dd/tmp/UNSH/which.1 /dd/tmp/UNSH/Makefile
expect  ec84e20efff9c28ab281eb5dec8c75b2
expect  426c0d5a368e7bde7adb72959c0aee67
expect  d400a25907e0ac0d3edf8ec6c443f056

# The same archive on standard input, into a directory -d makes.
case    unshar-reads-standard-input-into-a-new-directory
run     /dd/CMDS/rm -rf /dd/tmp/UNSD
run     /dd/CMDS/cat /dd/DOC/unshar/which6.shar | /dd/CMDS/unshar -n -d /dd/tmp/UNSD
run     /dd/CMDS/md5 /dd/tmp/UNSD/which6.c
expect  ec84e20efff9c28ab281eb5dec8c75b2
