# flagged -- the invocations that came out of chasing the last six gallery
# cards audit_cards.py called help-only, on 2026-09-01.
#
# Four of the six turned out to have a real invocation nobody had tried; two
# did not, and their reasons are measured here rather than assumed.

family  flagged

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   W=/dd/tmp/FLC
setup   /dd/CMDS/rm -f $W/* > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

case    pgmtoppm-colours-the-greyscale-asciitopgm-made
# The card ended `pgmtoppm < /nil' and captured the usage line that earned,
# with a PGM sitting two lines above it.  A colour PAIR ramps between them.
run     /dd/CMDS/NETPBM/pbmtext "netpbm" > $W/t.pbm 2>/nil
run     /dd/CMDS/NETPBM/pbmtoascii $W/t.pbm > $W/art.txt
run     /dd/CMDS/NETPBM/asciitopgm 8 60 < $W/art.txt > $W/a.pgm
run     /dd/CMDS/NETPBM/pgmtoppm red-blue $W/a.pgm > $W/a.ppm
run     /dd/CMDS/NETPBM/pnmfile $W/a.pgm $W/a.ppm
expect  a.pgm:	PGM raw, 60 by 8  maxval 127
expect  a.ppm:	PPM raw, 60 by 8  maxval 127

case    aterm-says-what-is-wrong-with-the-device-it-is-given
# Its own Example line is `ATerm /t1'.  The refusal is the finding: it wants
# an SCF device driven by the same driver as the one in its control file.
run     /dd/CMDS/ATerm /t1
expect  *** The specified device is not a valid one.  Sorry !
expect  *** Must be a SCF type device, having the same driver
expect  as the one specified in the control file.

case    newshist-ignores-df-and-reads-h0-lib-news-history
# One of the two `--' entries under newshist in DOC/DEPENDS.  /h0 IS this
# disk, so the path is makeable -- and until it exists newshist cannot get
# as far as saying anything about the id it was asked for.
run     /dd/CMDS/rm -f /dd/lib/news/history > /nil 2>/nil
run     /dd/CMDS/rm -f /dd/lib/news/history.dir > /nil 2>/nil
run     /dd/CMDS/rm -f /dd/lib/news/history.pag > /nil 2>/nil
run     /dd/CMDS/NEWS/newshist -df $W/history "<one@site.uucp>"
expect  database files for `/h0/lib/news/history' incomprehensible or unavailable
expect  no history entry for <one@site.uucp>
absent  /dd/tmp/FLC/history

case    with-the-file-there-it-reads-the-database-and-answers
run     /dd/CMDS/mkdir -p /dd/lib/news > /nil 2>/nil
run     echo "<one@site.uucp> 9999999 1" > /dd/lib/news/history
run     echo -n "" > /dd/lib/news/history.dir
run     echo -n "" > /dd/lib/news/history.pag
run     /dd/CMDS/ksh -c "cd /dd/lib/news; /dd/CMDS/NEWS/dbz history"
run     /dd/CMDS/NEWS/newshist "<one@site.uucp>"
expect  no history entry for <one@site.uucp> nor <<one@site.uucp>>
absent  can't open
absent  incomprehensible

case    dbz-builds-its-files-and-cannot-store-into-them
# This is why the answer above is `no history entry' for an id that IS in
# the file.  Build mode CREATES the .dir/.pag pair and then cannot store a
# key into it; CHECK mode (-c) then agrees it cannot find what it was asked
# about.  So the database is built, read and empty, and that is as far as
# this pair goes here.  The separator is not what stops it:
# tools/drives/flagged4.drive writes the line with real tabs and gets the
# same `store failed'.
run     /dd/CMDS/mkdir -p /dd/lib/news > /nil 2>/nil
run     /dd/CMDS/rm -f /dd/lib/news/history.dir > /nil 2>/nil
run     /dd/CMDS/rm -f /dd/lib/news/history.pag > /nil 2>/nil
run     echo "<one@site.uucp> 9999999 1" > /dd/lib/news/history
run     /dd/CMDS/ksh -c "cd /dd/lib/news; /dd/CMDS/NEWS/dbz history"
run     /dd/CMDS/ls /dd/lib/news
run     /dd/CMDS/ksh -c "cd /dd/lib/news; /dd/CMDS/NEWS/dbz -c history"
expect  store failed on `<one@site.uucp> 9999999 1
expect  history.dir
expect  history.pag
expect  can't find `<one@site.uucp> 9999999 1

case    dbz-check-mode-needs-the-pair-that-build-mode-makes
# `-c' on its own, with no database there, stops at dbminit.  Which is what
# makes the pair look like something you have to create by hand, and is why
# the card creates it.
run     /dd/CMDS/rm -f /dd/lib/news/history.dir > /nil 2>/nil
run     /dd/CMDS/rm -f /dd/lib/news/history.pag > /nil 2>/nil
run     /dd/CMDS/ksh -c "cd /dd/lib/news; /dd/CMDS/NEWS/dbz -c history"
expect  dbminit(`history') failed

case    disktest-is-silent-bare-and-its-help-is-all-there-is
# Its card shows `disktest -?' and that is not a defect in the card.  Neither
# other invocation can even be ASSERTED here: `disktest' alone and
# `disktest /dd' both END THE EMULATOR SESSION, and datatest fails any case
# whose session took an exception -- correctly.  tools/drives/flagged1.drive
# has the run where that happened.  The option list has one option, and it
# is -?.
run     /dd/CMDS/disktest -?
expect  Syntax   : disktest [<opt>]
expect  Function : measure diskperformance
expect  Options  : -?  show this text
expect  V1.0, written by Stephan Paschedag

case    nothing-on-this-disk-creates-an-event-so-edir-lists-none
# `edir' looks empty because it IS empty: OS-9's own `event' utility is
# Microware's and is not here, and `eset' can only LINK to an event that
# already exists -- which is what `can't link to' means.
run     /dd/CMDS/edir
run     /dd/CMDS/eset testevent 1
run     /dd/CMDS/eunlink -?
expect  Event Directory at
expect  eset: can't link to testevent
expect  Syntax: eunlink {<event>}
expect  Function: unlink an event
