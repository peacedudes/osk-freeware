family  gcc272
# GNU C 2.7.2 for OS-9/68000, Stephan Paschedag's port, 1997: compile, link
# and RUN.  Like every gcc here it hands its assembly to the reader's own
# r68 and l68 and links the reader's cstart.r and clibn.l, so this family
# needs a real OS-9 system on /h1 with CMDS, LIB and DEFS.
#
# THE DRIVER FORKS ITS PASSES BY BARE NAME.  It checks /dd/CMDS/gcc_cc2 is
# there -- which is GCC2's 2.5.6 pass on this disk -- and then forks `cc2',
# whatever answers to that.  Its own -F option is how a pass is pointed at
# a pathlist: -F<pass>x[<pathlist>].  GCC2_OPTS carries default options,
# so one environment variable names all four.  -uwlibs links the classic
# clibn.l rather than gclib, which is not on this disk.

load    /h1/CMDS/r68
load    /h1/CMDS/l68
load    /h1/CMDS/del
setup   W=/dd/tmp/GCC272W
setup   P=/dd/CMDS/GCC272
setup   export GCC2_OPTS="-Fcccp2x[$P/gcc272_cccp2] -Fcc2x[$P/gcc272_cc2] -Fcc2plusx[$P/gcc272_cc2plus] -Fcollectx[$P/gcc272_collect]"
setup   /dd/CMDS/rm -rf $W > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   cd $W
setup   echo '#include <stdio.h>' > $W/hello.c
setup   echo 'int main() { puts("hello, world"); return 0; }' >> $W/hello.c
setup   echo 'extern "C" int puts(const char *);' > $W/hello.cc
setup   echo 'class Greeter { public: void greet() { puts("hello from C++"); } };' >> $W/hello.cc
setup   echo 'int main() { Greeter g; g.greet(); return 0; }' >> $W/hello.cc
setup   echo '#include <stdio.h>' > $W/small.c
setup   echo 'int fib(n) int n; { return n < 2 ? n : fib(n - 1) + fib(n - 2); }' >> $W/small.c
setup   echo 'int bylen(a, b) char **a, **b;' >> $W/small.c
setup   echo '{ int d = strlen(*a) - strlen(*b); return d ? d : strcmp(*a, *b); }' >> $W/small.c
setup   echo 'int main() {' >> $W/small.c
setup   echo '  static char *w[] = { "sieve", "of", "Eratosthenes", "gcc", "on", "OS-9" };' >> $W/small.c
setup   echo '  char sieve[100], line[80]; int i, j, n = 0; double h = 0.0;' >> $W/small.c
setup   echo '  for (i = 2; i < 100; i++) sieve[i] = 1;' >> $W/small.c
setup   echo '  for (i = 2; i < 100; i++) if (sieve[i]) { n++; for (j = i + i; j < 100; j += i) sieve[j] = 0; }' >> $W/small.c
setup   echo '  sprintf(line, "primes below 100: %d", n); puts(line);' >> $W/small.c
setup   echo '  sprintf(line, "fib(20) = %d", fib(20)); puts(line);' >> $W/small.c
setup   echo '  for (i = 1; i <= 10; i++) h += 1.0 / i;' >> $W/small.c
setup   echo '  sprintf(line, "H(10) = %.6f", h); puts(line);' >> $W/small.c
setup   echo '  qsort(w, 6, sizeof w[0], bylen);' >> $W/small.c
setup   echo '  line[0] = 0; for (i = 0; i < 6; i++) { strcat(line, w[i]); if (i < 5) strcat(line, " "); }' >> $W/small.c
setup   echo '  puts(line); return 0; }' >> $W/small.c

case    gcc272-compiles-links-and-runs-hello-world
run     /dd/CMDS/rm -f $W/hello
run     /dd/CMDS/GCC272/gcc272 -uwlibs -L/h1/LIB -o $W/hello $W/hello.c
run     $W/hello
expect  hello, world

case    every-pass-is-2.7.2
run     /dd/CMDS/GCC272/gcc272 -v -S -o $W/hello.a $W/hello.c
expect  gcc2 version 2.7.2
expect  GNU CPP version 2.7.2
expect  GNU C version 2.7.2

case    a-small-program-at-O2
run     /dd/CMDS/rm -f $W/small
run     /dd/CMDS/GCC272/gcc272 -uwlibs -L/h1/LIB -O2 -o $W/small $W/small.c
run     $W/small
expect  primes below 100: 25
expect  fib(20) = 6765
expect  H(10) = 2.928968
expect  of on gcc OS-9 sieve Eratosthenes

case    cplusplus-without-the-stream-library-links-and-runs
run     /dd/CMDS/rm -f $W/hellocc
run     /dd/CMDS/GCC272/gcc272 -uwlibs -L/h1/LIB -o $W/hellocc $W/hello.cc
run     $W/hellocc
expect  hello from C++

# GCC2's 2.5.6 passes are sticky and register cc2 and cccp2.  With them
# resident, 2.7.2 still runs its own; and 2.5.6 still answers as 2.5.6
# afterwards, because 2.7.2's modules are named for themselves.
case    gcc2-2.5.6-and-2.7.2-do-not-answer-for-each-other
run     /dd/CMDS/GCC2/gcc2 -S -o $W/a256.a $W/hello.c
run     /dd/CMDS/GCC272/gcc272 -v -S -o $W/a272.a $W/hello.c
run     /dd/CMDS/GCC2/gcc2 -v -S -o $W/b256.a $W/hello.c
run     /h1/CMDS/unlink cc2 gcc2
expect  GNU C version 2.7.2
expect  GNU C version 2.5.6
expect  gcc version 2.5.6
