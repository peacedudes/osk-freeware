# inform -- Inform 1.0 (release 3), Graham Nelson's Z-machine compiler, built
# from SRC/inform/informosk.c (2026-08-23; shipped 2026-09-23).  The proof is
# the collection's own demo: hellow.inf compiles to a story file byte-identical
# to GAMES/INFORM/hellow.z3, which has shipped since day one.

family  inform

setup   /dd/CMDS/rm -rf /dd/tmp/INFC > /nil 2>/nil
setup   /dd/CMDS/mkdir -p /dd/tmp/INFC > /nil 2>/nil
setup   /dd/CMDS/cp /dd/SRC/inform/hellow.inf /dd/SRC/inform/parser.h /dd/SRC/inform/verblib.h /dd/SRC/inform/grammar.h /dd/tmp/INFC

case    inform-recompiles-hellow-byte-for-byte
run     cd /dd/tmp/INFC
run     /dd/CMDS/inform hellow.inf h.z3; echo "status $?"
run     /dd/CMDS/diff h.z3 /dd/GAMES/INFORM/hellow.z3 && echo "identical story file"
expect  status 0
expect  identical story file

case    inform-names-itself
run     /dd/CMDS/inform
expect  Graham Nelson
