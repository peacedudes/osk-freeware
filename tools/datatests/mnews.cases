family  mnews
# MNews, the news system in CMDS/MNEWS (2026-09-23).  Every program reads
# TOP's SysInfo table first, so `setup' builds it from SYS/sysinfo; the
# spool, the active file and nn's database are reset so a second run of
# this family starts where the first did (the image is not reset between
# runs).  nn is on its card: it wants a terminal.

setup   export PATH=/dd/CMDS/MNEWS:$PATH
# nn's programs stop with `No HOME environment variable' without these.
setup   export HOME=/dd USER=tester
setup   W=/dd/tmp/MNT
setup   /dd/CMDS/rm -rf $W /h0/SPOOL/MNEWS/comp /h0/SPOOL/MNEWS/control /h0/SPOOL/MNEWS/junk > /nil 2>/nil
setup   /dd/CMDS/rm -f /h0/USR/LIB/NEWS/HISTORY/* > /nil 2>/nil
setup   /dd/CMDS/rm -f /h0/SPOOL/NN/GROUPS /h0/SPOOL/NN/MASTER /h0/SPOOL/NN/DATA/*.? > /nil 2>/nil
setup   /dd/CMDS/printf 'control:00000 00000 n\rjunk:00000 00000 n\r' > /h0/USR/LIB/NEWS/Active
setup   /dd/CMDS/mkdir -p $W
setup   /dd/CMDS/setup

case    setup-builds-the-sysinfo-table-mnews-reads
run     /dd/CMDS/getinfo -a
expect  NEWS.DIR              String      /h0/SPOOL/MNEWS
expect  lck.inews             Lock        not locked

# Needs the super-user: inews obeys a control message only when the caller
# is the owner of the inews module, 0.0 here, and says so otherwise.
case    inews-makes-a-group-and-files-an-article-in-it
run     /dd/CMDS/printf 'Newsgroups: comp.os.os9\rSubject: case\r\rbody text\r' > $W/art
run     inews -c=newgroup:comp.os.os9 < /nil
run     inews -h < $W/art
run     /dd/CMDS/cat /h0/SPOOL/MNEWS/comp/os/os9/1
expect  Newsgroups: comp.os.os9
expect  Subject: case
expect  body text

# rnews forks inews by bare name, which is looked up in the execution
# directory -- /dd/CMDS -- so inews has to be resident first.
case    rnews-hands-a-batch-to-inews
load    /dd/CMDS/MNEWS/inews
run     /dd/CMDS/printf 'Newsgroups: junk\rSubject: batched\rFrom: a@b\rMessage-ID: <1@b>\r\rbody\r' > $W/a
run     LEN=$(/dd/CMDS/cat $W/a | /dd/CMDS/wc -c)
run     /dd/CMDS/printf '#! rnews %s\r' $LEN > $W/batch
run     /dd/CMDS/cat $W/a >> $W/batch
run     /dd/CMDS/MNEWS/rnews -d=1 $W/batch
expect  Received 1 articles

case    encode-and-decode-round-trip
run     echo hello world | encode | decode
expect  hello world

# nnadmin takes its menu keys as an argument; C is the configuration --
# once nnmaster has built nn's database, which needs the reader's own
# shell (the harness stages only `load' and `unlink' on /h1).  On a fresh
# disk it says so; the nnadmin card builds the database first and shows C.
case    nnadmin-names-the-database-it-needs
run     /dd/CMDS/rm -f /h0/SPOOL/NN/MASTER > /nil 2>/nil
run     nnadmin C
expect  Cannot open file /h0/SPOOL/NN/MASTER

# sbatch: a neighbour named in Sys gets the waiting article batched and
# handed to uux -- which, like rnews's inews, is forked by bare name and so
# has to be resident.  Sys is restored afterwards.
case    sbatch-batches-an-article-for-a-neighbour
load    /dd/CMDS/UUCP/uux
run     /dd/CMDS/rm -f /h0/SPOOL/BATCH/nbr > /nil 2>/nil
run     /dd/CMDS/cp /h0/USR/LIB/NEWS/Sys $W/sys.save
run     echo 'nbr:.*:*' >> /h0/USR/LIB/NEWS/Sys
run     /dd/CMDS/printf 'Newsgroups: junk\rSubject: onward\r\rbody\r' > $W/o
run     inews -h < $W/o
run     sbatch nbr 2>&1
run     /dd/CMDS/cp $W/sys.save /h0/USR/LIB/NEWS/Sys
expect  Spooling news for nbr
expect  uux: Unknown Host 'nbr'

# nnmaster -I builds nn's database, forking the reader's own shell and, for
# a new GROUPS file, the reader's own qsort; nncheck then reads it.  A first
# nncheck makes the user's .nn files (with the reader's touch) and prints
# nn's welcome; the second answers the question it is for.
case    nnmaster-builds-the-database-nncheck-reads
load    /h1/CMDS/shell
load    /h1/CMDS/qsort
load    /h1/CMDS/touch
run     /dd/CMDS/printf 'OK\ry\r' > $W/ok
run     /dd/CMDS/MNEWS/nnmaster -I < $W/ok
run     /dd/CMDS/ls /h0/SPOOL/NN
run     /dd/CMDS/mkdir -p $W/.nn
run     HOME=$W /dd/CMDS/MNEWS/nncheck < /nil > /nil
run     HOME=$W /dd/CMDS/MNEWS/nncheck < /nil
expect  Initializing master data base...
expect  MASTER
expect  No News (is good news)
absent  can't execute

# cvt_help turns nn's help markup (`;:A') into the control codes nn prints
# and back: the source's help.welcome converts to exactly what ships in
# USR/LIB/NN, and converting that returns the markup.
case    cvt_help-converts-help-markup-both-ways
run     /dd/CMDS/MNEWS/cvt_help < /dd/SRC/mnews/NN_OSK/help.welcome > $W/hw
run     /dd/CMDS/diff $W/hw /dd/USR/LIB/NN/help.welcome && echo same-as-shipped
run     /dd/CMDS/MNEWS/cvt_help < $W/hw | /dd/CMDS/head -1
expect  same-as-shipped
expect  ;:AWelcome to the nn news reader;:A

# nnaux is what nn runs to post: `nnaux post <work file> <line> <first
# action>', and `send' as the first action posts without asking.  It hands
# the file to `inews -h' through the reader's shell, so inews is loaded for
# the shell to find, then removes the work file, as it does for nn.
case    nnaux-posts-the-work-file-nn-hands-it
load    /h1/CMDS/shell
load    /dd/CMDS/MNEWS/inews
run     /dd/CMDS/printf 'Newsgroups: junk\rSubject: via nnaux\r\rposted by nnaux\r' > $W/nnaux.art
run     /dd/CMDS/MNEWS/nnaux post $W/nnaux.art 1 send
run     /dd/CMDS/cat /h0/SPOOL/MNEWS/junk/*
run     /dd/CMDS/ls $W
expect  Subject: via nnaux
expect  posted by nnaux
absent  nnaux.art
