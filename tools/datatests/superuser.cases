family  superuser
user    su
# The cases that need the SUPER-USER by design, gathered here because every
# other family runs as `tester' (2026-09-23).  Each says why.  The MNews
# setup is mnews.cases's, repeated so these can run on their own.

setup   export PATH=/dd/CMDS/MNEWS:$PATH
setup   export HOME=/dd USER=tester
setup   W=/dd/tmp/MNT
setup   /dd/CMDS/rm -rf $W /h0/SPOOL/MNEWS/comp /h0/SPOOL/MNEWS/control /h0/SPOOL/MNEWS/junk > /nil 2>/nil
setup   /dd/CMDS/rm -f /h0/USR/LIB/NEWS/HISTORY/* > /nil 2>/nil
setup   /dd/CMDS/rm -f /h0/SPOOL/NN/GROUPS /h0/SPOOL/NN/MASTER /h0/SPOOL/NN/DATA/*.? > /nil 2>/nil
setup   /dd/CMDS/printf 'control:00000 00000 n\rjunk:00000 00000 n\r' > /h0/USR/LIB/NEWS/Active
setup   /dd/CMDS/mkdir -p $W
setup   /dd/CMDS/setup

# Needs the super-user: inews obeys a control message only when the caller
# is the owner of the inews module, 0.0 here, and says so otherwise.
case    inews-makes-a-group-and-files-an-article-in-it
run     /dd/CMDS/printf 'Newsgroups: comp.os.os9\rSubject: case\r\rbody text\r' > $W/art
run     inews -c=newgroup:comp.os.os9 < /nil
run     inews -h < $W/art
run     /dd/CMDS/cat /h0/SPOOL/MNEWS/comp/os/os9/1
expect  Newsgroups: comp.os.os9
expect  Subject: case
expect  body text

# The GROUPS file nnmaster -I makes is its owner's alone (`------wr'), so
# another user's nncheck cannot read it until the super-user gives it
# public read.  Needs the super-user, for the attr.
case    another-users-nn-reads-groups-only-after-attr-pr
load    /h1/CMDS/shell
load    /h1/CMDS/qsort
load    /h1/CMDS/touch
run     /dd/CMDS/rm -f /h0/SPOOL/NN/GROUPS /h0/SPOOL/NN/MASTER
run     /dd/CMDS/printf 'OK\ry\r' > $W/ok
run     /dd/CMDS/MNEWS/nnmaster -I < $W/ok > /nil
run     /dd/CMDS/su -s /dd/CMDS/bash tester -c "/dd/CMDS/mkdir -p /dd/tmp/MNT/tu/.nn; HOME=/dd/tmp/MNT/tu /dd/CMDS/MNEWS/nncheck < /nil > /nil; HOME=/dd/tmp/MNT/tu /dd/CMDS/MNEWS/nncheck < /nil"
run     /h1/CMDS/attr -pr /h0/SPOOL/NN/GROUPS
run     /dd/CMDS/su -s /dd/CMDS/bash tester -c "HOME=/dd/tmp/MNT/tu /dd/CMDS/MNEWS/nncheck < /nil"
expect  Cannot open file /h0/SPOOL/NN/GROUPS
expect  ----r-wr  /h0/SPOOL/NN/GROUPS
expect  No News (is good news)

# uupoll's whole job is to leave a POLL file in the queue for a site, and
# it does it in silence -- which is why it read as broken. The grade letter
# goes into the name: no -g is `A', `-gZ' is `Z'.
# Needs the super-user to LIST the result: uupoll becomes uucp and makes the
# site directory owner-only, so another user's ls is refused.
case    uupoll-queues-a-poll-file-and-the-grade-is-in-its-name
run     /dd/CMDS/UUCP/uupoll nowhere
run     /dd/CMDS/UUCP/uupoll -gZ nowhere
run     /dd/CMDS/ls /dd/SPOOL/uucp/nowhere
expect  C.nowhereAPOLL
expect  C.nowhereZPOLL

# Initialising nn's database is the administrator's job.
# nnmaster -I builds nn's database, forking the reader's own shell and, for
# a new GROUPS file, the reader's own qsort; nncheck then reads it.  A first
# nncheck makes the user's .nn files (with the reader's touch) and prints
# nn's welcome; the second answers the question it is for.
case    nnmaster-builds-the-database-nncheck-reads
load    /h1/CMDS/shell
load    /h1/CMDS/qsort
load    /h1/CMDS/touch
run     /dd/CMDS/printf 'OK\ry\r' > $W/ok
run     /dd/CMDS/MNEWS/nnmaster -I < $W/ok
run     /dd/CMDS/ls /h0/SPOOL/NN
run     /dd/CMDS/mkdir -p $W/.nn
run     HOME=$W /dd/CMDS/MNEWS/nncheck < /nil > /nil
run     HOME=$W /dd/CMDS/MNEWS/nncheck < /nil
expect  Initializing master data base...
expect  MASTER
expect  No News (is good news)
absent  can't execute

# --- moved from the tester families on 2026-09-24 ------------------------
# Each of these REFUSES anyone but the super-user, in its own words, before
# doing anything at all -- measured as tester, the message is quoted.

# ssl reads a file's descriptor sector off the raw device.  As tester:
# `Sie sind doch nicht der Superuser - ooooder ?'  (from misc5)
# It finds the file BY NAME IN THE DATA DIRECTORY -- its own header says the
# file must be in the current directory -- so it is run there; given a path
# it printed the headings over sector 0 and an empty list.
case    ssl-shows-a-files-segment-list
run     /dd/CMDS/cp /dd/SYS/motd $W/plain.txt
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/ssl plain.txt"
expect  File descriptor sector plain.txt:
expect   Seg#     start    lenght

# As tester: `uuclean: you are not the superuser!'  (from misc6)
case    uuclean-explains-how-it-ages-the-spool
run     /dd/CMDS/UUCP/uuclean -?
expect  uuclean: removed old UUCP files, rotate UUCP and FileServ log files
expect          -nX     Remove those files over X days old (default is 7)
expect          -x      Set debug option on (files are not touched)

# As tester: `expire: you are not the superuser!'  (from news)
case    expire-explains-itself-when-given-an-illegal-option
run     /dd/CMDS/UUCP/expire -?
expect  expire: illegal option -- ?
expect  news article expire utility
expect  -e<days>   expire articles older than specified number of days
expect  expires all articles older than 14 days

# As tester: `Must be root'.  (from news)
case    rnews-files-a-batched-article-under-its-newsgroup
# rnews numbers articles from SYS/UUCP/active and writes the new high
# water mark back, so the case keeps a copy of active and puts it back:
# a second run would otherwise file a2, a3 ...
run     /dd/CMDS/cp /dd/SYS/UUCP/active $W/active.save
run     /dd/CMDS/rm -rf /dd/SPOOL/news/COMP $W/rn > /nil 2>/nil
run     /dd/CMDS/mkdir -p $W/rn
run     /dd/CMDS/printf 'Newsgroups: comp.os.os9\rSubject: rnews case\r\rhello there\r' > $W/rn/art.txt
run     LEN=$(/dd/CMDS/cat $W/rn/art.txt | /dd/CMDS/wc -c)
run     /dd/CMDS/printf '#! rnews %s\r' $LEN > $W/rn/batch.txt
run     /dd/CMDS/cat $W/rn/art.txt >> $W/rn/batch.txt
run     /dd/CMDS/UUCP/rnews $W/rn/batch.txt
run     /dd/CMDS/ls /dd/SPOOL/news/COMP/OS/OS9
run     /dd/CMDS/cat /dd/SPOOL/news/COMP/OS/OS9/a*
run     /dd/CMDS/cp $W/active.save /dd/SYS/UUCP/active
expect  Subject: rnews case
expect  hello there

# As tester: `adduser: Sorry, only the Superuser can use this utility!'
# (from system2)
case    the-uucp-adduser-can-remove-as-well-as-add
run     /dd/CMDS/UUCP/adduser -?
expect  ADDUSER: add a user to or remove a user from the system
expect  adduser -r <username>

# As tester: `rendsk: allowed for superuser only!'  (from tail)
case    rendsk-says-what-it-is-missing
run     /dd/CMDS/rendsk
expect  rendsk: Requires two parameters

# bootlogger is silent for the super-user; to anyone else it prints
# `BOOTLOGGER can be run only by the SYSTEM !'.  (from system2)
case    bootlogger-is-silent
run     /dd/CMDS/bootlogger -? > /dd/tmp/pt2 2>&1
run     /dd/CMDS/wc -c /dd/tmp/pt2
expect  0 /dd/tmp/pt2

# logname names the super-user too, as it names tester (tail.cases,
# uidmask.cases).
case    logname-names-the-super-user
run     /dd/CMDS/logname
expect  su
absent  no login name

# crontab's -u is the super-user's (legacy.cases shows tester refused).
case    crontab-lets-the-super-user-act-for-another
run     /dd/CMDS/SYSADMIN/crontab -u=tester -l
expect  no crontab for tester
absent  must be privileged

# LEAVE NOTHING OF THE SUPER-USER'S BEHIND.  The nn database built above is
# 0.0's, and owner-only; a later family runs as tester and cannot remove it,
# so mnews.cases' nnadmin case -- which needs the database ABSENT -- failed
# on the suite's second run (2026-09-24).  This family made the files, so
# this family takes them away.
case    superuser-leaves-no-nn-database-behind
run     /dd/CMDS/rm -f /h0/SPOOL/NN/GROUPS /h0/SPOOL/NN/MASTER /h0/SPOOL/NN/DATA/*.? > /nil 2>/nil
run     /dd/CMDS/ls /h0/SPOOL/NN; echo "listed"
expect  listed
absent  MASTER
