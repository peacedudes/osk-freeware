family  tail
# The CMDS programs no sheet had ever run before 2026-08-31. Most of them
# answer with their own name and their own options, which is a weak claim
# about the program and a strong one about the DISK: it catches a binary that
# has been truncated, replaced, or built without `-n=' and so reports somebody
# else's name.
#
# Two entries were WRONG and are corrected out of this batch: `checkfile' is a
# cheque-book program and not a C source checker, and `rsconvert' crashed
# (it runs since its memory size was raised; see its case below).

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   export HOME=/dd
setup   /dd/CMDS/mkdir /dd/tmp/TA
setup   /dd/CMDS/cp /dd/SYS/termcap /dd/tmp/TA/t.txt

# `day of August, two thousand and' was the third line here and it passed
# for one day: written 2026-08-31, failed 2026-09-01. What `today' does is
# spell the date out in words and name the moon's phase, and that is what
# can be asserted -- `two thousand and' is the year in words and holds
# until 2100; the month name does not hold until next month.
case    today-tells-you-the-date-in-words-and-the-phase-of-the-moon
run     /dd/CMDS/today
expect  Today is
expect  two thousand and
expect  The moon is

case    chbase-converts-and-shows-both-bases
run     /dd/CMDS/chbase 255 10 16
run     /dd/CMDS/chbase 377 8 2
run     /dd/CMDS/chbase
expect  255 [10] = FF [16]
expect  377 [8] = 11111111 [2]
expect  chbase:  Error options !!!

case    unp-reports-every-unprintable-it-strips
run     /dd/CMDS/unp /dd/tmp/TA/t.txt > /dd/tmp/TA/unp.txt
run     /dd/CMDS/wc -c /dd/tmp/TA/unp.txt
expect  9 found in line
expect  963 /dd/tmp/TA/unp.txt

case    unifdef-names-the-options-it-does-take
run     /dd/CMDS/unifdef -DFOO /dd/tmp/TA/t.txt
expect  unrecognized option: -DFOO
expect  function: remove ifdef'ed lines from source file
expect  At least one arg from [-d -u -id -iu] is required

case    proff-formats-a-line-of-text
run     /dd/CMDS/proff /dd/SYS/motd
expect  Welcome to os9exec -- OS-9/68k emulator

case    the-librarian-set-each-names-its-own-job
run     /dd/CMDS/libsplit
run     /dd/CMDS/EditLibr
run     /dd/CMDS/Libr2Ascii
run     /dd/CMDS/Ascii2Libr
expect  Splits a new Type Library into ROF files.
expect  Librarian Card Catalog file editor
expect  Convert a Librarian Card Catalog file to a plain ASCII text file.
expect  Copyright (c) 1991,1992 Robert Heller D/B/A Deepwoods Software

case    the-zip-helpers-name-their-versions
run     /dd/CMDS/zipinfo
run     /dd/CMDS/zipnote
run     /dd/CMDS/zipsplit
expect  ZipInfo:  Zipfile Information Utility v1.0 of 21 August 92
expect  ZipNote 1.9 (Aug 20th 1992)
expect  ZipSplit 1.9 (Aug 20th 1992)

case    dmake-and-makelex-run
run     /dd/CMDS/dmake -?
run     /dd/CMDS/makelex < /nil
expect  dmake [-AeEhiknpqrsStTuVx]
expect  DICTIONARY -- DO NOT EDIT THIS FILE!

case    the-elvis-helpers-and-the-less-helpers
run     /dd/CMDS/ref
run     /dd/CMDS/lessecho hello world
run     /dd/CMDS/lesskey
expect  usage: ref [-t] [-c class] [-f file] tag
expect  hello world
expect  /dd/.lesskey

case    the-ownership-commands
run     /dd/CMDS/chown
run     /dd/CMDS/logname
run     /dd/CMDS/eset
expect  Usage:  chown [-z] {numerical-uid | username} [file [... file]]
expect  Function: set event to a new value
# logname names only the super-user: 0.0 is `su', and for tester (1.7), uucp
# and anon it says `no login name' where whoami answers `tester' (measured
# 2026-09-24).  superuser.cases asserts the `su' half.
expect  logname: no login name

# NOT a C source checker. Its own screen says what it is, and it is the whole
# reason this entry was wrong for as long as it was: nobody had run it.
case    checkfile-is-a-cheque-book-program
run     /dd/CMDS/checkfile /dd/tmp/TA/t.txt
expect  CHECKFILE
expect  Copyright (c) 1992 by John R. Wainwright
expect  A - Add Records
expect  B - Print Balance

case    georgia-and-minnesota-simulate-a-year-of-weather
run     /dd/CMDS/georgia
expect  Year   1    Weather        Sky   Temperature    Precip      Wind
expect  January

case    mstoolstest-prints-the-drive-table-and-msformat-refuses-the-image
run     /dd/CMDS/mstoolstest
run     /dd/CMDS/msformat a:
expect  file="/dd/DOS/a.img"
expect  mtools_fat_compatibility=0
expect  Non-removable media is not supported

case    scqref-is-the-spreadsheet-quick-reference
run     /dd/CMDS/scqref < /nil
expect  sc Quick Reference
expect  C:   Cursor movement commands
expect  N:   Financial functions

# rsconvert used to take a Stack Overflow straight after its banner: its
# module asked for 11.2k and its yacc parser needs more.  Its memory size
# is 32k since 2026-09-14, and it converts.  netpbm6.cases has the
# fuller rayshade-3 conversion; this pins the bare, standard-input form.
case    rsconvert-reads-standard-input-without-overflowing
run     /dd/CMDS/rsconvert < /nil
expect  /* Converted by rsconvert */
absent  Stack Overflow

case    the-two-boyer-moore-tests-want-a-pattern
run     /dd/CMDS/bmgtest
run     /dd/CMDS/bmgtest2
expect  bmgtest: pattern argument missing

# THEY SEARCH A NAMED FILE, and did not until 2026-09-18.  Both opened it
# with Unix modes -- `open(name, 0)' is O_RDONLY on Unix and NO ACCESS BITS
# on OS-9 -- so every read through the descriptor was refused and a named
# file was searched as empty, while the same pattern on standard input
# worked.  That contrast is what this case asserts; without the file half it
# would have passed all along.  SRC/strsch/README.OSK.
case    the-boyer-moore-tests-search-a-named-file-and-standard-input-alike
run     /dd/CMDS/rm -rf /dd/tmp/TA/BMG > /nil 2>/nil
run     /dd/CMDS/mkdir -p /dd/tmp/TA/BMG > /nil 2>/nil
run     /dd/CMDS/printf "alpha\rbeta\rgamma\r" > /dd/tmp/TA/BMG/f.txt
run     /dd/CMDS/bmgtest beta /dd/tmp/TA/BMG/f.txt
expect  beta
run     /dd/CMDS/bmgtest2 gamma /dd/tmp/TA/BMG/f.txt
expect  gamma
run     /dd/CMDS/bmgtest alpha < /dd/tmp/TA/BMG/f.txt
expect  alpha
