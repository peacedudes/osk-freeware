# utils -- small command-line tools that had no test, each asserted on the
# data it produced (2026-09-14): a hex dump that loads back byte for byte, a
# base64 round trip, termcap answers, a zip code, a C declaration explained.

family  utils

setup   W=/dd/tmp/UTL
setup   /dd/CMDS/rm -rf $W > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   /dd/CMDS/printf 'Hello, world. The quick brown fox jumps over the lazy dog.\n' > $W/t.txt

case    xd-dumps-and-loads-back-byte-for-byte
run     /dd/CMDS/xd -c $W/t.txt
run     /dd/CMDS/xd $W/t.txt > $W/t.xd
run     /dd/CMDS/xd -l $W/t.xd > $W/t.back
run     /dd/CMDS/md5 $W/t.back
expect  48 65 6C 6C 6F 2C 20 77  6F 72 6C 64 2E 20 54 68 | Hello, world. Th
expect  = ff5361ac468d44a269c2e10f8c2270c2

case    xargs-hands-what-it-reads-to-a-command
run     echo $W/t.txt | /dd/CMDS/xargs /dd/CMDS/cat
expect  Hello, world. The quick brown fox jumps over the lazy dog.

case    tput-answers-from-termcap
run     /dd/CMDS/tput -Tvt100 cols
run     /dd/CMDS/tput -Tvt100 clear | /dd/CMDS/xd -c
expect  80
expect  1B 5B 48 1B 5B 32 4A

case    zc-names-the-city-for-a-zip-code
run     /dd/CMDS/zc 50325 < /nil
expect  Des Moines, IA.

case    cdecl-explains-a-declaration
run     echo "explain char *argv[]" | /dd/CMDS/cdecl
expect  declare argv as array of pointer to char

case    mimecode-base64-round-trip
run     /dd/CMDS/mimecode -e < $W/t.txt > $W/t.b64
run     /dd/CMDS/cat $W/t.b64
run     /dd/CMDS/mimecode -d < $W/t.b64 > $W/t.dec
run     /dd/CMDS/md5 $W/t.dec
expect  SGVsbG8sIHdvcmxkLiBUaGUgcXVpY2sgYnJvd24gZm94IGp1bXBzIG92ZXIgdGhlIGxhenkg
expect  = ff5361ac468d44a269c2e10f8c2270c2

case    uustat-reports-no-queue
run     /dd/CMDS/uustat < /nil
expect  uucp is possibly active

case    config-reports-double-precision
# 53 digits: before os9exec 209b35c (X flag after NEG) the soft-float
# answers were wrong, and this is a direct probe of that arithmetic.
run     /dd/CMDS/config < /nil
expect  Significant base digits = 53 (= at least 15 decimal digits)
expect  Char pointers = 32 bits

case    almanac-tables-the-sky-for-a-place-and-time
# Every figure is floating point, so this doubles as a check of the soft
# float the emulator runs it on: 20:18 UTC on 20 July 1969, from 87.45 W 41.50 N.
run     /dd/CMDS/almanac 087.45 41.50 0720.1969 20.1800 < /nil
run     /dd/CMDS/almanac 0720.1969 20.1800 < /nil
expect  Topocentric Coordinates      20:18:00       7/20/1969
expect  Sun          8.00090    20.3429   0.312892    1.01605  |   245.13     53.35
expect  Geocentric Coordinates       20:18:00       7/20/1969
expect  Pluto       11.59209    16.4850   0.000013   32.27423

case    dfiles-finds-a-duplicate-and-writes-the-cmp
run     /dd/CMDS/mkdir -p $W/dup/a $W/dup/b > /nil 2>/nil
run     /dd/CMDS/printf 'same\n' > $W/dup/a/f
run     /dd/CMDS/printf 'same\n' > $W/dup/b/f
run     /dd/CMDS/dfiles $W/dup < /nil
expect  cmp -s
expect  /dd/tmp/UTL/dup/a/f

case    howfrag-counts-a-files-segments
run     /dd/CMDS/howfrag /dd/SYS/motd < /nil
expect  /dd/SYS/motd: 1 segments

# strcmp answers in its EXIT STATUS, so the status is what these assert -- and
# `ct' (contains) and `bw' (begins with) are the two a shell's own test has no
# operator for, which is the reason it is here beside basename and dirname.
# Its own manual says a parameter error gives 4; measured 2026-09-23 it gives
# 0, so nothing here asserts 4 and DOC/INDEX does not repeat the claim.
case    strcmp-compares-and-answers-in-its-status
run     /dd/CMDS/strcmp abc eq abc; echo "equal says $?"
expect  equal says 0
run     /dd/CMDS/strcmp abc eq abd; echo "unequal says $?"
expect  unequal says 1

case    strcmp-contains-and-begins-with
run     /dd/CMDS/strcmp Mississippi ct ssiss; echo "contains says $?"
expect  contains says 0
run     /dd/CMDS/strcmp Mississippi bw sipp; echo "begins says $?"
expect  begins says 1

case    strcmp-c-ignores-case
run     /dd/CMDS/strcmp -c aaaXXXddd ct xxx; echo "caseless says $?"
expect  caseless says 0
run     /dd/CMDS/strcmp aaaXXXddd ct xxx; echo "cased says $?"
expect  cased says 1
