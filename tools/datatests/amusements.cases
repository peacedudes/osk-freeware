# amusements -- text generators, dialect filters and the moon, each asserted
# on what it printed (2026-09-14).

family  amusements

setup   export USER=tester
setup   W=/dd/tmp/AMU
setup   /dd/CMDS/rm -rf $W > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   /dd/CMDS/printf 'Hello, world. The quick brown fox jumps over the lazy dog.\n' > $W/t.txt

case    chef-speaks-swedish-chef
run     /dd/CMDS/chef < $W/t.txt
expect  Hellu, vurld. Zee qooeeck broon fux joomps oofer zee lezy dug.
expect  Bork Bork Bork!

case    fudd-speaks-elmer-fudd
run     /dd/CMDS/fudd < $W/t.txt
expect  Hewwo, wowwd. De qwick bwown fox jumps ovew de wazy dog.

case    drawl-speaks-with-a-drawl
run     /dd/CMDS/drawl < $W/t.txt
expect  Hello, warld. The quick brown fox jumps over thuh lazy dog.

case    lame-takes-its-text-as-arguments
# lame reads its arguments, not standard input: piped text prints nothing.
run     /dd/CMDS/lame "hello world" < /nil
expect  hell0 w0rld

case    spew-makes-as-many-headlines-as-asked
run     /dd/CMDS/spew 3 < /nil | /dd/CMDS/wc -l
expect  3

case    phoon-draws-the-moon-for-a-given-date
run     /dd/CMDS/phoon 1969 7 20 < /nil
expect  New Moon +
expect  5 20:51:06
expect  First Quarter -
expect  1 12:19:57

case    zot-builds-its-text-a-letter-at-a-time
run     /dd/CMDS/GAMES/zot -s=1 hello < /nil
expect  ello
expect  hello

case    cfscores-knows-who-has-played
run     /dd/CMDS/GAMES/cfscores < /nil
expect  tester has never played canfield.

# juggle (2026-09-15) checks a pattern before it draws anything: a site-swap
# string whose throws would land two balls in one hand at once is refused, and
# a random pattern needs a period from 2 to 9.
case    juggle-prints-its-version
run     /dd/CMDS/GAMES/juggle -v
expect  Juggle v1.0, (c) Glenn Hutchings 1995

case    juggle-refuses-an-unjugglable-pattern-and-a-bad-period
run     /dd/CMDS/GAMES/juggle -p 12
run     /dd/CMDS/GAMES/juggle -r 1
expect  Error: pattern not jugglable
expect  Error: invalid period

# jumble (2026-09-15) prints the permutations of its word in a fixed order:
# each letter in turn is swapped to the front and the rest permuted.
case    jumble-lists-all-six-orderings-of-abc
run     /dd/CMDS/jumble abc
expect  abc
expect  acb
expect  bac
expect  bca
expect  cba
expect  cab

case    jumble-with-no-word-prints-its-usage
run     /dd/CMDS/jumble
expect  usage: jumble <word>

# bjack and trigraph (2026-09-15): two 1990 IOCCC entries, built from
# SRC/ioccc/OSK.  bjack reads its wager with gets(), so a file of answers
# plays a hand and end of file quits.
case    bjack-takes-a-stake-and-deals-a-hand
run     echo "100" > $W/bj.in
run     echo "n" >> $W/bj.in
run     echo "n" >> $W/bj.in
run     /dd/CMDS/GAMES/bjack 700 < $W/bj.in
expect  Total $700.
expect  Dealer:

# What trigraph prints is the entry as published, trigraphs and all: it
# differs from the original only by that file's trailing blank line.
case    trigraph-prints-the-original-entry
run     /dd/CMDS/trigraph > $W/tri.c
run     /dd/CMDS/diff $W/tri.c /dd/SRC/ioccc/scjones.c
expect  46a47
absent  < 
