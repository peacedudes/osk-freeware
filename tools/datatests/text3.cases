family  text3
# Text tools that a card credited and nothing had typed.  Surfaced
# 2026-09-01 by the `worklist.py' carded() fix.
#
# ONE REAL CORRECTION CAME OUT OF THIS SET: `shuffle' is not a line
# shuffler.  DOC/INDEX called it "shuffle lines/cards" and it is a
# FULL-SCREEN SWITCH PUZZLE -- "LEVEL: 1 / Wich switch ? / moves:" -- so it
# is not here; a full-screen game belongs on a card, not in a case.

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   export PEP=/dd/SYS/PEP
setup   W=/dd/tmp/TXT3
setup   /dd/CMDS/rm -f $W > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   echo "banana" > $W/a.txt
setup   echo "apple" >> $W/a.txt
setup   echo "cherry" >> $W/a.txt
setup   echo "apple" >> $W/a.txt

case    ascii-writes-the-whole-table
run     /dd/CMDS/ascii > $W/asc.txt
run     /dd/CMDS/wc -c $W/asc.txt
expect  4290 /dd/tmp/TXT3/asc.txt

# bm is Boyer-Moore, a faster grep. Its exit status is the answer when
# there is no match, which is what a script would use it for.
case    bm-finds-every-line-and-says-so-in-its-status-when-it-cannot
run     /dd/CMDS/bm apple $W/a.txt
run     echo "found $?"
run     /dd/CMDS/bm zebra $W/a.txt
run     echo "missing $?"
expect  found 0
expect  missing 1

# expand turns tabs into spaces. Three tabs in six bytes become eighteen.
case    expand-turns-tabs-into-spaces
run     /dd/CMDS/printf '%s\r' "a	b	c" > $W/tabs.txt
run     /dd/CMDS/expand $W/tabs.txt > $W/exp.txt
run     /dd/CMDS/wc -c $W/tabs.txt $W/exp.txt
run     /dd/CMDS/dump $W/exp.txt
expect  6 /dd/tmp/TXT3/tabs.txt
expect  18 /dd/tmp/TXT3/exp.txt
expect  6120 2020 2020 2020 6220 2020 2020 2020

case    fcomp-names-the-line-that-was-inserted
run     /dd/CMDS/cp $W/a.txt $W/b.txt
run     echo "durian" >> $W/b.txt
run     /dd/CMDS/fcomp $W/a.txt $W/b.txt
run     /dd/CMDS/fcomp $W/a.txt $W/a.txt
expect  Inserted after line 4:
expect   durian
expect  The files are identical.

case    fmt-folds-a-line-to-a-width
run     /dd/CMDS/fmt -30 /dd/SYS/motd
expect  Welcome to os9exec -- OS-9/68k
expect  emulator

case    join-joins-two-sorted-files-on-their-first-field
run     echo "1 alpha" > $W/j1.txt
run     echo "2 bravo" >> $W/j1.txt
run     echo "1 one" > $W/j2.txt
run     echo "2 two" >> $W/j2.txt
run     /dd/CMDS/join $W/j1.txt $W/j2.txt
expect  1 alpha one
expect  2 bravo two

case    qsort9-sorts-and-unip-drops-the-repeat
run     /dd/CMDS/qsort9 $W/a.txt > $W/sorted.txt
run     /dd/CMDS/cat $W/sorted.txt
run     /dd/CMDS/unip $W/sorted.txt
expect  apple
expect  banana
expect  cherry

case    split-breaks-a-file-into-pieces
run     /dd/CMDS/rm -f $W/xaa $W/xab > /nil 2>/nil
run     /dd/CMDS/ksh -c "cd $W; /dd/CMDS/split -2 a.txt"
run     /dd/CMDS/wc -c $W/xaa $W/xab
expect  13 /dd/tmp/TXT3/xaa
expect  13 /dd/tmp/TXT3/xab

# pep is a file 'detergent'. Run over a file it says what it did, which is
# more useful than the file it produced.
case    pep-says-which-transformations-it-applied
run     /dd/CMDS/pep $W/tabs.txt
expect  pep  ver. 2.1; Copyright (c) 1989 Gisle Hannemyr
expect  Transformations:
expect   * stripping all trailing spaces;

case    pep-lists-its-character-set-conversions
run     /dd/CMDS/pep -?
expect  -i+/-     -- convert to/from IBM-PC charset
expect  -m+/-     -- convert to/from Macintosh charset
expect  -g<file>  -- get conversion table from file

case    speech-turns-english-into-phonemes
run     echo "hello there" > $W/sp.txt
run     /dd/CMDS/speech $W/sp.txt
expect  hEHlOW DHEHr

case    cursive-draws-a-banner-in-joined-writing
run     /dd/CMDS/cursive HI
expect   _    ,    _

case    gothic-draws-a-banner-in-blackletter
run     /dd/CMDS/gothic HI > $W/goth.txt
run     /dd/CMDS/wc -l $W/goth.txt
expect  goth.txt

case    roff-formats-a-text-file
run     /dd/CMDS/roff /dd/SYS/motd
expect  Welcome to os9exec -- OS-9/68k emulator

case    roff-lists-its-options
run     /dd/CMDS/roff -? < /nil
expect  Function: format textfiles
expect  +00       start at page 00
expect  -c        print tabel of contents

case    spiff-diffs-tolerantly
run     /dd/CMDS/spiff $W/a.txt $W/b.txt
expect  4a5
expect  durian

# gep needs its expressions in a FILE, named with -e -- which is what
# "(required)" in its own option list means, and why handing it a pattern
# and a file earns "more than one path specified".
case    gep-takes-its-expressions-from-a-file-named-with-dash-e
run     echo "apple" > $W/pat.txt
run     /dd/CMDS/gep -e=$W/pat.txt $W/a.txt
expect  apple

case    gep-says-so-when-given-a-pattern-instead-of-an-expression-file
run     /dd/CMDS/gep apple $W/a.txt
expect  -e[=]<path>  use <path> for expressions (required)
expect  gep: more than one path specified

# cookie wants BOTH the cookie file and the hash strfile built for it.
case    strfile-indexes-a-cookie-file-and-cookie-reads-the-pair
run     /dd/CMDS/rm -f $W/ck $W/ck.dat > /nil 2>/nil
run     echo "the first fortune" > $W/ck
run     echo "%" >> $W/ck
run     echo "the second fortune" >> $W/ck
run     echo "%" >> $W/ck
run     /dd/CMDS/strfile $W/ck
run     /dd/CMDS/cookie $W/ck $W/ck.dat
expect  converted to
expect  fortune

# WITH NO ARGUMENTS AT ALL cookie does not print its usage -- it prints a
# fortune, from a default file it carries. The usage line only appears when
# it is given one argument and not two, which is how the first draft of
# this case came to expect it here.
# The fortune it picks is random, so the bytes cannot be asserted -- but
# `dump' prints a line beginning `0000' only when there IS a first byte,
# which makes "it printed something" assertable without pinning what.
# (An `absent'-only case is the vacuous-pass shape this harness's own
# header warns about, and the first draft of this was one.)
case    cookie-alone-prints-a-fortune-from-its-default-file
run     /dd/CMDS/cookie > $W/ck.out
run     /dd/CMDS/dump $W/ck.out
expect  0000
absent  usage: cookie

# wns (2026-09-15, TOP release 2): a grep that prints a window of lines round
# each match, prefixed with the file name, and a dashed line wherever two
# windows do not touch.
case    wns-prints-a-window-round-each-match
run     /dd/CMDS/wns -w=1 GPL /dd/DOC/README < /nil
expect  /dd/DOC/README:Where a package is under the GPL
expect  -------------------
