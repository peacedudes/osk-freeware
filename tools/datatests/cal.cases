family  cal
# Calendars and astronomy that a card credited and nothing had typed.
# Surfaced 2026-09-01 by the `worklist.py' carded() fix.
#
# EVERY PROGRAM HERE READS A CLOCK, and on this disk `date -t' says 2100
# and does not advance -- so NOT ONE of these cases may assert today's
# date. Two cases elsewhere did and passed for exactly one day. What is
# asserted instead is either a pure function of an argument (`greg', and
# the Easter table) or the SHAPE of the answer.
#
# `ephem' AND `ephem881' END THE SESSION when standard output is not a
# terminal -- silently, with nothing written. They are full-screen and can
# only be run to a screen, which is what a gallery card is for, so they are
# not here. `calender' was accused of the same and is innocent; see its
# case below.

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   W=/dd/tmp/CAL
setup   /dd/CMDS/rm -f $W > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

case    qt-tells-the-time-in-words
run     /dd/CMDS/qt
expect  It's

# lunisolar reports the moon's phase in words and a percentage.
case    lunisolar-reports-the-phase-of-the-moon
run     /dd/CMDS/lunisolar
expect  The moon is
expect  of full).

# setimex reads the HOST clock, and this is the case that explains the 2100
# setimex reports the time read from the host clock.
case    setimex-reports-the-time
run     /dd/CMDS/setimex
expect  Time now:
expect  2026

case    digclk-and-gcl-are-clocks-and-say-how-to-run-them
run     /dd/CMDS/digclk -? < /nil
run     /dd/CMDS/gcl -? < /nil
expect  Usage: /dd/CMDS/digclk [refresh_rate]
expect  Function: display grand digital clock
expect  -n[=]<num>	run continuously for <num> seconds (default forever)

# calen wants its three numbers on standard input, not on the command line.
case    calen-asks-for-its-specification-on-standard-input
run     echo "9 2026 1" > $W/c.in
run     /dd/CMDS/calen < $W/c.in
expect  Enter calendar specs (month year length):

# `calender' PRINTS A WHOLE YEAR IN GERMAN and redirects perfectly well.
# The first draft of this case asserted that it "refuses to be redirected"
# and answers `cannot redirect' -- which it had, once, on an image whose
# /dd/tmp had been corrupted by `flink' (see system4.cases). Every odd
# answer that hour was that corruption, and it was read as five separate
# broken programs. REBUILD THE IMAGE BEFORE BELIEVING A STRANGE ANSWER.
case    calender-prints-a-whole-year-in-german
run     /dd/CMDS/calender 2026 > $W/cal.txt
run     /dd/CMDS/wc -c $W/cal.txt
run     /dd/CMDS/head -n 3 $W/cal.txt
expect  2986 /dd/tmp/CAL/cal.txt
expect  Jahreskalender   2026

# calcdate and ticktalk (2026-09-15) are asserted on explicit dates and times,
# never the clock.
case    calcdate-adds-thirty-days-and-counts-a-year
run     /dd/CMDS/calcdate 051788 -o 30
run     /dd/CMDS/calcdate 010188 -d 123188
expect  061688
expect  365

case    ticktalk-says-a-quarter-to-two-three-ways
run     /dd/CMDS/ticktalk 13 45
run     /dd/CMDS/ticktalk -french 13 45
run     /dd/CMDS/ticktalk -afrikaans 13 45
expect  Quarter To Two pm
expect  Quatorze Heures Moins Le Quart
expect  Kwart Voor Twee nm

# weekday (2026-09-15) on the date its own header uses as its example.
case    weekday-names-30-october-1989
run     /dd/CMDS/weekday 10/30/89
expect  30 October 1989 is on a Monday on julian day 303 in week 44
