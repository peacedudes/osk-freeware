family  misc6
# The next spread of programs that a card credited and nothing had typed.

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   export USER=tester
setup   export HOME=/dd
setup   W=/dd/tmp/MS6
setup   /dd/CMDS/rm -f $W > /nil 2>/nil
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil
setup   /dd/CMDS/cp /dd/SYS/motd $W/plain.txt

# tty and whoami are one line each, and the pair says who and where you
# are: `tester' because the harness runs as tester (whoami looks the
# process's owner number up in SYS/password), `term' because that is the
# only device os9exec presents.
case    tty-and-whoami-report-the-terminal-and-the-user
run     /dd/CMDS/tty
run     /dd/CMDS/whoami
expect  term
expect  tester
case    vlen-builds-a-variable-length-record-store-and-reports-its-mapper
run     /dd/CMDS/rm -f /dd/test.mp /dd/test.st > /nil 2>/nil
run     /dd/CMDS/vlen < /nil
expect  Created new filesystem
expect  Opening the file...
expect  Adding record #1, length == 50.
expect  minRecl == 10, maxRecl == 300
expect  mapper entries == 11, deleted mapper entries == 0

# mgif -i inspects a GIF and prints its whole header: this is gulls.gif,
# the photograph that ships in /dd/DEMO and that the netpbm cards use.
case    mgif-inspects-a-gif-and-reports-its-header
run     /dd/CMDS/mgif -i /dd/DEMO/gulls.gif
expect  Open file:                           /dd/DEMO/gulls.gif
expect       Screen width (s_dx)       = 320
expect       Screen height (s_dy)      = 200
expect       Num colors (s_colors)     = 256
expect       Interlace    = 0

# The help system: SYS/HELP ships twelve topics, each a .hlp and a .ndx.
case    help-lists-the-topics-it-has-and-asks-for-one
run     echo "q" > $W/q.txt
run     /dd/CMDS/help < $W/q.txt
expect  Advanced HELP system for OS-9 68k, (c) 1989 by Lukas Zeller
expect   - Type "?" at any prompt to get a list of available topics
expect   bm             dinfo          effo           help           indent
expect  Topic ?

case    ispell-lists-its-options-and-names-the-personal-dictionary
run     /dd/CMDS/ispell
expect  Function: interactive spelling checker
expect  	-l         produce a list of misspelled words in file(s)
expect  note: your personal dictionary is kept in HOME/ispell.words
expect  no input files specified

case    jargon-states-its-arguments
run     /dd/CMDS/jargon -?
expect  usage: jargon [-cigmr] [-b key] [srcname] [indexname]

case    finger-names-what-it-cannot-reach
run     /dd/CMDS/NETWORK/finger
expect  Function: display real world info on user.

# The two X11 demos reach their own code and stop where they should: there
# is no X server here.  Until the csl edition-25 swap (2026-09-04) they
# stopped earlier, at `csl traphandler mismatch', and this case pinned that.
case    the-x11-demos-stop-for-want-of-an-x-server
run     /dd/CMDS/basicwin
run     /dd/CMDS/xengine
expect  cannot connect to X server
expect  Can't open display
absent  csl traphandler mismatch

# gnuplot runs and reads a script; `dumb' is not one of the terminals this
# build was compiled with, and it says so with the offending column marked.
case    gnuplot-reads-a-script-and-names-the-terminal-it-does-not-have
run     echo "set terminal dumb" > $W/g.gp
run     echo "quit" >> $W/g.gp
run     /dd/CMDS/gnuplot $W/g.gp
expect  gnuplot> set terminal dumb
expect  unknown terminal type; type just 'set terminal' fo

# `uuencode' IS NOT A CASE HERE; its cases are in encoding.cases,
# untested.cases and PB.cases.  `uuexpand', its partner, is still untested
# and needs a session of its own.
