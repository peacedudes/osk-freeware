family  rebuilt
# CMDS/REBUILT KEEPS A SECOND BUILD of several programs, and until 2026-08-28
# nobody had asked which of each pair was the better one. Two swaps came out
# of asking -- `sed' took REBUILT/sed_1.06 and `m4' took REBUILT/m4_0.5,
# because the shipped m4 mangled its output. These cases record what the rest
# of the pairs actually do, so the question does not have to be re-opened.
#
# The archive pairs are in archives.cases: compress_4.0, zoo_2.1, gtar, ar2
# and the four gzip builds all agree with what ships.
setup   T=/dd/SYS/motd
setup   R=/dd/CMDS/REBUILT

case    wc-and-wc.cio-count-the-same-file-the-same-way
run     /dd/CMDS/wc < $T
expect  1      6     40

case    wc.cio-says-it-in-words-and-ignores-a-filename
run     $R/wc.cio < $T
expect  1 lines, 6 words, 40 chars

# The shipped ctags finds the statics as well as main; elvis's finds main
# and nothing else. That is why the bigger one ships.
#
# THE NAMES, NOT THE COUNT.  This read `absent 1 /dd/tags' against a
# `wc -l', which is a substring test: it passed while about.c had ten
# functions and failed the day it had ELEVEN, because "11 /dd/tags" contains
# "1 /dd/tags". The same shape cost an hour on 2026-09-01 with `40' and `0'.
# A count of a file somebody may edit is the wrong assertion anyway.
case    ctags-finds-the-static-functions
run     /dd/CMDS/rm -f /dd/tags
run     /dd/CMDS/ctags /dd/SRC/keep/about.c
run     /dd/CMDS/cat /dd/tags
expect  main
expect  entry_for
expect  from_depends
expect  find_collection

case    ctags.elvis-finds-only-main
run     /dd/CMDS/rm -f /dd/tags
run     $R/ctags.elvis /dd/SRC/keep/about.c
run     /dd/CMDS/cat /dd/tags
expect  main

# diff_1.1 is twice the size and carries more options; on the same pair of
# files the two agree line for line, so there is nothing to choose.
case    the-two-diffs-agree
run     /dd/CMDS/head -n 6 /dd/SYS/holidays > /dd/tmp/x1 2>/nil
run     /dd/CMDS/sed -e "s/Day/DAY/" /dd/tmp/x1 > /dd/tmp/x2
run     /dd/CMDS/diff /dd/tmp/x1 /dd/tmp/x2 > /dd/tmp/d1.out
run     $R/diff_1.1 /dd/tmp/x1 /dd/tmp/x2 > /dd/tmp/d2.out
# `cmp' IS NOT ON THIS DISK, so the `absent differ' this line used to carry
# passed no matter what the two files held -- a check that could not fail,
# found 2026-08-31. `tcmp' is here and says so in words.
run     /dd/CMDS/tcmp /dd/tmp/d1.out /dd/tmp/d2.out
expect  are identical

# The shipped `arc' is version 5.21 and takes its command letter bare.
case    the-shipped-arc-is-5.21-and-takes-a-bare-command-letter
run     /dd/CMDS/rm -f /dd/a1.arc
run     /dd/CMDS/arc a a1.arc $T
expect  Creating new archive

# C-LHarc: the shipped `lharc' is 1.00, REBUILT/lharcs is 1.01 -- newer, and
# no behavioural difference found. Each reads the other's archive, so there
# is nothing to choose and nothing to swap.
case    lharc-is-1.00-and-lharcs-is-1.01
run     /dd/CMDS/lharc
expect  Version 1.00

case    lharcs-is-the-newer-one
run     $R/lharcs
expect  Version 1.01

case    each-lharc-reads-the-other-s-archive
run     /dd/CMDS/rm -f /dd/tmp/l1.lzh /dd/tmp/l2.lzh
run     /dd/CMDS/lharc a /dd/tmp/l1.lzh $T
run     $R/lharcs a /dd/tmp/l2.lzh $T
run     /dd/CMDS/lharc l /dd/tmp/l2.lzh
expect  1 file
run     $R/lharcs l /dd/tmp/l1.lzh
expect  1 file

# REBUILT/screen_nocio is the trap-free build of the same program and stops at
# the same place -- there is no $HOME/.SCREENS on this disk. Nothing to swap;
# the name records the one real difference, which is that CMDS/screen wants
# cio and this does not.
case    both-screens-want-a-.SCREENS-directory
run     /dd/CMDS/screen
expect  .screens directory
run     $R/screen_nocio
expect  .screens directory

# EVERY MODULE IN HERE NOW ANSWERS TO ITS OWN FILENAME, 2026-08-30. Five of
# these files used to carry the module name of the program in /dd/CMDS that
# they sit beside, and OS-9 finds a program by MODULE name once it is
# resident -- so loading one of them silently answered for the other.
case    rebuilt-compress-calls-itself-compress_rebuilt
run     /dd/CMDS/modinfo $R/compress_rebuilt
expect  Module name           = compress_rebuilt

case    rebuilt-screen-calls-itself-screen_nocio
run     /dd/CMDS/modinfo $R/screen_nocio
expect  Module name           = screen_nocio

case    the-two-compresses-agree-byte-for-byte
run     $R/compress_rebuilt -c < /dd/SYS/termcap > /dd/tmp/rc.Z
run     /dd/CMDS/wc -c /dd/tmp/rc.Z
expect  631
run     /dd/CMDS/compress -dc < /dd/tmp/rc.Z > /dd/tmp/rc.out
run     /dd/CMDS/md5 /dd/tmp/rc.out
expect  ee2c20fa226fe6fc78feec7f123c7a99

case    the-renamed-kermit-still-runs
run     $R/kermit_cio
expect  Usage: kermit

case    the-renamed-pvic-reports-its-own-name
run     /dd/CMDS/modinfo $R/vi_1.0
expect  Module name           = vi_1.0

case    the-renamed-kermit-reports-its-own-name
run     /dd/CMDS/modinfo $R/kermit_cio
expect  Module name           = kermit_cio

case    the-scratch-archives-go-away
run     /dd/CMDS/rm -f /dd/a1.arc /dd/a2.arc /dd/a3.arc /dd/tags /dd/tmp/l1.lzh /dd/tmp/l2.lzh
run     /dd/CMDS/ls /dd/a1.arc
expect  error

# EVERY MODULE UNDER CMDS/REBUILT ANSWERS TO ITS OWN FILENAME, 2026-08-31.
# Before that these all reported the name of the program in /dd/CMDS they sit
# beside: compress_4.0 said `compress', the six gzip builds all said `gzip',
# and loading any of them answered for the shipped one.
case    the-alternates-report-their-own-names
run     /dd/CMDS/modinfo $R/compress_4.0
expect  Module name           = compress_4.0
run     /dd/CMDS/modinfo $R/gzip68k_nocsl
expect  Module name           = gzip68k_nocsl
run     /dd/CMDS/modinfo $R/zoo_2.1
expect  Module name           = zoo_2.1
run     /dd/CMDS/modinfo $R/vi.elvis
expect  Module name           = vi.elvis
run     /dd/CMDS/modinfo /dd/CMDS/vi_cio
expect  Module name           = vi_cio
run     /dd/CMDS/modinfo /dd/CMDS/kermit2
expect  Module name           = kermit2
