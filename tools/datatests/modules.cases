family  modules
# THE FIRST FAMILY THAT LOADS A MODULE, and the reason this file exists.
#
# Every sweep this collection has run started every program with an EMPTY
# module directory. A program that links a library MODULE -- the RTF
# Fortran-77 system links os9lib -- exits at F$Link before it prints
# anything, and was recorded as silent on a condition that cannot occur on a
# real system. Six programs sat in "silent in every stage" for weeks for that
# reason alone.
#
# `load' is what puts a module where F$Link can find it -- the reader's own,
# at /h1/CMDS/load; the harness stages one there (os9env.stage_reader_load).
# These cases prove the pair -- that load works, and that the Fortran set
# comes alive when it has.
load    /dd/CMDS/os9lib

case    for-speaks-once-os9lib-is-loaded
run     /dd/CMDS/for
expect  command: for file

case    lnk-speaks-too
run     /dd/CMDS/lnk
expect  command: lnk

# `fact' is the collection's own Fortran example, written 2026-09-18 so that
# the compiler here has something a reader can see through end to end.  It
# links os9lib like every other RTF program, which is why it belongs in this
# family rather than beside the compilers: with the module loaded it prints
# its table, and without it it would print nothing at all.
case    fact-prints-the-factorials-to-twelve
run     /dd/CMDS/fact
expect  n         n!
expect  1           1
expect  6         720
expect  12   479001600

case    rtf-the-compiler-itself
run     /dd/CMDS/rtf
expect  RTF pathname

# A module that is not there must FAIL, with the error number as its status.
# A `load' that reported success for a missing file would make every case
# above meaningless -- it is the check that can fail.  The STATUS, not the
# text: Microware's load prints `can't load "..." - ' and leaves the number
# to the shell, which bash does not print (measured 2026-09-22).
#
# IT HAS BEEN MADE TO FAIL, which is this collection's rule for a check.
# With the SDK's `load' staged on /h1 the status is 216; with no `load'
# there at all, bash's own not-found path answers 0 and this case fails
# `missing 216' (measured 2026-09-23).  So it tests `load', not the
# shell's ability to say no.
case    load-refuses-what-is-not-there
run     /h1/CMDS/load /dd/CMDS/no-such-module; echo "load says $?"
expect  load says 216

# -l prints the pathlist it loaded from, which is how you tell WHICH copy of
# a module you got when two are reachable.
case    load-l-reports-the-path
run     /h1/CMDS/load -l /dd/CMDS/rtfdat
expect  loaded "/dd/CMDS/rtfdat"

# And the module really is resident afterwards.  `mexist' PRINTS NOTHING in
# either case -- it answers in the exit status only -- so the status is what
# this asks for.  Written the obvious way (`absent not found') the case
# passed with no module loaded at all, because an `absent' test over empty
# output can never fail.  That is the shape of a check that cannot fail, and
# this file is where one would do the most damage.
case    the-module-is-in-the-directory
run     /dd/CMDS/mexist os9lib; echo "mexist os9lib says $?"
expect  mexist os9lib says 0

case    mexist-says-no-to-what-is-not-loaded
run     /dd/CMDS/mexist definitelynotamodule; echo "mexist junk says $?"
absent  mexist junk says 0

# which asks the module directory first, as the shell does -- and a module
# in memory has no filename, so which names the file holding the same module
# (name, size and CRC).  ckermit's module is called wermit, so the filename
# and the module name differ, which is the case worth proving.
case    which-names-the-file-a-module-in-memory-came-from
run     export PATH=/dd/CMDS
run     /h1/CMDS/load /dd/CMDS/ckermit
run     /dd/CMDS/which wermit
expect  in memory, same as /dd/CMDS/ckermit

case    which-finds-a-file-on-PATH-by-its-filename
run     export PATH=/dd/CMDS/GAMES:/dd/CMDS
run     /dd/CMDS/which -a ckermit
expect  /dd/CMDS/ckermit
absent  in memory

case    which-reports-what-it-cannot-find
run     export PATH=/dd/CMDS
run     /dd/CMDS/which definitelynotacommand; echo "which junk says $?"
expect  definitelynotacommand not found in:
expect  which junk says 1

# which names the data directory the way pd does, a level at a time.  It
# climbed with `../..' once, which on OS-9 opens the parent again, so three
# levels down it could only answer `.'.
case    which-names-a-deep-data-directory
run     /dd/CMDS/rm -rf /dd/tmp/WDEEP
run     /dd/CMDS/mkdir -p /dd/tmp/WDEEP/a/b
run     /dd/CMDS/cp /dd/SYS/motd /dd/tmp/WDEEP/a/b/note
run     export PATH=/dd/CMDS
run     /dd/CMDS/ksh -c "cd /dd/tmp/WDEEP/a/b; /dd/CMDS/which note"
expect  /dd/tmp/WDEEP/a/b/note
