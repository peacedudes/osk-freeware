family  files
setup   /dd/CMDS/rm -f /dd/tmp/c1 /dd/tmp/c2
setup   /dd/CMDS/head -n 3 /dd/SYS/holidays > /dd/tmp/c1
setup   /dd/CMDS/sed -e "s@1/1@9/9@" /dd/tmp/c1 > /dd/tmp/c2
# FILES AND DIRECTORIES, proved by what is on the disk afterwards rather than
# by what the program said.  Every case works in /dd/tmp/ft, which the first
# one makes and the last one takes away, so the family can be run again and
# mean the same thing.
setup   /dd/CMDS/rm -rf /dd/tmp/ft
setup   /dd/CMDS/mkdir /dd/tmp/ft
setup   /dd/CMDS/cat /dd/SYS/motd > /dd/tmp/ft/one

case    mkdir-and-dir-agree
run     /dd/CMDS/mkdir /dd/tmp/ft/sub
run     /dd/CMDS/dir /dd/tmp/ft
expect  sub
expect  Total of

case    cp-copies-the-bytes
run     /dd/CMDS/cp /dd/tmp/ft/one /dd/tmp/ft/two
run     /dd/CMDS/md5 /dd/tmp/ft/one /dd/tmp/ft/two
expect  6ae70057a9ed39f4db5229e3871721ae

case    mv-renames-rather-than-copies
run     /dd/CMDS/mv /dd/tmp/ft/two /dd/tmp/ft/three
run     /dd/CMDS/ls /dd/tmp/ft
expect  three
absent  two

case    rm-removes
run     /dd/CMDS/rm /dd/tmp/ft/three
run     /dd/CMDS/ls /dd/tmp/ft
absent  three

case    ls-l-shows-the-size
run     /dd/CMDS/ls -l /dd/tmp/ft/one
expect  40

case    fstat-reads-the-attributes
run     /dd/CMDS/fstat /dd/tmp/ft/one
expect  Owner
expect  File Length

case    basename-and-dirname-take-a-path-apart
run     /dd/CMDS/basename /dd/CMDS/GAMES/hack
expect  hack
absent  Usage
run     /dd/CMDS/dirname /dd/CMDS/GAMES/hack
expect  /dd/CMDS/GAMES

case    du-adds-up-a-directory
run     /dd/CMDS/du /dd/tmp/ft
expect  /dd/tmp/ft
expect  Total of

# `find' here is NOT the Unix one: it takes `-n=<name>' and `-o' to output
# the pathnames, and answers `only one parameter allowed' to the Unix form.
case    find-walks-a-tree
run     /dd/CMDS/find -o -n=one /dd/tmp/ft
expect  /dd/tmp/ft/one

case    find-refuses-the-unix-form
run     /dd/CMDS/find /dd/tmp/ft -name one -print
expect  only one parameter allowed

# `l' answers `not accessable, error: 214' for every directory tried, which
# is not what a brief directory listing should do.  Asserted so it fails the
# day it is fixed.
case    l-still-cannot-list-a-directory
run     /dd/CMDS/l /dd/tmp/ft
expect  214

case    space-measures-the-tree
run     /dd/CMDS/space /dd/tmp/ft
absent  can't

case    the-scratch-tree-goes-away-again
run     /dd/CMDS/rm -rf /dd/tmp/ft
run     /dd/CMDS/ls /dd/tmp/ft
expect  216

# `queens' reads the board size on standard input as a NUMBER, which is why
# every sweep here scored it silent: they all feed the same three lines of
# prose.  It is in this family because the point is the INPUT, not the file.
case    queens-solves-a-board-when-given-a-number
run     echo 5 | /dd/CMDS/queens
expect  Q# #

# `mkdir -p' WORKS, measured 2026-08-29.  CLAUDE.md said it did not, which is
# the kind of hard-won rule that costs a session when it is wrong: a script
# that avoids -p builds directories one at a time and gets the order wrong.
case    mkdir-p-builds-the-whole-chain
run     /dd/CMDS/rm -rf /dd/tmp/pp
run     /dd/CMDS/mkdir -p /dd/tmp/pp/a/b/c
run     /dd/CMDS/ls /dd/tmp/pp/a/b
expect  c
absent  Error

case    and-the-scratch-chain-goes-away
run     /dd/CMDS/rm -rf /dd/tmp/pp
run     /dd/CMDS/ls /dd/tmp/pp
expect  216

# PATH SEARCH WORKS AGAINST THE IMAGE.  disk/readme said it did not and told
# everyone to type /dd/CMDS/ in front of every command; that is the UNPACKED
# DIRECTORY's behaviour, not the image's.  This case runs a bare command name
# through the login environment, which is what a person actually types.
case    a-bare-command-name-is-found-on-the-image
run     /dd/CMDS/ksh -c "PATH=/dd/CMDS; export PATH; chksum /dd/SYS/motd"
expect  b4d9f557

# THE SILENT HALF OF THE cio SELECTOR MISMATCH, asserted so a fix announces
# itself. These programs open the file, read NOT ONE BYTE (measured with
# `os9exec -d1 0x0002': opens=1, reads=0) and report on it anyway. The day
# someone supplies a matching cio module, or rebuilds them, these cases fail
# and that is the point of them. DOC/README-CIO names all nine.
# KEYED ON THE MECHANISM, NOT THE MESSAGE. A working context diff, given two
# files differing in one line, prints that line. This one prints none of the
# file's content because it never reads a byte of it -- so `absent' is the
# assertion, and it survives the error text being reworded. The day a matching
# cio module appears, cdiff prints the changed line and this case fails, which
# is what it is for.
# THREE TRAPS AVOIDED HERE, each of which produced a false failure first.
# datatest captures the command LINES as well as their output, and it re-runs
# the family's `setup' lines after a restart -- so any string named in a
# command can appear inside a later case's transcript. The fixture therefore
# differs by a DATE (1/1 -> 9/9) and the assertion is on a word that appears
# in no command anywhere: `Year', which is only ever inside the file.
#
# A working context diff, given two files differing in one line, prints that
# line -- and that line contains "New Year's Day". This cdiff prints none of
# it, because it never reads a byte. So the day a matching cio module appears,
# this case fails, which is what it is for.
# And the ORDER matters: cdiff ends its output with a BEL and no newline, so
# the NEXT case's marker does not land at line start and is not matched --
# that case's output is then attributed to cdiff. The control is therefore
# placed BEFORE it, and what follows cdiff must contain no `Year'.
# The control that makes the case above mean something: a program with no
# getc macro call site reads the very same file correctly.
case    cat-reads-the-files-cdiff-could-not
run     /dd/CMDS/cat /dd/tmp/c1
expect  New Year
run     /dd/CMDS/cat /dd/tmp/c2
expect  9/9

# THESE TWO CASES HAVE TURNED OVER, 2026-08-31. They used to assert that
# `cdiff' and `nroff' printed NONE of the content they were given -- the
# silent half of the cio selector mismatch -- and they said so in the comment
# above: "the day a matching cio module appears, this case fails, which is
# what it is for". No matching module appeared; the two programs were REBUILT
# trap-free instead, and now they read their input. The assertions are
# reversed rather than deleted, so the file that proved the fault also proves
# the fix. tools/datatests/cio11.cases has all eleven.
case    cdiff-now-prints-the-line-that-differs
run     /dd/CMDS/cdiff /dd/tmp/c1 /dd/tmp/c2
expect  Year
expect  Difference of file

case    nroff-now-prints-the-text-it-was-given
run     /dd/CMDS/nroff /dd/tmp/c1
expect  New Year
run     /dd/CMDS/rm -f /dd/tmp/c1

# whereis searches SRC, CMDS, DEFS, LIB and DOC all the way down.  Source on
# this disk is filed by the archive it came in, so gen's source is found only
# by descending into SRC/divutils.
case    whereis-finds-source-filed-under-its-archive
run     /dd/CMDS/whereis gen
expect  /dd/SRC/divutils/gen.c
expect  /dd/CMDS/gen

case    whereis-reports-a-matching-directory-and-does-not-enter-it
run     /dd/CMDS/whereis -s keep
expect  /dd/SRC/keep
absent  /dd/SRC/keep/keep.c

case    whereis-ignores-case-as-RBF-does
run     /dd/CMDS/whereis -b GEN
expect  /dd/CMDS/gen

# ls -l names a file's owner from FD_OWN.  The os9lib stat it links left
# st_uid and st_gid at zero, so until 2026-09-23 every file said 0 0.  The
# file is made as tester (1.7) so the owner cannot be 0.0 by accident.
case    ls-names-the-owner-a-file-was-made-by
run     /dd/CMDS/rm -f /dd/tmp/lsown.txt
run     /dd/CMDS/su -s /dd/CMDS/bash tester -c "echo x > /dd/tmp/lsown.txt"
run     /dd/CMDS/ls -ln /dd/tmp/lsown.txt
expect  1 7        1   
