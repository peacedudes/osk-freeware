# refusals -- the residue that has a stable answer, 2026-09-19.
#
# `untested.cases' is the 2026-09-01 pass over the same gap.  This is the
# next layer down: tools/worklist.py --programs --no-test listed 22 more,
# most of them wanting hardware that is not here or taking the session
# with them when they run, and neither can be a case.  These seven can.
#
# A REFUSAL IS A MEASUREMENT.  Four of these say, in the same words every
# time, what they are missing -- a G-Windows display, a modem port, a
# mailbox -- and recording the words is what stops a future change turning
# "it says it needs G-Windows" into "it says nothing at all", which is the
# failure this collection keeps finding after the fact rather than before.
#
# `creadoc' is NOT here and cannot be: it lists its directory through your
# own OS-9's `dir' and forks its `shell', both loaded off /h1, and
# datatest.py mounts no /h1.  Its gallery card does that work; see
# tools/screenshots/compilers.sheet.

family  refusals

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   export HOME=/dd

case    colortest-names-the-device-it-wants
# G-Windows is Microware's windowing system and /win is its device.
run     /dd/CMDS/GAMES/colortest
expect  Not a G-Windows

case    dclock-says-it-needs-g-windows
run     /dd/CMDS/GAMES/dclock
expect  dclock only runs under G-Windows

case    lmargin-prints-its-usage-under-its-authors-name
# It reports itself as `epson': one program built twice, for the left
# margin and the right.  DOC/INDEX says so.
run     /dd/CMDS/lmargin -?
expect  usage: epson
expect  size of left margin

case    sterm-wants-a-modem-port
run     /dd/CMDS/COMMS/sterm
expect  No MODEM port defined

# `mailx' IS DELIBERATELY NOT HERE.  It was, for one evening, and it gave
# three different answers to the same inputs between 01:25 and 02:15 on
# 2026-09-19 -- "no mail waiting", then "can't change to your mailbox
# directory: 'su'...error 214", then the same with error 216 -- while the
# os9exec working copy beside this one was being rebuilt (sockets, and a
# memory-block ceiling).  A case cannot pin behaviour that is moving; its
# gallery card shows what it does and says no more than that.

case    kermit-r15-prints-its-modes
run     /dd/CMDS/kermit
expect  OS-9 Kermit Version 1 Release 5
expect  (connect mode)
expect  (Host server mode)

case    kermit2-is-release-6-with-the-same-modes
run     /dd/CMDS/kermit2
expect  Kermit Program   Version 1    Release 6
expect  (connect mode)
expect  (send mode)
