# refusals -- the residue that has a stable answer, 2026-09-19.
#
# `untested.cases' is the 2026-09-01 pass over the same gap.  This is the
# next layer down: tools/worklist.py --programs --no-test listed 22 more,
# most of them wanting hardware that is not here or taking the session
# with them when they run, and neither can be a case.  These six can.
#
# A REFUSAL IS A MEASUREMENT.  Three of these say, in the same words every
# time, what they are missing -- a G-Windows display, a modem port -- and
# recording the words is what stops a future change turning "it says it
# needs G-Windows" into "it says nothing at all", which is the failure
# this collection keeps finding after the fact rather than before.  A
# seventh, `mailx', was here and is not; the note further down says why.
#
# `creadoc' is NOT here and cannot be: it lists its directory through your
# own OS-9's `dir' and forks its `shell', both loaded off /h1, and
# datatest.py mounts no /h1.  Its gallery card does that work; see
# tools/screenshots/compilers.sheet.

family  refusals

setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   export HOME=/dd

case    colortest-names-the-device-it-wants
# G-Windows is Microware's windowing system and /win is its device.
run     /dd/CMDS/GAMES/colortest
expect  Not a G-Windows

case    dclock-says-it-needs-g-windows
run     /dd/CMDS/GAMES/dclock
expect  dclock only runs under G-Windows

case    lmargin-prints-its-usage-under-its-authors-name
# It reports itself as `epson': one program built twice, for the left
# margin and the right.  DOC/INDEX says so.
run     /dd/CMDS/lmargin -?
expect  usage: epson
expect  size of left margin

case    sterm-wants-a-modem-port
run     /dd/CMDS/COMMS/sterm
expect  No MODEM port defined

# `mailx' IS DELIBERATELY NOT HERE, and the reason is worth reading before
# anyone adds it back.  On 2026-09-19 it gave three answers to the same
# inputs inside fifty minutes: "no mail waiting" at 01:25, "can't change to
# your mailbox directory: 'su'...error 214" at 01:55, and the same with
# error 216 at 02:15.  The os9exec session confirms its binary did NOT
# change between the first two, so at least that step is not theirs, and I
# could not find what it was: replaying the SAME probe files against a
# PINNED binary and a FRESHLY BUILT image gives error 216 every time, five
# runs, both export forms.  Three earlier readings say otherwise and cannot
# be reproduced.
#
# So: the current answer is stable but the history is not, and a case
# that flaps is worse than a gap in coverage.  Its gallery card shows what
# it does and claims no mechanism.  If you make it reproduce, write the
# case and take `mailx' off the untested list.

case    kermit-r15-prints-its-modes
run     /dd/CMDS/kermit
expect  OS-9 Kermit Version 1 Release 5
expect  (connect mode)
expect  (Host server mode)

case    kermit2-is-release-6-with-the-same-modes
run     /dd/CMDS/kermit2
expect  Kermit Program   Version 1    Release 6
expect  (connect mode)
expect  (send mode)
