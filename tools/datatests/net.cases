family  net
# The communications programs that talk to a peer this emulator does not
# have: TCP/IP, packet radio, serial transfer.  NONE OF THEM CAN WORK HERE
# and that is not a defect -- os9exec presents no network and no second
# serial line.  So each case asserts what the program says about the device
# it cannot have, which is the only honest thing to assert and is exactly
# what somebody moving this onto real hardware needs to recognise.
#
# WHY THESE WERE UNTESTED FOR SO LONG.  `comms.drive' ran osknet, net,
# msntp, atp and infoxpress in ONE stanza, and osknet ends the session --
# so the transcript stopped after its banner and the other four never ran
# at all, while being recorded as driven.  Same for `xy-and-z': xy answers
# a receive handshake and waits, and z never ran.  One program per stanza.

# `atp' stops with "Unknown terminal type 'dumb'!" without these --
# datatest.py does not set SYS/login's environment, drive.py does.
setup   export TERM=vt100
setup   export TERMCAP=/dd/SYS/termcap
setup   W=/dd/tmp/NET
setup   /dd/CMDS/mkdir -p $W > /nil 2>/nil

# KA9Q net -- the packet-radio TCP/IP suite. It names every file it wants
# and then says where the manual is, which is the most useful thing it can
# do here. The two it calls Errors are /usr/spool paths, and OS-9 cannot
# have a /usr at all: a leading /name is a DEVICE.
case    net-names-the-files-it-cannot-find-and-stops
run     echo "exit" > $W/net.in
run     /dd/CMDS/NETWORK/net < $W/net.in
expect  Internet Protocol Package, (C) 1988 by Phil Karn, KA9Q
expect  startup.net not found
expect  hosts.net not found
expect  Error: Directory /usr/spool/mail not found
expect  Sorry, Chapter 2 will help you set up correctly.

case    atp-wants-a-configuration-file-and-says-which
run     /dd/CMDS/NETWORK/atp < /nil
expect  Reading Configuration file...
expect  Unable to open configuration file /dd/atprc or .atprc !

# `ttcp': its usage, and a real transfer.  The receiver waits in the
# background and the sender gives it a megabyte through the loopback, on a
# port of its own so nothing else on the host is in the way.  Needs an
# os9exec that answers /socket (a4b338e and later).
case    ttcp-sends-a-megabyte-to-itself-over-tcp
run     /dd/CMDS/NETWORK/ttcp -r -s -p28765 > $W/ttcp.r 2>&1 &
run     /dd/CMDS/NETWORK/ttcp -t -s -p28765 127.0.0.1 2>&1
run     /dd/CMDS/cat $W/ttcp.r
expect  ttcp-t: 1048576 bytes processed
expect  ttcp-r: 1048576 bytes processed

case    ttcp-prints-both-halves-of-its-usage
run     /dd/CMDS/NETWORK/ttcp < /nil
expect  Usage: ttcp -t [-options] host <in
expect  Usage: ttcp -r [-options] >out
expect  use UDP instead of TCP

# BIND's two: the usage line, and that nslookup READS resolv.conf -- it
# names the server the file gives before it reaches for the socket.  The
# file goes at the root of /h0 because that path is compiled in; the case
# removes it again, since the image is not reset between runs.
case    nsquery-prints-its-usage
run     /dd/CMDS/NETWORK/nsquery < /nil
expect  usage: nsquery [-d] host [server]

case    nslookup-reads-the-server-from-resolv-conf
run     /dd/CMDS/cat /dd/DOC/bind/resolv.conf > /h0/resolv.conf
run     /dd/CMDS/NETWORK/nslookup ftp.funet.fi < /nil
run     /dd/CMDS/rm -f /h0/resolv.conf
expect  address 127.0.0.1

# `msntp' IS DELIBERATELY NOT A CASE ANY MORE.  It wanted csl edition 25,
# which has shipped since 2026-09-04, and it then stopped where every
# program here stopped: "unable to allocate socket for NTP", no network to
# open a socket on.  On 2026-09-19 os9exec grew real sockets -- its own log
# that day has "a socket connect parks its caller instead of freezing the
# emulator" -- and msntp now BLOCKS instead of failing: run under gtimeout
# 90 against a host with no NTP server it printed nothing and never
# returned.  A case that hangs is worse than no case, and what it would be
# measuring is the emulator's network, not this disk.  Its card stands.

case    ckermit-reports-its-version-and-its-os9-modules
run     echo "show version" > $W/k.in
run     echo "exit" >> $W/k.in
run     /dd/CMDS/ckermit < $W/k.in
expect  C-Kermit 5A(190) BETA.14, 24 Jul 94
expect  OS-9 Communications I/O
expect  OS-9 file support
expect  C-Kermit Protocol Module

# z is Tim Kientzle's ZMODEM. `-?' prints the usage; bare it starts a
# receive handshake against nothing and gives up. `xy', its XMODEM/YMODEM
# twin, has NO usage flag -- `-h' means host mode there and starts the
# handshake, which is how it took a drive stanza down.
case    z-explains-itself-and-names-the-MODEM-variable
run     /dd/CMDS/COMMS/z -? < /nil
expect  To send files:      Z <file1> <file2> <etc.>
expect  Z uses the MODEM environment variable to determine the port
expect  Copyright (C) 1995 Tim Kientzle

# fixtext repairs the line endings of a received text batch, and what it
# actually does is map LF to CR -- so a DOS file's CRLF becomes CR CR and
# the length does not change. Worth pinning exactly, because "repair"
# suggests the pair would collapse to one and it does not.
case    fixtext-maps-LF-to-CR-and-leaves-the-length-alone
run     /dd/CMDS/autolf -c -C -L < /dd/SYS/motd > $W/crlf.txt
run     /dd/CMDS/UUCP/fixtext $W/crlf.txt $W/fixed.txt
run     /dd/CMDS/wc -c /dd/SYS/motd $W/crlf.txt $W/fixed.txt
run     /dd/CMDS/dump $W/fixed.txt
expect  40 /dd/SYS/motd
expect  41 /dd/tmp/NET/crlf.txt
expect  41 /dd/tmp/NET/fixed.txt
expect  6D75 6C61 746F 720D 0D

# rxmod loads a module sent over a serial line by txmod, and its trap
# handler IS on this disk beside it -- `load' installs it and the message
# changes. What happens next is a fault inside the trap, not a missing
# module, and the two are worth telling apart.
case    rxmod-says-so-when-its-trap-handler-is-not-loaded
run     /dd/CMDS/COMMS/rxmod -? < /nil
expect  can't install Vmod Trap handler

case    txmod-explains-the-other-half-of-the-pair
run     /dd/CMDS/COMMS/txmod -? < /nil
expect  TXMod Ed.1 Rv.2 - send Module via SCF to RXMod to link there
expect  Syntax: TXMod [<opts>] module(s) [<opts>]
expect  -l[=]<dev> : use dev for xmission

# fileserv serves files to remote sites on request and exits 0 in silence.
# /dd/SYS/UUCP/Parameters answers `server' TWICE -- yes at line 85, no at
# line 101 -- which is a copy-paste in the UUCPbb sample the file came from.
# The duplicate is asserted so that fixing it is a deliberate act.
case    the-Parameters-file-answers-server-twice
run     /dd/CMDS/grep -n "^server" /dd/SYS/UUCP/Parameters
run     /dd/CMDS/grep -n "^fileserver" /dd/SYS/UUCP/Parameters
expect  85:server = yes
expect  101:server = no
expect  104:fileserver = /dd/SPOOL/files

# fileserv IS DRIVEN FROM STANDARD INPUT and needs no remote peer at all.
# SRC/uucpbb/fileserv.c documents the protocol in its own header: a mail
# message whose body holds commands, five of them -- `reply <address>',
# `help', `get <filename>', `dir' and `quit'.  The help file it answers
# `help' from ships at SYS/UUCP/FileServ.help.
#
# IT FORKS `rmail' BY BARE NAME to send each reply, and a bare-name fork
# resolves against chx, never against PATH -- so from an ordinary shell it
# answers `cannot spawn process--> rmail ... (error 216)' because rmail is
# in CMDS/UUCP and chx is CMDS.  `load' it first and the fork succeeds.
# That is the same trick DOC/README-RUNNING gives for printmail/readmsg.
#
# The chain then stops inside rmail, which wants the mailbox to be a
# DIRECTORY named for the user -- see MAIL/README.  So what this asserts is
# the whole of what happens here: fileserv read the request, built a reply,
# forked rmail, and rmail said what it wants.  Measured 2026-09-21.
case    fileserv-answers-a-request-read-from-standard-input
run     /dd/CMDS/rm -rf /dd/tmp/FSA > /nil 2>/nil
run     /dd/CMDS/rm -f /dd/LOG/FileServ > /nil 2>/nil
run     /dd/CMDS/mkdir -p /dd/tmp/FSA
run     echo "From tester Mon Sep 21 00:00:00 2026" > /dd/tmp/FSA/req
run     echo "Subject: request" >> /dd/tmp/FSA/req
run     echo "" >> /dd/tmp/FSA/req
run     echo "reply tester" >> /dd/tmp/FSA/req
run     echo "help" >> /dd/tmp/FSA/req
run     echo "quit" >> /dd/tmp/FSA/req
# rmail reads HOME, and datatest sets none -- `getuser: HOME is not
# defined' is what it says without this, and the reply never gets as far
# as the mailbox.  SYS/login sets it, which is why this works by hand.
run     export HOME=/dd
run     /h1/CMDS/load /dd/CMDS/UUCP/rmail
run     /dd/CMDS/UUCP/fileserv < /dd/tmp/FSA/req
run     /dd/CMDS/cat /dd/LOG/FileServ
# PUT THE LOG BACK.  `driven.cases' asserts that uulog cannot open
# /DD/LOG/fileserv, so leaving this file behind fails THAT case on the
# suite's second run -- which is what the run-it-twice rule is for, and it
# caught this one.  The log ships absent; leave it absent.
run     /dd/CMDS/rm -f /dd/LOG/FileServ
expect  can't change to mailbox
expect  unable to fork RMAIL
absent  cannot spawn process
