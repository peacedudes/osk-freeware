# dm is Bob Devries' DiskMaster for the SECAD board; its makefile links SECAD's
# alib.l, which is not here.  strucmp, strstr and rename come from the os9alib
# shim -- os9lib.l has a real rename, but its psect also defines `copy', which
# dm's own misc.c defines, and l68 refuses the link.
dm|dm|diskmaster.c screen.c dirread.c showfiles.c misc.c error.c unarc.c mouse.c multicopy.c multidel.c multimove.c multiattr.c shellsort.c multitag.c listarc.c ../unixlib/getopt.c|VER=1 REV=3||
