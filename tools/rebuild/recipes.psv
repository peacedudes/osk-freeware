wam.sbprolog|sbprolog/SIM|dispatch.c init.c float.c io.c sub_inst.c loader.c main.c parse_oprnd.c dis.c print_inst.c unify.c load_work.c aux.c mathutil.c builtin/arith.c builtin/buffer.c builtin/builtin.c builtin/compare.c builtin/file.c builtin/init_branch.c builtin/meta.c builtin/name.c builtin/other.c builtin/saverest.c builtin/structure.c builtin/substuff.c builtin/syscall.c builtin/time.c builtin/tio.c|OS9|/dd/LIB/os9lib.l /dd/LIB/math.l|
# uucpbb -- Bob Billson's uucp/news package, 21 of its 24 programs, each
# from its own object group in makefile.c32.  Three are out: `login' wants
# an <os9.h> nothing here has, and `chown' and `cnvrtmail' assign to
# fd_own, which is an ARRAY in this <direct.h> -- a port written against a
# version where it was one number, and not something to guess at in a
# program that changes file ownership.
# Note uucico, uucp and uuxqt are also built from SRC/uucp_blars; two
# packages, both here, both compile.
adduser|uucpbb|adduser.c strdetab.c getenv.c strdup.c termio.c mfgets.c osk.c pwent.c parse.c|TERMCAP _OSK|/dd/LIB/termlib.l|
