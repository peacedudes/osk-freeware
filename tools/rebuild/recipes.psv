pvic|pvic/SRCE|alloc.c main.c cmdline.c edit.c enveval.c fileio.c help.c hexchars.c linefunc.c mark.c misccmds.c normal.c ops.c param.c ptrfunc.c regexp.c regsub.c screen.c search.c sentence.c tagcmd.c undo.c termcap.c termin.c general.c locfuncs.c||/dd/LIB/curses.l /dd/LIB/termlib.l /dd/LIB/math.l|
# Bob Larson's Unix-compatibility library.  32 of its 36 objects.  The four
# left out, each for a reason that is not about his code:
#   stat.c     wants sys/types.h to define dev_t as a STRUCT, and the overlay's
#              DEFS/sys/types.h is SRC/COMPAT's, which deliberately leaves
#              dev_t alone.  cpp will not search a -V directory for a name with
#              a directory in it, so there is no way to give two trees a
#              different <sys/types.h>.
#   ftime.c makenv.c putenv.c   want time_t, and the SDK's <time.h> hides its
#              typedef behind #ifndef ctime.
#   gethostname.c  its makefile passes -DHOSTNAME="name", quotes and all,
#              and the OS-9 shell will not carry an embedded quote.  The
#              collection's own shim supplies gethostname anyway.
# See notes/BLARSLIB.md.
blarslib.l|blarslib|alarm.c atan2.c bstring.c ctermid.c exec.c fsync.c getcwd.c getgid.c getopt.c getpw.c getwd.c isatty.c mkdir.c perror.c popen.c rand.c signal.c strchr.c strcspn.c strpbrk.c strrchr.c strspn.c strtok.c times.c ttyname.c umask.c usleep.c utime.c vfprintf.c vsprintf.c alloca.c ln.c|STACKDIR=-1 link=link|| -V=/dd/DEFS/blarsdefs
# Bob Larson's uucp.  Its own Makefile links blarslib, which is why these could
# not build before it was here.  gethostname comes from a shim: OS-9 has no
# node name, and blarslib's own gethostname.c wants a QUOTED -D the OS-9 shell
# will not carry.
uucico|uucp_blars|dcp.c dcpsys.c dcpxfer.c dcpgpkt.c dcpfpkt.c dcpmisc.c dcpio.c mfgets.c||/dd/LIB/blarslib.l|
uux|uucp_blars|uux.c getseq.c||/dd/LIB/blarslib.l|
uuxqt|uucp_blars|uuxqt.c mfgets.c getargs.c||/dd/LIB/blarslib.l|
uucp|uucp_blars|uucp.c mfgets.c getseq.c||/dd/LIB/blarslib.l|
uupoll|uucp_blars|uupoll.c||/dd/LIB/blarslib.l|
