# The rest of macutils, beside binhex and unsit.  Two things to know:
# macsave, macstream and macunpack each carry an fputc.c that rebuilds
# fputc out of fprintf, for a library that had none -- clibn HAS one, in
# the same psect as fflush, so compiling theirs makes l68 stop on a
# duplicate.  Left out on purpose.  And hexbin needed the size_t typedef
# in DEFS/blarsdefs/sys/types.h guarded; see the note in that file.
# All six were compared against the shipped binaries and match.
hexbin|macutils/HEXBIN|hexbin.c dl.c hecx.c hqx.c mu.c buffer.c crc.c readline.c printhdr.c globals.c ../UTIL/transname.c ../UTIL/util.c ../UTIL/backtrans.c ../FILEIO/wrfile.c ../FILEIO/fileglob.c ../CRC/binhex.c ../CRC/ccitt.c|CPP2 NODOT|/dd/LIB/blarslib.l|-V=/dd/DEFS/blarsdefs -V=/h6/macutils/UTIL -V=/h6/macutils/FILEIO -V=/h6/macutils/CRC
mcvert|macutils/MCVERT|mcvert.c hqxify.c unpack.c|CPP2|/dd/LIB/blarslib.l|-V=/dd/DEFS/blarsdefs
macsave|macutils/MIXED|macsave.c globals.c macbinary.c dir.c mcb.c ../UTIL/transname.c ../UTIL/util.c ../FILEIO/wrfile.c ../FILEIO/fileglob.c|CPP2 NODOT|/dd/LIB/blarslib.l|-V=/dd/DEFS/blarsdefs -V=/h6/macutils/UTIL -V=/h6/macutils/FILEIO -V=/h6/macutils/CRC
macstream|macutils/MIXED|macstream.c ../UTIL/transname.c ../UTIL/util.c ../UTIL/backtrans.c ../FILEIO/rdfile.c ../FILEIO/fileglob.c|CPP2 NODOT|/dd/LIB/blarslib.l|-V=/dd/DEFS/blarsdefs -V=/h6/macutils/UTIL -V=/h6/macutils/FILEIO -V=/h6/macutils/CRC
macunpack|macutils/MACUNPACK|macunpack.c globals.c macbinary.c dir.c mcb.c bin.c jdw.c stf.c lzc.c pit.c sit.c dia.c cpt.c zma.c lzh.c dd.c de_huffman.c de_compress.c de_lzah.c de_lzh.c crc.c bits_be.c ../UTIL/transname.c ../UTIL/util.c ../FILEIO/wrfile.c ../FILEIO/fileglob.c ../CRC/binhex.c ../CRC/ccitt.c|CPP2|/dd/LIB/blarslib.l|-V=/dd/DEFS/blarsdefs -V=/h6/macutils/UTIL -V=/h6/macutils/FILEIO -V=/h6/macutils/CRC
makecrc|macutils/CRC|makecrc.c|CPP2 NODOT||
# Five more, each compared against the shipped binary and identical.
perr|bix|perr.c|||
qsort9|bix|qsort9.c|||
rdjpgcom|jpeglib/JPEG_5A|rdjpgcom.c|KNR||
wrjpgcom|jpeglib/JPEG_5A|wrjpgcom.c|KNR||
lessecho|less/less_332|lessecho.c version.c|_OSK_MWC32=1 _OSK=1||
# lesskey builds and works, and is NOT identical to the shipped one: given no
# key file, ours says "Cannot open /dd/.lesskey" and prints its usage, while
# the shipped build lets OS-9's E$PNNF escape.  Different builds of the same
# program.  Nothing installed either way.
lesskey|less/less_332|lesskey.c version.c|_OSK_MWC32=1 _OSK=1||
# NOT here on purpose: SRC/bix has chown.c, dir.c and mkdir.c, and none of
# them is the CMDS program of that name -- compared, and all three differ
# completely (CMDS/chown takes <opts>, bix's takes -z; CMDS/dir lists a
# directory, bix's does something else).  Matching a source file by NAME is
# evidence, not proof, and these three are where it runs out.
# elvis's four helper programs.  The makefile lists more files on each rule's
# DEPENDENCY line than its compile line uses -- ctags names wildcard.c and
# elvprsv names five others, and compiling those really does break the link.
# Take the compile line, not the dependency line.  All four compared against
# the shipped binaries and identical; CMDS/ctags is the BSD one, so elvis's is
# REBUILT/ctags.elvis, whose module is called ctags.
ctags.elvis|elvis|ctags.c osk.c|MODNAME=ctags|/dd/LIB/termlib.l|
ref|elvis|ref.c||/dd/LIB/termlib.l|
elvrec|elvis|elvrec.c osk.c||/dd/LIB/termlib.l|
elvprsv|elvis|elvprsv.c||/dd/LIB/termlib.l|

# ---- netpbm / pbmplus, the four support libraries ----------------------
# Andrzej Kotanski's OSK port, 169 programs.  Every one of them is ONE source
# file plus one of these libraries -- the package's own Makefile.std says so
# in its PORTBINARIES/OBJECTS lists and in its `$(PORTBINARIES): $(LIBPBM)'
# rule.  So the libraries come first and the programs are mechanical after.
#
# -V=/h6/netpbm is not optional: every source opens "../pbmplus.h", and
# libpbm1.c also wants ../version.h and ../compile.h.  Makefile.std spells
# this INCLUDE = -I.. and it is the only include path the package needs.
#
# SYSV is the package's own switch for a System V-ish C library, and it is
# the right one here: it maps random/srandom onto rand/srand, index/rindex
# onto strchr/strrchr, bcopy/bzero/bcmp onto memcpy/memset/memcmp, and takes
# <string.h> rather than BSD's <strings.h>.  OS-9's K&R library has the
# System V spellings and none of the BSD ones.
#
# NEED_VFPRINTF2 is the package's OWN answer, not a shim of ours: libpbm1.c
# carries a portable mini-vfprintf behind that define, for systems with
# neither vfprintf nor _doprnt, and OS-9's K&R library is one.  Without it
# every program linking pbm.l stops with `Symbol vfprintf unresolved,
# referenced by psect libpbm1_c'.  Only libpbm1.c has the #ifdef, so only
# this recipe carries the define.
#
# NEED_VFPRINTF2 is the package's OWN answer, not a shim of ours: libpbm1.c
# carries a portable mini-vfprintf behind that define, for systems with
# neither vfprintf nor _doprnt, and OS-9's K&R library is one.  Without it
# every program linking pbm.l stops with `Symbol vfprintf unresolved,
# referenced by psect libpbm1_c'.  Only libpbm1.c has the #ifdef, so only
# this recipe carries the define.
#
# PGM/PPM/PNM stack: pgm.h includes pbm.h, ppm.h includes pgm.h, pnm.h
# includes all three, so each library above PBM needs the directories below
# it on the search path as well.
pbm.l|netpbm/PBM|libpbm1.c libpbm2.c libpbm3.c libpbm4.c libpbm5.c|_OSK SYSV NEED_VFPRINTF2|| -V=/h6/netpbm
pgm.l|netpbm/PGM|libpgm1.c libpgm2.c|_OSK SYSV|| -V=/h6/netpbm -V=/h6/netpbm/PBM
ppm.l|netpbm/PPM|libppm1.c libppm2.c libppm3.c libppm4.c libppm5.c|_OSK SYSV|| -V=/h6/netpbm -V=/h6/netpbm/PBM -V=/h6/netpbm/PGM
pnm.l|netpbm/PNM|libpnm1.c libpnm2.c libpnm3.c libpnm4.c|_OSK SYSV CPP2|| -V=/h6/netpbm -V=/h6/netpbm/PBM -V=/h6/netpbm/PGM -V=/h6/netpbm/PPM

# ---- netpbm / pbmplus, the programs -------------------------------------
# 152 of the package's 168.  One source file each against the libraries
# above.  CPP2 on a recipe means Microware's cpp ABORTS on that file
# (E_PRCABT) and GNU cpp does not; LONGREF goes with it because LONGREF is
# only implemented on the CPP2 and GCC paths, not the plain one.
# pbm.l is named three times because l68 makes ONE pass per -l= and
# libpbm5 calls libpbm2's pbm_readpbm.
# The 16 that do not build are in notes/COMPILE-AUDIT.md with their causes.
atktopbm|netpbm/PBM|atktopbm.c|_OSK SYSV|/dd/LIB/pbm.l /dd/LIB/pbm.l /dd/LIB/pbm.l| -V=/h6/netpbm
