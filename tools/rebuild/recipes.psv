# smail 2.5, from its own Makefile.osk.  It wants blarslib for getopt and the
# passwd functions, and two things OS-9 has no answer for at all -- gethostname
# and gettz -- which come from a shim.
#
# off_t comes from SRC/COMPAT/types.h, which is new and guarded twice -- read
# its header before touching it.  Four other ways were tried: -Doff_t=long
# collides with COMPAT's own typedef, an unguarded off_t in COMPAT broke
# `less' (it #defines off_t), a types.h in smail's own directory is found by
# COMPAT's `#include <types.h>' and loops, and -UOSK sends every other file
# down the wrong arm.
smail|smail/BNU/SMAIL_2.5/SRC|main.c map.c resolve.c deliver.c misc.c alias.c pw.c headers.c getpath.c str.c||/dd/LIB/blarslib.l /dd/LIB/unix.l| -V=/dd/DEFS/UNIX
lcasep|smail/BNU/SMAIL_2.5/SRC|lcasep.c||/dd/LIB/blarslib.l|
nptx|smail/BNU/SMAIL_2.5/SRC|nptx.c pw.c str.c||/dd/LIB/blarslib.l|
svbinmail|smail/BNU/SMAIL_2.5/SRC|svbinmail.c||/dd/LIB/blarslib.l|
# ansi2knr -- the standard de-ANSIfier, from the JPEG distribution, itself
# written in K&R so it can bootstrap.  A recipe with KNR in its defines runs
# every source through it before cc.  Build this FIRST: make_overlay.sh copies
# it out of built/ into the overlay, and a KNR recipe fails with
# "ansi2knr: command not found" until it is there.
# TRAPFREE on purpose.  ansi2knr is a BUILD TOOL -- every KNR recipe runs it,
# and make_overlay.sh puts it in the overlay -- so it should depend on as
# little as possible and behave identically wherever it runs.
ansi2knr|jpeglib/JPEG_5A|ansi2knr.c|TRAPFREE||
# The JPEG compressor, through ansi2knr (the KNR flag).  Three switches in
# jconfig.h had to change and each is commented there: HAVE_PROTOTYPES off,
# `const' defined empty, HAVE_STDDEF_H on, and INCOMPLETE_TYPES_BROKEN on --
# that last is the one JPEG provides for compilers exactly like this one.
#
cjpeg|jpeglib/JPEG_5A|cjpeg.c rdppm.c rdgif.c rdtarga.c rdrle.c rdbmp.c jcapi.c jcparam.c jdatadst.c jcmaster.c jcmarker.c jcmainct.c jcprepct.c jccoefct.c jccolor.c jcsample.c jchuff.c jcdctmgr.c jfdctfst.c jfdctflt.c jfdctint.c jcomapi.c jutils.c jerror.c jmemmgr.c jmemnobs.c|KNR||
# The JPEG decompressor.  It needs BOTH flags and neither alone will do it:
# it is the same ANSI tree as cjpeg, and one of its thirty sources --
# jdmarker.c -- is a victim of the cpp bus error (notes/CPP-MACRO-CRASH.md).
# KNR alone dies in cpp on that file; CPP2 alone hands c68 a prototype.  With
# both, ansi2knr runs first and cccp2 reads its output.
#
# Sources are DOBJECTS + DLIBOBJECTS + COMOBJECTS from the tree's own
# makefile.unix -- the decoder half of the library, not every .c in the
# directory (that would pull cjpeg's main in as well).
djpeg|jpeglib/JPEG_5A|djpeg.c wrppm.c wrgif.c wrtarga.c wrrle.c wrbmp.c rdcolmap.c jdapi.c jdatasrc.c jdmaster.c jdmarker.c jdmainct.c jdcoefct.c jdpostct.c jddctmgr.c jidctfst.c jidctflt.c jidctint.c jidctred.c jdhuff.c jdsample.c jdcolor.c jquant1.c jquant2.c jdmerge.c jcomapi.c jutils.c jerror.c jmemmgr.c jmemnobs.c|KNR CPP2||
# flex, through GNU's preprocessor (the CPP2 flag).  Microware's cpp bus-errors
# on dfa.c's nested macros -- notes/CPP-MACRO-CRASH.md -- and this is the way
# round it: cccp2 in cpp's place, then c68/o68/r68 by hand.  Two further things
# were in the way and neither is about the preprocessor: misc.c wants time_t
# from <sys/types.h>, which is System V behaviour the SDK does not have, and
# `ctime' lives in a clib psect a trap-free link will not take (shim).
flex|flex|ccl.c dfa.c ecs.c gen.c main.c misc.c nfa.c parse.c scan.c sym.c tblcmp.c yylex.c|CPP2 time_t=long||
# inform -- Graham Nelson's Inform 1.0 (v796), the Z-machine compiler behind
# GAMES/INFORM.  It has never been built here; DOC/INDEX has said so for
# months ("this SDK's cpp aborts partway through").  Three things were in the
# way and all three are now measured rather than guessed:
#
#   CPP2     one 775-character logical line, over cpp's 512 (CPP-MACRO-CRASH).
#   limits.h SRC/COMPAT's derived every limit through a CAST, which is correct
#            C and always FALSE in a #if.  inform picks its 32-bit type with a
#            four-arm #if over SCHAR_MAX/SHRT_MAX/INT_MAX/LONG_MAX, so every
#            arm failed and it reached `#error No type large enough'.  The
#            header is plain constants now.
#   LONGREF  100K of code needs long PC-relative branches, and o68 miscompiles
#            them -- see the note on compile_cpp2_post in rebuild.sh.
#
# Verified beyond linking: it recompiles the collection's own hellow.inf to a
# story file byte-identical to GAMES/INFORM/hellow.z3.
inform|inform|informosk.c|CPP2 LONGREF||
# GNU ed 0.2.  COMPILE-AUDIT called this an ANSI tree; it is not, it is K&R
# throughout, and ansi2knr WRECKS it -- `get_sbuf_line (lp)' becomes
# `get_sbuf_line (lp)  lp;'.  No KNR here.  What actually stopped it was
# ed.h's REALLOC macro, whose continuation lines join into ~1400 characters,
# well past cpp's 512 (notes/CPP-MACRO-CRASH.md).  CPP2 clears it.
#
# The rest is ordinary:
#   ERANGE     the SDK's <errno.h> is OS-9's own numbers and has no ERANGE;
#              0x100 is the value DEFS/os9lib/errno.h gives it, so a caller
#              that got it from there and one that got it here agree.
#   alloca.c xmalloc.c error.c   the tree's own, named by its Makefile's
#              LIBSRCS, which the first recipe attempt left out.
#   os9lib.l   umask, alloca.   blarslib.l  vfprintf, for error.c.
#   strtol     is in no library a -qm link can use (csl.l needs the trap
#              handler, ppplib.l is not a relocatable module), so the driver
#              adds shims/os9strtol.c.
#
# AT RUNTIME IT WANTS /r0.  buf.c hardcodes its scratch file as
# "/r0/ed.XXXXXX", the conventional OS-9 RAM disk.  os9exec has no /r0: OS9R0
# is ignored, and `mount -r' from inside a shell fails E_PNNF.  This is the
# ARCHIVE's, not ours -- the shipped disk/CMDS/ed has the same string -- and
# our build is the better of the two anyway, being trap-free where the shipped
# one is starred and cannot start without cio.
ed|ed|main.c buf.c glbl.c io.c re.c signal.c sub.c undo.c version.c getopt.c getopt1.c regex.c alloca.c xmalloc.c error.c|CPP2 HAVE_CONFIG_H ERANGE=0x100|/dd/LIB/os9lib.l /dd/LIB/blarslib.l|
# C News. Its source tree has been here since 2026-08-21 with no recipe; six of
# the disk's programs come out of it, and five build. It is K&R throughout --
# no KNR flag -- and the whole difficulty is that the tree is a PACKAGE: the
# sources live in one directory and the headers they want in another.
#
#   bdecode    <coder.h> and crctab from batch/
#   dbz        <fileinfo.h>, which the SDK does not have; it is in blarsdefs
#   newslock   link(), which OS-9 has not -- blarslib's ln.c supplies it
#
# `newshist' is the sixth and is NOT here: it wants gethistory() from
# relay/history.c, and that file pulls in the relay machinery behind it
# (libc.h fails to parse, and history.c has a macro called without arguments).
# That is a package build, not a recipe.
bdecode|cnews/input|bdecode.c ../batch/crctab.c|||-V=/h6/cnews/batch
c7decode|cnews/input|c7decode.c|||
byteflip|cnews/dbz|byteflip.c|||
dbz|cnews/dbz|dbzmain.c dbz.c||/dd/LIB/os9lib.l|-V=/dd/DEFS/blarsdefs
newslock|cnews/misc|newslock.c||/dd/LIB/blarslib.l|-V=/h6/cnews/h
# Rayshade 4.0, Craig Kolb's ray tracer -- 78 sources across six nested
# libraries, and the first PACKAGE build here rather than a directory build.
# Four separate walls, each with its own answer:
#
#   CPP2     the sources include <libcommon/common.h> -- a DIRECTORY in the
#            include name, which Microware's cpp will not look for in a -V
#            directory at all (it is also what blocks macutils).  GNU cpp has
#            no such limit, and with CPP2 every one of them resolves.
#   M020     shadow.c's stack frame overruns the 68000's 16-bit displacement;
#            c68020/r68020 is what `cc -K=2L' switches to for that.
#   geom.h   and it STILL overruns, because a HitList is a local: hence
#            MAXMODELDEPTH 128 -> 48, measured, with -M=200k for the runtime
#            side of the same thing.  See the note in geom.h.
#   I_STDLIB funcdefs.h's own RCS log names this switch: "Don't declare free
#            or exit void if stdlib.h is used."
#
# VERIFIED BY RENDERING, not by linking: planet.ray, solids.ray and balls.ray
# all come out complete at 24x24, and planet is recognisably a lit sphere.
# csg.ray truncates and blob.ray takes a bus error -- both untested against the
# shipped binary, because THAT one cannot render at all (config.h note).
rayshade|rayshade|libray/LIBCOMMON/expr.c libray/LIBCOMMON/memory.c libray/LIBCOMMON/rotate.c libray/LIBCOMMON/sampling.c libray/LIBCOMMON/scale.c libray/LIBCOMMON/transform.c libray/LIBCOMMON/translate.c libray/LIBCOMMON/vecmath.c libray/LIBCOMMON/xform.c libray/LIBIMAGE/image.c libray/LIBLIGHT/extended.c libray/LIBLIGHT/infinite.c libray/LIBLIGHT/jittered.c libray/LIBLIGHT/light.c libray/LIBLIGHT/point.c libray/LIBLIGHT/shadow.c libray/LIBLIGHT/spot.c libray/LIBOBJ/blob.c libray/LIBOBJ/bounds.c libray/LIBOBJ/box.c libray/LIBOBJ/cone.c libray/LIBOBJ/csg.c libray/LIBOBJ/cylinder.c libray/LIBOBJ/disc.c libray/LIBOBJ/geom.c libray/LIBOBJ/grid.c libray/LIBOBJ/hf.c libray/LIBOBJ/instance.c libray/LIBOBJ/intersect.c libray/LIBOBJ/list.c libray/LIBOBJ/plane.c libray/LIBOBJ/poly.c libray/LIBOBJ/roots.c libray/LIBOBJ/sphere.c libray/LIBOBJ/torus.c libray/LIBOBJ/triangle.c libray/LIBSURF/atmosphere.c libray/LIBSURF/fog.c libray/LIBSURF/fogdeck.c libray/LIBSURF/mist.c libray/LIBSURF/surface.c libray/LIBSURF/surfshade.c libray/LIBTEXT/blotch.c libray/LIBTEXT/bump.c libray/LIBTEXT/checker.c libray/LIBTEXT/cloud.c libray/LIBTEXT/fbm.c libray/LIBTEXT/fbmbump.c libray/LIBTEXT/gloss.c libray/LIBTEXT/imagetext.c libray/LIBTEXT/mapping.c libray/LIBTEXT/marble.c libray/LIBTEXT/mount.c libray/LIBTEXT/noise.c libray/LIBTEXT/sky.c libray/LIBTEXT/stripe.c libray/LIBTEXT/textaux.c libray/LIBTEXT/texture.c libray/LIBTEXT/windy.c libray/LIBTEXT/wood.c libshade/builtin.c libshade/lex.c libshade/lightdef.c libshade/misc.c libshade/objdef.c libshade/options.c libshade/picture.c libshade/setup.c libshade/shade.c libshade/stats.c libshade/surfdef.c libshade/symtab.c libshade/viewing.c libshade/yacc.c rayshade/main.c rayshade/raytrace.c rayshade/version.c|CPP2 M020 I_STDLIB|/dd/LIB/os9lib.l|-K=2L -M=200k -V=/h6/rayshade/libray -V=/h6/rayshade/libshade -V=/h6/rayshade/rayshade
# macutils -- and COMPILE-AUDIT's reason for having no recipe is now WRONG.
# It said the tree was blocked on an include-path knot: it wants <sys/types.h>
# as blarslib declares it, and Microware's cpp will not search a -V directory
# for an include name with a directory in it.  Both halves are true and CPP2
# dissolves both -- GNU cpp searches -I for such names, and a recipe's -V= now
# reaches that pass, so `-V=/dd/DEFS/blarsdefs' does exactly what was wanted.
#
# These two also needed the temp-name fix: `binhex' names BINHEX/binhex.c AND
# CRC/binhex.c, and until 2026-08-23 the driver put both on ctmp_binhex and
# lost the first.  See tmpbase() in rebuild.sh.
#
# `mcvert' is not here: it wants ftime(), which blarslib has and blarslib's
# ftime.c is one of the four objects NOT taken (see notes/BLARSLIB.md).
# `macsave' and `macunpack' are not here either; neither has been run down.
binhex|macutils/BINHEX|binhex.c dofile.c ../UTIL/transname.c ../UTIL/backtrans.c ../UTIL/util.c ../FILEIO/rdfile.c ../FILEIO/fileglob.c ../CRC/binhex.c ../CRC/ccitt.c|CPP2 NODOT|/dd/LIB/blarslib.l|-V=/dd/DEFS/blarsdefs -V=/h6/macutils/UTIL -V=/h6/macutils/FILEIO -V=/h6/macutils/CRC
unsit|macutils/UNSIT|unsit.c getopt.c updcrc.c ../UTIL/transname.c ../UTIL/backtrans.c ../UTIL/util.c ../FILEIO/rdfile.c ../FILEIO/wrfile.c ../FILEIO/fileglob.c ../CRC/binhex.c ../CRC/ccitt.c|CPP2 NODOT|/dd/LIB/blarslib.l|-V=/dd/DEFS/blarsdefs -V=/h6/macutils/UTIL -V=/h6/macutils/FILEIO -V=/h6/macutils/CRC
# mtools 3.6 -- the first program built with the GCC flag, and the reason the
# flag exists.  COMPILE-AUDIT filed this under "a gcc2 build, same category as
# ls" and left it there; the tree ships a whole GCC 2.5.6 in CMDS/GCC2, its own
# makefile says CC = gcc2, and nobody had tried it since the DEFS under it were
# repaired (see DEFS/GCC2/stdio.h and errno.h).
#
# 45 sources, and every one of the flags below was needed:
#
#   GCC              the port is ANSI; Microware cc cannot read a prototype.
#   HAVE_STRSPN      mtools sysincludes.h declares strspn/strcspn ANSI-style,
#   HAVE_STRCSPN     which conflicts with DEFS/os9unix/string.h reached through
#                    SRC/COMPAT.  Its own guards suppress the declarations.
#   _OSK_COMPAT_OFF_T  COMPAT/types.h typedefs off_t and so does sysincludes.h
#                    under _OSK -- and gcc2 PREDEFINES _OSK, so that arm always
#                    fires.  COMPAT already carries a guard for exactly this.
#   -V=/h7           COMPAT is opt-in on the GCC path; mtools wants its
#                    <limits.h> and <pwd.h>, which GCC has not got.
#   -M=64k           `mdir' bare says **** Stack Overflow **** without it.
#
# Two source-side corrections, both marked where they are:
#   config.h         claimed HAVE_STRERROR.  It is configure output from the
#                    machine the port was built on; this system has no
#                    strerror in any library a trap-free link can reach, and
#                    the claim only stopped mtools own copy being compiled.
#   sysincludes.h    declared `void atexit()' under _OSK while mtools own
#                    missing_functions.c defines `int atexit()'.  A port bug,
#                    not a compiler workaround -- it fails for any toolchain
#                    whose libgcc lacks atexit, which this one does.
#
# `strtoul' comes from shims/os9strtol.c, added by the driver's own retry.
# Verified by running: `mdir -?' prints the real mtools 3.6 usage, and `mdir'
# reaches for /pc1@, the PC floppy descriptor, which is correct when none is
# configured.
mtools|mtools/MTOOLS_3.6|mtools.c buffer.c codepage.c codepages.c config.c copyfile.c devices.c directory.c expand.c fat.c fat_free.c file.c file_name.c file_read.c filter.c force_io.c hash.c init.c match.c mattrib.c mbadblocks.c mcd.c mcopy.c mdel.c mdir.c mformat.c misc.c missing_functions.c mk_direntry.c mlabel.c mmd.c mmove.c mainloop.c minfo.c precmd.c privileges.c parse.c plain_io.c signal.c stream.c streamcache.c subdir.c toupper.c tty.c vfat.c xdf_io.c|GCC HAVE_CONFIG_H HAVE_STRSPN HAVE_STRCSPN _OSK_COMPAT_OFF_T|/dd/LIB/blarslib.l /dd/LIB/unix.l|-V=/h7 -M=64k
# GNU tar 1.11, through the GCC flag.  It has had no recipe since the tree
# arrived; the cpp bus error was blamed, and that was only the first of six
# walls.  READ notes/SESSION-2026-08-23.md BEFORE CHANGING ANY FLAG BELOW.
#
# WHAT IT CAN AND CANNOT DO -- verified by running it, not by linking:
#   READING and EXTRACTING work, and are the point.  Given a ustar archive
#   made on another machine it lists it with correct modes, owners, sizes and
#   dates, and extracts all three test files BYTE-IDENTICAL, including a
#   3000-byte binary.  That is what somebody with a .tar off the net needs.
#   CREATING archives is WRONG and says so loudly: `file X shrunk by 720880
#   bytes, padding with zeros' on every file.  os9lib.l's stat() fills
#   os9lib's OWN struct stat, and what gtar has in scope here is the one from
#   DEFS/UNIX via SRC/COMPAT.  Same SIZE, 36 bytes, so nothing is overrun --
#   the fields simply land in the wrong members and st_size is nonsense.
#   Do not install this over anything until that is fixed.
#
# THE FIX IS KNOWN AND MEASURED.  Pair os9lib's stat() with os9lib's own
# <stat.h> and it is correct: distinct inodes per file, real sizes, real
# mtimes.  It cannot be done here yet because gcc2's cc2 dies with a fatal
# signal on port.c once the os9lib headers are in scope -- both the STDC_MSG
# and VARARGS_MSG arms, and port.c hardcodes VARARGS_MSG at line 103 anyway.
# The same pairing is what GNU `ls' needs; see the ls section of that note.
#
# THE FLAGS, none of them guessable:
#   GCC              its makefile says CC = gcc.  Microware cc cannot read it.
#   S_IF*/S_IS*      OS-9 has no file-type or setuid bits.  These values are
#                    DEFS/os9lib/stat.h's own, so they are the disk's answer
#                    rather than one invented here, and S_IFREG and S_IFCHR
#                    differ (0x100/0x0) so the switch in create.c is legal --
#                    blarsdefs makes both 0 and it is not.
#   HAVE_SIZE_T      tar.h typedefs size_t under USG unless told otherwise.
#   ERROR=-1         rmdir.c wants OS-9's ERROR; only os9lib/stdio.h has it.
#   time_t=long      getdate.y needs it before any header supplies it.
#   uint=unsigned    diffarch.c casts to `uint' in its OSK arm.
#   NO_REMOTE        maps the whole rmt* family to plain open/read/ioctl and
#                    drops rtape_lib.c.  There is no remote tape here.
#   USG              System V: skips <sys/mtio.h>, which does not exist here.
#   -M=32k           without it, gtar overflows its stack.
#
# Four shims, all added by the driver's own retry: os9bcopy, os9getpw,
# os9geteuid (which gained unix_getuid for this), os9ftime and os9sswfm.
gtar|gtar/GNUTAR|tar.c create.c extract.c buffer.c getoldopt.c list.c update.c rmdir.c version.c names.c diffarch.c port.c wildmat.c getopt.c getopt1.c regex.c gnu.c mangle.c getdate.c|GCC DEFBLOCKING=4 NO_REMOTE USG HAVE_SIZE_T HAVE_STRSTR TRUE=1 FALSE=0 time_t=long uint=unsigned|/dd/LIB/os9lib.l /dd/LIB/blarslib.l /dd/LIB/unix.l|-V=/h7/OS9LIB -V=/dd/DEFS/os9lib -V=/h7 -M=32k
# ASM, and the only recipe that is.  MODNAME because the module is ATerm
# and the file is aterm: with -n=aterm the result differs from the shipped
# binary in five bytes, two of the name and the three CRC bytes.
aterm|aterm|ATerm.a|ASM MODNAME=ATerm||
# The eighteen mtools commands.  Each is a small main() over the same
# shared objects -- the archive's own Makefile calls them LINKS and builds
# each one from <name>.r plus mtools.l.  Same recipe as mtools with a
# different first source; the driver takes main() from the FIRST source
# that has one.
