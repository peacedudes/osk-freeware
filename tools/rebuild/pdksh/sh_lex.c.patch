+#ifdef OSK
+				/* Read to the end of the line rather than asking for
+				 * LINE (256) bytes at once.  OS-9's I$Read on a terminal
+				 * is documented to stop at the path's end-of-record
+				 * character, so on a conforming system the two are the
+				 * same -- but os9exec through v4.00 waits for the full
+				 * count, and a 256-byte read of a typed line then never
+				 * returns at all.  That is why ksh printed no prompt and
+				 * ran nothing.  A byte at a time costs one syscall per
+				 * character on a line nobody types fast, and works on
+				 * either.  '\n' is CR (0x0D) in OS-9 C.
+				 */
+				{
+					int got;
+
+					for (c = 0; c < LINE - 1; ) {
+						got = read(ttyfd, line + c, 1);
+						if (got <= 0) {
+							/* Report the error only when
+							 * nothing was read: a partial
+							 * line is worth keeping, and the
+							 * caller retries on c < 0.
+							 */
+							if (c == 0)
+								c = got;
+							break;
+						}
+						if (line[c++] == '\n')
+							break;
+					}
+				}
+#else
